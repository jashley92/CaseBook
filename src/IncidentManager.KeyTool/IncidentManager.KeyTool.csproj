<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PROD-57: casebook-keytool, run by an administrator on the CaseBook server (or, for a recovery drill, anywhere with a
    recovery certificate or the shares). Splits the evidence key into shares, checks a share, proves a backup opens the
    key, rebuilds the server's copy onto a new certificate, and exports evidence decrypted. It reads the envelope and
    never makes a key. Shipped in the release bundle under deploy\keytool.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>casebook-keytool</AssemblyName>
    <RootNamespace>IncidentManager.KeyTool</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IncidentManager.Infrastructure\IncidentManager.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IncidentManager.IntegrationTests" />
  </ItemGroup>

</Project>
