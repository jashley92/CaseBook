<?xml version="1.0" encoding="utf-8"?>
<!--
  BUG-261: CaseBook ships its own web.config so the published one has no <location path="." inheritInChildApplications="false">
  wrapper, which the SDK writes by default. The installer opens /api to anonymous requests (API tokens authenticate in the
  app) with a <location path="CaseBook/api"> entry in applicationHost.config, and IIS doesn't carry settings inside that
  wrapper into such a path: /api lost the aspNetCore handler, so IIS's StaticFile handler answered every /api request
  with its own 404 and API imports never reached the app. Publish adds the handler and <aspNetCore> element here.
-->
<configuration>
  <system.webServer>
  </system.webServer>
</configuration>
