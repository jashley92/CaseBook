@inherits LayoutComponentBase
@layout MainLayout
@inject NavigationManager Nav
@inject IWebHostEnvironment Env

@* Administration hub shell (Option B): one left rail is the single navigation for every admin destination,
   so the main sidebar carries just a single "Administration" entry instead of repeating all of these.
   Configuration and System items route into the Settings page (admin/settings/{section}); the rest are the
   standalone admin pages, which opt in with @layout AdminLayout so the rail persists across them. *@
<div class="admin-shell">
    <nav class="admin-rail" aria-label="Administration">
        <div class="admin-rail-head">
            <span class="bi bi-shield-lock" aria-hidden="true"></span><span>Administration</span>
        </div>
        @* The overview has its own, larger search box. *@
        @if (!OnOverview) { <AdminSearchBox Compact="true" /> }
        @foreach (var group in Groups)
        {
            <div class="admin-rail-label">@group.Label</div>
            @foreach (var item in group.Items)
            {
                <div class="admin-rail-item">
                    <NavLink class="admin-rail-link" href="@item.Href" Match="NavLinkMatch.All">
                        <span class="bi @item.Icon" aria-hidden="true"></span><span>@item.Title</span>
                        @if (item.Href == UpdatesHref) { <UpdateDot /> }
                    </NavLink>
                </div>
            }
        }
    </nav>
    <div class="admin-pane">
        @* UX-08: Administration › [section] trail. The rail navigates; the breadcrumb states "you are
           here" and gives a one-click way back to the admin landing from any deep section. *@
        <Breadcrumbs Items="Crumbs" />
        @Body
    </div>
</div>

@code {
    private const string UpdatesHref = "admin/settings/updates";

    public sealed record RailItem(string Title, string Icon, string Href);
    public sealed record RailGroup(string Label, RailItem[] Items);

    // UX-08: derive the breadcrumb from the active rail item so every admin page gets a consistent
    // "Administration › [section]" trail with no per-page wiring. The landing (admin) and any route not
    // in the rail render no trail — the rail alone navigates there.
    private IReadOnlyList<Crumb> Crumbs
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri);
            var q = path.IndexOf('?', StringComparison.Ordinal);
            if (q >= 0) path = path[..q];
            path = path.TrimEnd('/');

            var active = Groups.SelectMany(g => g.Items)
                .FirstOrDefault(i => string.Equals(i.Href.TrimEnd('/'), path, StringComparison.OrdinalIgnoreCase));

            return active is null || string.Equals(active.Href, "admin", StringComparison.OrdinalIgnoreCase)
                ? []
                : [new Crumb("Administration", "admin"), new Crumb(active.Title)];
        }
    }

    // UX-18: the rail is grouped by what an admin is trying to *do*, not by how a page is built (a settings section or a
    // standalone editor). Settings sections are /admin/settings/{section} (Admin.razor lists them in the same groups).
    // Match.All highlights the exact section.
    public static readonly RailGroup[] AllGroups =
    [
        new("Overview",
        [
            new("Overview", "bi-speedometer2", "admin"),   // what needs attention, and search
        ]),
        new("Organization",
        [
            new("Identity & branding", "bi-building", "admin/settings/identity"),
            new("Teams", "bi-people-fill", "admin/teams"),   // CAP-36
        ]),
        new("Cases & workflow",
        [
            new("Case templates", "bi-clipboard-check", "admin/templates"),
            new("Stage gates", "bi-shield-check", "admin/gates"),
            new("Taxonomy & severity labels", "bi-tags", "admin/settings/taxonomy"),
            new("Data elements", "bi-collection", "admin/data-elements"),
            new("Case outcomes", "bi-flag", "admin/outcomes"),
            new("Response & SLA", "bi-stopwatch", "admin/settings/sla"),
            new("Regulatory deadlines", "bi-alarm", "admin/settings/regulatory-deadlines"),
        ]),
        new("Notifications",
        [
            new("Notifications", "bi-envelope", "admin/settings/notifications"),
            new("Email templates", "bi-envelope-paper", "admin/email-templates"),
        ]),
        new("Integrations",
        [
            new("Integrations", "bi-plug", "admin/settings/integrations"),
        ]),
        new("Reports",
        [
            new("Reports", "bi-file-earmark-text", "admin/settings/reporting"),
        ]),
        new("Records & evidence",
        [
            new("Evidence storage", "bi-hdd", "admin/settings/evidence"),
            new("Retention", "bi-archive", "admin/settings/retention"),   // CAP-10: the settings and the review
            new("Integrity", "bi-shield-lock", "admin/settings/integrity"),
        ]),
        new("People & access",
        [
            new("Roles & access", "bi-people", "admin/roles"),
            new("API tokens", "bi-key", "admin/api-tokens"),
            @* UX-17: the Access log viewer is in the top-level "Audit & Exports" group; its settings are here. *@
            new("Security & access logging", "bi-person-lock", "admin/settings/security"),
        ]),
        new("System",
        [
            new("Diagnostics", "bi-activity", "admin/settings/diagnostics"),
            new("Server configuration", "bi-hdd-stack", "admin/settings/server"),
            new("Setting sources", "bi-diagram-3", "admin/settings/source"),
            new("Configuration bundle", "bi-box-seam", "admin/config-bundle"),
            new("Updates", "bi-cloud-arrow-down", UpdatesHref),   // PROD-49
            new("Search", "bi-search", "admin/settings/search"),   // CAP-22
            @* UX-18: the design-system reference is a developer tool, shown only in Development. *@
            new("Style guide", "bi-palette", StyleGuideHref),
        ]),
    ];

    private const string StyleGuideHref = "admin/style";

    private bool OnOverview => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/') == "admin";

    private RailGroup[] Groups => Env.IsDevelopment() ? AllGroups
        : [.. AllGroups.Select(g => g with { Items = [.. g.Items.Where(i => i.Href != StyleGuideHref)] })];
}
