@inject Microsoft.Extensions.Configuration.IConfiguration Config

<div class="sidebar-brand">
    <span class="bi bi-journal-bookmark-fill brand-mark" aria-hidden="true"></span>
    <span class="brand-titles">
        <span class="brand-text">Case<span class="brand-accent">Book</span></span>
        @if (!string.IsNullOrWhiteSpace(_orgName))
        {
            <span class="brand-org" title="@_orgName">@_orgName</span>
        }
    </span>
    @* Desktop-only collapse toggle in the header (convention: top of the sidebar). Wired CSP-safely by a
       delegated handler in theme.js (window.imNav); state persists in localStorage, applied before paint. *@
    <button type="button" id="nav-collapse-toggle" class="sidebar-collapse-btn"
            title="Collapse or expand the sidebar" aria-label="Collapse or expand the sidebar">
        <span class="bi bi-chevron-double-left" aria-hidden="true"></span>
    </button>
</div>

@code {
    // White-label identity (X-01): show the org's name under the product wordmark when configured.
    private string? _orgName => Config["Reporting:OrganizationName"];
}

@* UX-02: label the toggler; theme.js keeps aria-expanded in sync with the checkbox state. *@
<input type="checkbox" title="Navigation menu" class="navbar-toggler"
       aria-label="Show or hide the navigation menu" aria-expanded="false" />

<div class="nav-scrollable">
    @* title attributes double as tooltips when the sidebar is collapsed to icons (data-nav="collapsed"). *@
    <nav class="flex-column" aria-label="Primary">
        @* UX-14: leadership-only "Overview" cluster — the surfaces for looking *across* the team. Both are
           gated ViewAllCases (the dashboard is also the landing for these roles; others land on My Work).
           The whole group — label included — is inside the gate so analysts, who see neither entry, never
           get an empty heading. Team workload lives here, beside the Dashboard, because it is oversight,
           not personal work; it used to be a tab on the Work page, which read as a category error. *@
        <AuthorizeView Policy="@Policies.ViewAllCases">
            <div class="nav-group-label">Overview</div>
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All" title="Dashboard">
                    <span class="bi bi-speedometer2" aria-hidden="true"></span><span class="nav-text">Dashboard</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="team" Match="NavLinkMatch.All" title="Team workload">
                    <span class="bi bi-people-fill" aria-hidden="true"></span><span class="nav-text">Team workload</span>
                </NavLink>
            </div>
        </AuthorizeView>

        <div class="nav-group-label">Workspace</div>
        <div class="nav-item">
            <NavLink class="nav-link" href="work" Match="NavLinkMatch.All" title="My Work">
                <span class="bi bi-person-workspace" aria-hidden="true"></span><span class="nav-text">My Work</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="agenda" Match="NavLinkMatch.All" title="Agenda">
                <span class="bi bi-calendar-week" aria-hidden="true"></span><span class="nav-text">Agenda</span>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="cases" Match="NavLinkMatch.All" title="Cases">
                <span class="bi bi-folder2-open" aria-hidden="true"></span><span class="nav-text">Cases</span>
            </NavLink>
        </div>
        @* Prefix match so the /campaigns/{id} rollup keeps this highlighted too. *@
        <div class="nav-item">
            <NavLink class="nav-link" href="campaigns" Match="NavLinkMatch.Prefix" title="Campaigns">
                <span class="bi bi-diagram-3" aria-hidden="true"></span><span class="nav-text">Campaigns</span>
            </NavLink>
        </div>
        <AuthorizeView Policy="@Policies.EditCases">
            <div class="nav-item">
                <NavLink class="nav-link" href="cases/new" title="New Case">
                    <span class="bi bi-plus-circle" aria-hidden="true"></span><span class="nav-text">New Case</span>
                </NavLink>
            </div>
        </AuthorizeView>

        @* UX-17: audit/forensic surfaces + the export hub together. Access log (the "who viewed this"
           telemetry) sits beside Integrity & Audit — its sibling forensic surface — instead of being
           buried in the admin hub; it stays SysAdmin-only. Downloads renamed Exports (names the job). *@
        <div class="nav-group-label">Audit &amp; Exports</div>
        <div class="nav-item">
            <NavLink class="nav-link" href="integrity" title="Integrity &amp; Audit">
                <span class="bi bi-shield-lock" aria-hidden="true"></span><span class="nav-text">Integrity &amp; Audit</span>
            </NavLink>
        </div>
        <AuthorizeView Policy="@Policies.Administer">
            <div class="nav-item">
                <NavLink class="nav-link" href="access-log" Match="NavLinkMatch.All" title="Access log">
                    <span class="bi bi-eye" aria-hidden="true"></span><span class="nav-text">Access log</span>
                </NavLink>
            </div>
        </AuthorizeView>
        @* UX-09: one home for the export artifacts (metrics, IOC feed, compliance bundle, …). *@
        <div class="nav-item">
            <NavLink class="nav-link" href="exports" Match="NavLinkMatch.All" title="Exports">
                <span class="bi bi-download" aria-hidden="true"></span><span class="nav-text">Exports</span>
            </NavLink>
        </div>

        <AuthorizeView Policy="@Policies.Administer">
            <div class="nav-group-label">Administration</div>
            @* One entry into the admin hub; the hub's own left rail navigates its sections (Option B),
               so the main sidebar no longer repeats every admin destination. Prefix match keeps this
               highlighted across all admin/* routes. *@
            <div class="nav-item">
                <NavLink class="nav-link" href="admin" Match="NavLinkMatch.Prefix" title="Administration">
                    <span class="bi bi-sliders" aria-hidden="true"></span><span class="nav-text">Administration</span>
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>
