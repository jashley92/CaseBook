@inherits LayoutComponentBase
@inject TimeDisplay TimeDisp
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IncidentManager.Application.Preferences.UserDisplayPreferenceService DisplayPrefs
@inject IncidentManager.Web.Services.CaseTabsState Tabs
@inject ILogger<MainLayout> Logger
@inject ICurrentUser CurrentUser
@implements IDisposable

@* UX-02: first focusable element on the page, so a keyboard/AT user can skip the sidebar. *@
<a class="im-skip-link" href="#main-content">Skip to content</a>

<div class="page @(Tabs.Beside is not null && CurrentUser.Has(Permission.ViewCases) ? "has-beside" : "")">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <AuthorizeView Policy="@Policies.Administer">
            <IntegrityAlertBanner />
            <EvidenceIntegrityBanner />
            <UndeliveredAlertBanner />
        </AuthorizeView>
        <div class="top-row px-4 d-flex justify-content-between align-items-center gap-3">
            @* BUG-465: case search and the case tabs need ViewCases, not just a sign-in (Windows auth signs in every
               domain user, and one with no CaseBook role still saw them). *@
            <AuthorizeView Policy="@Policies.ViewCases">
                <Authorized>
                    <PaletteSearchButton />
                    @* RD-21: the cases you're on, as tabs. *@
                    <CaseTabStrip />
                </Authorized>
                <NotAuthorized>
                    <span></span>
                </NotAuthorized>
            </AuthorizeView>
            <div class="d-flex align-items-center gap-2">
                <AuthorizeView>
                    <Authorized>
                        @* BUG-465: the bell is case activity. *@
                        <AuthorizeView Policy="@Policies.ViewCases" Context="viewCases">
                            <NotificationBell />
                        </AuthorizeView>
                        <ProfileMenu />
                    </Authorized>
                    <NotAuthorized>
                        <button id="theme-toggle" type="button" class="btn btn-sm btn-outline-secondary"
                                title="Toggle light or dark theme" aria-label="Toggle light or dark theme">◐</button>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        @* U-29: @key bumps on every time-mode change, forcing Blazor to rebuild the routed page subtree
           so every timestamp re-renders in the new zone (a layout StateHasChanged alone does not reach
           into @Body, and CascadingValue only reaches components that declare the parameter). *@
        @* REL-01: a component that throws during render or a lifecycle method would otherwise tear down the
           whole circuit and drop the user into the "session lost" overlay, losing in-flight work. This boundary
           keeps the shell alive and shows a recover-in-place fallback. It resets on navigation (LocationChanged
           → Recover), and the fallback's "Reload the page" is the hard escape hatch. *@
        @* A page loaded in full showed three times: prerendered, again when the circuit started (each part loading
           afresh), and again when the display zone arrived (the rebuild above). So the page is shown once, when the
           circuit is live and knows its zone; until then a placeholder. The prerendered page is still built (a page
           that can't render fails on a first visit, as before) but not shown. *@
        <article id="main-content" tabindex="-1" class="content px-4" @key="_timeVersion">
            @if (PageReady)
            {
                @Page
            }
            else
            {
                <LoadingBlock Rows="6" Label="Loading the page…" />
                @if (!RendererInfo.IsInteractive)
                {
                    <div hidden inert>@Page</div>
                }
            }
        </article>
        @* RD-21: a second case's Briefing beside the page. BUG-465: ViewCases. *@
        <AuthorizeView Policy="@Policies.ViewCases">
            <Authorized>
                @if (Tabs.Beside is { } beside)
                {
                    <CaseBeside CaseId="beside" @key="beside" />
                }
            </Authorized>
        </AuthorizeView>
    </main>
</div>

<ToastHost />

<AuthorizeView>
    <Authorized>
        @* BUG-465: for everyone signed in, since it also holds the global keys (Escape, ?, g-chords); its case
           results (Find, pins, recents) come only with View cases. *@
        <CommandPalette />
        <IdleGuard />
        <ReportJobToaster />
        <PhoneNav />
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui">
    Something went wrong. Reload the page to continue.
    <a href="" class="reload">Reload</a>
    <a class="dismiss" aria-label="Dismiss">🗙</a>
</div>

@code {
    // U-29: the layout owns the on-screen time-zone re-render. Once the circuit becomes interactive we
    // read the browser's zone + stored UTC/local preference and push them into the scoped TimeDisplay;
    // it raises Changed, and because the layout is the ancestor of every timestamp (the top bar and
    // @Body), re-rendering here re-renders them all. The toggle in the profile menu flows through the
    // same Changed event.
    private int _timeVersion;

    private bool PageReady => RendererInfo.IsInteractive && TimeDisp.Initialized;

    private RenderFragment Page => @<ErrorBoundary @ref="_errorBoundary">
        <ChildContent>@Body</ChildContent>
        <ErrorContent>
            <ErrorFallback Scope="ErrorFallback.ErrorScope.Page" />
        </ErrorContent>
    </ErrorBoundary>;

    // REL-01: the boundary persists across page navigations (it isn't keyed by route), so once it has caught
    // an error it would keep showing the fallback even after the user navigates away. Recover on every
    // location change to clear a caught error and render the newly-navigated page. Recover() is a no-op when
    // nothing is caught, so this is safe to call unconditionally.
    private ErrorBoundary? _errorBoundary;

    protected override void OnInitialized()
    {
        TimeDisp.Changed += OnTimeChanged;
        Nav.LocationChanged += OnLocationChanged;
        Tabs.Changed += OnTabsChanged;
    }

    private Guid? _shownBeside;
    // Only the beside pane changes the layout; tab-list changes re-render the strip itself.
    private void OnTabsChanged()
    {
        if (_shownBeside == Tabs.Beside) return;
        _shownBeside = Tabs.Beside;
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(() => _errorBoundary?.Recover());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // The zone first: the page waits on it (PageReady); syncing the display preferences doesn't need to.
        if (!TimeDisp.Initialized) await ReadDisplayZone();
        await StartDisplayPrefSync();
    }

    private async Task ReadDisplayZone()
    {
        try
        {
            var (zone, mode, clock) = await JS.InvokeAsync<string[]>("imTime.display") is [var z, var m, var c] ? (z, m, c) : ("UTC", "utc", "24");
            _firstZone = true;
            TimeDisp.Configure(zone, string.Equals(mode, "local", StringComparison.OrdinalIgnoreCase)
                ? TimeDisplayMode.Local : TimeDisplayMode.Utc, clock == "12");
        }
        catch
        {
            // Interop unavailable — stay on the UTC default.
            _firstZone = true;
            TimeDisp.Configure(null, TimeDisplayMode.Utc);
        }
        finally { _firstZone = false; }
        // The same zone as the default raises no Changed, and the page is still waiting on it.
        StateHasChanged();
    }

    // BUG-509: the rebuild for the circuit's first display zone is still the page's first load, so the router's address
    // (its deep link not yet seen) is the one to open; a later toggle rebuilds the page where the viewer is.
    private bool _firstZone;

    private void OnTimeChanged()
    {
        var firstZone = _firstZone;   // Configure raises Changed before it returns
        InvokeAsync(() =>
        {
            if (firstZone) Tabs.ForgetWritten();
            _timeVersion++;   // bump the cascade so @Body (every visible timestamp) re-renders
            StateHasChanged();
        });
    }

    // --- Display preferences follow the account ---
    // theme.js / time.js report every theme, sidebar, density, time-zone or clock change here, and the whole set is
    // saved to the user's profile. Someone with nothing saved yet gets what their browser remembers copied up once,
    // so moving to account-level preferences doesn't reset anybody.
    private DotNetObjectReference<MainLayout>? _prefsRef;

    private async Task StartDisplayPrefSync()
    {
        try
        {
            _prefsRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("imPrefs.register", _prefsRef);
            if (await DisplayPrefs.GetMineAsync() is null) await OnDisplayPrefsChanged();
        }
        catch (JSException) { /* interop unavailable: the browser keeps its own copy */ }
        catch (JSDisconnectedException) { }
        // BUG-368: a convenience; a database failure here mustn't take the circuit down with it. BUG-702: a failed read
        // is a DbException (or a timeout), not a DbUpdateException; this is outside the ErrorBoundary.
        catch (Exception ex) when (ex is Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException
                                       or System.Data.Common.DbException or TimeoutException)
        {
            Logger.LogWarning(ex, "Couldn't sync display preferences; the browser keeps its own copy");
        }
    }

    [JSInvokable]
    public async Task OnDisplayPrefsChanged()
    {
        try
        {
            var prefs = new IncidentManager.Application.Preferences.DisplayPrefs(
                DarkTheme: await JS.InvokeAsync<string>("imTheme.current") == "dark",
                NavCollapsed: await JS.InvokeAsync<bool>("imNav.collapsed"),
                LocalTime: await JS.InvokeAsync<string>("imTime.mode") == "local",
                TwelveHourClock: await JS.InvokeAsync<string>("imTime.clock") == "12",
                CompactRows: await JS.InvokeAsync<string>("imDensity.current") == "compact");
            await DisplayPrefs.SaveMineAsync(prefs);
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (Exception ex) when (ex is Microsoft.EntityFrameworkCore.DbUpdateException or InvalidOperationException
                                       or System.Data.Common.DbException or TimeoutException)   // BUG-368, BUG-702
        {
            Logger.LogWarning(ex, "Couldn't save display preferences; the browser keeps its own copy");
        }
    }

    public void Dispose()
    {
        TimeDisp.Changed -= OnTimeChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Tabs.Changed -= OnTabsChanged;
        _prefsRef?.Dispose();
    }
}
