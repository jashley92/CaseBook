    </AuthorizeView>
    <NavLink class="im-part" href="program/improvement-actions" Match="NavLinkMatch.All">Improvement actions</NavLink>
    <NavLink class="im-part" href="program/legal" Match="NavLinkMatch.All">Legal register</NavLink>
    <NavLink class="im-part" href="program/report" Match="NavLinkMatch.All">Program report</NavLink>
</nav>
