@* UX-52: the one tab bar. Two levels, nothing else: Page (underlined; the views of a page or a case) and Sub (segmented;
   the lenses or parts inside one view). The audit found six tab styles, one per screen that drew its own. Items are links
   (Href: the address says which is current) or buttons (Key + OnSelect, with Active naming the current one). *@
<nav class="im-tabbar im-tabbar-@(Level == TabLevel.Sub ? "sub" : "page") @Class" aria-label="@Label">
    @foreach (var item in Items)
    {
        var i = item;
        if (i.Href is not null)
        {
            <NavLink class="im-tabbar-item" href="@i.Href" Match="NavLinkMatch.All" title="@i.Title">
                @if (i.Icon is not null) { <span class="bi @i.Icon" aria-hidden="true"></span> }
                <span>@i.Label</span>
                @if (i.Count is { } n) { <span class="im-tabbar-count">@n</span> }
                @if (i.Attention is { } a) { <span class="im-tabbar-attn">@a</span> }
            </NavLink>
        }
        else
        {
            var on = string.Equals(i.Key, Active, StringComparison.Ordinal);
            <button type="button" class="im-tabbar-item @(on ? "active" : "")" aria-current="@(on ? "page" : null)" title="@i.Title"
                    @onclick="() => OnSelect.InvokeAsync(i.Key)">
                @if (i.Icon is not null) { <span class="bi @i.Icon" aria-hidden="true"></span> }
                <span>@i.Label</span>
                @if (i.Count is { } n) { <span class="im-tabbar-count">@n</span> }
                @if (i.Attention is { } a) { <span class="im-tabbar-attn">@a</span> }
            </button>
        }
    }
    @if (End is not null)
    {
        <span class="im-tabbar-end">@End</span>
    }
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TabBarItem> Items { get; set; } = [];
    [Parameter] public TabLevel Level { get; set; } = TabLevel.Page;
    /// <summary>For button items: the key of the current one.</summary>
    [Parameter] public string? Active { get; set; }
    [Parameter] public EventCallback<string?> OnSelect { get; set; }
    /// <summary>The bar's accessible name ("Case views", "Program").</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    /// <summary>Controls at the bar's end (a view menu, an Add button), on the same row.</summary>
    [Parameter] public RenderFragment? End { get; set; }
    [Parameter] public string? Class { get; set; }
}
