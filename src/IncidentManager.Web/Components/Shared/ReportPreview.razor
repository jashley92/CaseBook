@using IncidentManager.Application.Reporting

@*
    In-app HTML preview of a generated case report (U-37). Renders the same CaseReportModel the Word report
    generator consumes, in the same section order (the case's chosen report profile / global layout), so an
    analyst or approver can see what they're about to Generate / Approve without pulling the file. Read-only.
    Timestamps render in UTC to match the forensic artifacts (the Word report uses UTC), not the per-user toggle.
*@

@if (Model is null)
{
    <p class="text-muted mb-0"><em>Nothing to preview.</em></p>
}
else
{
    <div class="im-report-preview border rounded p-4 bg-body">
        <div class="text-center border-bottom pb-2 mb-3">
            @if (Model.LogoBytes is { Length: > 0 })
            {
                <img class="mb-2" style="max-height:48px" src="@LogoDataUri(Model)" alt="Logo" />
            }
            @if (Model.Tlp is { } tlp)
            {
                <div class="text-end mb-1"><span class="im-tlp" style="color:#@IncidentManager.Domain.Enums.Tlp.Color(tlp)">@IncidentManager.Domain.Enums.Tlp.Label(tlp)</span></div>
            }
            <div class="fw-bold">@Org</div>
            <div class="small text-muted">@Team</div>
        </div>

        <h4 class="mb-1">@Model.CaseNumber — @Model.Title</h4>
        <div class="small text-muted mb-3">
            Classification: @Model.Classification &nbsp;&middot;&nbsp; Phase: @Model.Phase &nbsp;&middot;&nbsp; Severity: @Model.Severity<br />
            Origin: @Model.Origin@(Model.VendorName is null ? "" : $" ({Model.VendorName})")
            @if (Model.DetectionCaseId is not null) { <text> &nbsp;&middot;&nbsp; Detection case: @Model.DetectionCaseId</text> }
            @if (Model.SharingLine is { } sharing) { <br />@sharing }
            @foreach (var line in Model.FactsLines) { <br />@line }   @* BUG-517: as the Word facts (BUG-81) *@
        </div>

        @foreach (var section in Model.Sections)
        {
            <section class="mb-3">
                <h6 class="text-uppercase border-bottom pb-1" style="color:#44546A">@Heading(section)</h6>
                @switch (section)
                {
                    case ReportSection.Summary:
                        <RichBlocksView Blocks="Model.SummaryBlocks" />
                        break;

                    case ReportSection.BusinessImpact:
                        @* BUG-517: the lines the Word report prints, from the model. *@
                        @if (Model.BusinessImpactLines is not { Count: > 0 } impact)
                        {
                            <p class="mb-0 text-muted fst-italic">(no impact assessment recorded)</p>
                        }
                        else
                        {
                            <ul class="mb-0 small">
                                @foreach (var line in impact) { <li>@line</li> }
                            </ul>
                        }
                        break;

                    case ReportSection.EventTimeline:
                        @* BUG-517: a vendor case's "Where" column, captions and disclosure milestones, as in the Word report. *@
                        @if (Model.ShowsAttackChain)
                        {
                            <p class="small fst-italic text-muted mb-1">@Model.AttackChainCaption</p>
                            @foreach (var png in Model.AttackChainImages)
                            {
                                <img class="img-fluid border rounded mb-2" src="@Png(png)" alt="@CaseReportModel.AttackChainAlt" />
                            }
                            @if (Model.AttackChain.Count == 0)
                            {
                                <p class="mb-0 text-muted fst-italic">(none)</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered small mb-0">
                                        <thead><tr>@foreach (var h in Model.AttackChainHeaders) { <th>@h</th> }</tr></thead>
                                        <tbody>
                                            @foreach (var x in Model.AttackChain)
                                            {
                                                var cells = Model.AttackChainRow(x);
                                                <tr>
                                                    @for (var i = 0; i < cells.Length; i++)
                                                    {
                                                        <td class="@(i == 1 && x.Stated is null ? "text-nowrap" : "")">@cells[i]</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                @if (Model.AttackChain.Any(x => x.Stated is not null))
                                {
                                    <p class="small fst-italic text-muted mt-1 mb-0">@ReportAttackStep.ApproximateNote</p>
                                }
                            }
                        }
                        @if (Model.DisclosureMilestones.Count > 0)
                        {
                            <p class="small fw-semibold mt-2 mb-0" style="color:#44546A">Disclosure milestones</p>
                            <p class="small fst-italic text-muted mb-1">@CaseReportModel.DisclosureCaption</p>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered small mb-0">
                                    <thead><tr>@foreach (var h in CaseReportModel.DisclosureHeaders) { <th>@h</th> }</tr></thead>
                                    <tbody>
                                        @foreach (var x in Model.DisclosureMilestones)
                                        {
                                            var cells = CaseReportModel.DisclosureRow(x);
                                            <tr>
                                                @for (var i = 0; i < cells.Length; i++)
                                                {
                                                    <td class="@(i == 0 && x.Stated is null ? "text-nowrap" : "")">@cells[i]</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        break;

                    case ReportSection.InvestigationTimeline:
                        <p class="small fst-italic text-muted mb-1">@ReportTimelineItem.InvestigationSubtitle(Model.InvestigationTimeline)</p>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered small mb-0">
                                <thead><tr><th>When (UTC)</th><th>Type</th><th>Description</th><th>By</th></tr></thead>
                                <tbody>
                                    @if (Model.InvestigationTimeline.Count == 0)
                                    {
                                        <tr><td colspan="4" class="text-muted">(none)</td></tr>
                                    }
                                    @foreach (var x in Model.InvestigationTimeline)
                                    {
                                        <tr><td class="text-nowrap">@x.OccurredAtUtc.ToString("u")</td><td>@x.Type</td><td>@x.DescriptionWithSource</td><td>@x.By</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        break;

                    case ReportSection.SystemsReviewed:
                        <p class="small fst-italic text-muted mb-1">Entities and indicators examined during the investigation.@(Model.IndicatorsDefanged ? " " + CaseReportModel.DefangNote : "")</p>
                        @if (Model.EntityGraphImage is { } graph)
                        {
                            <img class="img-fluid border rounded mb-2" src="@Png(graph)" alt="@CaseReportModel.EntityGraphAlt" />
                        }
                        @if (Model.SystemsImpactedAssetsLine is { } assets)
                        {
                            <p class="small mb-1">@assets</p>
                        }
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered small mb-0">
                                <thead><tr>@foreach (var h in CaseReportModel.EntityHeaders) { <th>@h</th> }</tr></thead>
                                <tbody>
                                    @if (Model.Entities.Count == 0)
                                    {
                                        <tr><td colspan="@CaseReportModel.EntityHeaders.Length" class="text-muted">(none)</td></tr>
                                    }
                                    @foreach (var x in Model.Entities)
                                    {
                                        var cells = CaseReportModel.EntityRow(x);
                                        <tr>
                                            @for (var i = 0; i < cells.Length; i++)
                                            {
                                                if (i == 1) { <td><code class="small">@cells[i]</code></td> }
                                                else { <td>@cells[i]</td> }
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        break;

                    case ReportSection.Indicators:
                        <p class="small fst-italic text-muted mb-1">@Model.IocCaption</p>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered small mb-0">
                                <thead><tr><th>Type</th><th>Indicator</th><th>Verdict</th><th>TLP</th><th>Added (UTC)</th><th>Context</th></tr></thead>
                                <tbody>
                                    @if (Model.Iocs.Count == 0)
                                    {
                                        <tr><td colspan="6" class="text-muted">(none)</td></tr>
                                    }
                                    @foreach (var x in Model.Iocs)
                                    {
                                        <tr><td>@x.Type</td><td><code class="small">@x.Value</code></td><td>@x.Verdict</td><td>@(x.Tlp ?? "—")</td><td class="text-nowrap">@x.Added</td><td>@x.Description</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        break;

                    case ReportSection.Recommendations:
                        <p class="small fst-italic text-muted mb-1">Tasks recorded on the case, with their status.</p>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered small mb-0">
                                <thead><tr><th>Task</th><th>Owner</th><th>Due (UTC)</th><th>Status</th><th>Result</th></tr></thead>
                                <tbody>
                                    @if (Model.ActionItems.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-muted">(none)</td></tr>
                                    }
                                    @foreach (var x in Model.ActionItems)
                                    {
                                        <tr><td>@x.Title</td><td>@x.Owner</td><td>@(x.DueAtUtc?.ToString("u"))</td><td>@x.StatusLine</td><td>@x.Result</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        break;

                    case ReportSection.Outcome:
                        <ul class="mb-0 small">
                            @if (Model.Outcome is { } outcome) { <li><strong>Outcome: @outcome</strong></li> }
                            @if (Model.Conclusion is { } conclusion) { <li>Conclusion: @conclusion</li> }
                            <li>Current phase: @Model.Phase. Classification: @Model.Classification. Severity: @Model.Severity.</li>
                            @* BUG-517: the dated stamps in order (activity began, recovery started), after-closure note and
                               legal pointer, as the Word report prints them. *@
                            @foreach (var stamp in Model.OutcomeStamps) { <li>@stamp</li> }
                            @if (Model.ChangedAfterClosure is { } after) { <li>@after</li> }
                            @if (Model.OutcomeLegalPointer is { } legal) { <li>@legal</li> }
                        </ul>
                        break;

                    case ReportSection.CaseBrief:
                        @if (Model.Brief is { } brief)
                        {
                            <p class="small fst-italic text-muted mb-1">The team's working understanding, version @brief.Version, revised @brief.RevisedAtUtc.ToString("u") by @brief.RevisedBy.</p>
                            @foreach (var (label, text) in new (string, string?)[] { ("Working assessment", brief.WorkingAssessment), ("Known", brief.Known), ("Open questions", brief.OpenQuestions), ("Next steps", brief.NextSteps) })
                            {
                                if (text is null) continue;
                                <p class="small fw-semibold mb-0">@label</p>
                                <p class="small" style="white-space:pre-wrap">@text</p>
                            }
                        }
                        else { <p class="small mb-0">(no brief written)</p> }
                        break;

                    case ReportSection.AnalystNotes:
                        <p class="small fst-italic text-muted mb-1">Working notes recorded during the investigation, as written.</p>
                        @if (Model.Notes.Count == 0) { <p class="small mb-0">(none)</p> }
                        @foreach (var n in Model.Notes)
                        {
                            <p class="small fw-semibold mb-0">[@n.AtUtc.ToString("u")] @n.Author</p>
                            @* BUG-517: a note keeps its formatting, as in Word. *@
                            @if (n.Blocks is { Count: > 0 } blocks) { <RichBlocksView Blocks="blocks" /> }
                            else { <p class="small" style="white-space:pre-wrap">@n.Body</p> }
                        }
                        break;

                    case ReportSection.Appendix:
                        <p class="small fst-italic text-muted mb-1">Full structured record: assignments, relationships, ATT&amp;CK, history, evidence index.</p>
                        <ul class="small mb-0">
                            <li>Assignments: @Model.Assignments.Count</li>
                            <li>Entity relationships: @Model.Relationships.Count</li>
                            <li>MITRE ATT&amp;CK techniques: @Model.Techniques.Count</li>
                            <li>Classification changes: @Model.ClassificationHistory.Count &nbsp;·&nbsp; Severity changes: @Model.SeverityHistory.Count</li>
                            <li>Evidence items: @Model.Evidence.Count</li>
                        </ul>
                        break;
                }
            </section>
        }

        <div class="small fst-italic text-muted border-top pt-2 mt-3">
            Generated by @Model.GeneratedBy at @Model.GeneratedAtUtc.ToString("u"). Case content hash: <code class="small">@Model.ContentHash</code>
        </div>
    </div>
}

@code {
    /// <summary>The projected report to render. Null shows an empty state.</summary>
    [Parameter] public CaseReportModel? Model { get; set; }

    private string Org => string.IsNullOrWhiteSpace(Model!.OrganizationName) ? "[Company Name]" : Model.OrganizationName!;
    private string Team => string.IsNullOrWhiteSpace(Model!.TeamName) ? "[Team Name]" : Model.TeamName!;

    private static string Heading(ReportSection s) => s switch
    {
        ReportSection.Summary => "Summary",
        ReportSection.BusinessImpact => "Business Impact",
        ReportSection.EventTimeline => "Event Timeline",
        ReportSection.InvestigationTimeline => "Investigation Timeline",
        ReportSection.SystemsReviewed => "Systems Reviewed",
        ReportSection.Indicators => "Indicators of Compromise",
        ReportSection.Recommendations => "Response Tasks",
        ReportSection.Outcome => "Outcome",
        ReportSection.AnalystNotes => "Analyst Notes",
        ReportSection.CaseBrief => "Case Brief",
        ReportSection.Appendix => "Appendix",
        _ => s.ToString()
    };

    // PROD-46: the report pictures, inline (the same PNGs the Word report embeds).
    private static string Png(byte[] bytes) => $"data:image/png;base64,{Convert.ToBase64String(bytes)}";

    private static string LogoDataUri(CaseReportModel m) =>
        $"data:{(string.IsNullOrWhiteSpace(m.LogoContentType) ? "image/png" : m.LogoContentType)};base64,{Convert.ToBase64String(m.LogoBytes!)}";
}
