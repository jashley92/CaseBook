@* Visual MITRE ATT&CK matrix picker. Tactics are columns; techniques stack beneath the tactic(s)
   they belong to, so choosing a technique in a column *is* choosing its tactic. Sub-techniques are
   collapsed under their parent. Multi-select with add + remove: the grid reflects what's already
   tagged, and Apply syncs the difference. Off-catalogue tags (not in ATT&CK v19.1) are preserved and
   shown in their own strips so they aren't silently dropped: ids ATT&CK retired (with "Replace with" the technique that
   replaced them, under a tactic it has) and custom ids. Backs the Overview technique tag.
   While filtering, only the tactics with a match show, side by side from the left, under a line saying how many
   (AttackMatrixView); the others fold away with a short transition. *@

@using IncidentManager.Application.Mitre
@using IncidentManager.Web.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="atkm-backdrop" @onclick="Cancel"></div>
<div class="atkm-panel" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="@_titleId" @onclick:stopPropagation="true"
     @onkeydown="OnPanelKey">
    <div class="atkm-head">
        <h2 class="atkm-title" id="@_titleId">
            <span class="bi bi-diagram-3 me-2" aria-hidden="true"></span>@(SingleSelect ? "Choose a technique" : "Select ATT&CK techniques") <span class="text-muted small fw-normal">@AttackCatalog.Version</span>
        </h2>
        <div class="atkm-search">
            <span class="bi bi-search" aria-hidden="true"></span>
            @* Bound (not value= with @oninput) so a render never sends older text over newer keystrokes; see OnFilter. *@
            <input @ref="_filterBox" class="form-control form-control-sm" placeholder="Filter by ID or name…"
                   @bind:get="_text" @bind:set="OnFilter" @bind:event="oninput" @onkeydown="OnFilterKey" aria-label="Filter techniques" />
            @if (_text.Length > 0)
            {
                <button type="button" class="btn btn-sm btn-link p-0 ms-1" @onclick="ClearFilter" title="Clear filter">Clear</button>
            }
        </div>
        <button type="button" class="btn-close" aria-label="Close" @onclick="Cancel"></button>
    </div>

    @* A retired id typed in the filter says where it went. A tag is a technique under a tactic, so "Show" filters to the
       replacement and the user picks it in the column they mean. *@
    @if (AttackCatalog.Retired(_view.Filter) is { } filtered)
    {
        <div class="atkm-note small" role="status">
            <span class="bi bi-info-circle" aria-hidden="true"></span> @AttackCatalog.RetiredText(filtered)
            @if (filtered.ReplacedBy is { } by)
            {
                <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" @onclick="() => ShowTechnique(by.Id)">@($"Show {by.Id}")</button>
            }
        </div>
    }

    @if (_view.Summary is { } summary)
    {
        <div class="atkm-filterline small text-muted" role="status">@summary</div>
    }

    @* Every tactic stays in the grid: one with no match folds away (CSS) rather than leaving, so the rest slide into place.
       A folded column is inert: out of the tab order and the accessibility tree. *@
    <div class="atkm-grid" @ref="_grid">
        @if (_view.NoMatchText is { } none)
        {
            <div class="atkm-nomatch" role="status">@none</div>
        }
        @foreach (var col in _view.Columns)
        {
            var rows = col.Rows;
            var selN = col.Hidden ? 0 : rows.Count(r => IsSel(r.Row.Parent.Id, col.Tactic) || r.Row.Subs.Any(s => IsSel(s.Id, col.Tactic)));
            <div @key="col.Tactic" class="atkm-col @(col.Hidden ? "atkm-col-hidden" : "")" style="--tac:@Ui.TacticColor(col.Tactic)"
                 aria-hidden="@(col.Hidden ? "true" : null)" inert="@col.Hidden">
                <div class="atkm-colhead @(TacticPickable ? "atkm-colhead-btn" : "")"
                     title="@ColumnTitle(col.Tactic)"
                     role="@(TacticPickable ? "button" : null)" tabindex="@(TacticPickable ? "0" : null)"
                     @onclick="() => PickTacticHeader(col.Tactic)" @onkeydown="async e => { if (TacticPickable && IsActivate(e)) await PickTacticHeader(col.Tactic); }">
                    <span class="bi @Ui.TacticGlyph(col.Tactic)" aria-hidden="true"></span>
                    <span class="atkm-colname">@Ui.Label(col.Tactic)</span>
                    @if (selN > 0) { <span class="atkm-colcount" aria-label="@selN selected">@selN</span> }
                </div>
                <div class="atkm-cells">
                    @foreach (var shown in rows)
                    {
                        var row = shown.Row;
                        var pid = row.Parent.Id;
                        var expanded = _expanded.Contains(pid) || shown.OpenForMatch;
                        <div class="atkm-row">
                            @* A parent listed only for its sub-techniques is a heading: it opens them, so it's expanded or
                               not, never pressed. *@
                            <div class="atkm-cell @CellClass(pid, col.Tactic, row.ParentInTactic)"
                                 role="button" tabindex="0"
                                 aria-pressed="@(row.ParentInTactic ? (IsSel(pid, col.Tactic) ? "true" : "false") : null)"
                                 aria-expanded="@(row.ParentInTactic || row.Subs.Count == 0 ? null : (expanded ? "true" : "false"))"
                                 aria-label="@($"{pid} {row.Parent.Name}, {Ui.Label(col.Tactic)}")"
                                 @onclick="() => ToggleParent(row, col.Tactic)" @onkeydown="async e => { if (IsActivate(e)) await ToggleParent(row, col.Tactic); }">
                                @if (row.Subs.Count > 0)
                                {
                                    <button type="button" class="atkm-exp" @onclick="() => ToggleExpand(pid)" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true"
                                            aria-label="@(expanded ? "Collapse" : "Expand") the sub-techniques of @pid" aria-expanded="@(expanded ? "true" : "false")">
                                        <span class="bi @(expanded ? "bi-caret-down-fill" : "bi-caret-right-fill")" aria-hidden="true"></span>
                                    </button>
                                }
                                else
                                {
                                    <span class="atkm-exp-spacer"></span>
                                }
                                <span class="atkm-tid"><code>@pid</code></span>
                                <span class="atkm-tname" title="@row.Parent.Name">@row.Parent.Name</span>
                                @if (row.Subs.Count > 0) { <span class="atkm-subn" title="@row.Subs.Count sub-techniques">@row.Subs.Count</span> }
                                @if (IsSel(pid, col.Tactic)) { <span class="bi bi-check2 atkm-tick" aria-hidden="true"></span> }
                                else if (IsSelElsewhere(pid, col.Tactic)) { <span class="atkm-elsew" title="Tagged under @Ui.Label(_selected[pid])">•</span> }
                            </div>
                            @if (expanded)
                            {
                                @foreach (var sub in shown.ShownSubs)
                                {
                                    <div class="atkm-cell atkm-subcell @CellClass(sub.Id, col.Tactic, true)"
                                         role="button" tabindex="0" aria-pressed="@(IsSel(sub.Id, col.Tactic) ? "true" : "false")"
                                         aria-label="@($"{sub.Id} {sub.Name}, {Ui.Label(col.Tactic)}")"
                                         @onclick="() => ToggleTechnique(sub.Id, col.Tactic)" @onkeydown="async e => { if (IsActivate(e)) await ToggleTechnique(sub.Id, col.Tactic); }">
                                        <span class="atkm-tid"><code>@sub.Id</code></span>
                                        <span class="atkm-tname" title="@sub.Name">@sub.Name</span>
                                        @if (IsSel(sub.Id, col.Tactic)) { <span class="bi bi-check2 atkm-tick" aria-hidden="true"></span> }
                                        else if (IsSelElsewhere(sub.Id, col.Tactic)) { <span class="atkm-elsew" title="Tagged under @Ui.Label(_selected[sub.Id])">•</span> }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (!SingleSelect && RetiredTags() is { Count: > 0 } retired)
    {
        <div class="atkm-retired">
            <span class="text-muted small me-1">No longer in ATT&amp;CK @AttackCatalog.Version:</span>
            @foreach (var (tag, gone) in retired)
            {
                <span class="im-chip" title="@AttackCatalog.RetiredText(gone)"><code>@tag.Key</code> <span class="im-chip-role">@Ui.Label(tag.Value)</span>
                    <button type="button" class="im-chip-x" aria-label="Remove @tag.Key" @onclick="() => RemoveCustom(tag.Key)">×</button>
                </span>
                @if (gone.ReplacedBy is { } by && !_selected.ContainsKey(by.Id))
                {
                    <button type="button" class="btn btn-link btn-sm p-0 me-2" @onclick="() => Replace(tag.Key, by)"
                            title="@($"Tag {by.Id} {by.Name} under {Ui.Label(AttackCatalog.ReplacementTactic(by, tag.Value))} instead")">@($"Replace with {by.Id}")</button>
                }
            }
        </div>
    }

    @if (!SingleSelect && (_customTags.Count > 0 || _customOpen))
    {
        <div class="atkm-custom">
            <span class="text-muted small me-1">Custom:</span>
            @foreach (var c in _customTags)
            {
                <span class="im-chip"><code>@c.Key</code> <span class="im-chip-role">@Ui.Label(c.Value)</span>
                    <button type="button" class="im-chip-x" aria-label="Remove @c.Key" @onclick="() => RemoveCustom(c.Key)">×</button>
                </span>
            }
            @if (_customOpen)
            {
                <input class="form-control form-control-sm atkm-custom-in" placeholder="T1234[.001]" aria-label="Technique ID" @bind:get="_customId" @bind:set="v => _customId = v ?? string.Empty" @bind:event="oninput" />
                <select class="form-select form-select-sm atkm-custom-in" aria-label="Tactic" @bind="_customTactic">
                    @foreach (var t in AttackMatrixView.Tactics)
                    {
                        <option value="@t">@Ui.Label(t)</option>
                    }
                </select>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddCustom">Add</button>
                @if (_customError is not null) { <span class="small text-danger ms-1">@_customError</span> }
            }
            else
            {
                <button type="button" class="im-chip-add" @onclick="() => _customOpen = true"><span class="bi bi-plus-lg" aria-hidden="true"></span> Custom</button>
            }
        </div>
    }

    <div class="atkm-foot">
        @if (SingleSelect)
        {
            <div class="atkm-summary small text-muted">Click a technique under the tactic you mean@(AllowTacticOnly ? ", or click a tactic header to record the tactic only." : ".")</div>
            <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
        }
        else
        {
            <div class="atkm-summary small text-muted" role="status">
                @Delta() selected@(ChangeCount() > 0 ? $" · +{AddedCount()} / −{RemovedCount()}{(RetaggedCount() > 0 ? $" / ~{RetaggedCount()}" : "")} on apply" : "")
            </div>
            @if (!_customOpen && _customTags.Count == 0)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary me-auto" @onclick="() => _customOpen = true">
                    <span class="bi bi-plus-lg me-1" aria-hidden="true"></span>Not in the matrix?
                </button>
            }
            @* U-46: separate the discarding Cancel from the primary Apply so they aren't an easy mis-click. *@
            <button type="button" class="btn btn-outline-secondary me-3" @onclick="Cancel">Cancel</button>
            <button type="button" class="btn btn-primary" @onclick="Apply">Apply</button>
        }
    </div>
</div>

@code {
    // Keyboard activation for the matrix cells (role="button"): Enter or Space, like a native button. Keys from
    // the nested expand button are its own, so they don't also toggle the cell. C6: a held key acts once (its repeats
    // toggled the cell on and off, or picked it again).
    private static bool IsActivate(KeyboardEventArgs e) => e is { Repeat: false, Key: "Enter" or " " };

    [Parameter] public IReadOnlyDictionary<string, MitreTactic> Current { get; set; } = new Dictionary<string, MitreTactic>();
    [Parameter] public EventCallback<IReadOnlyDictionary<string, MitreTactic>> OnApply { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>Single-select mode (e.g. picking the ATT&amp;CK for one timeline step): clicking a cell
    /// immediately returns via <see cref="OnPick"/> and there is no add/remove.</summary>
    [Parameter] public bool SingleSelect { get; set; }

    /// <summary>In single-select mode, also let a tactic column header be picked (tactic-only, no
    /// technique) — <see cref="OnPick"/> then reports a null Id.</summary>
    [Parameter] public bool AllowTacticOnly { get; set; }

    /// <summary>Single-select result: the chosen technique id (null for a tactic-only header pick) + tactic.</summary>
    [Parameter] public EventCallback<(string? Id, MitreTactic Tactic)> OnPick { get; set; }

    private bool TacticPickable => SingleSelect && AllowTacticOnly;

    private readonly string _titleId = "atkm-" + Guid.NewGuid().ToString("N")[..8];
    private readonly Dictionary<string, MitreTactic> _selected = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private bool _initialized;

    private bool _customOpen;
    private string _customId = "";
    private MitreTactic _customTactic = MitreTactic.Execution;
    private string? _customError;

    protected override void OnParametersSet()
    {
        if (_initialized) return;
        _selected.Clear();
        foreach (var kv in Current) _selected[kv.Key.Trim().ToUpperInvariant()] = kv.Value;
        // Expand any parent that already has a tagged sub-technique, so current selections are visible.
        foreach (var id in _selected.Keys)
        {
            var dot = id.IndexOf('.');
            if (dot > 0) _expanded.Add(id[..dot]);
        }
        _initialized = true;
    }

    // The column head's tooltip: the tactic's id and what it is, and in tactic-only mode that a click records it.
    private string ColumnTitle(MitreTactic tac)
    {
        var what = $"{Ui.TacticId(tac)}: {Ui.TacticDescription(tac)}";
        return TacticPickable ? $"{what} Click to pick {Ui.Label(tac)} as a tactic-only step." : what;
    }

    // --- filtering: the columns are worked out once per change of the filter (AttackMatrixView), not on every render ---
    // The box shows each keystroke; the filter, the counts line and the columns' fold wait for typing to pause, so a word
    // typed is one change, not one a letter, and a later keystroke supersedes an earlier one. Until then only the box has
    // changed, and the browser already shows it, so the render Blazor makes as the handler first waits is skipped (unless
    // the Clear button comes or goes): a keystroke doesn't re-render the matrix. The box is bound with @bind:get/@bind:set,
    // so Blazor's copy of its value keeps step with the browser: a later render sends nothing, and only a clear changes it.
    private string _text = "";   // what's in the box, every keystroke; the matrix is filtered by _view.Filter once typing pauses
    private readonly TypingPause _pause = new();
    private bool _quiet;
    private AttackMatrixView _view = AttackMatrixView.Unfiltered;
    private bool _moved;

    internal async Task OnFilter(string? text)
    {
        var had = _text.Length > 0;
        _text = text ?? "";
        _quiet = had == (_text.Length > 0);
        if (await _pause.Settled()) SetFilter(_text);
        else _quiet = true; // superseded: nothing new to draw
    }

    // Enter applies what's typed at once (a held key, once).
    private void OnFilterKey(KeyboardEventArgs e)
    {
        if (e is not { Key: "Enter", Repeat: false }) return;
        _pause.Now();
        SetFilter(_text);
    }

    // A keystroke waiting out, or superseded in, its pause changes nothing on screen, so it doesn't re-render the matrix.
    protected override bool ShouldRender()
    {
        if (!_quiet) return true;
        _quiet = false;
        return false;
    }

    private async Task ClearFilter()
    {
        _pause.Now();
        _text = "";
        SetFilter("");
        // The Clear button goes with the filter: focus goes back to the box rather than dropping to the page.
        try { await _filterBox.FocusAsync(); } catch (Exception) { /* element gone */ }
    }

    private void SetFilter(string? value)
    {
        var next = AttackMatrixView.For(value, _view);
        _moved |= next.Layout != _view.Layout;
        _view = next;
        _quiet = false;
    }

    // --- selection ---
    private bool IsSel(string id, MitreTactic tac) => _selected.TryGetValue(id, out var t) && t == tac;
    private bool IsSelElsewhere(string id, MitreTactic tac) => _selected.TryGetValue(id, out var t) && t != tac;

    private string CellClass(string id, MitreTactic tac, bool selectable)
    {
        if (!selectable) return "atkm-header";
        if (IsSel(id, tac)) return "atkm-on";
        if (IsSelElsewhere(id, tac)) return "atkm-elsewhere";
        return "";
    }

    private async Task ToggleParent(AttackMatrixRow row, MitreTactic tac)
    {
        if (!row.ParentInTactic) { ToggleExpand(row.Parent.Id); return; } // header-only row: click expands
        await ToggleTechnique(row.Parent.Id, tac);
    }

    private async Task ToggleTechnique(string id, MitreTactic tac)
    {
        var key = id.ToUpperInvariant();
        if (SingleSelect) { await OnPick.InvokeAsync((key, tac)); return; }
        if (_selected.TryGetValue(key, out var cur) && cur == tac) _selected.Remove(key);
        else _selected[key] = tac;
    }

    private async Task PickTacticHeader(MitreTactic tac)
    {
        if (TacticPickable) await OnPick.InvokeAsync((null, tac));
    }

    private void ToggleExpand(string parentId)
    {
        if (!_expanded.Add(parentId)) _expanded.Remove(parentId);
    }

    // --- off-catalogue tags: retired ones (ATT&CK revoked or deprecated them) and custom ones (never in it) ---
    private IReadOnlyList<KeyValuePair<string, MitreTactic>> _customTags =>
        _selected.Where(kv => AttackCatalog.Find(kv.Key) is null && AttackCatalog.Retired(kv.Key) is null)
            .OrderBy(kv => kv.Key, StringComparer.OrdinalIgnoreCase).ToList();

    private List<(KeyValuePair<string, MitreTactic> Tag, RetiredTechnique Gone)> RetiredTags() =>
        _selected.Select(kv => (Tag: kv, Gone: AttackCatalog.Retired(kv.Key)))
            .Where(x => x.Gone is not null && AttackCatalog.Find(x.Tag.Key) is null)
            .OrderBy(x => x.Tag.Key, StringComparer.OrdinalIgnoreCase)
            .Select(x => (x.Tag, x.Gone!)).ToList();

    // A retired tag gives way to its replacement, under the tactic it had if the replacement is there too, else under the
    // replacement's primary tactic; the parent opens so the new tag is in view.
    private void Replace(string retiredId, AttackTechnique by)
    {
        if (!_selected.Remove(retiredId, out var had)) return;
        _selected[by.Id.ToUpperInvariant()] = AttackCatalog.ReplacementTactic(by, had);
        if (by.IsSubtechnique) _expanded.Add(by.ParentId);
    }

    // The filter's note on a retired id: filter to its replacement, applied at once.
    private void ShowTechnique(string id)
    {
        _pause.Now();
        _text = id;
        SetFilter(id);
    }

    private void AddCustom()
    {
        _customError = null;
        var id = (_customId ?? "").Trim().ToUpperInvariant();
        if (!System.Text.RegularExpressions.Regex.IsMatch(id, @"^T\d{4}(\.\d{3})?$",
                System.Text.RegularExpressions.RegexOptions.None, TimeSpan.FromSeconds(1)))  // S6444: bounded
        {
            _customError = "Use the format T1234 or T1234.001.";
            return;
        }
        _selected[id] = _customTactic;
        _customId = "";
    }

    private void RemoveCustom(string id) => _selected.Remove(id);

    // --- summary + apply ---
    private int Delta() => _selected.Count;
    private int AddedCount() => _selected.Keys.Count(k => !HasCurrent(k));
    private int RemovedCount() => Current.Keys.Count(k => !_selected.ContainsKey(k.ToUpperInvariant()));
    private int RetaggedCount() => _selected.Count(kv => TryCurrent(kv.Key, out var cur) && cur != kv.Value);
    private int ChangeCount() => AddedCount() + RemovedCount() + RetaggedCount();

    private bool HasCurrent(string key) => Current.Keys.Any(k => string.Equals(k, key, StringComparison.OrdinalIgnoreCase));
    private bool TryCurrent(string key, out MitreTactic tactic)
    {
        foreach (var kv in Current)
            if (string.Equals(kv.Key, key, StringComparison.OrdinalIgnoreCase)) { tactic = kv.Value; return true; }
        tactic = MitreTactic.Unspecified; return false;
    }

    private async Task Apply() => await OnApply.InvokeAsync(new Dictionary<string, MitreTactic>(_selected, StringComparer.OrdinalIgnoreCase));
    private async Task Cancel() => await OnCancel.InvokeAsync();

    // Keyboard: Escape closes without applying, like the app's other dialogs. Focus starts in the filter box, Tab stays
    // inside the panel, and closing gives focus back to what opened it (imModal). The panel takes focus itself on a
    // click on its text (tabindex="-1"), so Escape still reaches it.
    private ElementReference _filterBox;
    private ElementReference _grid;
    private bool _armed;
    private async Task OnPanelKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        _pause.Now(); // a pending filter doesn't land after the picker closes
        await Cancel();
    }

    // When a filter change moves the columns, the grid goes back to its left edge (smoothly, unless motion is reduced),
    // and focus left in a column that just folded away goes back to the box.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender) { await JS.InvokeVoidAsync("imModal.arm", ".atkm-panel"); _armed = true; }
            else if (_moved)
            {
                _moved = false;
                await JS.InvokeVoidAsync("imModal.toStart", _grid, _filterBox);
            }
        }
        catch (JSException) { /* the trap and the scroll are progressive enhancements */ }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { } // prerendering: no JS yet
    }

    // The picker leaves when it applies, cancels or picks.
    public async ValueTask DisposeAsync()
    {
        _pause.Now();
        if (!_armed) return;
        _armed = false;
        await JS.StopAsync("imModal.release");
    }
}
