@* BUG-101: breach-escalation and integrity-alarm emails that weren't delivered after every retry. Rendered for
   Administer users from MainLayout, like the integrity banners. Unlike those it can be cleared, one alert at a time,
   once an administrator has made sure the people it was for have heard (Mark handled, which records who). *@
@inject IncidentManager.Application.Notifications.UndeliveredAlertService Alerts
@inject TimeDisplay TimeDisp
@inject ToastService Toasts
@inject ILogger<UndeliveredAlertBanner> Logger
@implements IDisposable

@if (_alerts.Count > 0)
{
    <div class="integrity-alert" role="alert">
        <span class="bi bi-envelope-exclamation integrity-alert-icon" aria-hidden="true"></span>
        <div class="integrity-alert-text">
            <strong>@(_alerts.Count == 1 ? "An alert email wasn't delivered." : $"{_alerts.Count} alert emails weren't delivered.")</strong>
            They were tried @(IncidentManager.Domain.Entities.AlertDelivery.RetryAfter.Length + 1) times. Tell the people
            they were for some other way, then mark each one handled.
            <ul class="mb-0 mt-1 small">
                @foreach (var a in _alerts)
                {
                    <li>
                        @(a.Kind switch
                        {
                            IncidentManager.Domain.Entities.AlertDelivery.BreachEscalation => "Breach escalation",
                            IncidentManager.Domain.Entities.AlertDelivery.EvidenceDriftAlarm => "Evidence integrity alarm",
                            _ => "Audit-chain integrity alarm",
                        })
                        @if (a.CaseId is { } caseId) { <span>for <a href="@($"cases/{caseId}")"><code>@a.CaseNumber</code></a></span> }
                        to @string.Join(", ", a.Recipients), first tried @TimeDisp.Short(a.FirstFailedAtUtc).
                        <button type="button" class="btn btn-sm btn-light py-0 ms-1" disabled="@_dismissing.Busy" @onclick="() => Dismiss(a.Id)">Mark handled</button>
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    private IReadOnlyList<IncidentManager.Application.Notifications.UndeliveredAlert> _alerts = [];

    // BUG-177: an alert is given up about 2h40m after its first failure, usually while this page is already open, and
    // another administrator may mark one handled; so the list is read again every couple of minutes.
    private static readonly TimeSpan RefreshEvery = TimeSpan.FromMinutes(2);
    private Timer? _refresh;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (_disposed) return;   // BUG-566: gone while the list loaded; a timer now would never be stopped
        _refresh = new Timer(_ => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }), null, RefreshEvery, RefreshEvery);
    }

    // BUG-601: the timer's read and a Mark handled's read can overlap; the older one landing last brought back an alert
    // just marked handled.
    private readonly LoadSequence _load = new();

    private async Task LoadAsync()
    {
        var t = _load.Begin();
        try
        {
            var alerts = await Alerts.ListAsync();
            if (_load.IsCurrent(t)) _alerts = alerts;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            if (_load.IsCurrent(t)) _alerts = [];   // a banner never breaks the page
        }
    }

    private bool _disposed;   // BUG-566

    public void Dispose()
    {
        _disposed = true;
        _refresh?.Dispose();
    }

    // BUG-603: one at a time (a double-click marked it handled twice).
    private readonly InFlight _dismissing = new();

    private Task Dismiss(Guid id) => _dismissing.Run(() => DismissCore(id));

    private async Task DismissCore(Guid id)
    {
        try
        {
            await Alerts.DismissAsync(id);
            var t = _load.Begin();
            var alerts = await Alerts.ListAsync();
            if (_load.IsCurrent(t)) _alerts = alerts;
            Toasts.Success("Marked handled");
        }
        catch (ForbiddenException ex) { Toasts.Error(ex.Message); }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // BUG-178: the banner sits in the layout, outside the page's error boundary, so an error here would end the
            // whole session (and the unsaved work in the page below). Say so instead.
            Logger.LogError(ex, "Couldn't mark an undelivered alert handled.");
            Toasts.Error("Couldn't mark it handled. Try again in a moment.");
        }
    }
}
