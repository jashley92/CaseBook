@* U-28 / UX-12: friendly access-denied page. Windows auth lets a user sign in, but a page's policy can
   still fail — either because no AD group is mapped to a CaseBook role yet (no roles at all), or because
   the user holds roles that don't grant the specific permission the page needs. The bare framework text
   told them neither who they were nor what they had; this shows the signed-in identity, the roles they
   hold, and the permissions those grant, so they (and an admin they ask) can see exactly why a control is
   missing. Static markup only (CSP-safe). *@
@using IncidentManager.Application.Abstractions
@using IncidentManager.Domain.Enums
@inject ICurrentUser CurrentUser

<div class="access-denied">
    <div class="card access-denied-card">
        <div class="card-body empty-state">
            <span class="bi bi-shield-lock empty-state-icon" aria-hidden="true"></span>

            @if (!CurrentUser.IsAuthenticated)
            {
                <div class="empty-state-title">Not signed in</div>
                <div class="empty-state-msg">
                    Your session isn't authenticated. Close and reopen the browser, or contact a CaseBook
                    administrator if this persists.
                </div>
            }
            else if (CurrentUser.RoleNames.Count == 0)
            {
                <div class="empty-state-title">No access assigned yet</div>
                <div class="empty-state-msg">
                    You're signed in as <strong>@CurrentUser.DisplayName</strong>@_identityHint, but your
                    account hasn't been granted a role in CaseBook yet, so there's nothing here you can
                    open.
                </div>
                <div class="empty-state-msg text-muted">
                    Access is granted through your Active Directory group membership. Ask a CaseBook
                    administrator to add you to the security group for your team. A new AD group takes effect
                    after you next sign in to Windows.
                </div>
            }
            else
            {
                <div class="empty-state-title">You don't have access to that</div>
                <div class="empty-state-msg">
                    You're signed in as <strong>@CurrentUser.DisplayName</strong>@_identityHint.
                    @if (_required is { } need)
                    {
                        <span>That page needs the <strong>@AccessSummary.Label(need)</strong> permission
                            (@AccessSummary.Meaning(need)), which your role@(CurrentUser.RoleNames.Count == 1 ? " doesn't" : "s don't") grant.</span>
                    }
                    else
                    {
                        <span>That page or action needs a permission your role@(CurrentUser.RoleNames.Count == 1 ? " doesn't" : "s don't") grant.</span>
                    }
                </div>

                <div class="access-denied-grant">
                    <AccessSummary />
                </div>

                <div class="empty-state-msg text-muted">
                    If you need it, ask a CaseBook administrator. A change to what your role grants reaches you within a
                    few minutes; a new AD group takes effect after you next sign in to Windows.
                    <a href="account/access">See everything your role can do</a>.
                </div>
            }
        </div>
    </div>
</div>

@code {
    // A muted parenthetical to help an admin identify the exact account — the UPN when Windows auth
    // supplies one, otherwise the stable id. Suppressed when it would just repeat the display name.
    private MarkupString _identityHint;

    /// <summary>S-22: the path that was refused, so the page can name the permission it needs.</summary>
    [Parameter] public string? Path { get; set; }

    private Permission? _required;

    protected override void OnParametersSet() => _required = IncidentManager.Web.Security.PagePolicies.RequiredFor(Path);

    protected override void OnInitialized()
    {
        var hint = CurrentUser.UserPrincipalName;
        if (string.IsNullOrWhiteSpace(hint) &&
            !string.Equals(CurrentUser.UserId, CurrentUser.DisplayName, StringComparison.Ordinal))
        {
            hint = CurrentUser.UserId;
        }

        _identityHint = string.IsNullOrWhiteSpace(hint)
            ? default
            : (MarkupString)$" <span class=\"text-muted\">({System.Net.WebUtility.HtmlEncode(hint)})</span>";
    }

}
