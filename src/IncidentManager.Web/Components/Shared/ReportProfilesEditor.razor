@* UX-16: reusable report-profile editor, extracted from the old standalone "Report profiles" page so it
   sits with the rest of report configuration (defaults + section layout) on one "Reports" admin page.
   Rendered as a card to match the "Report sections" designer above it. Pure CRUD over ReportProfileService. *@
@using IncidentManager.Application.Admin
@using IncidentManager.Application.Reporting
@inject ReportProfileService Profiles
@inject ToastService Toasts

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><span class="bi bi-journal-text me-1"></span>Report profiles</span>
        <button class="btn btn-sm btn-primary" @onclick="BeginCreate" disabled="@(_edit is not null)">
            <span class="bi bi-plus-circle me-1"></span>New profile
        </button>
    </div>
    <div class="card-body">
        <p class="small text-muted">
            Reusable <strong>section layouts</strong> for printing a case, such as an <em>Executive summary</em> for
            leadership or a <em>Full examiner pack</em> for a DFS exam. A profile picked on a case's Report tab
            overrides the default layout above for that case's reports and preview.
        </p>

        @* PROD-47: optional customer-designed Word templates, one per profile. *@
        <div class="border rounded p-2 mb-3 small">
            <div class="fw-semibold mb-1"><span class="bi bi-file-earmark-word me-1" aria-hidden="true"></span>Word templates (optional)</div>
            <p class="mb-1 text-muted">
                Upload a .docx with <code>{{…}}</code> fields to give a profile's Word reports your own fonts, styles, headers and
                footers. PDF reports keep the built-in layout. A table row with a list field such as <code>{{ioc.value}}</code>
                repeats once per item, and <code>{{image.attack_chain}}</code> alone on a line becomes the picture. Templates with
                macros, embedded objects or external content are refused.
            </p>
            <a class="me-3" href="export/report-template-starter.docx" download><span class="bi bi-download me-1" aria-hidden="true"></span>Download the starter template</a>
            <details class="mt-1">
                <summary style="cursor:pointer; color: var(--im-accent-text)">Field reference: every {{…}} a template can use</summary>
                <div class="mt-2 im-template-fields">
                    <div class="fw-semibold">Single values</div>
                    <ul class="mb-2">
                        @foreach (var f in ReportTemplateFields.ScalarFields)
                        {
                            <li><code>{{@f.Name}}</code>: @f.Description</li>
                        }
                    </ul>
                    <div class="fw-semibold">Lists (the row or paragraph repeats per item)</div>
                    @foreach (var c in ReportTemplateFields.Collections)
                    {
                        <div class="mt-1">@c.Description:</div>
                        <div>@foreach (var f in c.Fields) { <code class="me-2" title="@f.Description">{{@f.Name}}</code> }</div>
                    }
                    <div class="fw-semibold mt-2">Pictures (alone in their paragraph, body only)</div>
                    <ul class="mb-0">
                        @foreach (var f in ReportTemplateFields.ImageFields)
                        {
                            <li><code>{{@f.Name}}</code>: @f.Description</li>
                        }
                    </ul>
                </div>
            </details>
        </div>

        @if (_templateProblems is { Count: > 0 })
        {
            <div class="alert alert-danger small py-2" role="alert">
                <div class="fw-semibold">That template wasn't accepted:</div>
                <ul class="mb-0">@foreach (var p in _templateProblems) { <li>@p</li> }</ul>
            </div>
        }

        @if (_edit is not null)
        {
            <div class="card mb-3 border-primary">
                <div class="card-header">@(_edit.IsNew ? "New profile" : $"Edit profile: {_edit.Name}")</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label">Name <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="_edit.Name" @bind:event="oninput" placeholder="e.g. Executive summary" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Description</label>
                            <input class="form-control" @bind="_edit.Description" @bind:event="oninput" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Sort order</label>
                            <input type="number" class="form-control" @bind="_edit.SortOrder" />
                        </div>
                    </div>

                    <h6 class="text-uppercase small text-muted mt-4">Sections</h6>
                    <p class="small text-muted mb-2">Choose which body sections this profile includes and their order.</p>
                    <ol class="list-group">
                        @for (var i = 0; i < _edit.Layout.Count; i++)
                        {
                            var idx = i;
                            var st = _edit.Layout[idx];
                            <li class="list-group-item d-flex align-items-center gap-2">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button class="btn btn-outline-secondary" title="Move up"
                                            disabled="@(idx == 0)" @onclick="() => MoveSection(idx, -1)">
                                        <span class="bi bi-arrow-up"></span>
                                    </button>
                                    <button class="btn btn-outline-secondary" title="Move down"
                                            disabled="@(idx == _edit.Layout.Count - 1)" @onclick="() => MoveSection(idx, 1)">
                                        <span class="bi bi-arrow-down"></span>
                                    </button>
                                </div>
                                <div class="form-check form-switch mb-0 flex-grow-1">
                                    <input class="form-check-input" type="checkbox" id="pf-sec-@st.Section"
                                           checked="@st.Enabled" @onchange="e => ToggleSection(idx, (bool)(e.Value ?? false))" />
                                    <label class="form-check-label @(st.Enabled ? "" : "text-muted")" for="pf-sec-@st.Section">
                                        @SectionLabel(st.Section)
                                        @if (!st.Enabled) { <span class="im-badge im-b-neutral ms-1">Hidden</span> }
                                    </label>
                                </div>
                                <span class="text-muted small">@(idx + 1)</span>
                            </li>
                        }
                    </ol>

                    <div class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" id="pf-active" @bind="_edit.IsActive" />
                        <label class="form-check-label" for="pf-active">Active <span class="text-muted small">(shown in the per-case profile picker)</span></label>
                    </div>
                </div>
                <div class="card-footer d-flex gap-2">
                    <button class="btn btn-sm btn-primary" @onclick="Save">Save</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _edit = null">Cancel</button>
                </div>
            </div>
        }

        @if (_profiles is null)
        {
            <p><em>Loading&hellip;</em></p>
        }
        else if (_profiles.Count == 0)
        {
            <p class="text-muted mb-0">No report profiles yet. Click <strong>New profile</strong> to add one.</p>
        }
        else
        {
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Profile</th><th>Sections</th><th>Word template</th><th style="width:9rem"></th></tr></thead>
                <tbody>
                    @foreach (var p in _profiles)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">@p.Name</span>
                                @if (!p.IsActive) { <span class="im-badge im-b-neutral ms-1">Inactive</span> }
                                <div class="small text-muted">@p.Description</div>
                            </td>
                            <td class="small">@SectionSummary(p.SectionLayout)</td>
                            <td class="small">
                                @if (p.TemplateFileName is { } tf)
                                {
                                    <a href="export/report-templates/@p.Id" download title="Download to edit, then upload again">@tf</a>
                                    <button class="btn btn-link btn-sm p-0 ms-2 text-danger align-baseline" @onclick="() => ConfirmRemoveTemplate(p)">Remove</button>
                                }
                                else
                                {
                                    <span class="text-muted">Built-in</span>
                                }
                                <label class="btn btn-sm btn-outline-secondary py-0 ms-2 mb-0" title="Upload a .docx template for this profile">
                                    @(p.TemplateFileName is null ? "Upload…" : "Replace…")
                                    <InputFile class="d-none" accept=".docx" OnChange="e => UploadTemplate(p, e)" />
                                </label>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary py-0" @onclick="() => BeginEdit(p)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => ConfirmDelete(p)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>


@* S-23: destructive actions state their consequence and ask first. *@
<ConfirmDialog @ref="_confirm" />

@code {
    private ConfirmDialog _confirm = null!;

    private void ConfirmDelete(ReportProfileView p) => _confirm.Ask(this, "Delete report profile",
        $"Delete the “{p.Name}” report profile? Cases set to it use the default report sections from now on.",
        "Delete profile", () => Delete(p));

    private List<ReportProfileView>? _profiles;
    private ProfileEdit? _edit;

    private sealed class ProfileEdit
    {
        public Guid? Id;
        public bool IsNew;
        public string Name = "";
        public string? Description;
        public bool IsActive = true;
        public int SortOrder;
        public List<ReportSectionState> Layout = [];
    }

    private static readonly Dictionary<ReportSection, string> SectionLabels = new()
    {
        [ReportSection.Summary] = "Summary",
        [ReportSection.BusinessImpact] = "Business Impact",
        [ReportSection.EventTimeline] = "Event Timeline",
        [ReportSection.InvestigationTimeline] = "Investigation Timeline",
        [ReportSection.SystemsReviewed] = "Systems Reviewed",
        [ReportSection.Indicators] = "Indicators of Compromise",
        [ReportSection.Recommendations] = "Recommendations",
        [ReportSection.Outcome] = "Outcome",
        [ReportSection.Appendix] = "Appendix (full structured record)",
    };

    private static string SectionLabel(ReportSection s) => SectionLabels.GetValueOrDefault(s, s.ToString());

    private static string SectionSummary(string? layout)
    {
        var enabled = ReportLayout.Resolve(layout);
        return enabled.Count == 0 ? "(none)" : string.Join(", ", enabled.Select(s => SectionLabels.GetValueOrDefault(s, s.ToString())));
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _profiles = await Profiles.ListAllAsync();

    // PROD-47: Word templates.
    private IReadOnlyList<string>? _templateProblems;

    private async Task UploadTemplate(ReportProfileView p, InputFileChangeEventArgs e)
    {
        _templateProblems = null;
        try
        {
            await using var stream = e.File.OpenReadStream(ReportProfileService.MaxTemplateBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var check = await Profiles.UploadTemplateAsync(p.Id, e.File.Name, ms.ToArray());
            if (!check.Ok) { _templateProblems = check.Problems; return; }
            await LoadAsync();
            Toasts.Success($"Template {e.File.Name} set for “{p.Name}” ({check.Placeholders.Count} fields). Word reports with this profile use it.");
        }
        catch (IOException) { _templateProblems = [$"A template must be {ReportProfileService.MaxTemplateBytes / 1024 / 1024} MB or smaller."]; }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { _templateProblems = [ex.Message]; }
    }

    private void ConfirmRemoveTemplate(ReportProfileView p) => _confirm.Ask(this, "Remove template",
        $"Stop using “{p.TemplateFileName}” for the “{p.Name}” profile? Its Word reports go back to the built-in layout. " +
        "Reports already generated are unchanged.",
        "Remove template", async () =>
        {
            try { await Profiles.RemoveTemplateAsync(p.Id); }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); return; }
            await LoadAsync();
            Toasts.Info("Template removed.");
        });

    private void BeginCreate() => _edit = new ProfileEdit
    {
        IsNew = true,
        SortOrder = (_profiles?.Count ?? 0) + 1,
        Layout = ReportLayout.Parse(null).ToList() // all sections, enabled, default order
    };

    private void BeginEdit(ReportProfileView p) => _edit = new ProfileEdit
    {
        Id = p.Id,
        IsNew = false,
        Name = p.Name,
        Description = p.Description,
        IsActive = p.IsActive,
        SortOrder = p.SortOrder,
        Layout = ReportLayout.Parse(p.SectionLayout).ToList()
    };

    private void MoveSection(int index, int delta)
    {
        if (_edit is null) return;
        var target = index + delta;
        if (target < 0 || target >= _edit.Layout.Count) return;
        (_edit.Layout[index], _edit.Layout[target]) = (_edit.Layout[target], _edit.Layout[index]);
    }

    private void ToggleSection(int index, bool enabled)
    {
        if (_edit is null) return;
        _edit.Layout[index] = _edit.Layout[index] with { Enabled = enabled };
    }

    private async Task Save()
    {
        if (_edit is null) return;

        var input = new ReportProfileInput(
            _edit.Name, _edit.Description, _edit.IsActive, _edit.SortOrder,
            ReportLayout.Serialize(_edit.Layout));

        try
        {
            if (_edit.IsNew) await Profiles.CreateAsync(input);
            else await Profiles.UpdateAsync(_edit.Id!.Value, input);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
            return;
        }

        _edit = null;
        await LoadAsync();
        Toasts.Success("Report profile saved");
    }

    private async Task Delete(ReportProfileView p)
    {
        try { await Profiles.DeleteAsync(p.Id); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
            return;
        }
        await LoadAsync();
        Toasts.Info($"Deleted report profile '{p.Name}'");
    }
}
