@* Renders report prose from RichText blocks — the same interpretation of the Markdown that the Word and PDF
   generators print — so the in-app report preview matches the generated document. Lists render with the
   document's own markers (not <ul>/<ol>) to mirror print exactly. *@
@using IncidentManager.Application.Content

@if (Blocks.Count == 0)
{
    <p class="mb-0 text-muted">@Empty</p>
}
else
{
    <div class="small">
        @foreach (var b in Blocks)
        {
            switch (b.Kind)
            {
                case RichBlockKind.Heading:
                    <div class="fw-semibold mt-2 mb-1" style="color:#44546A;@HeadingSize(b.Level)">@Runs(b)</div>
                    break;
                case RichBlockKind.Bullet or RichBlockKind.Numbered:
                    <div class="d-flex mb-1" style="padding-left:@((b.Level) * 1.25)rem">
                        <span class="flex-shrink-0 text-end me-2" style="min-width:1.25rem">@b.Marker</span>
                        <span>@Runs(b)</span>
                    </div>
                    break;
                case RichBlockKind.Quote:
                    <div class="fst-italic text-muted border-start ps-2 mb-1">@Runs(b)</div>
                    break;
                case RichBlockKind.Code:
                    <pre class="bg-body-tertiary p-2 mb-1 small">@b.PlainText</pre>
                    break;
                default:
                    <p class="mb-1" style="padding-left:@(b.Level * 1.25)rem">@Runs(b)</p>
                    break;
            }
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RichBlock> Blocks { get; set; } = [];
    [Parameter] public string Empty { get; set; } = "(not provided)";

    private static string HeadingSize(int level) => level switch { 1 => "font-size:1.05rem", 2 => "font-size:1rem", _ => "" };

    // Runs keep bold/italic/code; embedded newlines (hard breaks) become <br>. Text is encoded by Razor.
    private static RenderFragment Runs(RichBlock b) => builder =>
    {
        var seq = 0;
        foreach (var r in b.Runs)
        {
            var lines = r.Text.Split('\n');
            for (var i = 0; i < lines.Length; i++)
            {
                if (i > 0) { builder.OpenElement(seq++, "br"); builder.CloseElement(); }
                if (lines[i].Length == 0) continue;
                var tag = r.Code ? "code" : r.Bold && r.Italic ? "strong" : r.Bold ? "strong" : r.Italic ? "em" : null;
                if (tag is null) { builder.AddContent(seq++, lines[i]); continue; }
                builder.OpenElement(seq++, tag);
                if (r.Bold && r.Italic && !r.Code) builder.AddAttribute(seq++, "class", "fst-italic");
                builder.AddContent(seq++, lines[i]);
                builder.CloseElement();
            }
        }
    };
}
