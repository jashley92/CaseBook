@* INV-28: start a task where the work is (an entity, an evidence file, a timeline entry). Only the title is asked
   for; the task records what it's about, and the owner, due date and kind are set on the Tasks tab. *@
@implements IDisposable
@inject CaseService Cases
@inject ToastService Toasts
@inject UnsavedEdits Edits

@* BUG-425: im-own-keys: Ctrl/Cmd+Enter here adds this task (keymap.js leaves it to KeyDown), not the tab's composer. *@
<form class="im-quicktask im-own-keys" @onsubmit="Add" @onsubmit:preventDefault @onkeydown="KeyDown">
    <label class="visually-hidden" for="@_id">New task</label>
    <input id="@_id" class="form-control form-control-sm" maxlength="@ActionItem.MaxTitleLength" placeholder="@Placeholder"
           @bind="_title" @bind:event="oninput" @ref="_input" />
    <button type="submit" class="btn btn-sm btn-primary" disabled="@(_saving || string.IsNullOrWhiteSpace(_title))">Add task</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OnCancel.InvokeAsync()">Cancel</button>
    @if (_error is not null)
    {
        <div class="text-danger small w-100" role="alert">@_error</div>
    }
</form>

@code {
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    /// <summary>What the task is about: "entity:&lt;id&gt;", "evidence:&lt;id&gt;" or "entry:&lt;id&gt;".</summary>
    [Parameter, EditorRequired] public string About { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "What needs doing?";
    /// <summary>HR-17: a title to start from (a decision's text), edited before adding.</summary>
    [Parameter] public string? InitialTitle { get; set; }
    [Parameter] public EventCallback OnDone { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private readonly string _id = $"quicktask-{Guid.NewGuid():N}";
    private ElementReference _input;
    private string? _title;
    private string? _error;
    private bool _saving;

    [CascadingParameter] public EditRegion? Region { get; set; }

    protected override void OnInitialized()
    {
        _title = InitialTitle;
        // BUG-578: a title being typed is asked about before whatever holds this form hides it (a tab switch, a panel
        // moving on, leaving the case). The decision's own text, untouched, isn't unsaved input.
        Edits.Track(this, "the task you're adding",
            () => !string.IsNullOrWhiteSpace(_title) && !string.Equals(_title, InitialTitle, StringComparison.Ordinal), Region);
    }

    public void Dispose() => Edits.Forget(this);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await _input.FocusAsync(); } catch (Exception) { /* not focusable yet; harmless */ }
        }
    }

    private async Task KeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || !(e.CtrlKey || e.MetaKey) || e.Repeat) return;
        await Add();
    }

    private async Task Add()
    {
        if (_saving || string.IsNullOrWhiteSpace(_title)) return;   // WF-101
        _saving = true;
        _error = null;
        try
        {
            var sent = _title;
            await Cases.AddActionItemAsync(CaseId, sent, null, null, about: About);
            Toasts.Success("Task added");
            // BUG-601: what was typed during the save is kept, and the form with it; unchanged, the form is done.
            _title = DraftText.ClearIfUnchanged(_title, sent, null);
            if (_title is null) await OnDone.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            _error = ex.Message;
        }
        finally { _saving = false; }
    }
}
