@* A case's stored, hashed reports with download + approve-&-finalize. Shared by the Report tab (case report)
   and the Review tab (the separate lessons-learned report), so both kinds behave identically. *@
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject TimeDisplay TimeDisp

@if (Reports is null)
{
    <p><em>Loading&hellip;</em></p>
}
else if (Reports.Count == 0)
{
    <p class="text-muted">@EmptyText</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead><tr><th>File</th><th>Format</th><th>Ver</th><th>Status</th><th>SHA-256</th><th>Generated</th><th></th></tr></thead>
        <tbody>
            @foreach (var r in Reports)
            {
                <tr>
                    <td>@r.FileName</td>
                    <td>@r.Format</td>
                    <td>@r.Version</td>
                    <td>
                        @if (r.IsFinal)
                        {
                            <span class="im-badge im-b-ok">Final</span>
                            <div class="small text-muted">@Users.DisplayFor(r.ApprovedBy) · @TimeDisp.Long(r.ApprovedAtUtc)</div>
                        }
                        else
                        {
                            <span class="im-badge im-b-neutral">Draft</span>
                        }
                    </td>
                    <td><code class="small">@r.ContentSha256[..16]…</code></td>
                    <td class="small text-muted">@TimeDisp.Long(r.CreatedAtUtc)<br />@Users.DisplayFor(r.CreatedBy)</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" href="reports/@r.Id" target="_blank">Download</a>
                        @if (!r.IsFinal && r.Format == ReportFormat.Pdf)
                        {
                            <AuthorizeView Policy="@Policies.ApproveReports" Context="ap">
                                <button class="btn btn-sm btn-dark" @onclick="() => OnApprove.InvokeAsync(r.Id)">Approve &amp; finalize</button>
                            </AuthorizeView>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    /// <summary>The reports to list; null while loading.</summary>
    [Parameter] public IReadOnlyList<Report>? Reports { get; set; }
    [Parameter] public string EmptyText { get; set; } = "No reports generated yet.";
    /// <summary>Approve & finalize the given report id (the host tab owns the call + reload).</summary>
    [Parameter] public EventCallback<Guid> OnApprove { get; set; }
}
