@* CAP-40: one secret entered here in place of server configuration (Administer only, as the page is): the team-chat webhook
   URL or the SIEM webhook token, kept encrypted by Data Protection as CAP-05's Email sign-in keeps the SMTP password. The
   value is write-only: typed into a field that is never filled from the server, sent once on Save, and shown afterwards
   only as "set on <date> by <user>", with Replace and Clear. When the server's configuration sets it (a literal, a
   @cyberark: reference or a @protected: value), that wins, and this card shows it read-only. The secret's own test sits
   beside it: Send test for chat, Send test event for the SIEM. *@
@using IncidentManager.Application.Abstractions
@using IncidentManager.Web.Secrets
@inject StoredSecretAdminService Secrets
@inject IChatNotifier Chat
@inject IncidentManager.Web.Siem.SiemTestService SiemTest
@inject IConfiguration Config
@inject ToastService Toasts

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center"><span>@Title</span><span class="im-badge im-b-neutral" title="Saved with its own button, not with Save changes">Saves on its own</span></div>
    <div class="card-body">
        @if (Secrets.SetInServerConfiguration(Kind))
        {
            <p class="mb-1"><span class="im-badge im-b-neutral">Set in server configuration</span>
                <span class="ms-2 small">as @Secrets.ServerConfigurationForm(Kind)</span></p>
            <p class="form-text mb-0">
                The server's configuration sets the @Definition.Label (<code>@Definition.Name</code> in appsettings.Production.json),
                and it wins over this form, so it's read-only here. Change it on the server, or clear it there to manage it here.
            </p>
        }
        else if (_status is null)
        {
            <LoadingBlock />
        }
        else
        {
            @if (_status.Unreadable)
            {
                <div class="alert alert-warning py-2 small" role="alert">
                    The saved @Definition.Label can't be decrypted on this server (its Data Protection keys aren't here, as after a
                    database restored elsewhere), so nothing is sent with it. Re-enter the @Definition.Label.
                </div>
            }
            @if (Note is { Length: > 0 })
            {
                <div class="alert alert-info py-2 small" role="note">@Note</div>
            }
            <div style="max-width:38rem">
                <label class="form-label mb-0" for="@FieldId">@FieldLabel</label>
                @if (_status.Set && !_replacing)
                {
                    <div class="small mt-1">
                        <span class="im-badge im-b-ok">Set</span>
                        <span class="text-muted ms-1">on @(_status.SetAtUtc is { } setAt ? TimeDisplay.UtcDay(setAt) : "") by @(_status.SetBy ?? "an administrator")</span>
                    </div>
                    <div class="mt-1">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _replacing = true">Replace</button>
                        <button type="button" class="btn btn-sm btn-outline-danger ms-1" @onclick="Clear" disabled="@_clearing.Busy">Clear</button>
                    </div>
                }
                else
                {
                    @* Write-only: no value is ever rendered into this field; what's typed is read on change and sent once. *@
                    <input id="@FieldId" class="form-control" type="password" autocomplete="new-password" spellcheck="false"
                           @key="_fieldKey" @onchange="e => _newValue = e.Value as string" />
                    <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                        <button type="button" class="btn btn-primary" @onclick="Save" disabled="@_saving.Busy">Save</button>
                        @if (_status.Set)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelReplace">Cancel</button>
                        }
                    </div>
                }
            </div>
            @if (_status.UpdatedAtUtc is { } at)
            {
                <div class="small text-muted mt-1">Last changed @TimeDisplay.UtcLabelled(at) by @_status.UpdatedBy</div>
            }
            <div class="form-text">
                @Help The value is encrypted on this server (Data Protection) and never shown again. Changes apply to the next send,
                without a restart. To keep it in the server's configuration instead, see OPERATIONS.md section 6.
            </div>
        }

        <hr class="my-3" />
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <button type="button" class="btn btn-outline-primary" @onclick="SendTest" disabled="@_testing.Busy">@TestLabel</button>
            <span class="small text-muted">@TestHelp</span>
        </div>
        @if (_siemResults is { } results)
        {
            <ul class="list-unstyled small mt-2 mb-0">
                @foreach (var r in results)
                {
                    <li><span class="im-badge @(r.Delivered ? "im-b-ok" : "im-b-danger")">@r.Transport</span> <span class="ms-1">@r.Detail</span></li>
                }
            </ul>
        }
    </div>
</div>

@code {
    /// <summary>Which secret this card enters.</summary>
    [Parameter, EditorRequired] public StoredSecretKind Kind { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string FieldLabel { get; set; } = "";

    /// <summary>A sentence on what the secret is, before the card's own words on how it's kept.</summary>
    [Parameter] public string? Help { get; set; }

    /// <summary>A word on something else the secret needs (a switch that's off on the server), shown above the field.</summary>
    [Parameter] public string? Note { get; set; }

    private StoredSecretDefinition Definition => StoredSecretDefinition.For(Kind);
    private string FieldId => $"adm-secret-{Kind.ToString().ToLowerInvariant()}";
    private string TestLabel => Kind == StoredSecretKind.ChatWebhookUrl ? "Send test" : "Send test event";
    private string TestHelp => Kind == StoredSecretKind.ChatWebhookUrl
        ? "Posts a test message to the channel, through the saved settings."
        : "Event 5901, marked as a test, to each SIEM transport that's on. Doesn't touch case data.";

    private StoredSecretStatus? _status;
    // As CAP-05's review: the stamp of the secret the admin was last shown (or told about). Kept apart from _status, which a
    // test send refreshes for display without the admin seeing what changed.
    private string _stamp = "";
    private string? _newValue;   // held only between typing and Save; never rendered
    private bool _replacing;
    private int _fieldKey;
    private IReadOnlyList<IncidentManager.Web.Siem.SiemTestResult>? _siemResults;

    // BUG-603 (C8): one save, clear or test at a time.
    private readonly InFlight _saving = new();
    private readonly InFlight _clearing = new();
    private readonly InFlight _testing = new();

    // BUG-601 (C5): a save's reload and a test's can overlap; only the newest lands.
    private readonly LoadSequence _load = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var t = _load.Begin();
        var status = await Secrets.GetAsync(Kind);
        if (!_load.IsCurrent(t)) return;
        _status = status;
        _stamp = status.Stamp;
        _replacing = !status.Set;
        ForgetValue();
    }

    // Drops what was typed, and gives the field a new key so the browser's copy goes too.
    private void ForgetValue()
    {
        _newValue = null;
        _fieldKey++;
    }

    private void CancelReplace()
    {
        _replacing = false;
        ForgetValue();
    }

    private Task Save() => _saving.Run(SaveCore);

    private async Task SaveCore()
    {
        try
        {
            // With the stamp it loaded ("" for no row), so a secret changed since isn't written over.
            await Secrets.SaveAsync(Kind, _newValue, _stamp);
            Toasts.Success($"The {Definition.Label} is saved. The next send uses it.");
            await LoadAsync();   // the stamp of what was just saved, for the next Save
        }
        catch (IncidentManager.Application.Cases.StaleEditException ex)
        {
            ForgetValue();
            Toasts.Error(ex.Message);
            await ReloadStatusAsync(takeStamp: true);   // what's saved now, and they've been told
        }
        catch (Exception ex) when (ex is InvalidOperationException or IncidentManager.Application.Security.ForbiddenException)
        {
            // The refusal's reason (an http URL, a line break): never the value, which the field drops.
            ForgetValue();
            Toasts.Error(ex.Message);
        }
    }

    private Task Clear() => _clearing.Run(ClearCore);

    private async Task ClearCore()
    {
        try
        {
            await Secrets.ClearAsync(Kind, _stamp);
            Toasts.Info($"The saved {Definition.Label} is cleared.");
            await LoadAsync();
        }
        catch (IncidentManager.Application.Cases.StaleEditException ex)
        {
            Toasts.Error(ex.Message);
            await ReloadStatusAsync(takeStamp: true);
        }
        catch (Exception ex) when (ex is InvalidOperationException or IncidentManager.Application.Security.ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
    }

    private Task SendTest() => _testing.Run(SendTestCore);

    private async Task SendTestCore()
    {
        if (Kind == StoredSecretKind.ChatWebhookUrl)
        {
            if (!Chat.Enabled) { Toasts.Warning("Chat isn't on, or no webhook URL is set. Chat:Webhook:Enabled is set on the server."); return; }
            var baseUrl = (Config["App:BaseUrl"] ?? "").TrimEnd('/');
            var error = await Chat.SendTestAsync(new ChatNotification("CaseBook test message",
                "This is a test notification confirming the chat webhook configuration.", baseUrl.Length == 0 ? null : baseUrl));
            if (error is null) Toasts.Success("Test chat message posted to the channel.");
            else Toasts.Error($"Couldn't post the test message. {error}");
        }
        else
        {
            if (!SiemTest.AnyEnabled) { Toasts.Warning("No SIEM transport is on. Siem:Webhook:Enabled is set on the server."); return; }
            _siemResults = await SiemTest.SendTestAsync();
        }
        // A value that won't decrypt shows at once. The stamp stays the loaded one: a secret someone else saved since is
        // still refused on Save rather than silently taken as seen (CAP-05's regression).
        await ReloadStatusAsync(takeStamp: false);
    }

    // The saved status only (and its stamp, when the admin has just been told it changed).
    private async Task ReloadStatusAsync(bool takeStamp)
    {
        var t = _load.Begin();
        var status = await Secrets.GetAsync(Kind);
        if (!_load.IsCurrent(t)) return;
        _status = status;
        if (takeStamp) _stamp = status.Stamp;
    }
}
