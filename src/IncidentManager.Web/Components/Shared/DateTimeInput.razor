@* BUG-408: a date-and-time field that doesn't fight the person typing in it. Bound like an input (@bind-Value, with
   :after), to a DateTime or a DateTime?, as a wall-clock value to the minute. Blazor's own @bind wrote the value back
   after every keystroke, which reset the segment being typed (minutes "45" became "05"); see DateFieldBase for how
   this avoids it. DateInput and TimeInput are the date-only and time-only fields (BUG-426). *@
@typeparam TValue
@inherits DateFieldBase<TValue>

<input @ref="Element" type="datetime-local" value="@FirstShown" @attributes="AdditionalAttributes" />

@code {
    protected override string Format => "yyyy-MM-ddTHH:mm";
    protected override Type[] Supported => [typeof(DateTime)];
    protected override TValue FromText(DateTime parsed) => (TValue)(object)parsed;
    protected override string Show(TValue? value) => value is DateTime d ? Text(d) : "";
}
