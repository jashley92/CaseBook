@inject TeamWorkloadService Workload
@inject IncidentManager.Application.Cases.CaseService Cases
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IncidentManager.Web.Services.ToastService Toasts
@inject IAuthorizationService Authz
@inject AuthenticationStateProvider AuthState

@* Team-workload panel (E-25): per-analyst open-case distribution + the unassigned queue, for rebalancing.
   Extracted from the former /team page so it can be embedded in the consolidated Work landing under a
   ViewAllCases gate. Carries no <h1>/PageTitle — the host page owns the page heading.
   PROD-23: an editor (IC/SysAdmin) can rebalance in place — a *metered* reassign scoped to one analyst's
   queue (or the unassigned queue): count-capped and enumerate-and-confirm, never across disparate cases. *@

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <p class="text-muted mb-0">Open cases by analyst, plus the unassigned queue.</p>
    <a class="btn btn-sm btn-outline-secondary" href="cases?sla=true" title="Open cases at or past their response-time target">
        <span class="bi bi-clock-history" aria-hidden="true"></span> SLA at-risk cases
    </a>
</div>

@if (_w is null)
{
    <span class="visually-hidden" role="status">Loading team workload…</span>
    <SkeletonTable Rows="5" Columns="5" />
}
else
{
    <div class="im-tiles">
        <StatTile Icon="bi-folder2-open" Value="_w.TotalOpen" Label="Open cases" Tone="accent" />
        <StatTile Icon="bi-people" Value="_w.AnalystCount" Label="Analysts working" Tone="accent" />
        <StatTile Icon="bi-inbox" Value="_w.Unassigned.Open" Label="Unassigned"
                  Tone="@(_w.Unassigned.Open > 0 ? "warn" : "ok")" />
        <StatTile Icon="bi-clock-history"
                  Value="@(_w.Analysts.Sum(a => a.SlaAtRisk + a.SlaBreached) + _w.Unassigned.SlaAtRisk + _w.Unassigned.SlaBreached)"
                  Label="SLA at risk / overdue"
                  Tone="@(_sumBreached > 0 ? "danger" : (_sumAtRisk > 0 ? "warn" : "ok"))" />
    </div>

    @if (_w.TotalOpen == 0)
    {
        <div class="empty-state">
            <span class="bi bi-inbox empty-state-icon" aria-hidden="true"></span>
            <div class="empty-state-title">No open cases</div>
            <div class="empty-state-msg">When cases are opened and assigned, the team's caseload will appear here.</div>
        </div>
    }
    else
    {
        <div class="im-card">
        <div class="table-responsive">
            <table class="table align-middle wl-table im-table mb-0">
                <thead>
                    <tr>
                        <th>Analyst</th>
                        <th class="text-center">Open</th>
                        <th>Severity mix</th>
                        <th>SLA</th>
                        <th class="text-center" title="Open cases with no activity in @TeamWorkloadBuilder.StaleDays days">Stale</th>
                        @if (_canEdit) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                    @if (_w.Unassigned.Open > 0)
                    {
                        var u = _w.Unassigned;
                        <tr class="wl-unassigned">
                            <td>
                                <span class="wl-avatar wl-avatar-none"><span class="bi bi-inbox" aria-hidden="true"></span></span>
                                <a class="fw-semibold ms-2 link-body-emphasis text-decoration-none case-title" href="cases?assignee=none">Unassigned queue</a>
                                <div class="small text-muted ms-2 ps-4">Nobody actively working these</div>
                            </td>
                            <td class="text-center"><a class="wl-open text-decoration-none" href="cases?assignee=none">@u.Open</a></td>
                            <td>@SevBar(u.Critical, u.High, u.Medium, u.Low, u.Informational)</td>
                            <td>@SlaCell(u.SlaAtRisk, u.SlaBreached)</td>
                            <td class="text-center">@StaleCell(u.Stale)</td>
                            @if (_canEdit)
                            {
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary py-0" @onclick='() => OpenReassign(null, "the unassigned queue")'>
                                        <span class="bi bi-person-plus me-1" aria-hidden="true"></span>Assign…
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                    @foreach (var a in _w.Analysts)
                    {
                        <tr>
                            <td>
                                <span class="wl-avatar" style="background:hsl(@Ui.AvatarHue(a.UserId) 55% 42%)">@Ui.Initials(a.DisplayName)</span>
                                <a class="fw-semibold ms-2 link-body-emphasis text-decoration-none case-title" href="@AssigneeHref(a)" title="View @a.DisplayName's open cases">@a.DisplayName</a>
                                @if (a.AsIncidentCommander > 0)
                                {
                                    <div class="small text-muted ms-2 ps-4">IC on @a.AsIncidentCommander case@(a.AsIncidentCommander == 1 ? "" : "s")</div>
                                }
                            </td>
                            <td class="text-center"><a class="wl-open text-decoration-none" href="@AssigneeHref(a)">@a.Open</a></td>
                            <td>@SevBar(a.Critical, a.High, a.Medium, a.Low, a.Informational)</td>
                            <td>@SlaCell(a.SlaAtRisk, a.SlaBreached)</td>
                            <td class="text-center">@StaleCell(a.Stale)</td>
                            @if (_canEdit)
                            {
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary py-0" @onclick="() => OpenReassign(a.UserId, a.DisplayName)"
                                            title="@($"Reassign some of {a.DisplayName}'s cases")">
                                        <span class="bi bi-arrow-left-right me-1" aria-hidden="true"></span>Reassign…
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-muted small mb-0 mt-3">
            A case counts toward each incident commander and analyst assigned to it (observers excluded).
            Severity mix and SLA reuse the same data as the case list. Scoped to the cases you're allowed to see.
        </p>
        </div>
    }
}

@* PROD-23: metered reassign. Scoped to one analyst's queue (or the unassigned queue), count-capped, and
   routed through an enumerate-and-confirm step — never a bulk action across disparate cases. *@
@if (_reassignOpen)
{
    var fromLabel = _reassignFromId is null ? "the unassigned queue" : _reassignFromName;
    <div class="modal d-block im-trap" tabindex="-1" role="dialog" aria-modal="true" aria-label="Reassign cases"
         style="background:var(--im-scrim)" @onclick="CloseReassign">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(_reassignFromId is null ? "Assign from the unassigned queue" : $"Reassign from {_reassignFromName}")
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseReassign"></button>
                </div>

                @if (!_reassignConfirm)
                {
                    <div class="modal-body">
                        <div class="row g-2 align-items-end mb-3">
                            <div class="col-sm-7">
                                <label class="form-label small mb-0" for="reassign-to">Assign to</label>
                                <select id="reassign-to" class="form-select form-select-sm" @bind="_reassignToId">
                                    <option value="">Select a user…</option>
                                    @foreach (var u in Users.All().Where(u => !string.Equals(u.UserId, _reassignFromId, StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <option value="@u.UserId">@u.DisplayName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-sm-5">
                                <label class="form-label small mb-0" for="reassign-role">Role on the case</label>
                                <select id="reassign-role" class="form-select form-select-sm" @bind="_reassignRole">
                                    @foreach (var r in Enum.GetValues<CaseAssignmentRole>())
                                    {
                                        <option value="@r">@r</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small fw-semibold">@fromLabel's open cases</span>
                            <span class="small text-muted">@_reassignSelected.Count / @MaxReassign selected</span>
                        </div>

                        @if (_reassignCases is null)
                        {
                            <p class="text-muted small"><em>Loading…</em></p>
                        }
                        else if (_reassignCases.Count == 0)
                        {
                            <p class="text-muted small mb-0">No open cases here to reassign.</p>
                        }
                        else
                        {
                            <div class="border rounded" style="max-height:22rem;overflow:auto">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <tbody>
                                        @foreach (var c in _reassignCases)
                                        {
                                            var atCap = !_reassignSelected.Contains(c.Id) && _reassignSelected.Count >= MaxReassign;
                                            <tr>
                                                <td style="width:1%">
                                                    <input class="form-check-input" type="checkbox" checked="@_reassignSelected.Contains(c.Id)"
                                                           disabled="@atCap" aria-label="@($"Select {c.CaseNumber}")"
                                                           @onchange="e => ToggleReassign(c.Id, (bool)(e.Value ?? false))" />
                                                </td>
                                                <td><code>@c.CaseNumber</code></td>
                                                <td>@c.Title</td>
                                                <td><span class="@Ui.SeverityBadge(c.Severity)">@c.Severity</span></td>
                                                <td><span class="@Ui.PhaseBadge(c.Phase)">@Ui.Label(c.Phase)</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="form-text">
                                Metered: scoped to this one queue, up to <strong>@MaxReassign</strong> at a time, with a confirm step —
                                bulk reassignment across unrelated cases isn't offered.
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        @if (_reassignCases is { Count: > 0 })
                        {
                            <button class="btn btn-sm btn-outline-secondary me-auto" @onclick="SelectUpToCap">Select @Math.Min(_reassignCases.Count, MaxReassign)</button>
                        }
                        <button class="btn btn-outline-secondary" @onclick="CloseReassign">Cancel</button>
                        <button class="btn btn-primary" @onclick="ProceedToConfirm"
                                disabled="@(_reassignSelected.Count == 0 || string.IsNullOrEmpty(_reassignToId))">
                            Reassign @_reassignSelected.Count…
                        </button>
                    </div>
                }
                else
                {
                    <div class="modal-body">
                        <p>
                            Reassign these <strong>@_reassignSelected.Count</strong> case@(_reassignSelected.Count == 1 ? "" : "s")
                            @(_reassignFromId is null ? "" : $"from {_reassignFromName} ")to
                            <strong>@ToName()</strong> as <strong>@_reassignRole</strong>?
                            @if (_reassignFromId is not null)
                            {
                                <span class="text-muted">@_reassignFromName will be removed from @(_reassignSelected.Count == 1 ? "it" : "them").</span>
                            }
                        </p>
                        <ul class="small mb-0">
                            @foreach (var c in _reassignCases!.Where(c => _reassignSelected.Contains(c.Id)))
                            {
                                <li><code>@c.CaseNumber</code> — @c.Title</li>
                            }
                        </ul>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" @onclick="() => _reassignConfirm = false" disabled="@_reassigning">Back</button>
                        <button class="btn btn-primary" @onclick="ApplyReassign" disabled="@_reassigning">
                            @if (_reassigning) { <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> }
                            Confirm reassign
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private TeamWorkload? _w;
    private int _sumAtRisk, _sumBreached;
    private bool _canEdit;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _canEdit = (await Authz.AuthorizeAsync(auth.User, Policies.EditCases)).Succeeded;
        await LoadWorkload();
    }

    private async Task LoadWorkload()
    {
        _w = await Workload.GetAsync();
        _sumAtRisk = _w.Analysts.Sum(a => a.SlaAtRisk) + _w.Unassigned.SlaAtRisk;
        _sumBreached = _w.Analysts.Sum(a => a.SlaBreached) + _w.Unassigned.SlaBreached;
    }

    // --- PROD-23: metered reassign ------------------------------------------------------------------
    private const int MaxReassign = 25;

    private bool _reassignOpen;
    private string? _reassignFromId;   // null = the unassigned queue (assign only, nobody to remove)
    private string _reassignFromName = "";
    private IReadOnlyList<CaseListItem>? _reassignCases;
    private readonly HashSet<Guid> _reassignSelected = new();
    private string _reassignToId = "";
    private CaseAssignmentRole _reassignRole = CaseAssignmentRole.Analyst;
    private bool _reassignConfirm;
    private bool _reassigning;

    private async Task OpenReassign(string? fromId, string fromName)
    {
        _reassignOpen = true;
        _reassignFromId = fromId;
        _reassignFromName = fromName;
        _reassignSelected.Clear();
        _reassignToId = "";
        _reassignRole = CaseAssignmentRole.Analyst;
        _reassignConfirm = false;
        _reassignCases = null;

        // Load only this queue's open cases — the coherent cohort the reassign is scoped to.
        var page = await Cases.ListAsync(new CaseFilter
        {
            AssigneeUserId = fromId,
            UnassignedOnly = fromId is null,
            IncludeClosed = false,
            Page = 1,
            PageSize = 200
        });
        _reassignCases = page.Items;
    }

    private void CloseReassign() { _reassignOpen = false; _reassignCases = null; _reassignSelected.Clear(); }

    private void ToggleReassign(Guid id, bool on)
    {
        if (on) { if (_reassignSelected.Count < MaxReassign) _reassignSelected.Add(id); }
        else _reassignSelected.Remove(id);
    }

    private void SelectUpToCap()
    {
        _reassignSelected.Clear();
        foreach (var c in (_reassignCases ?? Array.Empty<CaseListItem>()).Take(MaxReassign))
            _reassignSelected.Add(c.Id);
    }

    private void ProceedToConfirm()
    {
        if (_reassignSelected.Count > 0 && !string.IsNullOrEmpty(_reassignToId)) _reassignConfirm = true;
    }

    private string ToName() => Users.Resolve(_reassignToId)?.DisplayName ?? _reassignToId;

    private async Task ApplyReassign()
    {
        if (_reassigning || _reassignSelected.Count == 0 || string.IsNullOrEmpty(_reassignToId)) return;
        _reassigning = true;
        var toName = ToName();
        var done = 0;
        try
        {
            foreach (var id in _reassignSelected.ToList())
            {
                try
                {
                    await Cases.AssignAsync(id, _reassignToId, toName, _reassignRole);
                    // Rebalancing: take the case off the source analyst (nobody to remove for the unassigned queue).
                    if (_reassignFromId is not null)
                        await Cases.UnassignAsync(id, _reassignFromId);
                    done++;
                }
                catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
                {
                    Toasts.Error(ex.Message);
                }
            }
        }
        finally
        {
            _reassigning = false;
        }

        CloseReassign();
        if (done > 0)
        {
            Toasts.Success($"Reassigned {done} case{(done == 1 ? "" : "s")} to {toName}.");
            await LoadWorkload();
        }
    }

    private static string AssigneeHref(AnalystLoad a) =>
        $"cases?assignee={Uri.EscapeDataString(a.UserId)}&assigneeName={Uri.EscapeDataString(a.DisplayName)}";

    // A compact stacked severity bar plus per-severity counts, so balance reads at a glance.
    private RenderFragment SevBar(int crit, int high, int med, int low, int info) =>
        @<div class="wl-sev">
            <div class="wl-bar" role="img" aria-label="Severity distribution">
                @Seg(crit, Severity.Critical)
                @Seg(high, Severity.High)
                @Seg(med, Severity.Medium)
                @Seg(low, Severity.Low)
                @Seg(info, Severity.Informational)
            </div>
            <div class="wl-chips">
                @Chip(crit, Severity.Critical, "C")
                @Chip(high, Severity.High, "H")
                @Chip(med, Severity.Medium, "M")
                @Chip(low, Severity.Low, "L")
                @Chip(info, Severity.Informational, "I")
            </div>
        </div>;

    private RenderFragment Seg(int n, Severity s) => n <= 0
        ? @<text></text>
        : @<span class="wl-seg" style="flex:@n;background:@Ui.SeverityColor(s)" title="@n @s"></span>;

    private RenderFragment Chip(int n, Severity s, string letter) => n <= 0
        ? @<text></text>
        : @<span class="wl-chip" title="@n @s"><i style="background:@Ui.SeverityColor(s)"></i>@letter&nbsp;@n</span>;

    private RenderFragment SlaCell(int atRisk, int breached) => (atRisk == 0 && breached == 0)
        ? @<span class="text-muted small">—</span>
        : @<span class="d-inline-flex gap-1 flex-wrap">
            @if (breached > 0) { <span class="im-badge im-sla-breached">@breached overdue</span> }
            @if (atRisk > 0) { <span class="im-badge im-sla-atrisk">@atRisk at risk</span> }
        </span>;

    private RenderFragment StaleCell(int stale) => stale <= 0
        ? @<span class="text-muted small">—</span>
        : @<span class="wl-stale" title="@stale open case@(stale == 1 ? "" : "s") with no activity in @TeamWorkloadBuilder.StaleDays days">@stale</span>;
}
