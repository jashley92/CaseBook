@* Design review P3: a read-only preview of a case beside a list, so checking "do I need to open this?" doesn't
   cost a page load and a Back. Everything here is read-only: acting on the case happens in the workspace, which
   keeps every change an attributable act there. Opening a preview is logged like opening the case. *@
@inject CaseService Cases
@inject IncidentManager.Application.Access.IAccessLogService AccessLog
@inject ISlaTargetsProvider SlaProvider
@inject IClock Clock
@inject TimeDisplay TimeDisp
@inject ISeverityLabels SevLabels
@inject IncidentManager.Application.Abstractions.IUserDirectory Users

<aside class="im-peek @(Drawer ? "is-drawer" : "")" aria-label="Case preview" @onkeydown="OnKey">
    @if (_loading)
    {
        <LoadingBlock Rows="6" Columns="2" Label="Loading the case preview…" />
    }
    else if (_p is null)
    {
        <div class="im-peek-head">
            <span class="text-muted small">Preview</span>
            <button type="button" class="btn-close ms-auto" aria-label="Close preview" @onclick="OnClose"></button>
        </div>
        <p class="text-muted small mb-0">This case isn't available. It may have been archived or restricted.</p>
    }
    else
    {
        var p = _p;
        <div class="im-peek-head">
            <code class="im-peek-num">@p.CaseNumber</code>
            <span class="small text-muted ms-auto d-none d-lg-inline"><kbd>Esc</kbd></span>
            <button type="button" class="btn-close" aria-label="Close preview" @onclick="OnClose"></button>
        </div>
        <h2 class="im-peek-title">@p.Title</h2>
        <div class="im-peek-badges">
            <span class="@Ui.ClassificationBadge(p.Classification)">@Ui.Label(p.Classification)</span>
            <span class="@Ui.SeverityBadge(p.Severity)">@SevLabels.For(p.Severity)</span>
            <span class="@Ui.PhaseBadge(p.Phase)">@Ui.Label(p.Phase)</span>
            @if (p.LegalReferred) { <span class="im-badge im-b-neutral">Legal referred</span> }
            @if (p.LegalHold) { <span class="im-badge im-b-danger">Legal hold</span> }
            @if (p.Materiality != MaterialityStatus.Undetermined) { <span class="@Ui.MaterialityBadge(p.Materiality)">@Ui.Label(p.Materiality)</span> }
            @if (p.IsRestricted) { <span class="im-badge im-b-warn">Restricted</span> }
            @if (p.IsExercise) { <span class="im-badge im-b-info">Exercise</span> }
        </div>

        var sla = SlaPolicy.Evaluate(p.Severity, p.Phase, p.DetectedAtUtc, p.ContainedAtUtc, p.ResolvedAtUtc,
            SlaProvider.Current, Clock.UtcNow, p.Classification);
        @if (sla.State != SlaState.NoTarget)
        {
            <section class="im-peek-sec">
                <h3 class="im-peek-h">Clock</h3>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="@Ui.SlaBadge(sla.State)">
                        <span class="bi @Ui.SlaGlyph(sla.State)" aria-hidden="true"></span>
                        @(sla.Clock is { } clk ? Ui.SlaClockLabel(clk) : "SLA"): @(Ui.SlaTiming(sla) is { Length: > 0 } t ? t : Ui.SlaLabel(sla.State))
                    </span>
                    @if (sla.IsActive && sla.DueAtUtc is { } due) { <span class="small text-muted im-data">due @TimeDisp.Short(due)</span> }
                </div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(p.Summary))
        {
            <section class="im-peek-sec">
                <h3 class="im-peek-h">Summary</h3>
                <p class="im-peek-clamp small mb-0">@IncidentManager.Application.Content.RichText.ToText(p.Summary)</p>
            </section>
        }

        <section class="im-peek-sec">
            <h3 class="im-peek-h">Next up <span>@(p.OpenTasks == 0 ? "no open tasks" : $"{p.OpenTasks} open task{(p.OpenTasks == 1 ? "" : "s")}")</span></h3>
            @if (p.NextTask is { } nt)
            {
                <div class="small">
                    @nt.Title
                    <span class="text-muted">
                        @if (!string.IsNullOrWhiteSpace(nt.Owner)) { <text> · @Users.DisplayFor(nt.Owner)</text> }
                        @if (nt.DueAtUtc is { } d) { <text> · </text><span class="@(d < Clock.UtcNow ? "text-danger" : "")">due @TimeDisp.Short(d)</span> }
                    </span>
                </div>
            }
            else
            {
                <div class="small text-muted">Nothing scheduled.</div>
            }
        </section>

        @if (p.Latest is { } l)
        {
            <section class="im-peek-sec">
                <h3 class="im-peek-h">Latest on the timeline <span>@Ui.RelativeTime(l.OccurredAtUtc, Clock.UtcNow)</span></h3>
                <p class="im-peek-clamp small mb-0">@IncidentManager.Application.Content.RichText.ToText(l.Description)</p>
            </section>
        }

        @if (p.Indicators.Count > 0)
        {
            <section class="im-peek-sec">
                <h3 class="im-peek-h">Indicators <span>@p.IndicatorCount</span></h3>
                <ul class="im-peek-iocs">
                    @foreach (var i in p.Indicators)
                    {
                        <li>
                            <span class="text-muted" title="@Ui.Label(i.Type)">@Ui.EntityGlyph(i.Type)</span>
                            <code class="im-peek-ioc" title="@i.Value">@i.Value</code>
                            <span class="@Ui.DispositionBadge(i.Disposition)">@Ui.Label(i.Disposition)</span>
                            @if (i.OtherCases > 0)
                            {
                                @* PROD-10: pivot by entity id so the indicator value never rides in a URL. *@
                                <a class="small text-nowrap" href="indicators?entity=@i.EntityId"
                                   title="Every case this indicator appears on">+@i.OtherCases</a>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        <section class="im-peek-sec">
            <h3 class="im-peek-h">Team</h3>
            @if (p.Team.Count == 0)
            {
                <div class="small text-muted fst-italic">Unassigned</div>
            }
            else
            {
                <div class="small">
                    @for (var n = 0; n < p.Team.Count; n++)
                    {
                        var m = p.Team[n];
                        @m.Name<span class="text-muted"> @(m.Role == CaseAssignmentRole.IncidentCommander ? "(IC)" : "")</span>@(n < p.Team.Count - 1 ? ", " : "")
                    }
                </div>
            }
        </section>

        <div class="im-peek-actions">
            <a class="btn btn-sm btn-primary" href="cases/@p.Id">Open case</a>
            <a class="btn btn-sm btn-outline-secondary" href="cases/@p.Id" target="_blank" rel="noopener">New tab</a>
        </div>
    }
</aside>

@code {
    /// <summary>The case to preview.</summary>
    [Parameter, EditorRequired] public Guid CaseId { get; set; }

    /// <summary>Raised by the close button, or Esc while focus is in the panel.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Open as a drawer over the page at every width (for pages with no room for a side column).</summary>
    [Parameter] public bool Drawer { get; set; }

    private Task OnKey(KeyboardEventArgs e) => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;

    private CasePreview? _p;
    private bool _loading = true;
    private Guid _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == CaseId) return;
        _loadedFor = CaseId;
        _loading = true;
        var id = CaseId;
        var p = await Cases.GetPreviewAsync(id);
        if (id != CaseId) return; // a newer selection arrived while this one loaded
        _p = p;
        _loading = false;
        // C-05: a preview shows case content, so it's recorded like an open (best-effort; coalesced into a view-session).
        if (p is not null) await AccessLog.RecordCaseOpenAsync(p.Id, p.CaseNumber, p.IsRestricted);
    }
}
