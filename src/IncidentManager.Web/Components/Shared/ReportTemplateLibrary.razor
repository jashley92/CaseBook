@* PROD-47: the Word report template library. Admins upload several customer-designed .docx templates, preview
   each one filled with a real case before anyone uses it, and keep them current (replace, rename, archive,
   delete). Report profiles pick one as their default below; the case Report tab can pick any active one. *@
@using IncidentManager.Application.Admin
@using IncidentManager.Application.Cases
@using IncidentManager.Application.Reporting
@inject ReportTemplateService Templates
@inject CaseService Cases
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject TimeDisplay TimeDisp
@inject ToastService Toasts
@inject ReportService Reports
@inject IncidentManager.Application.Access.IAccessLogService Access
@inject IJSRuntime JS

<div class="card mb-3">
    <div class="card-header"><span class="bi bi-file-earmark-word me-1" aria-hidden="true"></span>Word templates</div>
    <div class="card-body">
        <p class="small text-muted mb-2">
            Upload .docx files with <code>{{…}}</code> fields to give Word reports your own fonts, styles, headers and footers.
            A report profile picks one as its default, one can be the default for lessons-learned reports, and whoever
            generates a report can pick another. Any template can fill either report and use any field, so one template can
            serve both (<code>{{report.type}}</code> names which report it is). A table row with a list field such as <code>{{ioc.value}}</code> repeats once per item, and
            <code>{{image.attack_chain}}</code> or <code>{{image.entity_graph}}</code> alone on a line becomes the picture.
            Templates with macros, embedded objects or external content are refused.
        </p>
        <div class="small mb-3">
            <a class="me-3" href="export/report-template-starter.docx" download><span class="bi bi-download me-1" aria-hidden="true"></span>Starter: case report</a>
            <a class="me-3" href="export/report-template-starter-lessons.docx" download><span class="bi bi-download me-1" aria-hidden="true"></span>Starter: lessons-learned report</a>
            <details class="d-inline-block align-top">
                <summary style="cursor:pointer; color: var(--im-accent-text)">Field reference</summary>
                <div class="mt-2 im-template-fields">
                    <div class="fw-semibold">Single values</div>
                    <ul class="mb-2">
                        @foreach (var f in ReportTemplateFields.ScalarFields)
                        {
                            <li><code>{{@f.Name}}</code>: @f.Description</li>
                        }
                    </ul>
                    <div class="fw-semibold">Lists (the row or paragraph repeats per item)</div>
                    @foreach (var c in ReportTemplateFields.Collections)
                    {
                        <div class="mt-1">@c.Description:</div>
                        <div>@foreach (var f in c.Fields) { <code class="me-2" title="@f.Description">{{@f.Name}}</code> }</div>
                    }
                    <div class="fw-semibold mt-2">Pictures (alone in their paragraph, body only)</div>
                    <ul class="mb-0">
                        @foreach (var f in ReportTemplateFields.ImageFields)
                        {
                            <li><code>{{@f.Name}}</code>: @f.Description</li>
                        }
                    </ul>
                </div>
            </details>
        </div>

        @* Upload: name it, then pick the file. *@
        <div class="row g-2 align-items-end mb-3">
            <div class="col-sm-6 col-lg-4">
                <label class="form-label small mb-0" for="tpl-new-name">New template name</label>
                <input id="tpl-new-name" class="form-control form-control-sm" @bind="_newName" @bind:event="oninput"
                       placeholder="e.g. Examiner pack (blank uses the file name)" />
            </div>
            <div class="col-auto">
                <label class="btn btn-sm btn-primary mb-0 @(_uploading ? "disabled" : "")" aria-disabled="@(_uploading ? "true" : "false")">
                    <span class="bi bi-upload me-1" aria-hidden="true"></span>@(_uploading ? "Uploading…" : "Upload .docx…")
                    <InputFile class="d-none" accept=".docx" OnChange="Upload" disabled="@_uploading" />
                </label>
            </div>
        </div>

        @if (_problems is { Count: > 0 })
        {
            <div class="alert alert-danger small py-2" role="alert">
                <div class="fw-semibold">That template wasn't accepted:</div>
                <ul class="mb-0">@foreach (var p in _problems) { <li>@p</li> }</ul>
            </div>
        }

        @if (_previewFor is { } pv)
        {
            <div class="border rounded p-2 mb-3 small im-template-preview" role="region" aria-label="Preview @pv.Name">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="fw-semibold"><span class="bi bi-eye me-1" aria-hidden="true"></span>Preview “@pv.Name”</span>
                    <button type="button" class="btn-close" aria-label="Close preview" @onclick="ClosePreview"></button>
                </div>
                <p class="text-muted mb-2">
                    Fills the template with a case's data, to show here or download. Nothing is saved to the case and no report
                    version is created. The document opens with a PREVIEW line. Either way it's recorded in the access log.
                </p>
                @if (_cases is null)
                {
                    <span class="text-muted">Loading cases…</span>
                }
                else if (_cases.Count == 0)
                {
                    <span class="text-muted">No cases you can open yet. Create one (an exercise case works well), then preview.</span>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2 align-items-end">
                        <div>
                            <label class="form-label small mb-0" for="tpl-preview-case">Case</label>
                            <select id="tpl-preview-case" class="form-select form-select-sm" style="max-width:32rem" @bind="_previewCaseId" @bind:after="ClearShown">
                                @foreach (var c in _cases)
                                {
                                    <option value="@c.Id">@c.CaseNumber · @c.Title@(c.IsExercise ? " (exercise)" : "")</option>
                                }
                            </select>
                        </div>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => ShowHere(pv)">
                            <span class="bi bi-eye me-1" aria-hidden="true"></span>Show here
                        </button>
                        <a class="btn btn-sm btn-outline-primary" href="export/report-templates/@pv.Id/preview?caseId=@_previewCaseId" download>
                            <span class="bi bi-download me-1" aria-hidden="true"></span>Download preview
                        </a>
                    </div>
                    <div class="form-text">
                        Pick a case with an attack chain and entities to see the pictures filled in. Shown here, fonts not installed
                        on this computer are replaced and page breaks can differ slightly from Word.
                    </div>
                    @if (_shownBytes is not null)
                    {
                        @if (_shownError is not null)
                        {
                            <p class="text-danger mt-2 mb-0" role="alert">@_shownError</p>
                        }
                        @* docx-view.js owns this element's contents; Blazor never renders children into it. *@
                        <div class="im-docx-preview mt-2" role="region" aria-label="Filled template" @ref="_shownHost"></div>
                    }
                }
            </div>
        }

        @if (_templates is null)
        {
            <LoadingBlock />
        }
        else if (_templates.Count == 0)
        {
            <p class="text-muted mb-0">No Word templates yet. Word reports use the built-in layout.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Template</th><th>File</th><th class="text-nowrap">Default for</th><th>Updated</th><th style="width:1%"></th></tr></thead>
                    <tbody>
                        @foreach (var t in _templates)
                        {
                            <tr @key="t.Id">
                                <td>
                                    @if (_renaming == t.Id)
                                    {
                                        <div class="d-flex gap-1">
                                            <input class="form-control form-control-sm" style="max-width:16rem" aria-label="Template name"
                                                   @bind="_renameValue" @bind:event="oninput" />
                                            <button class="btn btn-sm btn-primary py-0" @onclick="() => SaveRename(t)" disabled="@_savingRename.Busy">Save</button>
                                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => _renaming = null">Cancel</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="fw-semibold">@t.Name</span>
                                        @if (!t.IsActive) { <span class="im-badge im-b-neutral ms-1">Archived</span> }
                                    }
                                </td>
                                <td class="small">
                                    @* One line per file name (long ones are cut off with the full name in the tooltip). *@
                                    <a href="export/report-templates/@t.Id" download class="d-inline-block text-truncate text-nowrap align-bottom"
                                       style="max-width:14rem" title="@t.FileName: download to edit, then replace">@t.FileName</a>
                                    @if (t.SizeBytes > 0) { <div class="text-muted">@Size(t.SizeBytes)</div> }
                                </td>
                                <td class="small">@(t.DefaultFor.Count == 0 ? "—" : string.Join(", ", t.DefaultFor))</td>
                                <td class="small text-muted">@TimeDisp.Short(t.UpdatedAtUtc) · @Users.DisplayFor(t.UpdatedBy)</td>
                                <td class="text-end" style="min-width:16rem">
                                    <button class="btn btn-sm btn-outline-primary py-0" @onclick="() => OpenPreview(t)">Preview</button>
                                    <label class="btn btn-sm btn-outline-secondary py-0 mb-0 @(_replacing.Busy ? "disabled" : "")" title="Upload a new version of this template">
                                        Replace…
                                        <InputFile class="d-none" accept=".docx" OnChange="e => Replace(t, e)" disabled="@_replacing.Busy" />
                                    </label>
                                    <button class="btn btn-sm btn-link py-0" @onclick="() => BeginRename(t)" aria-label="Rename @t.Name">Rename</button>
                                    @if (t.IsActive)
                                    {
                                        <button class="btn btn-sm btn-link py-0" aria-pressed="@(t.IsLessonsDefault ? "true" : "false")"
                                                title="@(t.IsLessonsDefault ? "Lessons-learned reports use this template by default. Click to go back to the built-in layout." : "Make this the default for lessons-learned reports")"
                                                @onclick="() => SetLessonsDefault(t, !t.IsLessonsDefault)" disabled="@_flagging">
                                            @if (t.IsLessonsDefault) { <span class="bi bi-check2 me-1" aria-hidden="true"></span> }Lessons default
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-link py-0" @onclick="() => SetActive(t, !t.IsActive)" disabled="@_flagging">@(t.IsActive ? "Archive" : "Restore")</button>
                                    <button class="btn btn-sm btn-link py-0 text-danger" @onclick="() => ConfirmDelete(t)" aria-label="Delete @t.Name">Delete…</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    /// <summary>Raised after the library changes, so the profiles editor can refresh its template choices.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private ConfirmDialog _confirm = null!;
    private List<ReportTemplateView>? _templates;
    private IReadOnlyList<string>? _problems;
    private string? _newName;
    private Guid? _renaming;
    private string? _renameValue;
    private ReportTemplateView? _previewFor;
    private List<CaseListItem>? _cases;
    private Guid _previewCaseId;
    // "Show here": the filled template drawn in the page by docx-view.js.
    private byte[]? _shownBytes;
    private bool _shownPending;
    private string? _shownError;
    private ElementReference _shownHost;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // BUG-601: a change's reload and the profiles editor's can overlap; only the newest lands.
    private readonly LoadSequence _load = new();

    private async Task LoadAsync()
    {
        var t = _load.Begin();
        var templates = await Templates.ListAllAsync();
        if (_load.IsCurrent(t)) _templates = templates;
    }

    /// <summary>Called by the profiles editor after a profile changes, so "Default for" stays current.</summary>
    public async Task ReloadAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    private async Task Changed()
    {
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private static async Task<byte[]> ReadAsync(IBrowserFile file)
    {
        // BUG-215: the size is checked up front, so a failure saving the file isn't reported as the file being too big.
        if (file.Size > ReportTemplateService.MaxTemplateBytes)
            throw new ArgumentException($"A template must be {ReportTemplateService.MaxTemplateBytes / 1024 / 1024} MB or smaller.");
        await using var stream = file.OpenReadStream(ReportTemplateService.MaxTemplateBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        return ms.ToArray();
    }

    // BUG-524: one upload at a time, until the list has reloaded. The control is disabled while it runs, but a second pick
    // can land before the re-render.
    private bool _uploading;

    private async Task Upload(InputFileChangeEventArgs e)
    {
        if (_uploading) return;
        // BUG-341 sibling: never InputFileChangeEventArgs.File, which throws for two or more files; the first is the template.
        if (DroppedFiles.First(e).First is not { } file) return;
        _uploading = true;
        _problems = null;
        try
        {
            var typed = _newName;
            var name = string.IsNullOrWhiteSpace(typed) ? Path.GetFileNameWithoutExtension(file.Name) : typed;
            var result = await Templates.UploadAsync(name, file.Name, await ReadAsync(file));
            if (!result.Check.Ok) { _problems = result.Check.Problems; return; }
            _newName = DraftText.ClearIfUnchanged(_newName, typed, null);   // BUG-601: a name typed for the next one stays
            await Changed();
            Toasts.Success($"Template “{name}” added ({result.Check.Placeholders.Count} fields). Preview it with a case below.");
            if (_templates?.FirstOrDefault(t => t.Id == result.Id) is { } added) await OpenPreview(added);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { _problems = [NotSaved]; }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { _problems = [ex.Message]; }
        finally { _uploading = false; }
    }

    // BUG-603: one replace at a time (a second pick while one is saving is ignored, not raced).
    private readonly InFlight _replacing = new();

    private Task Replace(ReportTemplateView t, InputFileChangeEventArgs e) => _replacing.Run(() => ReplaceCore(t, e));

    private async Task ReplaceCore(ReportTemplateView t, InputFileChangeEventArgs e)
    {
        if (DroppedFiles.First(e).First is not { } file) return;   // BUG-341 sibling: never InputFileChangeEventArgs.File
        _problems = null;
        try
        {
            var check = await Templates.ReplaceFileAsync(t.Id, file.Name, await ReadAsync(file));
            if (!check.Ok) { _problems = check.Problems; return; }
            await Changed();
            Toasts.Success($"“{t.Name}” now uses {file.Name}. Preview it with a case below.");
            ClearShown();   // what was shown came from the old file
            await OpenPreview(t);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException) { _problems = [NotSaved]; }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { _problems = [ex.Message]; }
    }

    private const string NotSaved = "The template file couldn't be saved, so nothing changed. Try again; if it keeps failing, " +
        "check that the app can write to its report-templates folder.";

    private async Task OpenPreview(ReportTemplateView t)
    {
        if (_previewFor?.Id != t.Id) ClearShown();
        _previewFor = t;
        if (_cases is null)
        {
            // BUG-601: Preview again while the case list loads: only the newest list lands (both did, and a case picked
            // after the first landed was reset to the first case by the second).
            var load = _casesLoad.Begin();
            var page = await Cases.ListAsync(new CaseFilter { IncludeClosed = true, IncludeExercises = true, PageSize = 100 });
            if (!_casesLoad.IsCurrent(load)) return;
            _cases = page.Items.ToList();
            if (_cases.Count > 0) _previewCaseId = _cases[0].Id;
        }
    }

    private readonly LoadSequence _casesLoad = new();

    private void ClosePreview()
    {
        _previewFor = null;
        ClearShown();
    }

    // BUG-439: bumped by every Show here and everything that clears what's shown (another case or template, Close, a
    // replaced file), so a slow fill that finishes after one of those is dropped instead of shown as the current choice.
    private int _showSeq;

    private void ClearShown()
    {
        _showSeq++;
        (_shownBytes, _shownPending, _shownError) = (null, false, null);
    }

    // BUG-603: the fill under way, while nothing has cleared it since; a second click then is ignored (a double-click
    // logged the preview twice). Another case or template clears it, so Show here for that one runs.
    private int? _showingSeq;

    private async Task ShowHere(ReportTemplateView t)
    {
        if (_showingSeq == _showSeq) return;
        ClearShown();
        var seq = _showSeq;
        _showingSeq = seq;
        var caseId = _previewCaseId;   // BUG-439: the case filled, not whichever is picked when the fill finishes
        try
        {
            var (fileName, bytes, _) = await Reports.PreviewTemplateAsync(t.Id, caseId);
            if (seq != _showSeq) return;
            // The admin sees the case's data without opening the case, so it's logged like the download.
            await Access.RecordArtifactAsync(IncidentManager.Domain.Enums.AccessType.Export, caseId,
                $"Word template preview (shown in Administration): {fileName}", t.Id);
            if (seq != _showSeq) return;
            (_shownBytes, _shownPending) = (bytes, true);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ForbiddenException)
        {
            if (seq == _showSeq) Toasts.Error(ex.Message);
        }
        finally
        {
            if (_showingSeq == seq) _showingSeq = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_shownPending || _shownBytes is null) return;
        _shownPending = false;
        try
        {
            using var stream = new DotNetStreamReference(new MemoryStream(_shownBytes));
            await JS.InvokeVoidAsync("imDocxView.render", _shownHost, stream);
        }
        catch (JSException)
        {
            _shownError = "Couldn't show the template in this browser. Download the preview instead.";
            StateHasChanged();
        }
        catch (JSDisconnectedException) { }
    }

    private void BeginRename(ReportTemplateView t) { _renaming = t.Id; _renameValue = t.Name; }

    // BUG-603: one rename save at a time (a double-click saved it twice).
    private readonly InFlight _savingRename = new();

    private Task SaveRename(ReportTemplateView t) => _savingRename.Run(() => SaveRenameCore(t));

    private async Task SaveRenameCore(ReportTemplateView t)
    {
        try { await Templates.RenameAsync(t.Id, _renameValue ?? ""); }   // BUG-350: the name only
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); return; }
        if (_renaming == t.Id) _renaming = null;   // BUG-601: a rename opened on another row meanwhile stays open
        await Changed();
        Toasts.Success("Template renamed");
    }

    // BUG-487: one Archive/Restore or Lessons default at a time, until the list has reloaded. The buttons are disabled, but
    // a second click lands before the re-render and acted on the row as it was before the first.
    private bool _flagging;

    private async Task SetActive(ReportTemplateView t, bool active)
    {
        if (_flagging) return;
        _flagging = true;
        try
        {
            try { await Templates.SetActiveAsync(t.Id, active); }   // BUG-350: the active flag only
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); return; }
            await Changed();
            Toasts.Success(active ? $"“{t.Name}” restored" : $"“{t.Name}” archived. It can't be picked for new reports.");
        }
        finally { _flagging = false; }
    }

    private async Task SetLessonsDefault(ReportTemplateView t, bool isDefault)
    {
        if (_flagging) return;
        _flagging = true;
        try
        {
            try { await Templates.SetLessonsDefaultAsync(t.Id, isDefault); }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); return; }
            await Changed();
            Toasts.Success(isDefault ? $"Lessons-learned reports now use “{t.Name}” by default"
                                     : "Lessons-learned reports now use the built-in layout by default");
        }
        finally { _flagging = false; }
    }

    private void ConfirmDelete(ReportTemplateView t) => _confirm.Ask(this, "Delete template",
        $"Delete “{t.Name}” and its file? Reports already generated from it are unchanged and still record its name.",
        "Delete template", async () =>
        {
            try { await Templates.DeleteAsync(t.Id); }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); return; }
            if (_previewFor?.Id == t.Id) ClosePreview();
            await Changed();
            Toasts.Info("Template deleted.");
        });

    private static string Size(long bytes) => bytes >= 1024 * 1024 ? $"{bytes / 1024d / 1024d:0.#} MB" : $"{Math.Max(1, bytes / 1024)} KB";
}
