@* Idle-lock landing (F-15). IdleGuard force-navigates here at the inactivity deadline, which tears down
   the working circuit — so all in-memory case data is gone and this neutral page is all that remains on
   an unattended screen. AllowAnonymous + the chromeless layout mean it always renders and shows nothing
   sensitive. "Resume" is a full-page link back to the app, which re-authenticates (silently under
   Windows auth) and starts a fresh session, on the page the tab locked on (LockReturnPage) or else the home page. *@
@page "/session-expired"
@layout Layout.BlankLayout
@attribute [AllowAnonymous]
@using IncidentManager.Application.Security
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Session locked · CaseBook</PageTitle>

<div class="session-locked">
    <div class="session-locked-card">
        <div class="session-locked-icon" aria-hidden="true"><span class="bi bi-lock-fill"></span></div>
        <h1 class="session-locked-title">Session locked</h1>
        <p class="session-locked-text">
            @if (Locked)
            {
                <span>You locked this session. Anything you saved is safe.</span>
            }
            else
            {
                <span>This session locked after a period of inactivity. Anything you saved is safe, but an edit you were
                    still typing may need to be redone.</span>
            }
        </p>
        <p class="session-locked-text session-locked-muted">
            This protects unattended workstations. Lock your computer when you step away, too.
        </p>
        <a href="@_resume" class="btn btn-primary">Resume session</a>
    </div>
</div>

@code {
    // S-24: set when the user locked the session themselves (profile menu → Lock now) rather than idling out.
    // A string, not a bool: this page is anonymous, and a malformed value must not be able to break it.
    [SupplyParameterFromQuery(Name = "locked")] private string? LockedQuery { get; set; }
    private bool Locked => LockedQuery is "1" or "true";

    private string _resume = "/";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        string? kept;
        try { kept = await JS.InvokeAsync<string?>("imIdle.takeReturnPage"); }
        catch (JSDisconnectedException) { return; }
        catch (JSException) { return; }   // the script didn't load: Resume stays on the home page
        if (LockReturnPage.Resolve(kept, Nav.BaseUri) is not { } page) return;
        _resume = page;
        StateHasChanged();
    }
}
