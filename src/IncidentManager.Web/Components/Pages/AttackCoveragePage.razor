@page "/attack-coverage"
@attribute [Authorize(Policy = Policies.ViewCases)]
@* PROD-42: the program-wide ATT&CK heatmap — which tactics and techniques the SOC has actually faced, across
   the cases the viewer can see, coloured by how many cases exercised each. Feeds the XSIAM detection-engineering
   loop (what to tune, what never shows up). Read-only and curated (no widget canvas); built from the technique
   tags and event-timeline steps analysts already record. Sub-techniques roll up to their parent. *@
@using IncidentManager.Application.Mitre
@inject AttackCoverageService Coverage

<PageTitle>ATT&amp;CK coverage</PageTitle>

<PageHeader Title="ATT&CK coverage"
            Subtitle="The tactics and techniques your cases have recorded, shaded by how many cases saw each." />

@if (_data is null)
{
    <span class="visually-hidden" role="status">Loading ATT&amp;CK coverage…</span>
    <section class="im-card"><SkeletonTable Rows="5" Columns="6" TableClass="table-sm" /></section>
    return;
}

<div class="im-tiles mb-3">
    <StatTile Icon="bi-folder2" Value="_data.CasesInPeriod" Label="Cases in period" Tone="neutral" />
    <StatTile Icon="bi-diagram-3" Value="_data.CasesWithAttackData" Label="With ATT&CK tags" Tone="accent" />
    <StatTile Icon="bi-columns-gap" Value="_data.Tactics.Count" Label="@($"Tactics seen (of {AllTactics.Length})")" Tone="neutral" />
    <StatTile Icon="bi-grid-3x3-gap" Value="TechniqueCount" Label="Techniques seen" Tone="neutral" />
</div>

<section class="im-card">
    <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
        <div>
            <label class="form-label small mb-0" for="atk-period">Period</label>
            <select id="atk-period" class="form-select form-select-sm" value="@(_months?.ToString() ?? "all")" @onchange="OnPeriodChanged">
                <option value="3">Last 3 months</option>
                <option value="6">Last 6 months</option>
                <option value="12">Last 12 months</option>
                <option value="24">Last 24 months</option>
                <option value="all">All time</option>
            </select>
        </div>
        <div class="form-check mb-1">
            <input class="form-check-input" type="checkbox" id="atk-exercises" checked="@_includeExercises" @onchange="OnExercisesChanged" />
            <label class="form-check-label small" for="atk-exercises">Include exercise cases</label>
        </div>
        <div class="ms-auto small text-muted mb-1">
            By detection date · sub-techniques roll up to their parent · ATT&amp;CK @AttackCatalog.Version
        </div>
    </div>

    @if (_data.CasesWithAttackData == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><span class="bi bi-diagram-3" aria-hidden="true"></span></div>
            <div class="empty-state-title">No ATT&amp;CK data in this period</div>
            <div class="empty-state-msg">
                Techniques appear here once analysts tag them on a case's <em>Overview</em> or record attack steps on its <em>Timeline</em>.
            </div>
        </div>
    }
    else
    {
        <div class="atkh-grid" role="list" aria-label="ATT&CK tactics">
            @foreach (var tac in AllTactics)
            {
                var col = _data.Tactics.FirstOrDefault(t => t.Tactic == tac);
                <div class="atkh-col @(col is null ? "atkh-col-none" : "")" role="listitem" style="--tac:@Ui.TacticColor(tac)">
                    <div class="atkh-colhead" title="@Ui.TacticId(tac)">
                        <span class="bi @Ui.TacticGlyph(tac)" aria-hidden="true"></span>
                        <span class="atkh-colname">@Ui.Label(tac)</span>
                        <span class="atkh-colcount" title="Cases touching this tactic">@(col?.CaseCount ?? 0)</span>
                    </div>
                    <div class="atkh-cells">
                        @if (col is null || col.Techniques.Count == 0)
                        {
                            <div class="atkh-empty">@(col is null ? "Not observed" : "Tactic only, no technique")</div>
                        }
                        else
                        {
                            @foreach (var t in col.Techniques)
                            {
                                var sel = _selected is { } s && s.Tactic == tac && s.Id == t.TechniqueId;
                                <button type="button" class="atkh-cell @(sel ? "atkh-sel" : "")" style="--heat:@Heat(t.CaseCount)%"
                                        @onclick="() => Select(tac, t)" aria-pressed="@(sel ? "true" : "false")"
                                        title="@($"{t.TechniqueId} {t.Name}: {t.CaseCount} case{(t.CaseCount == 1 ? "" : "s")}")">
                                    <code class="atkh-tid">@t.TechniqueId</code>
                                    <span class="atkh-tname">@t.Name</span>
                                    <span class="atkh-n">@t.CaseCount</span>
                                </button>
                            }
                        }
                    </div>
                </div>
            }
        </div>

        @if (SelectedTechnique is { } st)
        {
            <div class="mt-3">
                <h6 class="mb-1">
                    <code>@st.TechniqueId</code> @st.Name
                    <span class="text-muted small">· @Ui.Label(_selected!.Value.Tactic) · @st.CaseCount case@(st.CaseCount == 1 ? "" : "s")</span>
                </h6>
                @if (st.SubTechniques.Count > 0)
                {
                    <div class="small text-muted mb-2">Sub-techniques recorded: @string.Join(", ", st.SubTechniques)</div>
                }
                <ul class="list-unstyled mb-0">
                    @foreach (var c in st.Cases)
                    {
                        <li><a href="@($"cases/{c.CaseId}")"><code class="small">@c.CaseNumber</code></a> <span class="small text-muted">@c.Title</span></li>
                    }
                </ul>
            </div>
        }
        else
        {
            <p class="small text-muted mt-3 mb-0">Select a technique to list the cases behind it.</p>
        }
    }
</section>

@code {
    private static readonly MitreTactic[] AllTactics =
        Enum.GetValues<MitreTactic>().Where(t => t != MitreTactic.Unspecified).OrderBy(Ui.TacticRank).ToArray();

    private AttackCoverage? _data;
    private int? _months = 12;
    private bool _includeExercises;
    private (MitreTactic Tactic, string Id)? _selected;

    private int TechniqueCount => _data?.Tactics.SelectMany(t => t.Techniques).Select(t => t.TechniqueId).Distinct().Count() ?? 0;

    private CoverageTechnique? SelectedTechnique => _selected is { } s
        ? _data?.Tactics.FirstOrDefault(t => t.Tactic == s.Tactic)?.Techniques.FirstOrDefault(t => t.TechniqueId == s.Id)
        : null;

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _data = await Coverage.GetAsync(_months, _includeExercises);
        if (SelectedTechnique is null) _selected = null;
    }

    // 18–85% of the tactic colour over the page background, so a single case still reads as "seen".
    private int Heat(int count) => _data is { MaxTechniqueCases: > 0 } d ? 18 + (int)Math.Round(67.0 * count / d.MaxTechniqueCases) : 18;

    private void Select(MitreTactic tactic, CoverageTechnique t) =>
        _selected = _selected is { } s && s.Tactic == tactic && s.Id == t.TechniqueId ? null : (tactic, t.TechniqueId);

    private async Task OnPeriodChanged(ChangeEventArgs e)
    {
        _months = int.TryParse(e.Value?.ToString(), out var m) ? m : null;
        await Load();
    }

    private async Task OnExercisesChanged(ChangeEventArgs e)
    {
        _includeExercises = e.Value is true;
        await Load();
    }
}
