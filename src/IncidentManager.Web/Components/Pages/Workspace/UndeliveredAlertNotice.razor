@* BUG-101: on a case whose breach-escalation email to Legal / Privacy never went (after every retry), say so to
   everyone who can see the case, so the team doesn't assume Legal knows. An administrator clears it from the banner
   once it's handled. *@
@inject IncidentManager.Application.Notifications.UndeliveredAlertService Alerts
@inject TimeDisplay TimeDisp
@implements IDisposable

@foreach (var a in _alerts)
{
    <div class="alert alert-danger d-flex flex-wrap align-items-center gap-2 py-2" role="alert">
        <span class="bi bi-envelope-exclamation" aria-hidden="true"></span>
        <span>
            <strong>The breach escalation email to Legal / Privacy wasn't delivered.</strong>
            It was tried @(a.Retries + 1) times from @TimeDisp.Short(a.FirstFailedAtUtc). Tell @string.Join(", ", a.Recipients)
            another way; an administrator then marks it handled.
        </span>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CaseId { get; set; }

    private IReadOnlyList<IncidentManager.Application.Notifications.UndeliveredAlert> _alerts = [];
    private Guid _loadedFor;

    // BUG-177: the escalation is given up hours after it first failed, while the case is open in front of the team, and
    // cleared when an administrator marks it handled; so it's read again every couple of minutes.
    private static readonly TimeSpan RefreshEvery = TimeSpan.FromMinutes(2);
    private Timer? _refresh;

    protected override async Task OnParametersSetAsync()
    {
        if (CaseId == _loadedFor) return;
        _loadedFor = CaseId;
        await LoadAsync();
        _refresh ??= new Timer(_ => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); }), null, RefreshEvery, RefreshEvery);
    }

    private async Task LoadAsync()
    {
        var id = _loadedFor;
        try
        {
            var alerts = await Alerts.ForCaseAsync(id);
            if (id == _loadedFor) _alerts = alerts;   // not one read for the case before a switch
        }
        catch (Exception ex) when (ex is not OperationCanceledException) { _alerts = []; }
    }

    public void Dispose() => _refresh?.Dispose();
}
