@* Warnings before a phase change (RD-27: extracted from CaseWorkspace). INV-43: closing with a notification clock still
   running, stated whatever the close gate requires: closing doesn't answer the notification. INV-13: the tasks still
   open for the phases being left behind (or every open task when closing). Warnings only. *@
@inject TimeDisplay TimeDisp
@inject IncidentManager.Application.Abstractions.IUserDirectory Users

@if (To == CasePhase.Closed && Case.Phase != CasePhase.Closed && Notify?.Headline is { IsActive: true } nh)
{
    <div class="alert alert-danger py-2 px-3 small mt-2 mb-0" role="status">
        <div class="fw-semibold">No notification recorded for @nh.JurisdictionLabel</div>
        <div>It's due @(nh.DueAtUtc is { } due ? TimeDisp.Short(due) : "now"). Closing the case doesn't stop the clock:
            the dashboard and the reminders keep tracking it until the reported time is recorded.</div>
    </div>
}
@{ var open = OpenTasksBehind(); }
@if (open.Count > 0)
{
    <div class="alert alert-warning py-2 px-3 small mt-2 mb-0" role="status">
        <div class="fw-semibold mb-1">@IncidentManager.Application.Common.Plural.Of(open.Count, "task") still open</div>
        <ul class="mb-1 ps-3">
            @foreach (var t in open.Take(5))
            {
                <li>@t.Title <span class="text-muted">· @CaseTasksTab.KindLabel(t.Kind)@(string.IsNullOrWhiteSpace(t.Owner) ? "" : $" · {Users.DisplayFor(t.Owner)}")</span></li>
            }
        </ul>
        @if (open.Count > 5) { <div class="text-muted">…and @(open.Count - 5) more.</div> }
        <div class="text-muted">You can continue anyway. They stay open.</div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Case Case { get; set; } = null!;
    /// <summary>The phase being moved to.</summary>
    [Parameter] public CasePhase To { get; set; }
    [Parameter] public IncidentManager.Application.Compliance.CaseNotificationDeadlines? Notify { get; set; }

    private List<ActionItem> OpenTasksBehind()
    {
        if (To <= Case.Phase) return [];
        return Case.ActionItems
            .Where(t => t.IsOpen && (To == CasePhase.Closed || (t.Kind.Phase() is { } p && p < To)))
            .OrderBy(t => t.Kind).ThenBy(t => t.DueAtUtc)
            .ToList();
    }
}
