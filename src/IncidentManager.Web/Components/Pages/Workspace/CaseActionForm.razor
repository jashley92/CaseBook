@* The workspace's action dialogs (RD-27: extracted from CaseWorkspace): the header, fields and Cancel/apply of
   whichever one is open (CaseActionDraft.Name). The workspace hosts it in a modal, or for RD-15's transitions in the
   sheet under the header, opens it (OpenModal fills the draft) and, once it's applied, reloads the case. *@
@inject CaseService Cases
@inject IClock Clock
@inject TimeDisplay TimeDisp
@inject ISeverityLabels SevLabels
@inject IncidentManager.Application.Abstractions.IUserDirectory Users

@{ var T = D.Transition; var backdated = T.Backdated(TimeDisp.Zone, Clock.UtcNow); }
<div class="modal-header">
    <h5 class="modal-title" id="im-action-title">@Title()</h5>
    <button type="button" class="btn-close" aria-label="Close" @onclick="() => OnClose.InvokeAsync()"></button>
</div>
<div class="modal-body">
    @if (D.Name == "reclass")
    {
        @if (Case.Classification is null)
        {
            <p class="small text-muted mb-2">This <strong>Complex Event</strong> hasn't been triaged yet. Promoting it gives it its first formal classification.</p>
        }
        <label class="form-label small" for="ws-reclass-to">@(Case.Classification is null ? "Promote to" : "New classification")</label>
        <select id="ws-reclass-to" class="form-select mb-2" @bind="D.NewClass" @bind:after='() => OnTargetChanged.InvokeAsync("reclass")'>@foreach (var c in Enum.GetValues<Classification>()) { <option value="@c">@Ui.Label(c)</option> }</select>
        <label class="form-label small" for="ws-reclass-reason">Reason <span class="text-muted">(required)</span></label>
        <input id="ws-reclass-reason" class="form-control" placeholder="e.g. new evidence confirms data was exfiltrated" @bind="D.ReclassReason" @bind:event="oninput" />
        <RationaleHint Gate="T.Gate" Text="@D.ReclassReason" />
        <WhenItHappened Draft="T" OnChanged="Changed" />
        <GateSection Draft="T" OnFix="OnFix" OnChanged="Changed" />
    }
    else if (D.Name == "handoff")
    {
        @* INV-15: a structured handoff, prefilled from the record; edit freely. *@
        <label class="form-label small mb-0" for="ws-ho-to">Hand the case to</label>
        <select id="ws-ho-to" class="form-select form-select-sm mb-2" @bind="D.HandoffTo">
            <option value="">Choose a person…</option>
            @* INV-37: only people who can see the case (on a restricted one: its IC, team and cleared roles). *@
            @foreach (var u in D.HandoffPeople.OrderBy(u => u.DisplayName))
            {
                <option value="@u.UserId">@u.DisplayName</option>
            }
        </select>
        <label class="form-label small mb-0" for="ws-ho-state">Where it stands</label>
        <textarea id="ws-ho-state" class="form-control form-control-sm mb-2" rows="3" @bind="D.HandoffState" @bind:event="oninput"></textarea>
        <label class="form-label small mb-0" for="ws-ho-done">Done since the last handoff</label>
        <textarea id="ws-ho-done" class="form-control form-control-sm mb-2" rows="3" @bind="D.HandoffDone" @bind:event="oninput"></textarea>
        <label class="form-label small mb-0" for="ws-ho-open">Still open</label>
        <textarea id="ws-ho-open" class="form-control form-control-sm mb-2" rows="3" @bind="D.HandoffOpen" @bind:event="oninput"></textarea>
        <label class="form-label small mb-0" for="ws-ho-watch">Watch for <span class="text-muted">(optional)</span></label>
        <textarea id="ws-ho-watch" class="form-control form-control-sm mb-2" rows="2" @bind="D.HandoffWatch" @bind:event="oninput"
                  placeholder="e.g. if the other two users' sign-ins show new locations, re-open the scope with Privacy"></textarea>
        <div class="form-check small">
            <input class="form-check-input" type="checkbox" id="ws-ho-post" @bind="D.HandoffEmail" />
            <label class="form-check-label" for="ws-ho-post">Email it to them</label>
        </div>
        <div class="form-check small">
            <input class="form-check-input" type="checkbox" id="ws-ho-tasks" @bind="D.HandoffTasks" />
            <label class="form-check-label" for="ws-ho-tasks">Give them my open tasks on this case (@MyOpenTaskCount)</label>
        </div>
        <p class="small text-muted mt-2 mb-0">Recorded on the timeline as a handoff.</p>
    }
    else if (D.Name == "severity")
    {
        <label class="form-label small" for="ws-severity">New severity</label>
        <select id="ws-severity" class="form-select mb-2" @bind="D.NewSeverity">@foreach (var s in Enum.GetValues<Severity>()) { <option value="@s">@SevLabels.For(s)</option> }</select>
        var raising = D.NewSeverity > Case.Severity;
        <input class="form-control" maxlength="500" placeholder="@(raising ? "Why is it going up? (required)" : backdated ? "Reason (required when recording later)" : "Reason (optional)")" aria-label="Reason" @bind="D.SeverityReason" @bind:event="oninput" />
        <WhenItHappened Draft="T" OnChanged="Changed" />
    }
    else if (D.Name == "status")
    {
        <label class="form-label small" for="ws-status">New status</label>
        <select id="ws-status" class="form-select mb-2" @bind="D.NewPhase" @bind:after='() => OnTargetChanged.InvokeAsync("status")'>@foreach (var p in Enum.GetValues<CasePhase>()) { <option value="@p">@Ui.Label(p)</option> }</select>
        <label class="form-label small" for="ws-status-reason">@(D.NewPhase > Case.Phase ? "What was achieved" : "Reason") <span class="text-muted">@(T.Gate is { RequiresCommentary: true } || backdated ? "(required)" : "(optional)")</span></label>
        <input id="ws-status-reason" class="form-control" placeholder="e.g. containment verified across all affected hosts" @bind="D.PhaseReason" @bind:event="oninput" />
        <RationaleHint Gate="T.Gate" Text="@D.PhaseReason" />
        <WhenItHappened Draft="T" OnChanged="Changed" />
        <TransitionWarnings Case="Case" To="D.NewPhase" Notify="Notify" />
        <GateSection Draft="T" OnFix="OnFix" OnChanged="Changed" />
    }
    else if (D.Name == "supersede")
    {
        <p class="small text-muted mb-2">Marks this case as a duplicate of the one work continues on, links the two and adds a
            note to both. You then close this case as usual.</p>
        <label class="form-label small mb-1" for="ws-supersede-query">Case to keep</label>
        @if (D.SupersedeTargetId is not null)
        {
            <div class="alert alert-info py-1 px-2 small d-flex align-items-center gap-2 mb-2">
                <span>Keeping <code>@D.SupersedeTargetNumber</code></span>
                <button type="button" class="btn btn-link btn-sm p-0 ms-auto" @onclick="() => D.SupersedeTargetId = null">Change</button>
            </div>
        }
        else
        {
            @foreach (var l in D.SupersedeLinked)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary me-1 mb-1" @onclick="() => PickSupersedeTarget(l.OtherCaseId, l.OtherCaseNumber)">
                    <span class="bi bi-link-45deg" aria-hidden="true"></span> @l.OtherCaseNumber <span class="text-muted">(@Ui.CaseLinkLabel(l.Type, l.Outgoing))</span>
                </button>
            }
            <div class="input-group input-group-sm mb-1">
                <input id="ws-supersede-query" class="form-control" placeholder="Search by case number or title" @bind="D.SupersedeQuery" @bind:event="oninput"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await SearchSupersede(); })" />
                <button type="button" class="btn btn-outline-secondary" @onclick="SearchSupersede">Search</button>
            </div>
            @foreach (var r in D.SupersedeResults)
            {
                <button type="button" class="btn btn-sm btn-link d-block text-start p-0 mb-1" @onclick="() => PickSupersedeTarget(r.Id, r.CaseNumber)">
                    <code>@r.CaseNumber</code> <span class="text-muted">@r.Title</span>
                </button>
            }
        }
        <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="supersede-copy" @bind="D.SupersedeCopy" />
            <label class="form-check-label small" for="supersede-copy">Copy this case's indicators to the kept case (ones already there are skipped)</label>
        </div>
        <label class="form-label small mt-2" for="supersede-reason">Why it's a duplicate</label>
        <textarea id="supersede-reason" class="form-control" rows="2" @bind="D.SupersedeReason" @bind:event="oninput"
                  placeholder="e.g. Same phishing wave; the user report and the SIEM alert were filed separately"></textarea>
    }
    else if (D.Name == "restrict")
    {
        <p class="small mb-2">Restricting limits who can see this case. Once restricted:</p>
        <ul class="small mb-2">
            <li>@D.ClearanceNote</li>
            <li>It disappears for everyone else: case lists, search, My Work, dashboards, the indicator and ATT&amp;CK
                views, and exports.</li>
            <li>Assigning someone later gives them access, and removing them takes it away.</li>
            <li>Opening it, or downloading its evidence or reports, is flagged at a higher severity in the SIEM stream.</li>
        </ul>
        @if (!RestrictKeepsMe)
        {
            <div class="alert alert-info py-1 px-2 small mb-2">You'll be added to the case team as an analyst so you keep access.</div>
        }
        <label class="form-label small" for="restrict-reason">Reason <span class="text-muted">(optional, recorded in the audit trail)</span></label>
        <textarea id="restrict-reason" class="form-control" rows="2" maxlength="1000" @bind="D.RestrictReason" @bind:event="oninput"
                  placeholder="e.g. Insider investigation involving a named employee; HR and counsel only"></textarea>
    }
    else if (D.Name == "unrestrict")
    {
        <p class="small mb-2">Lifting the restriction opens this case to <strong>everyone with case access</strong>. It will show up in
            their case lists, search, dashboards and exports.</p>
        <label class="form-label small" for="unrestrict-reason">Reason</label>
        <textarea id="unrestrict-reason" class="form-control" rows="2" maxlength="1000" @bind="D.RestrictReason" @bind:event="oninput"
                  placeholder="e.g. Counsel confirmed the case no longer needs to be restricted"></textarea>
    }
    else if (D.Name == "holdrelease")
    {
        @if (Cases.LegalHoldReleaseNeedsSecondApprover)
        {
            <p class="small text-muted mb-2">Two-person control is on, so this sends a release request. The hold stays in force
                until someone else with Manage Legal approves it from the case.</p>
        }
        else
        {
            <p class="small mb-2">Once released, the case is no longer exempt from your retention policy and an administrator
                can archive it. Release it only after counsel confirms preservation is no longer required.</p>
        }
        <label class="form-label small" for="hold-release-reason">Reason</label>
        <textarea id="hold-release-reason" class="form-control" rows="3" maxlength="1000" @bind="D.HoldReleaseReason" @bind:event="oninput"
                  placeholder="e.g. Litigation settled; counsel confirmed preservation is no longer required"></textarea>
    }
    else if (D.Name == "legal")
    {
        <label class="form-label small" for="legal-contact">Legal contact <span class="text-muted">(optional)</span></label>
        <input id="legal-contact" class="form-control mb-2" placeholder="Name or team" @bind="D.LegalContact" />
        <label class="form-label small" for="legal-note">Regulatory relevance <span class="text-muted">(optional)</span></label>
        <input id="legal-note" class="form-control" placeholder="e.g. NY NPI" @bind="D.LegalNote" />
    }
    else if (D.Name == "materiality")
    {
        <p class="small text-muted mb-2">Record <strong>who</strong> made the call (the SOC, Legal / Privacy or a disclosure committee), when, and why.
            A final determination needs all three. An Incident or Breach can't close while this is open.</p>
        <WhyThisMatters Class="mb-2">
            A determination can start disclosure clocks (for SEC registrants, a Form 8-K is due within four business days),
            and your notification deadlines may count from it. The record shows the call was made deliberately and on time.
        </WhyThisMatters>
        <label class="form-label small" for="ws-mat-status">Determination</label>
        <select id="ws-mat-status" class="form-select mb-2" @bind="D.MaterialityStatus">
            <option value="@MaterialityStatus.UnderReview">Under review (with Legal / committee)</option>
            <option value="@MaterialityStatus.Material">Material</option>
            <option value="@MaterialityStatus.NotMaterial">Not material</option>
        </select>
        <label class="form-label small" for="ws-mat-maker">Decision-maker <span class="text-muted">@(D.MaterialityIsFinal ? "(required)" : "(optional)")</span></label>
        <input id="ws-mat-maker" class="form-control mb-2" placeholder="e.g. Disclosure Committee, General Counsel" @bind="D.MaterialityDecisionMaker" />
        <label class="form-label small" for="ws-mat-date">Decision date <span class="text-muted">@(D.MaterialityIsFinal ? "(required)" : "(optional)")</span></label>
        <input id="ws-mat-date" type="date" class="form-control mb-2" @bind="D.MaterialityDecidedOn" />
        <label class="form-label small" for="ws-mat-rationale">Rationale <span class="text-muted">@(D.MaterialityIsFinal ? "(required)" : "(optional)")</span></label>
        <textarea id="ws-mat-rationale" class="form-control" rows="2" placeholder="Why the case is or isn't material" @bind="D.MaterialityRationale"></textarea>
    }
    else if (D.Name == "archive")
    {
        <p class="mb-0">Archive <code>@Case.CaseNumber</code>? It's hidden from active queues and can be restored later.</p>
    }
    else if (D.Name == "reopen")
    {
        <p class="small text-muted mb-2">Reopen <code>@Case.CaseNumber</code>? It returns to the phase it was in before closing and the closure time is cleared. Closing it again re-runs the close gate.</p>
        <label class="form-label small" for="ws-reopen-reason">Reason <span class="text-muted">(required)</span></label>
        <input id="ws-reopen-reason" class="form-control" placeholder="Why is this case being reopened?" @bind="D.ReopenReason" @bind:event="oninput" />
    }
    else if (D.Name == "assign")
    {
        var people = Users.All();
        @if (people.Count == 0)
        {
            <p class="text-muted small mb-0">There's no one in the directory to assign.</p>
        }
        else
        {
            <label class="form-label small" for="ws-assign-user">Person</label>
            <select id="ws-assign-user" class="form-select mb-2" @bind="D.AssignUserId" @bind:after="OnAssignUserChanged">
                <option value="">Select a person…</option>
                @* Everyone in the directory: picking someone already on the case changes their role (e.g. an analyst
                   taking over as incident commander), so the list marks their current role. *@
                @foreach (var u in people)
                {
                    var current = CurrentRole(u.UserId);
                    <option value="@u.UserId">@u.DisplayName@(current is { } r ? $" (now {Ui.Label(r)})" : "")</option>
                }
            </select>
            @if (Case.IsRestricted)
            {
                <p class="small text-muted mb-2"><span class="bi bi-lock-fill" aria-hidden="true"></span> This case is restricted:
                    assigning someone gives them access to it.</p>
            }
            <label class="form-label small" for="ws-assign-role">Role on this case</label>
            <select id="ws-assign-role" class="form-select" @bind="D.AssignRole">
                @foreach (var r in Enum.GetValues<CaseAssignmentRole>())
                {
                    <option value="@r">@Ui.Label(r)</option>
                }
            </select>
        }
    }
    @if (D.Error is not null) { <p class="text-danger small mt-2 mb-0">@D.Error</p> }
</div>
<div class="modal-footer">
    <button class="btn btn-outline-secondary" @onclick="() => OnClose.InvokeAsync()">Cancel</button>
    <button class="@(D.Name == "archive" ? "btn btn-danger" : "btn btn-primary")" @onclick="Apply" disabled="@PrimaryDisabled()">@PrimaryLabel()</button>
</div>

@code {
    [Parameter, EditorRequired] public Case Case { get; set; } = null!;
    [Parameter, EditorRequired] public CaseActionDraft D { get; set; } = null!;
    [Parameter, EditorRequired] public CaseAccess Access { get; set; } = CaseAccess.None;
    [Parameter] public IncidentManager.Application.Compliance.CaseNotificationDeadlines? Notify { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>The reclassify or phase target changed ("reclass" or "status"): the workspace loads its gate (and
    /// opens the close-out view for Closed).</summary>
    [Parameter] public EventCallback<string> OnTargetChanged { get; set; }
    /// <summary>Applied: what to say, and for a supersede, the reason to close this case with.</summary>
    [Parameter] public EventCallback<(string Done, string? CloseReason)> OnApplied { get; set; }
    [Parameter] public EventCallback OnForbidden { get; set; }
    /// <summary>Someone else changed what this dialog edits (REL-02): the workspace reloads the case behind it.</summary>
    [Parameter] public EventCallback OnStale { get; set; }
    [Parameter] public EventCallback<string> OnFix { get; set; }

    // A child changed the draft (the time, a tick, the justification): re-render so Apply reflects it.
    private void Changed() { }

    private int MyOpenTaskCount => Case.ActionItems.Count(t => t.IsOpen && string.Equals(t.Owner, Access.MyId, StringComparison.OrdinalIgnoreCase));

    /// <summary>Whether the current user would still see the case once restricted (else the service adds them).</summary>
    private bool RestrictKeepsMe => Access.CanLiftRestriction(Case) || Access.IsOnCase(Case);

    private void PickSupersedeTarget(Guid id, string number)
    {
        D.SupersedeTargetId = id;
        D.SupersedeTargetNumber = number;
    }

    private async Task SearchSupersede() =>
        D.SupersedeResults = await Cases.SearchLinkableCasesAsync(Case.Id, D.SupersedeQuery, take: 8);

    private CaseAssignmentRole? CurrentRole(string userId) =>
        Case.Assignments.FirstOrDefault(a => string.Equals(a.UserId, userId, StringComparison.OrdinalIgnoreCase))?.Role;

    // Picking someone already on the case starts from the role they'd most likely move to: the commander seat if
    // it's what the dialog was opened for, otherwise their next step up.
    private void OnAssignUserChanged()
    {
        if (CurrentRole(D.AssignUserId) is { } now && now == D.AssignRole)
            D.AssignRole = now == CaseAssignmentRole.IncidentCommander ? CaseAssignmentRole.Analyst : CaseAssignmentRole.IncidentCommander;
    }

    private string Title() => D.Name switch
    {
        "reclass" => Case.Classification is null ? "Promote onto the ladder" : "Reclassify case",
        "severity" => "Change severity",
        "handoff" => "Hand off the case",
        "status" => "Change phase",
        "legal" => "Refer to Legal / Privacy",
        "holdrelease" => Cases.LegalHoldReleaseNeedsSecondApprover ? "Request legal hold release" : "Release legal hold",
        "supersede" => "Supersede as a duplicate",
        "restrict" => "Restrict to need-to-know",
        "unrestrict" => "Lift restriction",
        "materiality" => "Record materiality determination",
        "archive" => "Archive case",
        "assign" => "Assign someone to this case",
        "reopen" => "Reopen case",
        _ => ""
    };

    private string PrimaryLabel() => D.Name switch
    {
        "archive" => "Archive",
        "assign" => CurrentRole(D.AssignUserId) is null ? "Assign" : "Change role",
        "reopen" => "Reopen",
        "holdrelease" => Cases.LegalHoldReleaseNeedsSecondApprover ? "Request release" : "Release hold",
        "supersede" => "Supersede",
        "handoff" => "Hand off",
        "restrict" => "Restrict",
        "unrestrict" => "Lift restriction",
        _ => "Apply"
    };

    // Keep the primary disabled until required input is present. FR-14: the predicate mirrors the on-click
    // validation in Apply exactly, so the button is disabled precisely when a submit would be rejected.
    private bool PrimaryDisabled()
    {
        var t = D.Transition;
        var backdated = t.Backdated(TimeDisp.Zone, Clock.UtcNow);
        return D.Name switch
        {
            "assign" => string.IsNullOrEmpty(D.AssignUserId) || CurrentRole(D.AssignUserId) == D.AssignRole,
            "reopen" => string.IsNullOrWhiteSpace(D.ReopenReason),
            "holdrelease" => string.IsNullOrWhiteSpace(D.HoldReleaseReason),
            "supersede" => D.SupersedeTargetId is null || string.IsNullOrWhiteSpace(D.SupersedeReason),
            "unrestrict" => string.IsNullOrWhiteSpace(D.RestrictReason),
            // A final call needs decision-maker, date and rationale; "Under review" needs none of them.
            "materiality" => D.MaterialityIsFinal
                && (string.IsNullOrWhiteSpace(D.MaterialityDecisionMaker) || D.MaterialityDecidedOn is null
                    || string.IsNullOrWhiteSpace(D.MaterialityRationale)),
            // Reclass always needs a reason; both gated dialogs need an override justification when a blocking
            // requirement is unmet, and a long-enough rationale when the gate requires commentary.
            "reclass" => string.IsNullOrWhiteSpace(D.ReclassReason) || t.When is null
                || (t.NeedsOverride && string.IsNullOrWhiteSpace(t.Override))
                || t.RationaleError(D.ReclassReason) is not null,
            "status" => (t.NeedsOverride && string.IsNullOrWhiteSpace(t.Override))
                || t.RationaleError(D.PhaseReason) is not null
                || t.When is null || (backdated && string.IsNullOrWhiteSpace(D.PhaseReason)),
            "severity" => t.When is null || ((backdated || D.NewSeverity > Case.Severity) && string.IsNullOrWhiteSpace(D.SeverityReason)),   // HR-11
            "handoff" => string.IsNullOrWhiteSpace(D.HandoffTo) || string.IsNullOrWhiteSpace(D.HandoffState),
            _ => false
        };
    }

    private async Task Apply()
    {
        D.Error = null;
        var t = D.Transition;
        var id = Case.Id;
        string? closeReason = null;
        try
        {
            string done;
            switch (D.Name)
            {
                case "reclass":
                    if (string.IsNullOrWhiteSpace(D.ReclassReason)) { D.Error = "Enter a reason."; return; }
                    if (t.NeedsOverride && string.IsNullOrWhiteSpace(t.Override))
                    { D.Error = "Enter an override justification for the unmet requirements."; return; }
                    if (t.RationaleError(D.ReclassReason) is { } m1) { D.Error = m1; return; }
                    await Cases.ReclassifyAsync(id, D.NewClass, D.ReclassReason,
                        t.Attested.Count > 0 ? t.Attested : null, t.Override, t.EffectiveUtc(TimeDisp.Zone));
                    D.ReclassReason = "";
                    done = $"Reclassified to {Ui.Label(D.NewClass)}";
                    break;
                case "handoff":
                {
                    var moved = await Cases.HandOffAsync(id, D.HandoffTo!, HandoffBody(), D.HandoffTasks, notify: D.HandoffEmail);
                    done = $"Handed off to {Users.DisplayFor(D.HandoffTo)}" + (moved > 0 ? $" · {IncidentManager.Application.Common.Plural.Of(moved, "task")} reassigned" : "");
                    break;
                }
                case "severity":
                    await Cases.ChangeSeverityAsync(id, D.NewSeverity, D.SeverityReason, t.EffectiveUtc(TimeDisp.Zone));
                    D.SeverityReason = null;
                    done = $"Severity changed to {SevLabels.For(D.NewSeverity)}";
                    break;
                case "status":
                    if (t.NeedsOverride && string.IsNullOrWhiteSpace(t.Override))
                    { D.Error = "Enter an override justification for the unmet requirements."; return; }
                    if (t.RationaleError(D.PhaseReason) is { } m2) { D.Error = m2; return; }
                    await Cases.ChangePhaseAsync(id, D.NewPhase, D.PhaseReason,
                        t.Attested.Count > 0 ? t.Attested : null, t.Override, t.EffectiveUtc(TimeDisp.Zone));
                    D.PhaseReason = null;
                    done = $"Phase changed to {Ui.Label(D.NewPhase)}";
                    break;
                case "supersede":
                {
                    var res = await Cases.SupersedeAsync(id, D.SupersedeTargetId!.Value, D.SupersedeCopy, D.SupersedeReason ?? "");
                    closeReason = $"Duplicate of {res.PrimaryCaseNumber}: {D.SupersedeReason?.Trim()}";
                    done = $"Superseded by {res.PrimaryCaseNumber}" + (D.SupersedeCopy ? $" · {IncidentManager.Application.Common.Plural.Of(res.IndicatorsCopied, "indicator")} copied" : "")
                           + ". Close this case to finish.";
                    break;
                }
                case "restrict":
                    await Cases.SetRestrictedAsync(id, true, D.RestrictReason);
                    D.RestrictReason = null;
                    done = "Case restricted to need-to-know";
                    break;
                case "unrestrict":
                    if (string.IsNullOrWhiteSpace(D.RestrictReason)) { D.Error = "Enter a reason for lifting the restriction."; return; }
                    await Cases.SetRestrictedAsync(id, false, D.RestrictReason);
                    D.RestrictReason = null;
                    done = "Restriction lifted";
                    break;
                case "holdrelease" when Cases.LegalHoldReleaseNeedsSecondApprover:
                    await Cases.RequestLegalHoldReleaseAsync(id, D.HoldReleaseReason ?? "");
                    D.HoldReleaseReason = null;
                    done = "Release requested. Someone else with Manage Legal must approve it.";
                    break;
                case "holdrelease":
                    await Cases.SetLegalHoldAsync(id, false, D.HoldReleaseReason);
                    D.HoldReleaseReason = null;
                    done = "Legal hold released";
                    break;
                case "legal":
                    await Cases.ReferToLegalAsync(id, D.LegalContact, D.LegalNote, D.LegalBaseline);
                    done = "Referred to Legal / Privacy";
                    break;
                case "materiality":
                    DateTimeOffset? decidedOn = D.MaterialityDecidedOn is { } d
                        ? new DateTimeOffset(DateTime.SpecifyKind(d.Date, DateTimeKind.Utc)) : null;
                    await Cases.RecordMaterialityAsync(id, D.MaterialityStatus, D.MaterialityDecisionMaker, decidedOn,
                        D.MaterialityRationale, D.MaterialityBaseline);
                    done = $"Materiality recorded: {Ui.Label(D.MaterialityStatus)}";
                    break;
                case "archive":
                    await Cases.SetArchivedAsync(id, true);
                    done = "Case archived";
                    break;
                case "reopen":
                    if (string.IsNullOrWhiteSpace(D.ReopenReason)) { D.Error = "Enter a reason."; return; }
                    await Cases.ReopenAsync(id, D.ReopenReason);
                    D.ReopenReason = "";
                    done = "Case reopened";
                    break;
                case "assign":
                    if (string.IsNullOrWhiteSpace(D.AssignUserId)) { D.Error = "Select a person to assign."; return; }
                    var assignName = Users.Resolve(D.AssignUserId)?.DisplayName ?? D.AssignUserId;
                    var wasOn = CurrentRole(D.AssignUserId) is not null;
                    await Cases.AssignAsync(id, D.AssignUserId, assignName, D.AssignRole);
                    done = wasOn ? $"{assignName} is now {Ui.Label(D.AssignRole)}" : $"Assigned {assignName}";
                    D.AssignUserId = "";
                    D.AssignRole = CaseAssignmentRole.Analyst;
                    break;
                default:
                    done = "";
                    break;
            }
            await OnApplied.InvokeAsync((done, closeReason));
        }
        catch (ForbiddenException)
        {
            // REL-08: access was revoked since the case loaded; the workspace closes the dialog and explains.
            await OnForbidden.InvokeAsync();
        }
        catch (GateNotSatisfiedException ex)
        {
            D.Error = ex.Message;
        }
        catch (StaleEditException ex)
        {
            // REL-02: another author changed the referral / materiality while this dialog was open. Keep it open with
            // the user's entries intact, refresh the rest of the workspace to the newer values, and re-baseline so a
            // deliberate re-apply overwrites (mirrors the details/impact editors, FR-06).
            if (D.Name == "legal") D.LegalBaseline = ex.CurrentStamp;
            else if (D.Name == "materiality") D.MaterialityBaseline = ex.CurrentStamp;
            D.Error = ex.Message + " Your entries weren't saved. Review the current values, then select Apply again to overwrite them, or Cancel to discard yours.";
            await OnStale.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            D.Error = ex.Message;
        }
    }

    // The handoff as Markdown: the same text goes on the timeline and, if chosen, in the email to the recipient.
    private string HandoffBody()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("**Handed to ").Append(Users.DisplayFor(D.HandoffTo)).Append("**\n\n");
        void Part(string label, string? text)
        {
            if (string.IsNullOrWhiteSpace(text)) return;
            sb.Append("**").Append(label).Append("**\n\n").Append(text.Trim()).Append("\n\n");
        }
        Part("Where it stands", D.HandoffState);
        Part("Done since the last handoff", D.HandoffDone);
        Part("Still open", D.HandoffOpen);
        Part("Watch for", D.HandoffWatch);
        return sb.ToString().TrimEnd();
    }
}
