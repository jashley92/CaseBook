@* Shown for an address CaseBook doesn't know, instead of a blank page: a typed or stale URL (the 404
   status-code redirect in Program.cs sends page GETs here) or an in-app link to a route that doesn't
   exist (the Router's NotFoundPage). Keeps the normal chrome so the user can navigate straight on. *@
@page "/not-found"
@attribute [Authorize]

<PageTitle>Page not found · CaseBook</PageTitle>

<div class="empty-state my-5">
    <div class="empty-state-icon"><span class="bi bi-signpost-split" aria-hidden="true"></span></div>
    <h1 class="h4 mb-2">Page not found</h1>
    <p class="text-muted mb-3">
        @if (!string.IsNullOrWhiteSpace(From))
        {
            <span>There's nothing at <code>@From</code>. </span>
        }
        The link may be mistyped or out of date.
    </p>
    <div class="d-flex justify-content-center gap-2">
        <a class="btn btn-primary" href="cases">Go to cases</a>
        <a class="btn btn-outline-secondary" href="">Dashboard</a>
    </div>
</div>

@code {
    // Display only (never a link), like the access-denied page's refused path.
    [SupplyParameterFromQuery(Name = "from")] private string? From { get; set; }
}
