    private async Task CompleteTask(Guid id)
    {
        if (_completing || _done.Current is not { } session || session.Key != id) return;
        _completing = true;
        // BUG-601: what this form held, read once. The form can be cancelled and another task's opened while the save
        // runs; the toast and the phase offer were built from that other task's text.
        var result = string.IsNullOrWhiteSpace(_doneResult) ? null : _doneResult;
        var logged = _doneLog && result is not null;
        var known = _doneKnown && !string.IsNullOrWhiteSpace(_doneKnownLine);
        // C3: left at the minute the form opened with, it's "now" (the server's); a time typed back has no seconds.
        DateTimeOffset? at = WallClock.ToMinute(_doneWhen) == WallClock.ToMinute(_doneWhenDefault) ? null : WallClock.ToUtc(_doneWhen, TimeDisp.Zone);
        try
        {
            var doneBy = _doneBy == ExternalOwnerSentinel ? _doneByExternal : _doneBy;
            await Cases.CompleteActionItemAsync(CaseId, id, at,
                result, logged ? _doneType : null, doneBy: doneBy,
                knownLine: _doneKnown   // WF-104: [[tags]] as in the brief
                    ? IncidentManager.Application.Content.TagText.FromEditable(_doneKnownLine, new Dictionary<string, string>(),
                        Case.Entities.Select(x => (x.Id, x.Label, x.Value)))
                    : null);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); return; }
        finally { _completing = false; }
        _done.CloseIf(session);
        _selected.Remove(id);
        Toasts.Success((logged ? "Task done and result added to the timeline" : "Task done") + (known ? "; Known updated" : ""));
        // HR-10: containment, eradication or recovery work finished ahead of the case's phase.
        _advanceOffer = Case.ActionItems.FirstOrDefault(x => x.Id == id) is { Kind: TaskKind.Contain or TaskKind.Eradicate or TaskKind.Recover } done
                        && done.Kind.Phase() is { } phase && Case.Phase < phase && Case.Phase != CasePhase.Closed
            ? (phase, result is null ? done.Title : result.Trim(), at)
            : null;
        await OnChanged.InvokeAsync();
    }

    /// <summary>HR-10: ask the workspace to open its phase dialog for this phase, pre-filled with what was achieved and when.</summary>
    [Parameter] public EventCallback<(CasePhase Phase, string Achieved, DateTimeOffset? At)> OnAdvancePhase { get; set; }
    private (CasePhase Phase, string Achieved, DateTimeOffset? At)? _advanceOffer;

    private async Task AcceptAdvance()
    {
        if (_advanceOffer is not { } offer) return;
        _advanceOffer = null;
        await OnAdvancePhase.InvokeAsync(offer);
    }

    private async Task MarkSelectedDone()
    {
        if (_inFlight) return;
        _inFlight = true;
        try { await MarkSelectedDoneCore(); }
        finally { _inFlight = false; }
    }

    private async Task MarkSelectedDoneCore()
    {
        if (_selected.Count == 0) return;
        var done = 0;
        foreach (var id in _selected.Intersect(OpenTaskIds).ToList())
        {
            try { await Cases.SetActionItemStatusAsync(CaseId, id, ActionItemStatus.Done); done++; }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); }
        }
        _selected.Clear();
        if (done > 0)
        {
            Toasts.Success($"Marked {done} task{(done == 1 ? "" : "s")} done");
            await OnChanged.InvokeAsync();
        }
    }

    // --- Apply playbook (E-06) ---
    private void BeginApplyTemplate()
    {
        _applyingTemplate = true;
        _applyTemplate = null;
        _applySelected.Clear();
        _applyDefaultOwner = null;
    }

    /// <summary>CAP-11: the playbook notice's "Add them…": the playbook to open the apply card on.</summary>
    [Parameter] public Guid? OfferTemplateId { get; set; }
    [Parameter] public EventCallback OnOfferHandled { get; set; }

    // CAP-11: opens the apply card on the offered playbook with the steps the case doesn't have ticked (PlaybookOffer, the
    // notice's own reading, C2). Applying is the usual ApplyTemplateAsync with those steps. C7: a card already open with
    // another playbook or other steps ticked isn't replaced; CAP-11 review: one already open as offered is left as it is.
    private async Task TakeOffer(Guid templateId)
    {
        await OnOfferHandled.InvokeAsync();
        if (!CanEdit) return;
        if (_applyTemplates?.FirstOrDefault(t => t.Id == templateId) is not { } template)
        {
            Toasts.Error("That playbook is no longer available. Choose one from Apply playbook.");
            return;
        }
        var missing = PlaybookOffer.MissingSteps(template, Case.ActionItems.Select(t => t.Title)).Select(s => s.Id).ToHashSet();
        switch (PlaybookOffer.Take(_applyingTemplate ? _applyTemplate?.Id : null, _applySelected, templateId, missing))
        {
            case OfferTake.Keep: return;   // the default owner chosen in it stays
            case OfferTake.Refuse:
                Toasts.Error("You're already applying a playbook. Add its tasks or cancel it, then try again.");
                return;
        }
        _applyingTemplate = true;
        _applyTemplate = template;
        _applySelected.Clear();
        _applySelected.UnionWith(missing);
        _applyDefaultOwner = null;
    }

    private void CancelApplyTemplate()
    {
        _applyingTemplate = false;
        _applyTemplate = null;
        _applySelected.Clear();
        _applyDefaultOwner = null;
    }

    private void OnApplyTemplateChanged(ChangeEventArgs e)
    {
        _applyTemplate = Guid.TryParse(e.Value?.ToString(), out var id)
            ? _applyTemplates?.FirstOrDefault(t => t.Id == id) : null;
        _applySelected.Clear();
        if (_applyTemplate is not null)
            foreach (var s in _applyTemplate.Steps) _applySelected.Add(s.Id); // all checked by default
    }

    private void ToggleApplyStep(Guid stepId, bool on)
    {
        if (on) _applySelected.Add(stepId); else _applySelected.Remove(stepId);
    }

    private async Task ApplyKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || !(e.CtrlKey || e.MetaKey) || e.Repeat || !CanEdit) return;
        await ApplyTemplate();
