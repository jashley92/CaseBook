    public static string KindLabel(TaskKind k) => k switch
    {
        TaskKind.General => "General",
        TaskKind.Investigate => "Investigate",
        TaskKind.Contain => "Contain",
        TaskKind.Eradicate => "Eradicate",
        TaskKind.Recover => "Recover",
        TaskKind.Notify => "Notify",
