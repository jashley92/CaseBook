        // Seed the due date/time in the viewer's active display zone (what they see is what they picked).
        if (t.DueAtUtc is { } due)
        {
            var shown = DayValues.FromUtc(due, TimeDisp.Zone, OrgZone.Current);   // WF-64
            (_editDueDate, _editDueTime) = shown;
            _editDueShown = shown;   // BUG-571
        }
        else { _editDueDate = null; _editDueTime = null; _editDueShown = null; }
        _editDueStored = t.DueAtUtc;
        _editSeed = EditValues();
    }

    private object EditValues() => (_editTitle, _editOwner, _editOwnerExternal, _editStatus, _editCancelReason, _editKind,
        _editDescription, (_editDueDate, _editDueTime));

    private void CancelEdit() => _edit.Close();

    // BUG-93: the same one-at-a-time guard for editing, completing and the bulk "mark done".
    private async Task SaveEdit()
    {
        if (_inFlight) return;
        _inFlight = true;
        try { await SaveEditCore(); }
        finally { _inFlight = false; }
    }

    private async Task SaveEditCore()
    {
        if (_edit.Current is not { } session || string.IsNullOrWhiteSpace(_editTitle)) return;
        var id = session.Key;
        var owner = _editOwner switch
        {
            ExternalOwnerSentinel => string.IsNullOrWhiteSpace(_editOwnerExternal) ? null : _editOwnerExternal.Trim(),
            null or "" => null,
            var u => u
        };
        try
        {
            await Cases.UpdateActionItemAsync(CaseId, id, _editTitle, owner,
                DayValues.Kept(_editDueDate, _editDueTime, _editDueShown, _editDueStored, TimeDisp.Zone, OrgZone.Current), _editStatus, _editDescription, _editKind, cancelReason: _editCancelReason,
                expectedStamp: _editStamp);
            _edit.CloseIf(session);
            await OnChanged.InvokeAsync();
            Toasts.Success("Task updated");
        }
        catch (StaleEditException ex)
        {
            // Their change wins; the editor closes on the reloaded task rather than re-saving over it.
            _edit.CloseIf(session);
            Toasts.Error(ex.Message);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
    }

