    // --- INV-08: complete one task, optionally recording its result on the timeline ---
    // BUG-578: Mark done on a second task while one's result is open is refused; BUG-601: its save closes only its own.
    private readonly EditSlot<Guid> _done = new();
    private string? _doneResult;
    private bool _doneKnown;
    private string? _doneKnownLine;
    private static string? FirstLine(string? text) =>
        string.IsNullOrWhiteSpace(text) ? null : text.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
    private DateTime _doneWhen;
    private DateTime _doneWhenDefault;
    private bool _doneLog = true;
    private string _doneBy = "";               // HR-02: who did the work (defaults to whoever marks it done)
    private string? _doneByExternal;
    private TimelineEntryType _doneType = TimelineEntryType.Other;
    private bool _completing;

    // The investigation types a task result can be logged as: not a Decision (that needs a why) and not the
    // third-party disclosure milestones.
    internal static IReadOnlyList<TimelineEntryType> LoggableTypes =>
        Ui.Options<TimelineEntryType>("TimelineEntryType")
            .Where(t => t is not (TimelineEntryType.Decision or TimelineEntryType.Notified or TimelineEntryType.ScopeConfirmed
                or TimelineEntryType.DataConfirmed or TimelineEntryType.Remediation or TimelineEntryType.RegulatoryNotification))
            .ToList();

    /// <summary>
    /// The type a task's result is logged as. HR-10: what the task was (Contain → Containment); a question's answer is
    /// Analysis. BUG-478: a type an admin has hidden can't show in the select, so then the first one offered. BUG-508:
    /// shared with Now/Next, which has no select and logged every result as Analysis.
    /// </summary>
    public static TimelineEntryType ResultTypeFor(ActionItem t, IReadOnlyList<TimelineEntryType> offered)
    {
        var wanted = t.FollowsUpQuestion ? TimelineEntryType.Analysis : t.Kind.ResultType();
        return offered.Count == 0 || offered.Contains(wanted) ? wanted : offered[0];
    }

    internal static TimelineEntryType ResultTypeFor(ActionItem t) => ResultTypeFor(t, LoggableTypes);

    private void BeginComplete(ActionItem t)
    {
        if (!_done.TryOpen(t.Id, Toasts, "result")) return;
        _doneType = ResultTypeFor(t);
        _doneResult = null; _doneKnown = false; _doneKnownLine = null;
        _doneWhen = _doneWhenDefault = WallClock.ToWall(Clock.UtcNow, TimeDisp.Zone);
        _doneLog = true;
        _doneBy = CurrentUser.UserId;
        _doneByExternal = null;
    }

    private void CancelComplete() => _done.Close();

    private bool _moving;

    // Cancelling a task from its row, with an optional reason.
    // --- FR-54: a task's owner changed in place (the owner chip, "Take it") ---
    private const string KeepOwner = "keep";
    private Guid? _ownerFor;
    private bool _owning, _ownerFocus;
    private ElementReference _ownerPick;   // focused when it opens, so leaving it closes it

