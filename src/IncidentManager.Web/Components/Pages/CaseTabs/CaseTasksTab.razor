                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelComplete">Cancel</button>
                                    <button class="btn btn-sm btn-primary" disabled="@(_completing || (t.FollowsUpQuestion && string.IsNullOrWhiteSpace(_doneResult)))" @onclick="() => CompleteTask(t.Id)">Mark done</button>
                                </div>
                            </div>
                        </td>
