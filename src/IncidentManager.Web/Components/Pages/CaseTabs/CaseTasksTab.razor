        _inFlight = true;
        try { await AddCommentCore(taskId); }
        finally { _inFlight = false; }
    }

    private async Task AddCommentCore(Guid taskId)
    {
        var body = CommentDraft(taskId);
        if (string.IsNullOrWhiteSpace(body)) return;
        try
