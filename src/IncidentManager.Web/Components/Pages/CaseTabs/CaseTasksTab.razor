@* Case workspace — Tasks tab (UX-13, the final tab). After-action items: add a follow-up (owner +
   due date in the viewer's zone), the apply-playbook flow (E-06), and the item list with mark-done.
   Self-contained — it loads its own playbook templates and builds due-dates itself; the parent threads
   the live-collab flash (delegates), a Reload after a write (OnChanged), and Ctrl+Enter (SubmitAsync via @ref). *@
@implements IDisposable
@inject CaseService Cases
@inject IncidentManager.Application.Cases.ActionItemCommentService Comments
@inject IncidentManager.Application.Admin.CaseTemplateService Templates
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IClock Clock
@inject IncidentManager.Application.Abstractions.ICurrentUser CurrentUser
@inject TimeDisplay TimeDisp
@inject IncidentManager.Application.Abstractions.IOrganizationTimeZone OrgZone
@inject ToastService Toasts
@inject UnsavedEdits Edits
@inject IncidentManager.Application.Lessons.LessonsService Lessons
@inject IJSRuntime JS

<AuthorizeView Policy="@Policies.EditCases">
    @if (_applyTemplates is { Count: > 0 })
    {
        <div class="d-flex justify-content-end mb-2">
            @if (!_applyingTemplate)
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="BeginApplyTemplate">
                    <span class="bi bi-clipboard-check me-1"></span>Apply playbook
                </button>
            }
        </div>
        @if (_applyingTemplate)
        {
            @* BUG-425: Ctrl/Cmd+Enter in the playbook card adds its tasks, not the composer's. *@
            <div class="card mb-3 border-primary im-own-keys" @onkeydown="ApplyKey">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><span class="bi bi-clipboard-check me-1"></span>Apply a playbook</span>
                    <button class="btn-close" aria-label="Cancel" @onclick="CancelApplyTemplate"></button>
                </div>
                <div class="card-body">
                    <label class="form-label small mb-0" for="task-playbook">Playbook</label>
                    <select id="task-playbook" class="form-select form-select-sm mb-3" style="max-width:28rem" @onchange="OnApplyTemplateChanged"
                            value="@(_applyTemplate?.Id.ToString() ?? "")">
                        <option value="">Choose a playbook</option>
                        @foreach (var t in _applyTemplates)
                        {
                            <option value="@t.Id">@t.Name@(t.Steps.Count > 0 ? $" ({t.Steps.Count} steps)" : "")</option>
                        }
                    </select>

                    @if (_applyTemplate is not null)
                    {
                        @if (_applyTemplate.Steps.Count == 0)
                        {
                            <p class="text-muted small">This playbook has no steps to add.</p>
                        }
                        else
                        {
                            <p class="small text-muted mb-2">Uncheck steps you don't need. Each task goes to the step's owner, or to the case owner if the step has none. Due dates count from now.</p>
                            <div class="border rounded p-2 mb-2">
                                @* CAP-11: a step whose title is already a task (trimmed, ignoring case, as PlaybookOffer compares) says so. *@
                                @{ var applyOnCase = Case.ActionItems.Select(t => t.Title.Trim()).ToHashSet(StringComparer.OrdinalIgnoreCase); }
                                @foreach (var s in _applyTemplate.Steps)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="apply-step-@s.Id"
                                               checked="@_applySelected.Contains(s.Id)"
                                               @onchange="e => ToggleApplyStep(s.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label" for="apply-step-@s.Id">
                                            @s.Title
                                            @if (s.DueOffsetHours is { } h) { <span class="im-badge im-b-warn ms-1">+@FormatOffset(h)</span> }
                                            @if (!string.IsNullOrWhiteSpace(s.OwnerHint)) { <span class="im-badge im-b-neutral ms-1">@s.OwnerHint</span> }
                                            @if (applyOnCase.Contains(s.Title.Trim())) { <span class="im-badge im-b-neutral ms-1">already a task</span> }
                                        </label>
                                    </div>
                                }
                            </div>

                            @* U-45: no case owner yet — hint-less steps would land Unassigned. Offer a default owner. *@
                            @if (string.IsNullOrWhiteSpace(Case.IncidentCommander))
                            {
                                <div class="alert alert-warning py-2 px-2 small mb-0">
                                    <span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>
                                    This case has no incident commander yet, so steps without an owner will be added as
                                    <strong>Unassigned</strong>. Choose a default owner for them, or leave them unassigned.
                                    <div class="mt-2" style="max-width:20rem">
                                        <select class="form-select form-select-sm" aria-label="Default owner" @bind="_applyDefaultOwner">
                                            <option value="">Leave unassigned</option>
                                            @foreach (var u in Users.All())
                                            {
                                                <option value="@u.UserId">@u.DisplayName</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
                <div class="card-footer d-flex gap-2">
                    <button class="btn btn-sm btn-primary" @onclick="ApplyTemplate"
                            disabled="@(_applyTemplate is null || _applySelected.Count == 0)">
                        Add @_applySelected.Count task@(_applySelected.Count == 1 ? "" : "s")
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelApplyTemplate">Cancel</button>
                </div>
            </div>
        }
    }
    @* Phones: the add-task form folds behind a button so the task list starts near the top. *@
    <button type="button" class="btn btn-sm btn-outline-primary mb-3 d-sm-none" aria-expanded="@Ui.Aria(_addOpen)"
            aria-controls="task-add-form" @onclick="() => _addOpen = !_addOpen">
        <span class="bi @(_addOpen ? "bi-chevron-up" : "bi-plus-lg") me-1" aria-hidden="true"></span>@(_addOpen ? "Hide form" : "Add task")
    </button>
    @* Down a long task list, Add stays to hand (shown by CSS once the form has scrolled away), and opens the same form
       popped out at the right, so the reader keeps their place. Its slot keeps its height meanwhile, so nothing moves. *@
    <button type="button" class="btn btn-primary tl-add-fab task-add-fab" @onclick="OpenAddDocked">
        <span class="bi bi-plus-lg" aria-hidden="true"></span> Add task
    </button>
    <div id="task-add-slot" class="mb-3">
    <div id="task-add-form" class="card @(_addOpen ? "" : "im-phone-collapsed")" role="region" aria-label="Add a task">
        @* Shown only while the form is popped out (CSS: html[data-task-docked]). *@
        <div class="task-docked-head">
            <h2 class="im-entity-panel-h mb-0">Add a task</h2>
            <button type="button" class="btn-close" aria-label="Close the form (what's typed stays)" @onclick="CloseAddDocked"></button>
        </div>
        <div class="card-body row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-0" for="task-title">Task</label>
                <input id="task-title" class="form-control form-control-sm" @ref="_titleInput" @bind="_taskTitle" @bind:event="oninput" @onkeydown="OnTitleKey" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0" for="task-owner">Owner</label>
                <select id="task-owner" class="form-select form-select-sm" @bind="_taskOwner">
                    <option value="">Unassigned</option>
                    @foreach (var u in Users.All())
                    {
                        <option value="@u.UserId">@u.DisplayName</option>
                    }
                    <option value="@ExternalOwnerSentinel">External / other…</option>
                </select>
                @if (_taskOwner == ExternalOwnerSentinel)
                {
                    @* U-45: an external owner (e.g. a vendor contact) not in the directory. *@
                    <input class="form-control form-control-sm mt-1" aria-label="External owner name" @bind="_taskOwnerExternal" @bind:event="oninput"
                           placeholder="External owner name" />
                }
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0" for="task-kind">Kind</label>
                <select id="task-kind" class="form-select form-select-sm" @bind="_taskKind">
                    @foreach (var k in Enum.GetValues<TaskKind>())
                    {
                        <option value="@k">@KindLabel(k)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0" for="task-due-date">Due date</label>
                <DateInput id="task-due-date" class="form-control form-control-sm" @bind-Value="_taskDueDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0" for="task-due-time">Time (@TimeDisp.Label)</label>
                <TimeInput id="task-due-time" class="form-control form-control-sm" @bind-Value="_taskDueTime"
                       title="Leave blank for end of day." />
            </div>
            <div class="col-md-1 task-add-actions">
                <button class="btn btn-sm btn-primary w-100" title="Ctrl / ⌘ + Enter" @onclick="AddTask" disabled="@string.IsNullOrWhiteSpace(_taskTitle)">Add task</button>
            </div>
        </div>
    </div>
    </div>
</AuthorizeView>

@if (_advanceOffer is { } offer && CanEdit && Case.Phase < offer.Phase)
{
    @* HR-10: finishing the work of a later phase offers to move the case there: one human act, through the usual
       phase dialog (gate, effective time), with the result as what was achieved. *@
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 py-2 small" role="status">
        <span class="bi bi-signpost-split" aria-hidden="true"></span>
        <span class="flex-grow-1">That was @Ui.Label(offer.Phase).ToLowerInvariant() work. Move the case to @Ui.Label(offer.Phase), with this result as what was achieved?</span>
        <button type="button" class="btn btn-sm btn-primary" @onclick="AcceptAdvance">Move to @Ui.Label(offer.Phase)…</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _advanceOffer = null">Not now</button>
    </div>
}

@if (Case.ActionItems.Count == 0)
{
    <p class="text-muted">No tasks yet.@(CanEdit ? " Add the first one above." : "")</p>
}
else
{
    @* PROD-21: multi-select complete — tick several open tasks and close them in one action. *@
    @if (CanEdit && _selected.Count > 0)
    {
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="small text-muted">@_selected.Count selected</span>
            <button class="btn btn-sm btn-success" @onclick="MarkSelectedDone">
                <span class="bi bi-check2-all me-1" aria-hidden="true"></span>Mark @_selected.Count done
            </button>
            <button class="btn btn-sm btn-link p-0" @onclick="() => _selected.Clear()">Clear selection</button>
        </div>
    }
    var colCount = CanEdit ? 6 : 5;
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                @if (CanEdit)
                {
                    <th style="width:1%">
                        <input class="form-check-input" type="checkbox" title="Select all open tasks"
                               aria-label="Select all open tasks"
                               checked="@(OpenTaskIds.Count > 0 && _selected.Count == OpenTaskIds.Count)"
                               @onchange="e => ToggleSelectAll(OpenTaskIds, (bool)(e.Value ?? false))" />
                    </th>
                }
                <th>Task</th><th>Owner</th><th>Due</th><th>Status</th><th></th>
            </tr>
        </thead>
        <tbody>
            @{ TaskKind? lastKind = null; }
            @foreach (var t in OrderedTasks())
            {
                @if (Grouped && t.Kind != lastKind)
                {
                    lastKind = t.Kind;
                    var inKind = Case.ActionItems.Where(x => x.Kind == t.Kind).ToList();
                    @* INV-13: tasks grouped by the kind of response work, with how many are done. *@
                    <tr class="im-task-group" @key="@($"group-{t.Kind}")">
                        <td colspan="@colCount">
                            <span class="fw-semibold">@KindLabel(t.Kind)</span>
                            <span class="text-muted small ms-2">@inKind.Count(x => !x.IsOpen) of @inKind.Count done</span>
                        </td>
                    </tr>
                }
                var isOpen = t.Status != ActionItemStatus.Done && t.Status != ActionItemStatus.Cancelled;
                var threadOpen = _openThreads.Contains(t.Id);
                var comments = CommentsFor(t.Id);
                <tr class="im-enter @(t.IsOverdue(Clock.UtcNow) ? "im-row-danger" : "") @FlashClass?.Invoke(t.Id)" style="@FlashStyle?.Invoke(t.Id)" @key="t.Id" id="task-@t.Id">
                    @if (CanEdit)
                    {
                        <td>
                            @if (isOpen)
                            {
                                <input class="form-check-input" type="checkbox" checked="@_selected.Contains(t.Id)"
                                       aria-label="@($"Select task: {t.Title}")"
                                       @onchange="e => ToggleSelect(t.Id, (bool)(e.Value ?? false))" />
                            }
                        </td>
                    }
                    <td>
                        @t.Title
                        @AboutChip(t)
                        @if (!string.IsNullOrWhiteSpace(t.Description))
                        {
                            <div class="small text-muted" style="white-space:pre-wrap">@t.Description</div>
                        }
                        @if (t.Status == ActionItemStatus.Cancelled && comments.LastOrDefault(x => CaseService.IsCancelReason(x.Body)) is { } why)
                        {
                            @* HR-17: why it was dropped. FR-63: a reason kept as "Cancelled: " reads as the status does. *@
                            <div class="small text-muted">@CaseService.CancelReasonDisplay(why.Body) <span class="im-meta">@why.AuthorName · @TimeDisp.Short(why.CreatedAtUtc)</span></div>
                        }
                        @* HR-02: what a done task found or did, and who did it, without opening its comments. *@
                        @if (t.Status == ActionItemStatus.Done)
                        {
                            var doneMeta = (t.CompletedAtUtc is { } doneAt ? $"done {TimeDisp.Short(doneAt)}" : "done")
                                           + (t.CompletedBy is { } doneBy ? $" by {Users.DisplayFor(doneBy)}" : "");
                            @if (TaskResults.TryGetValue(t.Id, out var res))
                            {
                                <span class="im-task-result">@res.Text<span class="im-meta">@doneMeta</span></span>
                            }
                            else if (t.CompletedBy is not null)
                            {
                                <div class="small text-muted">@(char.ToUpperInvariant(doneMeta[0]) + doneMeta[1..])</div>
                            }
                        }
                    </td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(t.Owner) && !t.IsOpen)
                        {
                            <span class="text-muted">—</span>
                        }
                        else if (CanEdit && t.IsOpen && _ownerFor == t.Id)
                        {
                            @* FR-54: the owner picked in place, you first; an external name is still set in Edit. *@
                            <select @ref="_ownerPick" class="form-select form-select-sm im-owner-pick" aria-label="@($"Owner of {t.Title}")"
                                    @onchange="e => SetOwner(t, e.Value as string)" @onblur="() => _ownerFor = null">
                                <option value="@KeepOwner" selected>Choose…</option>
                                <option value="@CurrentUser.UserId">Me (@Users.DisplayFor(CurrentUser.UserId))</option>
                                <option value="">Unassigned</option>
                                @foreach (var u in Users.All().Where(u => !string.Equals(u.UserId, CurrentUser.UserId, StringComparison.OrdinalIgnoreCase)))
                                {
                                    <option value="@u.UserId">@u.DisplayName</option>
                                }
                            </select>
                        }
                        else if (CanEdit && t.IsOpen)
                        {
                            <button type="button" class="im-owner-btn" title="Change the owner" @onclick="() => (_ownerFor, _ownerFocus) = (t.Id, true)"
                                    aria-label="@($"Owner of {t.Title}: {(string.IsNullOrWhiteSpace(t.Owner) ? "unassigned" : Users.DisplayFor(t.Owner))}. Change")">
                                @if (string.IsNullOrWhiteSpace(t.Owner))
                                {
                                    <span class="im-badge im-b-warn">Unassigned</span>
                                }
                                else { @Users.DisplayFor(t.Owner) }
                            </button>
                            @if (string.IsNullOrWhiteSpace(t.Owner))
                            {
                                <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 ms-1 text-nowrap" @onclick="() => SetOwner(t, CurrentUser.UserId)"
                                        aria-label="@($"Take {t.Title}")">Take it</button>
                            }
                        }
                        else if (string.IsNullOrWhiteSpace(t.Owner))
                        {
                            <span class="im-badge im-b-warn" title="No owner assigned">Unassigned</span>
                        }
                        else { @Users.DisplayFor(t.Owner) }
                    </td>
                    <td class="im-task-due">
                        @* FR-59: the date on one line and the time (with its zone) under it, never broken up, however much
                           room a result or a long title takes from the column. *@
                        @if (t.DueAtUtc is { } due)
                        {
                            var (dueDay, dueTime) = SplitDue(TimeDisp.Due(due, OrgZone.Current));
                            <span class="im-task-due-day">@dueDay</span>
                            @if (dueTime is not null) { <span class="im-task-due-time">@dueTime</span> }
                        }
                        else { <text>—</text> }
                        @* RD-19: a notification task due after the running notification deadline (or undated) says so. *@
                        @if (LateForNotice(t) is { } notice)
                        {
                            <div class="im-task-notice">
                                <span class="bi bi-alarm" aria-hidden="true"></span>
                                @(t.DueAtUtc is null ? "Undated;" : "After") the @notice.JurisdictionCode deadline, @TimeDisp.Brief(notice.DueAtUtc!.Value, Clock.UtcNow)
                                @if (CanEdit)
                                {
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" disabled="@_inFlight" @onclick="() => DueByNotice(t)">Due by then</button>
                                }
                            </div>
                        }
                    </td>
                    <td>@StatusLabel(t.Status)</td>
                    <td class="text-end im-task-acts">
                        @if (CanEdit && isOpen)
                        {
                            <button class="btn btn-sm btn-outline-success me-1" title="Mark done"
                                    aria-label="@($"Mark done: {t.Title}")" @onclick="() => BeginComplete(t)">
                                <span class="bi bi-check2" aria-hidden="true"></span>
                            </button>
                        }
                        @if (CanEdit)
                        {
                            <button class="btn btn-sm btn-outline-secondary me-1" title="Edit this task"
                                    aria-label="@($"Edit task: {t.Title}")" @onclick="() => BeginEdit(t)">
                                <span class="bi bi-pencil" aria-hidden="true"></span>
                            </button>
                        }
                        @if (CanEdit && isOpen)
                        {
                            <button class="btn btn-sm btn-outline-secondary me-1" title="Cancel this task"
                                    aria-label="@($"Cancel task: {t.Title}")" @onclick="() => BeginCancel(t)">
                                <span class="bi bi-x-circle" aria-hidden="true"></span>
                            </button>
                        }
                        <button class="btn btn-sm @(threadOpen ? "btn-secondary" : "btn-outline-secondary")"
                                title="@(comments.Count == 0 ? "Add a comment" : $"{comments.Count} comment{(comments.Count == 1 ? "" : "s")}")"
                                aria-expanded="@Ui.Aria(threadOpen)" @onclick="() => ToggleThread(t.Id)">
                            <span class="bi bi-chat-left-text" aria-hidden="true"></span>
                            @if (comments.Count > 0) { <span class="ms-1">@comments.Count</span> }
                        </button>
                    </td>
                </tr>
                @if (_cancelFor == t.Id)
                {
                    <tr class="im-task-edit" @key="@($"cancel-{t.Id}")">
                        <td colspan="@colCount" class="bg-body-tertiary">
                            <label class="form-label small mb-0" for="task-cancel-why">Why cancel "@t.Title"? <span class="text-muted">(optional; kept as a comment on the task)</span></label>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <input id="task-cancel-why" class="form-control form-control-sm" style="max-width:36rem" maxlength="2000"
                                       @bind="_cancelWhy" @bind:event="oninput" placeholder="e.g. Covered by the containment task" disabled="@_cancelling" />
                                <button class="btn btn-sm btn-danger" @onclick="() => ConfirmCancel(t)" disabled="@_cancelling">Cancel the task</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _cancelFor = null" disabled="@_cancelling">Keep it</button>
                            </div>
                        </td>
                    </tr>
                }
                @if (_done.IsOpenFor(t.Id))
                {
                    @* INV-08: complete the task and, optionally, put its result on the timeline — written once. *@
                    <tr class="im-task-edit im-own-keys" @key="@($"done-{t.Id}")" @onkeydown="e => CompleteKey(e, t)">
                        <td colspan="@colCount" class="bg-body-tertiary">
                            <div class="row g-2">
                                <div class="col-12">
                                    @if (t.FollowsUpQuestion)
                                    {
                                        @* HR-02: a question's task is done when the question has an answer. *@
                                        <label class="form-label small mb-0" for="task-done-result">What did you find? <span class="text-muted">(required: this task follows up a question in the brief, and the answer shows there)</span></label>
                                    }
                                    else
                                    {
                                        <label class="form-label small mb-0" for="task-done-result">What was the result? <span class="text-muted">(optional)</span></label>
                                    }
                                    <textarea id="task-done-result" class="form-control form-control-sm" rows="2" maxlength="7992"
                                              @bind="_doneResult" @bind:event="oninput"
                                              placeholder="e.g. all 12 domains added to the proxy block list (change CHG-20931); verified from the Finance VLAN"></textarea>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0" for="task-done-by">Done by</label>
                                    <select id="task-done-by" class="form-select form-select-sm" @bind="_doneBy">
                                        @foreach (var u in Users.All())
                                        {
                                            <option value="@u.UserId">@u.DisplayName</option>
                                        }
                                        <option value="@ExternalOwnerSentinel">External / other…</option>
                                    </select>
                                    @if (_doneBy == ExternalOwnerSentinel)
                                    {
                                        <input class="form-control form-control-sm mt-1" aria-label="Done by (name)" @bind="_doneByExternal" @bind:event="oninput" placeholder="Name" />
                                    }
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0" for="task-done-when">Completed at (@TimeDisp.Label)</label>
                                    <DateTimeInput Past="true" id="task-done-when" class="form-control form-control-sm" @bind-Value="_doneWhen" />
                                    @* BUG-480 sibling: Shifted stops at year 1 and 9999 instead of throwing. *@
                                    <div class="tl-nudges" role="group" aria-label="Adjust the time">
                                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _doneWhen = WallClock.ToWall(Clock.UtcNow, TimeDisp.Zone)">Now</button>
                                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _doneWhen = TimeNudges.Shifted(_doneWhen, TimeSpan.FromHours(-1))" aria-label="One hour earlier">&minus;1 h</button>
                                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _doneWhen = TimeNudges.Shifted(_doneWhen, TimeSpan.FromMinutes(-15))" aria-label="15 minutes earlier">&minus;15 min</button>
                                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _doneWhen = TimeNudges.Shifted(_doneWhen, TimeSpan.FromMinutes(15))" aria-label="15 minutes later">+15 min</button>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0 text-nowrap" for="task-done-log" title="Add the result to the timeline as">Add to the timeline as</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">
                                            <input class="form-check-input mt-0" type="checkbox" id="task-done-log" @bind="_doneLog" />
                                        </span>
                                        <select class="form-select form-select-sm" aria-label="Timeline entry type" @bind="_doneType" disabled="@(!_doneLog)">
                                        @foreach (var type in LoggableTypes)
                                        {
                                            <option value="@type">@Ui.Label(type)</option>
                                        }
                                        </select>
                                    </div>
                                    @if (_doneLog && string.IsNullOrWhiteSpace(_doneResult))
                                    {
                                        <div class="form-text mt-0">Only a result goes on the timeline: write one, or nothing is added.</div>
                                    }
                                </div>
                                @* RD-10: what the work established can go straight into the brief's Known. *@
                                <div class="col-12">
                                    <div class="form-check small mb-1">
                                        <input class="form-check-input" type="checkbox" id="task-done-known" checked="@_doneKnown"
                                               @onchange="e => { _doneKnown = e.Value is true; if (_doneKnown && string.IsNullOrWhiteSpace(_doneKnownLine)) _doneKnownLine = FirstLine(_doneResult); }" />
