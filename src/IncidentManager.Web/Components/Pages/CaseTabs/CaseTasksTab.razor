                                                <PromoteToTimeline CaseId="CaseId" SourceRef="@($"taskcomment:{c.Id}")" Text="@c.Body" WrittenAtUtc="c.CreatedAtUtc"
                                                                   OnDone="CommentPromoted" OnCancel="() => _promotingComment = null" />
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                            @* REV-29 / S-16: discussion is open to everyone who can see the case, view-only roles included. *@
                            <AuthorizeView Policy="@Policies.ViewCases">
                                @* BUG-425: Ctrl/Cmd+Enter in the comment box posts the comment, not the composer's task. *@
                                <div class="d-flex align-items-start gap-2 im-own-keys" @onkeydown="e => CommentKey(e, t.Id)">
                                    <textarea class="form-control form-control-sm" rows="2" placeholder="Add a comment…"
                                              aria-label="@($"Comment on task: {t.Title}")"
                                              value="@CommentDraft(t.Id)"
