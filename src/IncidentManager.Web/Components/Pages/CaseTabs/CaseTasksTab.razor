@* Case workspace — Tasks tab (UX-13, the final tab). After-action items: add a follow-up (owner +
   due date in the viewer's zone), the apply-playbook flow (E-06), and the item list with mark-done.
   Self-contained — it loads its own playbook templates and builds due-dates itself; the parent threads
   the live-collab flash (delegates), a Reload after a write (OnChanged), and Ctrl+Enter (SubmitAsync via @ref). *@
@inject CaseService Cases
@inject IncidentManager.Application.Cases.ActionItemCommentService Comments
@inject IncidentManager.Application.Admin.CaseTemplateService Templates
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IClock Clock
@inject TimeDisplay TimeDisp
@inject ToastService Toasts

<AuthorizeView Policy="@Policies.EditCases">
    @if (_applyTemplates is { Count: > 0 })
    {
        <div class="d-flex justify-content-end mb-2">
            @if (!_applyingTemplate)
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="BeginApplyTemplate">
                    <span class="bi bi-clipboard-check me-1"></span>Apply playbook
                </button>
            }
        </div>
        @if (_applyingTemplate)
        {
            <div class="card mb-3 border-primary">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><span class="bi bi-clipboard-check me-1"></span>Apply a playbook</span>
                    <button class="btn-close" aria-label="Cancel" @onclick="CancelApplyTemplate"></button>
                </div>
                <div class="card-body">
                    <label class="form-label small mb-0" for="task-playbook">Playbook</label>
                    <select id="task-playbook" class="form-select form-select-sm mb-3" style="max-width:28rem" @onchange="OnApplyTemplateChanged"
                            value="@(_applyTemplate?.Id.ToString() ?? "")">
                        <option value="">Choose a playbook</option>
                        @foreach (var t in _applyTemplates)
                        {
                            <option value="@t.Id">@t.Name@(t.Steps.Count > 0 ? $" ({t.Steps.Count} steps)" : "")</option>
                        }
                    </select>

                    @if (_applyTemplate is not null)
                    {
                        @if (_applyTemplate.Steps.Count == 0)
                        {
                            <p class="text-muted small">This playbook has no steps to add.</p>
                        }
                        else
                        {
                            <p class="small text-muted mb-2">Uncheck steps you don't need. Each task goes to the step's owner, or to the case owner if the step has none. Due dates count from now.</p>
                            <div class="border rounded p-2 mb-2">
                                @foreach (var s in _applyTemplate.Steps)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="apply-step-@s.Id"
                                               checked="@_applySelected.Contains(s.Id)"
                                               @onchange="e => ToggleApplyStep(s.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label" for="apply-step-@s.Id">
                                            @s.Title
                                            @if (s.DueOffsetHours is { } h) { <span class="im-badge im-b-warn ms-1">+@FormatOffset(h)</span> }
                                            @if (!string.IsNullOrWhiteSpace(s.OwnerHint)) { <span class="im-badge im-b-neutral ms-1">@s.OwnerHint</span> }
                                        </label>
                                    </div>
                                }
                            </div>

                            @* U-45: no case owner yet — hint-less steps would land Unassigned. Offer a default owner. *@
                            @if (string.IsNullOrWhiteSpace(Case.IncidentCommander))
                            {
                                <div class="alert alert-warning py-2 px-2 small mb-0">
                                    <span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>
                                    This case has no incident commander yet, so steps without an owner will be added as
                                    <strong>Unassigned</strong>. Choose a default owner for them, or leave them unassigned.
                                    <div class="mt-2" style="max-width:20rem">
                                        <select class="form-select form-select-sm" aria-label="Default owner" @bind="_applyDefaultOwner">
                                            <option value="">Leave unassigned</option>
                                            @foreach (var u in Users.All())
                                            {
                                                <option value="@u.UserId">@u.DisplayName</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>
                <div class="card-footer d-flex gap-2">
                    <button class="btn btn-sm btn-primary" @onclick="ApplyTemplate"
                            disabled="@(_applyTemplate is null || _applySelected.Count == 0)">
                        Add @_applySelected.Count task@(_applySelected.Count == 1 ? "" : "s")
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelApplyTemplate">Cancel</button>
                </div>
            </div>
        }
    }
    @* Phones: the add-task form folds behind a button so the task list starts near the top. *@
    <button type="button" class="btn btn-sm btn-outline-primary mb-3 d-sm-none" aria-expanded="@_addOpen"
            aria-controls="task-add-form" @onclick="() => _addOpen = !_addOpen">
        <span class="bi @(_addOpen ? "bi-chevron-up" : "bi-plus-lg") me-1" aria-hidden="true"></span>@(_addOpen ? "Hide form" : "Add task")
    </button>
    <div id="task-add-form" class="card mb-3 @(_addOpen ? "" : "im-phone-collapsed")">
        <div class="card-body row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small mb-0" for="task-title">Task</label>
                <input id="task-title" class="form-control form-control-sm" @bind="_taskTitle" @bind:event="oninput" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0" for="task-owner">Owner</label>
                <select id="task-owner" class="form-select form-select-sm" @bind="_taskOwner">
                    <option value="">Unassigned</option>
                    @foreach (var u in Users.All())
                    {
                        <option value="@u.UserId">@u.DisplayName</option>
                    }
                    <option value="@ExternalOwnerSentinel">External / other…</option>
                </select>
                @if (_taskOwner == ExternalOwnerSentinel)
                {
                    @* U-45: an external owner (e.g. a vendor contact) not in the directory. *@
                    <input class="form-control form-control-sm mt-1" aria-label="External owner name" @bind="_taskOwnerExternal" @bind:event="oninput"
                           placeholder="External owner name" />
                }
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0" for="task-due-date">Due date</label>
                <input id="task-due-date" type="date" class="form-control form-control-sm" @bind="_taskDueDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0" for="task-due-time">Time (@TimeDisp.Label)</label>
                <input id="task-due-time" type="time" class="form-control form-control-sm" @bind="_taskDueTime"
                       title="Leave blank for end of day." />
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-primary w-100" title="Ctrl / ⌘ + Enter" @onclick="AddTask" disabled="@string.IsNullOrWhiteSpace(_taskTitle)">Add task</button>
            </div>
        </div>
    </div>
</AuthorizeView>

@if (Case.ActionItems.Count == 0)
{
    <p class="text-muted">No tasks yet.@(CanEdit ? " Add the first one above." : "")</p>
}
else
{
    @* PROD-21: multi-select complete — tick several open tasks and close them in one action. *@
    @if (CanEdit && _selected.Count > 0)
    {
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="small text-muted">@_selected.Count selected</span>
            <button class="btn btn-sm btn-success" @onclick="MarkSelectedDone">
                <span class="bi bi-check2-all me-1" aria-hidden="true"></span>Mark @_selected.Count done
            </button>
            <button class="btn btn-sm btn-link p-0" @onclick="() => _selected.Clear()">Clear selection</button>
        </div>
    }
    var colCount = CanEdit ? 6 : 5;
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                @if (CanEdit)
                {
                    <th style="width:1%">
                        <input class="form-check-input" type="checkbox" title="Select all open tasks"
                               aria-label="Select all open tasks"
                               checked="@(OpenTaskIds.Count > 0 && _selected.Count == OpenTaskIds.Count)"
                               @onchange="e => ToggleSelectAll(OpenTaskIds, (bool)(e.Value ?? false))" />
                    </th>
                }
                <th>Task</th><th>Owner</th><th>Due</th><th>Status</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Case.ActionItems.OrderBy(x => x.Status).ThenBy(x => x.DueAtUtc))
            {
                var isOpen = t.Status != ActionItemStatus.Done && t.Status != ActionItemStatus.Cancelled;
                var threadOpen = _openThreads.Contains(t.Id);
                var comments = CommentsFor(t.Id);
                <tr class="im-enter @(t.IsOverdue(Clock.UtcNow) ? "table-danger" : "") @FlashClass?.Invoke(t.Id)" style="@FlashStyle?.Invoke(t.Id)" @key="t.Id">
                    @if (CanEdit)
                    {
                        <td>
                            @if (isOpen)
                            {
                                <input class="form-check-input" type="checkbox" checked="@_selected.Contains(t.Id)"
                                       aria-label="@($"Select task: {t.Title}")"
                                       @onchange="e => ToggleSelect(t.Id, (bool)(e.Value ?? false))" />
                            }
                        </td>
                    }
                    <td>
                        @t.Title
                        @if (!string.IsNullOrWhiteSpace(t.Description))
                        {
                            <div class="small text-muted" style="white-space:pre-wrap">@t.Description</div>
                        }
                    </td>
                    <td>
                        @if (string.IsNullOrWhiteSpace(t.Owner))
                        {
                            <span class="im-badge im-b-warn" title="No owner assigned">Unassigned</span>
                        }
                        else { @Users.DisplayFor(t.Owner) }
                    </td>
                    <td>@(t.DueAtUtc is { } due ? TimeDisp.Short(due) : "—")</td>
                    <td>@StatusLabel(t.Status)</td>
                    <td class="text-end text-nowrap">
                        @if (CanEdit)
                        {
                            <button class="btn btn-sm btn-outline-secondary me-1" title="Edit this task"
                                    aria-label="@($"Edit task: {t.Title}")" @onclick="() => BeginEdit(t)">
                                <span class="bi bi-pencil" aria-hidden="true"></span>
                            </button>
                        }
                        <button class="btn btn-sm @(threadOpen ? "btn-secondary" : "btn-outline-secondary")"
                                title="@(comments.Count == 0 ? "Add a comment" : $"{comments.Count} comment{(comments.Count == 1 ? "" : "s")}")"
                                aria-expanded="@threadOpen" @onclick="() => ToggleThread(t.Id)">
                            <span class="bi bi-chat-left-text" aria-hidden="true"></span>
                            @if (comments.Count > 0) { <span class="ms-1">@comments.Count</span> }
                        </button>
                    </td>
                </tr>
                @if (_editingTaskId == t.Id)
                {
                    <tr class="im-task-edit" @key="@($"edit-{t.Id}")">
                        <td colspan="@colCount" class="bg-body-tertiary">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-4">
                                    <label class="form-label small mb-0" for="task-edit-title">Task</label>
                                    <input id="task-edit-title" class="form-control form-control-sm" @bind="_editTitle" @bind:event="oninput" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small mb-0" for="task-edit-owner">Owner</label>
                                    <select id="task-edit-owner" class="form-select form-select-sm" @bind="_editOwner">
                                        <option value="">Unassigned</option>
                                        @foreach (var u in Users.All())
                                        {
                                            <option value="@u.UserId">@u.DisplayName</option>
                                        }
                                        <option value="@ExternalOwnerSentinel">External / other…</option>
                                    </select>
                                    @if (_editOwner == ExternalOwnerSentinel)
                                    {
                                        <input class="form-control form-control-sm mt-1" aria-label="External owner name" @bind="_editOwnerExternal" @bind:event="oninput"
                                               placeholder="External owner name" />
                                    }
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0" for="task-edit-status">Status</label>
                                    <select id="task-edit-status" class="form-select form-select-sm" @bind="_editStatus">
                                        @foreach (var s in Enum.GetValues<ActionItemStatus>())
                                        {
                                            <option value="@s">@StatusLabel(s)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small mb-0" for="task-edit-due-date">Due date</label>
                                    <input id="task-edit-due-date" type="date" class="form-control form-control-sm" @bind="_editDueDate" />
                                </div>
                                <div class="col-md-1">
                                    <label class="form-label small mb-0" for="task-edit-due-time">Time</label>
                                    <input id="task-edit-due-time" type="time" class="form-control form-control-sm" @bind="_editDueTime"
                                           title="In @TimeDisp.Label. Leave blank for end of day." />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-0" for="task-edit-desc">Description <span class="text-muted">(optional)</span></label>
                                    <textarea id="task-edit-desc" class="form-control form-control-sm" rows="2" @bind="_editDescription" @bind:event="oninput"></textarea>
                                </div>
                                <div class="col-12 d-flex gap-2">
                                    <button class="btn btn-sm btn-primary" @onclick="SaveEdit"
                                            disabled="@string.IsNullOrWhiteSpace(_editTitle)">Save changes</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (threadOpen)
                {
                    <tr class="im-task-thread" @key="@($"thread-{t.Id}")">
                        <td colspan="@colCount" class="bg-body-tertiary">
                            @if (comments.Count == 0)
                            {
                                <p class="text-muted small mb-2">No comments yet. Add the first progress note or hand-off context.</p>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-2">
                                    @foreach (var c in comments)
                                    {
                                        <li class="mb-2">
                                            <div class="small text-muted">
                                                <span class="fw-semibold text-body">@c.AuthorName</span>
                                                · <span title="@TimeDisp.Long(c.CreatedAtUtc)">@TimeDisp.Short(c.CreatedAtUtc)</span>
                                            </div>
                                            <div style="white-space:pre-wrap">@c.Body</div>
                                        </li>
                                    }
                                </ul>
                            }
                            <AuthorizeView Policy="@Policies.EditCases">
                                <div class="d-flex align-items-start gap-2">
                                    <textarea class="form-control form-control-sm" rows="2" placeholder="Add a comment…"
                                              aria-label="@($"Comment on task: {t.Title}")"
                                              value="@CommentDraft(t.Id)"
                                              @oninput="e => SetCommentDraft(t.Id, e.Value?.ToString())"></textarea>
                                    <button class="btn btn-sm btn-primary text-nowrap"
                                            disabled="@string.IsNullOrWhiteSpace(CommentDraft(t.Id))"
                                            @onclick="() => AddComment(t.Id)">Comment</button>
                                </div>
                            </AuthorizeView>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

@code {
    private bool _addOpen;
    [Parameter, EditorRequired] public Case Case { get; set; } = null!;
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    /// <summary>Reload the case after a task/playbook write so the list (and the rest of the workspace) refreshes.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Live-collab flash hooks (parent owns the flash state).</summary>
    [Parameter] public Func<Guid, string?>? FlashClass { get; set; }
    [Parameter] public Func<Guid, string?>? FlashStyle { get; set; }
    /// <summary>Bumped by the parent on a live-collab change so task comments re-load when a collaborator posts one.</summary>
    [Parameter] public int RefreshToken { get; set; }

    // Add-a-task form
    private string _taskTitle = "";
    private string? _taskOwner;
    private string? _taskOwnerExternal;              // U-45: free-text owner when "External / other…" is picked
    private const string ExternalOwnerSentinel = "__external__";
    private DateTime? _taskDueDate;
    private TimeOnly? _taskDueTime;

    // Apply playbook (E-06)
    private List<IncidentManager.Application.Admin.TemplateView>? _applyTemplates;
    private bool _applyingTemplate;
    private IncidentManager.Application.Admin.TemplateView? _applyTemplate;
    private readonly HashSet<Guid> _applySelected = [];
    private string? _applyDefaultOwner; // U-45: default owner for hint-less steps when the case has no IC yet

    // Append-only task commentary: all comments on this case's tasks, grouped by task id. Loaded on first
    // parameters-set and re-loaded whenever RefreshToken changes (a live-collab edit) or after a post.
    private readonly HashSet<Guid> _openThreads = new();
    private readonly Dictionary<Guid, string> _commentDrafts = new();
    private ILookup<Guid, ActionItemCommentView> _commentsByTask =
        Array.Empty<ActionItemCommentView>().ToLookup(c => c.ActionItemId);
    private int _seenRefresh = -1;

    protected override async Task OnInitializedAsync()
        => _applyTemplates ??= await Templates.ListActiveAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (RefreshToken != _seenRefresh)
        {
            _seenRefresh = RefreshToken;
            await ReloadComments();
        }
    }

    private async Task ReloadComments()
    {
        var all = await Comments.ListForCaseAsync(CaseId);
        _commentsByTask = all.ToLookup(c => c.ActionItemId);
    }

    private IReadOnlyList<ActionItemCommentView> CommentsFor(Guid taskId) => _commentsByTask[taskId].ToList();

    private void ToggleThread(Guid taskId)
    {
        if (!_openThreads.Remove(taskId)) _openThreads.Add(taskId);
    }

    private string CommentDraft(Guid taskId) => _commentDrafts.GetValueOrDefault(taskId, "");
    private void SetCommentDraft(Guid taskId, string? text) => _commentDrafts[taskId] = text ?? "";

    private async Task AddComment(Guid taskId)
    {
        var body = CommentDraft(taskId);
        if (string.IsNullOrWhiteSpace(body)) return;
        try
        {
            await Comments.AddAsync(CaseId, taskId, body);
            _commentDrafts[taskId] = "";
            await ReloadComments();
            _openThreads.Add(taskId);
            Toasts.Success("Comment added");
            await OnChanged.InvokeAsync(); // refresh the rest of the workspace (audit trail, live-collab)
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
    }

    private static string StatusLabel(ActionItemStatus s) => s switch
    {
        ActionItemStatus.InProgress => "In progress",
        ActionItemStatus.Cancelled => "Canceled",
        _ => s.ToString()
    };

    // --- Edit a task (all fields, behind the Edit button) — consistent with how IOCs/entities are edited;
    // each save is one audited change (before → after) rather than a separate version chain. ---
    private Guid? _editingTaskId;
    private string _editTitle = "";
    private string? _editOwner;
    private string? _editOwnerExternal;
    private ActionItemStatus _editStatus;
    private DateTime? _editDueDate;
    private TimeOnly? _editDueTime;
    private string? _editDescription;

    private void BeginEdit(ActionItem t)
    {
        _editingTaskId = t.Id;
        _editTitle = t.Title;
        _editStatus = t.Status;
        _editDescription = t.Description;
        // Seed the owner picker: a directory user shows as itself, a free-text/external owner via the sentinel.
        if (string.IsNullOrWhiteSpace(t.Owner)) { _editOwner = ""; _editOwnerExternal = null; }
        else if (Users.All().Any(u => string.Equals(u.UserId, t.Owner, StringComparison.OrdinalIgnoreCase)))
        { _editOwner = t.Owner; _editOwnerExternal = null; }
        else { _editOwner = ExternalOwnerSentinel; _editOwnerExternal = t.Owner; }
        // Seed the due date/time in the viewer's active display zone (what they see is what they picked).
        if (t.DueAtUtc is { } due)
        {
            var wall = TimeZoneInfo.ConvertTime(due, TimeDisp.Zone);
            _editDueDate = wall.Date;
            _editDueTime = TimeOnly.FromTimeSpan(wall.TimeOfDay);
        }
        else { _editDueDate = null; _editDueTime = null; }
    }

    private void CancelEdit() => _editingTaskId = null;

    private async Task SaveEdit()
    {
        if (_editingTaskId is not { } id || string.IsNullOrWhiteSpace(_editTitle)) return;
        var owner = _editOwner switch
        {
            ExternalOwnerSentinel => string.IsNullOrWhiteSpace(_editOwnerExternal) ? null : _editOwnerExternal.Trim(),
            null or "" => null,
            var u => u
        };
        try
        {
            await Cases.UpdateActionItemAsync(CaseId, id, _editTitle, owner,
                ToDueUtc(_editDueDate, _editDueTime), _editStatus, _editDescription);
            _editingTaskId = null;
            await OnChanged.InvokeAsync();
            Toasts.Success("Task updated");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
    }

    /// <summary>Ctrl/⌘+Enter from the parent's hotkey dispatcher — add the follow-up in the composer.</summary>
    public async Task SubmitAsync()
    {
        if (CanEdit) await AddTask();
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(_taskTitle)) return;
        // The picker stores a directory user id, "" for unassigned, or the external sentinel (U-45) →
        // then the owner is the free-text name. Blank normalises to null (Unassigned).
        var owner = _taskOwner switch
        {
            ExternalOwnerSentinel => string.IsNullOrWhiteSpace(_taskOwnerExternal) ? null : _taskOwnerExternal.Trim(),
            null or "" => null,
            var u => u
        };
        // A failed save keeps what was typed so the analyst can fix it and retry.
        try { await Cases.AddActionItemAsync(CaseId, _taskTitle, owner, ResolveDueUtc()); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IncidentManager.Application.Security.ForbiddenException) { Toasts.Error($"Couldn't add the task. {ex.Message}"); return; }
        _taskTitle = ""; _taskOwner = null; _taskOwnerExternal = null; _taskDueDate = null; _taskDueTime = null;
        await OnChanged.InvokeAsync();
        Toasts.Success("Task added");
    }

    // A due deadline is entered in the viewer's active display zone (U-29) — so "what you pick is what you
    // see" round-trips through the UTC/Local toggle without shifting a day. Time is optional: a bare date
    // means "by end of that day" (23:59 local). Stored as a UTC instant like every other timestamp (F-20).
    private DateTimeOffset? ResolveDueUtc() => ToDueUtc(_taskDueDate, _taskDueTime);

    // Shared by the add and edit forms: convert a picked wall date/time (viewer zone) to a stored UTC instant.
    private DateTimeOffset? ToDueUtc(DateTime? date, TimeOnly? time)
    {
        if (date is not { } d) return null;
        var wall = DateTime.SpecifyKind(d.Date + (time ?? new TimeOnly(23, 59)).ToTimeSpan(), DateTimeKind.Unspecified);
        try { return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(wall, TimeDisp.Zone), TimeSpan.Zero); }
        catch { return new DateTimeOffset(DateTime.SpecifyKind(wall, DateTimeKind.Utc), TimeSpan.Zero); } // DST-invalid wall time: treat as UTC
    }

    // PROD-21: multi-select complete.
    private readonly HashSet<Guid> _selected = new();

    private List<Guid> OpenTaskIds => Case.ActionItems
        .Where(x => x.Status != ActionItemStatus.Done && x.Status != ActionItemStatus.Cancelled)
        .Select(x => x.Id).ToList();

    private void ToggleSelect(Guid id, bool on) { if (on) _selected.Add(id); else _selected.Remove(id); }

    private void ToggleSelectAll(IEnumerable<Guid> openIds, bool on)
    {
        _selected.Clear();
        if (on) foreach (var id in openIds) _selected.Add(id);
    }

    private async Task MarkSelectedDone()
    {
        if (_selected.Count == 0) return;
        var done = 0;
        foreach (var id in _selected.ToList())
        {
            try { await Cases.SetActionItemStatusAsync(CaseId, id, ActionItemStatus.Done); done++; }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); }
        }
        _selected.Clear();
        if (done > 0)
        {
            Toasts.Success($"Marked {done} task{(done == 1 ? "" : "s")} done");
            await OnChanged.InvokeAsync();
        }
    }

    // --- Apply playbook (E-06) ---
    private void BeginApplyTemplate()
    {
        _applyingTemplate = true;
        _applyTemplate = null;
        _applySelected.Clear();
        _applyDefaultOwner = null;
    }

    private void CancelApplyTemplate()
    {
        _applyingTemplate = false;
        _applyTemplate = null;
        _applySelected.Clear();
        _applyDefaultOwner = null;
    }

    private void OnApplyTemplateChanged(ChangeEventArgs e)
    {
        _applyTemplate = Guid.TryParse(e.Value?.ToString(), out var id)
            ? _applyTemplates?.FirstOrDefault(t => t.Id == id) : null;
        _applySelected.Clear();
        if (_applyTemplate is not null)
            foreach (var s in _applyTemplate.Steps) _applySelected.Add(s.Id); // all checked by default
    }

    private void ToggleApplyStep(Guid stepId, bool on)
    {
        if (on) _applySelected.Add(stepId); else _applySelected.Remove(stepId);
    }

    private async Task ApplyTemplate()
    {
        if (_applyTemplate is null || _applySelected.Count == 0) return;
        try
        {
            var n = await Cases.ApplyTemplateAsync(CaseId, _applyTemplate.Id, _applySelected.ToList(), _applyDefaultOwner);
            Toasts.Success($"Added {n} task{(n == 1 ? "" : "s")} from '{_applyTemplate.Name}'");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
            return;
        }
        CancelApplyTemplate();
        await OnChanged.InvokeAsync();
    }

    private static string FormatOffset(int hours) =>
        hours % 24 == 0 ? $"{hours / 24}d" : $"{hours}h";
}
