                                    <div class="col-12">
                                        <label class="form-label small mb-0" for="task-edit-cancel">Why cancel it? <span class="text-muted">(optional; kept as a comment on the task)</span></label>
                                        <input id="task-edit-cancel" class="form-control form-control-sm" maxlength="2000" @bind="_editCancelReason" @bind:event="oninput"
                                               placeholder="e.g. covered by the tenant-wide session revoke" />
                                    </div>
                                }
                                <div class="col-12">
                                    <label class="form-label small mb-0" for="task-edit-desc">Description <span class="text-muted">(optional)</span></label>
                                    <textarea id="task-edit-desc" class="form-control form-control-sm" rows="2" maxlength="@ActionItem.MaxDescriptionLength" @bind="_editDescription" @bind:event="oninput"></textarea>
                                </div>
                                <div class="col-12 d-flex gap-2">
                                    <button class="btn btn-sm btn-primary" @onclick="SaveEdit"
                                            disabled="@string.IsNullOrWhiteSpace(_editTitle)">Save changes</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                                    @if (t.Status is not (ActionItemStatus.Done or ActionItemStatus.Cancelled))
                                    {
                                        @* Work that turned out to be a program change, not this case's follow-up. *@
                                        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => MoveToLessons(t)" disabled="@_moving"
                                                title="Make it an improvement action in this case's lessons learned (title, description, owner and due date go with it), and cancel the task with a note saying so">
                                            <span class="bi bi-lightbulb" aria-hidden="true"></span> Move to lessons learned
                                        </button>
                                    }
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (threadOpen)
                {
                    <tr class="im-task-thread" @key="@($"thread-{t.Id}")">
                        <td colspan="@colCount" class="bg-body-tertiary">
                            @if (comments.Count == 0)
                            {
                                <p class="text-muted small mb-2">No comments yet. Add the first progress note or hand-off context.</p>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-2">
                                    @foreach (var c in comments)
                                    {
                                        <li class="mb-2">
                                            <div class="small text-muted">
                                                <span class="fw-semibold text-body">@c.AuthorName</span>
                                                · <span title="@TimeDisp.Long(c.CreatedAtUtc)">@TimeDisp.Short(c.CreatedAtUtc)</span>
                                            </div>
                                            <div style="white-space:pre-wrap">@c.Body</div>
                                            @if (Promoted.Contains($"taskcomment:{c.Id}"))
                                            {
                                                <span class="im-badge im-b-info"><span class="bi bi-clock-history" aria-hidden="true"></span> On the timeline</span>
                                            }
                                            else if (CanEdit)
                                            {
                                                <button class="btn btn-sm btn-link p-0" @onclick="() => _promotingComment = c.Id">Add to timeline</button>
                                            }
                                            @if (_promotingComment == c.Id)
