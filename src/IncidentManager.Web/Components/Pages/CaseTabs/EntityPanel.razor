@* INV-11: an entity (indicator, account, host…) in context, in a side panel over whatever tab is open — what it
   is, where this case refers to it, how it relates to other entities, and which other cases it appears on — so
   checking an entity doesn't mean leaving the work. Opened from a "[[" tag, a timeline actor/target, or an entity
   row. Read-only; changes are made where they always are (the IOCs & entities tab).
   INV-28: lists the tasks about the entity, and a task can be started from here.
   RD-05 (Casefile dossier): the verdict is set here, as a segmented control with its reason inline; "Seen before" is
   one block (open cases, then closed ones with how they ended), each with the verdict reached there; the value can be
   copied defanged; deep-linked as ?entity=<id>. *@
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject CaseService Cases
@inject ActionItemCommentService TaskComments
@inject IncidentManager.Application.Admin.CaseOutcomeService Outcomes
@inject ToastService Toasts
@inject IncidentManager.Application.Content.IMarkdownService Md
@inject TimeDisplay TimeDisp
@inject IJSRuntime JS
@inject IConfiguration Config
@inject UnsavedEdits Edits
@implements IDisposable

@if (Entity is { } en)
{
    <div class="im-panel-scrim" @onclick="OnClose"></div>
    <aside class="im-entity-panel im-trap" role="dialog" aria-modal="true" aria-labelledby="entity-panel-title" tabindex="-1"
           @onkeydown="OnKey">
        <div class="im-entity-panel-head">
            <div class="d-flex align-items-center gap-2">
                <span class="im-dossier-glyph" aria-hidden="true">@Ui.EntityGlyph(en.Type)</span>
                <h2 class="im-dossier-value mb-0" id="entity-panel-title"><span class="im-data">@en.Value</span></h2>
                <button type="button" class="btn btn-sm btn-link p-0 im-dossier-copy" title="Copy the defanged value (safe to paste into email or chat)"
                        aria-label="Copy the defanged value" @onclick="() => CopyDefanged(en)">
                    <span class="bi @(_copied ? "bi-check2" : "bi-copy")" aria-hidden="true"></span>
                </button>
                @if (CanEdit)
                {
                    @* INV-32: key to the case whatever its disposition. *@
                    <button type="button" class="btn btn-sm btn-link p-0 ms-auto im-dossier-copy" aria-pressed="@Ui.Aria(en.IsPinned)"
                            title="@(en.IsPinned ? "Unpin: remove it from Key entities" : "Pin: show it first in Key entities")" @onclick="() => TogglePin(en)">
                        <span class="bi @(en.IsPinned ? "bi-pin-fill" : "bi-pin")" aria-hidden="true"></span><span class="visually-hidden">@(en.IsPinned ? "Unpin" : "Pin")</span>
                    </button>
                }
                <button type="button" class="btn-close @(CanEdit ? "" : "ms-auto")" aria-label="Close" @onclick="OnClose"></button>
            </div>
            @if (!string.IsNullOrWhiteSpace(en.Label)) { <div class="im-dossier-label">@en.Label</div> }
            <div class="small text-muted">
                @Ui.Label(en.Type)@(string.IsNullOrWhiteSpace(en.Source) ? "" : $" · from {en.Source}") · added @TimeDisp.Brief(en.CreatedAtUtc, Clock.UtcNow)@(en.Tlp is { } tlp ? $" · TLP:{tlp.ToString().ToUpperInvariant().Replace("AMBERSTRICT", "AMBER+STRICT")}" : "")
                @if (Defanged(en) is { } df && df != en.Value) { <text> · shared as </text><span class="im-data">@df</span> }
            </div>
            @if (!string.IsNullOrWhiteSpace(en.Description)) { <div class="small mt-1">@en.Description</div> }

            @* RD-05: the verdict on this case, set here. Changing it asks why (required for Malicious or Compromised);
               the change is a verdict milestone on the timeline. *@
            <div class="im-dossier-verdict mt-2">
                <div class="small text-muted mb-1">Verdict on this case</div>
                @if (CanEdit)
                {
                    <div class="im-verdict-seg" role="radiogroup" aria-label="Verdict on this case">
                        @foreach (var d in VerdictOrder)
                        {
                            var on = (_pendingVerdict ?? en.Disposition) == d;
                            <button type="button" role="radio" aria-checked="@Ui.Aria(on)" class="@(on ? "on" : "")" @onclick="() => PickVerdict(en, d)">
                                <VerdictMark Value="d" />
                            </button>
                        }
                    </div>
                    @if (_pendingVerdict is { } pv && pv != en.Disposition)
                    {
                        // BUG-414: a verdict dated more than an hour back needs a reason too.
                        var required = pv is EntityDisposition.Malicious or EntityDisposition.Compromised
                            || DeterminedAt.UtcOf(_verdictWhen, TimeDisp.Zone, Clock.UtcNow) is { } dAt && CaseService.IsBackdated(dAt, Clock.UtcNow);
                        <div class="im-dossier-reason mt-2">
                            <label class="form-label small mb-1" for="dossier-reason">Why @Ui.Label(pv).ToLowerInvariant()? <span class="text-muted">@(required ? "(required)" : "(optional)")</span></label>
                            <textarea id="dossier-reason" class="form-control form-control-sm im-rec" rows="2" maxlength="2000"
                                      @bind="_verdictReason" @bind:event="oninput" disabled="@_savingVerdict"
                                      placeholder="@(required ? "What shows it, in a line. The reason is kept with the verdict." : "What you checked, in a line.")"></textarea>
                            <div class="mt-2"><DeterminedAt Id="dossier-determined" @bind-Value="_verdictWhen" /></div>
                            @if (_verdictError is not null) { <div class="text-danger small mt-1" role="alert">@_verdictError</div> }
                            <div class="d-flex gap-2 justify-content-end align-items-center mt-2">
                                <span class="small text-muted me-auto">Shown on the timeline.</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => { _pendingVerdict = null; _verdictFrom = null; _verdictError = null; _verdictWhen = null; }">Cancel</button>
                                <button type="button" class="btn btn-sm btn-primary text-nowrap" disabled="@(_savingVerdict || (required && string.IsNullOrWhiteSpace(_verdictReason)))"
                                        @onclick="() => SaveVerdict(en)">Save verdict</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <VerdictMark Value="en.Disposition" />
                }
            </div>

            <div class="d-flex flex-wrap gap-2 mt-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => OnShowOnTimeline.InvokeAsync(en.Id)">
                    <span class="bi bi-clock-history" aria-hidden="true"></span> Show on the timeline
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='() => OnGoToTab.InvokeAsync("Entities")'>
                    <span class="bi bi-pencil" aria-hidden="true"></span> Edit details
                </button>
                @if (VirusTotalUrl(en) is { } vt)
                {
                    <a class="btn btn-sm btn-outline-secondary" href="@vt" target="_blank" rel="noopener noreferrer">VirusTotal <span class="bi bi-box-arrow-up-right" aria-hidden="true"></span></a>
                }
            </div>
            @if (en.Disposition == EntityDisposition.Unknown && EntityMentions.Count(Case, en.Id) is var refs && refs >= EntityMentions.ReviewThreshold)
            {
                <div class="im-review-hint small mt-2" role="status">
                    <span class="bi bi-question-diamond" aria-hidden="true"></span>
                    Referred to @refs times and still Unknown.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick='() => OnGoToTab.InvokeAsync("Entities")'>Review its disposition</button>
                </div>
            }
        </div>

        <div class="im-entity-panel-body">
            @* HR-05: how the verdict on this case was reached, newest first. *@
            @if (Case.VerdictChanges.Where(v => v.EntityId == en.Id).OrderByDescending(v => v.EffectiveAt).ThenByDescending(v => v.ChangedAtUtc).ToList() is { Count: > 0 } verdicts)
            {
                <section>
                    <h3 class="im-entity-panel-h">Verdict history · @verdicts.Count</h3>
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var v in verdicts)
                        {
                            <li class="im-entity-ref">
                                <span class="fw-semibold">@Ui.Label(v.From) → @Ui.Label(v.To)</span>
                                @if (v.Reason is { } why) { <div>@why</div> }
                                <div class="text-muted">@Users.DisplayFor(v.ChangedBy) · @TimeDisp.Short(v.EffectiveAt)@(v.EffectiveAtUtc is not null ? $" · recorded {TimeDisp.Short(v.ChangedAtUtc)}" : "")</div>
                            </li>
                        }
                    </ul>
                </section>
            }
            <AccountDirectoryPanel CaseId="Case.Id" Entity="en" CanEdit="CanEdit" />
            <section>
                <h3 class="im-entity-panel-h">On this case · @References.Count</h3>
                @if (References.Count == 0)
                {
                    <p class="small text-muted mb-0">Nothing on the timeline, in the notes, in task comments or in the brief refers to it yet.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var r in References)
                        {
                            <li class="im-entity-ref">
                                <button type="button" class="btn btn-link p-0 text-start" @onclick="() => OnGoToTab.InvokeAsync(r.Tab)">
                                    <span class="im-badge im-b-neutral me-1">@r.Kind</span>@r.Text
                                </button>
                                <div class="small text-muted">@r.Why · @TimeDisp.Short(r.At)</div>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section>
                <div class="d-flex align-items-baseline justify-content-between">
                    <h3 class="im-entity-panel-h">Tasks · @Tasks.Count</h3>
                    @if (CanEdit && !_addingTask)
                    {
                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _addingTask = true">
                            <span class="bi bi-plus-lg" aria-hidden="true"></span> Task
                        </button>
                    }
                </div>
                @if (Tasks.Count == 0 && !_addingTask)
                {
                    <p class="small text-muted mb-0">No tasks are about it.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-1 small">
                        @foreach (var t in Tasks)
                        {
                            <li class="im-entity-ref">
                                <button type="button" class="btn btn-link p-0 text-start @(t.IsOpen ? "" : "text-muted text-decoration-line-through")" @onclick='() => OnGoToTab.InvokeAsync("Tasks")'>@t.Title</button>
                                <div class="text-muted">@(t.IsOpen ? "Open" : "Done")@(string.IsNullOrWhiteSpace(t.Owner) ? "" : $" · {Users.DisplayFor(t.Owner)}")</div>
                            </li>
                        }
                    </ul>
                }
                @if (_addingTask)
                {
                    <QuickTask CaseId="Case.Id" About="@($"{ActionItem.AboutEntity}:{en.Id}")" Placeholder="@($"A task about {(string.IsNullOrWhiteSpace(en.Label) ? en.Value : en.Label)}")"
                               OnDone="async () => { _addingTask = false; await OnChanged.InvokeAsync(); }" OnCancel="() => _addingTask = false" />
                }
            </section>

            @if (Relationships.Count > 0)
            {
                <section>
                    <h3 class="im-entity-panel-h">Relationships · @Relationships.Count</h3>
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var (verb, other) in Relationships)
                        {
                            <li><span class="text-muted">@verb</span> <code>@Short(other)</code></li>
                        }
                    </ul>
                </section>
            }

            @* RD-05: "have we seen this before?" in one place: open cases (still live), then closed ones with how they
               ended (HR-03), each with the verdict reached there. Exact values only, on cases you can see. *@
            <section>
                <h3 class="im-entity-panel-h">Seen before@(_otherCases is null ? "" : $" · {_otherCases.Count}")</h3>
                @if (_otherCases is null)
                {
                    <p class="small text-muted mb-0">Checking…</p>
                }
                else if (_otherCases.Count == 0)
                {
                    <p class="small text-muted mb-0">Not on any other case you can see. Matching is on the exact value.</p>
                }
                else
                {
                    @foreach (var o in _otherCases.Where(o => !o.IsClosed))
                    {
                        <div class="im-seen">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <VerdictMark Value="o.DispositionThere" />
                                <a href="cases/@o.OtherCaseId" class="im-data small">@o.OtherCaseNumber</a>
                                <span class="small text-muted ms-auto">open · @Ui.Label(o.OtherPhase)</span>
                            </div>
                            <div class="small">@o.OtherTitle</div>
                        </div>
                    }
                    @foreach (var o in _otherCases.Where(o => o.IsClosed).OrderByDescending(o => o.ClosedAtUtc))
                    {
                        <CaseHistoryItem CaseId="o.OtherCaseId" CaseNumber="@o.OtherCaseNumber" Title="@o.OtherTitle" Classification="o.OtherClassification"
                                         ClosedAtUtc="o.ClosedAtUtc" OutcomeLabel="@OutcomeLabel(o.OutcomeKey)" ClosingLine="@o.ClosingLine"
                                         Verdicts="@($"{Ui.Label(o.DispositionThere)} there")" />
                    }
                    <a class="small" href="intel/indicators?entity=@en.Id">Compare verdicts across cases</a>
                }
            </section>

            @* CAP-28: not the same value, but close to it by fixed rules (domain, /24 or /48, email domain), on cases you can
               see. Suggestions only: nothing is linked, and no value goes in a link (C7). *@
            <section aria-labelledby="ep-related-h">
                <h3 class="im-entity-panel-h" id="ep-related-h">Possibly related@(_related is null or { Count: 0 } ? "" : $" · {_related.Count}")</h3>
                @if (IncidentManager.Domain.Observables.RelatedObservables.KeyOf(en.Type, en.Value) is not { } key)
                {
                    <p class="small text-muted mb-0">Suggested for domains, URLs, IP addresses and email addresses only.</p>
                }
                else if (_related is null)
                {
                    <p class="small text-muted mb-0">Checking…</p>
                }
                else if (_related.Count == 0)
                {
                    <p class="small text-muted mb-0">Nothing on other cases you can see has the @key.Describe().</p>
                }
                else
                {
                    @foreach (var r in _related)
                    {
                        <div class="im-seen">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <VerdictMark Value="r.DispositionThere" />
                                <a href="cases/@r.OtherCaseId" class="im-data small">@r.OtherCaseNumber</a>
                                <span class="small text-muted ms-auto">@(r.IsClosed ? "closed" : $"open · {Ui.Label(r.OtherPhase)}")</span>
                            </div>
                            <div class="small im-ellipsis" title="@r.OtherValue"><code>@r.OtherValue</code></div>
                            <div class="small text-muted">@r.Why</div>
                        </div>
                    }
                    <p class="small text-muted mb-0">A suggestion by a fixed rule, not a match. Nothing is linked.</p>
                }
            </section>
        </div>
    </aside>
}

@code {
    [Parameter, EditorRequired] public Case Case { get; set; } = null!;
    [Parameter] public Guid? EntityId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Filter the timeline to this entity (INV-03).</summary>
    [Parameter] public EventCallback<Guid> OnShowOnTimeline { get; set; }
    [Parameter] public EventCallback<string> OnGoToTab { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    /// <summary>Reload the case after a task is added.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _addingTask;

    // RD-05: the verdict picker, in the order of the shapes legend.
    private static readonly EntityDisposition[] VerdictOrder =
        [EntityDisposition.Unknown, EntityDisposition.Benign, EntityDisposition.Suspicious, EntityDisposition.Malicious, EntityDisposition.Compromised];
    private EntityDisposition? _pendingVerdict;
    private EntityDisposition? _verdictFrom;   // BUG-372: the verdict shown when the pick was made
    private string? _verdictReason;
    private DateTime? _verdictWhen;   // BUG-414: when it was determined (null = now)
    private string? _verdictError;
    private bool _savingVerdict;
    private bool _copied;

    [Inject] private IClock Clock { get; set; } = null!;
    [CascadingParameter] public EditRegion? Region { get; set; }

    // BUG-578: a verdict's reason or time typed and not saved is asked about before the panel closes or moves on.
    protected override void OnInitialized() =>
        Edits.Track(this, "the verdict you're recording", () => _pendingVerdict is not null && (!string.IsNullOrWhiteSpace(_verdictReason) || _verdictWhen is not null), Region);

    public void Dispose() => Edits.Forget(this);

    // BUG-601: which entity the panel shows, as a ticket taken on each switch; a load or a save that finishes after the
    // panel moved on (even back to the same entity) leaves what's shown now alone.
    private readonly LoadSequence _showing = new();
    private LoadSequence.Ticket _shown;

    private void PickVerdict(CaseEntity en, EntityDisposition d)
    {
        _verdictError = null;
        // BUG-372: kept from the first pick, so a colleague's verdict that lands before Save is refused, not overwritten.
        _verdictFrom = d == en.Disposition ? null : _verdictFrom ?? en.Disposition;
        _pendingVerdict = d == en.Disposition ? null : d;
    }

    private async Task SaveVerdict(CaseEntity en)
    {
        if (_pendingVerdict is not { } d || _savingVerdict) return;
        var seen = _verdictFrom ?? en.Disposition;
        var shown = _shown;
        var reason = _verdictReason;
        _savingVerdict = true;
        _verdictError = null;
        try
        {
            // BUG-234: the verdict alone; the other fields stay as they are now, not as this panel last showed them.
            await Cases.SetEntityVerdictAsync(Case.Id, en.Id, d,
                string.IsNullOrWhiteSpace(reason) ? null : reason.Trim(), expectedDisposition: seen,
                determinedAtUtc: DeterminedAt.UtcOf(_verdictWhen, TimeDisp.Zone, Clock.UtcNow));
            Toasts.Success($"Verdict recorded: {Ui.Label(d)}");
            // BUG-601: the panel moved to another entity meanwhile: its pick and reason aren't this save's to close.
            if (_showing.IsCurrent(shown))
            {
                _pendingVerdict = null; _verdictFrom = null; _verdictWhen = null;
                _verdictReason = DraftText.ClearIfUnchanged(_verdictReason, reason, null);   // disabled while it saves
            }
            await OnChanged.InvokeAsync();
        }
        catch (StaleEditException ex)
        {
            if (_showing.IsCurrent(shown))
            {
                _pendingVerdict = null; _verdictFrom = null;
                _verdictError = ex.Message;
            }
            else Toasts.Error(ex.Message);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            if (_showing.IsCurrent(shown)) _verdictError = ex.Message;
            else Toasts.Error(ex.Message);
        }
        finally { _savingVerdict = false; }
    }

    // The value as it's shared outside CaseBook (network types defanged, others as they are).
    private static string? Defanged(CaseEntity en) =>
        en.Type is EntityType.IpAddress or EntityType.Domain or EntityType.Url or EntityType.EmailAddress
            ? IncidentManager.Domain.Observables.IocObservable.Defang(en.Value) : null;

    private async Task CopyDefanged(CaseEntity en)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Defanged(en) ?? en.Value);
            _copied = true;
            Toasts.Success("Copied");
        }
        catch (JSException) { Toasts.Error("Couldn't copy. Select the value and copy it instead."); }
    }

    private string? VirusTotalUrl(CaseEntity e)
    {
        if (!Ui.IsIocLike(e.Type) || string.IsNullOrWhiteSpace(e.Value)) return null;
        var template = Config["ExternalLinks:VirusTotalUrlTemplate"];
        return IncidentManager.Application.Content.LinkTemplate.Fill(template, e.Value);   // BUG-264
    }

    // BUG-603: a double-click pins once (the second click read the pin from before the first and undid it).
    private readonly InFlight _pinning = new();
    private Task TogglePin(CaseEntity en) => _pinning.Run(() => TogglePinCore(en));

    private async Task TogglePinCore(CaseEntity en)
    {
        try
        {
            await Cases.SetEntityPinnedAsync(Case.Id, en.Id, !en.IsPinned);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); }
    }
    private List<ActionItem> Tasks => EntityId is { } id
        ? Case.ActionItems.Where(t => t.AboutRef == $"{ActionItem.AboutEntity}:{id}")
            .OrderByDescending(t => t.IsOpen).ThenBy(t => t.CreatedAtUtc).ToList()
        : [];

    private sealed record Reference(string Kind, string Text, string Why, DateTimeOffset At, string Tab);

    private CaseEntity? Entity => EntityId is { } id ? Case.Entities.FirstOrDefault(e => e.Id == id) : null;

    private IReadOnlyList<EntityOverlap>? _otherCases;
    private IReadOnlyList<RelatedIndicator>? _related;   // CAP-28
    private IReadOnlyDictionary<string, string> _outcomeLabels = new Dictionary<string, string>();
    private string? OutcomeLabel(string? key) => key is null ? null
        : _outcomeLabels.GetValueOrDefault(key) ?? IncidentManager.Application.Admin.CaseOutcomeCatalog.Label(key);
    private IReadOnlyList<ActionItemCommentView> _taskComments = [];
    private Guid? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (EntityId == _loadedFor) return;
        _loadedFor = EntityId;
        var t = _shown = _showing.Begin();
        _addingTask = false;
        _pendingVerdict = null; _verdictFrom = null;
        _verdictReason = null;
        _verdictWhen = null;
        _verdictError = null;
        _copied = false;
        _otherCases = null;
        _related = null;
        if (EntityId is { } id)
        {
            // BUG-342: a quick switch to another entity starts its own load; drop this one's results once it has.
            var caseId = Case.Id;
            var overlaps = (await Cases.FindEntityOverlapsAsync(caseId, entityId: id))   // BUG-254: this entity's only
                .DistinctBy(o => o.OtherCaseId).ToList();
            if (!_showing.IsCurrent(t)) return;   // BUG-601: an A, B, A switch doesn't let the first A load land
            _otherCases = overlaps;
            var related = await Cases.FindRelatedIndicatorsAsync(caseId, entityId: id);   // CAP-28
            if (!_showing.IsCurrent(t)) return;
            _related = related;
            if (overlaps.Any(o => o.IsClosed) && _outcomeLabels.Count == 0)
            {
                var labels = await Outcomes.LabelsAsync();
                if (!_showing.IsCurrent(t)) return;
                _outcomeLabels = labels;
            }
            var comments = await TaskComments.ListForCaseAsync(caseId);   // INV-34
            if (!_showing.IsCurrent(t)) return;
            _taskComments = comments;
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await OnClose.InvokeAsync();
    }

    private string Tag => $"entity:{EntityId}";

    // INV-34: "tagged" for an entity chip; "mentioned" when the entity's value (an IP, host, account…) is typed out.
    // Short values are skipped so they don't match everywhere.
    private string? Why(string text)
    {
        if (text.Contains(Tag, StringComparison.OrdinalIgnoreCase)) return "tagged";
        return Entity is { Value.Length: >= 4 } en && text.Contains(en.Value, StringComparison.OrdinalIgnoreCase) ? "mentioned" : null;
    }

    private List<Reference> References
    {
        get
        {
            if (EntityId is not { } id) return [];
            var list = new List<Reference>();
            foreach (var t in Case.TimelineEntries.Where(t => t.IsCurrent))
            {
                var why = t.ActorEntityId == id ? "actor" : t.TargetEntityId == id ? "target" : Why(t.Description);
                if (why is null) continue;
                var kind = t.Kind == TimelineKind.Event ? "Event" : t.Type == TimelineEntryType.Decision ? "Decision" : "Investigation";
                list.Add(new(kind, Snippet(t.Description), why, t.OccurredAtUtc, "Timeline"));
            }
            foreach (var n in Case.Notes.Where(n => n.IsCurrent))
                if (Why(n.Body) is { } nw) list.Add(new("Note", Snippet(n.Body), nw, n.CreatedAtUtc, "Notes"));
            // INV-34: task comments (plain text, so usually the value typed out rather than a tag).
            foreach (var tc in _taskComments)
                if (Why(tc.Body) is { } cw)
                {
                    var task = Case.ActionItems.FirstOrDefault(t => t.Id == tc.ActionItemId);
                    list.Add(new("Task comment", Snippet(tc.Body), task is null ? cw : $"{cw} on \"{task.Title}\"", tc.CreatedAtUtc, "Tasks"));
                }
            // INV-36: the summary is the brief's first part (and may exist before any other part is written).
            var brief = Case.Briefs.FirstOrDefault(b => b.IsCurrent);
            if (new[] { Case.Summary, brief?.WorkingAssessment, brief?.Known, brief?.OpenQuestions, brief?.NextSteps }
                    .Any(p => p?.Contains(Tag, StringComparison.OrdinalIgnoreCase) == true))
                list.Add(new("Brief", "Case brief", "tagged", brief?.CreatedAtUtc ?? Case.CreatedAtUtc, "Briefing"));
            return list.OrderByDescending(r => r.At).ToList();
        }
    }

    private List<(string Verb, CaseEntity Other)> Relationships
    {
        get
        {
            if (EntityId is not { } id) return [];
            var byId = Case.Entities.ToDictionary(e => e.Id);
            var list = new List<(string, CaseEntity)>();
            foreach (var r in Case.EntityRelationships)
            {
                if (r.SourceEntityId == id && byId.TryGetValue(r.TargetEntityId, out var to))
                    list.Add((Ui.Label(r.Type), to));
                else if (r.TargetEntityId == id && byId.TryGetValue(r.SourceEntityId, out var from))
                    list.Add(($"{Ui.Label(r.Type)} (from)", from));
            }
            return list;
        }
    }

    private static string Short(CaseEntity e) => string.IsNullOrWhiteSpace(e.Label) ? e.Value : $"{e.Label} ({e.Value})";

    // A one-line, plain-text excerpt (Markdown and entity-tag syntax flattened).
    private string Snippet(string markdown)
    {
        var text = Md.ToPlainText(markdown).Replace('\n', ' ').Trim();
        return IncidentManager.Application.Common.TextFit.Cap(text, 120);
    }
}
