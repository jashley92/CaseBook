@* Case workspace — Discussion tab (PROD-04). Durable, threaded team comments with @mention notifications.
   Distinct from Notes (an analyst's own investigation documentation): this is cross-role conversation and
   handoff. Comments are append-only and hash-chained/audited by the save interceptor. Available to anyone
   who can view the case (the workspace already gates ViewCases), so Managers / Legal can participate too. *@
@implements IAsyncDisposable
@inject CaseCommentService Comments
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IncidentManager.Application.Abstractions.ICurrentUser Me
@inject IncidentManager.Application.Content.IMarkdownService Md
@inject TimeDisplay TimeDisp
@inject ToastService Toasts
@inject IJSRuntime JS

<div class="card mb-3">
    <div class="card-body">
        @if (_replyTo is { } r)
        {
            <div class="mb-2">
                <span class="im-badge im-b-info">
                    <span class="bi bi-reply" aria-hidden="true"></span> Replying to @AuthorName(r)
                </span>
                <button class="btn btn-link btn-sm p-0 ms-2 align-baseline" @onclick="CancelReply">Cancel</button>
            </div>
        }
        <label class="form-label small mb-1" for="@ComposerId">
            @(_replyTo is null ? "Add a comment" : "Reply")
            <span class="text-muted">· Markdown &mdash; <code>@@</code> to mention a teammate, <code>#</code> to tag an entity</span>
        </label>
        <ComposerHint>Team conversation and handoffs. <code>@@</code>mentioned teammates are notified. Not printed in the case report; record findings in <strong>Notes</strong>.</ComposerHint>
        @* EasyMDE enhances this textarea (toolbar + inline @mention autocomplete); managed in OnAfterRenderAsync. *@
        <textarea id="@ComposerId" class="form-control mb-2" placeholder="Share an update, a question, or a handoff…"></textarea>

        <button class="btn btn-sm btn-primary" @onclick="Submit">
            @(_replyTo is null ? "Post comment" : "Post reply")
        </button>
    </div>
</div>

@if (_comments is null)
{
    <p class="text-muted"><em>Loading discussion…</em></p>
}
else if (_comments.Count == 0)
{
    <div class="empty-state">
        <span class="bi bi-chat-dots empty-state-icon" aria-hidden="true"></span>
        <div class="empty-state-title">No discussion yet</div>
        <div class="empty-state-msg">Start the conversation — post an update, ask a question, or hand the case off. @@mention a teammate to pull them in.</div>
    </div>
}
else
{
    @foreach (var c in TopLevel)
    {
        @RenderComment(c, isReply: false)
        @foreach (var reply in RepliesOf(c.Id))
        {
            @RenderComment(reply, isReply: true)
        }
    }
}

@code {
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    /// <summary>The case's entities/IOCs, offered as inline "#" tags in the composer.</summary>
    [Parameter] public IReadOnlyList<IncidentManager.Domain.Entities.CaseEntity> Entities { get; set; } = [];
    /// <summary>FR-02: parent-owned draft store (survives tab switches). The comment composer stashes its
    /// unsubmitted text here on teardown and re-seeds from it on remount, so hopping tabs doesn't lose a reply.</summary>
    [Parameter] public Dictionary<string, string>? ComposerDrafts { get; set; }

    private List<CaseCommentView>? _comments;
    private CaseCommentView? _replyTo;
    private Guid _loadedCaseId;

    private string ComposerId => $"discuss-md-{CaseId}";
    private bool _editorMounted;

    // Everyone in the directory except the current user, as inline-@mention candidates ({id, name} for JS).
    private object[] MentionCandidates =>
        Users.All()
            .Where(u => !string.Equals(u.UserId, Me.UserId, StringComparison.OrdinalIgnoreCase))
            .Select(u => (object)new { id = u.UserId, name = u.DisplayName })
            .ToArray();

    // The case's entities as inline "#" tag candidates ({id, value, hint} for JS).
    private object[] EntityCandidates =>
        (Entities ?? Array.Empty<IncidentManager.Domain.Entities.CaseEntity>())
            .Select(e => (object)new
            {
                id = e.Id.ToString(),
                value = string.IsNullOrWhiteSpace(e.Label) ? e.Value : e.Label!,
                hint = e.Type.ToString()
            })
            .ToArray();

    private IEnumerable<CaseCommentView> TopLevel =>
        _comments!.Where(c => c.ParentId is null).OrderBy(c => c.CreatedAtUtc);

    private IEnumerable<CaseCommentView> RepliesOf(Guid parentId) =>
        _comments!.Where(c => c.ParentId == parentId).OrderBy(c => c.CreatedAtUtc);

    protected override async Task OnParametersSetAsync()
    {
        if (CaseId != _loadedCaseId) { _loadedCaseId = CaseId; await Load(); }
    }

    private async Task Load() => _comments = await Comments.ListAsync(CaseId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Enhance the composer with EasyMDE (markdown toolbar) + inline @mention autocomplete, once mounted.
        if (!_editorMounted)
        {
            try
            {
                // FR-02: re-seed the composer from a stashed draft if one survived a tab switch.
                var seed = ComposerDrafts?.GetValueOrDefault(ComposerId) ?? "";
                await JS.InvokeVoidAsync("markdownEditor.init", ComposerId, seed,
                    new { mentions = MentionCandidates, entities = EntityCandidates });
                _editorMounted = true;
            }
            catch (JSException) { /* editor is a progressive enhancement; Submit falls back gracefully */ }
        }
    }

    private void StartReply(CaseCommentView c) => _replyTo = c;
    private void CancelReply() => _replyTo = null;

    private async Task Submit()
    {
        string body;
        IReadOnlyList<string> mentions = Array.Empty<string>();
        try
        {
            body = (await JS.InvokeAsync<string>("markdownEditor.getValue", ComposerId) ?? "").Trim();
            mentions = await JS.InvokeAsync<string[]>("markdownEditor.getMentions", ComposerId);
        }
        catch (JSException) { return; } // editor not ready

        if (string.IsNullOrWhiteSpace(body)) return;
        try
        {
            await Comments.AddAsync(CaseId, body, _replyTo?.Id, mentions);
            _replyTo = null;
            await Load();
            Toasts.Success("Comment posted.");
            ComposerDrafts?.Remove(ComposerId); // FR-02: the draft is now saved
            try { await JS.InvokeVoidAsync("markdownEditor.setValue", ComposerId, ""); } catch (JSException) { /* best effort */ }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Toasts.Error(ex.Message);
        }
    }

    // FR-02: preserve an unsubmitted comment across a tab switch by stashing it in the parent-owned store.
    private async Task StashDraft()
    {
        if (ComposerDrafts is null) return;
        try
        {
            var val = await JS.InvokeAsync<string>("markdownEditor.getValue", ComposerId);
            if (!string.IsNullOrWhiteSpace(val)) ComposerDrafts[ComposerId] = val;
            else ComposerDrafts.Remove(ComposerId);
        }
        catch { /* editor not mounted or circuit tearing down — nothing to stash */ }
    }

    public async ValueTask DisposeAsync()
    {
        await StashDraft();
        try { await JS.InvokeVoidAsync("markdownEditor.destroy", ComposerId); }
        catch { /* circuit may already be gone during teardown */ }
    }

    private string AuthorName(CaseCommentView c) => c.AuthorName;

    private RenderFragment RenderComment(CaseCommentView c, bool isReply) =>@<div class="card mb-2 @(isReply ? "ms-4" : "")" @key="c.Id">
        <div class="card-body py-2">
            <div class="md-body">@((MarkupString)Md.ToHtml(c.Body, CaseId))</div>
            @if (c.Mentions.Count > 0)
            {
                <div class="mt-1">
                    @foreach (var m in c.Mentions)
                    {
                        <span class="im-badge im-b-info me-1"><span class="bi bi-at" aria-hidden="true"></span> @m</span>
                    }
                </div>
            }
            <small class="text-muted">
                @c.AuthorName · @TimeDisp.Long(c.CreatedAtUtc)
            </small>
            @if (!isReply)
            {
                <button class="btn btn-sm btn-link p-0 ms-2 align-baseline" @onclick="() => StartReply(c)">Reply</button>
            }
        </div>
    </div>;
}
