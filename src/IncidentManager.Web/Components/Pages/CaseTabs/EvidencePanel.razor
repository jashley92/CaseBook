@* RD-06 (Casefile): an evidence file in a side panel over whatever tab is open: what it is, a preview on request,
   its integrity in words, the chain of custody, what cites it and the tasks about it, with the acts on the file
   (cite, task, record a transfer, download). Opened from an evidence row, a cited-file chip or a brief citation;
   deep-linked as ?evidence=<id>. A preview is a deliberate look and records a "Viewed" custody event; a download
   records "Downloaded" and says so before you click. *@
@using Microsoft.Extensions.Logging
@inject EvidenceService Evidence
@inject IncidentManager.Application.Cases.CaseService Cases
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IncidentManager.Application.Content.IMarkdownService Md
@inject TimeDisplay TimeDisp
@inject ToastService Toasts
@inject IClock Clock
@inject ILogger<EvidencePanel> Logger
@inject UnsavedEdits Edits
@inject Microsoft.Extensions.Options.IOptionsMonitor<IncidentManager.Application.Evidence.EvidenceStorageOptions> EvidenceOptions
@implements IDisposable

@if (File is { } ev)
{
    <div class="im-panel-scrim" @onclick="OnClose"></div>
    <aside class="im-entity-panel im-trap" role="dialog" aria-modal="true" aria-labelledby="evidence-panel-title" tabindex="-1" @onkeydown="OnKey">
        <div class="im-entity-panel-head">
            <div class="d-flex align-items-center gap-2">
                <span class="bi @(IsImage(ev) ? "bi-file-earmark-image" : "bi-file-earmark-text") im-dossier-glyph" aria-hidden="true"></span>
                <h2 class="im-dossier-value mb-0" id="evidence-panel-title"><span class="im-data @(ev.IsWithdrawn ? "im-evp-withdrawn-name" : "")">@ev.OriginalFileName</span></h2>
                <button type="button" class="btn-close ms-auto" aria-label="Close" @onclick="OnClose"></button>
            </div>
            @if (!string.IsNullOrWhiteSpace(ev.Description)) { <div class="im-dossier-label">@ev.Description</div> }
            <div class="small text-muted">
                @(string.IsNullOrWhiteSpace(ev.ContentType) ? "File" : ev.ContentType) · @FormatSize(ev.SizeBytes) · added @TimeDisp.Brief(ev.CreatedAtUtc, Clock.UtcNow) by @Users.DisplayFor(ev.CreatedBy)
            </div>
            @if (ev.IsWithdrawn)
            {
                @* CAP-21: off the record, kept: who withdrew it, when and why. *@
                <div class="small mt-2" role="status">
                    <span class="im-badge im-b-warn"><span class="bi bi-slash-circle" aria-hidden="true"></span> Withdrawn</span>
                    by @Users.DisplayFor(ev.WithdrawnBy) · @TimeDisp.Long(ev.WithdrawnAtUtc!.Value)
                    <div class="text-muted im-ev-withdrawn-why">@ev.WithdrawnReason</div>
                    @if (ev.IsPurged)
                    {
                        <div class="mt-1"><span class="im-badge im-b-danger"><span class="bi bi-trash3" aria-hidden="true"></span> Contents purged</span>
                            by @Users.DisplayFor(ev.PurgedBy) · @TimeDisp.Long(ev.PurgedAtUtc!.Value)</div>
                        <div class="text-muted">@ev.PurgedReason</div>
                        <div class="text-muted">The file's bytes were deleted. Its name, SHA-256 and chain of custody stay.</div>
                    }
                    else
                    {
                        <div class="text-muted">It's left out of the report, the gates, citing and packages. The file, its hash and its chain of custody stay.</div>
                        @if (ReinstatableUntil(ev) is { } until && Clock.UtcNow <= until)
                        {
                            <div class="text-muted">It can be put back on the case until @TimeDisp.Long(until).</div>
                        }
                        else if (!ev.WasMovedOut)
                        {
                            <div class="text-muted">The withdrawal is final. An administrator can purge its contents (Administration › Evidence storage).</div>
                        }
                    }
                </div>
            }
            <div class="d-flex flex-wrap gap-2 mt-2">
                @if (!ev.IsPurged)
                {
                    <a class="btn btn-sm btn-outline-secondary" href="evidence/@ev.Id" target="_blank" rel="noopener"
                       title="Downloading adds a custody event in your name and an access-log entry">
                        <span class="bi bi-download" aria-hidden="true"></span> Download
                    </a>
                }
                @if (CanEdit && ev.IsWithdrawn && ReinstatableUntil(ev) is { } canUntil && Clock.UtcNow <= canUntil)
                {
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => StartReinstate(ev)">
                        <span class="bi bi-arrow-counterclockwise" aria-hidden="true"></span> Reinstate…
                    </button>
                }
                @if (CanEdit && !ev.IsWithdrawn)
                {
                    @* BUG-578: opening one doesn't close the other, so what's typed in it stays.
                       CAP-21 review: none for a withdrawn file: it's off the record, so no task is about it and no transfer of it is
                       recorded (both refused on the server too). *@
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _addingTask = true">
                        <span class="bi bi-plus-lg" aria-hidden="true"></span> Task about it
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _transferOpen = true">
                        <span class="bi bi-arrow-left-right" aria-hidden="true"></span> Record a transfer…
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => StartWithdraw(ev)"
                            title="Take a file filed on the wrong case off its record, with a reason">
                        <span class="bi bi-slash-circle" aria-hidden="true"></span> Withdraw…
                    </button>
                }
            </div>
            <div class="small text-muted mt-1">Downloading adds a custody event in your name and an access-log entry.</div>
        </div>

        <div class="im-entity-panel-body">
            @if (_reinstateOpen && ev.IsWithdrawn)
            {
                <section class="im-dossier-reason">
                    <h3 class="im-entity-panel-h">Put this file back on the case</h3>
                    <p class="small text-muted mb-2">It counts in the report and the gates again. The withdrawal and this stay in the chain of custody and the audit trail.</p>
                    <label class="form-label small mb-0" for="evp-reinstate-why">Why? <span class="text-muted">(required)</span></label>
                    <textarea id="evp-reinstate-why" class="form-control form-control-sm mb-2" rows="2" maxlength="@IncidentManager.Domain.Entities.Evidence.MaxWithdrawnReasonLength"
                              @bind="_reinstateReason" @bind:event="oninput" disabled="@_reinstateBusy" placeholder="e.g. Withdrawn by mistake; it is this case's"></textarea>
                    @if (_reinstateError is not null) { <div class="text-danger small mb-2" role="alert">@_reinstateError</div> }
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => (_reinstateOpen, _reinstateError) = (false, null)">Cancel</button>
                        <button type="button" class="btn btn-sm btn-primary" disabled="@(_reinstateBusy || string.IsNullOrWhiteSpace(_reinstateReason))"
                                @onclick="() => SaveReinstate(ev)">Reinstate the file</button>
                    </div>
                </section>
            }
            @if (_withdrawOpen && !ev.IsWithdrawn)
            {
                @* CAP-21: as retracting a timeline entry (BUG-413): a required reason, nothing deleted. Or moved to the right case. *@
                <section class="im-dossier-reason">
                    <h3 class="im-entity-panel-h">Withdraw this file</h3>
                    <p class="small text-muted mb-2">For a file filed on the wrong case. It leaves this case's report, the gates' evidence count and
                        citing, and can't be packaged. The file, its SHA-256 and its chain of custody stay, it can still be downloaded, and the
                        withdrawal is recorded in the chain of custody and the audit trail. @ReinstateNote</p>
                    <div class="mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="evp-withdraw-how" id="evp-withdraw-only" checked="@(!_moveIt)"
                                   @onchange="() => _moveIt = false" disabled="@_withdrawBusy" />
                            <label class="form-check-label small" for="evp-withdraw-only">Withdraw it from this case</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="evp-withdraw-how" id="evp-withdraw-move" checked="@_moveIt"
                                   @onchange="() => _moveIt = true" disabled="@_withdrawBusy" />
                            <label class="form-check-label small" for="evp-withdraw-move">Move it to the case it belongs on</label>
                        </div>
                        @if (_moveIt)
                        {
                            <label class="form-label small mb-0 mt-1" for="evp-move-to">Case number</label>
                            <input id="evp-move-to" class="form-control form-control-sm" style="max-width:20rem" @bind="_moveTo" @bind:event="oninput"
                                   disabled="@_withdrawBusy" placeholder="e.g. 2026-0142" />
                            <div class="form-text">It's copied there with its hash, collection details and description (checked against its
                                SHA-256), with a custody entry naming this case, and withdrawn here.</div>
                        }
                    </div>
                    <label class="form-label small mb-0" for="evp-withdraw-why">Why is it being withdrawn? <span class="text-muted">(required)</span></label>
                    <textarea id="evp-withdraw-why" class="form-control form-control-sm mb-2" rows="3" maxlength="@IncidentManager.Domain.Entities.Evidence.MaxWithdrawnReasonLength"
                              @bind="_withdrawReason" @bind:event="oninput" disabled="@_withdrawBusy"
                              placeholder="e.g. Uploaded to the wrong case; it belongs to 2026-0142"></textarea>
                    @if (_withdrawError is not null) { <div class="text-danger small mb-2" role="alert">@_withdrawError</div> }
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelWithdraw">Cancel</button>
                        <button type="button" class="btn btn-sm btn-danger" disabled="@(_withdrawBusy || string.IsNullOrWhiteSpace(_withdrawReason) || (_moveIt && string.IsNullOrWhiteSpace(_moveTo)))"
                                @onclick="() => SaveWithdraw(ev)">@(_moveIt ? "Move the file" : "Withdraw the file")</button>
                    </div>
                </section>
            }
            @if (_addingTask && !ev.IsWithdrawn)
            {
                <section>
                    <QuickTask CaseId="Case.Id" About="@($"{ActionItem.AboutEvidence}:{ev.Id}")" Placeholder="A task about this file"
                               OnDone="async () => { _addingTask = false; await OnChanged.InvokeAsync(); }" OnCancel="() => _addingTask = false" />
                </section>
            }
            @if (_transferOpen && !ev.IsWithdrawn)
            {
                <section class="im-dossier-reason">
                    <h3 class="im-entity-panel-h">Record a transfer</h3>
                    <p class="small text-muted mb-2">Who received a copy outside CaseBook, how and why. It's added to the chain of custody and the audit trail.</p>
                    <label class="form-label small mb-0" for="evp-to">Recipient</label>
                    <input id="evp-to" class="form-control form-control-sm mb-2" maxlength="200" @bind="_xferTo" @bind:event="oninput" disabled="@_xferBusy" placeholder="e.g. Outside counsel (Smith LLP)" />
                    <label class="form-label small mb-0" for="evp-how">Method <span class="text-muted">(optional)</span></label>
                    <input id="evp-how" class="form-control form-control-sm mb-2" maxlength="100" @bind="_xferHow" @bind:event="oninput" disabled="@_xferBusy" placeholder="e.g. Encrypted SFTP" />
                    <label class="form-label small mb-0" for="evp-why">Purpose</label>
                    <input id="evp-why" class="form-control form-control-sm mb-2" maxlength="500" @bind="_xferWhy" @bind:event="oninput" disabled="@_xferBusy" placeholder="e.g. Forensic analysis under engagement letter" />
                    @if (_xferError is not null) { <div class="text-danger small mb-2" role="alert">@_xferError</div> }
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _transferOpen = false">Cancel</button>
                        <button type="button" class="btn btn-sm btn-primary" disabled="@_xferBusy" @onclick="() => SaveTransfer(ev)">Record transfer</button>
                    </div>
                </section>
            }

            <section>
                <h3 class="im-entity-panel-h">Preview</h3>
                @if (IsImage(ev))
                {
                    <button type="button" class="btn p-0 border-0 bg-transparent" title="Open the image" @onclick="() => OnPreviewImage.InvokeAsync(ev.Id)">
                        <img src="evidence/@ev.Id/inline" alt="Preview of @ev.OriginalFileName" loading="lazy" class="im-evp-thumb" />
                    </button>
                    <div class="small text-muted mt-1">Opening the image records that you viewed it.</div>
                }
                else if (EvidenceService.IsTextPreviewable(ev.ContentType, ev.OriginalFileName))
                {
                    @if (_preview is { } text)
                    {
                        <pre class="im-evp-text">@text</pre>
                    }
                    else if (_previewMissing)
                    {
                        <p class="small text-muted mb-0">This file doesn't read as text. Download it to look inside.</p>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_previewLoading" @onclick="() => LoadPreview(ev)">
                            <span class="bi bi-eye" aria-hidden="true"></span> Show the first lines
                        </button>
                        <div class="small text-muted mt-1">Looking records a "Viewed" event in the chain of custody.</div>
                    }
                }
                else
                {
                    <p class="small text-muted mb-0">No preview for this kind of file. Download it to open it.</p>
                }
            </section>

            @* CAP-08: when, where from and by whom it was collected: facts about how it was acquired, so they can be set or
               corrected here (an audited change); the file itself never changes. *@
            <section class="im-evp-collect">
                <h3 class="im-entity-panel-h">Collection</h3>
                @if (_collEditing)
                {
                    <label class="form-label small mb-0" for="evp-coll-at">Collected (@TimeDisp.Label)</label>
                    <DateTimeInput Past="true" TValue="DateTime?" id="evp-coll-at" class="form-control form-control-sm mb-2" @bind-Value="_collAt" disabled="@_collBusy" />
                    <label class="form-label small mb-0" for="evp-coll-from">Collected from</label>
                    <input id="evp-coll-from" class="form-control form-control-sm mb-2" maxlength="@IncidentManager.Domain.Entities.Evidence.MaxCollectedFromLength"
                           @bind="_collFrom" @bind:event="oninput" disabled="@_collBusy" placeholder="e.g. WKS-0142, a mailbox, Okta, the vendor" />
                    <label class="form-label small mb-0" for="evp-coll-by">Collected by</label>
                    <input id="evp-coll-by" class="form-control form-control-sm mb-2" maxlength="@IncidentManager.Domain.Entities.Evidence.MaxCollectedByLength"
                           @bind="_collBy" @bind:event="oninput" disabled="@_collBusy" placeholder="e.g. J. Rivera (EDR live response)" />
                    <div class="small text-muted mb-2">Not after it was uploaded (@TimeDisp.Long(ev.CreatedAtUtc)), or before the case's activity began. The change is kept in the audit trail.</div>
                    @if (_collError is not null) { <div class="text-danger small mb-2" role="alert">@_collError</div> }
                    <div class="d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _collEditing = false">Cancel</button>
                        <button type="button" class="btn btn-sm btn-primary" disabled="@_collBusy" @onclick="() => SaveCollection(ev)">Save</button>
                    </div>
                }
                else
                {
                    <dl>
                        <dt>Collected</dt>
                        <dd>@(ev.CollectedAtUtc is { } at ? TimeDisp.Long(at) : "Not recorded: taken to be the upload")</dd>
                        @if (ev.CollectedFrom is { } from) { <dt>From</dt><dd class="im-data">@from</dd> }
                        @if (ev.CollectedBy is { } by) { <dt>By</dt><dd>@by</dd> }
                        <dt>Uploaded</dt>
                        <dd>@TimeDisp.Long(ev.CreatedAtUtc)@if (ev.CollectedAtUtc is { } c && IncidentManager.Domain.Entities.Case.ToMinute(c) < IncidentManager.Domain.Entities.Case.ToMinute(ev.CreatedAtUtc)) { <span class="text-muted"> · recorded @Ui.Hours((ev.CreatedAtUtc - c).TotalHours) after collection</span> }</dd>
                    </dl>
                    @if (CanEdit && !ev.IsWithdrawn)
                    {
                        <button type="button" class="btn btn-sm btn-link p-0 mt-1" @onclick="() => StartCollection(ev)">
                            <span class="bi bi-pencil" aria-hidden="true"></span> @(ev.HasCollection ? "Correct how it was collected" : "Record how it was collected")
                        </button>
                    }
                }
            </section>

            <section>
                <h3 class="im-entity-panel-h">Integrity</h3>
                <div class="im-data im-evp-hash">@ev.Sha256</div>
                <div class="small mt-1"><span class="bi bi-shield-check text-success" aria-hidden="true"></span>
                    SHA-256 taken as the file arrived. If the stored bytes ever change, the evidence re-check raises an integrity alarm.</div>
            </section>

            <section>
                <h3 class="im-entity-panel-h">Chain of custody@(_custody is null ? "" : $" · {_custody.Count}")</h3>
                @if (_custody is null)
                {
                    <p class="small text-muted mb-0">Loading…</p>
                }
                else if (_custody.Count == 0)
                {
                    <p class="small text-muted mb-0">No custody events recorded.</p>
                }
                else
                {
                    <ol class="im-evp-custody">
                        @foreach (var c in _custody)
                        {
                            <li>
                                <span class="im-data small" title="@TimeDisp.Long(c.AtUtc)">@TimeDisp.Brief(c.AtUtc, Clock.UtcNow)</span>
                                <span class="im-evp-dot im-evp-@c.Action.ToLowerInvariant()" aria-hidden="true"></span>
                                <span><strong>@c.Action</strong> by @Users.DisplayFor(c.Actor)@if (!string.IsNullOrWhiteSpace(c.Details) && c.Action != "Uploaded") {<span class="d-block small text-muted">@c.Details</span>}</span>
                            </li>
                        }
                    </ol>
                }
            </section>

            <section>
                <h3 class="im-entity-panel-h">Cited by · @CitedBy(ev).Count</h3>
                @if (CitedBy(ev) is { Count: > 0 } cites)
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var (label, text, entryId) in cites)
                        {
                            <li class="im-entity-ref">
                                <button type="button" class="btn btn-link p-0 text-start" @onclick="() => Go(entryId)">
                                    <span class="im-badge im-b-neutral me-1">@label</span>@text
                                </button>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="small text-muted mb-0">Nothing cites it yet. Cite it from a timeline entry, or in the brief's Known.</p>
                }
            </section>

            @if (Case.ActionItems.Where(t => t.AboutRef == $"{ActionItem.AboutEvidence}:{ev.Id}").ToList() is { Count: > 0 } tasks)
            {
                <section>
                    <h3 class="im-entity-panel-h">Tasks · @tasks.Count</h3>
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var t in tasks)
                        {
                            <li class="im-entity-ref">
                                <span class="@(t.IsOpen ? "" : "text-muted text-decoration-line-through")">@t.Title</span>
                                <div class="text-muted">@(t.IsOpen ? "Open" : "Done")@(string.IsNullOrWhiteSpace(t.Owner) ? "" : $" · {Users.DisplayFor(t.Owner)}")</div>
                            </li>
                        }
                    </ul>
                </section>
            }
        </div>
    </aside>
}

@code {
    [Parameter, EditorRequired] public Case Case { get; set; } = null!;
    [Parameter] public Guid? EvidenceId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Open the image lightbox (it records the view).</summary>
    [Parameter] public EventCallback<Guid> OnPreviewImage { get; set; }
    /// <summary>Show a citing timeline entry (null: the brief, on the Overview).</summary>
    [Parameter] public EventCallback<Guid?> OnShowCitation { get; set; }

    private Evidence? File => EvidenceId is { } id ? Case.Evidence.FirstOrDefault(e => e.Id == id) : null;
    private Guid? _loadedFor;
    private List<ChainOfCustodyEvent>? _custody;
    private string? _preview;
    private bool _previewLoading, _previewMissing, _addingTask, _transferOpen, _xferBusy;
    private string? _xferTo, _xferHow, _xferWhy, _xferError;
    [CascadingParameter] public EditRegion? Region { get; set; }

    // BUG-601: which file the panel shows, as a ticket taken on each switch; a load or a save that finishes after the panel
    // moved on (even back to the same file) leaves what's shown now alone. Each custody load takes its own too, so an older
    // list (from before a preview or a transfer was recorded) doesn't land over a newer one.
    private readonly LoadSequence _showing = new();
    private LoadSequence.Ticket _shown;
    private readonly LoadSequence _custodyLoad = new();

    // BUG-578: a transfer typed and not recorded is asked about before the panel closes or moves on. CAP-08 (C7): so is
    // a collection edit changed and not saved.
    protected override void OnInitialized()
    {
        Edits.Track(this, "the transfer you're recording", () => _transferOpen
            && (!string.IsNullOrWhiteSpace(_xferTo) || !string.IsNullOrWhiteSpace(_xferHow) || !string.IsNullOrWhiteSpace(_xferWhy)), Region);
        Edits.Track(this, "how the file was collected", () => _collEditing && CollectionDirty, Region);
        Edits.Track(this, "why the file is being withdrawn", () => _withdrawOpen && !string.IsNullOrWhiteSpace(_withdrawReason), Region);   // CAP-21
    }

    // CAP-21: withdrawing the file, with the record's row hash when the form opened (a colleague's change meanwhile is
    // refused, as a retraction's is).
    private bool _withdrawOpen, _withdrawBusy;
    private string? _withdrawReason, _withdrawError, _withdrawStamp;

    private void StartWithdraw(Evidence ev)
    {
        if (_withdrawOpen) return;   // C7: what's typed stays
        (_withdrawOpen, _withdrawReason, _withdrawError, _withdrawStamp, _moveIt, _moveTo) = (true, null, null, ev.RowHash ?? "", false, null);
    }

    // Moving instead of only withdrawing, and to which case.
    private bool _moveIt;
    private string? _moveTo;

    private int WindowDays => IncidentManager.Application.Evidence.EvidenceWithdrawal.WindowDays(EvidenceOptions.CurrentValue);

    private DateTimeOffset? ReinstatableUntil(Evidence ev) => IncidentManager.Application.Evidence.EvidenceWithdrawal.ReinstatableUntil(ev, WindowDays);

    private string ReinstateNote => WindowDays > 0
        ? $"It can be put back within {WindowDays} day{(WindowDays == 1 ? "" : "s")}; after that the withdrawal is final."
        : "It can't be undone.";

    private bool _reinstateOpen, _reinstateBusy;
    private string? _reinstateReason, _reinstateError, _reinstateStamp;

    private void StartReinstate(Evidence ev) =>
        (_reinstateOpen, _reinstateReason, _reinstateError, _reinstateStamp) = (true, null, null, ev.RowHash ?? "");

    private async Task SaveReinstate(Evidence ev)
    {
        if (_reinstateBusy || string.IsNullOrWhiteSpace(_reinstateReason)) return;
        var shown = _shown;
        _reinstateBusy = true;
        _reinstateError = null;
        try
        {
            await Cases.ReinstateEvidenceAsync(Case.Id, ev.Id, _reinstateReason.Trim(), _reinstateStamp);
            Toasts.Success("File reinstated. It's on the case's record again.");
            if (!_showing.IsCurrent(shown)) return;
            (_reinstateOpen, _reinstateReason) = (false, null);
            await OnChanged.InvokeAsync();
            await LoadCustody(ev.Id);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException or StaleEditException or ConcurrentEditException)
        {
            var problem = ex is ConcurrentEditException ? "Someone changed this case meanwhile, so the file wasn't reinstated. Try again." : ex.Message;
            if (_showing.IsCurrent(shown)) _reinstateError = problem; else Toasts.Error(problem);
            if (ex is StaleEditException or ConcurrentEditException) await OnChanged.InvokeAsync();
            if (File is { } now && now.Id == ev.Id) _reinstateStamp = now.RowHash ?? "";
        }
        finally { _reinstateBusy = false; }
    }

    private void CancelWithdraw() => (_withdrawOpen, _withdrawError) = (false, null);

    private async Task SaveWithdraw(Evidence ev)
    {
        if (_withdrawBusy || string.IsNullOrWhiteSpace(_withdrawReason)) return;   // C8
        var shown = _shown;
        _withdrawError = null;
        _withdrawBusy = true;
        try
        {
            if (_moveIt)
            {
                var to = (_moveTo ?? "").Trim();
                await Cases.MoveEvidenceAsync(Case.Id, ev.Id, to, _withdrawReason.Trim(), _withdrawStamp);
                Toasts.Success($"File moved to {to}, and withdrawn here. Both chains of custody say so.");
            }
            else
            {
                await Cases.WithdrawEvidenceAsync(Case.Id, ev.Id, _withdrawReason.Trim(), _withdrawStamp);
                Toasts.Success("File withdrawn. It stays in the chain of custody and the audit trail.");
            }
            if (!_showing.IsCurrent(shown)) return;   // BUG-601: the panel moved on meanwhile
            (_withdrawOpen, _withdrawReason) = (false, null);
            await OnChanged.InvokeAsync();
            await LoadCustody(ev.Id);
        }
        catch (StaleEditException ex)
        {
            // The form stays open with the reason, expecting what's there now, so withdrawing again is a knowing choice.
            if (!_showing.IsCurrent(shown)) { Toasts.Error(ex.Message); return; }
            _withdrawError = ex.Message;
            await OnChanged.InvokeAsync();
            if (File is { } now && now.Id == ev.Id) _withdrawStamp = now.RowHash ?? "";
        }
        catch (ConcurrentEditException)
        {
            // CAP-21 review: the case changed while the withdrawal was checked (a notice or an entry may name the file now, or
            // a colleague withdrew it). Nothing was saved; the form stays open with the reason, on the case as it is now.
            const string problem = "Someone changed this case while the file was being withdrawn, so it wasn't withdrawn. " +
                "Check whether a notice or a timeline entry names it now, then withdraw it again if it's still needed.";
            if (!_showing.IsCurrent(shown)) { Toasts.Error(problem); return; }
            _withdrawError = problem;
            await OnChanged.InvokeAsync();
            if (File is { } now && now.Id == ev.Id) _withdrawStamp = now.RowHash ?? "";
        }
        catch (Exception ex)
        {
            var problem = UserFacingError.Describe(ex, Logger, "withdrawing evidence", "Couldn't withdraw the file. Try again.");
            if (_showing.IsCurrent(shown)) _withdrawError = problem;
            else Toasts.Error(problem);
        }
        finally { _withdrawBusy = false; }
    }

    // CAP-08: the collection being edited, with what it was when the edit opened (the stamp the save sends, so a
    // colleague's correction meanwhile isn't overwritten) and the time as shown (kept as recorded when left alone, C3).
    private bool _collEditing, _collBusy;
    private DateTime? _collAt, _collAtShown;
    private string? _collFrom, _collBy, _collError;
    private EvidenceCollection _collOpenedWith = EvidenceCollection.None;

    private void StartCollection(Evidence ev)
    {
        _collOpenedWith = EvidenceCollection.Of(ev);
        _collAt = _collAtShown = ev.CollectedAtUtc is { } at ? WallClock.ToMinute(WallClock.ToWall(at, TimeDisp.Zone)) : null;
        (_collFrom, _collBy, _collError) = (ev.CollectedFrom, ev.CollectedBy, null);
        _collEditing = true;
    }

    private DateTimeOffset? CollectedAtUtc() => _collAt is { } typed
        ? WallClock.Kept(typed, _collAtShown, _collOpenedWith.AtUtc, TimeDisp.Zone)
        : null;

    private bool CollectionDirty =>
        CollectedAtUtc() != _collOpenedWith.AtUtc
        || !string.Equals((_collFrom ?? "").Trim(), _collOpenedWith.From ?? "", StringComparison.Ordinal)
        || !string.Equals((_collBy ?? "").Trim(), _collOpenedWith.By ?? "", StringComparison.Ordinal);

    private async Task SaveCollection(Evidence ev)
    {
        if (_collBusy) return;   // C8
        var shown = _shown;
        _collError = null;
        _collBusy = true;
        try
        {
            var changed = await Cases.RecordEvidenceCollectionAsync(Case.Id, ev.Id,
                new EvidenceCollection(CollectedAtUtc(), _collFrom, _collBy), _collOpenedWith);
            if (!_showing.IsCurrent(shown)) return;   // BUG-601: the panel moved on meanwhile
            _collEditing = false;
            if (changed)
            {
                Toasts.Success("Collection recorded. The change is in the audit trail.");
                await OnChanged.InvokeAsync();
            }
        }
        catch (StaleEditException ex)
        {
            // As a verdict's refusal (CAP-02): the edit stays open with what was typed, and expects what's there now, so
            // saving again records it knowingly over the colleague's change.
            if (!_showing.IsCurrent(shown)) { Toasts.Error(ex.Message); return; }
            _collError = ex.Message;
            await OnChanged.InvokeAsync();
            if (File is { } now && now.Id == ev.Id) _collOpenedWith = EvidenceCollection.Of(now);
        }
        catch (Exception ex)
        {
            var problem = UserFacingError.Describe(ex, Logger, "recording how evidence was collected", "Couldn't save how it was collected. Try again.");
            if (_showing.IsCurrent(shown)) _collError = problem;
            else Toasts.Error(problem);
        }
        finally { _collBusy = false; }
    }

    public void Dispose() => Edits.Forget(this);

    protected override async Task OnParametersSetAsync()
    {
        if (EvidenceId == _loadedFor) return;
        _loadedFor = EvidenceId;
        _shown = _showing.Begin();
        _custodyLoad.Invalidate();
        _custody = null;
        _preview = null;
        _previewLoading = _previewMissing = _addingTask = _transferOpen = _collEditing = _withdrawOpen = _reinstateOpen = _moveIt = false;
        _reinstateReason = _reinstateError = _moveTo = null;
        _xferTo = _xferHow = _xferWhy = _xferError = _collError = _withdrawReason = _withdrawError = null;
        if (EvidenceId is { } id) await LoadCustody(id);
    }

    // BUG-342: after each await, a result for an item the panel has since moved off is dropped.
    private async Task LoadCustody(Guid id)
    {
        var t = _custodyLoad.Begin();
        List<ChainOfCustodyEvent> custody;
        try { custody = await Evidence.GetCustodyAsync(id); }
        catch (Exception ex) when (ex is InvalidOperationException) { custody = []; }
        if (_custodyLoad.IsCurrent(t)) _custody = custody;
    }

    private async Task LoadPreview(Evidence ev)
    {
        if (_previewLoading) return;   // BUG-603: one look records one "Viewed"
        var shown = _shown;
        _previewLoading = true;
        try
        {
            var preview = await Evidence.PreviewTextAsync(ev.Id);
            if (!_showing.IsCurrent(shown)) return;   // BUG-342
            _preview = preview;
            _previewMissing = preview is null;
            await LoadCustody(ev.Id);   // the view was just recorded
        }
        catch (Exception ex)
        {
            Toasts.Error(UserFacingError.Describe(ex, Logger, "previewing evidence", "Couldn't show the preview. Try again."));
        }
        finally { if (_showing.IsCurrent(shown)) _previewLoading = false; }
    }

    private async Task SaveTransfer(Evidence ev)
    {
        if (_xferBusy) return;
        var shown = _shown;
        _xferError = null;
        _xferBusy = true;
        try
        {
            await Evidence.RecordTransferAsync(ev.Id, _xferTo ?? "", _xferHow, _xferWhy ?? "");
            Toasts.Success("Transfer recorded in the chain of custody");
            // BUG-601: the panel moved to another file meanwhile: its transfer form isn't this save's to close.
            if (!_showing.IsCurrent(shown)) return;
            _transferOpen = false;
            _xferTo = _xferHow = _xferWhy = null;   // disabled while it saved, so nothing typed since
            await LoadCustody(ev.Id);
        }
        catch (Exception ex)
        {
            var problem = UserFacingError.Describe(ex, Logger, "recording an evidence transfer", "Couldn't record the transfer. Try again.");
            if (_showing.IsCurrent(shown)) _xferError = problem;
            else Toasts.Error(problem);
        }
        finally { _xferBusy = false; }
    }

    // What relies on the file: current timeline entries that cite it (or show it as their screenshot), and the brief.
    private List<(string Label, string Text, Guid? EntryId)> CitedBy(Evidence ev)
    {
        var list = new List<(string, string, Guid?)>();
        var cited = Case.Citations.Where(c => c.EvidenceId == ev.Id).Select(c => c.TimelineEntryId).ToHashSet();
        foreach (var e in Case.TimelineEntries.Where(t => t.IsCurrent && (cited.Contains(t.Id) || t.EvidenceId == ev.Id)).OrderBy(t => t.OccurredAtUtc))
        {
            var kind = e.Kind == TimelineKind.Event ? "Attack step" : e.Type == TimelineEntryType.Decision ? "Decision" : Ui.Label(e.Type);
            list.Add(($"{kind}, {TimeDisp.Brief(e.OccurredAtUtc, Clock.UtcNow)}", Snippet(e.Description), e.Id));
        }
        var brief = Case.Briefs.FirstOrDefault(b => b.IsCurrent);
        if (new[] { Case.Summary, brief?.WorkingAssessment, brief?.Known, brief?.OpenQuestions }
                .Any(p => p?.Contains($"evidence:{ev.Id}", StringComparison.OrdinalIgnoreCase) == true))
            list.Add(("Brief", $"The brief (v{brief?.Version ?? 1})", null));
        return list;
    }

    private async Task Go(Guid? entryId) => await OnShowCitation.InvokeAsync(entryId);

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await OnClose.InvokeAsync();
    }

    private string Snippet(string markdown)
    {
        var text = Md.ToPlainText(markdown).Replace('\n', ' ').Trim();
        return IncidentManager.Application.Common.TextFit.Cap(text, 110);
    }

    private static bool IsImage(Evidence ev) => ev.ContentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.0} MB",
        >= 1024 => $"{bytes / 1024.0:0.0} KB",
        _ => $"{bytes} B"
    };
}
