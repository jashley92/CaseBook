@* Case workspace — Entities tab (UX-13, interwoven pass). Artifacts / IOCs and their relationships, an
   interactive vis-network graph (with the attack-step overlay), cross-case "also in" overlaps, defang view,
   and VirusTotal / STIX deep-links. This tab OWNS the graph interop: it renders vis-network in its own
   OnAfterRenderAsync, holds its own DotNetObjectReference for the node-drag callback ([JSInvokable]
   OnNodesMoved), and destroys the graph on dispose. Cross-tab concerns are threaded in: the shared confirm
   dialog (RequestConfirm → parent AskConfirm), the live-collab flash (delegates), a Reload after a write
   (OnChanged), and a RefreshToken (bumped on collaborator changes) to re-pull the overlap map. Ctrl+Enter
   adds an entity via SubmitAsync (@ref). *@
@implements IAsyncDisposable
@inject CaseService Cases
@inject IncidentManager.Application.Accounts.AccountDirectoryService AccountDirectory
@inject IConfiguration Config
@inject ToastService Toasts
@inject IJSRuntime JS
@inject TimeDisplay TimeDisp
@inject IClock Clock
@inject UnsavedEdits Edits

<p class="text-muted small">
    Accounts, hosts, IPs, domains, URLs, file hashes and other indicators tied to this case, and how they relate.
</p>

@* PROD-40: mid-investigation correlation. When this case shares indicators with other OPEN cases that aren't
   already linked, suggest relating them — surface only; a human decides whether (and how) to link. *@
@if (CanEdit && _related.Count > 0 && !_relatedDismissed)
{
    <div class="card mb-3 border-info">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><span class="bi bi-diagram-3 me-1" aria-hidden="true"></span>Possibly related open cases</span>
            <button class="btn btn-sm btn-link p-0 text-muted" @onclick="() => _relatedDismissed = true" title="Hide until the next indicator is added">Dismiss</button>
        </div>
        <div class="card-body">
            <p class="text-muted small mb-2">
                These open cases share indicators with this one. Nothing is linked automatically, so link any that are related.
            </p>
            <ul class="list-unstyled mb-0">
                @foreach (var r in _related)
                {
                    <li class="d-flex flex-wrap align-items-center gap-2 py-2 border-top">
                        <a href="cases/@r.CaseId" class="fw-semibold text-decoration-none"><span class="im-casenum">@r.CaseNumber</span></a>
                        <span>@r.Title</span>
                        <span class="text-nowrap"><RungMark Value="r.Classification" /></span>
                        <span class="text-muted small">shares:</span>
                        @foreach (var ind in r.SharedIndicators.Take(6))
                        {
                            <code class="small im-badge im-b-neutral">@ind</code>
                        }
                        @if (r.SharedIndicators.Count > 6)
                        {
                            <span class="text-muted small">+@(r.SharedIndicators.Count - 6) more</span>
                        }
                        @* BUG-425: Ctrl/Cmd+Enter in the suggestion's controls links it (keymap.js leaves .im-own-keys to it); not on
                           the case-number link, where it opens the case in a new tab as a link should. *@
                        <span class="ms-auto d-flex align-items-center gap-1 im-own-keys" @onkeydown='e => SaveOnKey(e, () => LinkRelated(r.CaseId))'>
                            <select class="form-select form-select-sm" style="width:auto" aria-label="Relationship type"
                                    @onchange="e => SetRelatedType(r.CaseId, e.Value?.ToString())">
                                @foreach (var t in Enum.GetValues<CaseLinkType>())
                                {
                                    <option value="@t" selected="@(RelatedTypeFor(r.CaseId) == t)">@Ui.CaseLinkLabel(t, true)</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => LinkRelated(r.CaseId)">Link</button>
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
}

<AuthorizeView Policy="@Policies.EditCases">
    <div class="card mb-3 @(EditingId is not null ? "border-primary" : "")">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@(EditingId is null ? "Add entity / IOC" : "Edit entity / IOC")</span>
            @if (EditingId is not null)
            {
                <span class="small text-muted"><span class="bi bi-pencil-square" aria-hidden="true"></span> Changes are recorded in the audit trail.</span>
            }
        </div>
        <div class="card-body row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small mb-0" for="ent-type">Type</label>
                <select id="ent-type" class="form-select form-select-sm" @bind="_enType" @bind:after="() => _enTypePicked = true">
                    @foreach (var t in Ui.Options<EntityType>("EntityType"))
                    {
                        <option value="@t">@Ui.Label(t)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-0" for="ent-value">Value</label>
                <input id="ent-value" class="form-control form-control-sm" @bind="_enValue" @bind:event="oninput" @bind:after="ValueTyped" @onkeydown="OnValueKey" placeholder="e.g. 203.0.113.66, CONTOSO\jdoe or a command line" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0" for="ent-label">Label</label>
                <input id="ent-label" class="form-control form-control-sm" @bind="_enLabel" @bind:event="oninput" placeholder="Optional" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0" for="ent-disposition">Disposition</label>
                <select id="ent-disposition" class="form-select form-select-sm" @bind="_enDisposition">
                    @foreach (var d in Ui.Options<EntityDisposition>("EntityDisposition"))
                    {
                        <option value="@d">@Ui.Label(d)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-0" for="ent-source">Source</label>
                <input id="ent-source" class="form-control form-control-sm" @bind="_enSource" @bind:event="oninput" placeholder="@($"{DetectionLabel}…")" />
            </div>
            @if (EditingId is null)
            {
                <div class="col-md-1">
                    <button class="btn btn-sm btn-primary w-100" title="Ctrl / ⌘ + Enter" @onclick="SubmitComposer" disabled="@string.IsNullOrWhiteSpace(_enValue)">Add</button>
                </div>
            }
            <div class="col-md-9">
                <input class="form-control form-control-sm" aria-label="Description or context" @bind="_enDescription" @bind:event="oninput" placeholder="Description / context (optional)" />
            </div>
            @* PROD-45: an optional TLP marking for sharing this indicator; blank = the report's marking applies. *@
            <div class="col-md-3">
                <select class="form-select form-select-sm" @bind="_enTlp" aria-label="TLP sharing marking" title="TLP sharing marking for this indicator">
                    <option value="">TLP: same as report</option>
                    @foreach (var t in Enum.GetValues<TlpLevel>())
                    {
                        <option value="@t">@Tlp.Label(t)</option>
                    }
                </select>
            </div>
            @if (EditingId is not null)
            {
                <div class="col-md-6">
                    @* HR-05: a verdict raised to Malicious or Compromised is a finding, so it needs a one-line why. *@
                    <label class="form-label small mb-0" for="ent-reason">@(VerdictNeedsReason ? "Why is it " + Ui.Label(_enDisposition).ToLowerInvariant() + "?" : "Reason for change") <span class="text-muted">@(VerdictNeedsReason ? "(required; kept with the verdict on the timeline)" : "(optional)")</span></label>
                    <input id="ent-reason" class="form-control form-control-sm" maxlength="2000" @bind="_enReason" @bind:event="oninput" placeholder="e.g. re-assessed as benign after review" />
                </div>
                @if (VerdictChanging)
                {
                    @* BUG-414: when the new verdict was actually reached. *@
                    <div class="col-md-6">
                        <DeterminedAt Id="ent-determined" @bind-Value="_enDeterminedWall" />
                    </div>
                }
                <div class="col-md-6 d-flex justify-content-end align-items-end gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEntityEdit">Cancel</button>
                    <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="SubmitComposer" disabled="@string.IsNullOrWhiteSpace(_enValue)">
                        <span class="bi bi-check-lg" aria-hidden="true"></span> Save changes
                    </button>
                </div>
            }
            @if (_entityError is not null) { <div class="col-12"><div class="text-danger small">@_entityError</div></div> }
        </div>
    </div>

    @* PROD-22: bulk indicator paste. SOC receives IOCs in blocks; parse → refang → auto-type → review → one write. *@
    @if (EditingId is null)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><span class="bi bi-clipboard-plus" aria-hidden="true"></span> Paste indicators</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleBulk">
                    @(_bulkOpen ? "Close" : "Open")
                </button>
            </div>
            @if (_bulkOpen)
            {
                <div class="card-body">
                    <p class="text-muted small mb-2">
                        Paste IOCs one per line, or separated by commas or semicolons. Defanged values
                        (<code>hxxp</code>, <code>[.]</code>) are refanged, types are detected and duplicates dropped.
                        A value ending in a file extension (<code>svchost.exe</code>, <code>invoice.docm</code>) is read as a
                        file name; pick Domain in the list for the rare domain that ends that way.
                        Review the list, then add them in one step. For a STIX 2.1 bundle or IOC CSV file,
                        <a href="@($"cases/import?into={CaseId}")">import it into this case</a> instead.
                    </p>
                    @* BUG-425: Ctrl/Cmd+Enter in the pasted text parses it; in the review below it adds the selected ones.
                       BUG-449: the text fields here bind on input, so the key reads what was just typed. *@
                    <div class="im-own-keys" @onkeydown="e => SaveOnKey(e, ParseBulkOnKey)">
                    <textarea class="form-control form-control-sm mb-2" rows="4" aria-label="Paste indicators" @bind="_bulkText" @bind:event="oninput"
                              placeholder="1.2.3.4, evil.example[.]com&#10;hxxp://bad[.]site/x&#10;44d88612fea8a8f36de82e1278abb02f&#10;user@phish.example"></textarea>
                    <div class="d-flex gap-2 mb-2">
                        <button class="btn btn-sm btn-outline-primary" title="Ctrl / ⌘ + Enter" @onclick="ParseBulk"
                                disabled="@string.IsNullOrWhiteSpace(_bulkText)">Parse &amp; preview</button>
                        @if (_bulkRows.Count > 0)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearBulk">Clear</button>
                        }
                    </div>
                    </div>

                    @if (_bulkParsedEmpty)
                    {
                        <div class="text-muted small">No indicators found in that text.</div>
                    }

                    @if (_bulkRows.Count > 0)
                    {
                        <div class="im-own-keys" @onkeydown="e => SaveOnKey(e, AddBulk)">
                        <div class="row g-2 align-items-end mb-2">
                            <div class="col-md-3">
                                <label class="form-label small mb-0" for="ent-bulk-disposition">Disposition (all)</label>
                                <select id="ent-bulk-disposition" class="form-select form-select-sm" @bind="_bulkDisposition">
                                    @foreach (var d in Ui.Options<EntityDisposition>("EntityDisposition"))
                                    {
                                        <option value="@d">@Ui.Label(d)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-0" for="ent-bulk-source">Source (all)</label>
                                <input id="ent-bulk-source" class="form-control form-control-sm" @bind="_bulkSource" @bind:event="oninput" placeholder="@($"{DetectionLabel}…")" />
                            </div>
                            <div class="col-md-6 text-md-end">
                                <span class="small text-muted me-2">@_bulkRows.Count(r => r.Include) of @_bulkRows.Count selected</span>
                                <button class="btn btn-sm btn-link p-0 me-2" @onclick="() => SetAllBulk(true)">Select all</button>
                                <button class="btn btn-sm btn-link p-0" @onclick="() => SetAllBulk(false)">Select none</button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-2">
                                <thead><tr><th style="width:2rem"></th><th style="width:11rem">Type</th><th>Value</th></tr></thead>
                                <tbody>
                                    @foreach (var r in _bulkRows)
                                    {
                                        <tr class="@(r.Include ? "" : "text-muted")">
                                            <td><input class="form-check-input" type="checkbox" aria-label="Include @r.Value" @bind="r.Include" /></td>
                                            <td>
                                                <select class="form-select form-select-sm" aria-label="Type for @r.Value" @bind="r.Type">
                                                    @foreach (var t in Ui.Options<EntityType>("EntityType"))
                                                    {
                                                        <option value="@t">@Ui.Label(t)</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                <code class="small">@r.Value</code>
                                                @if (r.Type == EntityType.Other)
                                                {
                                                    <span class="im-badge im-b-warn ms-1" title="Type not detected. Pick one or leave it as Other.">Check type</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="AddBulk"
                                disabled="@(_bulkBusy || !_bulkRows.Any(r => r.Include))">
                            @if (_bulkBusy) { <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> }
                            Add @_bulkRows.Count(r => r.Include) indicator(s)
                        </button>
                        @if (_bulkError is not null) { <span class="text-danger small ms-2">@_bulkError</span> }
                        </div>
                    }
                </div>
            }
        </div>
    }
</AuthorizeView>

@if (Case.Entities.Count == 0)
{
    <p class="text-muted">No entities or IOCs yet.@(CanEdit ? " Add one above, or paste a block of indicators." : "")</p>
}
else
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="d-flex align-items-center gap-2">
                <span>Relationship graph</span>
                @* PROD-29: this case's own graph, or how it connects to other cases through shared indicators and links. *@
                <span class="seg" role="radiogroup" aria-label="Graph view">
                    <button type="button" class="seg-opt @(!_crossView ? "on" : "")" role="radio" aria-checked="@Ui.Aria(!_crossView)"
                            @onclick="() => SetCrossView(false)">This case</button>
                    <button type="button" class="seg-opt @(_crossView ? "on" : "")" role="radio" aria-checked="@Ui.Aria(_crossView)"
                            @onclick="() => SetCrossView(true)"
                            title="This case, the indicators it shares with other cases you can see, and its case links">Across cases</button>
                </span>
            </span>
            <div class="btn-group btn-group-sm">
                @if (!_crossView)
                {
                    <button class="btn @(_showAttackEdges ? "btn-primary" : "btn-outline-secondary")" @onclick="ToggleAttackEdges"
                            title="Show attack steps (actor → target) as dashed edges, colored by tactic">Attack steps</button>
                }
                <button class="btn btn-outline-secondary" @onclick="GraphFit" title="Fit graph to view">Fit</button>
                <button class="btn btn-outline-secondary" @onclick="GraphTogglePhysics">
                    @(_physicsOn ? "Freeze" : "Unfreeze")
                </button>
                <button class="btn btn-outline-secondary" @onclick="GraphRelayout" title="Re-run the force layout">Re-layout</button>
                <a class="btn btn-outline-secondary" href="cases/@CaseId/graph.stix.json"
                   title="Export the graph as a STIX 2.1 bundle to share with a partner or load into a TIP or XSIAM">
                    <span class="bi bi-box-arrow-up" aria-hidden="true"></span> STIX
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (_crossView && _overlaps.Count == 0 && _links.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-icon"><span class="bi bi-intersect" aria-hidden="true"></span></div>
                    <div class="empty-state-title">Not connected to other cases yet</div>
                    <div class="empty-state-msg">No indicators are shared with other cases you can see, and this case has no links.
                        Shared indicators and linked cases, including campaigns, appear here once recorded.</div>
                </div>
            }
            else
            {
                <div id="@ActiveGraphId" @key="ActiveGraphId" style="height:460px;border:1px solid var(--bs-border-color);border-radius:.375rem;background:var(--bs-body-bg);"></div>
            }
            @if (_crossView)
            {
                <div class="d-flex flex-wrap gap-3 mt-2 small text-muted align-items-center">
                    <span><span class="bi bi-square-fill" style="color:var(--im-accent-strong)" aria-hidden="true"></span> This case</span>
                    <span><span class="bi bi-square" aria-hidden="true"></span> Other cases</span>
                    <span>Indicators colored by disposition · dashed = case link (gold = campaign)</span>
                    <span class="ms-auto fst-italic">Read-only. Open other cases from the "also in" links below or from Related cases on the Overview tab.</span>
                </div>
            }
            else
            {
            <div class="d-flex flex-wrap gap-3 mt-2 small text-muted align-items-center">
                <span>Disposition:</span>
                @* UX-05: dots share one source of truth with the graph via Ui.DispositionColor(). *@
                @foreach (var d in new[] { EntityDisposition.Malicious, EntityDisposition.Compromised, EntityDisposition.Suspicious, EntityDisposition.Benign, EntityDisposition.Unknown })
                {
                    <span><span class="d-inline-block rounded-circle" style="width:10px;height:10px;background:@Ui.DispositionColor(d);"></span> @Ui.Label(d)</span>
                }
                <span class="ms-auto fst-italic">Drag nodes to arrange · scroll to zoom · drag background to pan</span>
            </div>
            }
        </div>
    </div>

    <div class="card mb-3 im-entity-list">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Entities (@Case.Entities.Count)</span>
            @* CAP-02: pick several, then record one verdict on all of them (each keeps its own history row and milestone). *@
            @if (CanEdit)
            {
                <span class="d-flex flex-wrap align-items-center gap-2 ms-md-auto me-md-2" role="group" aria-label="Selected entities">
                    @if (Case.Entities.Any(e => e.Disposition == EntityDisposition.Unknown))
                    {
                        <button type="button" class="btn btn-sm btn-link p-0" @onclick="PickUnknown"
                                title="Select every entity still marked Unknown">Select Unknown</button>
                    }
                    @if (_picked.Count > 0)
                    {
                        <span class="small text-muted" aria-live="polite">@_picked.Count selected</span>
                        <button type="button" class="btn btn-sm btn-link p-0" @onclick="_picked.Clear">Clear</button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="OpenAssess">Set verdict for @_picked.Count…</button>
                    }
                </span>
            }
            <span class="seg" role="radiogroup" aria-label="Indicator display"
                  title="Defanged shows network and URL indicators as hxxp://evil[.]com so they're safe to copy.">
                <button type="button" class="seg-opt @(!_defangView ? "on" : "")"
                        role="radio" aria-checked="@Ui.Aria(!_defangView)"
                        @onclick="() => _defangView = false">Live</button>
                <button type="button" class="seg-opt @(_defangView ? "on" : "")"
                        role="radio" aria-checked="@Ui.Aria(_defangView)"
                        @onclick="() => _defangView = true">Defanged</button>
            </span>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr>
                    @if (CanEdit)
                    {
                        <th style="width:2rem"><input class="form-check-input" type="checkbox" aria-label="Select all entities"
                                                      checked="@AllPicked" @onchange="e => PickAll((bool)(e.Value ?? false))" /></th>
                    }
                    <th>Type</th><th>Value</th><th>Label</th><th>Disposition</th><th>Source</th><th></th></tr></thead>
                <tbody>
                    @foreach (var e in Case.Entities.OrderBy(x => x.Type).ThenBy(x => x.Value))
                    {
                        <tr id="@RowId(e.Id)" class="im-enter @(FocusEntityId == e.Id ? "im-focus-row" : "") @FlashClass?.Invoke(e.Id)" style="@FlashStyle?.Invoke(e.Id)" @key="e.Id">
                            @if (CanEdit)
                            {
                                <td><input class="form-check-input" type="checkbox" aria-label="Select @Ui.Label(e.Type) @(e.Label ?? e.Value)"
                                           checked="@_picked.Contains(e.Id)" @onchange="ev => Pick(e.Id, e.Disposition, (bool)(ev.Value ?? false))" /></td>
                            }
                            <td class="text-nowrap">@Ui.EntityGlyph(e.Type) @Ui.Label(e.Type)</td>
                            <td class="im-entity-valuecell"><code class="small im-entity-value">@ValueWithBreaks(e)</code>
                                @if (!string.IsNullOrWhiteSpace(e.Description)) { <br /><small class="text-muted">@e.Description</small> }
                                @if (_overlaps.TryGetValue(e.Id, out var alsoIn) && alsoIn.Count > 0)
                                {
                                    <br />
                                    <small><span class="im-badge im-b-info">also in</span>
                                        @foreach (var o in alsoIn)
                                        {
                                            <a class="ms-1" href="cases/@o.OtherCaseId" title="@AlsoInTitle(o)"><span class="im-casenum small">@o.OtherCaseNumber</span></a>
                                        }
                                        @* PROD-10: pivot to every case carrying it (by id, so the value stays out of the URL). *@
                                        <a class="ms-2" href="intel/indicators?entity=@e.Id" title="Every case this indicator appears on">
                                            <span class="bi bi-crosshair" aria-hidden="true"></span> All cases
                                        </a>
                                    </small>
                                }
                            </td>
                            <td class="small">@(e.Label ?? "—")</td>
                            <td class="text-nowrap"><span class="@Ui.DispositionBadge(e.Disposition)">@Ui.Label(e.Disposition)</span>
                                @if (e.Tlp is { } tlp) { <span class="im-tlp im-tlp-sm ms-1" style="color:#@Tlp.Color(tlp)">@Tlp.Label(tlp)</span> }</td>
                            <td class="small text-muted">@(e.Source ?? "—")</td>
                            @* FR-60: the row's acts as one compact group; where the list is narrow they show as icons (the words
                               stay for screen readers and in each title), so the Value column keeps its room. *@
                            <td class="text-nowrap">
                                <div class="btn-group btn-group-sm im-ent-acts" role="group" aria-label="@($"Actions for {e.Label ?? e.Value}")">
                                    @{ var vtUrl = VirusTotalUrl(e); }
                                    @if (vtUrl is not null)
                                    {
                                        <a class="btn btn-outline-secondary" href="@vtUrl" target="_blank" rel="noopener noreferrer" title="Look it up on VirusTotal">
                                            <span class="bi bi-box-arrow-up-right" aria-hidden="true"></span><span class="im-ent-act-word">VirusTotal</span>
                                        </a>
                                    }
                                    <button type="button" class="btn btn-outline-secondary" @onclick="() => OnOpenEntity.InvokeAsync(e.Id)"
                                            title="Where it appears on this case and on others">
                                        <span class="bi bi-info-circle" aria-hidden="true"></span><span class="im-ent-act-word">Details</span>
                                    </button>
                                    <AuthorizeView Policy="@Policies.EditCases" Context="rm">
                                        <button type="button" class="btn btn-outline-secondary" title="Edit" @onclick="() => StartEntityEdit(e)">
                                            <span class="bi bi-pencil" aria-hidden="true"></span><span class="im-ent-act-word">Edit</span>
                                        </button>
                                        <button type="button" class="btn btn-outline-danger" title="Remove" @onclick='() => Confirm($"Remove entity {e.Value}? Its relationships are removed too. (An entity an attack step names as actor or target stays until the step changes.)", () => RemoveEntity(e.Id))'>
                                            <span class="bi bi-trash3" aria-hidden="true"></span><span class="im-ent-act-word">Remove</span>
                                        </button>
                                    </AuthorizeView>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <AuthorizeView Policy="@Policies.EditCases">
        @if (Case.Entities.Count >= 2)
        {
            <div class="card mb-3">
                <div class="card-header">Add relationship</div>
                @* BUG-425: Ctrl/Cmd+Enter here adds the relationship, not the entity composer's entity. *@
                <div class="card-body row g-2 align-items-end im-own-keys" @onkeydown="e => SaveOnKey(e, AddRelationship)">
                    <div class="col-md-4">
                        <label class="form-label small mb-0" for="ent-rel-source">Source</label>
                        <select id="ent-rel-source" class="form-select form-select-sm" @bind="_relSource">
                            <option value="">Select…</option>
                            @foreach (var e in Case.Entities.OrderBy(x => x.Type))
                            {
                                <option value="@e.Id" title="@e.Value">@EntityOption(e)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0" for="ent-rel-type">Relationship</label>
                        <select id="ent-rel-type" class="form-select form-select-sm" @bind="_relType">
                            @foreach (var t in Ui.Options<EntityRelationshipType>("EntityRelationshipType"))
                            {
                                <option value="@t">@Ui.Label(t)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-0" for="ent-rel-target">Target</label>
                        <select id="ent-rel-target" class="form-select form-select-sm" @bind="_relTarget">
                            <option value="">Select…</option>
                            @foreach (var e in Case.Entities.OrderBy(x => x.Type))
                            {
                                <option value="@e.Id" title="@e.Value">@EntityOption(e)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-sm btn-primary w-100" title="Ctrl / ⌘ + Enter" @onclick="AddRelationship"
                                disabled="@(string.IsNullOrEmpty(_relSource) || string.IsNullOrEmpty(_relTarget))">Add</button>
                    </div>
                    @if (_relError is not null) { <div class="col-12"><div class="text-danger small">@_relError</div></div> }
                </div>
            </div>
        }
    </AuthorizeView>

    @if (Case.EntityRelationships.Count > 0)
    {
        <div class="card">
            <div class="card-header">Relationships (@Case.EntityRelationships.Count)</div>
            <div class="card-body p-0">
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                        @foreach (var r in Case.EntityRelationships.OrderBy(x => x.CreatedAtUtc))
                        {
                            @if (_relEdit.IsOpenFor(r.Id))
                            {
                                @* INV-49: correct the type, description or direction in place — one audited change. BUG-425: its own
                                   Ctrl/Cmd+Enter saves it (BUG-449: the description binds on input, so what was just typed). *@
                                <tr class="im-own-keys" @onkeydown="e => SaveOnKey(e, SaveRelationship)">
                                    <td colspan="2">
                                        <div class="row g-2 align-items-end">
                                            <div class="col-md-4">
                                                <label class="form-label small mb-0" for="rel-edit-source">Source</label>
                                                <select id="rel-edit-source" class="form-select form-select-sm" @bind="_relEditSource">
                                                    @foreach (var e in Case.Entities.OrderBy(x => x.Type))
                                                    {
                                                        <option value="@e.Id" title="@e.Value">@EntityOption(e)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label small mb-0" for="rel-edit-type">Relationship</label>
                                                <select id="rel-edit-type" class="form-select form-select-sm" @bind="_relEditType">
                                                    @foreach (var t in Ui.Options<EntityRelationshipType>("EntityRelationshipType"))
                                                    {
                                                        <option value="@t">@Ui.Label(t)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="form-label small mb-0" for="rel-edit-target">Target</label>
                                                <select id="rel-edit-target" class="form-select form-select-sm" @bind="_relEditTarget">
                                                    @foreach (var e in Case.Entities.OrderBy(x => x.Type))
                                                    {
                                                        <option value="@e.Id" title="@e.Value">@EntityOption(e)</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-1">
                                                <button type="button" class="btn btn-sm btn-outline-secondary w-100" title="Swap source and target"
                                                        aria-label="Swap source and target" @onclick="SwapRelationship">
                                                    <span class="bi bi-arrow-left-right" aria-hidden="true"></span>
                                                </button>
                                            </div>
                                            <div class="col-md-9">
                                                <label class="visually-hidden" for="rel-edit-desc">Description</label>
                                                <input id="rel-edit-desc" class="form-control form-control-sm" maxlength="1000" @bind="_relEditDescription" @bind:event="oninput"
                                                       placeholder="Description / context (optional)" />
                                            </div>
                                            <div class="col-md-3 d-flex gap-2 justify-content-end">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="_relEdit.Close">Cancel</button>
                                                <button type="button" class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="SaveRelationship">Save</button>
                                            </div>
                                            @if (_relEditError is not null) { <div class="col-12"><div class="text-danger small" role="alert">@_relEditError</div></div> }
                                        </div>
                                    </td>
                                </tr>
                                continue;
                            }
                            <tr>
                                <td>
                                    <span class="fw-semibold">@EntityName(r.SourceEntityId)</span>
                                    <span class="text-muted">@Ui.Label(r.Type)</span>
                                    <span class="fw-semibold">@EntityName(r.TargetEntityId)</span>
                                    @if (!string.IsNullOrWhiteSpace(r.Description)) { <br /><small class="text-muted">@r.Description</small> }
                                </td>
                                <td class="text-end">
                                    <AuthorizeView Policy="@Policies.EditCases" Context="rm">
                                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => BeginEditRelationship(r)"
                                                aria-label="Edit this relationship">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick='() => Confirm("Remove this relationship?", () => RemoveRelationship(r.Id))'>Remove</button>
                                    </AuthorizeView>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (_assess is { } assessing)
{
    @* CAP-02: one verdict, one "when determined" and one reason for every selected entity; one audited save. Ctrl/Cmd+Enter
       records it (.im-own-keys), Escape closes it. *@
    <div class="modal d-block im-trap" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="ent-assess-title"
         style="background:var(--im-scrim)" @onclick="CancelAssess" @onkeydown="OnAssessKey">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-content im-own-keys" @onkeydown="e => SaveOnKey(e, SaveAssess)">
                <div class="modal-header">
                    <h5 class="modal-title" id="ent-assess-title">Set the verdict for @IncidentManager.Application.Common.Plural.Of(assessing.Count, "entity", "entities")</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelAssess"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">
                        Each entity that changes gets its own verdict record and timeline milestone, with this reason and time.
                        @if (AssessUnchanged is > 0 and var same)
                        {
                            <span>@IncidentManager.Application.Common.Plural.Of(same, "is", "are") already @Ui.Label(_assessDisposition) and stay as they are.</span>
                        }
                    </p>
                    <label class="form-label small mb-0" for="ent-assess-disposition">Verdict</label>
                    <select id="ent-assess-disposition" class="form-select form-select-sm mb-2" @bind="_assessDisposition">
                        @foreach (var d in Verdicts)
                        {
                            <option value="@d">@Ui.Label(d)</option>
                        }
                    </select>
                    <div class="mb-2"><DeterminedAt Id="ent-assess-determined" @bind-Value="_assessDeterminedWall" /></div>
                    <label class="form-label small mb-0" for="ent-assess-reason">@(AssessNeedsReason ? $"Why are they {Ui.Label(_assessDisposition).ToLowerInvariant()}?" : "Reason") <span class="text-muted">@(AssessNeedsReason ? "(required; kept with each verdict on the timeline)" : "(optional)")</span></label>
                    <textarea id="ent-assess-reason" class="form-control form-control-sm" rows="2" maxlength="2000"
                              placeholder="e.g. confirmed in the EDR triage of the phishing wave"
                              @bind="_assessReason" @bind:event="oninput"></textarea>
                    @if (_assessError is not null)
                    {
                        <p class="text-danger small mt-2 mb-0" role="alert">@_assessError</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelAssess">Cancel</button>
                    <button type="button" class="btn btn-primary" title="Ctrl / ⌘ + Enter" @onclick="SaveAssess"
                            disabled="@(_assessSaving || (AssessNeedsReason && string.IsNullOrWhiteSpace(_assessReason)))">
                        @if (_assessSaving) { <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> }
                        Record verdict
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public Case Case { get; set; } = null!;
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    /// <summary>Deep-link focus: when set (from an entity tag chip), scroll to and briefly highlight that row.</summary>
    [Parameter] public Guid? FocusEntityId { get; set; }
    /// <summary>INV-11: open an entity in the workspace's entity panel.</summary>
    [Parameter] public EventCallback<Guid> OnOpenEntity { get; set; }
    /// <summary>Reload the case after an entity/relationship write so the rest of the workspace refreshes.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Ask the parent's shared confirm dialog to guard a destructive action.</summary>
    [Parameter] public EventCallback<(string Message, string Verb, Func<Task> OnConfirm)> RequestConfirm { get; set; }
    /// <summary>Live-collab flash hooks (parent owns the flash state).</summary>
    [Parameter] public Func<Guid, string?>? FlashClass { get; set; }
    [Parameter] public Func<Guid, string?>? FlashStyle { get; set; }
    /// <summary>Bumped by the parent on a collaborator change, to re-pull the cross-case overlap map.</summary>
    [Parameter] public int RefreshToken { get; set; }

    // Entity add/edit form
    private EntityType _enType = EntityType.IpAddress;
    // BUG-416: until the type is picked by hand, it follows what's typed (an IP, DOMAIN\user, a command line…), and a
    // bare name the directory knows is an account.
    private bool _enTypePicked;
    private CancellationTokenSource? _accountCheck;
    private string _enValue = "";
    private string? _enLabel;
    private EntityDisposition _enDisposition = EntityDisposition.Suspicious;
    // BUG-484: the add form's verdict before an edit loaded an entity's. The next add used the edited one's (Malicious,
    // say), and WF-29 raised a matched Unknown entity to it without a reason.
    private EntityDisposition _enAddDisposition = EntityDisposition.Suspicious;
    private TlpLevel? _enTlp;   // PROD-45
    private TlpLevel? _enTlpAtOpen;   // BUG-234: what the editor showed, so a colleague's later marking isn't written back
    private string? _enStamp;         // BUG-234: the entity's row hash when the editor opened
    private string? _relEditStamp;
    private string? _enSource;
    private string? _enDescription;
    private string? _entityError;
    // Entity being corrected in place (none = add mode). BUG-578: one at a time; another row's Edit is refused, not
    // replaced, and so is one over an entity typed into the add form.
    private readonly EditSlot<Guid> _enEdit = new();
    private Guid? EditingId => _enEdit.Current?.Key;
    private string? _enSeed;   // BUG-578: the form as the edit opened it, so an untouched edit holds nothing up
    private bool VerdictNeedsReason => EditingId is { } eid && Case.Entities.FirstOrDefault(e => e.Id == eid) is { } was
        && was.Disposition != _enDisposition && _enDisposition is EntityDisposition.Malicious or EntityDisposition.Compromised;
    private string? _enReason;    // optional reason-for-change → audit trail
    // BUG-414: the verdict is changing in this edit, and when it was determined (null = now).
    private bool VerdictChanging => EditingId is { } vid && Case.Entities.FirstOrDefault(e => e.Id == vid) is { } before
        && before.Disposition != _enDisposition;
    private DateTime? _enDeterminedWall;

    // PROD-22: bulk indicator paste (parse → review → one write).
    private bool _bulkOpen;
    private string _bulkText = "";
    private bool _bulkParsedEmpty;
    private EntityDisposition _bulkDisposition = EntityDisposition.Suspicious;
    private string? _bulkSource;
    private bool _bulkBusy;
    private string? _bulkError;
    private readonly List<BulkRow> _bulkRows = new();

    // CAP-02: the entities picked for one verdict, and the dialog that records it. _assess is what the dialog opened with
    // (id → the verdict each showed when it was ticked), so a colleague's change since is refused rather than written over.
    // CAP-02 review (C9): the verdict is taken at the tick (EntityPicks), not at dialog open: a live refresh in between
    // reloaded the case, so the colleague's verdict was already what the dialog "saw" and the stale check passed.
    private readonly EntityPicks _picked = new();
    private Dictionary<Guid, EntityDisposition>? _assess;
    private EntityDisposition _assessDisposition = EntityDisposition.Benign;
    private DateTime? _assessDeterminedWall;
    private string? _assessReason;
    private string? _assessError;
    private bool _assessSaving;
    private bool _assessTrapArmed;
    private readonly InFlight _assessing = new();
    private bool AllPicked => Case.Entities.Count > 0 && Case.Entities.All(e => _picked.Contains(e.Id));
    private bool AssessNeedsReason => _assessDisposition is EntityDisposition.Malicious or EntityDisposition.Compromised
        && (AssessUnchanged ?? 0) < (_assess?.Count ?? 0);
    private int? AssessUnchanged => _assess?.Count(kv => kv.Value == _assessDisposition);

    /// <summary>CAP-02: the Closure gate's "Assess" link: select every entity still Unknown once the tab shows.</summary>
    [Parameter] public bool PickUnknownOnShow { get; set; }
    [Parameter] public EventCallback OnPickUnknownHandled { get; set; }

    private sealed class BulkRow
    {
        public bool Include { get; set; } = true;
        public EntityType Type { get; set; }
        public EntityType Detected { get; init; }   // BUG-506: what the parser found, before a hidden type was swapped
        public string Value { get; set; } = "";
    }

    // Relationship add form
    private string? _relSource;
    private EntityRelationshipType _relType = EntityRelationshipType.CommunicatedWith;
    private string? _relTarget;
    private string? _relError;

    // Cross-case "also in" overlaps (entity id → other cases sharing it).
    private Dictionary<Guid, IReadOnlyList<EntityOverlap>> _overlaps = new();
    // HR-03: what the other case is and how it ended, on hover; the entity panel shows it in full.
    private static string AlsoInTitle(EntityOverlap o) =>
        $"{o.OtherTitle} · {Ui.Label(o.OtherPhase)}"
        + (o.IsClosed && o.OutcomeKey is { } k ? $" · {IncidentManager.Application.Admin.CaseOutcomeCatalog.Label(k)}" : "")
        + $" · {Ui.Label(o.DispositionThere)} there"
        + (o.ClosingLine is { } line ? $" · {line}" : "");
    private int _loadedToken = int.MinValue;
    private int? _loadedEntities;   // BUG-254: the entity set the overlaps were computed for

    // PROD-40: mid-investigation correlation — visible OPEN cases sharing indicators, not yet linked.
    private IReadOnlyList<RelatedCaseSuggestion> _related = Array.Empty<RelatedCaseSuggestion>();
    private bool _relatedDismissed;
    private readonly Dictionary<Guid, CaseLinkType> _relatedType = new();

    // Defanged vs live indicator display.
    private bool _defangView;

    // Interactive graph (vis-network via JS interop) — owned by this tab.
    private string GraphContainerId => $"entity-graph-{CaseId}";
    private string CrossGraphId => $"cross-graph-{CaseId}";
    private string ActiveGraphId => _crossView ? CrossGraphId : GraphContainerId;

    // PROD-29: the cross-case view and the case links it draws.
    private bool _crossView;
    private IReadOnlyList<CaseLinkView> _links = [];
    private bool _physicsOn = true;
    private bool _showAttackEdges = true;   // overlay event steps as attack edges on the entity graph
    private bool _graphNeedsPush;
    private string? _lastGraphSig;
    private DotNetObjectReference<CaseEntitiesTab>? _graphRef;

    /// <summary>CAP-36: the detection source's name as the workspace resolves it (the case's team's, else the organization's).</summary>
    [Parameter] public string DetectionLabel { get; set; } = "SIEM";

    [CascadingParameter] public EditRegion? Region { get; set; }

    // BUG-578: what's typed in this tab's forms (compared with what each opened with) is asked about before a tab switch,
    // leaving the case or the time-display redraw hides it.
    private bool AddDirty => !string.IsNullOrWhiteSpace(_enValue) || !string.IsNullOrWhiteSpace(_enLabel)
        || !string.IsNullOrWhiteSpace(_enDescription) || !string.IsNullOrWhiteSpace(_enSource);
    private bool EditDirty => EditingId is not null
        && (EntityInput() != _enSeed || !string.IsNullOrWhiteSpace(_enReason) || _enDeterminedWall is not null);
    private string EntityInput() => string.Join("\u001f", _enType, _enValue, _enLabel, _enDisposition, _enSource, _enDescription, _enTlp);

    protected override void OnInitialized()
    {
        Edits.Track(this, "the entity you're adding", () => EditingId is null && AddDirty, Region);
        Edits.Track(this, "the entity you're editing", () => EditDirty, Region);
        Edits.Track(this, "the relationship you're editing", () => _relEdit.IsOpen && RelationshipInput() != _relEditSeed, Region);
        Edits.Track(this, "the indicators you pasted", () => _bulkOpen && (!string.IsNullOrWhiteSpace(_bulkText) || _bulkRows.Count > 0), Region);
        Edits.Track(this, "the verdict you're recording", () => _assess is not null && (!string.IsNullOrWhiteSpace(_assessReason) || _assessDeterminedWall is not null), Region);   // CAP-02
        _graphRef = DotNetObjectReference.Create(this);
        // BUG-506 (BUG-478 sibling): a default an admin has hidden showed nothing in its select while the save used it.
        _enType = OfferedOr(_enType, EntityTypes);
        _enDisposition = _enAddDisposition = OfferedOr(_enDisposition, Verdicts);
        _bulkDisposition = OfferedOr(_bulkDisposition, Verdicts);
        _relType = OfferedOr(_relType, Ui.Options<EntityRelationshipType>("EntityRelationshipType"));
    }

    private static IReadOnlyList<EntityType> EntityTypes => Ui.Options<EntityType>("EntityType");
    private static IReadOnlyList<EntityDisposition> Verdicts => Ui.Options<EntityDisposition>("EntityDisposition");

    /// <summary>BUG-506: the value wanted if the select offers it, else the first one it offers.</summary>
    public static T OfferedOr<T>(T wanted, IReadOnlyList<T> offered) where T : struct, Enum =>
        offered.Count == 0 || offered.Contains(wanted) ? wanted : offered[0];

    /// <summary>
    /// BUG-506: a detected entity type the select offers; else Other (the "not detected" type) if it's offered, else the
    /// current type, itself kept to one offered.
    /// </summary>
    public static EntityType DetectedOr(EntityType detected, EntityType current, IReadOnlyList<EntityType> offered) =>
        offered.Contains(detected) ? detected
        : offered.Contains(EntityType.Other) ? EntityType.Other
        : OfferedOr(current, offered);

    protected override async Task OnParametersSetAsync()
    {
        // BUG-578: a relationship a colleague removed takes its open edit with it (its row is gone), so another can open.
        if (_relEdit.Current is { } rel && Case.EntityRelationships.All(r => r.Id != rel.Key)) _relEdit.Close();
        // CAP-02: a removed entity leaves the selection (the open dialog keeps what it opened with, and the save refuses it).
        _picked.KeepOnly(Case.Entities.Select(e => e.Id));
        // Load overlaps on first mount and whenever the parent signals a live change.
        if (_loadedToken != RefreshToken)
        {
            _loadedToken = RefreshToken;
            // BUG-254: a live change elsewhere on the case (a note, a step) leaves its entities, and so the cross-case
            // correlation, as they were: two table scans per viewer per colleague's save otherwise.
            var entities = EntitySignature();
            if (entities != _loadedEntities)
            {
                _loadedEntities = entities;
                await LoadOverlaps();
                await LoadRelated();
            }
            await LoadLinks();
        }
        if (PickUnknownOnShow)
        {
            PickUnknown();
            await OnPickUnknownHandled.InvokeAsync();
        }
    }

    // BUG-601: loads that run side by side (a live refresh's, a save's) each take a ticket; only the newest one's lands.
    private readonly LoadSequence _linksLoad = new(), _overlapsLoad = new(), _relatedLoad = new();

    private async Task LoadLinks()
    {
        var t = _linksLoad.Begin();
        IReadOnlyList<CaseLinkView> links;
        try { links = await Cases.GetCaseLinksAsync(CaseId); } catch (InvalidOperationException) { links = []; }
        if (_linksLoad.IsCurrent(t)) _links = links;
    }

    private int EntitySignature()
    {
        var h = new HashCode();
        foreach (var e in Case.Entities.OrderBy(e => e.Id)) { h.Add(e.Id); h.Add(e.Type); h.Add(e.Value); }
        return h.ToHashCode();
    }

    private async Task LoadOverlaps()
    {
        var t = _overlapsLoad.Begin();
        var overlaps = (await Cases.FindEntityOverlapsAsync(CaseId))
            .GroupBy(o => o.EntityId)
            .ToDictionary(g => g.Key, g => (IReadOnlyList<EntityOverlap>)g.ToList());
        if (_overlapsLoad.IsCurrent(t)) _overlaps = overlaps;
    }

    // PROD-40: pull the visible open cases sharing indicators with this one (not already linked). Only
    // editors — who can act on it — see the suggestion.
    private async Task LoadRelated()
    {
        var t = _relatedLoad.Begin();
        if (!CanEdit) { _related = Array.Empty<RelatedCaseSuggestion>(); return; }
        var related = await Cases.FindRelatedOpenCasesAsync(CaseId);
        if (_relatedLoad.IsCurrent(t)) _related = related;
    }

    private CaseLinkType RelatedTypeFor(Guid caseId) =>
        _relatedType.TryGetValue(caseId, out var t) ? t : CaseLinkType.RelatedTo;

    private void SetRelatedType(Guid caseId, string? value)
    {
        if (IncidentManager.Domain.Common.EnumNames.TryParse<CaseLinkType>(value, out var t)) _relatedType[caseId] = t;   // BUG-592
    }

    private Task LinkRelated(Guid otherCaseId) => _linking.Run(() => LinkRelatedCore(otherCaseId));

    private async Task LinkRelatedCore(Guid otherCaseId)
    {
        try
        {
            var linkId = await Cases.LinkCaseAsync(CaseId, otherCaseId, RelatedTypeFor(otherCaseId),
                "Suggested from shared indicators");
            await OnChanged.InvokeAsync();   // refresh the case + the Overview "Related cases" list
            await LoadRelated();             // the now-linked case drops off the suggestions
            Toasts.Success(linkId is null ? "Those cases were already linked." : "Cases linked.");
        }
        catch (Exception ex) { Toasts.Error(ex.Message); }
    }

    private Task Confirm(string message, Func<Task> action, string verb = "Remove") => RequestConfirm.InvokeAsync((message, verb, action));

    private string DisplayValue(CaseEntity e) =>
        _defangView && IocObservable.IsRefangable(e.Type) ? IocObservable.Defang(e.Value) : e.Value;

    // FR-60: a long value may wrap only after a . @ / \ (a domain's labels, an address's halves, a path's parts), never
    // mid-token; an IP address never wraps at all ("203.0.113." over "45" read as two values).
    private RenderFragment ValueWithBreaks(CaseEntity e) => __builder =>
    {
        var v = DisplayValue(e);
        if (e.Type == EntityType.IpAddress)
        {
            <span class="text-nowrap">@v</span>
            return;
        }
        foreach (var part in BreakParts(v))
        {
            @part<wbr />
        }
    };

    // The value cut after each separator. A defanged dot ("[.]") stays whole: the break goes after its bracket.
    private static IEnumerable<string> BreakParts(string v)
    {
        var start = 0;
        for (var i = 0; i < v.Length; i++)
        {
            var sep = v[i] is '.' or '@' or '/' or '\\' or ']';
            if (!sep || (i + 1 < v.Length && v[i + 1] == ']')) continue;
            yield return v[start..(i + 1)];
            start = i + 1;
        }
        if (start < v.Length) yield return v[start..];
    }

    // BUG-425: the relationship forms, the paste and the suggestions each save themselves on Ctrl/Cmd+Enter (they're marked
    // .im-own-keys, which keymap.js leaves alone), as their buttons do; one save at a time per form (a paste waiting on the
    // directory doesn't hold up a relationship save), and a held key doesn't repeat. BUG-603: each handler runs through its
    // form's InFlight itself, so a double-click, Enter and a click, or two confirms don't write twice.
    private readonly InFlight _linking = new();
    private readonly InFlight _pasting = new();
    private readonly InFlight _relAdding = new();
    private readonly InFlight _relEditing = new();
    private readonly InFlight _removing = new();

    private Task SaveOnKey(KeyboardEventArgs e, Func<Task> save) =>
        e.Key != "Enter" || !(e.CtrlKey || e.MetaKey) || e.Repeat || !CanEdit ? Task.CompletedTask : save();

    private Task ParseBulkOnKey() => string.IsNullOrWhiteSpace(_bulkText) ? Task.CompletedTask : ParseBulk();

    /// <summary>Ctrl/⌘+Enter from the parent's hotkey dispatcher — add the entity in the composer, or save the edit.</summary>
    public async Task SubmitAsync()
    {
        if (_assess is not null) return;   // CAP-02: the verdict dialog has its own Ctrl/Cmd+Enter
        await SubmitComposer();
    }

    // Enter in the value adds the entity, like any one-line form (held Enter doesn't add it twice).
    private async Task OnValueKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || e.Repeat || e.CtrlKey || e.MetaKey) return;
        await SubmitComposer();
    }

    // BUG-330: Enter, Ctrl+Enter and the button do what the composer is showing: an edit is saved, never added as a
    // second entity. One at a time, so Enter and a click don't save twice.
    private bool _adding;
    private async Task SubmitComposer()
    {
        if (_adding) return;
        _adding = true;
        try
        {
            if (EditingId is null) await AddEntity();
            else await SaveEntityEdit();
        }
        finally { _adding = false; }
    }

    // BUG-416: the type follows the value until it's picked by hand (never while editing an existing one).
    private async Task ValueTyped()
    {
        if (EditingId is not null || _enTypePicked || string.IsNullOrWhiteSpace(_enValue)) return;
        // Sonar S6966/S2930: the earlier check is only cancelled here. The call that made it disposes it when it wakes
        // (finally, below), so its Task.Delay or directory call never runs on a disposed token.
        if (_accountCheck is { } earlier) { _accountCheck = null; await earlier.CancelAsync(); }
        var detected = IocObservable.DetectType(_enValue);
        _enType = DetectedOr(detected, _enType, EntityTypes);   // BUG-506
        if (detected != EntityType.Other || !AccountDirectory.IsAvailable || !EntityTypes.Contains(EntityType.Account)) return;
        // A bare name could be an account or a host: ask the directory once typing pauses.
        var cts = _accountCheck = new CancellationTokenSource();
        var value = _enValue;
        try
        {
            await Task.Delay(400, cts.Token);
            if (await AccountDirectory.IsKnownAccountAsync(value, cts.Token)
                && !cts.IsCancellationRequested && _enValue == value && !_enTypePicked && EditingId is null
                && EntityTypes.Contains(EntityType.Account))   // BUG-506: hidden meanwhile
                _enType = EntityType.Account;
        }
        catch (OperationCanceledException) { /* typed on */ }
        finally
        {
            if (ReferenceEquals(_accountCheck, cts)) _accountCheck = null;
            cts.Dispose();
        }
    }

    private async Task AddEntity()
    {
        if (EditingId is not null || string.IsNullOrWhiteSpace(_enValue)) return;   // BUG-330: the form is editing one
        _entityError = null;
        try
        {
            var addedVal = _enValue;
            var asked = _enDisposition;
            var (sentLabel, sentDescription, sentSource, sentTlp) = (_enLabel, _enDescription, _enSource, _enTlp);
            var r = await Cases.AddOrMatchEntityAsync(CaseId, _enType, addedVal, sentLabel, _enDisposition, sentDescription, sentSource);
            if (sentTlp is not null && !r.AlreadyOnCase) await Cases.SetEntityTlpAsync(CaseId, r.Id, sentTlp);   // PROD-45
            // BUG-601: the next indicator, typed or pasted while this one saved, stays in the form.
            if (EditingId is null)
            {
                _enValue = DraftText.ClearIfUnchanged(_enValue, addedVal);
                _enLabel = DraftText.ClearIfUnchanged(_enLabel, sentLabel, null);
                _enDescription = DraftText.ClearIfUnchanged(_enDescription, sentDescription, null);
                _enSource = DraftText.ClearIfUnchanged(_enSource, sentSource, null);
                if (_enValue.Length == 0)
                {
                    if (_enTlp == sentTlp) _enTlp = null;
                    _enTypePicked = false;   // BUG-416: the next value sets the type again
                }
            }
            await OnChanged.InvokeAsync();
            await LoadOverlaps(); // the new IOC may correlate with another case — surface "also in" now
            _relatedDismissed = false; // a new IOC may reveal a related case — re-surface the suggestion (PROD-40)
            await LoadRelated();
            // HR-04: adding one that's already here never overwrites its verdict, so say what the case kept.
            if (!r.AlreadyOnCase) Toasts.Success($"Added {addedVal}");
            else if (r.VerdictChanged)   // WF-29: an Unknown one takes the verdict it was added with
                Toasts.Info($"{addedVal} was already on this case as Unknown; it's now {Ui.Label(r.Disposition)}.");
            else if (r.Disposition != asked)
                Toasts.Warning($"{addedVal} is already on this case as {Ui.Label(r.Disposition)}. Its verdict wasn't changed; use Edit to change it.");
            else Toasts.Info($"{addedVal} is already on this case.");
        }
        catch (Exception ex) { _entityError = ex.Message; }
    }

    // --- CAP-02: one verdict on several entities ---
    // CAP-02 review (C9): each pick keeps the verdict shown when it was ticked.
    private void Pick(Guid entityId, EntityDisposition shown, bool on) => _picked.Set(entityId, shown, on);

    private void PickAll(bool on)
    {
        if (on) _picked.Replace(Case.Entities.Select(e => (e.Id, e.Disposition)));
        else _picked.Clear();
    }

    private void PickUnknown() =>
        _picked.Replace(Case.Entities.Where(e => e.Disposition == EntityDisposition.Unknown).Select(e => (e.Id, e.Disposition)));

    private void OpenAssess()
    {
        if (_picked.Count == 0 || _assess is not null) return;
        if (_picked.Count > CaseService.MaxEntitiesPerAssessment)
        {
            Toasts.Info($"Pick up to {CaseService.MaxEntitiesPerAssessment:N0} entities at a time.");
            return;
        }
        _assess = _picked.Snapshot();   // CAP-02 review (C9): what each showed when ticked, not what it shows now
        _assessDisposition = OfferedOr(_assessDisposition, Verdicts);   // BUG-506: the last one used, if the select offers it
        _assessDeterminedWall = null;   // BUG-414: now, unless set
        _assessReason = null;
        _assessError = null;
    }

    private void CancelAssess()
    {
        if (_assessSaving) return;   // the save in flight closes it
        _assess = null;
        _assessError = null;
    }

    private void OnAssessKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelAssess();
    }

    private Task SaveAssess() => _assessing.Run(SaveAssessCore);

    private async Task SaveAssessCore()
    {
        if (_assess is not { } seen || _assessSaving) return;
        _assessSaving = true;
        _assessError = null;
        try
        {
            var determined = DeterminedAt.UtcOf(_assessDeterminedWall, TimeDisp.Zone, Clock.UtcNow);   // BUG-414
            var verdict = _assessDisposition;
            var changed = await Cases.AssessEntitiesAsync(CaseId, seen.Keys.ToList(), verdict, _assessReason, seen, determined);
            _assess = null;
            _picked.Clear();
            await OnChanged.InvokeAsync();
            var plural = IncidentManager.Application.Common.Plural.Of;
            Toasts.Success(changed == 0 ? $"{(seen.Count == 1 ? "It was" : "They were all")} already {Ui.Label(verdict)}."
                : $"Recorded {Ui.Label(verdict)} on {plural(changed, "entity", "entities")}.");
        }
        catch (StaleEditException ex)
        {
            // CAP-02 review: the refusal is shown in the dialog, which stays open with the verdict, time and reason typed,
            // and the picks then expect what each shows now: saving again records theirs knowingly, over the colleague's.
            // (Before the live refresh lands, "now" is still the old verdict, so a second save is refused again, not lost.)
            _assessError = ex.Message;
            await OnChanged.InvokeAsync();
            if (Disposed || _assess is null) return;
            _picked.Rebase(Case.Entities.Select(e => (e.Id, e.Disposition)));
            _assess = _picked.Snapshot();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            _assessError = ex.Message;
        }
        finally { _assessSaving = false; }
    }

    // --- PROD-22: bulk indicator paste ---
    private void ToggleBulk() => _bulkOpen = !_bulkOpen;

    private Task ParseBulk() => _pasting.Run(ParseBulkCore);

    private async Task ParseBulkCore()
    {
        ParseBulkRows();
        // BUG-416: a bare name the directory knows is an account (at most 50 asked, so a big paste isn't held up).
        if (!AccountDirectory.IsAvailable || !EntityTypes.Contains(EntityType.Account)) return;   // BUG-506
        foreach (var row in _bulkRows.Where(r => r.Detected == EntityType.Other).Take(50).ToList())
            if (await AccountDirectory.IsKnownAccountAsync(row.Value)) row.Type = EntityType.Account;
    }

    private void ParseBulkRows()
    {
        _bulkError = null;
        _bulkRows.Clear();
        var types = EntityTypes;
        foreach (var p in IocObservable.ParseIndicators(_bulkText))   // BUG-506: a hidden type is shown as Other (Check type)
            _bulkRows.Add(new BulkRow { Type = DetectedOr(p.Type, EntityType.Other, types), Detected = p.Type, Value = p.Value });
        _bulkDisposition = OfferedOr(_bulkDisposition, Verdicts);   // BUG-506
        _bulkParsedEmpty = _bulkRows.Count == 0;
        // BUG-202: as many as an IOC file takes, so the list stays one a person can review.
        if (_bulkRows.Count > IncidentManager.Application.Import.CaseImportService.MaxEntities)
        {
            _bulkError = $"That's {_bulkRows.Count:N0} indicators; paste up to {IncidentManager.Application.Import.CaseImportService.MaxEntities:N0} " +
                         "at a time, or import them from a STIX bundle or IOC CSV file.";
            _bulkRows.Clear();
        }
    }

    private void ClearBulk()
    {
        _bulkText = "";
        _bulkRows.Clear();
        _bulkParsedEmpty = false;
        _bulkError = null;
    }

    private void SetAllBulk(bool include)
    {
        foreach (var r in _bulkRows) r.Include = include;
    }

    private Task AddBulk() => _pasting.Run(AddBulkCore);

    private async Task AddBulkCore()
    {
        var rows = _bulkRows.Where(r => r.Include).ToList();
        if (rows.Count == 0 || _bulkBusy) return;
        _bulkBusy = true;
        _bulkError = null;
        var added = 0;
        var existing = 0;
        try
        {
            // One case is a coherent cohort (like PROD-21's per-case task bulk), so no E-18 cross-case
            // metering applies here. AddEntity upserts by (type, value), so re-pasting is idempotent, and it
            // never overwrites a recorded verdict or detail (HR-04).
            // BUG-202: one load and one audited save per batch, not per indicator.
            var results = await Cases.AddOrMatchEntitiesAsync(CaseId,
                rows.Select(r => new CaseService.EntityToAdd(r.Type, r.Value, null, _bulkDisposition, null, _bulkSource)).ToList(),
                promotedReason: "Set by paste");
            existing = results.Count(r => r.AlreadyOnCase);
            var promoted = results.Count(r => r.VerdictChanged);
            added = results.Count - existing;
            ClearBulk();
            await OnChanged.InvokeAsync();
            await LoadOverlaps(); // pasted IOCs may correlate with other cases — refresh "also in"
            _relatedDismissed = false; // pasted IOCs may reveal related cases — re-surface the suggestion (PROD-40)
            await LoadRelated();
            var plural = IncidentManager.Application.Common.Plural.Of;
            // WF-29: say how many Unknown ones took the pasted verdict; the rest kept theirs.
            var kept = promoted == 0
                ? $"{plural(existing, "was", "were")} already on this case and kept {(existing == 1 ? "its" : "their")} verdict."
                : $"{plural(existing, "was", "were")} already on this case; {promoted} of them changed from Unknown to {Ui.Label(_bulkDisposition)}"
                  + (promoted < existing ? ", the rest kept their verdict." : ".");
            Toasts.Success(existing == 0 ? $"Added {plural(added, "indicator")}"
                : added == 0 ? (existing == 1 && promoted == 0 ? "That indicator was already on this case and kept its verdict." : $"All {kept}")
                : $"Added {plural(added, "indicator")}. {kept}");
        }
        catch (Exception ex)
        {
            _bulkError = added > 0 ? $"Added {added}, then stopped: {ex.Message}" : ex.Message;
        }
        finally { _bulkBusy = false; }
    }

    // Load an existing IOC into the composer to correct it in place.
    private void StartEntityEdit(CaseEntity e)
    {
        // BUG-578: what's typed into the add form, or another entity's edit, is kept: refused instead of re-seeded.
        if (EditingId is null && AddDirty) { Toasts.Info("Add or clear the entity you're typing, then try again."); return; }
        if (!_enEdit.TryOpen(e.Id, Toasts, "entity")) return;
        _enAddDisposition = _enDisposition;   // BUG-484: the add form's, put back when the edit ends
        _entityError = null;
        _enReason = null;
        _enType = e.Type;
        _enValue = e.Value;
        _enLabel = e.Label;
        _enDisposition = e.Disposition;
        _enSource = e.Source;
        _enDescription = e.Description;
        _enTlp = e.Tlp;
        _enTlpAtOpen = e.Tlp;
        _enStamp = e.RowHash ?? "";
        _enDeterminedWall = null;   // BUG-414: now, unless set
        _enSeed = EntityInput();
        _bringIntoView = ("imMotion.focusId", "ent-value");   // BUG-410
    }

    private void CancelEntityEdit()
    {
        if (EditingId is { } was) _bringIntoView = ("imMotion.scrollToId", RowId(was));   // BUG-410: back to the row
        _enEdit.Close(); _enReason = null; _entityError = null; _enTypePicked = false; _enDeterminedWall = null;
        _enValue = ""; _enLabel = null; _enDescription = null; _enSource = null; _enTlp = null;
        _enDisposition = OfferedOr(_enAddDisposition, Verdicts);   // BUG-484; BUG-506: to one the select offers
        _enType = OfferedOr(_enType, EntityTypes);   // BUG-506: an edited one's hidden type isn't the next add's
    }

    private async Task SaveEntityEdit()
    {
        if (_enEdit.Current is not { } editing || string.IsNullOrWhiteSpace(_enValue)) return;
        var id = editing.Key;
        _entityError = null;
        try
        {
            var tlp = _enTlp;   // read before the wait: a Cancel during it empties the form
            var tlpChanged = _enTlpAtOpen != tlp;   // BUG-234: changed in this editor, not just different from now
            var determined = VerdictChanging ? DeterminedAt.UtcOf(_enDeterminedWall, TimeDisp.Zone, Clock.UtcNow) : null;   // BUG-414
            await Cases.EditEntityAsync(CaseId, id, _enType, _enValue, _enLabel, _enDisposition, _enDescription, _enSource, _enReason,
                expectedStamp: _enStamp, determinedAtUtc: determined);
            if (tlpChanged) await Cases.SetEntityTlpAsync(CaseId, id, tlp);   // PROD-45
            // BUG-601: cancelled during the save (and the form since used to add one): what's in it now isn't this edit's.
            if (_enEdit.IsCurrent(editing)) CancelEntityEdit();
            await OnChanged.InvokeAsync();
            await LoadOverlaps(); // a changed value/type may change cross-case correlation
            _relatedDismissed = false; // a changed value may reveal/clear a related case (PROD-40)
            await LoadRelated();
            Toasts.Success("Entity updated");
        }
        catch (StaleEditException ex)
        {
            if (_enEdit.IsCurrent(editing)) CancelEntityEdit();
            Toasts.Error(ex.Message);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            if (_enEdit.IsCurrent(editing)) _entityError = ex.Message;
            else Toasts.Error(ex.Message);
        }
    }

    private Task RemoveEntity(Guid entityId) => _removing.Run(() => RemoveEntityCore(entityId));

    private async Task RemoveEntityCore(Guid entityId)
    {
        try { await Cases.RemoveEntityAsync(CaseId, entityId); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error($"Couldn't remove the entity. {ex.Message}"); return; }
        await OnChanged.InvokeAsync();
        await LoadOverlaps(); // keep the overlap map in sync with the current entity set
        await LoadRelated();  // a removed IOC may drop a correlation (don't un-dismiss on a removal)
        Toasts.Success("Entity removed");
    }

    /// <summary>Deep-link to a VirusTotal search for an IOC-like entity, or null when not applicable.</summary>
    private string? VirusTotalUrl(CaseEntity e)
    {
        if (!Ui.IsIocLike(e.Type) || string.IsNullOrWhiteSpace(e.Value)) return null;
        var template = Config["ExternalLinks:VirusTotalUrlTemplate"];
        return IncidentManager.Application.Content.LinkTemplate.Fill(template, e.Value);   // BUG-264
    }

    private Task AddRelationship() => _relAdding.Run(AddRelationshipCore);

    private async Task AddRelationshipCore()
    {
        _relError = null;
        var (sentSource, sentTarget) = (_relSource, _relTarget);
        if (!Guid.TryParse(sentSource, out var src) || !Guid.TryParse(sentTarget, out var tgt)) return;
        try
        {
            await Cases.LinkEntitiesAsync(CaseId, src, tgt, _relType, null);
            // BUG-601: a pick made while it saved is the next relationship's.
            _relSource = DraftText.ClearIfUnchanged(_relSource, sentSource, null);
            _relTarget = DraftText.ClearIfUnchanged(_relTarget, sentTarget, null);
            await OnChanged.InvokeAsync();
            Toasts.Success("Relationship added");
        }
        catch (Exception ex) { _relError = ex.Message; }
    }

    // INV-49: in-place relationship edit. BUG-578/601: one at a time (another row's Edit is refused, not replaced), and a
    // save closes only its own.
    private readonly EditSlot<Guid> _relEdit = new();
    private string? _relEditSource, _relEditTarget, _relEditDescription, _relEditError;
    private EntityRelationshipType _relEditType;
    private string? _relEditSeed;
    private string RelationshipInput() => string.Join("\u001f", _relEditSource, _relEditTarget, _relEditType, _relEditDescription);

    private void BeginEditRelationship(EntityRelationship r)
    {
        if (!_relEdit.TryOpen(r.Id, Toasts, "relationship")) return;
        _relEditSource = r.SourceEntityId.ToString();
        _relEditTarget = r.TargetEntityId.ToString();
        _relEditType = r.Type;
        _relEditDescription = r.Description;
        _relEditStamp = r.RowHash ?? "";
        _relEditError = null;
        _relEditSeed = RelationshipInput();
    }

    private void SwapRelationship() => (_relEditSource, _relEditTarget) = (_relEditTarget, _relEditSource);

    private Task SaveRelationship() => _relEditing.Run(SaveRelationshipCore);

    private async Task SaveRelationshipCore()
    {
        if (_relEdit.Current is not { } editing || !Guid.TryParse(_relEditSource, out var src) || !Guid.TryParse(_relEditTarget, out var tgt)) return;
        _relEditError = null;
        try
        {
            await Cases.EditRelationshipAsync(CaseId, editing.Key, src, tgt, _relEditType, _relEditDescription, _relEditStamp);
            _relEdit.CloseIf(editing);
            await OnChanged.InvokeAsync();
            Toasts.Success("Relationship updated");
        }
        catch (StaleEditException ex)
        {
            _relEdit.CloseIf(editing);
            Toasts.Error(ex.Message);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            if (_relEdit.IsCurrent(editing)) _relEditError = ex.Message;
            else Toasts.Error(ex.Message);
        }
    }

    private Task RemoveRelationship(Guid relationshipId) => _removing.Run(() => RemoveRelationshipCore(relationshipId));

    private async Task RemoveRelationshipCore(Guid relationshipId)
    {
        try { await Cases.UnlinkAsync(CaseId, relationshipId); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error($"Couldn't remove the relationship. {ex.Message}"); return; }
