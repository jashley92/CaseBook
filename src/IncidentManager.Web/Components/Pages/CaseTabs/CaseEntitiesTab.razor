        Toasts.Success("Relationship removed");
    }

    // FR-63: a relationship picker's line: the label alone left two accounts labelled alike looking the same, so the
    // value follows it.
    private static string EntityOption(CaseEntity e) =>
        string.IsNullOrWhiteSpace(e.Label) ? $"{Ui.Label(e.Type)}: {Ui.Fit(e.Value)}" : $"{Ui.Label(e.Type)}: {Ui.Fit(e.Label, 28)} ({Ui.Fit(e.Value, 28)})";

    private string EntityName(Guid entityId)
    {
        var e = Case.Entities.FirstOrDefault(x => x.Id == entityId);
        if (e is null) return "(unknown)";
        return string.IsNullOrWhiteSpace(e.Label) ? e.Value : e.Label!;
    }

    // --- Interactive graph (vis-network via JS interop) ---
    private sealed record GraphColor(string Background, string Border);
    private sealed record GraphNodeDto(string Id, string Label, string Title, string Shape, GraphColor Color, double? X, double? Y);
    private sealed record GraphEdgeDto(string Id, string From, string To, string Label, string? Color, bool Dashes);

    /// <summary>vis-network node shape per entity type, so hosts, IPs, URLs etc. read differently at a glance.</summary>
    private static string ShapeFor(EntityType t) => t switch
    {
        EntityType.Account => "dot",
        EntityType.Host => "hexagon",
        EntityType.IpAddress => "diamond",
        EntityType.Domain => "diamond",
        EntityType.Url => "triangle",
        EntityType.FileHash => "square",
        EntityType.FileName => "triangleDown",
        EntityType.EmailAddress => "star",
        EntityType.Process => "dot",
        EntityType.CommandLine => "dot",
        EntityType.RegistryKey => "square",
        _ => "dot"
    };

    private IReadOnlyList<GraphNodeDto> GraphNodes()
    {
        var layout = Case.EntityLayouts.ToDictionary(l => l.EntityId);
        return Case.Entities.Select(e =>
        {
            var label = e.Label ?? e.Value;
            label = IncidentManager.Application.Common.TextFit.Cap(label, 22);
            var color = Ui.DispositionColor(e.Disposition);
            var title = $"{Ui.Label(e.Type)}: {e.Value}" + (string.IsNullOrWhiteSpace(e.Description) ? "" : $" · {e.Description}");
            var pos = layout.TryGetValue(e.Id, out var l) ? l : null;
            return new GraphNodeDto(e.Id.ToString(), $"{Ui.EntityGlyph(e.Type)} {label}", title,
                ShapeFor(e.Type), new GraphColor(color, color), pos?.X, pos?.Y);
        }).ToList();
    }

    private IReadOnlyList<GraphEdgeDto> GraphEdges()
    {
        var edges = Case.EntityRelationships.Select(r =>
            new GraphEdgeDto(r.Id.ToString(), r.SourceEntityId.ToString(), r.TargetEntityId.ToString(),
                Ui.Label(r.Type), null, false)).ToList();

        // Layer the attack narrative: event steps with both an actor and a target become dashed,
        // tactic-coloured edges so the malicious activity graphs over the entity relationships.
        if (_showAttackEdges)
        {
            foreach (var e in Case.TimelineEntries.Where(x => x.Kind == TimelineKind.Event && x.IsCurrent   // BUG-413
                && x.ActorEntityId is not null && x.TargetEntityId is not null))
            {
                var tactic = PrimaryTactic(e);
                edges.Add(new GraphEdgeDto($"evt-{e.Id}", e.ActorEntityId!.ToString()!, e.TargetEntityId!.ToString()!,
                    Ui.Label(tactic), Ui.TacticColor(tactic), true));
            }
        }
        return edges;
    }

    private static MitreTactic PrimaryTactic(TimelineEntry e) =>
        e.Tactics.Count == 0 ? MitreTactic.Unspecified : e.Tactics.Select(t => t.Tactic).OrderBy(Ui.TacticRank).First();

    /// <summary>Signature of the graph's data so we only push to JS when something actually changed.</summary>
    private string GraphSignature() => string.Concat(
        string.Join("|", Case.Entities.Select(e => $"{e.Id:N}:{(int)e.Type}:{(int)e.Disposition}:{e.Label}:{e.Value}")),
        "#",
        string.Join("|", Case.EntityRelationships.Select(r => $"{r.Id:N}:{r.SourceEntityId:N}>{r.TargetEntityId:N}:{(int)r.Type}")),
        "#att:", _showAttackEdges ? "1" : "0", ":",
        string.Join("|", Case.TimelineEntries.Where(x => x.Kind == TimelineKind.Event && x.IsCurrent && x.ActorEntityId is not null && x.TargetEntityId is not null)
            .Select(e => $"{e.Id:N}:{e.ActorEntityId:N}>{e.TargetEntityId:N}")));

    private Guid? _focusHandled;
    private (string Fn, string Id)? _bringIntoView;
    /// <summary>Stable DOM id for an entity row, so an entity tag chip can deep-link straight to it.</summary>
    private static string RowId(Guid id) => $"ent-{id:N}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Deep-link focus (entity tagging): scroll to the referenced row once; CSS pulses it briefly.
        if (FocusEntityId is { } fid && fid != _focusHandled)
        {
            _focusHandled = fid;
            try { await JS.InvokeVoidAsync("imMotion.scrollToId", RowId(fid)); } catch (JSException) { /* motion is optional */ }
        }
        // BUG-410: Edit loads the row into the form at the top of the tab, so take the user there (and back to the
        // row when the edit ends).
        if (_bringIntoView is { } target)
        {
            _bringIntoView = null;
            var (fn, id) = target;
            try { await JS.InvokeVoidAsync(fn, id); } catch (JSException) { /* motion is optional */ }
        }

        // CAP-02: UX-01's focus trap for the verdict dialog, as the timeline's dialogs do.
        if ((_assess is not null) != _assessTrapArmed && !Disposed)
        {
            _assessTrapArmed = _assess is not null;
            try { await JS.InvokeVoidAsync(_assessTrapArmed ? "imModal.arm" : "imModal.release"); }
            catch (JSException) { /* focus trap is a progressive enhancement */ }
        }

        // The graph container only exists when there are entities to draw. BUG-418: nor for a tab disposed meanwhile.
        if (Disposed || Case.Entities.Count == 0) return;

        var sig = _crossView ? "x:" + CrossSignature() : GraphSignature();
        if (!_graphNeedsPush && sig == _lastGraphSig) return;

        _graphNeedsPush = false;
        _lastGraphSig = sig;
        try
        {
            if (_crossView)
            {
                if (_overlaps.Count > 0 || _links.Count > 0)
                    await JS.InvokeVoidAsync("entityGraph.render", CrossGraphId, CrossNodes(), CrossEdges(), null, false);
            }
            else
            {
                await JS.InvokeVoidAsync("entityGraph.render", GraphContainerId, GraphNodes(), GraphEdges(), _graphRef, CanEdit);
            }
        }
        catch (JSException) { /* graph is a progressive enhancement; ignore transient interop errors */ }
        catch (ObjectDisposedException) { /* BUG-418: the tab was disposed during the call */ }
    }

    /// <summary>Called from JS when the user finishes dragging node(s). Persists the arranged layout (editors only).</summary>
    [JSInvokable]
    public async Task OnNodesMoved(EntityPosition[] positions)
    {
        if (!CanEdit || positions is null || positions.Length == 0) return;
        // BUG-603: one save at a time. A drag that ends while one runs is saved after it; each sends every node, so the
        // latest arrangement is the one kept and none is dropped.
        _layoutNext = positions;
        if (_layoutSaving) return;
        _layoutSaving = true;
        try
        {
            while (_layoutNext is { } next)
            {
                _layoutNext = null;
                // Called from the graph script, so a refused save must be reported here rather than thrown back to JS.
                try { await Cases.SaveGraphLayoutAsync(CaseId, next); }
                catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
                {
                    await InvokeAsync(() => Toasts.Error($"Couldn't save the graph layout. {ex.Message}"));
                }
            }
        }
        finally { _layoutSaving = false; }
    }

    private bool _layoutSaving;
    private EntityPosition[]? _layoutNext;

    private async Task GraphFit() => await SafeGraphCall("entityGraph.fit", ActiveGraphId);

    private async Task SetCrossView(bool cross)
    {
        if (_crossView == cross) return;
        // The other view's container leaves the DOM; drop its network so a later switch back rebuilds cleanly.
        await SafeGraphCall("entityGraph.destroy", ActiveGraphId);
        _crossView = cross;
        _physicsOn = true;
        _graphNeedsPush = true;
    }

    private string CrossSignature() => string.Concat(
        string.Join("|", _overlaps.OrderBy(k => k.Key).Select(k => $"{k.Key:N}>" + string.Join(",", k.Value.Select(o => o.OtherCaseId.ToString("N"))))),
        "#", string.Join("|", _links.Select(l => $"{l.LinkId:N}:{(int)l.Type}")));

    /// <summary>PROD-29: this case (accent box), its shared indicators, the other cases carrying them, and linked cases.</summary>
    // Cross-view nodes carry their own label colour: a dark label on the gold "this case" box for contrast.
    private sealed record GraphFont(string Color);
    private sealed record CrossNodeDto(string Id, string Label, string Title, string Shape, GraphColor Color, GraphFont? Font);

    private IReadOnlyList<CrossNodeDto> CrossNodes()
    {
        var accent = "#e0af12";
        var light = new GraphFont("#f8f9fa");
        var nodes = new List<CrossNodeDto>
        {
            new($"case-{CaseId:N}", $"◆ {Case.CaseNumber}", $"This case: {Case.Title}", "box", new GraphColor(accent, accent), new GraphFont("#212529")),
        };
        var others = new Dictionary<Guid, string>();
        foreach (var (entityId, list) in _overlaps)
        {
            if (Case.Entities.FirstOrDefault(e => e.Id == entityId) is not { } e) continue;
            var label = e.Label ?? e.Value;
            label = IncidentManager.Application.Common.TextFit.Cap(label, 22);
            var color = Ui.DispositionColor(e.Disposition);
            nodes.Add(new($"ioc-{entityId:N}", $"{Ui.EntityGlyph(e.Type)} {label}",
                $"{Ui.Label(e.Type)}: {e.Value} · shared with {IncidentManager.Application.Common.Plural.Of(list.Count, "other case")}", ShapeFor(e.Type), new GraphColor(color, color),
                null));   // indicators keep the theme-aware default label colour
            foreach (var o in list) others.TryAdd(o.OtherCaseId, o.OtherCaseNumber);
        }
        foreach (var l in _links) others.TryAdd(l.OtherCaseId, l.OtherCaseNumber);
        foreach (var (id, number) in others)
        {
            var title = _links.FirstOrDefault(l => l.OtherCaseId == id) is { } link ? $"{number}: {link.OtherTitle}" : number;
            nodes.Add(new($"case-{id:N}", number, title, "box", new GraphColor("#6c757d", "#6c757d"), light));
        }
        return nodes;
    }

    private IReadOnlyList<GraphEdgeDto> CrossEdges()
    {
        var self = $"case-{CaseId:N}";
        var edges = new List<GraphEdgeDto>();
        foreach (var (entityId, list) in _overlaps)
        {
            if (Case.Entities.All(e => e.Id != entityId)) continue;
            edges.Add(new($"has-{entityId:N}", self, $"ioc-{entityId:N}", "", null, false));
            foreach (var o in list)
                edges.Add(new($"also-{entityId:N}-{o.OtherCaseId:N}", $"ioc-{entityId:N}", $"case-{o.OtherCaseId:N}", "", null, false));
        }
        foreach (var l in _links)
            edges.Add(new($"link-{l.LinkId:N}", l.Outgoing ? self : $"case-{l.OtherCaseId:N}", l.Outgoing ? $"case-{l.OtherCaseId:N}" : self,
                Ui.CaseLinkLabel(l.Type, true), l.Type == CaseLinkType.PartOfCampaign ? "#e0af12" : "#6c757d", true));
        return edges;
    }

    private async Task GraphTogglePhysics()
    {
        _physicsOn = !_physicsOn;
        await SafeGraphCall("entityGraph.setPhysics", ActiveGraphId, _physicsOn);
    }

    private async Task GraphRelayout()
    {
        _physicsOn = true;
        await SafeGraphCall("entityGraph.relayout", ActiveGraphId);
    }

    private void ToggleAttackEdges()
    {
        _showAttackEdges = !_showAttackEdges;
        _graphNeedsPush = true;   // edge set changed → re-render the graph on next after-render
    }

    private async Task SafeGraphCall(string fn, params object[] args)
    {
        try { await JS.InvokeVoidAsync(fn, args); }
        catch (JSException) { /* ignore */ }
    }

    /// <summary>BUG-425: removed from the page (a tab switch, the phone's Now/Next view, the error fallback); the
    /// workspace's @ref still points here, so its Ctrl/Cmd+Enter checks this first (CaseWorkspace.Keyboard).</summary>
    internal bool Disposed { get; private set; }

    public async ValueTask DisposeAsync()
    {
        Disposed = true;
        Edits.Forget(this);
        // Sonar S2930: a directory check still waiting is cancelled first, so its Task.Delay ends before the source is
        // disposed (its own call's Dispose after that is a no-op).
        if (_accountCheck is { } check)
        {
            _accountCheck = null;
            await check.CancelAsync();
            check.Dispose();
        }
        try
        {
            if (_assessTrapArmed) await JS.InvokeVoidAsync("imModal.release");   // CAP-02: the dialog went with the tab
            await JS.InvokeVoidAsync("entityGraph.destroy", GraphContainerId); await JS.InvokeVoidAsync("entityGraph.destroy", CrossGraphId);
        }
        catch { /* circuit may already be gone during teardown */ }
        _graphRef?.Dispose();
    }
}
