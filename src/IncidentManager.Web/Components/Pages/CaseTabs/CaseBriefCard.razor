@* INV-09: the case brief — where the case stands, in five short parts, at the top of the Overview, so anyone
   picking the case up sees it without reading every note. Each save is a new version; earlier versions stay
   readable under History. Neutral, factual wording: it's part of the case record.
   INV-36: the first part is the case summary, the one the case report prints. The current summary is read from the
   case (the field the report, the close gate and import use); each version keeps the summary as it stood.
   INV-25: the next steps are the case's open tasks, not text: the current brief lists them live, each saved version
   records them as they stood, and an open question can be followed up as a task from here.
   INV-27: says how far the record has moved on since the current version, and suggests an update after a decision,
   handoff, phase, classification or materiality change. Never forced. *@
@implements IDisposable
@inject CaseService Cases
@inject UnsavedEdits Edits
@inject IClock Clock
@inject IncidentManager.Application.Content.IMarkdownService Md
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject TimeDisplay TimeDisp
@inject ToastService Toasts
@inject ISeverityLabels SevLabels

@* RD-04: Pane renders the same brief as the Now section of the Now/Next pane: no card chrome, the record serif,
   labels above the parts, and no next-steps list (Next, below it, is that list). *@
<section class="@(Pane ? "im-now im-nn-sec" : "card im-brief mb-4")" id="@(Pane ? "nn-brief" : "ov-brief")" aria-labelledby="@(Pane ? "nn-brief-title" : "brief-title")">
    <div class="@(Pane ? "im-nn-head flex-wrap" : "card-header") d-flex align-items-center flex-wrap gap-2">
        @if (Pane)
        {
            <h2 class="im-nn-h" id="nn-brief-title" title="Where it stands: the brief">Now</h2>
        }
        else
        {
            <h2 class="h6 mb-0" id="brief-title">Where it stands</h2>
        }
        @if (Current is { } cur && !_editing)
        {
            <span class="im-badge im-b-neutral" title="Brief version">v@(cur.Version)</span>
            @* HR-01: on a case closed with an outcome, the current version is the closing brief, its assessment the conclusion. *@
            @if (Case.ClosingBrief is { } closing)
            {
                @* BUG-310: a version revised after the case closed isn't the closing brief; the report keeps the closing one. *@
                if (closing.Id == cur.Id)
                {
                    <span class="im-badge im-b-info" title="Written when the case closed; the working assessment is the conclusion">Closing brief</span>
                }
                else
                {
                    <span class="im-badge im-b-warn" title="@($"Revised after the case closed. The conclusion of record is in v{closing.Version}, the closing brief, which the report prints.")">Revised after closure</span>
                }
            }
            <span class="small text-muted" title="@TimeDisp.Long(cur.CreatedAtUtc)">
                Revised @Ui.RelativeTime(cur.CreatedAtUtc, Clock.UtcNow) by @Users.DisplayFor(cur.CreatedBy)
            </span>
            @if (cur.ConfirmedAtUtc is { } confirmed)
            {
                <span class="small text-muted" title="@($"Confirmed still accurate {TimeDisp.Long(confirmed)}")">
                    · confirmed @Ui.RelativeTime(confirmed, Clock.UtcNow) by @Users.DisplayFor(cur.ConfirmedBy)
                </span>
            }
            @if (Earlier.Count > 0)
            {
                <button type="button" class="btn btn-sm btn-link p-0" aria-expanded="@Ui.Aria(_showHistory)" @onclick="() => _showHistory = !_showHistory">
                    @(_showHistory ? "Hide" : "Show") @Earlier.Count earlier version@(Earlier.Count == 1 ? "" : "s")
                </button>
            }
            @if (Freshness is { Count: > 0 } fresh)
            {
                <button type="button" class="im-badge im-b-warn im-brief-fresh" @onclick="() => OnShowSince.InvokeAsync(IncidentManager.Application.Cases.BriefFreshness.Baseline(Case, cur))"
                        title="@($"Recorded since the brief was last reviewed (v{fresh.ReviewedVersion}): {string.Join(", ", fresh.Breakdown.Select(b => $"{b.Count} {b.What}"))}. Click to see them on the timeline.")">
                    @IncidentManager.Application.Common.Plural.Of(fresh.Count, "change") since
                </button>
                @if (CanEdit && !_editing)
                {
                    <button type="button" class="btn btn-link btn-sm p-0" disabled="@_saving" @onclick="ConfirmStillAccurate"
                            title="You've checked the brief against what's changed and it still stands: record that, without a new version">Still accurate</button>
                }
            }
        }
        @if (CanEdit && !_editing)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="BeginEdit">
                <span class="bi bi-pencil" aria-hidden="true"></span> @(Current is null && !HasSummary ? "Write the brief" : Pane ? "Update" : "Revise")
            </button>
        }
    </div>
    <div class="@(Pane ? "im-nn-body" : "card-body")">

    @if (_editing)
    {
        @* BUG-370: the editor's own Ctrl/Cmd+Enter saves the brief (keymap.js leaves .im-own-keys to it), in the pane and
           on the Briefing tab alike, instead of submitting whatever else the tab has open. *@
        <div class="im-own-keys" @onkeydown="EditorKey">
        <p class="small text-muted mb-2">Keep it short and factual; this is part of the case record. Saving keeps the earlier version.</p>
        @foreach (var part in Parts.Where(p => p.Editable))
        {
            <div class="mb-2">
                <label class="form-label small mb-0 fw-semibold" for="@($"brief-{part.Key}")">@part.Label</label>
                @if (part.Key == SummaryKey) { @ReportNote() }
                <span class="small text-muted ms-1">@part.Hint</span>
                @if (part.Key == KnownKey && Case.Evidence.Any(x => !x.IsWithdrawn))
                {
                    @* INV-33: what's known, with the evidence it rests on. Inserts a file chip at the end of the part. *@
                    <select class="form-select form-select-sm d-inline-block w-auto ms-2 im-brief-cite" aria-label="Cite evidence in Known"
                            value="" @onchange="e => CiteInKnown(e.Value?.ToString())">
                        <option value="">Cite evidence…</option>
                        @foreach (var ev in Case.Evidence.Where(x => !x.IsWithdrawn).OrderByDescending(x => x.CreatedAtUtc))   @* CAP-21 *@
                        {
                            <option value="@ev.Id">@ev.OriginalFileName</option>
                        }
                    </select>
                }
                <textarea id="@($"brief-{part.Key}")" data-tag-box data-tag-refs="@TagRefLabels" data-list-box class="form-control form-control-sm" rows="@part.Rows" maxlength="@CaseBrief.MaxPartLength"
                          value="@_draft[part.Key]" @oninput="e => _draft[part.Key] = e.Value?.ToString()"></textarea>
            </div>
        }
        @if (!Pane)
        {
            <div class="mb-2">
                <span class="form-label small mb-0 fw-semibold">Next steps</span>
                <span class="small text-muted ms-1">The case's open tasks. Saving records them with this version; change them on the Tasks tab.</span>
                @NextList(editing: true)
            </div>
        }
        else
        {
            <p class="small text-muted mb-2">Next steps are saved with this version from the open tasks, as listed under Next.</p>
        }
        @if (_error is not null)
        {
            <p class="text-danger small mb-2" role="alert">@_error</p>
        }
        <div class="d-flex gap-2 justify-content-end">
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _editing = false">Cancel</button>
            <button class="btn btn-sm btn-primary" disabled="@_saving" @onclick="Save">Save brief</button>
        </div>
        </div>
    }
    else if (Current is not null || HasSummary)
    {
        @if (Freshness?.Prompt is { } prompt)
        {
            <div class="im-brief-nudge small" role="status">
                <span class="bi bi-arrow-repeat" aria-hidden="true"></span>
                <span>@prompt</span>
                @if (CanEdit)
                {
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="BeginEdit">Update the brief</button>
                    <span class="text-muted">or</span>
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" disabled="@_saving" @onclick="ConfirmStillAccurate"
                            title="Nothing to change: record that you've checked it, without a new version">mark it still accurate</button>
                }
            </div>
        }
        @Render(Current, Case.Summary, current: true)
        @if (_showHistory)
        {
            <div class="tl-history mt-3">
                @foreach (var prior in Earlier)
                {
                    <div class="tl-history-item">
                        <div class="small text-muted mb-1">
                            <span class="im-badge im-b-neutral">v@(prior.Version)</span>
                            @Users.DisplayFor(prior.CreatedBy) · @TimeDisp.Long(prior.CreatedAtUtc)
                        </div>
                        @Render(prior, prior.Summary, current: false)
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p class="small text-muted mb-0">
            Nothing written yet. Say where the case stands: a summary for the case report, what the team thinks is
            happening, what's known, what's still open and what's next, so anyone can pick it up.
        </p>
    }
    </div>
</section>

@code {
    [Parameter, EditorRequired] public Case Case { get; set; } = null!;
    /// <summary>CAP-38 review: the case's clocks, for its standing with its regulators (the reported milestone follows it).</summary>
    [Parameter] public IncidentManager.Application.Compliance.CaseNotificationDeadlines? Notify { get; set; }
    /// <summary>HR-02: each task's latest recorded result.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, IncidentManager.Application.Cases.TaskResult> TaskResults { get; set; } = new Dictionary<Guid, IncidentManager.Application.Cases.TaskResult>();
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Switch the workspace to another tab (a task opens the Tasks tab).</summary>
    [Parameter] public EventCallback<string> OnGoToTab { get; set; }
    /// <summary>INV-27: show the timeline's changes since a time (the current version's).</summary>
    [Parameter] public EventCallback<DateTimeOffset> OnShowSince { get; set; }
    /// <summary>RD-04: render as the Now section of the Now/Next pane.</summary>
    [Parameter] public bool Pane { get; set; }

    // INV-27: how far the record has moved on since the current version (null without one).
    private BriefFreshness.Result? Freshness => Current is { } cur
        ? BriefFreshness.Since(Case, cur, new MilestoneLabels(c => Ui.Label(c), s => SevLabels.For(s), p => Ui.Label(p), m => Ui.Label(m),
            Standing: Notify?.Standing))   // CAP-38 review: reported by the standing
        : null;

    private sealed record Part(string Key, string Label, string Hint, int Rows, Func<CaseBrief, string?> Get, bool Editable = true);

    private static readonly Part[] Parts =
    [
        new(SummaryKey, "Summary", "What happened and where it stands, in a few sentences.", 4, b => b.Summary),
        new("assessment", "Working assessment", "What the team currently thinks is happening, and how sure it is.", 2, b => b.WorkingAssessment),
        new("known", "Known", "What is established, and where it comes from.", 3, b => b.Known),
        new("open", "Open questions", "What the team still needs to find out.", 2, b => b.OpenQuestions),
        new(NextKey, "Next steps", "", 0, b => b.NextSteps, Editable: false),
    ];

    private const string SummaryKey = "summary";
    private const string OpenKey = "open";
    private const string KnownKey = "known";

    // INV-33: appends "[[file]]" to Known, on the current line; saved as "[file](evidence:<id>)".
    private void CiteInKnown(string? evidenceId)
    {
        if (!Guid.TryParse(evidenceId, out var id) || Case.Evidence.FirstOrDefault(e => e.Id == id) is not { } ev) return;
        var current = (_draft.GetValueOrDefault(KnownKey) ?? "").TrimEnd();
        _draft[KnownKey] = (current.Length == 0 ? "- " : current + " ") + Citation(ev.OriginalFileName, id, RefsOf(KnownKey));
    }

    /// <summary>
    /// What a citation of a file puts in the box. C13: a name a [[tag]] can hold goes in as one (linked on save, its label
    /// escaped there); one with a bracket goes in as the link itself, its label escaped (MarkdownText.LinkLabel), which a
    /// save keeps as it is. The brackets used to become parentheses, so the brief named a file the case doesn't have.
    /// </summary>
    public static string Citation(string fileName, Guid evidenceId, IDictionary<string, string> refs)
    {
        var name = fileName.ReplaceLineEndings(" ");   // a line break ends a link
        if (name.IndexOfAny(['[', ']']) >= 0)
            return $"[{IncidentManager.Application.Content.MarkdownText.LinkLabel(name)}](evidence:{evidenceId})";
        IncidentManager.Application.Content.TagText.Remember(refs, name, $"evidence:{evidenceId}");   // BUG-121: after any earlier [[name]]
        return $"[[{name}]]";
    }
    private const string NextKey = "next";
    private const int NextShown = 5;

    private CaseBrief? Current => Case.Briefs.FirstOrDefault(b => b.IsCurrent);
    private bool HasSummary => !string.IsNullOrWhiteSpace(Case.Summary);
    private List<CaseBrief> Earlier => Case.Briefs.Where(b => !b.IsCurrent).OrderByDescending(b => b.Version).ToList();

    private bool _editing;
    private bool _saving;
    private bool _showHistory;
    private string? _error;
    private string? _taskError;
    private string? _newTask;
    private bool _adding;
    private Guid? _openedFrom;
    private readonly Dictionary<string, string?> _draft = new();
    private Dictionary<string, string?> _seeded = new();   // BUG-578: the parts as the editor opened, so an untouched one isn't "unsaved"

    [CascadingParameter] public EditRegion? Region { get; set; }

    // BUG-578: the brief being revised, or a task being typed under Next steps, is asked about before a tab switch, the
    // pane stepping aside, leaving the case or the time-display redraw hides it.
    protected override void OnInitialized()
    {
        Edits.Track(this, "the brief you're revising", () => _editing
            && _draft.Any(d => !string.Equals(d.Value ?? "", _seeded.GetValueOrDefault(d.Key) ?? "", StringComparison.Ordinal)), Region);
        Edits.Track(this, "the task you're adding", () => _adding && !string.IsNullOrWhiteSpace(_newTask), Region);
    }

    public void Dispose() => Edits.Forget(this);
    // WF-28: each part's link targets on their own. FromEditable counts a label's tags per text, so one list shared by every
    // part (with the summary read twice) gave the n-th tag in Open questions the n-th target of the whole brief: saving
    // unchanged could turn an entity tag into an evidence link.
    private readonly Dictionary<string, Dictionary<string, string>> _refs = new(StringComparer.Ordinal);

    private Dictionary<string, string> RefsOf(string key) =>
        _refs.TryGetValue(key, out var r) ? r : _refs[key] = new Dictionary<string, string>(StringComparer.Ordinal);

    // BUG-450: every label Linked can resolve from refs (any part's, as below), for the boxes' data-tag-refs: text-box.js
    // inserts a pick with one of those names as its link, so it isn't saved as a link to that other target.
    private string TagRefLabels => IncidentManager.Application.Content.TagText.RefLabels(_refs.Values.SelectMany(r => r.Keys));

    // A part's own targets first; a tag moved in from another part keeps that part's first target for its label.
    private string? Linked(string key)
    {
        var refs = new Dictionary<string, string>(RefsOf(key), StringComparer.Ordinal);
        foreach (var (label, targets) in _refs.Where(r => r.Key != key).SelectMany(r => r.Value))
            refs.TryAdd(label, targets.Split('|')[0]);
        return IncidentManager.Application.Content.TagText.FromEditable(
            _draft.GetValueOrDefault(key), refs, Case.Entities.Select(e => (e.Id, e.Label, e.Value)));
    }

    /// <summary>Opens the editor (also used by the close gate's "Fix" for a missing summary).</summary>
    public void BeginEdit()
    {
        if (!CanEdit || _editing) return;
        var cur = Current;
        _openedFrom = cur?.Id;
        // Entity tags and evidence citations show as [[name]] in the plain boxes, and turn back into links on save.
        _refs.Clear();
        foreach (var p in Parts.Where(p => p.Editable && p.Key != SummaryKey))
            _draft[p.Key] = cur is null ? null : IncidentManager.Application.Content.TagText.ToEditable(p.Get(cur), RefsOf(p.Key));
        // The case's own summary is the current one (a version recorded before INV-36 may hold other text).
        _draft[SummaryKey] = IncidentManager.Application.Content.TagText.ToEditable(Case.Summary, RefsOf(SummaryKey));
        _seeded = new Dictionary<string, string?>(_draft);
        _error = null;
        _editing = true;
        StateHasChanged();
    }

    // Says the current version still stands, without a new one; the "changes since" count starts again.
    private async Task ConfirmStillAccurate()
    {
        if (_saving || Current is not { } cur) return;   // BUG-603: a second click came back refused over the first one
        _saving = true;
        try
        {
            await Cases.ConfirmBriefAsync(Case.Id, cur.Id);
            Toasts.Success("Brief marked still accurate");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException or StaleEditException)
        {
            Toasts.Error(ex.Message);
            await OnChanged.InvokeAsync();
        }
        finally { _saving = false; }
    }

    // BUG-545: a held key doesn't repeat. keymap.js's BUG-536 guard doesn't reach .im-own-keys, and after a stale refusal
    // the editor re-baselines, so a repeat would save over the colleague's brief before the warning could be read.
    private async Task EditorKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey) && !e.Repeat && _editing) await Save();
    }

    private async Task Save()
    {
        if (_saving) return;   // REV-31: one save at a time (a click and Ctrl+Enter, or a double click)
        _saving = true;
        _error = null;
        try
        {
            var saved = await Cases.ReviseBriefAsync(Case.Id, _openedFrom, Linked(SummaryKey), Linked("assessment"), Linked("known"),
                Linked("open"));
            _editing = false;
            if (saved) Toasts.Success("Brief saved");
            else Toasts.Info("No changes; the brief is unchanged. Use \"mark it still accurate\" to record that you've checked it.");
            await OnChanged.InvokeAsync();
        }
        catch (StaleEditException ex)
        {
            // Keep the author's text; the next save deliberately replaces the newer version.
            _error = ex.Message;
            _openedFrom = Guid.TryParse(ex.CurrentStamp, out var g) ? g : null;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            _error = ex.Message;
        }
        finally { _saving = false; }
    }

    // The summary first, set apart because it's the one part the case report prints; then the working parts.
    private RenderFragment Render(CaseBrief? b, string? summary, bool current) => @<text>
        <div class="im-brief-summary">
            <div class="im-brief-summary-h"><span class="fw-semibold">Summary</span> @if (current) { @ReportNote() }</div>
            @if (!string.IsNullOrWhiteSpace(summary))
            {
                <div class="md-body @(Pane ? "im-rec" : "")">@((MarkupString)Md.ToHtml(summary, Case.Id))</div>
            }
            else
            {
                <p class="small text-muted mb-0">@(current ? "No summary yet. The case report and the close checks need one." : "No summary.")</p>
            }
        </div>
        <dl class="im-brief-parts mb-0">
            @if (b is not null)
            {
                @foreach (var p in Parts.Where(p => p.Key != SummaryKey && !(current && p.Key == NextKey)))
                {
                    if (p.Get(b) is { Length: > 0 } text)
                    {
                        @* HR-01: on a closed case's closing brief, the assessment is the conclusion. *@
                        <dt>@(current && p.Key == "assessment" && Case.Phase == CasePhase.Closed && Case.OutcomeKey is not null ? "Conclusion" : p.Label)</dt>
                        @if (current && p.Key == OpenKey && CaseNext.QuestionParts(text) is { } parts)
                        {
                            @* BUG-299: prose first, as written, then the list's questions with their tasks. *@
                            @if (parts.Prose is { } prose)
                            {
                                <dd class="md-body">@((MarkupString)Md.ToHtml(prose, Case.Id))</dd>
                            }
                            <dd>@Questions(parts.Items)</dd>
                        }
                        else
                        {
                            <dd class="md-body">@((MarkupString)Md.ToHtml(text, Case.Id))</dd>
                        }
                    }
                }
            }
            @if (current && !Pane)
            {
                <dt>Next steps</dt>
                <dd>
                    @NextList(editing: false)
                    @if (CanEdit)
                    {
                        @if (_adding)
                        {
                            @* BUG-451: its own Ctrl/Cmd+Enter adds the task (keymap.js leaves .im-own-keys to it), not the tab's details save. *@
                            <form class="im-brief-add im-own-keys" @onsubmit="AddTask" @onsubmit:preventDefault @onkeydown="AddTaskKey">
                                <label class="visually-hidden" for="brief-new-task">New task</label>
                                <input id="brief-new-task" class="form-control form-control-sm" maxlength="@ActionItem.MaxTitleLength"
                                       placeholder="What needs doing?" @bind="_newTask" @bind:event="oninput" />
                                <button type="submit" class="btn btn-sm btn-primary" disabled="@string.IsNullOrWhiteSpace(_newTask)">Add</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => { _adding = false; _newTask = null; }">Cancel</button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => { _adding = true; _taskError = null; }">
                                <span class="bi bi-plus-lg" aria-hidden="true"></span> Add a task
                            </button>
                        }
                    }
                    @if (_taskError is not null)
                    {
                        <p class="text-danger small mb-0" role="alert">@_taskError</p>
                    }
                </dd>
            }
        </dl>
    </text>;

    // INV-25: the case's open tasks, in the order to do them (the same list the context panel and handoff read).
    private RenderFragment NextList(bool editing) => @<text>
        @{
            var now = Clock.UtcNow;
            var open = CaseNext.Open(Case, now);
        }
        @if (open.Count == 0)
        {
            <p class="small text-muted mb-1">No open tasks.</p>
        }
        else
        {
            <ul class="im-brief-next">
                @foreach (var t in open.Take(NextShown))
                {
                    <li>
                        @if (editing)
                        {
                            <span>@t.Title</span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-link p-0 text-start" @onclick='() => OnGoToTab.InvokeAsync("Tasks")'>@t.Title</button>
                        }
                        <span class="im-brief-next-meta">
                            @(string.IsNullOrWhiteSpace(t.Owner) ? "Unassigned" : Users.DisplayFor(t.Owner))
                            @if (t.DueAtUtc is { } due)
                            {
                                <span class="@(t.IsOverdue(now) ? "text-danger" : "")" title="@TimeDisp.Long(due)"> · @(t.IsOverdue(now) ? "overdue, was due" : "due") @TimeDisp.DateOnly(due)</span>
                            }
                        </span>
                    </li>
                }
            </ul>
            @if (open.Count > NextShown)
            {
                <button type="button" class="btn btn-link btn-sm p-0" @onclick='() => OnGoToTab.InvokeAsync("Tasks")'>@(open.Count - NextShown) more on the Tasks tab</button>
            }
        }
    </text>;

    // INV-25: open questions written as a list, each with the task following it up (or a button to raise one).
    private RenderFragment Questions(List<string> questions) => @<ul class="im-brief-q">
        @foreach (var q in questions)
        {
            var title = QuestionTitle(q);
            var task = Case.TasksFollowingUp(title)   // BUG-298
                .OrderByDescending(t => t.IsOpen).ThenByDescending(t => t.CreatedAtUtc).FirstOrDefault();
            <li>
                <span class="md-body im-brief-q-text">@((MarkupString)Md.ToInlineHtml(q, Case.Id))</span>
                @if (task is not null)
                {
                    <button type="button" class="im-badge @(task.IsOpen ? "im-b-info" : "im-b-neutral") im-brief-q-task" title="Followed up as a task"
                            @onclick='() => OnGoToTab.InvokeAsync("Tasks")'>
                        <span class="bi @(task.IsOpen ? "bi-list-check" : "bi-check2")" aria-hidden="true"></span>
                        Task · @(task.IsOpen ? (string.IsNullOrWhiteSpace(task.Owner) ? "open" : Users.DisplayFor(task.Owner)) : (task.Status == ActionItemStatus.Done ? "done" : "canceled"))
                    </button>
                    @* HR-02: the answer stays with the question. *@
                    @if (task.Status == ActionItemStatus.Done)
                    {
                        @if (TaskResults.TryGetValue(task.Id, out var answer))
                        {
                            <div class="im-brief-q-answer">
                                @answer.Text
                                <span class="im-meta">@Users.DisplayFor(task.CompletedBy ?? answer.RecordedBy) · @TimeDisp.Short(task.CompletedAtUtc ?? answer.RecordedAtUtc)</span>
                            </div>
                        }
                        else
                        {
                            <div class="im-brief-q-answer im-missing">Marked done without an answer.</div>
                        }
                    }
                }
                else if (CanEdit)
                {
                    <button type="button" class="btn btn-link btn-sm p-0 im-brief-q-task" @onclick="() => RaiseTask(title)">
                        <span class="bi bi-plus-lg" aria-hidden="true"></span> Follow up as a task
                    </button>
                }
            </li>
        }
    </ul>;

    private static string QuestionTitle(string markdown) => IncidentManager.Application.Content.MarkdownService.PlainLine(markdown);

    // BUG-603: one at a time (a double click raised the follow-up task twice, or came back refused).
    private readonly InFlight _raising = new();
    private Task RaiseTask(string question) => _raising.Run(() => RaiseTaskCore(question));

    private async Task RaiseTaskCore(string question)
    {
        _taskError = null;
        try
        {
            await Cases.RaiseTaskFromQuestionAsync(Case.Id, question);
            Toasts.Success("Task added");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            _taskError = ex.Message;
        }
    }

    private bool _addingTask;

    // BUG-451: Ctrl/Cmd+Enter in the inline form; a held key doesn't repeat, and AddTask's own guard covers a click or
    // an Enter submit alongside it. The title binds on input, so it reads what was just typed.
    private Task AddTaskKey(KeyboardEventArgs e) =>
        e.Key == "Enter" && (e.CtrlKey || e.MetaKey) && !e.Repeat ? AddTask() : Task.CompletedTask;

    private async Task AddTask()
    {
        if (_addingTask || string.IsNullOrWhiteSpace(_newTask)) return;   // WF-101: Enter held, or a double click
        _addingTask = true;
        _taskError = null;
        try
        {
            var sent = _newTask;
            await Cases.AddActionItemAsync(Case.Id, sent.Trim(), null, null);
            // BUG-601: what was typed during the save stays, in the open form, for the next task.
            _newTask = DraftText.ClearIfUnchanged(_newTask, sent, null);
            if (_newTask is null) _adding = false;
            Toasts.Success("Task added");
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            _taskError = ex.Message;
        }
        finally { _addingTask = false; }
    }

    private static RenderFragment ReportNote() => @<span class="im-brief-report" title="Printed as the summary in the case report. The other parts are the team's working understanding and stay out of the report unless its layout includes the brief.">
        <span class="bi bi-file-earmark-text" aria-hidden="true"></span> Case report
    </span>;
}
