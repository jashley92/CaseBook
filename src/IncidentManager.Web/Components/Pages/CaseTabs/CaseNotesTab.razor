@* Case workspace — Notes tab (UX-13, interwoven pass). Markdown notes with versioned edits (U-35). This
   tab owns its two EasyMDE editors (the add composer + the in-place edit editor): it reconciles them in its
   own OnAfterRenderAsync via the shared markdownEditor JS API and tears them down on dispose, so the parent's
   central editor reconcile no longer carries a Notes branch. Cross-tab concerns stay in the parent and are
   threaded in: live-collab flash (delegates), a Reload after a write (OnChanged), and the case hotkeys —
   the parent calls SubmitAsync() via @ref for Ctrl/⌘+Enter, and sets AutofocusComposer for the 'n' shortcut.
   INV-37: a note can @mention teammates (people who can see the case) to point them at it; they're emailed a link to
   the note. There are no replies: the conversation happens in the team's chat. *@
@implements IAsyncDisposable
@inject CaseService Cases
@inject IncidentManager.Application.Content.IMarkdownService Md
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject TimeDisplay TimeDisp
@inject ToastService Toasts
@inject IJSRuntime JS

<AuthorizeView Policy="@Policies.EditCases">
    @* Phones: the composer folds behind a button so the notes start near the top. The editor redraws itself
       when it becomes visible (autoRefresh). *@
    <button type="button" class="btn btn-sm btn-outline-primary mb-3 d-sm-none" aria-expanded="@Ui.Aria(ComposerShown)"
            aria-controls="note-add-form" @onclick="() => _composerOpen = !ComposerShown">
        <span class="bi @(ComposerShown ? "bi-chevron-up" : "bi-plus-lg") me-1" aria-hidden="true"></span>@(ComposerShown ? "Hide form" : "Add note")
    </button>
    <div id="note-add-form" class="card mb-3 @(ComposerShown ? "" : "im-phone-collapsed")">
        <div class="card-body">
            <label class="form-label small mb-1" for="@NoteAddEditorId">Note <span class="text-muted">· Markdown: headings, <strong>**bold**</strong>, lists, links · <code>@@</code> to mention a teammate · <code>[[</code> to tag an entity</span></label>
            @* EasyMDE enhances this textarea (managed in OnAfterRenderAsync); value pulled on Add. *@
            <ComposerHint>Working notes: findings and reasoning as you go. Not in the case report unless its report profile includes Analyst Notes. <code>@@</code>mentioned teammates are emailed a link to the note.</ComposerHint>
            <textarea id="@NoteAddEditorId" class="form-control mb-2"></textarea>
            <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="AddNote">Add note</button>
        </div>
    </div>
</AuthorizeView>

@if (Notes.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon"><span class="bi bi-journal-text" aria-hidden="true"></span></div>
        <div class="empty-state-title">No notes yet</div>
        <div class="empty-state-msg">Record findings and reasoning here. Notes print in the case report, and edits keep every prior version.</div>
    </div>
}
else
{
    @foreach (var n in Notes.Where(x => x.IsCurrent).OrderByDescending(x => x.CreatedAtUtc))
    {
        <div class="card mb-2 im-enter @FlashClass?.Invoke(n.Id) @(IsFocused(n) ? "im-note-focus" : "")" style="@FlashStyle?.Invoke(n.Id)" @key="n.Id" id="@($"note-{n.Id}")">
            <div class="card-body py-2">
                @if (_editNoteId == n.Id)
                {
                    @* EasyMDE enhances this textarea; keyed by note id so switching notes remounts a fresh editor. *@
                    <textarea id="@NoteEditEditorId(n.Id)" class="form-control mb-2" aria-label="Edit note"></textarea>
                    <button class="btn btn-sm btn-primary" @onclick="SaveNoteEdit">Save new version</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelNoteEdit">Cancel</button>
                }
                else
                {
                    <div class="md-body">@((MarkupString)Md.ToHtml(n.Body, CaseId))</div>
                    @if (n.Mentions.Count > 0)
                    {
                        <div class="mb-1">
                            @foreach (var m in n.Mentions)
                            {
                                <span class="im-badge im-b-info me-1" title="Mentioned: emailed a link to this note"><span class="bi bi-at" aria-hidden="true"></span> @Users.DisplayFor(m)</span>
                            }
                        </div>
                    }
                    <small class="text-muted">
                        @Users.DisplayFor(n.CreatedBy) · @TimeDisp.Long(n.CreatedAtUtc)
                        @if (n.Version > 1)
                        {
                            <span class="im-badge im-b-neutral ms-1">v@(n.Version)</span>
                        }
                    </small>
                    <AuthorizeView Policy="@Policies.EditCases" Context="edit">
                        <button class="btn btn-sm btn-link p-0 ms-2" @onclick="() => StartNoteEdit(n)">Edit</button>
                        @if (!IsPromoted(n))
                        {
                            <button class="btn btn-sm btn-link p-0 ms-2" @onclick="() => _promoting = n.Id">Add to timeline</button>
                        }
                        @* HR-17: a note's follow-up becomes a task that remembers the note. *@
                        <button class="btn btn-sm btn-link p-0 ms-2" @onclick="() => _taskFor = _taskFor == n.Id ? null : n.Id">
                            <span class="bi bi-plus-lg" aria-hidden="true"></span> Task
                        </button>
                    </AuthorizeView>
                    var noteTasks = TasksAbout(n);
                    @if (noteTasks.Count > 0)
                    {
                        <div class="tl-tasks" aria-label="Tasks about this note">
                            @foreach (var t in noteTasks)
                            {
                                <span class="tl-task @(t.IsOpen ? "" : "tl-task-done")" title="@(t.IsOpen ? "Open task" : "Done")">
                                    <span class="bi @(t.IsOpen ? "bi-square" : "bi-check2-square")" aria-hidden="true"></span> @t.Title
                                </span>
                            }
                        </div>
                    }
                    @if (_taskFor == n.Id)
                    {
                        <QuickTask CaseId="CaseId" About="@($"{ActionItem.AboutNote}:{NoteRoot(n)}")" Placeholder="A task about this note"
                                   OnDone="async () => { _taskFor = null; await OnChanged.InvokeAsync(); }" OnCancel="() => _taskFor = null" />
                    }
                    @if (IsPromoted(n))
                    {
                        <span class="im-badge im-b-info ms-2"><span class="bi bi-clock-history" aria-hidden="true"></span> On the timeline</span>
                    }
                    @if (_promoting == n.Id)
                    {
                        <PromoteToTimeline CaseId="CaseId" SourceRef="@($"note:{n.Id}")" Text="@n.Body" WrittenAtUtc="n.CreatedAtUtc"
                                           OnDone="PromotedDone" OnCancel="() => _promoting = null" />
                    }
                }
            </div>
        </div>
    }
}

@code {
    private bool _composerOpen;
    // The 'n' shortcut (AutofocusComposer) opens it too, so the keyboard path never lands on a hidden editor.
    private bool ComposerShown => _composerOpen || AutofocusComposer;
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<AnalystNote> Notes { get; set; } = [];
    /// <summary>The case's entities/IOCs, offered as inline "[[" tags in the note editors.</summary>
    [Parameter] public IReadOnlyList<CaseEntity> Entities { get; set; } = [];
    [Parameter] public bool CanEdit { get; set; }
    /// <summary>INV-07: the sources already promoted to the timeline ("note:&lt;id&gt;" …).</summary>
    [Parameter] public IReadOnlySet<string> Promoted { get; set; } = new HashSet<string>();
    private Guid? _promoting;
    /// <summary>HR-17: the case's tasks, to show the ones about each note.</summary>
    [Parameter] public IReadOnlyList<ActionItem> Tasks { get; set; } = [];
    private Guid? _taskFor;

    // A task about a note points at its first version, so it follows the note through edits.
    private Guid NoteRoot(AnalystNote n)
    {
        var root = n;
        for (var guard = 0; root.SupersedesNoteId is { } prior && Notes.FirstOrDefault(x => x.Id == prior) is { } p && guard < 100; guard++)
            root = p;
        return root.Id;
    }

    private List<ActionItem> TasksAbout(AnalystNote n)
    {
        var about = $"{ActionItem.AboutNote}:{NoteRoot(n)}";
        return Tasks.Where(t => t.AboutRef == about).OrderByDescending(t => t.IsOpen).ThenBy(t => t.CreatedAtUtc).ToList();
    }

    // INV-20: a note stays "on the timeline" after it's edited — any version of it may have been promoted.
    private bool IsPromoted(AnalystNote n)
    {
        for (AnalystNote? v = n; v is not null; v = v.SupersedesNoteId is { } prior ? Notes.FirstOrDefault(x => x.Id == prior) : null)
            if (Promoted.Contains($"note:{v.Id}")) return true;
        return false;
    }
    private async Task PromotedDone() { _promoting = null; await OnChanged.InvokeAsync(); }
    /// <summary>Reload the case after a note write so the list (and the rest of the workspace) refreshes.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Live-collab flash hooks (parent owns the flash state); render a note's flash class / hue.</summary>
    [Parameter] public Func<Guid, string?>? FlashClass { get; set; }
    [Parameter] public Func<Guid, string?>? FlashStyle { get; set; }
    /// <summary>The 'n' shortcut: focus the composer once it's mounted, then signal the parent to clear the flag.</summary>
    [Parameter] public bool AutofocusComposer { get; set; }
    [Parameter] public EventCallback OnAutofocusHandled { get; set; }
    /// <summary>FR-02: parent-owned draft store (survives tab switches). The add composer stashes its
    /// unsubmitted text here on teardown and re-seeds from it on remount, so hopping tabs doesn't lose a note.</summary>
    [Parameter] public Dictionary<string, string>? ComposerDrafts { get; set; }
    /// <summary>INV-37: a note to bring into view (a mention email links to it). Any version of it may be named.</summary>
    [Parameter] public Guid? FocusNoteId { get; set; }

    // S-13: people who can see this case, except the current user, as inline-@mention candidates ({id, name} for JS).
    private IReadOnlyList<IncidentManager.Application.Abstractions.UserSummary> _mentionable = [];
    private Guid _mentionsFor;
    private bool _focusDone;
    private object[] MentionCandidates => _mentionable.Select(u => (object)new { id = u.UserId, name = u.DisplayName }).ToArray();

    protected override async Task OnParametersSetAsync()
    {
        if (CanEdit && _mentionsFor != CaseId)
        {
            _mentionsFor = CaseId;
            _mentionable = await Cases.MentionableAsync(CaseId);
        }
    }

    // The focused note, or the current version of an earlier one that was named (the link may predate an edit).
    private bool IsFocused(AnalystNote n)
    {
        if (FocusNoteId is not { } f) return false;
        for (AnalystNote? v = n; v is not null; v = v.SupersedesNoteId is { } prior ? Notes.FirstOrDefault(x => x.Id == prior) : null)
            if (v.Id == f) return true;
        return false;
    }

    private string NoteAddEditorId => $"note-md-{CaseId}";
    private static string NoteEditEditorId(Guid noteId) => $"noteedit-md-{noteId}";
    private readonly HashSet<string> _mdEditors = new();  // element ids of currently-mounted EasyMDE instances

    private string _noteBody = "";
    private Guid? _editNoteId;
    private string _editNoteBody = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ReconcileEditors();

        // INV-37: bring the linked note into view once.
        if (!_focusDone && Notes.FirstOrDefault(n => n.IsCurrent && IsFocused(n)) is { } focus)
        {
            _focusDone = true;
            try { await JS.InvokeVoidAsync("imMotion.scrollToId", $"note-{focus.Id}"); }
            catch (JSException) { /* best effort */ }
        }

        // U-14: place the caret in the composer when reached via the 'n' shortcut (once it's mounted).
        if (AutofocusComposer && _mdEditors.Contains(NoteAddEditorId))
        {
            try { await JS.InvokeVoidAsync("markdownEditor.focus", NoteAddEditorId); }
            catch (JSException) { /* editor not ready; harmless */ }
            await OnAutofocusHandled.InvokeAsync();
        }
    }

    // Reconcile this tab's EasyMDE editors (add composer + the in-place edit editor) against what's needed.
    // Id-keyed via the shared markdownEditor JS API; the seed value applies on first mount only.
    private async Task ReconcileEditors()
    {
        var desired = new Dictionary<string, string>();
        if (CanEdit)
        {
            // FR-02: on (re)mount, seed the add composer from a stashed draft if one survived a tab switch.
            desired[NoteAddEditorId] = ComposerDrafts?.GetValueOrDefault(NoteAddEditorId) ?? _noteBody ?? "";
            if (_editNoteId is { } nid) desired[NoteEditEditorId(nid)] = _editNoteBody ?? "";
        }

        foreach (var id in _mdEditors.Where(id => !desired.ContainsKey(id)).ToList())
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); } catch (JSException) { /* ignore */ }
            _mdEditors.Remove(id);
        }
        foreach (var (id, seed) in desired)
        {
            if (_mdEditors.Contains(id)) continue;
            try { await JS.InvokeVoidAsync("markdownEditor.init", id, seed, new { mentions = MentionCandidates, entities = EntityCandidates }); _mdEditors.Add(id); }
            catch (JSException) { /* editor is a progressive enhancement */ }
        }
    }

    // The case's entities as inline "[[" tag candidates ({id, value, hint} for the editor JS).
    private object[] EntityCandidates =>
        (Entities ?? Array.Empty<CaseEntity>())
            .Select(e => (object)new
            {
                id = e.Id.ToString(),
                value = string.IsNullOrWhiteSpace(e.Label) ? e.Value : e.Label!,
                hint = Ui.Label(e.Type)   // the display name ("IP address"), not the enum identifier
            })
            .ToArray();

    /// <summary>Ctrl/⌘+Enter from the parent's hotkey dispatcher — submit whichever composer is active.</summary>
    public async Task SubmitAsync()
    {
        if (!CanEdit) return;
        if (_editNoteId is not null) await SaveNoteEdit(); else await AddNote();
    }

    private async Task AddNote()
    {
        try { _noteBody = await JS.InvokeAsync<string>("markdownEditor.getValue", NoteAddEditorId); }
        catch (JSException) { /* editor not mounted; fall back to bound value */ }
        if (string.IsNullOrWhiteSpace(_noteBody)) return;
        var mentions = await MentionsIn(NoteAddEditorId);
        try { await Cases.AddNoteAsync(CaseId, _noteBody, mentions); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IncidentManager.Application.Security.ForbiddenException) { Toasts.Error($"Couldn't add the note. {ex.Message}"); return; }
        _noteBody = "";
        ComposerDrafts?.Remove(NoteAddEditorId); // FR-02: the draft is now saved
        await OnChanged.InvokeAsync();
        Toasts.Success("Note added");
        try { await JS.InvokeVoidAsync("markdownEditor.setValue", NoteAddEditorId, ""); }
        catch (JSException) { /* best effort */ }
    }

    // The teammates whose "@Name" appears in the editor's text (an edit keeps its earlier mentions; only new ones notify).
    private async Task<string[]> MentionsIn(string editorId)
    {
        try { return await JS.InvokeAsync<string[]>("markdownEditor.getMentions", editorId); }
        catch (JSException) { return []; }
    }

    private async Task StartNoteEdit(AnalystNote note)
    {
        _editNoteId = note.Id;
        _editNoteBody = note.Body;
        try { await JS.InvokeVoidAsync("markdownEditor.setValue", NoteEditEditorId(note.Id), note.Body); }
        catch (JSException) { /* editor not mounted yet; ReconcileEditors seeds it from _editNoteBody */ }
    }

    private void CancelNoteEdit()
    {
        _editNoteId = null;
        _editNoteBody = "";
    }

    private async Task SaveNoteEdit()
    {
        if (_editNoteId is not { } noteId) return;
        try { _editNoteBody = await JS.InvokeAsync<string>("markdownEditor.getValue", NoteEditEditorId(noteId)); }
        catch (JSException) { /* fall back to bound value */ }
        if (string.IsNullOrWhiteSpace(_editNoteBody)) return;
        var mentions = await MentionsIn(NoteEditEditorId(noteId));
        try { await Cases.EditNoteAsync(CaseId, noteId, _editNoteBody, mentions); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IncidentManager.Application.Security.ForbiddenException) { Toasts.Error($"Couldn't save the note. {ex.Message}"); return; }
        CancelNoteEdit();
        await OnChanged.InvokeAsync();
        Toasts.Success("Note updated");
    }

    // FR-02: capture the add composer's unsubmitted text into the parent-owned store before teardown, so a
    // tab switch preserves it. Best-effort: if the editor/circuit is already gone, there's nothing to save.
    private async Task StashDraft()
    {
        if (ComposerDrafts is null) return;
        try
        {
            var val = await JS.InvokeAsync<string>("markdownEditor.getValue", NoteAddEditorId);
            if (!string.IsNullOrWhiteSpace(val)) ComposerDrafts[NoteAddEditorId] = val;
            else ComposerDrafts.Remove(NoteAddEditorId);
        }
        catch { /* editor not mounted or circuit tearing down — nothing to stash */ }
    }

    public async ValueTask DisposeAsync()
    {
        await StashDraft();
        foreach (var id in _mdEditors)
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); }
            catch { /* circuit may already be gone during teardown */ }
        }
        _mdEditors.Clear();
    }
}
