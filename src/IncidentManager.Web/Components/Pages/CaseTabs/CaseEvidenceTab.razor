    // Only image evidence can be previewed inline (the /inline endpoint serves image/* only).
    private static bool IsImageEvidence(Evidence ev) =>
        ev.ContentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;

    // REL-06: friendly, consistent message for a file over the size limit (used by the picker and drop paths). PROD-55:
    // the limit is the administrator's.
    private string TooLargeMessage(string name) =>
        $"“{name}” is larger than the {EvidenceRoom.Size(Evidence.Limits.MaxUploadBytes)} limit and wasn't uploaded.";

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.0} MB",
        >= 1024 => $"{bytes / 1024.0:0.0} KB",
        _ => $"{bytes} B"
    };

    private static string CustodyGlyph(string action) => action.ToLowerInvariant() switch
    {
        "uploaded" => "bi-upload",
        "downloaded" => "bi-download",
        "viewed" => "bi-eye",
        "transferred" => "bi-arrow-left-right",
        "withdrawn" => "bi-slash-circle",   // CAP-21
        _ => "bi-dot"
    };

    // ---- CAP-12: package evidence for hand-over ----
    // Pick the files (every file that stands, by default) and name the recipient, method and purpose once. Preparing it
    // checks everything and returns a ticket; the download is a plain link to that ticket, opened in a new tab (so nothing
    // picked or typed goes in a URL, and a failed download doesn't take the case page with it). Custody and the audit
    // trail are written when the download finishes.
    private bool _pkgOpen, _pkgBusy;
    private readonly HashSet<Guid> _pkgPicked = [];
    private string? _pkgTo, _pkgHow, _pkgWhy, _pkgError;
    private EvidencePackageStaged? _pkgReady;

    private bool PackageDirty => _pkgOpen && _pkgReady is null
        && (!string.IsNullOrWhiteSpace(_pkgTo) || !string.IsNullOrWhiteSpace(_pkgHow) || !string.IsNullOrWhiteSpace(_pkgWhy));

    private IEnumerable<Evidence> Packable => EvidenceItems.Where(e => !e.IsWithdrawn).OrderBy(e => e.CreatedAtUtc);

    private void StartPackage()
    {
        if (_pkgOpen)
        {
            // C7: closing it with a hand-over typed is refused rather than losing what's typed.
            if (PackageDirty) { Toasts.Info("Finish or cancel the package you're preparing first."); return; }
            _pkgOpen = false;
            return;
        }
        _pkgPicked.Clear();
        foreach (var e in Packable) _pkgPicked.Add(e.Id);
        (_pkgTo, _pkgHow, _pkgWhy, _pkgError, _pkgReady, _pkgOpen) = (null, null, null, null, null, true);
    }

    private void CancelPackage() => (_pkgOpen, _pkgReady, _pkgError) = (false, null, null);

    private void TogglePicked(Guid id)
    {
        if (!_pkgPicked.Add(id)) _pkgPicked.Remove(id);
        _pkgReady = null;   // a different pick is a different package
    }

    private void PickAll(bool all)
    {
        _pkgPicked.Clear();
        if (all) foreach (var e in Packable) _pkgPicked.Add(e.Id);
        _pkgReady = null;
    }

    private async Task PreparePackage()
    {
        if (_pkgBusy) return;   // C8
        _pkgBusy = true;
        _pkgError = null;
        try
        {
            var picked = Packable.Where(e => _pkgPicked.Contains(e.Id)).Select(e => e.Id).ToList();
            var ready = await Cases.StageEvidencePackageAsync(CaseId, picked, _pkgTo ?? "", _pkgHow, _pkgWhy ?? "");
            if (_disposed) return;   // C5
            _pkgReady = ready;
        }
        catch (Exception ex)
        {
            _pkgError = UserFacingError.Describe(ex, Logger, "preparing an evidence package", "Couldn't prepare the package. Try again.");
        }
        finally { _pkgBusy = false; }
    }

    // The download has been started (in its own tab): the form closes; what's recorded arrives with the next refresh.
    private void PackageStarted()
    {
        Toasts.Info("The package is downloading. Each file's chain of custody records the transfer as it starts, and how far it got when it ends.");
        (_pkgOpen, _pkgReady, _pkgTo, _pkgHow, _pkgWhy) = (false, null, null, null, null);
        foreach (var id in _custodyOpen.ToList()) _ = LoadCustodyLater(id);
    }

    // The custody list of an open row, read again once the download has had a moment to finish.
    private async Task LoadCustodyLater(Guid id)
    {
        await Task.Delay(TimeSpan.FromSeconds(5));
        if (_disposed) return;   // C5
        await InvokeAsync(async () =>
        {
            if (_disposed || !_custodyOpen.Contains(id)) return;
            await LoadCustody(id);
            StateHasChanged();
        });
    }

    private RenderFragment PackageForm() => __builder =>
    {
        var picked = Packable.Where(e => _pkgPicked.Contains(e.Id)).ToList();
        var bytes = picked.Sum(e => e.SizeBytes);
        <div class="card mb-3" role="region" aria-labelledby="pkg-title">
            <div class="card-body">
                <div class="small fw-semibold mb-1" id="pkg-title">Package evidence for hand-over</div>
                <div class="small text-muted mb-2">
                    One zip with the password “@EvidenceRisk.ZipPassword”, holding the files you pick and a MANIFEST.txt (the case, each file's
                    SHA-256, size, collection and chain of custody so far). Once the download has finished, each file's chain of custody
                    records the transfer and the audit trail records the package with its SHA-256. Up to @EvidencePackage.MaxFiles files and
                    @EvidenceRoom.Size(Evidence.Limits.MaxUploadBytes) in all. Withdrawn files can't be packaged.
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 small mb-1">
                    <span>@picked.Count of @Packable.Count() files · @FormatSize(bytes)</span>
                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => PickAll(true)" disabled="@_pkgBusy">All</button>
                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => PickAll(false)" disabled="@_pkgBusy">None</button>
                </div>
                <div class="im-pkg-files mb-2" role="group" aria-label="Files to package">
                    @foreach (var e in Packable)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="pkg-@e.Id" checked="@_pkgPicked.Contains(e.Id)" disabled="@_pkgBusy"
                                   @onchange="() => TogglePicked(e.Id)" />
                            <label class="form-check-label small" for="pkg-@e.Id">@e.OriginalFileName <span class="text-muted">· @FormatSize(e.SizeBytes)</span></label>
                        </div>
                    }
                </div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label small mb-0" for="pkg-to">Recipient</label>
                        <input id="pkg-to" class="form-control form-control-sm" maxlength="@EvidenceHandOver.MaxRecipientLength" @bind="_pkgTo" @bind:event="oninput"
                               @bind:after="() => _pkgReady = null" disabled="@_pkgBusy" placeholder="e.g. Outside counsel (Smith LLP)" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0" for="pkg-how">Method <span class="text-muted">(optional)</span></label>
                        <input id="pkg-how" class="form-control form-control-sm" maxlength="@EvidenceHandOver.MaxMethodLength" @bind="_pkgHow" @bind:event="oninput"
                               @bind:after="() => _pkgReady = null" disabled="@_pkgBusy" placeholder="e.g. Encrypted SFTP" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small mb-0" for="pkg-why">Purpose</label>
                        <input id="pkg-why" class="form-control form-control-sm" maxlength="@EvidenceHandOver.MaxPurposeLength" @bind="_pkgWhy" @bind:event="oninput"
                               @bind:after="() => _pkgReady = null" disabled="@_pkgBusy" placeholder="e.g. Forensic analysis under engagement letter" />
                    </div>
                </div>
                @if (_pkgError is not null) { <div class="text-danger small mt-2" role="alert">@_pkgError</div> }
                <div class="mt-2 d-flex flex-wrap align-items-center gap-2">
                    @if (_pkgReady is { } ready)
                    {
                        <a class="btn btn-sm btn-primary" href="evidence/package/@ready.Ticket" target="_blank" rel="noopener" @onclick="PackageStarted">
                            <span class="bi bi-download" aria-hidden="true"></span> Download the package
                        </a>
                        <span class="small text-muted" role="status">Ready: @IncidentManager.Application.Common.Plural.Of(ready.Files, "file", "files"), @FormatSize(ready.Bytes). The link works once, until @TimeDisp.Short(ready.ExpiresAtUtc).</span>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-primary" @onclick="PreparePackage" disabled="@(_pkgBusy || picked.Count == 0)">
                            @if (_pkgBusy) { <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> }
                            Prepare the package
                        </button>
                    }
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CancelPackage">Cancel</button>
                </div>
            </div>
        </div>
    };
}
