@* Case workspace — Evidence tab (UX-13, first slice of the interwoven pass). Upload (manual / paste /
   drag-drop, U-39), the hashed evidence list, per-item chain of custody (U-26), and inline image preview.
   The cross-tab concerns stay in the parent and are threaded in: the screenshot lightbox (OnPreview), the
   live-collab flash (FlashClass/FlashStyle), and a Reload after upload (OnChanged). The paste/drop shim is
   still registered by the parent against the element IDs kept here (evidence-dropzone / -file-input / -file-drop).
   CAP-08: an upload can say when, where from and by whom the file was collected; CAP-25: the list filters and sorts. *@
@using Microsoft.Extensions.Logging
@inject EvidenceService Evidence
@inject IncidentManager.Application.Cases.CaseService Cases
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject TimeDisplay TimeDisp
@inject ToastService Toasts
@inject ILogger<CaseEvidenceTab> Logger
@inject UnsavedEdits Edits
@inject IJSRuntime JS
@inject AntiforgeryStateProvider Antiforgery
@inject NavigationManager Nav
@inject IClock Clock
@implements IDisposable

<div id="evidence-dropzone">
    <AuthorizeView Policy="@Policies.EditCases">
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small mb-0">File</label>
                        <InputFile id="evidence-file-input" class="form-control form-control-sm" OnChange="OnFileSelected" disabled="@_busy" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small mb-0" for="ev-desc">Description</label>
                        <input id="ev-desc" class="form-control form-control-sm" @bind="_evDesc" @bind:event="oninput" disabled="@_busy"
                               maxlength="@IncidentManager.Application.Evidence.EvidenceService.MaxDescriptionLength" />
                    </div>
                    <div class="col-md-2">
                        @* REL-03: guard against a double-click (and give feedback on a slow/large upload) — the
                           button both disables and shows a spinner while a hashed upload is streaming, so the
                           same file can't be sent twice (which would create duplicate evidence + custody events). *@
                        <button class="btn btn-sm btn-primary w-100" @onclick="Upload" disabled="@(_file is null || _busy)">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><text>Uploading…</text>
                            }
                            else
                            {
                                <text>Upload</text>
                            }
                        </button>
                    </div>
                </div>
                @* CAP-08: when, where from and by whom it was collected, each optional (custody otherwise starts at the upload). *@
                <div class="row g-2 mt-0">
                    <div class="col-md-4">
                        <label class="form-label small mb-0" for="ev-coll-at">Collected (@TimeDisp.Label) <span class="text-muted">(optional)</span></label>
                        <DateTimeInput Past="true" TValue="DateTime?" id="ev-coll-at" class="form-control form-control-sm" @bind-Value="_collAt" disabled="@_busy" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-0" for="ev-coll-from">Collected from <span class="text-muted">(optional)</span></label>
                        <input id="ev-coll-from" class="form-control form-control-sm" @bind="_collFrom" @bind:event="oninput" disabled="@_busy"
                               maxlength="@IncidentManager.Domain.Entities.Evidence.MaxCollectedFromLength" placeholder="e.g. WKS-0142, a mailbox, Okta, the vendor" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small mb-0" for="ev-coll-by">Collected by <span class="text-muted">(optional)</span></label>
                        <input id="ev-coll-by" class="form-control form-control-sm" @bind="_collBy" @bind:event="oninput" disabled="@_busy"
                               maxlength="@IncidentManager.Domain.Entities.Evidence.MaxCollectedByLength" placeholder="e.g. J. Rivera (EDR live response)" />
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <span class="bi bi-clipboard me-1"></span>Paste a screenshot or drag files onto this tab. They're hashed and logged to the chain of custody like any upload.
                    Dropped files upload straight away, without a description but with the collection details above, if any; the description box is for the file you pick.
                    @if (_file is not null && !_busy) { <span class="ms-1">Ready: <strong>@_file.Name</strong>. Add a description and click Upload.</span> }
                </div>
                @if (_parts is { } up)
                {
                    @* PROD-56: a large upload, sent in parts. *@
                    var done = up.Size == 0 ? 0 : (int)(up.Sent * 100 / up.Size);
                    <div class="mt-2" role="status" aria-live="polite">
                        <div class="d-flex justify-content-between small">
                            <span>Uploading <strong>@up.Name</strong>: @EvidenceRoom.Size(up.Sent) of @EvidenceRoom.Size(up.Size)</span>
                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="CancelParts">Cancel</button>
                        </div>
                        <div class="progress" style="height:.5rem" aria-hidden="true">
                            <div class="progress-bar" style="width:@(done)%"></div>
                        </div>
                        <div class="small text-muted">Keep this page open until it finishes.</div>
                    </div>
                }
                @if (_uploadError is not null) { <div class="text-danger small mt-2">@_uploadError</div> }
                @if (_unfinished.Count > 0)
                {
                    @* PROD-59: large uploads cut off part-way (a restart, the page closed, the network lost), kept to carry on.
                       Rendered while one carries on too: its file is read from the input in this list. *@
                    <div class="mt-2 small" role="region" aria-label="Unfinished uploads">
                        <div class="fw-semibold">Unfinished uploads</div>
                        @foreach (var u in _unfinished)
                        {
                            <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                                <span class="bi bi-hourglass-split text-muted" aria-hidden="true"></span>
                                <strong>@u.FileName</strong>
                                <span class="text-muted">@EvidenceRoom.Size(u.Received) of @EvidenceRoom.Size(u.Size) arrived; last part @TimeDisp.Long(u.LastActivity)</span>
                                <label class="btn btn-sm btn-outline-primary mb-0 @(_busy ? "disabled" : "")" for="@($"evidence-resume-{u.Id}")">Pick it again to carry on</label>
                                <InputFile id="@($"evidence-resume-{u.Id}")" class="d-none" OnChange="e => OnResumePicked(u, e)" disabled="@_busy" />
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => DiscardUnfinished(u)" disabled="@_busy">Discard</button>
                            </div>
                        }
                        <div class="text-muted mt-1">Each is kept for 24 hours after its last part arrived.</div>
                    </div>
                }

                @* Hidden sinks the paste-drop shim (wwwroot/js/paste-drop.js) feeds: paste stages one
                   screenshot in the picker; a drop bulk-uploads immediately. Both reuse InputFile streaming. *@
                <InputFile id="evidence-file-drop" class="d-none" multiple OnChange="OnDropped" />
            </div>
        </div>
    </AuthorizeView>

    @if (EvidenceItems.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><span class="bi bi-file-earmark-lock" aria-hidden="true"></span></div>
            <div class="empty-state-title">No evidence yet</div>
            <div class="empty-state-msg">Upload, paste or drop files here. Each file is hashed on arrival and gets its own chain of custody.</div>
        </div>
    }
    else
    {
        @* CAP-25: a filter over name, description and hash prefix (kept in the page, never the URL: C7), quick chips, and
           sortable columns. *@
        var shown = Shown();
        // CAP-21: withdrawn files are counted apart and listed only with the Withdrawn chip on.
        var withdrawnCount = EvidenceItems.Count(e => e.IsWithdrawn);
        var listable = _chips.Contains(EvidenceChip.Withdrawn) ? EvidenceItems.Count : EvidenceItems.Count - withdrawnCount;
        <div class="im-ev-bar" role="search" aria-label="Filter the evidence">
            <input type="search" class="form-control form-control-sm im-ev-filter" placeholder="Filter by name, description or hash"
                   aria-label="Filter by name, description or hash" @bind="_filter" @bind:event="oninput" />
            <div class="im-counts" role="group" aria-label="Show only">
                @foreach (var (chip, label) in ChipLabels)
                {
                    <button type="button" class="im-count @(_chips.Contains(chip) ? "on" : "")" aria-pressed="@Ui.Aria(_chips.Contains(chip))"
                            @onclick="() => ToggleChip(chip)">@label</button>
                }
                @if (withdrawnCount > 0)
                {
                    <button type="button" class="im-count @(_chips.Contains(EvidenceChip.Withdrawn) ? "on" : "")" aria-pressed="@Ui.Aria(_chips.Contains(EvidenceChip.Withdrawn))"
                            title="Files withdrawn from this case: kept, but off its record" @onclick="() => ToggleChip(EvidenceChip.Withdrawn)">
                        Withdrawn (@withdrawnCount)
                    </button>
                }
            </div>
            @if (shown.Count != listable)
            {
                <span class="small text-muted" role="status">@shown.Count of @listable
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="ClearFilter">Show all</button></span>
            }
            @if (CanEdit && withdrawnCount < EvidenceItems.Count)
            {
                @* CAP-12: many files handed over at once, in one recorded zip. *@
                <button type="button" class="btn btn-sm btn-outline-primary ms-auto" @onclick="StartPackage" aria-expanded="@Ui.Aria(_pkgOpen)"
                        title="Download several files as one zip for hand-over, with a manifest, recorded in each file's chain of custody">
                    <span class="bi bi-file-earmark-zip" aria-hidden="true"></span> Package evidence…
                </button>
            }
        </div>
        @if (_pkgOpen)
        {
            @PackageForm()
        }
        @if (shown.Count == 0)
        {
            <p class="small text-muted">
                @if (listable == 0)
                {
                    <text>Every file on this case has been withdrawn. </text>
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => ToggleChip(EvidenceChip.Withdrawn)">Show the withdrawn files</button>
                }
                else
                {
                    <text>No files match. </text><button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="ClearFilter">Show all @(EvidenceItems.Count - withdrawnCount)</button>
                }
            </p>
        }
        else
        {
        @* CAP-25: at a narrow width (641 px with the side menu open) the table scrolls in its own box, not the page. *@
        <div class="table-responsive">
        <table class="table table-sm align-middle im-ev-table">
            <thead><tr>@SortTh("File", EvidenceSort.Name)@SortTh("Size", EvidenceSort.Size)<th>SHA-256</th>@SortTh("Collected", EvidenceSort.Collected)@SortTh("Uploaded", EvidenceSort.Uploaded)<th></th></tr></thead>
            <tbody>
                @foreach (var ev in shown)
                {
                    <tr class="im-enter @FlashClass?.Invoke(ev.Id) @(ev.IsWithdrawn ? "im-ev-withdrawn" : "")" style="@FlashStyle?.Invoke(ev.Id)" @key="ev.Id" id="ev-@ev.Id">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (IsImageEvidence(ev))
                                {
                                    @* Click the thumbnail to preview the image in a lightbox (U-40 preview, reused). *@
                                    <button type="button" class="btn p-0 border-0 bg-transparent" @onclick="() => OnPreview.InvokeAsync(ev.Id)" title="Preview">
                                        <img src="evidence/@ev.Id/inline" alt="" loading="lazy"
                                             style="max-height:36px;max-width:56px;border-radius:.25rem;border:1px solid var(--bs-border-color);cursor:zoom-in" />
                                    </button>
                                }
                                <div>
                                    @* RD-06: the file opens in its panel: preview, integrity, custody, what cites it. *@
                                    <button type="button" class="btn btn-link p-0 text-start im-evp-open" @onclick="() => OnOpenEvidence.InvokeAsync(ev.Id)"
                                            title="Open the file's panel">@ev.OriginalFileName</button>
                                    @if (EvidenceRisk.IsRisky(ev.OriginalFileName, ev.ContentType))
                                    {
                                        <span class="im-badge im-b-warn ms-1" title="@EvidenceRisk.Sentence(ev.OriginalFileName, ev.ContentType)"><span class="bi bi-exclamation-triangle" aria-hidden="true"></span> Can run</span>
                                    }
                                    @if (ev.IsWithdrawn)
                                    {
                                        <span class="im-badge im-b-neutral ms-1"><span class="bi bi-slash-circle" aria-hidden="true"></span> Withdrawn</span>
                                    }
                                    <br /><small class="text-muted">@ev.Description</small>
                                    @if (ev.IsWithdrawn)
                                    {
                                        @* CAP-21: struck through, with who withdrew it, when and why. *@
                                        <div class="small im-ev-withdrawn-why">Withdrawn by @Users.DisplayFor(ev.WithdrawnBy) · @TimeDisp.Long(ev.WithdrawnAtUtc!.Value): @ev.WithdrawnReason</div>
                                    }
                                    @{
                                        var citedBy = Citations.Count(x => x.EvidenceId == ev.Id && _currentEntries.Contains(x.TimelineEntryId));   // BUG-443
                                        var inBrief = BriefText?.Contains($"evidence:{ev.Id}", StringComparison.OrdinalIgnoreCase) == true;   // INV-33
                                        var cites = new List<string>();
                                        if (citedBy > 0) cites.Add(IncidentManager.Application.Common.Plural.Of(citedBy, "timeline entry", "timeline entries"));
                                        if (inBrief) cites.Add("the brief");
                                    }
                                    @if (cites.Count > 0)
                                    {
                                        @* INV-10: what relies on this item. *@
                                        <div class="small"><span class="im-badge im-b-info"><span class="bi bi-link-45deg" aria-hidden="true"></span> Cited by @string.Join(" and ", cites)</span></div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>@FormatSize(ev.SizeBytes)</td>
                        <td><code class="small">@IncidentManager.Application.Common.TextFit.Cap(ev.Sha256, 17)</code></td>
                        @* CAP-08: when, where from and by whom it was collected, when recorded. *@
                        <td class="small text-muted im-ev-collected">
                            @if (ev.CollectedAtUtc is { } collectedAt) { @TimeDisp.Long(collectedAt) }
                            else if (ev.HasCollection) { <span>Time not recorded</span> }
                            else { <span aria-label="Not recorded">—</span> }
                            @if (EvidenceCollection.Source(ev) is { } source) { <br /><span>@source</span> }
                        </td>
                        <td class="small text-muted">@TimeDisp.Long(ev.CreatedAtUtc)<br />@Users.DisplayFor(ev.CreatedBy)</td>
                        <td>
                            @* PROD-58: the actions wrap (each whole) rather than push the row past its column when the side panel is open. *@
                            <div class="d-flex flex-wrap align-items-center gap-1 text-nowrap">
                                @if (IsImageEvidence(ev))
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OnPreview.InvokeAsync(ev.Id)">Preview</button>
                                }
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleCustody(ev.Id)"
                                        title="Access and transfer history"
                                        aria-expanded="@(_custodyOpen.Contains(ev.Id) ? "true" : "false")">
                                    <span class="bi @(_custodyOpen.Contains(ev.Id) ? "bi-chevron-down" : "bi-clock-history")" aria-hidden="true"></span> Custody
                                </button>
                                @* PROD-58: a file that can run downloads first inside a zip with the password "infected". *@
                                @if (EvidenceRisk.ZipFirst(Evidence.Limits.SafeDownloadMode, ev.OriginalFileName, ev.ContentType))
                                {
                                    <a class="btn btn-sm btn-primary" href="evidence/@ev.Id/safe" target="_blank"
                                       title="A zip with the password &quot;infected&quot;, so it can't run by accident">
                                        <span class="bi bi-file-earmark-zip" aria-hidden="true"></span> Download safely
                                    </a>
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => AskPlainDownload(ev)">Plain file</button>
                                }
                                else
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="evidence/@ev.Id" target="_blank">Download</a>
                                    <a class="btn btn-sm btn-link" href="evidence/@ev.Id/safe" target="_blank"
                                       title="In a zip with the password &quot;infected&quot;">As zip</a>
                                }
                                @if (CanEdit && !ev.IsWithdrawn)
                                {
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => ToggleTask(ev.Id)"
                                            title="Start a task about this file"><span class="bi bi-plus-lg" aria-hidden="true"></span> Task</button>
                                    @* PROD-59: a sample's SHA-256 is nearly always an indicator. *@
                                    <button type="button" class="btn btn-sm btn-link" @onclick="() => HashToIoc(ev)" disabled="@_iocBusy.Contains(ev.Id)"
                                            title="Add this file's SHA-256 to IOCs &amp; entities"><span class="bi bi-fingerprint" aria-hidden="true"></span> Hash as IOC</button>
                                }
                            </div>
                        </td>
                    </tr>
                    var evTasks = Tasks.Where(t => t.AboutRef == $"{ActionItem.AboutEvidence}:{ev.Id}").ToList();
                    @if (evTasks.Count > 0 || _taskFor.Contains(ev.Id))
                    {
                        @* INV-28: the tasks about this file, and a new one. *@
                        <tr class="im-custody-row">
                            <td colspan="6">
                                @if (evTasks.Count > 0)
                                {
                                    <div class="tl-tasks">
                                        @foreach (var t in evTasks)
                                        {
                                            <span class="tl-task @(t.IsOpen ? "" : "tl-task-done")"><span class="bi @(t.IsOpen ? "bi-square" : "bi-check2-square")" aria-hidden="true"></span> @t.Title</span>
                                        }
                                    </div>
                                }
                                @if (_taskFor.Contains(ev.Id))
                                {
                                    <QuickTask CaseId="CaseId" About="@($"{ActionItem.AboutEvidence}:{ev.Id}")" Placeholder="A task about this file"
                                               OnDone="async () => { _taskFor.Remove(ev.Id); await OnChanged.InvokeAsync(); }" OnCancel="() => _taskFor.Remove(ev.Id)" />
                                }
                            </td>
                        </tr>
                    }
                    @if (_custodyOpen.Contains(ev.Id))
                    {
                        <tr class="im-custody-row">
                            <td colspan="6" class="bg-body-tertiary">
                                <div class="small fw-semibold mb-2">
                                    <span class="bi bi-shield-check me-1" aria-hidden="true"></span>Chain of custody
                                </div>
                                <WhyThisMatters Class="mb-2">
                                    Each file's SHA-256 is recorded at upload and re-checked on a schedule. Every download, preview and
                                    hand-off is logged with who and when, so counsel, insurers, law enforcement or regulators can rely on
                                    the evidence later.
                                </WhyThisMatters>
                                @if (_custodyLoading.Contains(ev.Id))
                                {
                                    <span class="skel skel-line" style="width:40%;display:block"></span>
                                }
                                else if (_custody.TryGetValue(ev.Id, out var events) && events.Count > 0)
                                {
                                    <table class="table table-sm mb-0 im-table">
                                        <thead><tr><th>When (@TimeDisp.Label)</th><th>Action</th><th>By</th><th>Details</th></tr></thead>
                                        <tbody>
                                            @foreach (var c in events)
                                            {
                                                <tr>
                                                    <td class="small im-data text-nowrap">@TimeDisp.Long(c.AtUtc)</td>
                                                    <td class="small"><span class="bi @CustodyGlyph(c.Action) me-1" aria-hidden="true"></span>@c.Action</td>
                                                    <td class="small">@Users.DisplayFor(c.Actor)</td>
                                                    <td class="small text-muted">@c.Details</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <span class="small text-muted">No custody events recorded.</span>
                                }
                                <AuthorizeView Policy="@Policies.EditCases" Context="xfer">
                                    @if (_transfer.IsOpenFor(ev.Id))
                                    {
                                        @* PROD-13: a hand-off outside CaseBook is attested here, since no export ships evidence bytes. *@
                                        <div class="border rounded p-2 mt-2 bg-body">
                                            <div class="small fw-semibold mb-1">Record a transfer</div>
                                            <div class="small text-muted mb-2">Record who received a copy outside CaseBook, how and why. It's added to the chain of custody and the audit trail.</div>
                                            <div class="row g-2">
                                                <div class="col-md-4">
                                                    <label class="form-label small mb-0" for="xfer-to-@ev.Id">Recipient</label>
                                                    <input id="xfer-to-@ev.Id" class="form-control form-control-sm" maxlength="200" @bind="_xferTo" @bind:event="oninput" disabled="@_xferBusy"
                                                           placeholder="e.g. Outside counsel (Smith LLP)" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small mb-0" for="xfer-how-@ev.Id">Method <span class="text-muted">(optional)</span></label>
                                                    <input id="xfer-how-@ev.Id" class="form-control form-control-sm" maxlength="100" @bind="_xferHow" @bind:event="oninput" disabled="@_xferBusy"
                                                           placeholder="e.g. Encrypted SFTP" />
                                                </div>
                                                <div class="col-md-5">
                                                    <label class="form-label small mb-0" for="xfer-why-@ev.Id">Purpose</label>
                                                    <input id="xfer-why-@ev.Id" class="form-control form-control-sm" maxlength="500" @bind="_xferWhy" @bind:event="oninput" disabled="@_xferBusy"
                                                           placeholder="e.g. Forensic analysis under engagement letter" />
                                                </div>
                                            </div>
                                            @if (_xferError is not null) { <div class="text-danger small mt-1">@_xferError</div> }
                                            <div class="mt-2 d-flex gap-2">
                                                <button class="btn btn-sm btn-primary" @onclick="SaveTransfer" disabled="@_xferBusy">Record transfer</button>
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelTransfer">Cancel</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-link p-0 mt-2" @onclick="() => StartTransfer(ev.Id)">
                                            <span class="bi bi-arrow-left-right me-1" aria-hidden="true"></span>Record a transfer
                                        </button>
                                    }
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>
        }
    }
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<Evidence> EvidenceItems { get; set; } = [];
    /// <summary>INV-10: timeline entries' citations, to say what relies on each item.</summary>
    [Parameter] public IReadOnlyList<EvidenceCitation> Citations { get; set; } = [];
    /// <summary>BUG-443: the case's timeline entries; only citations by current ones count (a retracted entry's stay on it).</summary>
    [Parameter] public IReadOnlyList<TimelineEntry> Entries { get; set; } = [];
    private HashSet<Guid> _currentEntries = [];
    protected override void OnParametersSet() => _currentEntries = Entries.Where(e => e.IsCurrent).Select(e => e.Id).ToHashSet();
    /// <summary>Open the parent-owned screenshot lightbox (shared with the Timeline) for an image evidence id.</summary>
    [Parameter] public EventCallback<Guid> OnPreview { get; set; }
    /// <summary>Reload the case after an upload so the rest of the workspace reflects the new evidence.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Live-collab flash hooks (parent owns the flash state); render an item's flash class / hue.</summary>
    [Parameter] public Func<Guid, string?>? FlashClass { get; set; }
    [Parameter] public Func<Guid, string?>? FlashStyle { get; set; }
    /// <summary>INV-28: may start a task about a file.</summary>
    [Parameter] public bool CanEdit { get; set; }
    /// <summary>INV-28: the case's tasks, to show the ones about each file.</summary>
    [Parameter] public IReadOnlyList<ActionItem> Tasks { get; set; } = [];
    /// <summary>RD-06: open a file in the evidence panel.</summary>
    [Parameter] public EventCallback<Guid> OnOpenEvidence { get; set; }
    /// <summary>INV-33: the current brief's text (all parts), to say when it cites a file.</summary>
    [Parameter] public string? BriefText { get; set; }
    [CascadingParameter] public EditRegion? Region { get; set; }

    // BUG-578: a description or a transfer typed and not saved is asked about before a tab switch, leaving the case or
    // the time-display redraw hides it (a picked file alone isn't: picking it again is one click).
    protected override void OnInitialized()
    {
        // CAP-08: and the collection details typed with it.
        Edits.Track(this, "the evidence description you're writing", () => !string.IsNullOrWhiteSpace(_evDesc)
            || _collAt is not null || !string.IsNullOrWhiteSpace(_collFrom) || !string.IsNullOrWhiteSpace(_collBy), Region);
        Edits.Track(this, "the transfer you're recording", () => TransferDirty, Region);
        Edits.Track(this, "the evidence package you're preparing", () => PackageDirty, Region);   // CAP-12
        // PROD-56: leaving mid-way through a large upload stops it, so it asks first.
        Edits.Track(this, "the upload in progress", () => _parts is not null, Region);
    }

    // PROD-59: this person's large uploads to this case that stopped part-way, offered to carry on.
    private IReadOnlyList<EvidenceService.UnfinishedUpload> _unfinished = [];

    protected override async Task OnInitializedAsync() => await RefreshUnfinishedAsync();

    private async Task RefreshUnfinishedAsync()
    {
        try { _unfinished = await Evidence.UnfinishedUploadsAsync(CaseId); }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Couldn't list the unfinished uploads");   // the list is a convenience: never fails the tab
        }
    }

    private async Task OnResumePicked(EvidenceService.UnfinishedUpload u, InputFileChangeEventArgs e)
    {
        if (_busy) return;
        _uploadError = null;
        var file = e.File;
        if (!string.Equals(file.Name, u.FileName, StringComparison.Ordinal) || file.Size != u.Size)
        {
            _uploadError = $"That isn't the same file. Pick {u.FileName} ({u.Size:N0} bytes) to carry on.";
            return;
        }
        _busy = true;
        try
        {
            if (await SendInPartsAsync(file, $"evidence-resume-{u.Id}", 0, description: null, resumeId: u.Id) is not { } recorded) return;
            await OnChanged.InvokeAsync();
            Toasts.Success($"Uploaded {u.FileName}");
            await NoteElsewhereAsync(recorded, u.FileName);
            await WarnIfNearLimitAsync();
        }
        catch (Exception ex)
        {
            _uploadError = UserFacingError.Describe(ex, Logger, "resuming an upload", "Couldn't carry on the upload. Try again.");
        }
        finally
        {
            _busy = false;
            await RefreshUnfinishedAsync();
        }
    }

    private async Task DiscardUnfinished(EvidenceService.UnfinishedUpload u)
    {
        if (_busy) return;   // C8: once at a time
        _busy = true;
        try { await Evidence.AbandonUploadAsync(u.Id); }
        catch (Exception ex)
        {
            _uploadError = UserFacingError.Describe(ex, Logger, "discarding an upload", "Couldn't discard the upload. Try again.");
        }
        finally
        {
            _busy = false;
            await RefreshUnfinishedAsync();
        }
    }

    // PROD-58: the plain file of one that can run is a deliberate choice, asked first.
    private ConfirmDialog? _confirm;

    private void AskPlainDownload(Evidence ev)
    {
