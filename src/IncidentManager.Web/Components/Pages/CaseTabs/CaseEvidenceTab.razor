    public void Dispose()
    {
        _disposed = true;
        Edits.Forget(this);
        if (_parts is { } u)
        {
            // Leaving stops the upload; PROD-59: the server keeps it, to carry on (the page's own call may be gone with it).
            _ = JS.InvokeVoidAsync("imChunkedUpload.stop", u.Key).AsTask().ContinueWith(_ => { }, TaskScheduler.Default);
            u.Ended.TrySetResult("");
        }
        _self?.Dispose();
    }
    // BUG-578: the rows with a quick task open. Opening one on another row used to close (and empty) the first.
    private readonly HashSet<Guid> _taskFor = [];
    private void ToggleTask(Guid id) { if (!_taskFor.Add(id)) _taskFor.Remove(id); }

    private IBrowserFile? _file;
    private string? _evDesc;
    private string? _uploadError;
    // REL-03: true while an upload is streaming, so a second click / drop can't fire a duplicate upload and
    // the UI can show progress on a slow or large file.
    private bool _busy;

    // U-26: per-evidence chain-of-custody, lazily loaded when a row is expanded.
    private readonly HashSet<Guid> _custodyOpen = new();
    private readonly HashSet<Guid> _custodyLoading = new();
    private readonly Dictionary<Guid, List<ChainOfCustodyEvent>> _custody = new();

    // Manual picker or a pasted screenshot (via the shim) stages one file to describe + Upload.
    // BUG-483: a paste while an upload streams is refused, and says so, as the picker is disabled then. It replaced the file
    // being uploaded, which the upload then cleared, so the paste was dropped without a word (and a failed upload's error
    // sat beside the pasted file's name, with the description typed for the other one).
    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        if (_busy) { Toasts.Warning("An upload is still running. Paste the screenshot again once it's finished."); return; }
        _file = e.File;
    }

    private async Task Upload()
    {
        if (_file is null || _busy) return; // REL-03: ignore a re-click while an upload is in flight
        _uploadError = null;
        // REL-06: catch the common, expected failure (over the size cap) up front with a clear message,
        // rather than letting the stream throw a generic IOException that reads as an internal error.
        if (_file.Size > Evidence.Limits.MaxUploadBytes) { _uploadError = TooLargeMessage(_file.Name); return; }
        _busy = true;
        try
        {
            var name = _file.Name;
            var sentDesc = _evDesc;
            var (sentAt, sentFrom, sentBy) = (_collAt, _collFrom, _collBy);
            if (await SendAsync(_file, "evidence-file-input", 0, sentDesc, Collection()) is not { } recorded) return;
            _file = null;
            _evDesc = DraftText.ClearIfUnchanged(_evDesc, sentDesc, null);   // BUG-601 (the box is disabled while it uploads)
            if (_collAt == sentAt) _collAt = null;   // CAP-08: likewise the collection
            _collFrom = DraftText.ClearIfUnchanged(_collFrom, sentFrom, null);
            _collBy = DraftText.ClearIfUnchanged(_collBy, sentBy, null);
            await OnChanged.InvokeAsync();
            Toasts.Success($"Uploaded {name}");
            await NoteElsewhereAsync(recorded, name);
            await WarnIfNearLimitAsync();
        }
        catch (Exception ex)
        {
            // REL-06: domain messages pass through; EF/IO/internal errors become a plain line (detail logged).
            _uploadError = UserFacingError.Describe(ex, Logger, "uploading evidence",
                "Couldn't upload the file. Try again.");
        }
        finally
        {
            _busy = false;
        }
    }

    // PROD-56: a file up to 100 MB goes through the page as before; a larger one in parts (chunked-upload.js), with
    // progress. The recorded evidence's id; null when the person cancelled a large upload (nothing was recorded); a
    // failure throws with its reason.
    // CAP-08: with when, where from and by whom it was collected, on both paths.
    private async Task<Guid?> SendAsync(IBrowserFile file, string inputId, int index, string? description, EvidenceCollection? collected)
    {
        if (file.Size <= EvidenceUploadSessions.InPageMaxBytes)
        {
            await using var stream = file.OpenReadStream(EvidenceUploadSessions.InPageMaxBytes); // NOSONAR S5693: evidence up to 100 MB by design (PROD-56); larger goes in 8 MB parts, and EvidenceRoom checks the admin limit first
            return (await Evidence.UploadAsync(CaseId, file.Name, file.ContentType, stream, description, file.Size, collected)).Id;
        }
        return await SendInPartsAsync(file, inputId, index, description, collected);
    }

    // CAP-08: the collection typed in the form; the time is a wall-clock time in the viewer's zone.
    private DateTime? _collAt;
    private string? _collFrom, _collBy;

    private EvidenceCollection? Collection()
    {
        var c = new EvidenceCollection(_collAt is { } at ? WallClock.ToUtc(at, TimeDisp.Zone, Clock.UtcNow) : null, _collFrom, _collBy);
        return c.IsEmpty ? null : c;
    }

    // PROD-59: adds the file's SHA-256 to the case's indicators (or says it's already one), unjudged: the analyst sets the
    // verdict on IOCs & entities. One add per file at a time (C8).
    private readonly HashSet<Guid> _iocBusy = [];

    private async Task HashToIoc(Evidence ev)
    {
        if (!_iocBusy.Add(ev.Id)) return;
        try
        {
            var name = ev.OriginalFileName;
            var r = await Cases.AddOrMatchEntityAsync(CaseId, EntityType.FileHash, ev.Sha256,
                IncidentManager.Application.Common.TextFit.Cap(name, 400), EntityDisposition.Unknown,
                IncidentManager.Application.Common.TextFit.Cap($"SHA-256 of evidence file {name}.", 4000), "Evidence");
            if (_disposed) return;   // C5: the tab has gone
            if (r.AlreadyOnCase) Toasts.Info($"{name}'s SHA-256 is already an indicator here (verdict: {r.Disposition}).");
            else
            {
                Toasts.Success($"Added {name}'s SHA-256 to IOCs & entities. Set its verdict there.");
                await OnChanged.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Toasts.Warning(UserFacingError.Describe(ex, Logger, "adding a hash as an indicator", "Couldn't add the hash. Try again."));
        }
        finally { _iocBusy.Remove(ev.Id); }
    }

    // PROD-59: the same file is already evidence in other cases this person can see: say where (a hint, not a refusal).
    private async Task NoteElsewhereAsync(Guid evidenceId, string name)
    {
        try
        {
            if (await Evidence.AlsoEvidenceInAsync(evidenceId) is { Count: > 0 } cases)
                Toasts.Info($"{name} is also evidence in {string.Join(", ", cases)}.");
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Couldn't look up other cases holding the same evidence");   // a hint only: never fails the upload
        }
    }

    // PROD-56: the large upload in progress (one at a time from this tab), its progress, and how it ended.
    private sealed class PartsUpload(string key, string name, long size)
    {
        public string Key { get; } = key;
        public string Name { get; } = name;
        public long Size { get; } = size;
        public long Sent { get; set; }
        public Guid? RecordedId { get; set; }
        public TaskCompletionSource<string?> Ended { get; } = new(TaskCreationOptions.RunContinuationsAsynchronously);   // null: done; "": cancelled
    }

    private PartsUpload? _parts;
    private DotNetObjectReference<CaseEvidenceTab>? _self;
    private bool _disposed;

    // CAP-08: a resumed upload carries the collection it began with (the server kept it), so it takes none.
    private async Task<Guid?> SendInPartsAsync(IBrowserFile file, string inputId, int index, string? description,
        EvidenceCollection? collected = null, string? resumeId = null)
    {
        var token = Antiforgery.GetAntiforgeryToken()?.Value
                    ?? throw new InvalidOperationException("The page's security token is missing. Reload the page and try again.");
        _self ??= DotNetObjectReference.Create(this);
        var upload = _parts = new PartsUpload(Guid.NewGuid().ToString("N"), file.Name, file.Size);
        StateHasChanged();
        try
        {
            if (resumeId is null)
                await JS.InvokeVoidAsync("imChunkedUpload.start", _self, upload.Key, inputId, index, CaseId, description, token,
                    new { collectedAt = collected?.AtUtc, collectedFrom = collected?.From, collectedBy = collected?.By });
            else await JS.InvokeVoidAsync("imChunkedUpload.resume", _self, upload.Key, inputId, index, resumeId, token);
            var failed = await upload.Ended.Task;
            if (failed is null) return upload.RecordedId ?? throw new InvalidOperationException("The upload finished without a record.");
            if (failed.Length == 0) { Toasts.Info($"Upload of {upload.Name} cancelled. Nothing was recorded."); return null; }
            // PROD-59: one that stopped part-way is kept on the server: say so, and how to carry on.
            await RefreshUnfinishedAsync();
            if (!_disposed && _unfinished.Any(x => x.FileName == upload.Name && x.Size == upload.Size))
                failed = failed.TrimEnd().TrimEnd('.') + ". What arrived is kept: pick the file again under Unfinished uploads to carry on (within 24 hours).";
            throw new ArgumentException(failed);
        }
        finally
        {
            if (ReferenceEquals(_parts, upload)) _parts = null;
        }
    }

    [JSInvokable]
    public Task OnChunkedProgress(string key, long sent, long size) => Report(key, u => u.Sent = sent);

    [JSInvokable]
    public Task OnChunkedDone(string key, string id) => Report(key, u =>
    {
        u.RecordedId = Guid.TryParse(id, out var recorded) ? recorded : null;
        u.Ended.TrySetResult(null);
    });

    [JSInvokable]
    public Task OnChunkedFailed(string key, string reason) => Report(key, u => u.Ended.TrySetResult(reason));

    // C5: a callback for an upload this tab no longer shows (or after it's gone) changes nothing.
    private Task Report(string key, Action<PartsUpload> apply) => InvokeAsync(() =>
    {
        if (_disposed || _parts is not { } u || u.Key != key) return;
        apply(u);
        StateHasChanged();
    });

    private async Task CancelParts()
    {
        if (_parts is { } u) await JS.InvokeVoidAsync("imChunkedUpload.cancel", u.Key);
    }

    // PROD-55: past 90 % of the evidence storage limit, the uploader hears it (and so does the log, from the service).
    private async Task WarnIfNearLimitAsync()
    {
        try
        {
            var use = await Evidence.StorageUseAsync();
            if (use.NearQuota)
                Toasts.Warning($"Evidence now takes {EvidenceRoom.Size(use.UsedBytes)} of its {EvidenceRoom.Size(use.QuotaBytes!.Value)} limit. " +
                               "Tell an administrator before it fills up.");
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "Couldn't read evidence storage use after an upload.");
        }
    }

    // U-39: files dropped onto the Evidence tab (via the paste-drop shim) upload immediately — a drop is a
    // bulk gesture, so we don't stage them for a per-file description. Same hashed/custody UploadAsync path.
    private const int MaxDropFiles = 50;

    // BUG-603: a second drop while one is being read in is ignored (_busy, below, covers the uploads themselves).
    private readonly InFlight _dropping = new();
    private Task OnDropped(InputFileChangeEventArgs e) => _dropping.Run(() => UploadDropped(e));

    private async Task UploadDropped(InputFileChangeEventArgs e)
    {
        // REL-03: ignore a drop while an upload batch is already streaming. BUG-483: say so; it was dropped without a word.
        if (_busy) { Toasts.Warning("An upload is still running. Drop the files again once it's finished."); return; }
        _uploadError = null;
        // BUG-341: GetMultipleFiles throws past its limit, outside the per-file catch; DroppedFiles answers null instead.
        if (DroppedFiles.UpTo(e, MaxDropFiles) is not { } files) { _uploadError = $"Drop up to {MaxDropFiles} files at a time."; return; }
        _busy = true;
        var uploaded = 0;
        var recorded = new List<(Guid Id, string Name)>();
        // CAP-08: a drop is usually one collection (the logs pulled from one host), so the collection details typed in the
        // form go with each file, and stay in the form.
        var collected = Collection();
        try
        {
            for (var i = 0; i < files.Count; i++)
            {
                var f = files[i];
                if (f.Size > Evidence.Limits.MaxUploadBytes) { _uploadError = TooLargeMessage(f.Name); continue; } // REL-06
                try
                {
                    // REV-34: the description box belongs to the file staged in the picker, not to these.
                    if (await SendAsync(f, "evidence-file-drop", i, description: null, collected) is { } id)
                    {
                        uploaded++;
                        recorded.Add((id, f.Name));
                    }
                }
                catch (Exception ex)
                {
                    // REL-06: per-file — keep the name, map the reason (domain verbatim / internal generic).
                    _uploadError = $"{f.Name}: {UserFacingError.Describe(ex, Logger, "uploading evidence", "couldn't be uploaded. Try again.")}";
                }
            }
        }
        finally
        {
            _busy = false;
        }
        if (uploaded > 0)
        {
            await OnChanged.InvokeAsync();
            Toasts.Success($"Uploaded {uploaded} file{(uploaded == 1 ? "" : "s")}");
            foreach (var (id, name) in recorded) await NoteElsewhereAsync(id, name);
        }
    }

    // U-26: show/hide an evidence item's chain of custody, loading it on each expand (a preview or a transfer
    // since the last look adds entries, PROD-13); the previous list stays visible while it refreshes.
    private async Task ToggleCustody(Guid evidenceId)
    {
        if (_custodyOpen.Contains(evidenceId))
        {
            // BUG-578: collapsing hides the row's transfer form: refused while it holds text, else it's let go (so another
            // row's can open).
            if (_transfer.IsOpenFor(evidenceId))
            {
                if (TransferDirty) { Toasts.Info(EditSlot.Refusal("transfer")); return; }
                _transfer.Close();
            }
            _custodyOpen.Remove(evidenceId);
            return;
        }
        _custodyOpen.Add(evidenceId);
        await LoadCustody(evidenceId);
    }

    // BUG-601: per file, the newest load's list is the one shown (one from before a transfer doesn't land after it).
    private readonly KeyedLoad<Guid> _custodyLoads = new();

    private async Task LoadCustody(Guid evidenceId)
    {
        if (!_custody.ContainsKey(evidenceId)) _custodyLoading.Add(evidenceId);
        var t = _custodyLoads.Begin(evidenceId);
        List<ChainOfCustodyEvent> events;
        try { events = await Evidence.GetCustodyAsync(evidenceId); }
        catch { events = new(); }
        if (!_custodyLoads.IsCurrent(t)) return;
        _custody[evidenceId] = events;
        _custodyLoading.Remove(evidenceId);
    }

    // PROD-13: record a hand-off outside CaseBook. BUG-578/601: one transfer form at a time (another row's is refused, not
    // replaced, so what's typed in it stays), and a save closes only its own.
    private readonly EditSlot<Guid> _transfer = new();
    private string? _xferTo, _xferHow, _xferWhy, _xferError;
    private bool _xferBusy;

    private void StartTransfer(Guid evidenceId)
    {
        if (!_transfer.TryOpen(evidenceId, Toasts, "transfer")) return;
        _xferTo = _xferHow = _xferWhy = _xferError = null;
    }

    private void CancelTransfer() => _transfer.Close();

    private bool TransferDirty => _transfer.IsOpen
        && (!string.IsNullOrWhiteSpace(_xferTo) || !string.IsNullOrWhiteSpace(_xferHow) || !string.IsNullOrWhiteSpace(_xferWhy));

    private async Task SaveTransfer()
    {
        if (_xferBusy || _transfer.Current is not { } open) return;
        _xferError = null;
        _xferBusy = true;
        try
        {
            await Evidence.RecordTransferAsync(open.Key, _xferTo ?? "", _xferHow, _xferWhy ?? "");
            _transfer.CloseIf(open);
            Toasts.Success("Transfer recorded in the chain of custody");
            await LoadCustody(open.Key);
        }
        catch (Exception ex)
        {
            var problem = UserFacingError.Describe(ex, Logger, "recording an evidence transfer",
                "Couldn't record the transfer. Try again.");
            if (_transfer.IsCurrent(open)) _xferError = problem;
            else Toasts.Error(problem);
        }
        finally
        {
            _xferBusy = false;
        }
    }

    // CAP-25: the list's filter, chips and sort (EvidenceListView holds the logic). The filter text stays here, never in
    // the URL (C7). Newest upload first by default, as before.
    private string? _filter;
    private readonly HashSet<EvidenceChip> _chips = [];
    private EvidenceSort _sort = EvidenceSort.Uploaded;
    private bool _sortDesc = true;

    private static readonly (EvidenceChip Chip, string Label)[] ChipLabels =
    [
        (EvidenceChip.Images, "Images"), (EvidenceChip.Text, "Text"), (EvidenceChip.CanRun, "Can run"),
        (EvidenceChip.Cited, "Cited"), (EvidenceChip.Uncited, "Not cited"),
    ];

    private IReadOnlyList<Evidence> Shown() => EvidenceListView.Apply(EvidenceItems, _filter, _chips, IsCited, _sort, _sortDesc);

    // As the row's "Cited by" badge says: a current timeline entry (BUG-443) or the brief (INV-33) cites it.
    private bool IsCited(Evidence ev) =>
        Citations.Any(x => x.EvidenceId == ev.Id && _currentEntries.Contains(x.TimelineEntryId))
        || BriefText?.Contains($"evidence:{ev.Id}", StringComparison.OrdinalIgnoreCase) == true;

    private void ToggleChip(EvidenceChip chip) { if (!_chips.Add(chip)) _chips.Remove(chip); }

    private void ClearFilter()
    {
        _filter = null;
        _chips.Clear();
    }

    // A header click sorts by that column in its natural direction; clicking the sorted column flips it (as the case list).
    private void SetSort(EvidenceSort sort)
    {
        if (_sort == sort) _sortDesc = !_sortDesc;
        else (_sort, _sortDesc) = (sort, EvidenceListView.DefaultDescending(sort));
    }

    private RenderFragment SortTh(string label, EvidenceSort sort)
    {
        var on = _sort == sort;
        var ariaSort = on ? (_sortDesc ? "descending" : "ascending") : "none";
        var icon = on ? (_sortDesc ? "bi-arrow-down" : "bi-arrow-up") : "bi-arrow-down-up";
