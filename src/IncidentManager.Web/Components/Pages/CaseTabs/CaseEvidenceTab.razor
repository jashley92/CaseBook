@* Case workspace — Evidence tab (UX-13, first slice of the interwoven pass). Upload (manual / paste /
   drag-drop, U-39), the hashed evidence list, per-item chain of custody (U-26), and inline image preview.
   The cross-tab concerns stay in the parent and are threaded in: the screenshot lightbox (OnPreview), the
   live-collab flash (FlashClass/FlashStyle), and a Reload after upload (OnChanged). The paste/drop shim is
   still registered by the parent against the element IDs kept here (evidence-dropzone / -file-input / -file-drop). *@
@using Microsoft.Extensions.Logging
@inject EvidenceService Evidence
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject TimeDisplay TimeDisp
@inject ToastService Toasts
@inject ILogger<CaseEvidenceTab> Logger
@inject UnsavedEdits Edits
@implements IDisposable

<div id="evidence-dropzone">
    <AuthorizeView Policy="@Policies.EditCases">
        <div class="card mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small mb-0">File</label>
                        <InputFile id="evidence-file-input" class="form-control form-control-sm" OnChange="OnFileSelected" disabled="@_busy" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small mb-0" for="ev-desc">Description</label>
                        <input id="ev-desc" class="form-control form-control-sm" @bind="_evDesc" @bind:event="oninput" disabled="@_busy"
                               maxlength="@IncidentManager.Application.Evidence.EvidenceService.MaxDescriptionLength" />
                    </div>
                    <div class="col-md-2">
                        @* REL-03: guard against a double-click (and give feedback on a slow/large upload) — the
                           button both disables and shows a spinner while a hashed upload is streaming, so the
                           same file can't be sent twice (which would create duplicate evidence + custody events). *@
                        <button class="btn btn-sm btn-primary w-100" @onclick="Upload" disabled="@(_file is null || _busy)">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span><text>Uploading…</text>
                            }
                            else
                            {
                                <text>Upload</text>
                            }
                        </button>
                    </div>
                </div>
                <div class="small text-muted mt-2">
                    <span class="bi bi-clipboard me-1"></span>Paste a screenshot or drag files onto this tab. They're hashed and logged to the chain of custody like any upload.
                    Dropped files upload straight away, without a description; the box above is for the file you pick.
                    @if (_file is not null) { <span class="ms-1">Ready: <strong>@_file.Name</strong>. Add a description and click Upload.</span> }
                </div>
                @if (_uploadError is not null) { <div class="text-danger small mt-2">@_uploadError</div> }

                @* Hidden sinks the paste-drop shim (wwwroot/js/paste-drop.js) feeds: paste stages one
                   screenshot in the picker; a drop bulk-uploads immediately. Both reuse InputFile streaming. *@
                <InputFile id="evidence-file-drop" class="d-none" multiple OnChange="OnDropped" />
            </div>
        </div>
    </AuthorizeView>

    @if (EvidenceItems.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><span class="bi bi-file-earmark-lock" aria-hidden="true"></span></div>
            <div class="empty-state-title">No evidence yet</div>
            <div class="empty-state-msg">Upload, paste or drop files here. Each file is hashed on arrival and gets its own chain of custody.</div>
        </div>
    }
    else
    {
        <table class="table table-sm align-middle">
            <thead><tr><th>File</th><th>Size</th><th>SHA-256</th><th>Uploaded</th><th></th></tr></thead>
            <tbody>
                @foreach (var ev in EvidenceItems.OrderByDescending(x => x.CreatedAtUtc))
                {
                    <tr class="im-enter @FlashClass?.Invoke(ev.Id)" style="@FlashStyle?.Invoke(ev.Id)" @key="ev.Id" id="ev-@ev.Id">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (IsImageEvidence(ev))
                                {
                                    @* Click the thumbnail to preview the image in a lightbox (U-40 preview, reused). *@
                                    <button type="button" class="btn p-0 border-0 bg-transparent" @onclick="() => OnPreview.InvokeAsync(ev.Id)" title="Preview">
                                        <img src="evidence/@ev.Id/inline" alt="" loading="lazy"
                                             style="max-height:36px;max-width:56px;border-radius:.25rem;border:1px solid var(--bs-border-color);cursor:zoom-in" />
                                    </button>
                                }
                                <div>
                                    @* RD-06: the file opens in its panel: preview, integrity, custody, what cites it. *@
                                    <button type="button" class="btn btn-link p-0 text-start im-evp-open" @onclick="() => OnOpenEvidence.InvokeAsync(ev.Id)"
                                            title="Open the file's panel">@ev.OriginalFileName</button><br /><small class="text-muted">@ev.Description</small>
                                    @{
                                        var citedBy = Citations.Count(x => x.EvidenceId == ev.Id && _currentEntries.Contains(x.TimelineEntryId));   // BUG-443
                                        var inBrief = BriefText?.Contains($"evidence:{ev.Id}", StringComparison.OrdinalIgnoreCase) == true;   // INV-33
                                        var cites = new List<string>();
                                        if (citedBy > 0) cites.Add(IncidentManager.Application.Common.Plural.Of(citedBy, "timeline entry", "timeline entries"));
                                        if (inBrief) cites.Add("the brief");
                                    }
                                    @if (cites.Count > 0)
                                    {
                                        @* INV-10: what relies on this item. *@
                                        <div class="small"><span class="im-badge im-b-info"><span class="bi bi-link-45deg" aria-hidden="true"></span> Cited by @string.Join(" and ", cites)</span></div>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>@FormatSize(ev.SizeBytes)</td>
                        <td><code class="small">@IncidentManager.Application.Common.TextFit.Cap(ev.Sha256, 17)</code></td>
                        <td class="small text-muted">@TimeDisp.Long(ev.CreatedAtUtc)<br />@Users.DisplayFor(ev.CreatedBy)</td>
                        <td class="text-nowrap">
                            @if (IsImageEvidence(ev))
                            {
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OnPreview.InvokeAsync(ev.Id)">Preview</button>
                            }
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ToggleCustody(ev.Id)"
                                    title="Access and transfer history"
                                    aria-expanded="@(_custodyOpen.Contains(ev.Id) ? "true" : "false")">
                                <span class="bi @(_custodyOpen.Contains(ev.Id) ? "bi-chevron-down" : "bi-clock-history")" aria-hidden="true"></span> Custody
                            </button>
                            <a class="btn btn-sm btn-outline-primary" href="evidence/@ev.Id" target="_blank">Download</a>
                            @if (CanEdit)
                            {
                                <button type="button" class="btn btn-sm btn-link ms-1" @onclick="() => ToggleTask(ev.Id)"
                                        title="Start a task about this file"><span class="bi bi-plus-lg" aria-hidden="true"></span> Task</button>
                            }
                        </td>
                    </tr>
                    var evTasks = Tasks.Where(t => t.AboutRef == $"{ActionItem.AboutEvidence}:{ev.Id}").ToList();
                    @if (evTasks.Count > 0 || _taskFor.Contains(ev.Id))
                    {
                        @* INV-28: the tasks about this file, and a new one. *@
                        <tr class="im-custody-row">
                            <td colspan="5">
                                @if (evTasks.Count > 0)
                                {
                                    <div class="tl-tasks">
                                        @foreach (var t in evTasks)
                                        {
                                            <span class="tl-task @(t.IsOpen ? "" : "tl-task-done")"><span class="bi @(t.IsOpen ? "bi-square" : "bi-check2-square")" aria-hidden="true"></span> @t.Title</span>
                                        }
                                    </div>
                                }
                                @if (_taskFor.Contains(ev.Id))
                                {
                                    <QuickTask CaseId="CaseId" About="@($"{ActionItem.AboutEvidence}:{ev.Id}")" Placeholder="A task about this file"
                                               OnDone="async () => { _taskFor.Remove(ev.Id); await OnChanged.InvokeAsync(); }" OnCancel="() => _taskFor.Remove(ev.Id)" />
                                }
                            </td>
                        </tr>
                    }
                    @if (_custodyOpen.Contains(ev.Id))
                    {
                        <tr class="im-custody-row">
                            <td colspan="5" class="bg-body-tertiary">
                                <div class="small fw-semibold mb-2">
                                    <span class="bi bi-shield-check me-1" aria-hidden="true"></span>Chain of custody
                                </div>
                                <WhyThisMatters Class="mb-2">
                                    Each file's SHA-256 is recorded at upload and re-checked on a schedule. Every download, preview and
                                    hand-off is logged with who and when, so counsel, insurers, law enforcement or regulators can rely on
                                    the evidence later.
                                </WhyThisMatters>
                                @if (_custodyLoading.Contains(ev.Id))
                                {
                                    <span class="skel skel-line" style="width:40%;display:block"></span>
                                }
                                else if (_custody.TryGetValue(ev.Id, out var events) && events.Count > 0)
                                {
                                    <table class="table table-sm mb-0 im-table">
                                        <thead><tr><th>When (@TimeDisp.Label)</th><th>Action</th><th>By</th><th>Details</th></tr></thead>
                                        <tbody>
                                            @foreach (var c in events)
                                            {
                                                <tr>
                                                    <td class="small im-data text-nowrap">@TimeDisp.Long(c.AtUtc)</td>
                                                    <td class="small"><span class="bi @CustodyGlyph(c.Action) me-1" aria-hidden="true"></span>@c.Action</td>
                                                    <td class="small">@Users.DisplayFor(c.Actor)</td>
                                                    <td class="small text-muted">@c.Details</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <span class="small text-muted">No custody events recorded.</span>
                                }
                                <AuthorizeView Policy="@Policies.EditCases" Context="xfer">
                                    @if (_transfer.IsOpenFor(ev.Id))
                                    {
                                        @* PROD-13: a hand-off outside CaseBook is attested here, since no export ships evidence bytes. *@
                                        <div class="border rounded p-2 mt-2 bg-body">
                                            <div class="small fw-semibold mb-1">Record a transfer</div>
                                            <div class="small text-muted mb-2">Record who received a copy outside CaseBook, how and why. It's added to the chain of custody and the audit trail.</div>
                                            <div class="row g-2">
                                                <div class="col-md-4">
                                                    <label class="form-label small mb-0" for="xfer-to-@ev.Id">Recipient</label>
                                                    <input id="xfer-to-@ev.Id" class="form-control form-control-sm" maxlength="200" @bind="_xferTo" @bind:event="oninput" disabled="@_xferBusy"
                                                           placeholder="e.g. Outside counsel (Smith LLP)" />
                                                </div>
                                                <div class="col-md-3">
                                                    <label class="form-label small mb-0" for="xfer-how-@ev.Id">Method <span class="text-muted">(optional)</span></label>
                                                    <input id="xfer-how-@ev.Id" class="form-control form-control-sm" maxlength="100" @bind="_xferHow" @bind:event="oninput" disabled="@_xferBusy"
                                                           placeholder="e.g. Encrypted SFTP" />
                                                </div>
                                                <div class="col-md-5">
                                                    <label class="form-label small mb-0" for="xfer-why-@ev.Id">Purpose</label>
                                                    <input id="xfer-why-@ev.Id" class="form-control form-control-sm" maxlength="500" @bind="_xferWhy" @bind:event="oninput" disabled="@_xferBusy"
                                                           placeholder="e.g. Forensic analysis under engagement letter" />
                                                </div>
                                            </div>
                                            @if (_xferError is not null) { <div class="text-danger small mt-1">@_xferError</div> }
                                            <div class="mt-2 d-flex gap-2">
                                                <button class="btn btn-sm btn-primary" @onclick="SaveTransfer" disabled="@_xferBusy">Record transfer</button>
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelTransfer">Cancel</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-link p-0 mt-2" @onclick="() => StartTransfer(ev.Id)">
                                            <span class="bi bi-arrow-left-right me-1" aria-hidden="true"></span>Record a transfer
                                        </button>
                                    }
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<Evidence> EvidenceItems { get; set; } = [];
    /// <summary>INV-10: timeline entries' citations, to say what relies on each item.</summary>
    [Parameter] public IReadOnlyList<EvidenceCitation> Citations { get; set; } = [];
    /// <summary>BUG-443: the case's timeline entries; only citations by current ones count (a retracted entry's stay on it).</summary>
    [Parameter] public IReadOnlyList<TimelineEntry> Entries { get; set; } = [];
    private HashSet<Guid> _currentEntries = [];
    protected override void OnParametersSet() => _currentEntries = Entries.Where(e => e.IsCurrent).Select(e => e.Id).ToHashSet();
    /// <summary>Open the parent-owned screenshot lightbox (shared with the Timeline) for an image evidence id.</summary>
    [Parameter] public EventCallback<Guid> OnPreview { get; set; }
    /// <summary>Reload the case after an upload so the rest of the workspace reflects the new evidence.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Live-collab flash hooks (parent owns the flash state); render an item's flash class / hue.</summary>
    [Parameter] public Func<Guid, string?>? FlashClass { get; set; }
    [Parameter] public Func<Guid, string?>? FlashStyle { get; set; }
    /// <summary>INV-28: may start a task about a file.</summary>
    [Parameter] public bool CanEdit { get; set; }
    /// <summary>INV-28: the case's tasks, to show the ones about each file.</summary>
    [Parameter] public IReadOnlyList<ActionItem> Tasks { get; set; } = [];
    /// <summary>RD-06: open a file in the evidence panel.</summary>
    [Parameter] public EventCallback<Guid> OnOpenEvidence { get; set; }
    /// <summary>INV-33: the current brief's text (all parts), to say when it cites a file.</summary>
    [Parameter] public string? BriefText { get; set; }
    [CascadingParameter] public EditRegion? Region { get; set; }

    // BUG-578: a description or a transfer typed and not saved is asked about before a tab switch, leaving the case or
    // the time-display redraw hides it (a picked file alone isn't: picking it again is one click).
    protected override void OnInitialized()
    {
        Edits.Track(this, "the evidence description you're writing", () => !string.IsNullOrWhiteSpace(_evDesc), Region);
        Edits.Track(this, "the transfer you're recording", () => TransferDirty, Region);
    }

    public void Dispose() => Edits.Forget(this);
    // BUG-578: the rows with a quick task open. Opening one on another row used to close (and empty) the first.
    private readonly HashSet<Guid> _taskFor = [];
    private void ToggleTask(Guid id) { if (!_taskFor.Add(id)) _taskFor.Remove(id); }

    private const long MaxEvidenceBytes = 50 * 1024 * 1024;

    private IBrowserFile? _file;
    private string? _evDesc;
    private string? _uploadError;
    // REL-03: true while an upload is streaming, so a second click / drop can't fire a duplicate upload and
    // the UI can show progress on a slow or large (≤50MB) file.
    private bool _busy;

    // U-26: per-evidence chain-of-custody, lazily loaded when a row is expanded.
    private readonly HashSet<Guid> _custodyOpen = new();
    private readonly HashSet<Guid> _custodyLoading = new();
    private readonly Dictionary<Guid, List<ChainOfCustodyEvent>> _custody = new();

    // Manual picker or a pasted screenshot (via the shim) stages one file to describe + Upload.
    // BUG-483: a paste while an upload streams is refused, and says so, as the picker is disabled then. It replaced the file
    // being uploaded, which the upload then cleared, so the paste was dropped without a word (and a failed upload's error
    // sat beside the pasted file's name, with the description typed for the other one).
    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        if (_busy) { Toasts.Warning("An upload is still running. Paste the screenshot again once it's finished."); return; }
        _file = e.File;
    }

    private async Task Upload()
    {
        if (_file is null || _busy) return; // REL-03: ignore a re-click while an upload is in flight
        _uploadError = null;
        // REL-06: catch the common, expected failure (over the size cap) up front with a clear message,
        // rather than letting the stream throw a generic IOException that reads as an internal error.
        if (_file.Size > MaxEvidenceBytes) { _uploadError = TooLargeMessage(_file.Name); return; }
        _busy = true;
        try
        {
            await using var stream = _file.OpenReadStream(MaxEvidenceBytes);
            var name = _file.Name;
            var sentDesc = _evDesc;
            await Evidence.UploadAsync(CaseId, _file.Name, _file.ContentType, stream, sentDesc);
            _file = null;
            _evDesc = DraftText.ClearIfUnchanged(_evDesc, sentDesc, null);   // BUG-601 (the box is disabled while it uploads)
            await OnChanged.InvokeAsync();
            Toasts.Success($"Uploaded {name}");
        }
        catch (Exception ex)
        {
            // REL-06: domain messages pass through; EF/IO/internal errors become a plain line (detail logged).
            _uploadError = UserFacingError.Describe(ex, Logger, "uploading evidence",
                "Couldn't upload the file. Try again.");
        }
        finally
        {
            _busy = false;
        }
    }

    // U-39: files dropped onto the Evidence tab (via the paste-drop shim) upload immediately — a drop is a
    // bulk gesture, so we don't stage them for a per-file description. Same hashed/custody UploadAsync path.
    private const int MaxDropFiles = 50;

    // BUG-603: a second drop while one is being read in is ignored (_busy, below, covers the uploads themselves).
    private readonly InFlight _dropping = new();
    private Task OnDropped(InputFileChangeEventArgs e) => _dropping.Run(() => UploadDropped(e));

    private async Task UploadDropped(InputFileChangeEventArgs e)
    {
        // REL-03: ignore a drop while an upload batch is already streaming. BUG-483: say so; it was dropped without a word.
        if (_busy) { Toasts.Warning("An upload is still running. Drop the files again once it's finished."); return; }
        _uploadError = null;
        // BUG-341: GetMultipleFiles throws past its limit, outside the per-file catch, so check the count first.
        if (e.FileCount > MaxDropFiles) { _uploadError = $"Drop up to {MaxDropFiles} files at a time."; return; }
        IReadOnlyList<IBrowserFile> files;
        try { files = e.GetMultipleFiles(maximumFileCount: MaxDropFiles); }
        catch (InvalidOperationException) { _uploadError = $"Drop up to {MaxDropFiles} files at a time."; return; }
        _busy = true;
        var uploaded = 0;
        try
        {
            foreach (var f in files)
            {
                if (f.Size > MaxEvidenceBytes) { _uploadError = TooLargeMessage(f.Name); continue; } // REL-06
                try
                {
                    await using var stream = f.OpenReadStream(MaxEvidenceBytes);
                    // REV-34: the description box belongs to the file staged in the picker, not to these.
                    await Evidence.UploadAsync(CaseId, f.Name, f.ContentType, stream, description: null);
                    uploaded++;
                }
                catch (Exception ex)
                {
                    // REL-06: per-file — keep the name, map the reason (domain verbatim / internal generic).
                    _uploadError = $"{f.Name}: {UserFacingError.Describe(ex, Logger, "uploading evidence", "couldn't be uploaded. Try again.")}";
                }
            }
        }
        finally
        {
            _busy = false;
        }
        if (uploaded > 0)
        {
            await OnChanged.InvokeAsync();
            Toasts.Success($"Uploaded {uploaded} file{(uploaded == 1 ? "" : "s")}");
        }
    }

    // U-26: show/hide an evidence item's chain of custody, loading it on each expand (a preview or a transfer
    // since the last look adds entries, PROD-13); the previous list stays visible while it refreshes.
    private async Task ToggleCustody(Guid evidenceId)
    {
        if (_custodyOpen.Contains(evidenceId))
        {
            // BUG-578: collapsing hides the row's transfer form: refused while it holds text, else it's let go (so another
            // row's can open).
            if (_transfer.IsOpenFor(evidenceId))
            {
                if (TransferDirty) { Toasts.Info(EditSlot.Refusal("transfer")); return; }
                _transfer.Close();
            }
            _custodyOpen.Remove(evidenceId);
            return;
        }
        _custodyOpen.Add(evidenceId);
        await LoadCustody(evidenceId);
    }

    // BUG-601: per file, the newest load's list is the one shown (one from before a transfer doesn't land after it).
    private readonly KeyedLoad<Guid> _custodyLoads = new();

    private async Task LoadCustody(Guid evidenceId)
    {
        if (!_custody.ContainsKey(evidenceId)) _custodyLoading.Add(evidenceId);
        var t = _custodyLoads.Begin(evidenceId);
        List<ChainOfCustodyEvent> events;
        try { events = await Evidence.GetCustodyAsync(evidenceId); }
        catch { events = new(); }
        if (!_custodyLoads.IsCurrent(t)) return;
        _custody[evidenceId] = events;
        _custodyLoading.Remove(evidenceId);
    }

    // PROD-13: record a hand-off outside CaseBook. BUG-578/601: one transfer form at a time (another row's is refused, not
    // replaced, so what's typed in it stays), and a save closes only its own.
    private readonly EditSlot<Guid> _transfer = new();
    private string? _xferTo, _xferHow, _xferWhy, _xferError;
    private bool _xferBusy;

    private void StartTransfer(Guid evidenceId)
    {
        if (!_transfer.TryOpen(evidenceId, Toasts, "transfer")) return;
        _xferTo = _xferHow = _xferWhy = _xferError = null;
    }

    private void CancelTransfer() => _transfer.Close();

    private bool TransferDirty => _transfer.IsOpen
        && (!string.IsNullOrWhiteSpace(_xferTo) || !string.IsNullOrWhiteSpace(_xferHow) || !string.IsNullOrWhiteSpace(_xferWhy));

    private async Task SaveTransfer()
    {
        if (_xferBusy || _transfer.Current is not { } open) return;
        _xferError = null;
        _xferBusy = true;
        try
        {
            await Evidence.RecordTransferAsync(open.Key, _xferTo ?? "", _xferHow, _xferWhy ?? "");
            _transfer.CloseIf(open);
            Toasts.Success("Transfer recorded in the chain of custody");
            await LoadCustody(open.Key);
        }
        catch (Exception ex)
        {
            var problem = UserFacingError.Describe(ex, Logger, "recording an evidence transfer",
                "Couldn't record the transfer. Try again.");
            if (_transfer.IsCurrent(open)) _xferError = problem;
            else Toasts.Error(problem);
        }
        finally
        {
            _xferBusy = false;
        }
    }

    // Only image evidence can be previewed inline (the /inline endpoint serves image/* only).
    private static bool IsImageEvidence(Evidence ev) =>
        ev.ContentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;

    // REL-06: friendly, consistent message for a file over the 50 MB cap (used by the picker and drop paths).
    private static string TooLargeMessage(string name) =>
        $"“{name}” is larger than the {MaxEvidenceBytes / (1024 * 1024)} MB limit and wasn't uploaded.";

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.0} MB",
        >= 1024 => $"{bytes / 1024.0:0.0} KB",
        _ => $"{bytes} B"
    };

    private static string CustodyGlyph(string action) => action.ToLowerInvariant() switch
    {
        "uploaded" => "bi-upload",
        "downloaded" => "bi-download",
        "viewed" => "bi-eye",
        "transferred" => "bi-arrow-left-right",
        _ => "bi-dot"
    };
}
