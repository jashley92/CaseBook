    // --- Regulatory notification deadlines (PROD-07) ---
    private void BeginMarkReported()
    {
        _reportedError = null;
        // FR-09: seed + accept the reported time as wall-clock in the viewer's display zone (like Detected /
        // Initial-activity), not raw UTC — so an analyst who types local everywhere can't mis-stop the
        // highest-stakes regulatory clock by their zone offset. WallClock.ToUtc converts on save.
        _reportedAt = _reportedSeed = WallClock.ToWall(Clock.UtcNow, TimeDisp.Zone);
        TakeReportedStamps();
        _markingReported = true;
    }

    // BUG-594 / CAP-38 review (C9): what the form shows, read when it opens and again after a refusal: the stored time, and
    // the regulators still owed a notice (the ones a save records).
    private void TakeReportedStamps()
    {
        _reportedShown = _deadlines?.ReportedAtUtc;
        _outstandingShown = _deadlines?.Standing.Outstanding ?? [];
    }

    private Task MarkReported() => _saving.Run(MarkReportedCore);

    private async Task MarkReportedCore()
    {
        _reportedError = null;
        if (_reportedAt is not { } dt) { _reportedError = "Enter the reported time."; return; }
        try
        {
            var utc = WallClock.ToUtc(dt, TimeDisp.Zone); // FR-09: wall-clock (display zone) → UTC, matching every other datetime field
            // BUG-594: refused when someone recorded a reported time after the form opened. CAP-38 review: or when the
            // regulators still owed changed (one brought into play, a notice removed), so none gets a notice nobody saw.
            await Cases.MarkReportedAsync(CaseId, utc, Shown.Of(_reportedShown), _outstandingShown);
            _markingReported = false;
            await LoadDeadlines();
            await OnChanged.InvokeAsync();
            Toasts.Success("Reported milestone recorded");
        }
        catch (StaleEditException ex)
        {
            // CAP-38 review (C7, C9): the time typed stays, the form shows who is owed now, and a deliberate save again works.
            _reportedError = ex.Message;
            await LoadDeadlines();
            TakeReportedStamps();
            if (_deadlines?.Standing.IsFullyReported != false) _markingReported = false;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            _reportedError = ex.Message;
        }
    }

    private Task ClearReported() =>
        RequestConfirm.InvokeAsync(("Clear the reported milestone? The notification countdown will resume.", "Clear",
            () => _removing.Run(ClearReportedCore)));

    private async Task ClearReportedCore()
    {
        await Cases.ClearReportedAsync(CaseId);
        await LoadDeadlines();
        await OnChanged.InvokeAsync();
        Toasts.Success("Reported milestone cleared");
    }

    private static string RemainingLabel(TimeSpan rem)
    {
        if (rem < TimeSpan.Zero)
        {
            var over = -rem;
            return over.TotalDays >= 1 ? $"overdue {(int)over.TotalDays}d" : $"overdue {Math.Max(1, (int)over.TotalHours)}h";
        }
        return rem.TotalDays >= 1 ? $"in {(int)rem.TotalDays}d" : $"in {Math.Max(1, (int)rem.TotalHours)}h";
    }

    protected override async Task OnParametersSetAsync()
    {
        // Load related cases on first mount and whenever the parent signals a live change.
        if (_loadedToken != RefreshToken)
        {
            _loadedToken = RefreshToken;
            await LoadLinks();
        }
        // HR-14: what's still open after closure (the review and its improvement actions).
        if (Case.Phase == CasePhase.Closed && _lessonsFor != (Case.Id, RefreshToken))
        {
            _lessonsFor = (Case.Id, RefreshToken);
            // BUG-601: an older load (the token before) landing last doesn't replace the newer one's.
            var t = _lessonsLoad.Begin();
            IncidentManager.Application.Lessons.CaseLessonsView? lessons;
            try { lessons = await Lessons.GetForCaseAsync(Case.Id); }
            catch (ForbiddenException) { lessons = null; }
            if (_lessonsLoad.IsCurrent(t)) _lessons = lessons;
        }
        // Re-evaluate the notification deadlines whenever the parent passes an updated case (e.g. after a
        // materiality determination or reported milestone recorded from the header Actions), so the card and
        // the header badge stay in sync (PROD-07).
        await LoadDeadlines();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ReconcileEditor();
        if (_scrollTo is { } id)
        {
            _scrollTo = null;
            try { await JS.InvokeVoidAsync("imMotion.scrollToId", id); } catch (JSException) { /* ignore */ }
        }
    }

    // Stage readiness "Fix": open the editor that satisfies an unmet check, or hand off to the workspace for a
    // tab or a dialog.
    private string? _scrollTo;
    public async Task FixReadiness(string checkKey)
    {
        switch (checkKey)
        {
            case GateCheckKeys.SummaryPresent:
                // INV-36: the summary is the brief's first part.
                if (BriefInPane) { await OnEditBrief.InvokeAsync(); return; }
                _briefing?.BeginBriefEdit();
                _scrollTo = "ov-brief";
                break;
            case GateCheckKeys.DetectionCaseIdSet:
                if (!_editingDetails) BeginEditDetails();
                _scrollTo = "ov-details";
                break;
            case GateCheckKeys.AffectedIndividualsCountSet or GateCheckKeys.MinAffectedIndividuals
                or GateCheckKeys.DataElementsSet or GateCheckKeys.AffectedStatesSet:
                // RD-11: the impact editor is in Things › Impact; the workspace opens it there.
                if (Section != "Impact") { await OnFix.InvokeAsync(checkKey); return; }
                if (!_editingImpact) BeginEditImpact();
                _scrollTo = "ov-impact";
                break;
            default:
                await OnFix.InvokeAsync(checkKey);
                return;
        }
        StateHasChanged();
    }

    // INV-36: the Summary composer moved to the brief, so no EasyMDE editor is wanted here any more; this still
    // tears down one left mounted.
    private async Task ReconcileEditor()
    {
        var desired = new Dictionary<string, string>();

        foreach (var id in _mdEditors.Where(id => !desired.ContainsKey(id)).ToList())
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); } catch (JSException) { /* ignore */ }
            _mdEditors.Remove(id);
        }
        foreach (var (id, seed) in desired)
        {
            if (_mdEditors.Contains(id)) continue;
            try
            {
                await JS.InvokeVoidAsync("markdownEditor.init", id, seed);
                // BUG-566: torn down while this ran, so DisposeAsync missed it; left in the shared registry, it would
                // keep a later mount of this editor id from attaching.
                if (Disposed) { try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); } catch { /* circuit may be gone */ } return; }
                _mdEditors.Add(id);
            }
            catch (JSException) { /* editor is a progressive enhancement */ }
        }
    }

    /// <summary>Ctrl/⌘+Enter from the parent's hotkey dispatcher — save the details edit if open.</summary>
    public async Task SubmitAsync()
    {
        // BUG-425: only on the Briefing, where the details editor is; the Impact, ATT&CK and Connections parts share this
        // component (and _editingDetails) but don't show it. Forms with their own Save take their own keys (SaveOnKey).
        if (CanEdit && _editingDetails && Section == "Briefing") await SaveDetails();
    }

    // BUG-425: one of this tab's saves at a time, by click or Ctrl/Cmd+Enter; a form marked .im-own-keys (keymap.js leaves
    // it alone) saves itself on Ctrl/Cmd+Enter, not the details editor. A held key doesn't repeat it. BUG-603: each save
    // runs through _saving itself (the confirmed removals through _removing, the techniques through _tagging), so a
    // double-click, Enter and a click, or two confirms don't write twice.
    private readonly InFlight _saving = new();
    private readonly InFlight _removing = new();
    private readonly InFlight _tagging = new();

    private Task SaveOnKey(KeyboardEventArgs e, Func<Task> save) =>
        e.Key != "Enter" || !(e.CtrlKey || e.MetaKey) || e.Repeat || !CanEdit ? Task.CompletedTask : save();

    // BUG-578: unsaved input in this tab's forms (compared with what each opened with, so an untouched one holds nothing up).
    private bool DetailsDirty => _editingDetails && DetailsInput() != _detailsSeed;
    private bool ImpactDirty => _editingImpact && ImpactInput() != _impactSeed;
    private bool LinkDirty => _addingLink && (_linkTargetId is not null || !string.IsNullOrWhiteSpace(_linkQuery) || !string.IsNullOrWhiteSpace(_linkDesc));
    private bool NoticeDirty => (_notice.IsOpen && (Moved(_noticeAt, _noticeSeed) || NoticeDetailsInput() != _noticeDetailsSeed))   // CAP-07
                                || (_markingReported && Moved(_reportedAt, _reportedSeed));
    private static bool Moved(DateTime? now, DateTime? seed) =>
        (now is { } n ? WallClock.ToMinute(n) : (DateTime?)null) != (seed is { } s ? WallClock.ToMinute(s) : null);
    private string? _detailsSeed, _impactSeed;
    private string DetailsInput() => string.Join("\u001f", _edTitle, _edDetection, _edDataTypes, _edImpacted, _edDetected?.Ticks, _edOccurred?.Ticks);
    private string ImpactInput() => string.Join("\u001f", _impCount, string.Join(",", _impElementKeys.Order(StringComparer.Ordinal)), _impStates);

    private Task Confirm(string message, Func<Task> action, string verb = "Remove") => RequestConfirm.InvokeAsync((message, verb, action));

    // INV-29: the last few decisions, handoffs and response milestones, newest first — a read-time view of the
    // timeline, so "what just happened" is answered without switching tabs.
    private sealed record RecentItem(DateTimeOffset At, string Icon, string Kind, string Text);

    private static readonly HashSet<MilestoneKind> RecentMilestones =
    [
        MilestoneKind.Classification, MilestoneKind.Severity, MilestoneKind.Phase, MilestoneKind.Materiality,
        // HR-07: team changes are record-keeping, not what happened; gates fold into their transitions.
        MilestoneKind.Gate, MilestoneKind.Reported, MilestoneKind.TaskDone, MilestoneKind.Verdict, MilestoneKind.Assessment,
        MilestoneKind.ActivityBegan, MilestoneKind.Opened, MilestoneKind.Contained
    ];

    private List<RecentItem> RecentOnTimeline()
    {
        var labels = new MilestoneLabels(c => Ui.Label(c), s => SevLabels.For(s), p => Ui.Label(p), m => Ui.Label(m),
            k => OutcomeLabels.GetValueOrDefault(k) ?? IncidentManager.Application.Admin.CaseOutcomeCatalog.Label(k),
            d => Ui.Label(d), t => TimeDisp.DateOnly(t), _deadlines?.Standing);   // CAP-38 review: reported by the standing
        var milestones = CaseMilestones.Project(Case, labels)
            .Where(m => RecentMilestones.Contains(m.Kind))
            .Select(m => new RecentItem(m.AtUtc, m.Flagged ? "bi-flag-fill im-ov-flag" : "bi-flag", "Milestone",
                m.Detail is { } detail ? $"{m.Title}: {OneLine(detail)}" : m.Title));
        var entries = Case.TimelineEntries
            .Where(e => e.IsCurrent && e.Type is TimelineEntryType.Decision or TimelineEntryType.Handoff)
            .Select(e => e.Type == TimelineEntryType.Decision
                ? new RecentItem(e.OccurredAtUtc, "bi-diamond-fill im-ov-dec", "Decision", OneLine(e.Description))
                : new RecentItem(e.OccurredAtUtc, "bi-arrow-left-right", "Handoff", OneLine(e.Description)));
        if (Case.Phase != CasePhase.Closed)
            return milestones.Concat(entries).OrderByDescending(r => r.At).Take(5).ToList();
        // HR-14: a closed case reads oldest-first: how it began and how it ended, with the full story a click away.
        var story = milestones.Concat(entries).OrderBy(r => r.At).ToList();
        _storyHidden = Math.Max(0, story.Count - 12);
        return story.Count <= 12 ? story : story.Take(8).Concat(story.TakeLast(4)).ToList();
    }

    // --- HR-14: the closed-case outcome strip ---
    private int _storyHidden;
    private IncidentManager.Application.Lessons.CaseLessonsView? _lessons;
    private (Guid Case, int Token)? _lessonsFor;
    private readonly LoadSequence _lessonsLoad = new();

    // When recovery began: the (effective) time of the latest move into Recovery.
    private DateTimeOffset? RecoveryStarted => Case.StatusChanges
        .Where(s => s.To == CasePhase.Recovery).OrderByDescending(s => s.EffectiveAt).Select(s => (DateTimeOffset?)s.EffectiveAt).FirstOrDefault();

    // "2026-10-01 09:12 UTC" over "→ 10:20 UTC" over "68 min" (the end's date only when it differs).
    private RenderFragment SpanFragment(DateTimeOffset? from, DateTimeOffset? to) => @<text>
        @if (from is not { } a && to is not { })
        {
            <span class="text-muted">Not recorded</span>
        }
        else
        {
            <span>@(from is { } f ? TimeDisp.Short(f) : "Start not recorded")</span><br />
            <span class="text-muted">→ @(to is { } b ? (from is { } s && TimeDisp.DateOnly(s) == TimeDisp.DateOnly(b) ? TimeDisp.TimeOnly(b) : TimeDisp.Short(b)) : "not recorded")</span>
            @if (from is { } x && to is { } y && y >= x)
            {
                <br /><span class="im-ov-took">@Took(y - x)</span>
            }
        }
    </text>;

    private static string Took(TimeSpan d) => d.TotalMinutes < 120 ? $"{Math.Round(d.TotalMinutes)} min"
        : d.TotalHours < 48 ? $"{d.TotalHours:0.#} h" : $"{d.TotalDays:0.#} days";

    private string OneLine(string markdown)
    {
        var text = Md.ToPlainText(markdown).Replace('\n', ' ').Trim();
        return IncidentManager.Application.Common.TextFit.Cap(text, 160);
    }

    // --- Details ---
    private void BeginEditDetails()
    {
        _edTitle = Case.Title;
        _edSummary = Case.Summary;
        _edDetection = Case.DetectionCaseId;
        _edDataTypes = Case.DataTypesInvolved;
        _edImpacted = Case.ImpactedAssets;
        _edDetected = Case.DetectedAtUtc is { } d ? WallClock.ToWall(d, TimeDisp.Zone) : null;
        _edOccurred = Case.OccurredAtUtc is { } o ? WallClock.ToWall(o, TimeDisp.Zone) : null;
        (_edDetectedShown, _edOccurredShown) = (_edDetected, _edOccurred);
        (_edDetectedAt, _edOccurredAt) = (Case.DetectedAtUtc, Case.OccurredAtUtc);
        _detailsError = null;
        _detailsBaseline = Case.DetailsConcurrencyStamp(); // FR-06: baseline for the optimistic-concurrency check
        _editingDetails = true;
        _detailsSeed = DetailsInput();
    }

    // WF-68: a time left as shown keeps its recorded instant; converting it back would read a time in the repeated autumn
    // hour as standard time and move it an hour (and every deadline that runs from it). BUG-503 follow-up: compared at the
    // minute the field shows, so a time typed back to it (which comes back without its seconds) is kept too.
    private DateTimeOffset? Kept(DateTime? edited, DateTime? shown, DateTimeOffset? recorded) =>
        edited is null ? null : WallClock.Kept(edited.Value, shown, recorded, TimeDisp.Zone);

    private Task SaveDetails() => _saving.Run(SaveDetailsCore);

    private async Task SaveDetailsCore()
    {
        if (string.IsNullOrWhiteSpace(_edTitle) || _edDetected is null) return;
        // INV-36: the summary isn't edited here; send the one on record so this save never changes it. If it
        // changed since the editor opened, the concurrency stamp refuses the save instead of reverting it.
        _edSummary = Case.Summary;
        try
        {
            await Cases.UpdateDetailsAsync(CaseId, _edTitle, _edSummary, _edDetection, _edDataTypes, _edImpacted,
                // BUG-553: the instants the form was seeded from, not the reloaded case's: after a stale refusal the case
                // holds the colleague's time, and "Save again to overwrite" would keep it while the form shows ours.
                Kept(_edDetected, _edDetectedShown, _edDetectedAt)!.Value, Kept(_edOccurred, _edOccurredShown, _edOccurredAt),
                _detailsBaseline);
        }
        catch (StaleEditException ex) // FR-06: another author changed these fields while we were editing
        {
            _detailsBaseline = ex.CurrentStamp; // re-baseline so a deliberate re-Save overwrites
            _detailsError = "Someone else saved changes to these details while you were editing, so yours weren't saved. Review the current values, then Save again to overwrite them, or Cancel to discard yours.";
            await OnChanged.InvokeAsync(); // refresh the rest of the workspace to the newer values
            return;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) // domain validation (future detection / activity after detection), permission
        {
            _detailsError = ex.Message;
            return;
        }
        _editingDetails = false;
        _detailsError = null;
        await OnChanged.InvokeAsync();
        Toasts.Success("Details saved");
    }

    // --- Structured impact assessment (E-12) ---
    private string DataElementLabel(string key) =>
        _dataElementLabels.TryGetValue(key, out var label) ? label : key;

    private IEnumerable<string> SelectedElementKeysOrdered()
    {
        var keys = Case.DataElements.Select(d => d.ElementKey).ToHashSet(StringComparer.Ordinal);
        var ordered = _dataElements.Where(e => keys.Contains(e.Key)).Select(e => e.Key).ToList();
        ordered.AddRange(keys.Where(k => ordered.All(o => o != k)).OrderBy(k => k, StringComparer.Ordinal));
        return ordered;
    }

    private void BeginEditImpact()
    {
        _impCount = Case.AffectedIndividualsCount;
        _impElementKeys = Case.DataElements.Select(d => d.ElementKey).ToHashSet(StringComparer.Ordinal);
        // Pre-fill the org's default jurisdictions on a case that has none yet (X-01); analyst can edit.
        _impStates = string.IsNullOrWhiteSpace(Case.AffectedStates)
            ? (Config["Organization:DefaultJurisdictions"] is { Length: > 0 } d ? d : null)
            : Case.AffectedStates;
        _impactError = null;
        _impactBaseline = Case.ImpactConcurrencyStamp(); // FR-06: baseline for the optimistic-concurrency check
        _editingImpact = true;
        _impactSeed = ImpactInput();
    }

    private void ToggleElement(string key, bool on)
    {
        if (on) _impElementKeys.Add(key); else _impElementKeys.Remove(key);
    }

    private Task SaveImpact() => _saving.Run(SaveImpactCore);

    private async Task SaveImpactCore()
    {
        try
        {
            await Cases.UpdateImpactAssessmentAsync(CaseId, _impCount, _impElementKeys, _impStates, _impactBaseline);
        }
        catch (StaleEditException ex) // FR-06: another author changed the impact assessment while we were editing
        {
            _impactBaseline = ex.CurrentStamp;
            _impactError = "Someone else saved the impact assessment while you were editing, so your entries weren't saved. Review the current values, then Save again to overwrite them, or Cancel to discard yours.";
            await OnChanged.InvokeAsync();
            return;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            _impactError = ex.Message;
            return;
        }
        _editingImpact = false;
        _impactError = null;
        await OnChanged.InvokeAsync();
        Toasts.Success("Impact assessment saved");
    }

    // --- Assignments / techniques ---
    private Task RemoveTechnique(Guid techniqueId) => _tagging.Run(() => RemoveTechniqueCore(techniqueId));

    private async Task RemoveTechniqueCore(Guid techniqueId)
    {
