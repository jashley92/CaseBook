@* RD-11: there is no Overview tab any more. This component renders one part of the case at a time (Section):
   the Briefing view's sections (outcome, brief on narrow screens, story, notification, gate, case record, access),
   or one of the Things view's parts: Impact, ATT&CK ("Attack") or Connections (related cases).
   Case workspace — Overview tab (UX-13, the last tab). The workspace "hub": the vitals/SLA strip, case
   details, the structured impact assessment (E-12), stage-readiness,
   assignments, MITRE ATT&CK techniques (with the matrix picker), related cases (E-14), and the change log.
   It owns its Summary EasyMDE editor (own reconcile + teardown) — the last such editor, so the parent's
   central reconcile retires. Parent-owned chrome is threaded in: the retention alert (RetentionMessage, set
   by header actions), the readiness gate (ReadinessEval, computed in the parent's Reload), the shared
   confirm dialog (RequestConfirm→AskConfirm), the assign modal (OnOpenModal→parent OpenModal), a Reload
   after a write (OnChanged), a RefreshToken (bumped on collaborator changes) to re-pull related cases, and
   Ctrl+Enter save via SubmitAsync (@ref). *@
@implements IAsyncDisposable
@inject CaseService Cases
@inject IConfiguration Config
@inject IClock Clock
@inject IncidentManager.Application.Content.IMarkdownService Md
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject TimeDisplay TimeDisp
@inject ToastService Toasts
@inject ISeverityLabels SevLabels
@inject IJSRuntime JS
@inject IncidentManager.Application.Sla.ISlaTargetsProvider SlaProvider
@inject IncidentManager.Application.Compliance.NotificationDeadlineService Deadlines
@inject IncidentManager.Application.Lessons.LessonsService Lessons
@inject UnsavedEdits Edits
@using IncidentManager.Application.Compliance

@if (RetentionMessage is not null)
{
    <div class="alert alert-danger py-2 small">@RetentionMessage</div>
}

@* INV-29: one reading column, in the order someone opening the case asks: where it stands (the summary and the
   brief), what just happened, how bad it is and who must be told, whether it can move on, then the reference facts.
   The clocks, dates and team live in the case context panel (or its strip), not here. The open tasks are the
   brief's Next steps here, so beside the Overview the panel's Next shrinks to its summary line (INV-40). *@
@if (Section == "Briefing" && Case.Phase == CasePhase.Closed)
{
    @* HR-14: a closed case is read, months later, for what it was and how it went: the outcome and the response's
       shape first, then the closing brief, then the story. *@
    <dl class="im-ov-facts im-ov-outcome" aria-label="Outcome of this case">
        <div>
            <dt>Outcome</dt>
            <dd class="im-ov-outcome-main">@(Case.OutcomeKey is { } ok ? OutcomeLabels.GetValueOrDefault(ok) ?? IncidentManager.Application.Admin.CaseOutcomeCatalog.Label(ok) : "Not recorded")</dd>
        </div>
        <div>
            <dt>Activity began</dt>
            <dd>@(Case.OccurredAtUtc is { } began ? TimeDisp.Short(began) + (BeganApprox is null ? "" : " (approximately)") : "Not recorded")</dd>
        </div>
        <div>
            <dt>Detected → contained</dt>
            <dd>@if (Case.ContainmentNotNeededReason is { } why) { <span title="@why">Not needed: @why</span> } else { @SpanFragment(Case.DetectedAtUtc, Case.ContainedAtUtc) }</dd>
        </div>
        <div>
            @if (RecoveryStarted is not null)
            {
                <dt>Recovery → closed</dt>
                <dd>@SpanFragment(RecoveryStarted, Case.ClosedAtUtc)</dd>
            }
            else
            {
                <dt>Closed</dt>
                <dd>@(Case.ClosedAtUtc is { } closed ? TimeDisp.Short(closed) : "Not recorded")</dd>
            }
        </div>
        <div>
            <dt>After closure</dt>
            <dd>
                @if (_lessons is null) { <span class="text-muted">…</span> }
                else if (_lessons.Review is not { IsRecorded: true }) { <span>No post-incident review</span> }
                else
                {
                    var open = _lessons.Actions.Count(a => a.Status is ImprovementActionStatus.Open or ImprovementActionStatus.InProgress);
                    <button type="button" class="btn btn-link p-0 align-baseline text-start" @onclick='() => OnGoToTab.InvokeAsync("Review")'>
                        @(open == 0 ? (_lessons.Actions.Count == 0 ? "No improvement actions" : "Improvement actions all closed")
                                    : $"{open} improvement {(open == 1 ? "action" : "actions")} open")
                    </button>
                }
            </dd>
        </div>
    </dl>
}

@* INV-09 / INV-36: the brief leads, with the case summary as its first part. *@
@* RD-04: where the Now/Next pane is beside the tab, the brief lives there and isn't repeated here. *@
@* RD-12: the Briefing's five questions, with the brief itself a click away. *@
@if (Section == "Briefing")
{
    <CaseBriefing @ref="_briefing" Case="Case" TaskResults="TaskResults" Notify="_deadlines" Readiness="ReadinessEval" DataElementLabels="_dataElementLabels"
                  CanEdit="CanEdit" OnChanged="OnChanged" OnGoToTab="OnGoToTab" OnShowSince="OnShowSince" OnShowGate="ShowGate"
                  OnAssign='() => OnOpenModal.InvokeAsync("assign")' />
}

<div class="im-ov">
    @* RD-12: a closed case's story; an open case's recent decisions are the Briefing's "Why". *@
    @if (Section == "Briefing" && Case.Phase == CasePhase.Closed)
    {
    var recent = RecentOnTimeline();
    <section class="im-ov-sec" id="ov-recent" aria-labelledby="ov-recent-h">
        <div class="im-ov-head">
            @if (Case.Phase == CasePhase.Closed)
            {
                @* HR-14: told as a story, oldest first. *@
                <h2 class="im-ov-h" id="ov-recent-h">How it unfolded</h2>
                <span class="small text-muted">key moments, oldest first</span>
            }
            else
            {
                <h2 class="im-ov-h" id="ov-recent-h">Recent on the timeline</h2>
            }
            <button type="button" class="btn btn-link btn-sm p-0 ms-auto" @onclick='() => OnGoToTab.InvokeAsync("Timeline")'>Open the timeline <span aria-hidden="true">→</span></button>
        </div>
        @if (recent.Count == 0)
        {
            <p class="text-muted small mb-0">No decisions, handoffs or response milestones yet. Phase and classification changes, decisions and completed tasks show here as they're recorded.</p>
        }
        else
        {
            <ul class="im-ov-recent">
                @for (var i = 0; i < recent.Count; i++)
                {
                    var r = recent[i];
                    @if (i == 8 && _storyHidden > 0 && Case.Phase == CasePhase.Closed)
                    {
                        <li class="im-ov-recent-gap"><span></span><span class="bi bi-three-dots" aria-hidden="true"></span>
                            <button type="button" class="btn btn-link btn-sm p-0 text-start" @onclick='() => OnGoToTab.InvokeAsync("Timeline")'>@_storyHidden more on the timeline</button></li>
                    }
                    <li>
                        <span class="im-ov-recent-at" title="@TimeDisp.Long(r.At)">@TimeDisp.DateOnly(r.At)<br /> @TimeDisp.TimeOnly(r.At)</span>
                        <span class="bi @r.Icon" aria-hidden="true"></span>
                        <span><span class="im-ov-recent-kind">@r.Kind</span> @r.Text</span>
                    </li>
                }
            </ul>
        }
    </section>
    }

    @if (Section == "Impact")
    {
    <section class="im-ov-sec" id="ov-impact" aria-labelledby="ov-impact-h">
        <div class="im-ov-head">
            <h2 class="im-ov-h" id="ov-impact-h">Scope and impact</h2>
            <AuthorizeView Policy="@Policies.EditCases" Context="ie">
                @if (!_editingImpact)
                {
                    <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="BeginEditImpact">Edit</button>
                }
            </AuthorizeView>
        </div>
                @if (_editingImpact)
                {
                    @* BUG-425: the impact editor's Ctrl/Cmd+Enter saves it (keymap.js leaves .im-own-keys to it). BUG-449: its fields bind on input, so the key saves what was just typed. *@
                    <div class="im-own-keys" @onkeydown="e => SaveOnKey(e, SaveImpact)">
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-imp-count">Affected individuals (estimate)</label>
                        <input id="ov-imp-count" type="number" min="0" class="form-control form-control-sm" @bind="_impCount" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-1 d-block">Data elements involved</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var el in _dataElements)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="de-@el.Key"
                                           checked="@_impElementKeys.Contains(el.Key)"
                                           @onchange="e => ToggleElement(el.Key, (bool)(e.Value ?? false))" />
                                    <label class="form-check-label small" for="de-@el.Key">@el.Label</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-imp-states">Affected jurisdictions (state codes, comma-separated)</label>
                        <input id="ov-imp-states" class="form-control form-control-sm" placeholder="e.g. NY, NJ, CT" @bind="_impStates" @bind:event="oninput" />
                    </div>
                    @if (_impactError is { } ierr)
                    {
                        <div class="alert alert-warning py-1 px-2 small mb-2">@ierr</div>
                    }
                    <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="SaveImpact">Save</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _editingImpact = false">Cancel</button>
                    </div>
                }
                else if (Case.AffectedIndividualsCount is null && Case.DataElements.Count == 0 && string.IsNullOrWhiteSpace(Case.AffectedStates))
                {
                    @if (Case.Phase == CasePhase.Closed)
                    {
                        @* HR-14: on a closed case it wasn't "not yet" anything; it wasn't recorded. *@
                        <p class="text-muted small mb-0">Not recorded.</p>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Not assessed yet. Record the affected count, data elements and jurisdictions for the Legal and regulatory handoff.</p>
                    }
                }
                else
                {
                    <dl class="im-ov-facts mb-0">
                        <div><dt>Affected individuals</dt><dd class="im-ov-big">@(Case.AffectedIndividualsCount?.ToString("N0") ?? "—")</dd></div>
                        <div><dt>Jurisdictions</dt><dd>@(Case.AffectedStates ?? "—")</dd></div>
                        <div><dt>Data elements</dt>
                            <dd>
                                @if (Case.DataElements.Count == 0)
                                {
                                    <text>—</text>
                                }
                                else
                                {
                                    @foreach (var key in SelectedElementKeysOrdered())
                                    {
                                        <span class="im-badge im-b-neutral me-1 mb-1">@DataElementLabel(key)</span>
                                    }
                                }
                            </dd>
                        </div>
                    </dl>
                }
    </section>
    }

    @if (Section == "Briefing")
    {
        @if (_deadlines is { Enabled: true })
        {
            <section class="im-ov-sec" id="ov-notify" aria-labelledby="ov-notify-h">
                <div class="im-ov-head">
                    <h2 class="im-ov-h" id="ov-notify-h">Notification</h2>
                    @if (_deadlines.Headline is { } hl)
                    {
                        <span class="@Ui.SlaBadge(hl.State)" title="Most urgent jurisdiction">
                            <span class="bi @Ui.SlaGlyph(hl.State)" aria-hidden="true"></span> @Ui.SlaLabel(hl.State)
                        </span>
                    }
                </div>
                <div class="im-sec-body">
                    <WhyThisMatters Class="mb-2">
                        Regulators set short, fixed notice windows. NYDFS Part 500, for example, expects notice within 72 hours of
                        determining a reportable cybersecurity incident. Each jurisdiction's clock comes from the data elements in the
                        impact assessment, so a notice at risk of running late shows here first. CaseBook only tracks the deadline:
                        notifying regulators, and recording it here, is up to your team.
                    </WhyThisMatters>
                    @* CAP-38: fully or partly reported, by the reading every view uses; never one "Reported" while a clock runs. *@
                    @if ((_deadlines.Standing.IsFullyReported || _deadlines.Standing.IsPartlyReported) && StandingLine(_deadlines) is { } standing)
                    {
                        <p class="small mb-2"><span class="bi @(_deadlines.Standing.IsFullyReported ? "bi-check2-circle text-success" : "bi-hourglass-split text-warning")" aria-hidden="true"></span>
                            @standing</p>
                    }
                    @if (_deadlines.AwaitingTrigger)
                    {
                        <p class="text-muted small mb-0">
                            @(_deadlines.StartBasis == NotificationStartBasis.Determination
                                ? "The countdown starts once the case is determined material. Record that from the Actions menu."
                                : "The countdown starts once this case is classified a Breach.")
                        </p>
                    }
                    else if (_deadlines.StartedButNoJurisdictions)
                    {
                        <p class="text-muted small mb-0">The recorded data elements don't trigger notice in any jurisdiction. If more data was involved, add it to the impact assessment above.</p>
                    }
                    else if (_deadlines.Statuses.Count > 0)
                    {
                        <table class="table table-sm im-table mb-2">
                            <thead><tr><th>Jurisdiction</th><th>Window</th><th>Deadline</th><th>Status</th><th>Notified</th></tr></thead>
                            <tbody>
                                @foreach (var s in _deadlines.Statuses)
                                {
                                    <tr>
                                        <td>@s.JurisdictionLabel <code class="small text-muted">@s.JurisdictionCode</code></td>
                                        <td class="small text-muted">@s.WindowHours h</td>
                                        <td class="small">@(s.DueAtUtc is { } d ? TimeDisp.Short(d) : "—")
                                            @if (s is { IsActive: true, Remaining: { } rem }) { <span class="text-muted"> (@RemainingLabel(rem))</span> }
                                        </td>
                                        <td><span class="@Ui.SlaBadge(s.State)">@Ui.SlaLabel(s.State)</span></td>
                                        @* BUG-09: each regulator's notice is recorded on its own row; its clock stops there. *@
                                        <td class="small">
                                            @if (s.NotifiedAtUtc is { } notified)
                                            {
                                                @TimeDisp.Short(notified)
                                                @if (CanEdit && _deadlines.NoticeCodes.Contains(s.JurisdictionCode))
                                                {
                                                    <button type="button" class="im-rail-x ms-1" aria-label="Remove the notice to @s.JurisdictionLabel"
                                                            title="Remove this notice (a mis-entry)" @onclick="() => RemoveNotice(s.JurisdictionCode, s.JurisdictionLabel)">×</button>
                                                }
                                                @* CAP-07: how the regulator was notified, shown and edited on the row; the time stays. *@
                                                @if (CanEdit && _noticeEditing && _notice.IsOpenFor(s.JurisdictionCode))
                                                {
                                                    <div class="d-flex align-items-center gap-1 flex-wrap im-own-keys mt-1"
                                                         @onkeydown="e => SaveOnKey(e, SaveNoticeDetails)">
                                                        @NoticeFields(s.JurisdictionLabel)
                                                        <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="SaveNoticeDetails">Save</button>
                                                        <button class="btn btn-sm btn-outline-secondary" @onclick="_notice.Close">Cancel</button>
                                                    </div>
                                                    @if (_noticeError is not null) { <div class="text-danger small">@_noticeError</div> }
                                                }
                                                else
                                                {
                                                    @if (NoticeHow(s.JurisdictionCode) is { } how) { <div class="text-muted">@how</div> }
                                                    @if (CanEdit && OwnNotice(s.JurisdictionCode) is { } own)
                                                    {
                                                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => BeginNoticeDetails(s.JurisdictionCode, own)">@(own.HasDetails ? "Edit how notified" : "Add how notified")</button>
                                                    }
                                                }
                                            }
                                            else if (CanEdit && _notice.IsOpenFor(s.JurisdictionCode))
                                            {
                                                @* BUG-425: Ctrl/Cmd+Enter records this notice, not the case record's details. *@
                                                <div class="d-flex align-items-center gap-1 flex-wrap im-own-keys"
                                                     @onkeydown="e => SaveOnKey(e, SaveNotice)">
                                                    <DateTimeInput Past="true" class="form-control form-control-sm" style="max-width: 13rem" @bind-Value="_noticeAt"
                                                           aria-label="@($"When {s.JurisdictionLabel} was notified ({TimeDisp.Label})")" />
                                                    @NoticeFields(s.JurisdictionLabel)   @* CAP-07: optional *@
                                                    <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="SaveNotice">Save</button>
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="_notice.Close">Cancel</button>
                                                </div>
                                                @if (_noticeError is not null) { <div class="text-danger small">@_noticeError</div> }
                                            }
                                            else if (CanEdit)
                                            {
                                                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => BeginNotice(s.JurisdictionCode, s.NotifiedAtUtc)">Record notice</button>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Not yet</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (CanEdit)
                    {
                        @if (!_deadlines.Standing.IsFullyReported && !_deadlines.AwaitingTrigger)
                        {
                            @if (_markingReported)
                            {
                                @* BUG-425: Ctrl/Cmd+Enter records the reported time, not the case record's details. *@
                                <div class="d-flex align-items-end gap-2 flex-wrap im-own-keys" @onkeydown="e => SaveOnKey(e, MarkReported)">
                                    <div>
                                        <label class="form-label small mb-0" for="ov-reported-at">@(_deadlines.Statuses.Count > 1 || _deadlines.Standing.IsPartlyReported ? "Every regulator not yet recorded was notified at" : "Reported at") (@TimeDisp.Label)</label>
                                        <DateTimeInput Past="true" id="ov-reported-at" class="form-control form-control-sm" @bind-Value="_reportedAt"
                                               title="When regulators were notified. Saving this stops the notification countdown." />
                                    </div>
                                    <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="MarkReported">Save</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _markingReported = false">Cancel</button>
                                </div>
                                @* CAP-38 review: the regulators a save records, as read when the form opened (or after a refusal). *@
                                @if (_outstandingShown.Count > 0) { <p class="small text-muted mt-1 mb-0">Records a notice to @string.Join(", ", _outstandingShown).</p> }
                                @if (_reportedError is not null) { <p class="text-danger small mt-1 mb-0" role="alert">@_reportedError</p> }
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="BeginMarkReported">
                                    <span class="bi bi-send-check" aria-hidden="true"></span> @(_deadlines.Standing.IsPartlyReported ? "Record notice to the remaining regulators" : _deadlines.Statuses.Count > 1 ? "Record notice to all regulators" : "Mark reported to regulators")
                                </button>
                            }
                        }
                        else if (_deadlines.Standing.IsFullyReported)
                        {
                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="ClearReported">@(_deadlines.NoticeCodes.Count > 1 ? "Clear all notices" : "Clear reported milestone")</button>
                        }
                    }
                </div>
            </section>
        }


        @if (ReadinessEval is { } rg)
        {
            <section class="im-ov-sec" id="ov-gate" aria-labelledby="ov-gate-h">
                <div class="im-ov-head">
                    <h2 class="im-ov-h" id="ov-gate-h">Next gate: @StageGateTriggers.Label(rg.Trigger)</h2>
                    <div class="d-flex align-items-center gap-2 ms-auto">
                        @if (ReadinessMachineOutstanding == 0)
                        {
                            <span class="im-badge im-b-ok">Data complete</span>
                        }
                        else
                        {
                            <span class="im-badge im-b-warn">@ReadinessMachineOutstanding outstanding</span>
                        }
                        <button class="btn btn-sm btn-link p-0 text-decoration-none" @onclick="() => _showReadiness = !_showReadiness" aria-expanded="@Ui.Aria(_showReadiness)" aria-label="Show what the next gate checks">
                            <span class="bi @(_showReadiness ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
                @if (_showReadiness)
                {
                    <p class="text-muted small mb-2">What's needed to <strong>@StageGateTriggers.Label(rg.Trigger).ToLowerInvariant()</strong>. Checked when you make the change. You can override it with a recorded justification.</p>
                    <GateChecklist Eval="rg" Attested="_readinessAttested" Interactive="false" OnFix="@(CanEdit ? EventCallback.Factory.Create<string>(this, FixReadiness) : default)" />
                }
            </section>
        }


    <section class="im-ov-sec" id="ov-details" aria-labelledby="ov-details-h">
        <div class="im-ov-head">
            <h2 class="im-ov-h" id="ov-details-h">Case record</h2>
            <AuthorizeView Policy="@Policies.EditCases" Context="ed">
                @if (!_editingDetails)
                {
                    <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="BeginEditDetails">Edit details</button>
                }
            </AuthorizeView>
        </div>
                @if (_editingDetails)
                {
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-title">Title</label>
                        <input id="ov-title" class="form-control form-control-sm" @bind="_edTitle" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-detection">@DetectionLabel case ID</label>
                        <input id="ov-detection" class="form-control form-control-sm" @bind="_edDetection" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-data-context">Data context <span class="text-muted">(notes)</span></label>
                        <input id="ov-data-context" class="form-control form-control-sm" @bind="_edDataTypes" @bind:event="oninput" />
                        <div class="form-text mt-0">Free-text notes. The impact assessment's data elements are the official list.</div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-impacted">Impacted assets</label>
                        <input id="ov-impacted" class="form-control form-control-sm" @bind="_edImpacted" @bind:event="oninput" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-sm-6">
                            <label class="form-label small mb-0" for="ov-detected">Detected (@TimeDisp.Label)</label>
                            <DateTimeInput Past="true" id="ov-detected" class="form-control form-control-sm" @bind-Value="_edDetected"
                                   title="When this was first detected or reported, not when the case was opened. Starts the response SLA clock." />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small mb-0" for="ov-occurred">Initial activity <span class="text-muted">(optional)</span></label>
                            <DateTimeInput Past="true" id="ov-occurred" class="form-control form-control-sm" @bind-Value="_edOccurred"
                                   title="When adversary activity began (initial access), if known. Used to calculate dwell time." />
                        </div>
                    </div>
                    @* INV-36: the summary is edited in the brief ("Where it stands"), where each version is kept. *@
                    @if (_detailsError is { } derr)
                    {
                        <div class="alert alert-warning py-1 px-2 small mb-2" role="alert">@derr</div>
                    }
                    <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="SaveDetails" disabled="@(string.IsNullOrWhiteSpace(_edTitle) || _edDetected is null)">Save</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _editingDetails = false)">Cancel</button>
                }
                else
                {
                    <dl class="row mb-0 im-ov-dl">
                        <CaseOriginField Case="Case" CanEdit="CanEdit" OnChanged="OnChanged" />
                        @if (Teams is { Count: > 0 } || Case.TeamId is not null)
                        {
                            <CaseTeamField Case="Case" Teams="@(Teams ?? [])" CanEdit="CanEdit" OnChanged="OnChanged" />
                        }
                        @if (Case.ThirdParty is not null)
                        {
                            <dt class="col-sm-3">Vendor</dt>
                            <dd class="col-sm-9">@Case.ThirdParty.VendorName@(string.IsNullOrWhiteSpace(Case.ThirdParty.VendorContact) ? "" : $" ({Case.ThirdParty.VendorContact})")</dd>
                        }
                        <dt class="col-sm-3">@DetectionLabel case</dt>
                        <dd class="col-sm-9">@(Case.DetectionCaseId ?? "—")
                            @{ var detectionUrl = DetectionCaseUrl(); }
                            @if (detectionUrl is not null)
                            {
                                <a class="btn btn-sm btn-outline-secondary py-0 ms-2" href="@detectionUrl" target="_blank" rel="noopener noreferrer">Open in @DetectionLabel</a>
                            }
                        </dd>
                        <dt class="col-sm-3">Data context</dt>
