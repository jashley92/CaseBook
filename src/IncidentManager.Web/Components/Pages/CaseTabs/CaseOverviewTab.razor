    private async Task DoUnassign(string userId)
    {
        await Cases.UnassignAsync(CaseId, userId);
        await OnChanged.InvokeAsync();
        Toasts.Success("Assignment removed");
    }

    private async Task RemoveTechnique(Guid techniqueId)
    {
        await Cases.RemoveTechniqueAsync(CaseId, techniqueId);
        await OnChanged.InvokeAsync();
        Toasts.Success("Technique removed");
    }

    private void OpenTechMatrix() => _techMatrixOpen = true;
    private void CancelTechMatrix() => _techMatrixOpen = false;

    // The case's current technique tags as id → tactic, seeding the matrix's selection state.
    private IReadOnlyDictionary<string, MitreTactic> CurrentTechniqueMap() =>
        Case.Techniques.ToDictionary(t => t.TechniqueId, t => t.Tactic, StringComparer.OrdinalIgnoreCase);

    // Sync the case's techniques to the matrix's chosen set: remove dropped tags, add new ones, and
    // re-tag any whose tactic (column) changed. AddTechniqueAsync upserts, so a tactic change is a re-add.
    private async Task ApplyTechMatrix(IReadOnlyDictionary<string, MitreTactic> desired)
    {
        _techMatrixOpen = false;
        var current = Case.Techniques.ToList();

        foreach (var t in current.Where(t => !desired.ContainsKey(t.TechniqueId)))
            await Cases.RemoveTechniqueAsync(CaseId, t.Id);

        foreach (var kv in desired)
        {
            var existing = current.FirstOrDefault(t => string.Equals(t.TechniqueId, kv.Key, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
                await Cases.AddTechniqueAsync(CaseId, kv.Key, AttackCatalog.Find(kv.Key)?.Name ?? "", kv.Value);
            else if (existing.Tactic != kv.Value)
                await Cases.AddTechniqueAsync(CaseId, kv.Key, existing.Name, kv.Value);
        }

        await OnChanged.InvokeAsync();
        Toasts.Success("Techniques updated");
    }

    // --- Related cases (E-14) ---
    private async Task LoadLinks() => _links = await Cases.GetCaseLinksAsync(CaseId);

    private void BeginAddLink()
    {
        _addingLink = true;
        _linkType = CaseLinkType.RelatedTo;
        ClearLinkTarget();
        _linkDesc = null;
    }

    private void CancelAddLink()
    {
        _addingLink = false;
        ClearLinkTarget();
    }

    private void ClearLinkTarget()
    {
        _linkTargetId = null;
        _linkTargetLabel = null;
        _linkQuery = "";
        _linkResults = Array.Empty<LinkableCase>();
    }

    private async Task SearchLinkTargets()
    {
        _linkResults = string.IsNullOrWhiteSpace(_linkQuery)
            ? Array.Empty<LinkableCase>()
            : await Cases.SearchLinkableCasesAsync(CaseId, _linkQuery);
    }

    private void SelectLinkTarget(LinkableCase c)
    {
        _linkTargetId = c.Id;
        _linkTargetLabel = $"{c.CaseNumber} — {c.Title}";
        _linkResults = Array.Empty<LinkableCase>();
    }

    private async Task AddLink()
    {
        if (_linkTargetId is not { } target) return;
        try
        {
            var created = await Cases.LinkCaseAsync(CaseId, target, _linkType, _linkDesc);
            if (created is null) { Toasts.Warning("Those cases are already linked."); }
            else { Toasts.Success("Case linked."); }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Toasts.Warning(ex.Message);
        }
        _addingLink = false;
        ClearLinkTarget();
        _linkDesc = null;
        await LoadLinks();
    }

    private async Task RemoveLink(Guid linkId)
    {
        await Cases.RemoveCaseLinkAsync(CaseId, linkId);
        Toasts.Success("Link removed.");
        await LoadLinks();
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var id in _mdEditors)
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); }
            catch { /* circuit may already be gone during teardown */ }
        }
        _mdEditors.Clear();
    }
}
