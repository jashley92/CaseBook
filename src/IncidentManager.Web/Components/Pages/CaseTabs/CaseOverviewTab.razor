    private Task AddLink() => _saving.Run(AddLinkCore);

    private async Task AddLinkCore()
    {
        if (_linkTargetId is not { } target) return;
        var sentNote = _linkDesc;
        try
        {
            var created = await Cases.LinkCaseAsync(CaseId, target, _linkType, sentNote);
            if (created is null) { Toasts.Warning("Those cases are already linked."); }
            else { Toasts.Success("Case linked."); }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Warning(ex.Message);
            return; // keep the picker and description so the user can adjust and retry
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            // BUG-525: a save the database refused shows a message, not a broken page; the form stays for a retry.
            Toasts.Warning("The link wasn't saved. Reload the case and try again.");
            return;
        }
        _addingLink = false;
        ClearLinkTarget();
        _linkDesc = DraftText.ClearIfUnchanged(_linkDesc, sentNote, null);   // BUG-601 (the note is disabled while it saves)
        await LoadLinks();
    }

    private Task RemoveLink(Guid linkId) => _removing.Run(() => RemoveLinkCore(linkId));

    private async Task RemoveLinkCore(Guid linkId)
    {
        await Cases.RemoveCaseLinkAsync(CaseId, linkId);
        Toasts.Success("Link removed.");
        await LoadLinks();
    }

    /// <summary>BUG-425: removed from the page (a tab switch, the phone's Now/Next view, the error fallback); the
    /// workspace's @ref still points here, so its Ctrl/Cmd+Enter checks this first (CaseWorkspace.Keyboard).</summary>
    internal bool Disposed { get; private set; }

    public async ValueTask DisposeAsync()
    {
        Disposed = true;
        Edits.Forget(this);
        foreach (var id in _mdEditors)
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); }
            catch { /* circuit may already be gone during teardown */ }
        }
        _mdEditors.Clear();
    }
}
