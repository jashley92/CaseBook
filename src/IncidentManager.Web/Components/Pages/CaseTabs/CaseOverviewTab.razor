        <input class="form-control form-control-sm" style="max-width: 12rem" @bind="_nReference" @bind:event="oninput"
               maxlength="@JurisdictionNotice.MaxReferenceLength" placeholder="Reference number" aria-label="@($"{label}'s reference or confirmation number")" />
        <input class="form-control form-control-sm" style="max-width: 12rem" @bind="_nBy" @bind:event="oninput"
               maxlength="@JurisdictionNotice.MaxNotifiedByLength" placeholder="Notified by" aria-label="@($"Who notified {label}")" />
        <select class="form-select form-select-sm" style="max-width: 14rem" @bind="_nEvidence" aria-label="@($"The evidence file holding the notice to {label}")">
            <option value="">Notice file…</option>
            @* CAP-21: a withdrawn file isn't offered (the notice's own, if it were one, still shows as chosen). *@
            @foreach (var ev in Case.Evidence.Where(e => !e.IsWithdrawn || e.Id.ToString() == _nEvidence).OrderBy(e => e.OriginalFileName, StringComparer.OrdinalIgnoreCase))
            {
                <option value="@ev.Id.ToString()">@ev.OriginalFileName</option>
            }
            @if (_nEvidence.Length > 0 && !Case.Evidence.Any(e => e.Id.ToString() == _nEvidence))
            {
                <option value="@_nEvidence">@NoticeDetailText.MissingFile</option>
            }
        </select>
    };

    private Task RemoveNotice(string code, string label) =>
        RequestConfirm.InvokeAsync(($"Remove the notice to {label}? Its countdown resumes.", "Remove",
            () => _removing.Run(() => RemoveNoticeCore(code))));

    private async Task RemoveNoticeCore(string code)
    {
        await Cases.RemoveNoticeAsync(CaseId, code);
        await LoadDeadlines();
        await OnChanged.InvokeAsync();
        Toasts.Success("Notice removed");
    }

    private DateTime? _reportedAt, _reportedSeed;
    private DateTimeOffset? _reportedShown;   // BUG-594: the reported time the page showed when the form opened
