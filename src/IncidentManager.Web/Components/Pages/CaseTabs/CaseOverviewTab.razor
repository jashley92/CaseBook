        await OnChanged.InvokeAsync();
        Toasts.Success("Technique removed");
    }

    // BUG-296: the techniques as the picker opened, so applying changes only what this person changed: a tag a colleague
    // added since isn't removed, nor a tactic they changed put back.
    private IReadOnlyDictionary<string, MitreTactic> _techOpenedWith = new Dictionary<string, MitreTactic>();
    private void OpenTechMatrix() { _techOpenedWith = CurrentTechniqueMap(); _techMatrixOpen = true; }
    private void CancelTechMatrix() => _techMatrixOpen = false;

    // The case's current technique tags as id → tactic, seeding the matrix's selection state.
    private IReadOnlyDictionary<string, MitreTactic> CurrentTechniqueMap() =>
        Case.Techniques.ToDictionary(t => t.TechniqueId, t => t.Tactic, StringComparer.OrdinalIgnoreCase);

    // Sync the case's techniques to the matrix's chosen set: remove dropped tags, add new ones, and
    // re-tag any whose tactic (column) changed. AddTechniqueAsync upserts, so a tactic change is a re-add.
    private Task ApplyTechMatrix(IReadOnlyDictionary<string, MitreTactic> desired) => _tagging.Run(() => ApplyTechMatrixCore(desired));

    private async Task ApplyTechMatrixCore(IReadOnlyDictionary<string, MitreTactic> desired)
    {
        _techMatrixOpen = false;
        var current = Case.Techniques.ToList();   // as the live refresh has it now
        var opened = _techOpenedWith;
        CaseTechnique? Live(string id) => current.FirstOrDefault(t => string.Equals(t.TechniqueId, id, StringComparison.OrdinalIgnoreCase));

        try
        {
            // Taken off in the picker (and still on the case as it was).
            foreach (var (id, tactic) in opened.Where(o => !desired.ContainsKey(o.Key)))
                if (Live(id) is { } t && t.Tactic == tactic)
                    await Cases.RemoveTechniqueAsync(CaseId, t.Id);

            foreach (var kv in desired)
            {
                var existing = Live(kv.Key);
                if (!opened.TryGetValue(kv.Key, out var was))
                {
                    if (existing is null)
                        await Cases.AddTechniqueAsync(CaseId, kv.Key, AttackCatalog.Find(kv.Key)?.Name ?? "", kv.Value);
                }
                else if (was != kv.Value && existing is not null && existing.Tactic == was)
                    await Cases.AddTechniqueAsync(CaseId, kv.Key, existing.Name, kv.Value);   // re-tactic only what wasn't changed since
            }
            Toasts.Success("Techniques updated");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
        await OnChanged.InvokeAsync(); // reload either way, so a partial update shows what was saved
    }

