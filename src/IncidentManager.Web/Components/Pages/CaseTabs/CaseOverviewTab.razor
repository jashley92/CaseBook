    /// <summary>HR-02: each task's latest recorded result.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, IncidentManager.Application.Cases.TaskResult> TaskResults { get; set; } = new Dictionary<Guid, IncidentManager.Application.Cases.TaskResult>();
    [Parameter] public bool CanEdit { get; set; }
    /// <summary>CAP-36: the teams (null while the workspace reads them), for the case's team and its detection source.</summary>
    [Parameter] public IReadOnlyList<IncidentManager.Application.Admin.TeamView>? Teams { get; set; }
    /// <summary>S-08: whether this user may lift the need-to-know restriction (the IC or a cleared role).</summary>
    [Parameter] public bool CanLiftRestriction { get; set; }
    /// <summary>Retention-guard message set by the parent's legal-hold / archive actions (header, any tab).</summary>
    [Parameter] public string? RetentionMessage { get; set; }
    /// <summary>The next-gate readiness evaluation, computed in the parent's Reload (null when none applies).</summary>
    [Parameter] public GateEvaluation? ReadinessEval { get; set; }
    /// <summary>RD-04: the brief is in the Now/Next pane beside this tab, so the Overview doesn't show it.</summary>
    [Parameter] public bool BriefInPane { get; set; }
    /// <summary>RD-11: which part to show: "Briefing", "Impact", "Attack" or "Connections".</summary>
    [Parameter] public string Section { get; set; } = "Briefing";
    /// <summary>RD-04: open the brief editor in the pane (the summary gate check's Fix).</summary>
    [Parameter] public EventCallback OnEditBrief { get; set; }
    /// <summary>Reload the case after a write so the rest of the workspace refreshes.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Ask the parent's shared confirm dialog to guard a destructive action.</summary>
    [Parameter] public EventCallback<(string Message, string Verb, Func<Task> OnConfirm)> RequestConfirm { get; set; }
    /// <summary>Open one of the parent's action modals (used for the assign modal).</summary>
    [Parameter] public EventCallback<string> OnOpenModal { get; set; }

    /// <summary>A readiness "Fix" this tab can't satisfy in place (a tab or a dialog); the workspace routes it.</summary>
    [Parameter] public EventCallback<string> OnFix { get; set; }
    /// <summary>INV-29: switch the workspace to another tab (e.g. "Open the timeline").</summary>
    [Parameter] public EventCallback<string> OnGoToTab { get; set; }
    /// <summary>INV-27: show the timeline's changes since a time.</summary>
    [Parameter] public EventCallback<DateTimeOffset> OnShowSince { get; set; }
    /// <summary>Bumped by the parent on a collaborator change, to re-pull related cases.</summary>
    [Parameter] public int RefreshToken { get; set; }

    private CaseBriefing? _briefing;
    private readonly HashSet<string> _mdEditors = new();
    private readonly HashSet<Guid> _readinessAttested = new(); // always empty — the card is read-only
    private int _loadedToken = int.MinValue;

    // Details edit buffer
    private bool _editingDetails;
    private string _edTitle = "";
    private string? _edSummary;
    private string? _edDetection;
    private string? _edDataTypes;
    private string? _edImpacted;
    private DateTime? _edDetected;
    private DateTime? _edOccurred;
    private DateTime? _edDetectedShown, _edOccurredShown;   // WF-68: as seeded, to keep an untouched instant
    private DateTimeOffset? _edDetectedAt, _edOccurredAt;   // BUG-553: the instants those were seeded from
    private string? _detailsError;
    private string? _detailsBaseline; // FR-06: field signature captured when the editor opened

    // Structured impact assessment (E-12)
    private bool _editingImpact;
    private int? _impCount;
    private HashSet<string> _impElementKeys = new(StringComparer.Ordinal);
    private string? _impStates;
    private string? _impactError;
    private string? _impactBaseline; // FR-06: field signature captured when the editor opened
    private IReadOnlyList<DataElement> _dataElements = Array.Empty<DataElement>();
    private IReadOnlyDictionary<string, string> _dataElementLabels = new Dictionary<string, string>();

    // Regulatory notification deadlines (PROD-07)
    private CaseNotificationDeadlines? _deadlines;
    private bool _markingReported;
    // BUG-601: each evaluation takes a ticket, so an older one (a parameter set, a save) landing last doesn't show stale
    // deadlines.
    private readonly LoadSequence _deadlineLoad = new();

    private async Task LoadDeadlines()
    {
        var t = _deadlineLoad.Begin();
        var deadlines = await Deadlines.EvaluateAsync(CaseId);
        if (!_deadlineLoad.IsCurrent(t)) return;
        _deadlines = deadlines;
        // A notice a colleague recorded meanwhile hides its form; the slot is let go so another row's can open. CAP-07: an
        // edit of how one was notified stays open while its notice does (a save over a colleague's change is refused, and
        // what's typed is kept); a notice removed meanwhile takes its form with it.
        if (_notice.Current is { } open && (_noticeEditing
                ? !deadlines.NoticeCodes.Contains(open.Key) || !deadlines.Statuses.Any(s => s.JurisdictionCode == open.Key && s.NotifiedAtUtc is not null)
                : !deadlines.Statuses.Any(s => s.JurisdictionCode == open.Key && s.NotifiedAtUtc is null)))
            _notice.Close();
    }

    // BUG-09: recording one regulator's notice. BUG-578/601: one notice form at a time (a second is refused, not
    // replaced), and a save closes only its own.
    private readonly EditSlot<string> _notice = new();
    private DateTime? _noticeAt, _noticeSeed;
    private DateTimeOffset? _noticeShown;   // BUG-594: that regulator's notice as the page showed it when the form opened
    private string? _noticeError;

    private void BeginNotice(string code, DateTimeOffset? shown)
    {
        if (!_notice.TryOpen(code, Toasts, "notice")) return;
        _noticeEditing = false;
        _noticeError = null;
        _noticeAt = _noticeSeed = WallClock.ToWall(Clock.UtcNow, TimeDisp.Zone);
        _noticeShown = shown;
        SeedNoticeDetails(null);
    }

    private Task SaveNotice() => _saving.Run(SaveNoticeCore);

    private async Task SaveNoticeCore()
    {
        if (_notice.Current is not { } open || _noticeEditing) return;
        _noticeError = null;
        if (_noticeAt is not { } at) { _noticeError = "Enter when they were notified."; return; }
        try
        {
            // BUG-594: refused when someone recorded this regulator's notice after the form opened. CAP-07: with how it
            // was notified, when any of that was given.
            var how = TypedNoticeDetails();
            await Cases.RecordNoticeAsync(CaseId, open.Key, WallClock.ToUtc(at, TimeDisp.Zone), Shown.Of(_noticeShown),
                how.IsEmpty ? null : how);
            _notice.CloseIf(open);
            await LoadDeadlines();
            await OnChanged.InvokeAsync();
            Toasts.Success("Notice recorded");
        }
        catch (StaleEditException ex)
        {
            _notice.CloseIf(open);
            Toasts.Error(ex.Message);
            await LoadDeadlines();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            if (_notice.IsCurrent(open)) _noticeError = ex.Message;
        }
    }

    // CAP-07: how the regulator was notified (method, reference, who, the notice file), typed with a new notice or edited on
    // one already recorded (_noticeEditing). It shares the notice slot, so one notice form is open at a time (BUG-578).
    private bool _noticeEditing;
    private string _nMethod = "", _nReference = "", _nBy = "", _nEvidence = "";
    private string? _noticeDetailsSeed;
    private string? _noticeStamp;   // FR-06 / REL-02: the details as the form opened with them

    private string NoticeDetailsInput() => string.Join("\u001f", _nMethod, _nReference, _nBy, _nEvidence);

    private void SeedNoticeDetails(JurisdictionNotice? n)
    {
        _nMethod = n?.Method?.ToString() ?? "";
        _nReference = n?.Reference ?? "";
        _nBy = n?.NotifiedBy ?? "";
        _nEvidence = n?.EvidenceId?.ToString() ?? "";
        _noticeDetailsSeed = NoticeDetailsInput();
    }

    // C16: the method is read by name only.
    private NoticeDetails TypedNoticeDetails()
    {
        NoticeMethod? method = null;
        if (_nMethod.Length > 0)
            method = IncidentManager.Domain.Common.EnumNames.TryParse<NoticeMethod>(_nMethod, out var m) ? m
                : throw new ArgumentException("Choose how the regulator was notified from the list.");
        Guid? file = null;
        if (_nEvidence.Length > 0)
            file = Guid.TryParse(_nEvidence, out var g) ? g : throw new ArgumentException("Choose the notice file from the case's evidence.");
        return new NoticeDetails(method, _nReference, _nBy, file);
    }

    // The notice recorded for exactly this code (a legacy "NY;CA" one is shown under each code, but edited as a whole: not here).
    private JurisdictionNotice? OwnNotice(string code) =>
        _deadlines?.NoticeCodes.Contains(code) == true
            ? Case.JurisdictionNotices.FirstOrDefault(n => string.Equals(n.Jurisdiction, code, StringComparison.OrdinalIgnoreCase)) : null;

    // CAP-38: "Partly reported: NY notified …, CA due …", in the wording the Briefing, report and register use.
    private string? StandingLine(CaseNotificationDeadlines d) => NoticeDetailText.Standing(d, TimeDisp.Short);

    // How a regulator was notified, in words (BUG-428: a legacy "NY;CA" notice counts for each code).
    private string? NoticeHow(string code) =>
        Case.ByNoticeCode(Case.JurisdictionNotices.Select(n => (n.Jurisdiction, n))).GetValueOrDefault(code) is { } notice
            ? NoticeDetailText.Summary(notice, Case.Evidence) : null;

    private void BeginNoticeDetails(string code, JurisdictionNotice n)
    {
        if (!_notice.TryOpen(code, Toasts, "notice")) return;
        _noticeEditing = true;
        _noticeError = null;
        _noticeAt = _noticeSeed = null;   // no time on this form
        _noticeStamp = n.DetailsConcurrencyStamp();
        SeedNoticeDetails(n);
    }

    private Task SaveNoticeDetails() => _saving.Run(SaveNoticeDetailsCore);

    private async Task SaveNoticeDetailsCore()
    {
        if (_notice.Current is not { } open || !_noticeEditing) return;
        _noticeError = null;
        try
        {
            if (await Cases.UpdateNoticeDetailsAsync(CaseId, open.Key, TypedNoticeDetails(), _noticeStamp))
            {
                await LoadDeadlines();
                await OnChanged.InvokeAsync();
                Toasts.Success("Notice details saved");
            }
            _notice.CloseIf(open);
        }
        catch (StaleEditException ex)   // FR-06: a colleague changed (or removed) it while this was open
        {
            if (!_notice.IsCurrent(open)) return;
            _noticeStamp = ex.CurrentStamp;   // re-baselined, so a deliberate second Save overwrites theirs
            _noticeError = ex.Message;
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            if (_notice.IsCurrent(open)) _noticeError = ex.Message;
        }
    }

    // CAP-07: the optional fields, in the record form and the edit form alike.
    private RenderFragment NoticeFields(string label) => __builder =>
    {
        <select class="form-select form-select-sm" style="max-width: 9rem" @bind="_nMethod" aria-label="@($"How {label} was notified")">
            <option value="">Method…</option>
