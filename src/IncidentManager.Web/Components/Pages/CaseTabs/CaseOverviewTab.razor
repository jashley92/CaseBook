        _linkTargetLabel = null;
        _linkQuery = "";
        _linkResults = Array.Empty<LinkableCase>();
        _linkSearch.Invalidate();   // BUG-482: a search still running doesn't land in the cleared picker
    }

    // BUG-482 (as BUG-454): each search takes a ticket and only the latest one's results land, so an older (slower)
    // query's, or one for a box since cleared, doesn't replace them.
    private readonly LoadSequence _linkSearch = new();

    private async Task SearchLinkTargets()
    {
        var t = _linkSearch.Begin();
        if (string.IsNullOrWhiteSpace(_linkQuery)) { _linkResults = Array.Empty<LinkableCase>(); return; }
        var found = await Cases.SearchLinkableCasesAsync(CaseId, _linkQuery);
