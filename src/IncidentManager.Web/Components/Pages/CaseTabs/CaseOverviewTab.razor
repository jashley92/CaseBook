@* Case workspace — Overview tab (UX-13, the last tab). The workspace "hub": the vitals/SLA strip, case
   details, the structured impact assessment (E-12), stage-readiness,
   assignments, MITRE ATT&CK techniques (with the matrix picker), related cases (E-14), and the change log.
   It owns its Summary EasyMDE editor (own reconcile + teardown) — the last such editor, so the parent's
   central reconcile retires. Parent-owned chrome is threaded in: the retention alert (RetentionMessage, set
   by header actions), the readiness gate (ReadinessEval, computed in the parent's Reload), the shared
   confirm dialog (RequestConfirm→AskConfirm), the assign modal (OnOpenModal→parent OpenModal), a Reload
   after a write (OnChanged), a RefreshToken (bumped on collaborator changes) to re-pull related cases, and
   Ctrl+Enter save via SubmitAsync (@ref). *@
@implements IAsyncDisposable
@inject CaseService Cases
@inject IConfiguration Config
@inject IClock Clock
@inject IncidentManager.Application.Content.IMarkdownService Md
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject TimeDisplay TimeDisp
@inject ToastService Toasts
@inject ISeverityLabels SevLabels
@inject IJSRuntime JS
@inject IncidentManager.Application.Sla.ISlaTargetsProvider SlaProvider
@inject IncidentManager.Application.Compliance.NotificationDeadlineService Deadlines
@using IncidentManager.Application.Compliance

@if (RetentionMessage is not null)
{
    <div class="alert alert-danger py-2 small">@RetentionMessage</div>
}

@* INV-29: one reading column, in the order someone opening the case asks: where it stands (the summary and the
   brief), what just happened, how bad it is and who must be told, whether it can move on, then the reference facts.
   The clocks, dates, next steps and team live in the case context panel (or its strip), not here. *@
@* INV-09 / INV-36: the brief leads, with the case summary as its first part. *@
<CaseBriefCard @ref="_brief" Case="Case" CanEdit="CanEdit" OnChanged="OnChanged" OnGoToTab="OnGoToTab" OnShowSince="OnShowSince" />

<div class="im-ov">
    @{ var recent = RecentOnTimeline(); }
    <section class="im-ov-sec" id="ov-recent" aria-labelledby="ov-recent-h">
        <div class="im-ov-head">
            <h2 class="im-ov-h" id="ov-recent-h">Recent on the timeline</h2>
            <button type="button" class="btn btn-link btn-sm p-0 ms-auto" @onclick='() => OnGoToTab.InvokeAsync("Timeline")'>Open the timeline <span aria-hidden="true">→</span></button>
        </div>
        @if (recent.Count == 0)
        {
            <p class="text-muted small mb-0">No decisions, handoffs or response milestones yet. Phase and classification changes, decisions and completed tasks show here as they're recorded.</p>
        }
        else
        {
            <ul class="im-ov-recent">
                @foreach (var r in recent)
                {
                    <li>
                        <span class="im-ov-recent-at" title="@TimeDisp.Long(r.At)">@TimeDisp.DateOnly(r.At)<br /> @TimeDisp.TimeOnly(r.At)</span>
                        <span class="bi @r.Icon" aria-hidden="true"></span>
                        <span><span class="im-ov-recent-kind">@r.Kind</span> @r.Text</span>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="im-ov-sec" id="ov-impact" aria-labelledby="ov-impact-h">
        <div class="im-ov-head">
            <h2 class="im-ov-h" id="ov-impact-h">Scope and impact</h2>
            <AuthorizeView Policy="@Policies.EditCases" Context="ie">
                @if (!_editingImpact)
                {
                    <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="BeginEditImpact">Edit</button>
                }
            </AuthorizeView>
        </div>
                @if (_editingImpact)
                {
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-imp-count">Affected individuals (estimate)</label>
                        <input id="ov-imp-count" type="number" min="0" class="form-control form-control-sm" @bind="_impCount" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-1 d-block">Data elements involved</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var el in _dataElements)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="de-@el.Key"
                                           checked="@_impElementKeys.Contains(el.Key)"
                                           @onchange="e => ToggleElement(el.Key, (bool)(e.Value ?? false))" />
                                    <label class="form-check-label small" for="de-@el.Key">@el.Label</label>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-imp-states">Affected jurisdictions (state codes, comma-separated)</label>
                        <input id="ov-imp-states" class="form-control form-control-sm" placeholder="e.g. NY, NJ, CT" @bind="_impStates" />
                    </div>
                    @if (_impactError is { } ierr)
                    {
                        <div class="alert alert-warning py-1 px-2 small mb-2">@ierr</div>
                    }
                    <button class="btn btn-sm btn-primary" @onclick="SaveImpact">Save</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _editingImpact = false">Cancel</button>
                }
                else if (Case.AffectedIndividualsCount is null && Case.DataElements.Count == 0 && string.IsNullOrWhiteSpace(Case.AffectedStates))
                {
                    <p class="text-muted small mb-0">Not assessed yet. Record the affected count, data elements and jurisdictions for the Legal and regulatory handoff.</p>
                }
                else
                {
                    <dl class="im-ov-facts mb-0">
                        <div><dt>Affected individuals</dt><dd class="im-ov-big">@(Case.AffectedIndividualsCount?.ToString("N0") ?? "—")</dd></div>
                        <div><dt>Jurisdictions</dt><dd>@(Case.AffectedStates ?? "—")</dd></div>
                        <div><dt>Data elements</dt>
                            <dd>
                                @if (Case.DataElements.Count == 0)
                                {
                                    <text>—</text>
                                }
                                else
                                {
                                    @foreach (var key in SelectedElementKeysOrdered())
                                    {
                                        <span class="im-badge im-b-neutral me-1 mb-1">@DataElementLabel(key)</span>
                                    }
                                }
                            </dd>
                        </div>
                    </dl>
                }
    </section>

        @if (_deadlines is { Enabled: true })
        {
            <section class="im-ov-sec" id="ov-notify" aria-labelledby="ov-notify-h">
                <div class="im-ov-head">
                    <h2 class="im-ov-h" id="ov-notify-h">Notification</h2>
                    @if (_deadlines.Headline is { } hl)
                    {
                        <span class="@Ui.SlaBadge(hl.State)" title="Most urgent jurisdiction">
                            <span class="bi @Ui.SlaGlyph(hl.State)" aria-hidden="true"></span> @Ui.SlaLabel(hl.State)
                        </span>
                    }
                </div>
                <div class="im-sec-body">
                    <WhyThisMatters Class="mb-2">
                        Regulators set short, fixed notice windows. NYDFS Part 500, for example, expects notice within 72 hours of
                        determining a reportable cybersecurity incident. Each jurisdiction's clock comes from the data elements in the
                        impact assessment, so a notice at risk of running late shows here first. CaseBook only tracks the deadline:
                        notifying regulators, and recording it here, is up to your team.
                    </WhyThisMatters>
                    @if (_deadlines.ReportedAtUtc is { } rep)
                    {
                        <p class="small mb-2"><span class="bi bi-check2-circle text-success" aria-hidden="true"></span>
                            Reported to regulators <strong>@TimeDisp.Short(rep)</strong>.</p>
                    }
                    @if (_deadlines.AwaitingTrigger)
                    {
                        <p class="text-muted small mb-0">
                            @(_deadlines.StartBasis == NotificationStartBasis.Determination
                                ? "The countdown starts once the case is determined material. Record that from the Actions menu."
                                : "The countdown starts once this case is classified a Breach.")
                        </p>
                    }
                    else if (_deadlines.StartedButNoJurisdictions)
                    {
                        <p class="text-muted small mb-0">The recorded data elements don't trigger notice in any jurisdiction. If more data was involved, add it to the impact assessment above.</p>
                    }
                    else if (_deadlines.Statuses.Count > 0)
                    {
                        <table class="table table-sm im-table mb-2">
                            <thead><tr><th>Jurisdiction</th><th>Window</th><th>Deadline</th><th>Status</th></tr></thead>
                            <tbody>
                                @foreach (var s in _deadlines.Statuses)
                                {
                                    <tr>
                                        <td>@s.JurisdictionLabel <code class="small text-muted">@s.JurisdictionCode</code></td>
                                        <td class="small text-muted">@s.WindowHours h</td>
                                        <td class="small">@(s.DueAtUtc is { } d ? TimeDisp.Short(d) : "—")
                                            @if (s is { IsActive: true, Remaining: { } rem }) { <span class="text-muted"> (@RemainingLabel(rem))</span> }
                                        </td>
                                        <td><span class="@Ui.SlaBadge(s.State)">@Ui.SlaLabel(s.State)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    @if (CanEdit)
                    {
                        @if (_deadlines.ReportedAtUtc is null && !_deadlines.AwaitingTrigger)
                        {
                            @if (_markingReported)
                            {
                                <div class="d-flex align-items-end gap-2 flex-wrap">
                                    <div>
                                        <label class="form-label small mb-0" for="ov-reported-at">Reported at (@TimeDisp.Label)</label>
                                        <input id="ov-reported-at" type="datetime-local" class="form-control form-control-sm" @bind="_reportedAt"
                                               title="When regulators were notified. Saving this stops the notification countdown." />
                                    </div>
                                    <button class="btn btn-sm btn-primary" @onclick="MarkReported">Save</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _markingReported = false">Cancel</button>
                                </div>
                                @if (_reportedError is not null) { <p class="text-danger small mt-1 mb-0">@_reportedError</p> }
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="BeginMarkReported">
                                    <span class="bi bi-send-check" aria-hidden="true"></span> Mark reported to regulators
                                </button>
                            }
                        }
                        else if (_deadlines.ReportedAtUtc is not null)
                        {
                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="ClearReported">Clear reported milestone</button>
                        }
                    }
                </div>
            </section>
        }


        @if (ReadinessEval is { } rg)
        {
            <section class="im-ov-sec" id="ov-gate" aria-labelledby="ov-gate-h">
                <div class="im-ov-head">
                    <h2 class="im-ov-h" id="ov-gate-h">Next gate: @StageGateTriggers.Label(rg.Trigger)</h2>
                    <div class="d-flex align-items-center gap-2 ms-auto">
                        @if (ReadinessMachineOutstanding == 0)
                        {
                            <span class="im-badge im-b-ok">Data complete</span>
                        }
                        else
                        {
                            <span class="im-badge im-b-warn">@ReadinessMachineOutstanding outstanding</span>
                        }
                        <button class="btn btn-sm btn-link p-0 text-decoration-none" @onclick="() => _showReadiness = !_showReadiness" aria-expanded="@Ui.Aria(_showReadiness)" aria-label="Show what the next gate checks">
                            <span class="bi @(_showReadiness ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></span>
                        </button>
                    </div>
                </div>
                @if (_showReadiness)
                {
                    <p class="text-muted small mb-2">What's needed to <strong>@StageGateTriggers.Label(rg.Trigger).ToLowerInvariant()</strong>. Checked when you make the change. You can override it with a recorded justification.</p>
                    <GateChecklist Eval="rg" Attested="_readinessAttested" Interactive="false" OnFix="@(CanEdit ? EventCallback.Factory.Create<string>(this, FixReadiness) : default)" />
                }
            </section>
        }


    <section class="im-ov-sec" id="ov-details" aria-labelledby="ov-details-h">
        <div class="im-ov-head">
            <h2 class="im-ov-h" id="ov-details-h">Case record</h2>
            <AuthorizeView Policy="@Policies.EditCases" Context="ed">
                @if (!_editingDetails)
                {
                    <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="BeginEditDetails">Edit details</button>
                }
            </AuthorizeView>
        </div>
                @if (_editingDetails)
                {
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-title">Title</label>
                        <input id="ov-title" class="form-control form-control-sm" @bind="_edTitle" @bind:event="oninput" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-detection">@DetectionLabel case ID</label>
                        <input id="ov-detection" class="form-control form-control-sm" @bind="_edDetection" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-data-context">Data context <span class="text-muted">(notes)</span></label>
                        <input id="ov-data-context" class="form-control form-control-sm" @bind="_edDataTypes" />
                        <div class="form-text mt-0">Free-text notes. The impact assessment's data elements are the official list.</div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small mb-0" for="ov-impacted">Impacted assets</label>
                        <input id="ov-impacted" class="form-control form-control-sm" @bind="_edImpacted" />
                    </div>
                    <div class="row g-2 mb-2">
                        <div class="col-sm-6">
                            <label class="form-label small mb-0" for="ov-detected">Detected (@TimeDisp.Label)</label>
                            <input id="ov-detected" type="datetime-local" class="form-control form-control-sm" @bind="_edDetected"
                                   title="When this was first detected or reported, not when the case was opened. Starts the response SLA clock." />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small mb-0" for="ov-occurred">Initial activity <span class="text-muted">(optional)</span></label>
                            <input id="ov-occurred" type="datetime-local" class="form-control form-control-sm" @bind="_edOccurred"
                                   title="When adversary activity began (initial access), if known. Used to calculate dwell time." />
                        </div>
                    </div>
                    @* INV-36: the summary is edited in the brief ("Where it stands"), where each version is kept. *@
                    @if (_detailsError is { } derr)
                    {
                        <div class="alert alert-warning py-1 px-2 small mb-2" role="alert">@derr</div>
                    }
                    <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="SaveDetails" disabled="@(string.IsNullOrWhiteSpace(_edTitle) || _edDetected is null)">Save</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _editingDetails = false)">Cancel</button>
                }
                else
                {
                    <dl class="row mb-0 im-ov-dl">
                        <dt class="col-sm-3">Origin</dt>
                        <dd class="col-sm-9">@(Case.Origin == CaseOrigin.ThirdParty ? "Third-party / vendor" : "Internal detection")</dd>
                        @if (Case.ThirdParty is not null)
                        {
                            <dt class="col-sm-3">Vendor</dt>
                            <dd class="col-sm-9">@Case.ThirdParty.VendorName@(string.IsNullOrWhiteSpace(Case.ThirdParty.VendorContact) ? "" : $" ({Case.ThirdParty.VendorContact})")</dd>
                        }
                        <dt class="col-sm-3">@DetectionLabel case</dt>
                        <dd class="col-sm-9">@(Case.DetectionCaseId ?? "—")
                            @{ var detectionUrl = DetectionCaseUrl(); }
                            @if (detectionUrl is not null)
                            {
                                <a class="btn btn-sm btn-outline-secondary py-0 ms-2" href="@detectionUrl" target="_blank" rel="noopener noreferrer">Open in @DetectionLabel</a>
                            }
                        </dd>
                        <dt class="col-sm-3">Data context</dt>
                        <dd class="col-sm-9">@(Case.DataTypesInvolved ?? "—")</dd>
                        <dt class="col-sm-3">Impacted assets</dt>
                        <dd class="col-sm-9">@(Case.ImpactedAssets ?? "—")</dd>
                        <dt class="col-sm-3">Detected</dt>
                        <dd class="col-sm-9">@TimeDisp.Long(Case.DetectedAtUtc)</dd>
                        @if (Case.OccurredAtUtc is { } began)
                        {
                            <dt class="col-sm-3">Initial activity</dt>
                            <dd class="col-sm-9">@TimeDisp.Long(began)</dd>
                        }
                        <dt class="col-sm-3">Opened</dt>
                        <dd class="col-sm-9">@TimeDisp.Long(Case.CreatedAtUtc) by @Users.DisplayFor(Case.CreatedBy)</dd>
                    </dl>
                }


        <div class="im-ov-record">
            <div class="im-sec">
                <div class="im-sec-head"><h3>Access</h3></div>
            @* S-08: who can see this case, in plain words, with the control to change it beside the explanation. *@
            <div class="im-visibility small mt-2 @(Case.IsRestricted ? "is-restricted" : "")">
                @if (Case.IsRestricted)
                {
                    <span class="bi bi-lock-fill" aria-hidden="true"></span>
                    <span>
                        <strong>Restricted.</strong> @RestrictedAudience
                        @if (CanLiftRestriction)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0 ms-1 align-baseline" @onclick='() => OnOpenModal.InvokeAsync("unrestrict")'>Lift restriction…</button>
                        }
                        else if (CanEdit)
                        {
                            <span class="text-muted">Only the incident commander or a cleared role can lift it.</span>
                        }
                    </span>
                }
                else
                {
                    <span class="bi bi-unlock" aria-hidden="true"></span>
                    <span>
                        Open to everyone with case access.
                        @if (CanEdit)
                        {
                            <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick='() => OnOpenModal.InvokeAsync("restrict")'>Restrict to need-to-know…</button>
                        }
                    </span>
                }
            </div>
            </div>
            <div class="im-sec">
            <div class="im-sec-head"><h3>MITRE ATT&CK</h3></div>
            <div class="im-chips">
                @if (Case.Techniques.Count == 0)
                {
                    <span class="text-muted small">No techniques tagged.</span>
                }
                @foreach (var t in Case.Techniques.OrderBy(x => x.Tactic).ThenBy(x => x.TechniqueId))
                {
                    <span class="im-chip im-chip-tac" style="--tac:@Ui.TacticColor(t.Tactic)" title="@(t.TechniqueId + (string.IsNullOrWhiteSpace(t.Name) ? "" : ": " + t.Name) + " · " + Ui.Label(t.Tactic))">
                        <a href="https://attack.mitre.org/techniques/@(t.TechniqueId.Replace('.', '/'))/" target="_blank" rel="noopener noreferrer"><code>@t.TechniqueId</code></a>
                        @if (t.Tactic != MitreTactic.Unspecified) { <span class="im-chip-role">@Ui.Label(t.Tactic)</span> }
                        <AuthorizeView Policy="@Policies.EditCases" Context="tq">
                            <button type="button" class="im-chip-x" aria-label="Remove @t.TechniqueId"
                                    @onclick='() => Confirm($"Remove technique {t.TechniqueId}?", () => RemoveTechnique(t.Id))'>×</button>
                        </AuthorizeView>
                    </span>
                }
                <AuthorizeView Policy="@Policies.EditCases" Context="tqadd">
                    <button type="button" class="im-chip-add" @onclick="OpenTechMatrix">
                        <span class="bi bi-diagram-3 me-1" aria-hidden="true"></span> @(Case.Techniques.Count == 0 ? "Add techniques…" : "Edit techniques…")
                    </button>
                </AuthorizeView>
            </div>
        </div>
            <div class="im-sec">
            <div class="im-sec-head">
                <h3>Related cases</h3>
                <div class="d-flex align-items-center gap-2">
                    @if (_links.Count > 0) { <span class="im-badge im-b-neutral">@_links.Count</span> }
                    @if (_links.Any(l => l.Type == CaseLinkType.PartOfCampaign))
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="campaigns/@CaseId"
                           title="See all cases in this campaign, with shared indicators and a combined timeline">
                            <span class="bi bi-diagram-3" aria-hidden="true"></span> View campaign
                        </a>
                    }
                    <AuthorizeView Policy="@Policies.EditCases" Context="lk">
                        @if (!_addingLink)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="BeginAddLink">Link a case</button>
                        }
                    </AuthorizeView>
                </div>
            </div>
            @if (_addingLink)
            {
                <div class="mb-2">
                    <label class="form-label small mb-0" for="ov-link-type">Relationship</label>
                    <select id="ov-link-type" class="form-select form-select-sm" @bind="_linkType">
                        @foreach (var t in Enum.GetValues<CaseLinkType>())
                        {
                            <option value="@t">@Ui.CaseLinkLabel(t, true)</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-0" for="ov-link-query">Case</label>
                    @if (_linkTargetId is not null)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <span class="im-badge im-b-info">@_linkTargetLabel</span>
                            <button class="btn btn-sm btn-link p-0" @onclick="ClearLinkTarget">Change</button>
                        </div>
                    }
                    else
                    {
                        <input id="ov-link-query" class="form-control form-control-sm" placeholder="Search by number or title"
                               @bind="_linkQuery" @bind:event="oninput" @bind:after="SearchLinkTargets" />
                        @if (_linkResults.Count > 0)
                        {
                            <div class="list-group mt-1">
                                @foreach (var r in _linkResults)
                                {
                                    <button type="button" class="list-group-item list-group-item-action py-1 small text-start" @onclick="() => SelectLinkTarget(r)">
                                        <strong>@r.CaseNumber</strong> — @r.Title
                                        <span class="@Ui.ClassificationBadge(r.Classification) ms-1">@Ui.Label(r.Classification)</span>
                                    </button>
                                }
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_linkQuery))
                        {
                            <div class="form-text">No matching cases that you have access to.</div>
                        }
                    }
                </div>
                <div class="mb-2">
                    <label class="form-label small mb-0" for="ov-link-note">Note (optional)</label>
                    <input id="ov-link-note" class="form-control form-control-sm" @bind="_linkDesc" placeholder="Why are these related?" />
                </div>
                <button class="btn btn-sm btn-primary" @onclick="AddLink" disabled="@(_linkTargetId is null)">Add link</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelAddLink">Cancel</button>
            }
            @if (_links.Count == 0 && !_addingLink)
            {
                <p class="text-muted small mb-0">No related cases yet. Link duplicates, related cases, or others in the same campaign.</p>
            }
            else if (_links.Count > 0)
            {
                <ul class="list-group list-group-flush">
                    @foreach (var l in _links)
                    {
                        <li class="list-group-item px-0 d-flex justify-content-between align-items-start">
                            <div>
                                <span class="@Ui.CaseLinkBadge(l.Type)">@Ui.CaseLinkLabel(l.Type, l.Outgoing)</span>
                                <a href="cases/@l.OtherCaseId" class="ms-1 fw-semibold text-decoration-none">@l.OtherCaseNumber</a>
                                <div class="small text-muted">@l.OtherTitle</div>
                                @if (!string.IsNullOrWhiteSpace(l.Description)) { <div class="small fst-italic text-muted">@l.Description</div> }
                            </div>
                            <AuthorizeView Policy="@Policies.EditCases" Context="rl">
                                <button class="btn btn-sm btn-outline-danger py-0" title="Remove link"
                                        @onclick='() => Confirm($"Remove the link to {l.OtherCaseNumber}?", () => RemoveLink(l.LinkId))'>×</button>
                            </AuthorizeView>
                        </li>
                    }
                </ul>
            }
        </div>

        </div>
    </section>

        <div class="im-sec">
            <button class="btn btn-sm btn-link p-0 text-decoration-none" @onclick="() => _showHistory = !_showHistory">
                <span class="bi @(_showHistory ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></span>
                Change history (@History().Count())
            </button>
            @if (_showHistory)
            {
                @if (!History().Any())
                {
                    <p class="text-muted small mt-2 mb-0">No changes recorded.</p>
                }
                else
                {
                    <table class="table table-sm mt-2 mb-0">
                        <thead><tr><th>When (@TimeDisp.Label)</th><th>Attribute</th><th>Change</th><th>By</th></tr></thead>
                        <tbody>
                            @foreach (var h in History().OrderByDescending(x => x.At))
                            {
                                <tr>
                                    <td class="small im-data">@TimeDisp.Long(h.At)</td>
                                    <td class="small">@h.Attribute</td>
                                    <td class="small">@h.Change</td>
                                    <td class="small">@Users.DisplayFor(h.By)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
</div>

@* MITRE ATT&CK matrix picker (self-contained overlay) — tag techniques from the tactic grid. *@
@if (_techMatrixOpen)
{
    <AttackMatrixPicker Current="CurrentTechniqueMap()" OnApply="ApplyTechMatrix" OnCancel="CancelTechMatrix" />
}

@code {
    [Parameter, EditorRequired] public Case Case { get; set; } = null!;
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    /// <summary>S-08: whether this user may lift the need-to-know restriction (the IC or a cleared role).</summary>
    [Parameter] public bool CanLiftRestriction { get; set; }
    /// <summary>Retention-guard message set by the parent's legal-hold / archive actions (header, any tab).</summary>
    [Parameter] public string? RetentionMessage { get; set; }
    /// <summary>The next-gate readiness evaluation, computed in the parent's Reload (null when none applies).</summary>
    [Parameter] public GateEvaluation? ReadinessEval { get; set; }
    /// <summary>Reload the case after a write so the rest of the workspace refreshes.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Ask the parent's shared confirm dialog to guard a destructive action.</summary>
    [Parameter] public EventCallback<(string Message, string Verb, Func<Task> OnConfirm)> RequestConfirm { get; set; }
    /// <summary>Open one of the parent's action modals (used for the assign modal).</summary>
    [Parameter] public EventCallback<string> OnOpenModal { get; set; }

    /// <summary>A readiness "Fix" this tab can't satisfy in place (a tab or a dialog); the workspace routes it.</summary>
    [Parameter] public EventCallback<string> OnFix { get; set; }
    /// <summary>INV-29: switch the workspace to another tab (e.g. "Open the timeline").</summary>
    [Parameter] public EventCallback<string> OnGoToTab { get; set; }
    /// <summary>INV-27: show the timeline's changes since a time.</summary>
    [Parameter] public EventCallback<DateTimeOffset> OnShowSince { get; set; }
    /// <summary>Bumped by the parent on a collaborator change, to re-pull related cases.</summary>
    [Parameter] public int RefreshToken { get; set; }

    private CaseBriefCard? _brief;
    private readonly HashSet<string> _mdEditors = new();
    private readonly HashSet<Guid> _readinessAttested = new(); // always empty — the card is read-only
    private int _loadedToken = int.MinValue;

    // Details edit buffer
    private bool _editingDetails;
    private string _edTitle = "";
    private string? _edSummary;
    private string? _edDetection;
    private string? _edDataTypes;
    private string? _edImpacted;
    private DateTime? _edDetected;
    private DateTime? _edOccurred;
    private string? _detailsError;
    private string? _detailsBaseline; // FR-06: field signature captured when the editor opened

    // Structured impact assessment (E-12)
    private bool _editingImpact;
    private int? _impCount;
    private HashSet<string> _impElementKeys = new(StringComparer.Ordinal);
    private string? _impStates;
    private string? _impactError;
    private string? _impactBaseline; // FR-06: field signature captured when the editor opened
    private IReadOnlyList<DataElement> _dataElements = Array.Empty<DataElement>();
    private IReadOnlyDictionary<string, string> _dataElementLabels = new Dictionary<string, string>();

    // Regulatory notification deadlines (PROD-07)
    private CaseNotificationDeadlines? _deadlines;
    private bool _markingReported;
    private DateTime? _reportedAt;
    private string? _reportedError;

    // Related cases (E-14)
    private IReadOnlyList<CaseLinkView> _links = Array.Empty<CaseLinkView>();
    private bool _addingLink;
    private CaseLinkType _linkType = CaseLinkType.RelatedTo;
    private string _linkQuery = "";
    private IReadOnlyList<LinkableCase> _linkResults = Array.Empty<LinkableCase>();
    private Guid? _linkTargetId;
    private string? _linkTargetLabel;
    private string? _linkDesc;

    // Techniques matrix + change-history toggle
    private bool _techMatrixOpen;
    private bool _showHistory;
    private bool _showReadiness;   // INV-29: one collapsed row until asked for

    private string DetectionLabel
    {
        get
        {
            var label = Config["ExternalLinks:DetectionSourceLabel"];
            return string.IsNullOrWhiteSpace(label) ? "SIEM" : label;
        }
    }

    private string? DetectionCaseUrl()
    {
        var template = Config["ExternalLinks:DetectionCaseUrlTemplate"];
        if (string.IsNullOrWhiteSpace(template) || string.IsNullOrWhiteSpace(Case.DetectionCaseId)) return null;
        return string.Format(template, Uri.EscapeDataString(Case.DetectionCaseId));
    }

    private int ReadinessMachineOutstanding => ReadinessEval?.Requirements
        .Count(r => r.Kind == GateRequirementKind.MachineCheck && r.IsBlocking && !r.MachineSatisfied) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        // X-03: the data-element reference set — active options for editing, plus a key→label map (incl.
        // inactive) so already-recorded elements always render with their current label.
        _dataElements = await Cases.ListActiveDataElementsAsync();
        _dataElementLabels = await Cases.DataElementLabelsAsync();
        // S-08: the roles that see every restricted case, for the visibility line.
        _clearanceRoles = await Cases.GetRestrictedClearanceRolesAsync();
    }

    private IReadOnlyList<string> _clearanceRoles = [];

    private string RestrictedAudience
    {
        get
        {
            var who = (Case.Assignments.Count > 0 || Case.IncidentCommander is not null, _clearanceRoles.Count > 0) switch
            {
                (true, true) => $"Only the people above and anyone with {Ui.RolePhrase(_clearanceRoles)}",
                (true, false) => "Only the people above",
                (false, true) => $"No one is assigned, so only people with {Ui.RolePhrase(_clearanceRoles)}",
                _ => "No one is assigned, so no one"
            };
            return who + " can open this case or see it in lists, search, dashboards and exports.";
        }
    }

    // --- Regulatory notification deadlines (PROD-07) ---
    private void BeginMarkReported()
    {
        _reportedError = null;
        // FR-09: seed + accept the reported time as wall-clock in the viewer's display zone (like Detected /
        // Initial-activity), not raw UTC — so an analyst who types local everywhere can't mis-stop the
        // highest-stakes regulatory clock by their zone offset. WallToUtc converts on save.
        _reportedAt = UtcToWall(Clock.UtcNow);
        _markingReported = true;
    }

    private async Task MarkReported()
    {
        _reportedError = null;
        if (_reportedAt is not { } dt) { _reportedError = "Enter the reported time."; return; }
        try
        {
            var utc = WallToUtc(dt); // FR-09: wall-clock (display zone) → UTC, matching every other datetime field
            await Cases.MarkReportedAsync(CaseId, utc);
            _markingReported = false;
            _deadlines = await Deadlines.EvaluateAsync(CaseId);
            await OnChanged.InvokeAsync();
            Toasts.Success("Reported milestone recorded");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            _reportedError = ex.Message;
        }
    }

    private async Task ClearReported() =>
        await RequestConfirm.InvokeAsync(("Clear the reported milestone? The notification countdown will resume.", "Clear",
            async () =>
            {
                await Cases.ClearReportedAsync(CaseId);
                _deadlines = await Deadlines.EvaluateAsync(CaseId);
                await OnChanged.InvokeAsync();
                Toasts.Success("Reported milestone cleared");
            }));

    private static string RemainingLabel(TimeSpan rem)
    {
        if (rem < TimeSpan.Zero)
        {
            var over = -rem;
            return over.TotalDays >= 1 ? $"overdue {(int)over.TotalDays}d" : $"overdue {Math.Max(1, (int)over.TotalHours)}h";
        }
        return rem.TotalDays >= 1 ? $"in {(int)rem.TotalDays}d" : $"in {Math.Max(1, (int)rem.TotalHours)}h";
    }

    protected override async Task OnParametersSetAsync()
    {
        // Load related cases on first mount and whenever the parent signals a live change.
        if (_loadedToken != RefreshToken)
        {
            _loadedToken = RefreshToken;
            await LoadLinks();
        }
        // Re-evaluate the notification deadlines whenever the parent passes an updated case (e.g. after a
        // materiality determination or reported milestone recorded from the header Actions), so the card and
        // the header badge stay in sync (PROD-07).
        _deadlines = await Deadlines.EvaluateAsync(CaseId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ReconcileEditor();
        if (_scrollTo is { } id)
        {
            _scrollTo = null;
            try { await JS.InvokeVoidAsync("imMotion.scrollToId", id); } catch (JSException) { /* ignore */ }
        }
    }

    // Stage readiness "Fix": open the editor that satisfies an unmet check, or hand off to the workspace for a
    // tab or a dialog.
    private string? _scrollTo;
    public async Task FixReadiness(string checkKey)
    {
        switch (checkKey)
        {
            case GateCheckKeys.SummaryPresent:
                // INV-36: the summary is the brief's first part.
                _brief?.BeginEdit();
                _scrollTo = "ov-brief";
                break;
            case GateCheckKeys.DetectionCaseIdSet:
                if (!_editingDetails) BeginEditDetails();
                _scrollTo = "ov-details";
                break;
            case GateCheckKeys.AffectedIndividualsCountSet or GateCheckKeys.MinAffectedIndividuals
                or GateCheckKeys.DataElementsSet or GateCheckKeys.AffectedStatesSet:
                if (!_editingImpact) BeginEditImpact();
                _scrollTo = "ov-impact";
                break;
            default:
                await OnFix.InvokeAsync(checkKey);
                return;
        }
        StateHasChanged();
    }

    // INV-36: the Summary composer moved to the brief, so no EasyMDE editor is wanted here any more; this still
    // tears down one left mounted.
    private async Task ReconcileEditor()
    {
        var desired = new Dictionary<string, string>();

        foreach (var id in _mdEditors.Where(id => !desired.ContainsKey(id)).ToList())
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); } catch (JSException) { /* ignore */ }
            _mdEditors.Remove(id);
        }
        foreach (var (id, seed) in desired)
        {
            if (_mdEditors.Contains(id)) continue;
            try { await JS.InvokeVoidAsync("markdownEditor.init", id, seed); _mdEditors.Add(id); }
            catch (JSException) { /* editor is a progressive enhancement */ }
        }
    }

    /// <summary>Ctrl/⌘+Enter from the parent's hotkey dispatcher — save the details edit if open.</summary>
    public async Task SubmitAsync()
    {
        if (CanEdit && _editingDetails) await SaveDetails();
    }

    private Task Confirm(string message, Func<Task> action, string verb = "Remove") => RequestConfirm.InvokeAsync((message, verb, action));

    // INV-29: the last few decisions, handoffs and response milestones, newest first — a read-time view of the
    // timeline, so "what just happened" is answered without switching tabs.
    private sealed record RecentItem(DateTimeOffset At, string Icon, string Kind, string Text);

    private static readonly HashSet<MilestoneKind> RecentMilestones =
    [
        MilestoneKind.Classification, MilestoneKind.Severity, MilestoneKind.Phase, MilestoneKind.Materiality,
        MilestoneKind.Gate, MilestoneKind.Reported, MilestoneKind.TaskDone, MilestoneKind.Command
    ];

    private List<RecentItem> RecentOnTimeline()
    {
        var labels = new MilestoneLabels(c => Ui.Label(c), s => SevLabels.For(s), p => Ui.Label(p), m => Ui.Label(m));
        var milestones = CaseMilestones.Project(Case, labels)
            .Where(m => RecentMilestones.Contains(m.Kind))
            .Select(m => new RecentItem(m.AtUtc, m.Flagged ? "bi-flag-fill im-ov-flag" : "bi-flag", "Milestone",
                m.Detail is { } detail ? $"{m.Title}: {OneLine(detail)}" : m.Title));
        var entries = Case.TimelineEntries
            .Where(e => e.IsCurrent && e.Type is TimelineEntryType.Decision or TimelineEntryType.Handoff)
            .Select(e => e.Type == TimelineEntryType.Decision
                ? new RecentItem(e.OccurredAtUtc, "bi-diamond-fill im-ov-dec", "Decision", OneLine(e.Description))
                : new RecentItem(e.OccurredAtUtc, "bi-arrow-left-right", "Handoff", OneLine(e.Description)));
        return milestones.Concat(entries).OrderByDescending(r => r.At).Take(5).ToList();
    }

    private string OneLine(string markdown)
    {
        var text = Md.ToPlainText(markdown).Replace('\n', ' ').Trim();
        return text.Length <= 160 ? text : text[..157] + "…";
    }

    // --- Details ---
    private void BeginEditDetails()
    {
        _edTitle = Case.Title;
        _edSummary = Case.Summary;
        _edDetection = Case.DetectionCaseId;
        _edDataTypes = Case.DataTypesInvolved;
        _edImpacted = Case.ImpactedAssets;
        _edDetected = Case.DetectedAtUtc is { } d ? UtcToWall(d) : null;
        _edOccurred = Case.OccurredAtUtc is { } o ? UtcToWall(o) : null;
        _detailsError = null;
        _detailsBaseline = Case.DetailsConcurrencyStamp(); // FR-06: baseline for the optimistic-concurrency check
        _editingDetails = true;
    }

    private async Task SaveDetails()
    {
        if (string.IsNullOrWhiteSpace(_edTitle) || _edDetected is null) return;
        // INV-36: the summary isn't edited here; send the one on record so this save never changes it. If it
        // changed since the editor opened, the concurrency stamp refuses the save instead of reverting it.
        _edSummary = Case.Summary;
        try
        {
            await Cases.UpdateDetailsAsync(CaseId, _edTitle, _edSummary, _edDetection, _edDataTypes, _edImpacted,
                WallToUtc(_edDetected.Value), _edOccurred is { } occ ? WallToUtc(occ) : null, _detailsBaseline);
        }
        catch (StaleEditException ex) // FR-06: another author changed these fields while we were editing
        {
            _detailsBaseline = ex.CurrentStamp; // re-baseline so a deliberate re-Save overwrites
            _detailsError = "Someone else saved changes to these details while you were editing, so yours weren't saved. Review the current values, then Save again to overwrite them, or Cancel to discard yours.";
            await OnChanged.InvokeAsync(); // refresh the rest of the workspace to the newer values
            return;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) // domain validation (future detection / activity after detection), permission
        {
            _detailsError = ex.Message;
            return;
        }
        _editingDetails = false;
        _detailsError = null;
        await OnChanged.InvokeAsync();
        Toasts.Success("Details saved");
    }

    // --- Wall-clock ⇄ UTC in the viewer's active display zone (U-29) ---
    private DateTimeOffset WallToUtc(DateTime wall)
    {
        var unspecified = DateTime.SpecifyKind(wall, DateTimeKind.Unspecified);
        try { return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(unspecified, TimeDisp.Zone), TimeSpan.Zero); }
        catch { return new DateTimeOffset(DateTime.SpecifyKind(unspecified, DateTimeKind.Utc), TimeSpan.Zero); } // DST-invalid wall time: treat as UTC
    }

    private DateTime UtcToWall(DateTimeOffset utc)
        => DateTime.SpecifyKind(TimeZoneInfo.ConvertTime(utc, TimeDisp.Zone).DateTime, DateTimeKind.Unspecified);

    // --- Structured impact assessment (E-12) ---
    private string DataElementLabel(string key) =>
        _dataElementLabels.TryGetValue(key, out var label) ? label : key;

    private IEnumerable<string> SelectedElementKeysOrdered()
    {
        var keys = Case.DataElements.Select(d => d.ElementKey).ToHashSet(StringComparer.Ordinal);
        var ordered = _dataElements.Where(e => keys.Contains(e.Key)).Select(e => e.Key).ToList();
        ordered.AddRange(keys.Where(k => ordered.All(o => o != k)).OrderBy(k => k, StringComparer.Ordinal));
        return ordered;
    }

    private void BeginEditImpact()
    {
        _impCount = Case.AffectedIndividualsCount;
        _impElementKeys = Case.DataElements.Select(d => d.ElementKey).ToHashSet(StringComparer.Ordinal);
        // Pre-fill the org's default jurisdictions on a case that has none yet (X-01); analyst can edit.
        _impStates = string.IsNullOrWhiteSpace(Case.AffectedStates)
            ? (Config["Organization:DefaultJurisdictions"] is { Length: > 0 } d ? d : null)
            : Case.AffectedStates;
        _impactError = null;
        _impactBaseline = Case.ImpactConcurrencyStamp(); // FR-06: baseline for the optimistic-concurrency check
        _editingImpact = true;
    }

    private void ToggleElement(string key, bool on)
    {
        if (on) _impElementKeys.Add(key); else _impElementKeys.Remove(key);
    }

    private async Task SaveImpact()
    {
        try
        {
            await Cases.UpdateImpactAssessmentAsync(CaseId, _impCount, _impElementKeys, _impStates, _impactBaseline);
        }
        catch (StaleEditException ex) // FR-06: another author changed the impact assessment while we were editing
        {
            _impactBaseline = ex.CurrentStamp;
            _impactError = "Someone else saved the impact assessment while you were editing, so your entries weren't saved. Review the current values, then Save again to overwrite them, or Cancel to discard yours.";
            await OnChanged.InvokeAsync();
            return;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            _impactError = ex.Message;
            return;
        }
        _editingImpact = false;
        _impactError = null;
        await OnChanged.InvokeAsync();
        Toasts.Success("Impact assessment saved");
    }

    // --- Change history ---
    private sealed record HistoryRow(DateTimeOffset At, string Attribute, string Change, string? Reason, string By);

    private IEnumerable<HistoryRow> History()
    {
        foreach (var x in Case.ClassificationChanges)
            yield return new HistoryRow(x.EffectiveAt, "Classification",
                $"{(x.From is { } f ? Ui.Label(f) : "—")} → {Ui.Label(x.To)}", x.Reason, x.ChangedBy);

        foreach (var x in Case.SeverityChanges)
            yield return new HistoryRow(x.EffectiveAt, "Severity",
                $"{(x.From is { } sf ? SevLabels.For(sf) : "—")} → {SevLabels.For(x.To)}", x.Reason, x.ChangedBy);

        foreach (var x in Case.StatusChanges)
            yield return new HistoryRow(x.EffectiveAt, "Phase",
                $"{(x.From is { } f ? Ui.Label(f) : "—")} → {Ui.Label(x.To)}", x.Reason, x.ChangedBy);

        // Materiality is a significant, decision-maker-attributed case-level transition and belongs in the
        // curated progression alongside classification/severity/phase. The rationale is the "reason"; the
        // off-app decision-maker (when recorded) is appended so the curated view names who made the call.
        foreach (var x in Case.MaterialityChanges)
            yield return new HistoryRow(x.ChangedAtUtc, "Materiality",
                $"{Ui.Label(x.From)} → {Ui.Label(x.To)}"
                    + (string.IsNullOrWhiteSpace(x.DecisionMaker) ? "" : $" (by {x.DecisionMaker})"),
                x.Rationale, x.ChangedBy);
    }

    // --- Assignments / techniques ---
    private async Task RemoveTechnique(Guid techniqueId)
    {
        await Cases.RemoveTechniqueAsync(CaseId, techniqueId);
        await OnChanged.InvokeAsync();
        Toasts.Success("Technique removed");
    }

    private void OpenTechMatrix() => _techMatrixOpen = true;
    private void CancelTechMatrix() => _techMatrixOpen = false;

    // The case's current technique tags as id → tactic, seeding the matrix's selection state.
    private IReadOnlyDictionary<string, MitreTactic> CurrentTechniqueMap() =>
        Case.Techniques.ToDictionary(t => t.TechniqueId, t => t.Tactic, StringComparer.OrdinalIgnoreCase);

    // Sync the case's techniques to the matrix's chosen set: remove dropped tags, add new ones, and
    // re-tag any whose tactic (column) changed. AddTechniqueAsync upserts, so a tactic change is a re-add.
    private async Task ApplyTechMatrix(IReadOnlyDictionary<string, MitreTactic> desired)
    {
        _techMatrixOpen = false;
        var current = Case.Techniques.ToList();

        try
        {
            foreach (var t in current.Where(t => !desired.ContainsKey(t.TechniqueId)))
                await Cases.RemoveTechniqueAsync(CaseId, t.Id);

            foreach (var kv in desired)
            {
                var existing = current.FirstOrDefault(t => string.Equals(t.TechniqueId, kv.Key, StringComparison.OrdinalIgnoreCase));
                if (existing is null)
                    await Cases.AddTechniqueAsync(CaseId, kv.Key, AttackCatalog.Find(kv.Key)?.Name ?? "", kv.Value);
                else if (existing.Tactic != kv.Value)
                    await Cases.AddTechniqueAsync(CaseId, kv.Key, existing.Name, kv.Value);
            }
            Toasts.Success("Techniques updated");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
        await OnChanged.InvokeAsync(); // reload either way, so a partial update shows what was saved
    }

    // --- Related cases (E-14) ---
    private async Task LoadLinks() => _links = await Cases.GetCaseLinksAsync(CaseId);

    private void BeginAddLink()
    {
        _addingLink = true;
        _linkType = CaseLinkType.RelatedTo;
        ClearLinkTarget();
        _linkDesc = null;
    }

    private void CancelAddLink()
    {
        _addingLink = false;
        ClearLinkTarget();
    }

    private void ClearLinkTarget()
    {
        _linkTargetId = null;
        _linkTargetLabel = null;
        _linkQuery = "";
        _linkResults = Array.Empty<LinkableCase>();
    }

    private async Task SearchLinkTargets()
    {
        _linkResults = string.IsNullOrWhiteSpace(_linkQuery)
            ? Array.Empty<LinkableCase>()
            : await Cases.SearchLinkableCasesAsync(CaseId, _linkQuery);
    }

    private void SelectLinkTarget(LinkableCase c)
    {
        _linkTargetId = c.Id;
        _linkTargetLabel = $"{c.CaseNumber} — {c.Title}";
        _linkResults = Array.Empty<LinkableCase>();
    }

    private async Task AddLink()
    {
        if (_linkTargetId is not { } target) return;
        try
        {
            var created = await Cases.LinkCaseAsync(CaseId, target, _linkType, _linkDesc);
            if (created is null) { Toasts.Warning("Those cases are already linked."); }
            else { Toasts.Success("Case linked."); }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Warning(ex.Message);
            return; // keep the picker and description so the user can adjust and retry
        }
        _addingLink = false;
        ClearLinkTarget();
        _linkDesc = null;
        await LoadLinks();
    }

    private async Task RemoveLink(Guid linkId)
    {
        await Cases.RemoveCaseLinkAsync(CaseId, linkId);
        Toasts.Success("Link removed.");
        await LoadLinks();
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var id in _mdEditors)
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); }
            catch { /* circuit may already be gone during teardown */ }
        }
        _mdEditors.Clear();
    }
}
