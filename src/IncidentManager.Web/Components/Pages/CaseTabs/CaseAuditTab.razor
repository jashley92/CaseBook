@* Case workspace — Audit tab (UX-13, extracted from CaseWorkspace.razor). The tamper-evident audit
   trail for one case, with server-side filtering (E-24) and, for leads/admins, the "Viewed by" read-log
   (C-05). Self-contained: it loads its own data; the parent passes the case identity, the lead flag, a
   persisted filter object, and a RefreshToken it bumps when a collaborator changes the case. *@
@inject IntegrityService Integrity
@inject IncidentManager.Application.Access.IAccessLogService AccessLog
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject CaseService Cases
@inject TimeDisplay TimeDisp

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
    <p class="text-muted mb-0">Tamper-evident audit trail for this case (most recent first).</p>
    <a class="btn btn-sm btn-outline-secondary" href="@AuditExportHref()">
        <span class="bi bi-download me-1" aria-hidden="true"></span>Export CSV
    </a>
</div>

@* E-24: filter the hash-chained trail by actor / action / entity / date range (server-side). *@
<div class="row g-2 align-items-end mb-3">
    <div class="col-6 col-md-3">
        <label class="form-label small mb-0" for="audit-actor">Actor</label>
        <select id="audit-actor" class="form-select form-select-sm" @bind="State.Actor" @bind:after="ApplyAuditFilter">
            <option value="">Any</option>
            @foreach (var actor in State.Actors)
            {
                <option value="@actor">@Users.DisplayFor(actor)</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-3">
        <label class="form-label small mb-0" for="audit-action">Action</label>
        <select id="audit-action" class="form-select form-select-sm" @bind="State.Action" @bind:after="ApplyAuditFilter">
            <option value="">Any</option>
            @foreach (var act in Enum.GetValues<AuditAction>())
            {
                <option value="@act">@AuditLabels.Label(act)</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="audit-entity">Entity</label>
        <select id="audit-entity" class="form-select form-select-sm" @bind="State.Entity" @bind:after="ApplyAuditFilter">
            <option value="">Any</option>
            @foreach (var et in State.EntityTypes)
            {
                <option value="@et">@AuditLabels.Entity(et)</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="audit-from">From (UTC)</label>
        <input id="audit-from" type="date" class="form-control form-control-sm" @bind="State.From" @bind:after="ApplyAuditFilter" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="audit-to">To (UTC)</label>
        <input id="audit-to" type="date" class="form-control form-control-sm" @bind="State.To" @bind:after="ApplyAuditFilter" />
    </div>
</div>

@if (_audit is null)
{
    <p><em>Loading&hellip;</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="small text-muted">@_audit.Count entr@(_audit.Count == 1 ? "y" : "ies")@(AuditFiltered ? " (filtered)" : "")@(_audit.Count >= AuditPageSize ? $". Showing the most recent {AuditPageSize}." : "")</span>
        @if (AuditFiltered)
        {
            <button class="btn btn-sm btn-link p-0" @onclick="ClearAuditFilter">Clear filters</button>
        }
    </div>
    @if (_audit.Count == 0)
    {
        <p class="text-muted">No audit entries match the current filters.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead><tr><th>#</th><th>When (UTC)</th><th>Actor</th><th>Action</th><th>Entity</th><th>What changed</th><th>Reason</th></tr></thead>
            <tbody>
                @foreach (var a in _audit)
                {
                    var hasRaw = !string.IsNullOrWhiteSpace(a.BeforeJson) || !string.IsNullOrWhiteSpace(a.AfterJson);
                    var open = _expandedRows.Contains(a.Sequence);
                    <tr @key="a.Sequence">
                        <td class="text-nowrap">
                            @if (hasRaw)
                            {
                                <button type="button" class="btn btn-sm btn-link p-0 me-1 align-baseline"
                                        @onclick="() => ToggleRaw(a.Sequence)" aria-expanded="@open"
                                        title="@(open ? "Hide raw change data" : "Show raw change data")"
                                        aria-label="@(open ? $"Hide raw change data for entry {a.Sequence}" : $"Show raw change data for entry {a.Sequence}")">
                                    <span class="bi @(open ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></span>
                                </button>
                            }
                            @a.Sequence
                        </td>
                        <td class="small">@a.AtUtc.ToString("u")</td>
                        <td>@Users.DisplayFor(a.Actor)</td>
                        <td>@AuditLabels.Label(a.Action)</td>
                        <td>
                            @AuditLabels.Entity(a.EntityType)
                            @if (!string.IsNullOrWhiteSpace(a.EntityLabel))
                            {
                                <div class="small text-muted" title="@a.EntityLabel">@Trunc(a.EntityLabel!, 40)</div>
                            }
                        </td>
                        <td class="small">@ChangeCell(a)</td>
                        <td class="small">@(string.IsNullOrWhiteSpace(a.Reason) ? "" : a.Reason)</td>
                    </tr>
                    @if (open)
                    {
                        <tr @key="@($"raw-{a.Sequence}")" class="im-audit-raw">
                            <td colspan="7" class="bg-body-tertiary">
                                <div class="d-flex flex-wrap gap-3 py-1">
                                    @if (!string.IsNullOrWhiteSpace(a.BeforeJson))
                                    {
                                        <div style="flex:1 1 20rem;min-width:0">
                                            <div class="small text-muted mb-1"><span class="bi bi-box-arrow-in-left me-1" aria-hidden="true"></span>Before</div>
                                            <pre class="mb-0 p-2 border rounded bg-body" style="white-space:pre-wrap;word-break:break-word;font-size:.78rem;max-height:18rem;overflow:auto">@PrettyJson(a.BeforeJson)</pre>
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.AfterJson))
                                    {
                                        <div style="flex:1 1 20rem;min-width:0">
                                            <div class="small text-muted mb-1"><span class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></span>After</div>
                                            <pre class="mb-0 p-2 border rounded bg-body" style="white-space:pre-wrap;word-break:break-word;font-size:.78rem;max-height:18rem;overflow:auto">@PrettyJson(a.AfterJson)</pre>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
}

<AuthorizeView Policy="@Policies.ViewAllCases">
    @* C-05: "Viewed by" — coalesced read-sessions, shown only to leads/admins (surveillance data). *@
    <div class="mt-4">
        <h2 class="h6 d-flex align-items-center gap-2">
            <span class="bi bi-eye" aria-hidden="true"></span> Viewed by
            <span class="im-badge im-b-neutral rounded-pill">@(_viewedBy?.Count ?? 0)</span>
        </h2>
        <p class="small text-muted mb-2">
            Who has opened this case, grouped into sessions. Access logs aren't part of the tamper-evident
            trail. Configure them in Administration → Governance &amp; security → Access logging.
        </p>
        @if (_viewedBy is null)
        {
            <p class="small text-muted"><em>Loading&hellip;</em></p>
        }
        else if (_viewedBy.Count == 0)
        {
            <p class="small text-muted">No views recorded yet, or access logging is off.</p>
        }
        else
        {
            <table class="table table-sm align-middle">
                <thead><tr><th>Viewer</th><th class="text-end">Opens</th><th>First seen</th><th>Last seen</th></tr></thead>
                <tbody>
                    @foreach (var v in _viewedBy)
                    {
                        <tr>
                            <td>@Users.DisplayFor(v.ActorUserId)@if (v.WasRestricted) { <span class="im-badge im-b-warn ms-2">restricted</span> }</td>
                            <td class="text-end">@v.Count</td>
                            <td class="small">@TimeDisp.Short(v.FirstSeenUtc)</td>
                            <td class="small">@TimeDisp.Short(v.LastSeenUtc)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</AuthorizeView>

@code {
    [Parameter, EditorRequired] public string CaseNumber { get; set; } = "";
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    [Parameter] public bool CanViewAll { get; set; }
    /// <summary>Filter selections + facet cache, held by the parent so they survive this tab's re-mount.</summary>
    [Parameter, EditorRequired] public CaseAuditFilter State { get; set; } = new();
    /// <summary>The parent bumps this when a collaborator changes the case, to re-query the trail live.</summary>
    [Parameter] public int RefreshToken { get; set; }

    private const int AuditPageSize = 500;
    private List<AuditLogEntry>? _audit;
    // Case entity id -> display label, so the diff can resolve a reference field (a timeline entry's
    // Actor/Target) from an opaque GUID to a human name. Loaded with the trail.
    private IReadOnlyDictionary<Guid, string> _entityLabels = new Dictionary<Guid, string>();
    private IReadOnlyList<CaseAccessEvent>? _viewedBy;
    private int _loadedToken = int.MinValue;
    // Sequences whose raw before/after JSON is expanded in the GUI (per-viewer, reset on each (re)load).
    private readonly HashSet<long> _expandedRows = new();

    private bool AuditFiltered => !BuildAuditFilter().IsEmpty;

    protected override async Task OnParametersSetAsync()
    {
        // Load on first mount and whenever the parent signals a live change; an unrelated parent re-render
        // (same token) leaves the current, possibly-filtered, view untouched.
        if (_loadedToken != RefreshToken)
        {
            _loadedToken = RefreshToken;
            await LoadAudit();
        }
    }

    private async Task LoadAudit()
    {
        _expandedRows.Clear(); // a fresh result set — collapse any open raw panels
        if (!State.FacetsLoaded)
        {
            (State.Actors, State.EntityTypes) = await Integrity.AuditFacetsAsync(CaseNumber);
            State.FacetsLoaded = true;
        }
        _audit = await Integrity.QueryAsync(BuildAuditFilter(), AuditPageSize);
        _entityLabels = await Cases.GetEntityLabelsAsync(CaseId); // resolve reference GUIDs in the diff to IOC labels
        // C-05: leads/admins see who has read this case (coalesced view-sessions).
        if (CanViewAll)
            _viewedBy = await AccessLog.ForCaseAsync(CaseId);
    }

    // E-24: build the server-side filter from the tab's controls. "To" is inclusive to the end of the day.
    private AuditQueryFilter BuildAuditFilter() => new()
    {
        CaseNumber = CaseNumber,
        Actor = string.IsNullOrWhiteSpace(State.Actor) ? null : State.Actor,
        Action = Enum.TryParse<AuditAction>(State.Action, out var a) ? a : null,
        EntityType = string.IsNullOrWhiteSpace(State.Entity) ? null : State.Entity,
        FromUtc = State.From is { } f ? new DateTimeOffset(f.Date, TimeSpan.Zero) : null,
        ToUtc = State.To is { } t ? new DateTimeOffset(t.Date.AddDays(1).AddTicks(-1), TimeSpan.Zero) : null
    };

    private async Task ApplyAuditFilter() => await LoadAudit();

    private async Task ClearAuditFilter()
    {
        State.Actor = State.Action = State.Entity = "";
        State.From = State.To = null;
        await LoadAudit();
    }

    // Deep-link to the scoped CSV export mirroring the active filter (dates as yyyy-MM-dd, UTC).
    private string AuditExportHref()
    {
        var f = BuildAuditFilter();
        var qs = new List<string> { $"case={Uri.EscapeDataString(CaseNumber)}" };
        if (f.Actor is { } actor) qs.Add($"actor={Uri.EscapeDataString(actor)}");
        if (f.Action is { } act) qs.Add($"action={act}");
        if (f.EntityType is { } et) qs.Add($"entity={Uri.EscapeDataString(et)}");
        if (State.From is { } from) qs.Add($"from={from:yyyy-MM-dd}");
        if (State.To is { } to) qs.Add($"to={to:yyyy-MM-dd}");
        return "export/case-audit.csv?" + string.Join("&", qs);
    }

    // The "what changed" cell: the field-level before/after diff parsed from the entry's captured snapshots
    // (the detail was always recorded — this surfaces it). Long values are truncated with the full text on
    // hover. Create/delete have no diff, so they read as a short verb.
    // Resolve a stored reference value for the diff renderer: an entity GUID → its IOC label, or a directory
    // user id (an owner / incident commander) → that person's display name. Returns null for anything else,
    // so the raw value stands.
    private string? ResolveRef(string value)
    {
        if (Guid.TryParse(value, out var g) && _entityLabels.TryGetValue(g, out var label)) return label;
        return Users.Resolve(value) is { } u ? u.DisplayName : null;
    }

    private RenderFragment ChangeCell(AuditLogEntry a) => __builder =>
    {
        var changes = AuditChangeDetail.Changes(a, ResolveRef);
        if (changes.Count == 0)
        {
            var verb = a.Action switch
            {
                AuditAction.Create => "created",
                AuditAction.SoftDelete => "removed",
                _ => "—"
            };
            <span class="text-muted">@verb</span>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (var ch in changes)
                {
                    <li>
                        <span class="fw-medium">@ch.Label:</span>
                        <span class="text-muted" title="@ch.Before">@Trunc(ch.Before)</span>
                        <span class="bi bi-arrow-right mx-1" aria-hidden="true"></span>
                        <span title="@ch.After">@Trunc(ch.After)</span>
                    </li>
                }
            </ul>
        }
    };

    private static string Trunc(string value, int max = 48) =>
        value.Length <= max ? value : value[..(max - 1)] + "…";

    // Expand / collapse the raw before/after JSON for one entry (see exactly what changed at the data level).
    private void ToggleRaw(long sequence)
    {
        if (!_expandedRows.Add(sequence)) _expandedRows.Remove(sequence);
    }

    // Re-indent the stored (compact) snapshot JSON for display; fall back to the raw text if it won't parse.
    private static string PrettyJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            // Relaxed escaping is for display only (Blazor HTML-encodes the text on render), so timestamps
            // and punctuation read as "+00:00" rather than "+00:00".
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement,
                new System.Text.Json.JsonSerializerOptions
                {
                    WriteIndented = true,
                    Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
                });
        }
        catch (System.Text.Json.JsonException)
        {
            return json;
        }
    }
}
