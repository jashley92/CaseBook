    /// <summary>ATT&CK technique ID → URL path segment (sub-techniques nest, e.g. T1078.001 → T1078/001).</summary>
    private static string TechniquePath(string techniqueId) => techniqueId.Replace('.', '/');

    // FR-02: in add mode, capture the Investigation composer's unsubmitted text into the parent-owned store
    // before teardown, so a tab switch preserves it. An in-progress edit (_tlEditId set) is intentionally not
    // stashed — it would otherwise resurface as a new add entry after the tab remounts in add mode.
    private async Task StashDraft()
    {
        // BUG-329: a tab that never had the add editor hasn't shown the stash, so it leaves it alone.
        if (ComposerDrafts is null || !_stashTaken) return;
        // BUG-397: while an edit is open, the add text is the draft BUG-35 kept aside; that, not the edit, is stashed.
        if (_tlEditId is not null)
        {
            KeepStash(_draft?.Desc);
            return;
        }
        // BUG-329: with no editor mounted (an event step or a question showing), its getValue is "" and used to drop the
        // stash. The add text is then _tlDesc, read back when the editor went.
        if (!_mdEditors.Contains(InvEditorId))
        {
            KeepStash(_tlDesc);
            return;
        }
        try { KeepStash(await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId)); }
        catch { /* circuit tearing down — nothing to stash */ }
    }

    /// <summary>BUG-425: removed from the page (a tab switch, the phone's Now/Next view, the error fallback); the
    /// workspace's @ref still points here, so its Ctrl/Cmd+Enter checks this first (CaseWorkspace.Keyboard).</summary>
    internal bool Disposed { get; private set; }

    public async ValueTask DisposeAsync()
    {
        Disposed = true;
        Edits.Forget(this);
        try { await JS.InvokeVoidAsync("imMotion.unwatchTimelineToolbar"); } catch { /* circuit may already be gone */ }
        _mentionLoad.Invalidate();
        await StashDraft();
        foreach (var id in _mdEditors)
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); }
            catch { /* circuit may already be gone during teardown */ }
        }
        _mdEditors.Clear();
    }
