            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _tlWhen = _tlWhen.AddHours(-1)" aria-label="One hour earlier">&minus;1 h</button>
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _tlWhen = _tlWhen.AddMinutes(-15)" aria-label="15 minutes earlier">&minus;15 min</button>
