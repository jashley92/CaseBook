    private static string TechniquePath(string techniqueId) => techniqueId.Replace('.', '/');

    // --- Wall-clock ⇄ UTC in the viewer's active display zone (U-29/U-46) ---
    private DateTimeOffset WallToUtc(DateTime wall)
    {
        var unspecified = DateTime.SpecifyKind(wall, DateTimeKind.Unspecified);
        try { return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(unspecified, TimeDisp.Zone), TimeSpan.Zero); }
        catch { return new DateTimeOffset(DateTime.SpecifyKind(unspecified, DateTimeKind.Utc), TimeSpan.Zero); } // DST-invalid wall time: treat as UTC
    }

    private DateTime UtcToWall(DateTimeOffset utc)
        => DateTime.SpecifyKind(TimeZoneInfo.ConvertTime(utc, TimeDisp.Zone).DateTime, DateTimeKind.Unspecified);

    // FR-02: in add mode, capture the Investigation composer's unsubmitted text into the parent-owned store
    // before teardown, so a tab switch preserves it. An in-progress edit (_tlEditId set) is intentionally not
    // stashed — it would otherwise resurface as a new add entry after the tab remounts in add mode.
    private async Task StashDraft()
    {
        if (ComposerDrafts is null || _tlEditId is not null) return;
        try
        {
            var val = await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId);
            if (!string.IsNullOrWhiteSpace(val)) ComposerDrafts[InvEditorId] = val;
            else ComposerDrafts.Remove(InvEditorId);
        }
        catch { /* editor not mounted or circuit tearing down — nothing to stash */ }
    }

    public async ValueTask DisposeAsync()
    {
        await StashDraft();
        foreach (var id in _mdEditors)
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); }
            catch { /* circuit may already be gone during teardown */ }
        }
        _mdEditors.Clear();
    }
