                    </select>
                    <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => _fuLink = null">Change</button>
                }
                else
                {
                    <input class="form-control form-control-sm im-then-wide" placeholder="Case number or title" aria-label="Case to link"
                           @bind="_fuLinkQuery" @bind:event="oninput" @bind:after="SearchFuLink" />
                }
                <button type="button" class="btn btn-sm btn-link p-0" aria-label="Remove the link" @onclick="() => { _fuLinkOpen = false; _fuLink = null; _fuLinkQuery = null; _fuLinkResults = []; }"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            </div>
            @if (_fuLink is null && _fuLinkResults.Count > 0)
            {
                <div class="im-then-results">
                    @foreach (var r in _fuLinkResults)
                    {
                        <button type="button" class="btn btn-sm btn-link p-0 d-block text-start" @onclick="() => { _fuLink = r; _fuLinkResults = []; }">
                            <code>@r.CaseNumber</code> <span class="text-muted">@r.Title</span>
                        </button>
                    }
                </div>
            }
        }
        @if (SaveSummary() is { } summary)
        {
            <div class="im-then-summary"><span class="bi bi-check2" aria-hidden="true"></span> @summary.Replace("Saved together", "Saves together")</div>
        }
    </div>;

    // --- RD-07: the composer's five modes ---
    private enum ComposerMode { Finding, Decision, Adversary, Question, Note }
    // Question and Note aren't timeline entries; the other three map onto the entry kind and type.
    private ComposerMode? _special;
    private ComposerMode CurrentMode => _special
        ?? (_tlAddKind == TimelineKind.Event ? ComposerMode.Adversary : _tlType == TimelineEntryType.Decision ? ComposerMode.Decision : ComposerMode.Finding);
    private bool _editorMentions;
    private IReadOnlyList<IncidentManager.Application.Abstractions.UserSummary> _mentionable = [];
    private Guid _mentionsFor;
    private string? _question;
    private bool _questionTask = true;
    private bool _saving;

    private IEnumerable<(ComposerMode Mode, string Icon, string Label)> Modes()
    {
        yield return (ComposerMode.Finding, "bi-search", "Finding");
        yield return (ComposerMode.Decision, "bi-signpost-split", "Decision");
        yield return (ComposerMode.Adversary, "bi-lightning", IsThirdParty ? "Disclosure step" : "Adversary step");
        yield return (ComposerMode.Question, "bi-question-circle", "Question");
        yield return (ComposerMode.Note, "bi-journal-text", "Working note");
    }

    private void SetMode(ComposerMode m)
    {
        _special = m is ComposerMode.Question or ComposerMode.Note ? m : null;
        switch (m)
        {
            case ComposerMode.Adversary:
                _tlAddKind = TimelineKind.Event;
                break;
            case ComposerMode.Decision:
                _tlAddKind = TimelineKind.Investigation;
                _tlType = TimelineEntryType.Decision;
                break;
            default:
                _tlAddKind = TimelineKind.Investigation;
                if (_tlType == TimelineEntryType.Decision) _tlType = TimelineEntryType.Analysis;
                break;
        }
    }

    private async Task AddQuestion()
    {
        if (string.IsNullOrWhiteSpace(_question) || _saving) return;
        _saving = true;
        try
        {
            await Cases.AddOpenQuestionAsync(CaseId, _question, _questionTask);
            _question = null;
            await OnChanged.InvokeAsync();
            Toasts.Success(_questionTask ? "Question added to the brief, with a task to answer it" : "Question added to the brief");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
        finally { _saving = false; }
    }

    private async Task AddNote()
    {
        if (_saving) return;
        string body;
        try { body = await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId); }
        catch (JSException) { return; }
        if (string.IsNullOrWhiteSpace(body)) return;
        string[] mentions = [];
        try { mentions = await JS.InvokeAsync<string[]>("markdownEditor.getMentions", InvEditorId); } catch (JSException) { }
        _saving = true;
        try
        {
            await Cases.AddNoteAsync(CaseId, body, mentions);
            ComposerDrafts?.Remove(InvEditorId);
            try { await JS.InvokeVoidAsync("markdownEditor.setValue", InvEditorId, ""); } catch (JSException) { }
            await OnChanged.InvokeAsync();
            Toasts.Success(mentions.Length > 0 ? $"Working note saved; {IncidentManager.Application.Common.Plural.Of(mentions.Length, "person", "people")} emailed" : "Working note saved");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
        finally { _saving = false; }
    }

    // The case's entities as inline "[[" tag candidates ({id, value, hint}) for the Investigation editor.
    private object[] EntityCandidates =>
        Case.Entities
            .Select(e => (object)new
            {
                id = e.Id.ToString(),
                value = string.IsNullOrWhiteSpace(e.Label) ? e.Value : e.Label!,
                hint = Ui.Label(e.Type)   // the display name ("IP address"), not the enum identifier
            })
            .ToArray();

    private async Task OpenNotesNow()
    {
        await SwitchToNotes();
        await OnOpenNotesHandled.InvokeAsync();
        StateHasChanged();
    }

    /// <summary>Ctrl/⌘+Enter from the parent's hotkey dispatcher — submit whichever composer is active.</summary>
    public async Task SubmitAsync()
    {
        if (!CanEdit) return;
        if (_notesOnly && _notesList is { IsEditing: true } list) { await list.SubmitAsync(); return; }
        if (_tlEditId is not null)
        {
            if (_tlAddKind == TimelineKind.Event) await SaveEventEdit(); else await SaveInvestigationEdit();
        }
        else if (_special == ComposerMode.Question) await AddQuestion();
        else if (_special == ComposerMode.Note) await AddNote();
        else if (_tlAddKind == TimelineKind.Event) await AddEventStep();
        else await AddTimeline();
    }

    private async Task OnTimelinePasted(InputFileChangeEventArgs e)
    {
        _composerOpen = true; // a pasted screenshot is staged in the form, so show it
        try
        {
            var f = e.File;
            const long maxShot = 15 * 1024 * 1024;
            await using var s = f.OpenReadStream(maxShot);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            _tlShotBytes = ms.ToArray();
            _tlShotEvidenceId = null;
            _tlShotName = f.Name;
            _tlShotType = string.IsNullOrWhiteSpace(f.ContentType) ? "image/png" : f.ContentType;
        }
        catch (Exception ex)
        {
            Toasts.Error("Couldn't read the pasted image. Try again, or upload it on the Evidence tab (15 MB max).");
            ClearTimelineShot();
        }
    }

    private void ClearTimelineShot() { _tlShotBytes = null; _tlShotName = null; _tlShotEvidenceId = null; }

    private string TlShotDataUri() =>
        _tlShotBytes is null ? "" : $"data:{_tlShotType};base64,{Convert.ToBase64String(_tlShotBytes)}";

    // Uploads the staged screenshot as hashed, chain-of-custody evidence and returns its id to link.
    private async Task<Guid?> UploadTimelineShotAsync()
    {
        if (_tlShotBytes is null) return null;
        if (_tlShotEvidenceId is { } uploaded) return uploaded;
        await using var s = new MemoryStream(_tlShotBytes);
        var ev = await Evidence.UploadAsync(CaseId, _tlShotName ?? "pasted-screenshot.png", _tlShotType, s, "Pasted into the timeline");
        _tlShotEvidenceId = ev.Id;
        return ev.Id;
    }

    private async Task AddTimeline()
    {
        try { _tlDesc = await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId); }
        catch (JSException) { /* editor not mounted; fall back to bound value */ }

        if (string.IsNullOrWhiteSpace(_tlDesc)) return;
        if (IsDecision && string.IsNullOrWhiteSpace(_decWhy)) { Toasts.Error("Record why the decision was made."); return; }
        var whenUtc = WallToUtc(_tlWhen);
        Guid? shotId;
        try
        {
            shotId = await UploadTimelineShotAsync();
            await Cases.AddTimelineEntryAsync(CaseId, TimelineKind.Investigation, _tlType, whenUtc, _tlDesc, _tlSource,
                evidenceId: shotId, decision: Decision(), followUps: FollowUps());
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error($"Couldn't add the timeline entry. {ex.Message}");
            return;
        }
        var saved = SaveSummary();
        _tlDesc = ""; _tlSource = null; ClearTimelineShot(); ClearDecision(); ResetFollowUps();
        ComposerDrafts?.Remove(InvEditorId); // FR-02: the draft is now saved
        await OnChanged.InvokeAsync();
        Toasts.Success(saved ?? (shotId is null ? "Timeline entry added" : "Timeline entry added with screenshot"));
        try { await JS.InvokeVoidAsync("markdownEditor.setValue", InvEditorId, ""); }
        catch (JSException) { /* best effort */ }
    }

    // Event timeline: an adversary action — ATT&CK tactic(s) + actor→target attribution.
    private async Task AddEventStep()
    {
        if (string.IsNullOrWhiteSpace(_tlDesc)) return;
        var whenUtc = WallToUtc(_tlWhen);
        var disclosure = IsThirdParty && !_evtAttackMode;
        Guid? shotId;
        try
        {
            shotId = await UploadTimelineShotAsync();
            if (disclosure)
            {
                await Cases.AddEventStepAsync(CaseId, whenUtc, Array.Empty<MitreTactic>(), null, null, null,
                    _tlDesc, _tlSource, evidenceId: shotId, type: _evtStage, followUps: FollowUps());
            }
            else
            {
                Guid? actor = Guid.TryParse(_evtActorId, out var a) ? a : null;
                Guid? target = Guid.TryParse(_evtTargetId, out var t) ? t : null;
                var technique = string.IsNullOrWhiteSpace(_evtTechnique) ? null : _evtTechnique;
                await Cases.AddEventStepAsync(CaseId, whenUtc, EvtTacticSet(), technique, actor, target, _tlDesc, _tlSource, evidenceId: shotId, followUps: FollowUps());
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
            return;
        }
        _tlDesc = ""; _tlSource = null; _evtTechnique = ""; _evtActorId = ""; _evtTargetId = ""; _actorPrev = ""; _targetPrev = "";
        _evtTactic = MitreTactic.Unspecified;
        ClearTimelineShot();
        await OnChanged.InvokeAsync();
        var savedStep = SaveSummary();
        ResetFollowUps();
        var what = disclosure ? "Disclosure step" : IsThirdParty ? "Attack step" : "Event step";
        Toasts.Success(savedStep ?? (shotId is null ? $"{what} added" : $"{what} added with screenshot"));
    }

    // Switch the timeline lens (All / Event / Investigation); abandon any in-progress edit and clear
    // kind-specific filters that no longer apply.
    private async Task SwitchLens(TimelineKind? lens)
    {
        if (_tlEditId is not null) await CancelTimelineEdit();
        _decOnly = false;
        _keyOnly = false;
        _notesOnly = false;
        _tlLens = lens;
        if (lens is { } k) { _tlAddKind = k; _special = null; }   // a focused lens drives what the composer adds
        ClearTimelineFilters();
    }

    // In the All lens the composer serves both timelines; pick which one to add to.
    private void SetAddKind(TimelineKind kind) => _tlAddKind = kind;

    // Load an Event step into the composer for an in-place correction.
    private void StartEventEdit(TimelineEntry e)
    {
        _special = null;
        _tlAddKind = TimelineKind.Event;
        _evtAttackMode = IsThirdParty && IsAttackStep(e); // FR-24: edit an attack step in attack mode
        _tlEditId = e.Id;
        _tlReason = null;
        _tlWhen = UtcToWall(e.OccurredAtUtc);
        _evtActorId = e.ActorEntityId?.ToString() ?? "";
        _evtTargetId = e.TargetEntityId?.ToString() ?? "";
        _actorPrev = _evtActorId; _targetPrev = _evtTargetId;
        _evtTechnique = e.TechniqueId ?? "";
        _evtTactic = e.Tactics.Select(t => t.Tactic).FirstOrDefault();
        _evtStage = e.Type;   // E-32: vendor-disclosure stage for a third-party case
        _tlDesc = e.Description;
        _tlSource = e.Source;
    }

    private async Task SaveEventEdit()
    {
        if (_tlEditId is not { } id || string.IsNullOrWhiteSpace(_tlDesc)) return;
        var whenUtc = WallToUtc(_tlWhen);
        // Captured before CancelTimelineEdit resets the composer mode, so the toast names what was edited.
        var savedLabel = IsThirdParty && !_evtAttackMode ? "Disclosure step updated" : IsThirdParty ? "Attack step updated" : "Event step updated";
        try
        {
            if (IsThirdParty && !_evtAttackMode)
            {
                await Cases.EditEventStepAsync(CaseId, id, whenUtc, Array.Empty<MitreTactic>(), null, null, null,
                    _tlDesc, _tlSource, _tlReason, type: _evtStage);
            }
            else
            {
                Guid? actor = Guid.TryParse(_evtActorId, out var a) ? a : null;
                Guid? target = Guid.TryParse(_evtTargetId, out var t) ? t : null;
                var technique = string.IsNullOrWhiteSpace(_evtTechnique) ? null : _evtTechnique;
                await Cases.EditEventStepAsync(CaseId, id, whenUtc, EvtTacticSet(), technique, actor, target, _tlDesc, _tlSource, _tlReason);
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
            return;
        }
        await CancelTimelineEdit();
        await OnChanged.InvokeAsync();
        Toasts.Success(savedLabel);
    }

    // Load an Investigation entry into the Markdown composer to edit; saving creates a new version.
    private async Task StartInvestigationEdit(TimelineEntry e)
    {
        _tlAddKind = TimelineKind.Investigation;
        _tlEditId = e.Id;
        _tlReason = null;
        _tlType = e.Type;
        _tlWhen = UtcToWall(e.OccurredAtUtc);
        _tlSource = e.Source;
        _tlDesc = e.Description;
        _decWhy = e.Rationale; _decOptions = e.OptionsConsidered; _decBy = e.DecidedBy;
        try { await JS.InvokeVoidAsync("markdownEditor.setValue", InvEditorId, e.Description); }
        catch (JSException) { /* editor not mounted yet; ReconcileEditor seeds it from _tlDesc */ }
    }

    private async Task SaveInvestigationEdit()
    {
        if (_tlEditId is not { } id) return;
        try { _tlDesc = await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId); }
        catch (JSException) { /* fall back to bound value */ }
        if (string.IsNullOrWhiteSpace(_tlDesc)) return;
        var whenUtc = WallToUtc(_tlWhen);
        if (IsDecision && string.IsNullOrWhiteSpace(_decWhy)) { Toasts.Error("Record why the decision was made."); return; }
        try { await Cases.EditInvestigationEntryAsync(CaseId, id, _tlType, whenUtc, _tlDesc, _tlSource, _tlReason, Decision()); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error($"Couldn't save the entry. {ex.Message}"); return; }
        await CancelTimelineEdit();
        await OnChanged.InvokeAsync();
        Toasts.Success("Investigation entry saved as a new version");
    }

    // Leave edit mode and clear the composer. For Investigation, also blank the Markdown editor.
    private async Task CancelTimelineEdit()
    {
        var wasInvestigationEdit = _tlAddKind == TimelineKind.Investigation && _tlEditId is not null;
        _tlEditId = null; _tlReason = null; ClearDecision();
        _tlDesc = ""; _tlSource = null; _evtTechnique = ""; _evtActorId = ""; _evtTargetId = ""; _actorPrev = ""; _targetPrev = "";
        _evtTactic = MitreTactic.Unspecified; _evtAttackMode = false; // FR-24: back to the default disclosure composer
        if (wasInvestigationEdit)
        {
            try { await JS.InvokeVoidAsync("markdownEditor.setValue", InvEditorId, ""); }
            catch (JSException) { /* best effort */ }
        }
    }

    private void ToggleHistory(Guid entryId)
    {
        if (!_tlHistoryOpen.Remove(entryId)) _tlHistoryOpen.Add(entryId);
    }

    // Prior versions of an Investigation entry, newest first, by walking the supersede chain.
    private List<TimelineEntry> InvestigationHistory(TimelineEntry current)
    {
        var all = Case.TimelineEntries;
        var history = new List<TimelineEntry>();
        var cursor = current.SupersedesEntryId;
        while (cursor is { } id && all.FirstOrDefault(x => x.Id == id) is { } prior)
        {
            history.Add(prior);
            cursor = prior.SupersedesEntryId;
        }
        return history;
    }

    // --- INV-10: evidence an entry cites ---
    private Guid? _citing;
    private readonly HashSet<Guid> _citeSel = new();
    private bool _citeSaving;

    private List<Evidence> CitedBy(TimelineEntry e) => Case.Citations.Where(x => x.TimelineEntryId == e.Id)
        .Select(x => Case.Evidence.FirstOrDefault(ev => ev.Id == x.EvidenceId)).OfType<Evidence>()
        .OrderBy(ev => ev.OriginalFileName, StringComparer.OrdinalIgnoreCase).ToList();

    private static bool IsImage(Evidence ev) => ev.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    // --- INV-28: tasks started from an entry ---
    private Guid? _taskFor;

    // An entry's first version: what a task about it records, so the link survives edits.
    private Guid RootOf(TimelineEntry e)
    {
        var first = e;
        while (first.SupersedesEntryId is { } prior && Case.TimelineEntries.FirstOrDefault(x => x.Id == prior) is { } p) first = p;
        return first.Id;
    }

    // HR-15: an entry added or edited after the case closed says so; the record isn't locked, it's marked.
    private RenderFragment AfterClosureMark(DateTimeOffset added, DateTimeOffset lastChanged) => @<text>
        @if (Case.ClosureRecordedAtUtc is { } closed && lastChanged > closed)
        {
            <span class="tl-after-closure" title="@($"The case closed {TimeDisp.Long(closed)}; this was {(added > closed ? "added" : "edited")} {TimeDisp.Long(lastChanged)}")">
                <span class="bi bi-pencil-square" aria-hidden="true"></span> @(added > closed ? "added" : "edited") after closure
            </span>
        }
    </text>;

    // HR-08: a task result logged on the timeline says which entry (usually a decision) the task carried out.
    private RenderFragment CarriesOut(TimelineEntry e) => @<text>
        @if (e.ActionItemId is { } tid && Case.ActionItems.FirstOrDefault(t => t.Id == tid) is { About: { Kind: ActionItem.AboutEntry } about }
             && Case.TimelineEntries.FirstOrDefault(x => x.IsCurrent && RootOf(x) == about.Id) is { } origin && origin.Id != e.Id)
        {
            <div class="tl-carries small">
                <span class="bi bi-arrow-return-right" aria-hidden="true"></span>
                Carries out the @(origin.Type == TimelineEntryType.Decision ? "decision" : "entry") of
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => ScrollToEntry(origin.Id)">@TimeDisp.Short(origin.OccurredAtUtc)</button>:
                <span class="text-muted">@IncidentManager.Application.Cases.TaskResults.Excerpt(IncidentManager.Application.Content.RichText.ToText(origin.Description), 100)</span>
            </div>
        }
    </text>;

    private async Task ScrollToEntry(Guid id)
    {
        try { await JS.InvokeVoidAsync("imMotion.scrollToId", $"tl-{id}"); } catch (JSException) { /* motion is optional */ }
    }

    // HR-17: a task started from a decision begins as the decision itself ("Disable j.morales, revoke …"), to be
    // trimmed into the action; anything else starts blank.
    private static string? DecisionTaskTitle(TimelineEntry e)
    {
        if (e.Type != TimelineEntryType.Decision) return null;
        var text = IncidentManager.Application.Content.RichText.ToText(e.Description).ReplaceLineEndings(" ").Trim();
        return text.Length <= ActionItem.MaxTitleLength ? text : text[..(ActionItem.MaxTitleLength - 1)].TrimEnd() + "…";
    }

    private RenderFragment TaskButton(TimelineEntry e) => @<text>
        @if (CanEdit)
        {
            <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => _taskFor = _taskFor == e.Id ? null : e.Id">
                <span class="bi bi-plus-lg" aria-hidden="true"></span> Task
            </button>
        }
    </text>;

    private RenderFragment EntryTasks(TimelineEntry e) => @<text>
        @{
            var about = $"{ActionItem.AboutEntry}:{RootOf(e)}";
            var tasks = Case.ActionItems.Where(t => t.AboutRef == about).OrderByDescending(t => t.IsOpen).ThenBy(t => t.CreatedAtUtc).ToList();
        }
        @if (tasks.Count > 0)
        {
            <div class="tl-tasks" aria-label="@(e.Type == TimelineEntryType.Decision ? "Tasks carrying out this decision" : "Tasks about this entry")">
                @* RD-13: a decision says what carried it out. *@
                @if (e.Type == TimelineEntryType.Decision) { <span class="tl-tasks-h">Carried out by</span> }
                @foreach (var t in tasks)
                {
                    <span class="tl-task @(t.IsOpen ? "" : "tl-task-done")" title="@(t.IsOpen ? "Open task" : "Done")">
                        <span class="bi @(t.IsOpen ? "bi-square" : "bi-check2-square")" aria-hidden="true"></span> @t.Title
                        @if (t.Status == ActionItemStatus.Done && t.CompletedAtUtc is { } doneAt)
                        {
                            <span class="text-muted">&nbsp;· done @TimeDisp.Short(doneAt)@(t.CompletedBy is { } by ? $" by {Users.DisplayFor(by)}" : "")</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(t.Owner)) { <span class="text-muted">· @Users.DisplayFor(t.Owner)</span> }
                    </span>
                    @* HR-02: what the task found or did, right under the entry it follows up. *@
                    @if (t.Status == ActionItemStatus.Done && TaskResults.TryGetValue(t.Id, out var res))
                    {
                        <span class="tl-task-result" title="@res.Text">@IncidentManager.Application.Cases.TaskResults.Excerpt(res.Text)</span>
                    }
                }
            </div>
        }
        @if (_taskFor == e.Id)
        {
            <QuickTask CaseId="CaseId" About="@about" Placeholder="A task about this entry" InitialTitle="@DecisionTaskTitle(e)"
                       OnDone="async () => { _taskFor = null; await OnChanged.InvokeAsync(); }" OnCancel="() => _taskFor = null" />
        }
    </text>;

    private RenderFragment CiteButton(TimelineEntry e) => @<text>
        @if (CanEdit && Case.Evidence.Count > 0)
        {
            <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => StartCite(e)">
                <span class="bi bi-paperclip" aria-hidden="true"></span> Cite evidence
            </button>
        }
    </text>;

    private RenderFragment CitedEvidence(TimelineEntry e) => @<text>
        @{ var cited = CitedBy(e); }
        @if (cited.Count > 0)
        {
            <div class="tl-cites" aria-label="Evidence cited">
                @foreach (var ev in cited)
                {
                    @if (IsImage(ev))
                    {
                        <button type="button" class="tl-cite" @onclick="() => OnPreview.InvokeAsync(ev.Id)" title="Preview @ev.OriginalFileName">
                            <span class="bi bi-image" aria-hidden="true"></span> @ev.OriginalFileName
                        </button>
                    }
                    else
                    {
                        @* RD-06: a cited file opens its panel (preview, integrity, custody) instead of downloading. *@
                        <a class="tl-cite" href="cases/@CaseId?evidence=@ev.Id" title="Open @ev.OriginalFileName">
                            <span class="bi bi-paperclip" aria-hidden="true"></span> @ev.OriginalFileName
                        </a>
                    }
                }
            </div>
        }
        @if (_citing == e.Id)
        {
            <div class="tl-cite-pick border rounded p-2 mt-2 bg-body-tertiary">
                <div class="small fw-semibold mb-1">Evidence that supports this entry</div>
                @foreach (var ev in Case.Evidence.OrderByDescending(x => x.CreatedAtUtc))
                {
                    <div class="form-check small">
                        <input class="form-check-input" type="checkbox" id="@($"cite-{e.Id}-{ev.Id}")" checked="@_citeSel.Contains(ev.Id)"
                               @onchange="x => ToggleCite(ev.Id, (bool)(x.Value ?? false))" />
                        <label class="form-check-label" for="@($"cite-{e.Id}-{ev.Id}")">
                            @ev.OriginalFileName <span class="text-muted">· @TimeDisp.Short(ev.CreatedAtUtc)@(string.IsNullOrWhiteSpace(ev.Description) ? "" : $" · {ev.Description}")</span>
                        </label>
                    </div>
                }
                <div class="d-flex gap-2 justify-content-end mt-1">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _citing = null">Cancel</button>
                    <button class="btn btn-sm btn-primary" disabled="@_citeSaving" @onclick="() => SaveCite(e.Id)">Save</button>
                </div>
            </div>
        }
    </text>;

    private void StartCite(TimelineEntry e)
    {
        _citing = e.Id;
        _citeSel.Clear();
        foreach (var ev in CitedBy(e)) _citeSel.Add(ev.Id);
    }

    private void ToggleCite(Guid id, bool on) { if (on) _citeSel.Add(id); else _citeSel.Remove(id); }

    private async Task SaveCite(Guid entryId)
    {
        _citeSaving = true;
        try
        {
            await Cases.CiteEvidenceAsync(CaseId, entryId, _citeSel.ToList());
            _citing = null;
            await OnChanged.InvokeAsync();
            Toasts.Success("Evidence cited");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); }
        finally { _citeSaving = false; }
    }

