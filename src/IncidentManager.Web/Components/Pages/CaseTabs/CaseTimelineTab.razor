@* Case workspace — Timeline tab (UX-13, interwoven pass; the largest tab). Two interleaved timelines
   (U-36): the Event / vendor-disclosure narrative and the analyst Investigation log, with a lens switch,
   in-place editing (+ versioned history for Investigation), the first-party attack kill-chain, ATT&CK
   attribution to IOC entities, per-entry screenshot paste (U-40), and filters. The tab owns its single
   Investigation EasyMDE editor (own reconcile + teardown via the shared markdownEditor JS API). Cross-tab
   concerns are threaded in: the screenshot lightbox (OnPreview → parent OpenShot), the live-collab flash
   (delegates), a Reload after a write (OnChanged), and Ctrl/⌘+Enter (parent calls SubmitAsync via @ref).
   The paste shim is registered by the parent against the ids kept here (timeline-dropzone / -file-paste).
   The "jump to new entries" pill (U-32) stays parent-owned (live-collab state). *@
@implements IAsyncDisposable
@inject CaseService Cases
@inject EvidenceService Evidence
@inject IClock Clock
@inject IncidentManager.Application.Content.IMarkdownService Md
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject TimeDisplay TimeDisp
@inject IncidentManager.Application.Abstractions.IOrganizationTimeZone OrgZone
@inject ToastService Toasts
@inject IJSRuntime JS
@inject ISeverityLabels SevLabels
@inject IncidentManager.Application.Preferences.UserDisplayPreferenceService DisplayPrefs
@inject UnsavedEdits Edits

@* INV-26: one toolbar row — the lens, the reading controls and "Add" — so the history starts near the top of the
   tab. Filters open in a second row only when asked for (or while one is set); each lens explains itself on hover. *@
@{
    // Only current versions are shown; superseded Investigation edits live in history (below) and the audit trail.
    // INV-30: the Decisions lens is Investigation narrowed to decisions; "key entries" keeps the turning points.
    var tlAll = Case.TimelineEntries.Where(x => (_tlLens is null || x.Kind == _tlLens) && x.IsCurrent
                                          && (!_decOnly || x.Type == TimelineEntryType.Decision)
                                          && (!KeyOnlyApplies || IsKeyEntry(x))).ToList();
    var tlView = FilteredTimeline(tlAll)
        .Where(e => ChangedSinceUtc is not { } since || (e.ModifiedAtUtc ?? e.CreatedAtUtc) > since).ToList();
    // INV-01: response milestones, derived from the case record. Shown in All (unless hidden) and their own lens;
    // an entry filter (type / tactic / source) doesn't apply to them, so they step aside while one is active.
    var msAll = _tlLens is null && _showMilestones
        ? Milestones().Where(m => !KeyOnlyApplies || IsKeyMilestone(m)).ToList() : [];
    // HR-07: a closed case reads as a story; team changes are record-keeping, folded until asked for.
    var teamHidden = Case.Phase == CasePhase.Closed && !_showTeamChanges ? msAll.Count(m => m.Kind == MilestoneKind.Command) : 0;
    if (teamHidden > 0) msAll = msAll.Where(m => m.Kind != MilestoneKind.Command).ToList();
    var msView = FiltersActive ? []
        : ChangedSinceUtc is { } msSince ? msAll.Where(m => (m.RecordedAtUtc ?? m.AtUtc) > msSince).ToList() : msAll;
    // BUG-413: retracted entries are out of the record; shown as stubs only when asked for, in the plain views.
    var retracted = !_decOnly && !KeyOnlyApplies && !FiltersActive && ChangedSinceUtc is null
        ? Case.TimelineEntries.Where(x => x.IsRetracted && (_tlLens is null || x.Kind == _tlLens)).ToList() : [];
    var rows = MergeRows(_showRetracted ? tlView.Concat(retracted) : tlView, msView);
    var totalAll = tlAll.Count + msAll.Count;
    // The attack chain is always event-only, regardless of lens (shown under All and Event).
    var tlChain = AttackSteps();
}

<div class="tl-toolbar" id="tl-toolbar">
    @* RD-13: the Record's lenses. Story and Everything read in two lanes (the adversary, the response) either side
       of the time spine; the others are one lane. *@
    <div class="im-seg" role="group" aria-label="Record lens">
        <button class="btn btn-sm @(StoryLens ? "active" : "")" aria-pressed="@Ui.Aria(StoryLens)"
                title="The turning points, oldest first: attack steps, decisions, handoffs, and the phase, classification, severity, materiality, gate and reporting milestones."
                @onclick="SwitchToStory">Story <span class="tl-count">@(CurrentEntries.Count(IsKeyEntry) + Milestones().Count(IsKeyMilestone))</span></button>
        <button class="btn btn-sm @(_tlLens is null && !_keyOnly && !_notesOnly ? "active" : "")" aria-pressed="@Ui.Aria(_tlLens is null && !_keyOnly && !_notesOnly)"
                title="The full chronology: what happened, what the team did, and the response milestones."
                @onclick="() => SwitchLens(null)">Everything <span class="tl-count">@(CurrentEntries.Count() + Milestones().Count)</span></button>
        <button class="btn btn-sm @(_tlLens == TimelineKind.Event ? "active" : "")" aria-pressed="@Ui.Aria(_tlLens == TimelineKind.Event)"
                title="@(IsThirdParty ? "The attacker's steps (at the vendor, and in our environment if they pivoted in) and the disclosure milestones (what the vendor told us and what we confirmed)." : "The attack narrative: facts and timing of what the adversary did.")"
                @onclick="() => SwitchLens(TimelineKind.Event)">@(IsThirdParty ? "Attack & disclosure" : "Attack chain") <span class="tl-count">@CurrentEntries.Count(x => x.Kind == TimelineKind.Event)</span></button>
        <button class="btn btn-sm @(_tlLens == TimelineKind.Investigation && !_decOnly ? "active" : "")" aria-pressed="@Ui.Aria(_tlLens == TimelineKind.Investigation && !_decOnly)"
                title="What the team did: findings, actions, decisions and handoffs."
                @onclick="() => SwitchLens(TimelineKind.Investigation)">Response <span class="tl-count">@CurrentEntries.Count(x => x.Kind == TimelineKind.Investigation)</span></button>
        @* INV-30: "what did we decide, and why?" — the examiner's first question, one click away. *@
        <button class="btn btn-sm @(_decOnly ? "active" : "")" aria-pressed="@Ui.Aria(_decOnly)"
                title="Decisions, each with why it was made, what else was considered and who decided."
                @onclick="SwitchToDecisions">Decisions <span class="tl-count">@CurrentEntries.Count(x => x.Type == TimelineEntryType.Decision)</span></button>
        @* RD-08: the working notes, off the record, as a lens of it (the Notes tab is gone). *@
        <button class="btn btn-sm @(_notesOnly ? "active" : "")" aria-pressed="@Ui.Aria(_notesOnly)"
                title="Working notes: reasoning as you go, off the record and out of the report until put on the record."
                @onclick="SwitchToNotes">Working notes <span class="tl-count">@Case.Notes.Count(n => n.IsCurrent)</span></button>
    </div>
    @if (totalAll > 0 && !_notesOnly)
    {
        @* UX-55: Filter, how times are shown and the order behind one View button, so the lenses, View and Add fit one row
           beside the rail (they took two). Pressed while the view isn't the default, so a filter or T+ is never hidden. *@
        <div class="tl-viewmenu" @onkeydown="ViewMenuKey">
            <button type="button" class="btn btn-sm @(ViewCustomised ? "btn-secondary" : "btn-outline-secondary")"
                    aria-expanded="@Ui.Aria(_viewMenu)" aria-controls="tl-viewmenu" @onclick="() => _viewMenu = !_viewMenu"
                    title="Filter, clock or T+, and order">
                <span class="bi bi-sliders" aria-hidden="true"></span> View@(FilterCount > 0 ? $" ({FilterCount})" : "")
                <span class="bi bi-chevron-down" aria-hidden="true"></span>
            </button>
            @if (_viewMenu)
            {
                <div class="tl-viewmenu-scrim" @onclick="() => _viewMenu = false"></div>
                <div id="tl-viewmenu" class="tl-viewmenu-pop" role="group" aria-label="View options">
                    <button type="button" class="btn btn-sm @(FiltersActive ? "btn-secondary" : "btn-outline-secondary") w-100 text-start"
                            aria-expanded="@Ui.Aria(FiltersShown)" aria-controls="tl-filter-row"
                            @onclick="() => { _showFilters = !_showFilters; _viewMenu = false; }">
                        <span class="bi bi-funnel" aria-hidden="true"></span> @(FiltersShown ? "Hide filters" : "Filter…")@(FilterCount > 0 ? $" ({FilterCount} on)" : "")
                    </button>
                    @if (Case.DetectedAtUtc is not null)
                    {
                        @* INV-03: responders talk in time since detection ("T+26h we had the session"). *@
                        <div class="tl-viewmenu-row">
                            <span class="tl-viewmenu-label" id="tl-vm-times">Times</span>
                            <div class="im-seg" role="group" aria-labelledby="tl-vm-times">
                                <button type="button" class="btn btn-sm @(_tPlus ? "" : "active")" aria-pressed="@Ui.Aria(!_tPlus)" @onclick="() => _tPlus = false">Clock</button>
                                <button type="button" class="btn btn-sm @(_tPlus ? "active" : "")" aria-pressed="@Ui.Aria(_tPlus)" @onclick="() => _tPlus = true"
                                        title="Time since the case was detected (T+ detection)">T+</button>
                            </div>
                        </div>
                    }
                    <div class="tl-viewmenu-row">
                        <span class="tl-viewmenu-label" id="tl-vm-order">Order</span>
                        <div class="im-seg" role="group" aria-labelledby="tl-vm-order">
                            <button type="button" class="btn btn-sm @(_tlOldestFirst ? "" : "active")" aria-pressed="@Ui.Aria(!_tlOldestFirst)" @onclick="() => _tlOldestFirst = false">Newest first</button>
                            <button type="button" class="btn btn-sm @(_tlOldestFirst ? "active" : "")" aria-pressed="@Ui.Aria(_tlOldestFirst)" @onclick="() => _tlOldestFirst = true">Oldest first</button>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (ChangedSinceUtc is { } sinceChip)
        {
            @* INV-04: only what was added or changed since the viewer last had the case open. *@
            <span class="im-badge im-b-info">
                Changed since @TimeDisp.Short(sinceChip)
                <button type="button" class="btn-close btn-close-sm ms-1 align-middle" style="font-size:.55rem" aria-label="Show everything"
                        @onclick="OnClearSince"></button>
            </span>
        }
    }
    @if (_tlEditId is null)
    {
        <AuthorizeView Policy="@Policies.EditCases">
            @if (!ComposerVisible)
            {
                <button type="button" class="btn btn-sm btn-primary ms-auto" aria-expanded="false" aria-controls="timeline-dropzone"
                        title="Add @(IsThirdParty ? "an attack step, a disclosure milestone" : "an attack step") or an investigation entry. You can also paste a screenshot, or paste or drop a file."
                        @onclick="OpenComposer">
                    <span class="bi bi-plus-lg" aria-hidden="true"></span> Add
                </button>
            }
            else if (Case.TimelineEntries.Any(x => x.IsCurrent))
            {
                <button type="button" class="btn btn-sm btn-link ms-auto" aria-expanded="true" aria-controls="timeline-dropzone"
                        @onclick="() => _composerOpen = false">Hide form</button>
            }
        </AuthorizeView>
    }
</div>
@if (totalAll > 0 && !_notesOnly && FiltersShown)
{
    @* BUG-425: im-own-keys: Ctrl/Cmd+Enter in a filter does nothing (keymap.js leaves it alone); it isn't the composer's. *@
    <div class="tl-filters im-own-keys" id="tl-filter-row">
        @if (_tlLens is null)
        {
            <div class="form-check form-switch mb-0 small" title="Show classification, phase, gate and other response milestones in the chronology">
                <input class="form-check-input" type="checkbox" role="switch" id="tl-show-ms" @bind="_showMilestones" />
                <label class="form-check-label" for="tl-show-ms">Milestones</label>
            </div>
        }
        @if (_tlLens == TimelineKind.Event && !IsThirdParty)
        {
                <select class="form-select form-select-sm w-auto" @bind="_tlFilterTacticStr" aria-label="Filter by tactic">
                    <option value="">All tactics</option>
                    @foreach (var t in Enum.GetValues<MitreTactic>().Where(x => x != MitreTactic.Unspecified).OrderBy(Ui.TacticRank))
                    {
                        <option value="@t">@Ui.Label(t)</option>
                    }
                </select>
        }
        else if ((_tlLens == TimelineKind.Investigation && !_decOnly) || (_tlLens == TimelineKind.Event && IsThirdParty))
        {
                <select class="form-select form-select-sm w-auto" @bind="_tlFilterTypeStr" aria-label="Filter by type">
                    <option value="">All types</option>
                    @* FR-23: the Disclosure lens filters by its milestone set; Investigation by the IR-type set. *@
                    @foreach (var t in (_tlLens == TimelineKind.Event ? (IReadOnlyList<TimelineEntryType>)DisclosureOrder : InvestigationTypeOptions()))
                    {
                        <option value="@t">@Ui.Label(t)</option>
                    }
                </select>
        }
        <input class="form-control form-control-sm w-auto" style="max-width:14rem" @bind="_tlFilterSource"
               @bind:event="oninput" placeholder="Filter by source…" aria-label="Filter by source" />
        @if (Case.Entities.Count > 0)
        {
            @* INV-03: everything that touches one entity — as actor or target, or tagged inline with [[ in the text. *@
                <select class="form-select form-select-sm w-auto" style="max-width:16rem" @bind="_tlFilterEntityStr" aria-label="Filter by entity">
                    <option value="">Any entity</option>
                    @foreach (var en in Case.Entities.OrderBy(x => x.Type).ThenBy(EntityShort))
                    {
                        <option value="@en.Id">@Ui.Label(en.Type): @EntityShort(en)</option>
                    }
                </select>
        }
        @if (FiltersActive)
        {
            <button type="button" class="btn btn-sm btn-link text-decoration-none px-1"
                    @onclick="ClearTimelineFilters">Clear</button>
            <span class="text-muted small">@tlView.Count of @tlAll.Count@(msAll.Count > 0 ? " · milestones hidden while filtering" : "")</span>
        }
    </div>
}

<AuthorizeView Policy="@Policies.EditCases">
    @* Down a long timeline, Add is always to hand (shown by CSS once the toolbar has scrolled away), and opens the
       composer docked rather than taking the reader back to the top. *@
    @if (_tlEditId is null && !ComposerVisible)
    {
        <button type="button" class="btn btn-primary tl-add-fab" @onclick="OpenComposer" aria-label="Add to the timeline">
            <span class="bi bi-plus-lg" aria-hidden="true"></span> Add
        </button>
    }
    @* Design review P5 / INV-26: the composer stays folded (opened from the toolbar's Add) so the history starts at
       the top of the tab. It opens for a new case with no entries yet, when editing, and when a screenshot is pasted.
       Opened while the top of the timeline is scrolled out of view, it's docked at the bottom of the window instead:
       the same form, so the reader keeps their place and can read the entries while writing. *@
    <div id="timeline-dropzone" class="card mb-3 @(_tlEditId is not null ? "border-primary" : "") @(ComposerVisible ? "" : "d-none")"
         role="region" aria-label="@(_tlEditId is null ? "Add to the timeline" : "Edit the entry")">
        <div class="card-body">
            @* Shown only while the composer is popped out (CSS: html[data-tl-docked]). *@
            @if (ComposerVisible)
            {
                <div class="tl-docked-head">
                    <h2 class="im-entity-panel-h mb-0">@(_tlEditId is null ? "Add to the timeline" : "Editing an entry")</h2>
                    <button type="button" class="btn-close" aria-label="Close the form (what's typed stays as a draft)" @onclick="CloseDocked"></button>
                </div>
            }
            @* U-40: hidden sink the paste shim feeds a pasted screenshot into; staged then attached on Add. CAP-26: any file,
               pasted or dropped on the composer; one that isn't an image is cited by the entry. *@
            <InputFile id="timeline-file-paste" class="d-none" OnChange="OnTimelinePasted" aria-label="Attach a file to the entry" />
            @if (_tlEditId is null)
            {
                <div class="small text-muted mb-2 d-flex align-items-center gap-2 flex-wrap tl-composer-paste" aria-live="polite">
                    <span><span class="bi bi-clipboard me-1" aria-hidden="true"></span>Paste a screenshot, or paste or drop a file, to attach it.
                        <span class="tl-paste-detail">It's saved as hashed evidence with chain of custody; a file that isn't an image is cited by the entry.</span></span>
                    @if (_tlShotBytes is not null)
                    {
                        <span class="im-badge im-b-info">
                            <span class="bi bi-paperclip me-1" aria-hidden="true"></span>@_tlShotName@(TlShotIsFile ? $" · {EvidenceRoom.Size(_tlShotBytes.LongLength)}" : "")
                        </span>
                        @if (!TlShotIsFile)
                        {
                            <img src="@TlShotDataUri()" alt="Pasted screenshot preview" style="max-height:40px;border-radius:.25rem;border:1px solid var(--bs-border-color)" />
                        }
                        else if (EvidenceRisk.Sentence(_tlShotName, _tlShotType, _tlShotBytes.AsSpan(0, Math.Min(16, _tlShotBytes.Length))) is { } risk)
                        {
                            @* CAP-26 (PROD-58): a file that can run is stored like any other, and downloads inside a zip. *@
                            <span class="im-badge im-b-warn" title="@risk It's kept as evidence and downloads inside a password-protected zip.">
                                <span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>Can run: downloads zipped
                            </span>
                        }
                        <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="ClearTimelineShot"
                                aria-label="Remove @_tlShotName">Remove</button>
                    }
                </div>
            }
            @if (_tlEditId is not null)
            {
                <div class="alert alert-primary py-1 px-2 small d-flex justify-content-between align-items-center mb-2">
                    <span>
                        <span class="bi bi-pencil-square" aria-hidden="true"></span>
                        @(_tlAddKind == TimelineKind.Event
                            ? (IsThirdParty && !_evtAttackMode ? "Editing this disclosure milestone. The audit trail records the change."
                                            : "Editing this attack step. The audit trail records the change.")
                            : "Editing this entry. Saving creates a new version and keeps the old one.")
                    </span>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none p-0"
                            @onclick="CancelEditToRow">Cancel</button>
                </div>
            }
            @if (_tlEditId is null)
            {
                @* RD-07: one composer, five modes, for everything written into the case: what we found or did, a decision
                   with its why, what the adversary (or vendor) did, a question for the brief, or a working note. *@
                <div class="im-modes mb-2" role="radiogroup" aria-label="What to log">
                    @foreach (var (m, icon, label) in Modes())
                    {
                        var on = CurrentMode == m;
                        <button type="button" role="radio" aria-checked="@Ui.Aria(on)" class="@(on ? "on" : "")" @onclick="() => SetMode(m)">
                            <span class="bi @icon" aria-hidden="true"></span> @label
                        </button>
                    }
                </div>
            }
            @if (_special == ComposerMode.Question && _tlEditId is null)
            {
                @* RD-07: a question goes on the brief's open questions (a new brief version), optionally followed up as a task. *@
                <label class="form-label small mb-1" for="tl-question">What does the team still need to find out?</label>
                <textarea id="tl-question" data-tag-box data-tag-refs="@TagRefLabels" class="form-control form-control-sm im-rec" rows="2" maxlength="400" @bind="_question" @bind:event="oninput"
                          aria-describedby="tl-oneline-hint" placeholder="e.g. Did the other two users' credentials get used?"></textarea>
                @OneLineHint("the brief and as its task's title")
                <div class="form-check small mt-2">
                    <input class="form-check-input" type="checkbox" id="tl-question-task" @bind="_questionTask" />
                    <label class="form-check-label" for="tl-question-task">Follow it up as a task, so its answer comes back to the brief</label>
                </div>
                <div class="d-flex justify-content-end align-items-center gap-2 mt-2 tl-composer-actions">
                    <span class="small text-muted me-auto">Saves a new version of the brief with the question added@(_questionTask ? ", and a task" : "").</span>
                    <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" disabled="@(string.IsNullOrWhiteSpace(_question) || _saving)" @onclick="AddQuestion">
                        <span class="bi bi-question-circle" aria-hidden="true"></span> Add question
                    </button>
                </div>
            }
            else if (_tlAddKind == TimelineKind.Event)
            {
                @if (IsThirdParty && _evtAttackMode)
                {
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="small fw-semibold" id="tl-where-label">Where did it happen?</span>
                        <div class="im-seg" role="group" aria-labelledby="tl-where-label">
                            <button type="button" class="btn btn-sm @(!_evtOurs ? "active" : "")" aria-pressed="@Ui.Aria(!_evtOurs)"
                                    @onclick="() => _evtOurs = false">The vendor's environment</button>
                            <button type="button" class="btn btn-sm @(_evtOurs ? "active" : "")" aria-pressed="@Ui.Aria(_evtOurs)"
                                    @onclick="() => _evtOurs = true">Our environment</button>
                        </div>
                    </div>
                    <p class="small text-muted mb-2 im-composer-hint">
                        @(_evtOurs
                            ? "What the attacker did in our network after pivoting from the vendor. The first step here is the pivot: its actor can be the vendor-side host and its target ours."
                            : "What the attacker did in the vendor's environment, as the vendor reported it.")
                        It counts in the case's techniques, the report's attack chain and ATT&amp;CK coverage@(_evtOurs ? " (as ours)" : " (marked as at a vendor)").
                    </p>
                }
                else if (IsThirdParty)
                {
                    <p class="small text-muted mb-2 im-composer-hint">A point in the disclosure: when the vendor told us something, or we confirmed something about our data.</p>
                }
                @if (!IsThirdParty || _evtAttackMode)
                {
                    @* First-party (or a third-party attack step): the attack narrative — ATT&CK tactic(s) + actor→target attribution to IOCs.
                       INV-47: rows with the time buttons align to the top, so the buttons hang under the date only. *@
                    <div class="row g-2 align-items-start">
                        <div class="col-md-4">
                            @StepWhenField()
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-0" for="tl-atk-actor">Actor <span class="text-muted">(from IOCs)</span></label>
                            <select id="tl-atk-actor" class="form-select form-select-sm" @bind="_evtActorId" @bind:after="AfterPartyPicked">
                                <option value="">None</option>
                                @foreach (var en in Case.Entities)
                                {
                                    <option value="@en.Id">@EntityOptionLabel(en)</option>
                                }
                                <option value="@NewIoc">+ New IOC…</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-0" for="tl-atk-target">Target <span class="text-muted">(from IOCs)</span></label>
                            <select id="tl-atk-target" class="form-select form-select-sm" @bind="_evtTargetId" @bind:after="AfterPartyPicked">
                                <option value="">None</option>
                                @foreach (var en in Case.Entities)
                                {
                                    <option value="@en.Id">@EntityOptionLabel(en)</option>
                                }
                                <option value="@NewIoc">+ New IOC…</option>
                            </select>
                        </div>
                    </div>
                    <div class="mt-2">
                        <label class="form-label small mb-0">ATT&amp;CK <span class="text-muted">(technique or tactic, optional)</span></label>
                        <AttackStepPicker @bind-TechniqueId="_evtTechnique" @bind-Tactic="_evtTactic" />
                    </div>
                    <div class="mt-2">
                        <label class="form-label small mb-1" for="tl-atk-desc">What the @(!IsThirdParty ? "adversary did" : _evtOurs ? "attacker did in our environment" : "attacker did at the vendor")</label>
                        <textarea id="tl-atk-desc" data-tag-box data-tag-refs="@TagRefLabels" class="form-control form-control-sm" rows="2" @bind="_tlDesc" @bind:event="oninput"
                                  aria-describedby="tl-oneline-hint" placeholder="e.g. Authenticated to the VPN from 203.0.113.66 with valid credentials"></textarea>
                        @OneLineHint("the report's tables and the attack-chain diagram")
                    </div>
                }
                else
                {
                    @* E-32: third-party/vendor case — a vendor-disclosure narrative, not an attack kill-chain.
                       No ATT&CK / actor→target; the milestone (disclosure received, vendor detection, scope
                       confirmed, remediation) is the response type carried on the step. *@
                    <div class="row g-2 align-items-start">
                        <div class="col-md-4">
                            @* REV-24: a milestone's time can be stated as a date, a window or not at all (an imported vendor
                               summary), so the editor shows the same choice the attack step does; a date edited here is kept. *@
                            @StepWhenField(disclosure: true)
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-0" for="tl-disc-stage">Milestone</label>
                            <select id="tl-disc-stage" class="form-select form-select-sm" @bind="_evtStage">
                                @foreach (var t in DisclosureComposerOptions())
                                {
                                    <option value="@t">@Ui.Label(t)</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="mt-2">
                        <label class="form-label small mb-1" for="tl-disc-desc">What the vendor reported / what we confirmed</label>
                        <textarea id="tl-disc-desc" data-tag-box data-tag-refs="@TagRefLabels" class="form-control form-control-sm" rows="2" @bind="_tlDesc" @bind:event="oninput"
                                  aria-describedby="tl-oneline-hint" placeholder="e.g. Vendor confirmed our policyholder records were in the exposed dataset"></textarea>
                        @OneLineHint("the report's disclosure milestones table")
                    </div>
                }
                <div class="row g-2 align-items-end mt-1">
                    <div class="col-md-4">
                        <label class="form-label small mb-0" for="tl-evt-source">Source</label>
                        <input id="tl-evt-source" class="form-control form-control-sm" maxlength="200" @bind="_tlSource" @bind:event="oninput" placeholder="@EventSourcePlaceholder" />
                    </div>
                    @if (_tlEditId is not null)
                    {
                        <div class="col-md-4">
                            <label class="form-label small mb-0" for="tl-evt-reason">Reason for change <span class="text-muted">(optional)</span></label>
                            <input id="tl-evt-reason" class="form-control form-control-sm" maxlength="2000" @bind="_tlReason" @bind:event="oninput" placeholder="e.g. corrected source IP" />
                        </div>
                    }
                </div>
                @if (_tlEditId is null) { @ThenSection() }
                <div class="d-flex justify-content-end align-items-end gap-2 mt-2 tl-composer-actions">
                    @if (_tlEditId is null)
                    {
                        <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="AddEventStep">
                            <span class="bi bi-plus-lg" aria-hidden="true"></span> Add step
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEditToRow">Cancel</button>
                        <button class="btn btn-sm btn-primary" @onclick="SaveEventEdit">
                            <span class="bi bi-check-lg" aria-hidden="true"></span> Save changes
                        </button>
                    }
                </div>
            }
            else
            {
                @* Investigation = the analyst's working log: response type + Markdown notes. RD-07: a working note uses the
                   same editor without the record's fields. *@
                @if (_special != ComposerMode.Note)
                {
                <div class="row g-2 align-items-start">
                    @if (_tlEditId is not null || CurrentMode != ComposerMode.Decision)
                    {
                    <div class="col-md-3">
                        <label class="form-label small mb-0" for="tl-inv-type">Type</label>
                        <select id="tl-inv-type" class="form-select form-select-sm" @bind="_tlType">
                            @foreach (var t in InvestigationComposerOptions())
                            {
                                <option value="@t">@Ui.Label(t)</option>
                            }
                        </select>
                    </div>
                    }
                    <div class="col-md-3">
                        <label class="form-label small mb-0" for="tl-inv-when">Occurred (@TimeDisp.Label)</label>
                        <DateTimeInput Past="true" id="tl-inv-when" class="form-control form-control-sm" @bind-Value="_tlWhen" />
                        @TimeNudges()
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0" for="tl-inv-source">Source</label>
                        <input id="tl-inv-source" class="form-control form-control-sm" maxlength="200" @bind="_tlSource" @bind:event="oninput" placeholder="@($"{DetectionLabel}…")" />
                    </div>
                </div>
                }
                <div class="tl-inv-main @(_special == ComposerMode.Note ? "" : "mt-3")">
                    <label class="form-label small mb-1" for="@InvEditorId">
                        @(_special == ComposerMode.Note ? "Working note" : IsDecision ? "The decision" : "What you found or did") <span class="text-muted">· Markdown · <code>[[</code> to tag an entity@(_special == ComposerMode.Note ? " · " : "")@if (_special == ComposerMode.Note) {<code>@@</code><text> to mention a teammate</text>}</span>
                    </label>
                    @if (_tlEditId is null)
                    {
                        <ComposerHint>@(_special == ComposerMode.Note
                            ? "Working reasoning as you go. Not on the timeline and not in the case report unless its layout includes analyst notes; put it on the record later if it matters. Mentioned teammates are emailed a link."
                            : IsDecision
                            ? "What was decided. Say why below: the decision and its reasons appear together in the report's investigation timeline. Write facts and reasons; this is part of the case record."
                            : "What the team found or did, and when. Appears in the report's investigation timeline and doesn't notify anyone.")</ComposerHint>
                    }
                    @* EasyMDE enhances this textarea (managed in this tab's OnAfterRenderAsync); value pulled on Add/Save. *@
                    <textarea id="@InvEditorId" class="form-control"></textarea>
                    @if (IsDecision)
                    {
                        @* INV-06: a decision is recorded with why, what else was considered, and who decided. *@
                        <div class="row g-2 mt-1">
                            <div class="col-12">
                                <label class="form-label small mb-0" for="tl-dec-why">Why <span class="text-muted">(required)</span></label>
                                <textarea id="tl-dec-why" class="form-control form-control-sm" rows="2" maxlength="4000" @bind="_decWhy" @bind:event="oninput"
                                          placeholder="e.g. sign-in logs for the other two users are incomplete, and resetting is low cost"></textarea>
                            </div>
                            <div class="col-md-7">
                                <label class="form-label small mb-0" for="tl-dec-options">Options considered <span class="text-muted">(optional)</span></label>
                                <input id="tl-dec-options" class="form-control form-control-sm" maxlength="2000" @bind="_decOptions" @bind:event="oninput" placeholder="e.g. reset only the confirmed account" />
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small mb-0" for="tl-dec-by">Decided by <span class="text-muted">(optional)</span></label>
                                @* HR-17: the case's people first, then everyone; free text still works ("IC with Legal"). *@
                                <input id="tl-dec-by" class="form-control form-control-sm" maxlength="300" @bind="_decBy" @bind:event="oninput" placeholder="e.g. Incident Commander with Legal" list="tl-dec-by-people" autocomplete="off" />
                                <datalist id="tl-dec-by-people">
                                    @foreach (var name in DeciderNames())
                                    {
                                        <option value="@name"></option>
                                    }
                                </datalist>
                            </div>
                        </div>
                    }
                    @if (_tlEditId is not null)
                    {
                        <div class="mt-2">
                            <label class="form-label small mb-0" for="tl-inv-reason">Reason for change <span class="text-muted">(optional)</span></label>
                            <input id="tl-inv-reason" class="form-control form-control-sm" maxlength="2000" @bind="_tlReason" @bind:event="oninput" placeholder="e.g. clarified meeting outcome" />
                        </div>
                    }
                    @if (_tlEditId is null && _special != ComposerMode.Note) { @ThenSection() }
                    <div class="mt-2 d-flex justify-content-end gap-2 tl-composer-actions">
                        @if (_tlEditId is null && _special == ComposerMode.Note)
                        {
                            <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" disabled="@_saving" @onclick="AddNote">
                                <span class="bi bi-journal-text" aria-hidden="true"></span> Save working note
                            </button>
                        }
                        else if (_tlEditId is null)
                        {
                            <button class="btn btn-sm btn-primary" title="Ctrl / ⌘ + Enter" @onclick="AddTimeline">
                                <span class="bi bi-plus-lg" aria-hidden="true"></span> @(IsDecision ? "Record decision" : "Add to the record")
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEditToRow">Cancel</button>
                            <button class="btn btn-sm btn-primary" @onclick="SaveInvestigationEdit">
                                <span class="bi bi-check-lg" aria-hidden="true"></span> Save new version
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</AuthorizeView>


@* The attack chain: the adversary's steps (on a third-party case, the attacker's steps at the vendor). *@
@if (_tlLens != TimelineKind.Investigation && !_notesOnly && tlChain.Count > 0)
{
    <div class="killchain-wrap mb-3 @(_showKillChain ? "" : "killchain-collapsed")">
        @* INV-26: folded, it's one line — the tactics in order — so the history below stays in view. *@
        <button type="button" class="killchain-strip" aria-expanded="@Ui.Aria(_showKillChain)" @onclick="ToggleKillChain">
            <span class="fw-semibold small text-nowrap"><span class="bi bi-diagram-3 me-1" aria-hidden="true"></span>@ChainTitle(tlChain)</span>
            <span class="text-muted small text-nowrap">@IncidentManager.Application.Common.Plural.Of(tlChain.Count, "step")</span>
            @if (!_showKillChain)
            {
                <span class="killchain-strip-tactics small">
                    @for (var i = 0; i < tlChain.Count; i++)
                    {
                        var tac = PrimaryTactic(tlChain[i]);
                        @if (i > 0) { <span class="text-muted" aria-hidden="true"> → </span> }
                        <span style="color:@Ui.TacticColor(tac)">@Ui.Label(tac)</span>
                    }
                </span>
            }
            <span class="small ms-auto text-nowrap killchain-strip-toggle">@(_showKillChain ? "Hide" : "Show") <span class="bi @(_showKillChain ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></span></span>
        </button>
        @if (_showKillChain)
        {
            <div class="killchain">
                @for (var i = 0; i < tlChain.Count; i++)
                {
                    var step = tlChain[i];
                    if (i > 0)
                    {
                        var pivot = IsPivot(tlChain[i - 1], step);
                        <div class="killchain-arrow @(pivot ? "killchain-pivot" : "")" aria-hidden="@Ui.Aria(!pivot)">
                            <span class="bi bi-arrow-right" aria-hidden="true"></span>
                            @if (pivot) { <span class="killchain-pivot-label">Pivot into our network</span> }
                        </div>
                    }
                    <div class="killchain-node" style="--tl-color:@Ui.TacticColor(PrimaryTactic(step))">
                        <div class="killchain-node-head">
                            <span class="killchain-idx">@(i + 1)</span>
                            <span class="bi @Ui.TacticGlyph(PrimaryTactic(step))" aria-hidden="true"></span>
                            @if (IncidentManager.Application.Cases.StepTime.Stated(step) is { } stated)
                            {
                                <span class="killchain-time tl-approx" title="@stated">@IncidentManager.Application.Cases.StepTime.Short(step)</span>
                            }
                            else
                            {
                                <time class="killchain-time" title="@TimeDisp.Long(step.OccurredAtUtc)">@TimeDisp.Short(step.OccurredAtUtc)</time>
                            }
                            @if (IncidentManager.Application.Cases.EventSteps.WhereLabel(Case, step) is { } where)
                            {
                                <span class="im-badge im-b-neutral killchain-where">@where</span>
                            }
                        </div>
                        <div class="killchain-tactics">
                            @foreach (var tt in step.Tactics.Select(x => x.Tactic).OrderBy(Ui.TacticRank))
                            {
                                <span class="tactic-chip" style="--tac:@Ui.TacticColor(tt)">@Ui.Label(tt)</span>
                            }
                        </div>
                        @if (EntityById(step.ActorEntityId) is not null || EntityById(step.TargetEntityId) is not null)
                        {
                            <div class="killchain-attrib">
                                @if (EntityById(step.ActorEntityId) is { } a)
                                {
                                    <span class="tl-ent">@Ui.EntityGlyph(a.Type) @EntityShort(a)</span>
                                }
                                <span class="tl-arrow">&rarr;</span>
                                @if (EntityById(step.TargetEntityId) is { } tgt)
                                {
                                    <span class="tl-ent">@Ui.EntityGlyph(tgt.Type) @EntityShort(tgt)</span>
                                }
                                else
                                {
                                    <span class="text-muted">?</span>
                                }
                            </div>
                        }
                        <div class="killchain-desc md-body">@((MarkupString)Inline(step.Description))</div>
                    </div>
                }
            </div>
        }
    </div>
}

@if (_notesOnly)
{
    <CaseNotesTab @ref="_notesList" CaseId="CaseId" Notes="Case.Notes" Entities="Case.Entities" Tasks="Case.ActionItems" CanEdit="CanEdit"
                  Promoted="PromotedSources" OnChanged="OnChanged" FlashClass="FlashClass" FlashStyle="FlashStyle" FocusNoteId="FocusNoteId" />
}
else if (totalAll == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon"><span class="bi bi-clock-history" aria-hidden="true"></span></div>
        <div class="empty-state-title">No entries in this timeline yet</div>
        <div class="empty-state-msg">
            @(_decOnly ? "No decisions yet. Record one as a Decision entry, with why it was made, so the record answers \"what did we decide, and why?\"" : _tlLens switch
            {
                TimelineKind.Event => IsThirdParty
                    ? "Record the vendor's incident: the attacker's steps in their environment, and the disclosure milestones."
                    : "Record the facts and timing of what happened.",
                TimelineKind.Investigation => "Log the actions you and the team take as the investigation unfolds.",
                _ => "Record what happened and log the team's actions as the investigation unfolds."
            })
        </div>
    </div>
}
else if (rows.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon"><span class="bi bi-funnel" aria-hidden="true"></span></div>
        <div class="empty-state-title">No entries match your filters</div>
        <div class="empty-state-actions">
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearTimelineFilters">Clear filters</button>
        </div>
    </div>
}
else
{
    <div class="tl-panel">
    @if (teamHidden > 0)
    {
        <div class="tl-fold small text-muted">
            <span class="bi bi-people" aria-hidden="true"></span> @teamHidden team @(teamHidden == 1 ? "change" : "changes") hidden
            <button type="button" class="btn btn-link btn-sm p-0 ms-1" @onclick="() => _showTeamChanges = true">Show</button>
        </div>
    }
    @if (retracted.Count > 0)
    {
        @* BUG-413 *@
        <div class="tl-fold small text-muted">
            <span class="bi bi-slash-circle" aria-hidden="true"></span> @retracted.Count retracted @(retracted.Count == 1 ? "entry" : "entries") @(_showRetracted ? "shown" : "hidden")
            <button type="button" class="btn btn-link btn-sm p-0 ms-1" @onclick="() => _showRetracted = !_showRetracted">@(_showRetracted ? "Hide" : "Show")</button>
        </div>
    }
    @if (Lanes) { @MiniMap() }
    <ol class="tl @(Lanes ? "tl-lanes" : "")">
        @{ DateOnly? lastDay = null; DateTimeOffset? lastAt = null; }
        @if (Lanes)
        {
            <li class="tl-lanehead" aria-hidden="true"><span>@(IsThirdParty ? "Attack & disclosure" : "Adversary")</span><span></span><span>Response</span></li>
        }
        @foreach (var row in rows)
        {
            @* RD-13: a long quiet stretch is shown as one, so silence reads as silence. *@
            @* ST-02: an approximate time measures nothing, so no gap is drawn to or from one. *@
            var rowApprox = row.Entry?.IsApproximate == true;
            if (lastAt is { } prevAt && !rowApprox && Math.Abs((row.At - prevAt).TotalHours) >= GapHours)
            {
                <li class="tl-gap" @key="@($"gap-{row.At.UtcTicks}")"><span>@Ui.Hours(Math.Abs((row.At - prevAt).TotalHours)) with nothing recorded</span></li>
            }
            lastAt = rowApprox ? null : row.At;
            var day = LocalDay(row.At);
            if (day != lastDay)
            {
                lastDay = day;
                @* INV-03: a day header, counted from the day the case was detected. *@
                <li class="tl-day" @key="@($"day-{day}")"><span>@DayLabel(day)</span></li>
            }
            if (row.Milestone is { } m)
            {
                @* INV-01: a milestone derived from the case record. Read-only; its source record is the thing to change. *@
                <li class="tl-item @BandClass(row.At) tl-kind-ms @(m.Flagged ? "tl-ms-flagged" : "") @(m.Kind == MilestoneKind.EvidenceWithdrawn ? "tl-ms-withdrawn" : "")" id="tl-@m.Key" @key="m.Key">
                    <span class="tl-dot" aria-hidden="true"><span class="bi @MilestoneGlyph(m.Kind)"></span></span>
                    <div class="tl-body">
                        <div class="tl-head">
                            <span class="tl-kind-label"><span class="bi bi-flag" aria-hidden="true"></span> Milestone</span>
                            <span class="tl-ms-title">@m.Title</span>
                            @if (m.Note is { } note)
                            {
                                @* HR-07: the gate this transition passed, folded in rather than a row of its own. *@
                                <span class="tl-ms-note"><span class="bi bi-shield-check" aria-hidden="true"></span> @note</span>
                            }
                            @TimeLabel(m.AtUtc)
                        </div>
                        @if (m.Detail is { } detail)
                        {
                            <div class="tl-desc tl-ms-detail">@detail</div>
                        }
                        <div class="tl-meta">
                            <span>from @m.Source</span>
                            @if (m.Actor is { } who)
                            {
                                <span>by @Users.DisplayFor(who)</span>
                            }
                            @if (m.RecordedAtUtc is { } rec)
                            {
                                @* INV-05: dated to when it happened; say openly that it was entered later. *@
                                <span class="tl-late" title="Entered @TimeDisp.Long(rec)"><span class="bi bi-clock-history" aria-hidden="true"></span> recorded @TimeDisp.Short(rec)</span>
                            }
                            @if (m.Transition is { } tr)
                            {
                                var corrections = CorrectionsFor(tr.ChangeId);
                                @if (corrections.Count > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => ToggleCorrections(tr.ChangeId)"
                                            aria-expanded="@Ui.Aria(_corrOpen.Contains(tr.ChangeId))">
                                        <span class="bi bi-clock-history" aria-hidden="true"></span>
                                        Time corrected@(corrections.Count > 1 ? $" ({corrections.Count})" : "")
                                    </button>
                                }
                                @if (CanCorrect(tr.Kind))
                                {
                                    <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => StartCorrection(m)">
                                        <span class="bi bi-pencil" aria-hidden="true"></span> Correct time
                                    </button>
                                }
                            }
                        </div>
                        @if (m.Transition is { } open && _corrOpen.Contains(open.ChangeId))
                        {
                            <div class="tl-history mt-2">
                                @foreach (var k in CorrectionsFor(open.ChangeId))
                                {
                                    <div class="tl-history-item small">
                                        <div class="text-muted">@Users.DisplayFor(k.CreatedBy) · @TimeDisp.Long(k.CreatedAtUtc)</div>
                                        <div>Moved from <span class="im-data">@TimeDisp.Long(k.FromEffectiveUtc)</span> to <span class="im-data">@TimeDisp.Long(k.ToEffectiveUtc)</span>. @k.Reason</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </li>
                continue;
            }
            var e = row.Entry!;
            if (e.IsRetracted)
            {
                @* BUG-413: a retracted entry stays in the record as a stub: who retracted it, when and why, and what it said. *@
                <li class="tl-item @BandClass(row.At) tl-retracted" id="tl-@e.Id" @key="e.Id">
                    <span class="tl-dot" aria-hidden="true"><span class="bi bi-slash-circle"></span></span>
                    <div class="tl-body">
                        <div class="tl-head">
                            <span class="tl-kind-label"><span class="bi bi-slash-circle" aria-hidden="true"></span> Retracted @(e.Kind == TimelineKind.Event ? "step" : "entry")</span>
                            @TimeLabel(e.OccurredAtUtc)
                        </div>
                        <div class="tl-desc tl-retracted-text md-body">@((MarkupString)(e.Kind == TimelineKind.Event ? Inline(e.Description) : Html(e.Description)))</div>
                        <div class="tl-meta small">
                            Retracted by @Users.DisplayFor(e.RetractedBy ?? "") · @TimeDisp.Short(e.RetractedAtUtc!.Value)@(string.IsNullOrWhiteSpace(e.RetractReason) ? "" : $": {e.RetractReason}")
                        </div>
                    </div>
                </li>
                continue;
            }
            if (e.Kind == TimelineKind.Event)
            {
                // FR-24: a third-party case can carry attack (ATT&CK) steps alongside disclosure milestones —
                // render each Event entry by what it actually holds, not just the case's third-party flag.
                var asAttack = IncidentManager.Application.Cases.EventSteps.IsAttack(Case, e);
                <li class="tl-item @BandClass(row.At) tl-kind-event im-enter @FlashClass?.Invoke(e.Id)" style="@FlashStyle?.Invoke(e.Id)" id="tl-@e.Id" @key="e.Id">
                    <span class="tl-dot" style="--tl-color:@(asAttack ? Ui.TacticColor(PrimaryTactic(e)) : Ui.TimelineColor(e.Type))" aria-hidden="true">
                        <span class="bi @(asAttack ? Ui.TacticGlyph(PrimaryTactic(e)) : Ui.TimelineGlyph(e.Type))"></span>
                    </span>
                    <div class="tl-body">
                        <div class="tl-head">
                            <span class="tl-kind-label"><span class="bi @(asAttack ? "bi-lightning-charge" : "bi-megaphone")" aria-hidden="true"></span> @(asAttack ? (IsThirdParty ? $"Attack {IncidentManager.Application.Cases.EventSteps.WhereLabel(Case, e)}" : "Attack step") : "Disclosure milestone")</span>
                            @if (asAttack)
                            {
                                <span class="tl-tactics">
                                    @foreach (var tt in e.Tactics.Select(x => x.Tactic).OrderBy(Ui.TacticRank))
                                    {
                                        <span class="tactic-chip" style="--tac:@Ui.TacticColor(tt)">
                                            <span class="bi @Ui.TacticGlyph(tt)" aria-hidden="true"></span> @Ui.Label(tt)
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(e.TechniqueId))
                                    {
                                        <a class="tactic-chip" style="--tac:#6c757d" target="_blank" rel="noopener noreferrer"
                                           href="https://attack.mitre.org/techniques/@TechniquePath(e.TechniqueId)/">
                                            <span class="bi bi-diagram-2" aria-hidden="true"></span> @e.TechniqueId
                                        </a>
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="tactic-chip" style="--tac:@Ui.TimelineColor(e.Type)">
                                    <span class="bi @Ui.TimelineGlyph(e.Type)" aria-hidden="true"></span> @Ui.Label(e.Type)
                                </span>
                            }
                            @StepTimeLabel(e)
                        </div>
                        <div class="tl-desc md-body">@((MarkupString)Inline(e.Description))</div>
                        @if (e.EvidenceId is { } shotId)
                        {
                            @* U-40: attached screenshot — click the thumbnail to preview it in a lightbox. *@
                            <button type="button" class="tl-shot d-inline-block mt-1 btn p-0 border-0 bg-transparent" @onclick="() => OnPreview.InvokeAsync(shotId)" title="Preview the attached screenshot">
                                <img src="evidence/@shotId/inline" alt="Attached screenshot" loading="lazy"
                                     style="max-height:120px;max-width:100%;border-radius:.375rem;border:1px solid var(--bs-border-color);cursor:zoom-in" />
                            </button>
                        }
                        @CitedEvidence(e)
                        <div class="tl-meta">
                            @if (EntityById(e.ActorEntityId) is { } actor || EntityById(e.TargetEntityId) is not null)
                            {
                                <span class="tl-attrib">
                                    @if (EntityById(e.ActorEntityId) is { } a)
                                    {
                                        <button type="button" class="tl-ent tl-ent-btn" @onclick="() => OnOpenEntity.InvokeAsync(a.Id)" title="@Ui.EntityDetailsHint(EntityShort(a))">@Ui.EntityGlyph(a.Type) @EntityShort(a)</button>
                                    }
                                    <span class="tl-arrow">&rarr;</span>
                                    @if (EntityById(e.TargetEntityId) is { } tgt)
                                    {
                                        <button type="button" class="tl-ent tl-ent-btn" @onclick="() => OnOpenEntity.InvokeAsync(tgt.Id)" title="@Ui.EntityDetailsHint(EntityShort(tgt))">@Ui.EntityGlyph(tgt.Type) @EntityShort(tgt)</button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">(unspecified)</span>
                                    }
                                </span>
                            }
                            @if (!string.IsNullOrWhiteSpace(e.Source))
                            {
                                <span class="tl-source"><span class="bi bi-tag" aria-hidden="true"></span> @e.Source</span>
                            }
                            <span>logged by @Users.DisplayFor(e.CreatedBy)</span>
                            @if (e.ModifiedAtUtc is { } mod)
                            {
                                <span class="text-muted" title="@TimeDisp.Long(mod)">· edited by @Users.DisplayFor(e.ModifiedBy)</span>
                            }
                            @AfterClosureMark(e.CreatedAtUtc, e.ModifiedAtUtc ?? e.CreatedAtUtc)
                            @if (CanEdit)
                            {
                                <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => StartEventEdit(e)">
                                    <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-link p-0 tl-edit" title="Take it off the record, with a reason" @onclick="() => StartRetract(e)">
                                    <span class="bi bi-slash-circle" aria-hidden="true"></span> Retract
                                </button>
                                @if (asAttack && CanReorder(e))
                                {
                                    @* ST-01: steps whose times don't settle the order (same date, or not stated) are put in order by hand. *@
                                    <span class="tl-move" role="group" aria-label="Move this step">
                                        <button type="button" class="btn btn-sm btn-link p-0 tl-edit" title="Move earlier in the attack chain" @onclick="() => MoveStep(e, true)">
                                            <span class="bi bi-arrow-up" aria-hidden="true"></span><span class="visually-hidden">Move earlier</span>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-link p-0 tl-edit" title="Move later in the attack chain" @onclick="() => MoveStep(e, false)">
                                            <span class="bi bi-arrow-down" aria-hidden="true"></span><span class="visually-hidden">Move later</span>
                                        </button>
                                    </span>
                                }
                            }
                            @CiteButton(e)
                            @TaskButton(e)
                        </div>
                        @EntryTasks(e)
                    </div>
                </li>
            }
            else
            {
                var isDecision = e.Type == TimelineEntryType.Decision;
                <li class="tl-item @BandClass(row.At) tl-kind-inv @(isDecision ? "tl-kind-dec" : "") @(e.Type == TimelineEntryType.Handoff ? "tl-kind-handoff" : "") im-enter @FlashClass?.Invoke(e.Id)" style="@FlashStyle?.Invoke(e.Id)" id="tl-@e.Id" @key="e.Id">
                    <span class="tl-dot" style="--tl-color:@Ui.TimelineColor(e.Type)" aria-hidden="true">
                        <span class="bi @Ui.TimelineGlyph(e.Type)"></span>
                    </span>
                    <div class="tl-body">
                        <div class="tl-head">
                            @if (isDecision)
                            {
                                <span class="tl-kind-label"><span class="bi bi-signpost-2" aria-hidden="true"></span> @Ui.Label(e.Type)</span>
                            }
                            else if (e.Type == TimelineEntryType.Handoff)
                            {
                                @* INV-15: a handoff reads as its own kind, not an ordinary investigation note. *@
                                <span class="tl-kind-label"><span class="bi bi-arrow-left-right" aria-hidden="true"></span> @Ui.Label(e.Type)</span>
                            }
                            else
                            {
                                <span class="tl-kind-label"><span class="bi bi-search" aria-hidden="true"></span> Investigation</span>
                                <span class="tactic-chip" style="--tac:@Ui.TimelineColor(e.Type)">
                                    <span class="bi @Ui.TimelineGlyph(e.Type)" aria-hidden="true"></span> @Ui.Label(e.Type)
                                </span>
                            }
                            @if (e.Version > 1)
                            {
                                <span class="im-badge im-b-neutral">v@(e.Version)</span>
                            }
                            @TimeLabel(e.OccurredAtUtc)
                        </div>
                        <div class="tl-desc md-body">@((MarkupString)Html(e.Description))</div>
                        @if (isDecision)
                        {
                            <dl class="tl-decision">
                                @if (e.Rationale is { } why) { <dt>Why</dt><dd>@why</dd> }
                                @if (e.OptionsConsidered is { } options) { <dt>Options considered</dt><dd>@options</dd> }
                                @if (e.DecidedBy is { } by) { <dt>Decided by</dt><dd>@by</dd> }
                            </dl>
                        }
                        @if (e.EvidenceId is { } shotId)
                        {
                            @* U-40: attached screenshot — click the thumbnail to preview it in a lightbox. *@
                            <button type="button" class="tl-shot d-inline-block mt-1 btn p-0 border-0 bg-transparent" @onclick="() => OnPreview.InvokeAsync(shotId)" title="Preview the attached screenshot">
                                <img src="evidence/@shotId/inline" alt="Attached screenshot" loading="lazy"
                                     style="max-height:120px;max-width:100%;border-radius:.375rem;border:1px solid var(--bs-border-color);cursor:zoom-in" />
                            </button>
                        }
                        @CitedEvidence(e)
                        <div class="tl-meta">
                            @if (!string.IsNullOrWhiteSpace(e.Source))
                            {
                                <span class="tl-source"><span class="bi bi-tag" aria-hidden="true"></span> @e.Source</span>
                            }
                            <span>logged by @Users.DisplayFor(e.CreatedBy)</span>
                            @{ var history = InvestigationHistory(e); }
                            @{ var firstRecorded = history.Count > 0 ? history[^1].CreatedAtUtc : e.CreatedAtUtc; }
                            @if (e.IsImported)
                            {
                                @* INV-23: dated as the imported summary gave it; the import time is on hover. *@
                                <span class="tl-late" title="Imported @TimeDisp.Long(firstRecorded) from a structured summary"><span class="bi bi-box-arrow-in-down" aria-hidden="true"></span> imported @TimeDisp.Short(firstRecorded)</span>
                            }
                            else if (firstRecorded - e.OccurredAtUtc > CaseService.BackdateReasonThreshold)
                            {
                                @* INV-03: entered well after it happened — said openly, as on milestones and in the report. *@
                                <span class="tl-late" title="Entered @TimeDisp.Long(firstRecorded)"><span class="bi bi-clock-history" aria-hidden="true"></span> recorded @TimeDisp.Short(firstRecorded)</span>
                            }
                            @AfterClosureMark(firstRecorded, e.CreatedAtUtc)
                            @if (history.Count > 0)
                            {
                                <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => ToggleHistory(e.Id)">
                                    <span class="bi bi-clock-history" aria-hidden="true"></span>
                                    @(_tlHistoryOpen.Contains(e.Id) ? "Hide" : "Show") @history.Count earlier version@(history.Count == 1 ? "" : "s")
                                </button>
                            }
                            @if (CanEdit)
                            {
                                <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => StartInvestigationEdit(e)">
                                    <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-link p-0 tl-edit" title="Take it off the record, with a reason" @onclick="() => StartRetract(e)">
                                    <span class="bi bi-slash-circle" aria-hidden="true"></span> Retract
                                </button>
                            }
                            @CiteButton(e)
                            @TaskButton(e)
                        </div>
                        @CarriesOut(e)
                        @EntryTasks(e)
                        @if (_tlHistoryOpen.Contains(e.Id))
                        {
                            <div class="tl-history mt-2">
                                @foreach (var prior in InvestigationHistory(e))
                                {
                                    <div class="tl-history-item">
                                        <div class="small text-muted">
                                            <span class="im-badge im-b-neutral">v@(prior.Version)</span>
                                            @Users.DisplayFor(prior.CreatedBy) · @TimeDisp.Long(prior.CreatedAtUtc)
                                        </div>
                                        <div class="md-body">@((MarkupString)Html(prior.Description))</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </li>
            }
        }
    </ol>
    </div>
}

@if (_newIocFor is not null)
{
    @* INV-48: add an entity / IOC without leaving the half-written event step; it's selected where it was asked for. *@
    <div class="modal d-block im-trap" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="tl-newioc-title"
         style="background:var(--im-scrim)" @onclick="CancelNewIoc">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <form class="modal-content" @onsubmit="SaveNewIoc" @onsubmit:preventDefault>
                <div class="modal-header">
                    <h5 class="modal-title" id="tl-newioc-title">New IOC as the @(_newIocFor == "actor" ? "actor" : "target")</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelNewIoc"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-sm-4">
                            <label class="form-label small mb-0" for="tl-newioc-type">Type</label>
                            <select id="tl-newioc-type" class="form-select form-select-sm" @bind="_newIocType">
                                @foreach (var t in Ui.Options<EntityType>("EntityType"))
                                {
                                    <option value="@t">@Ui.Label(t)</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-8">
                            <label class="form-label small mb-0" for="tl-newioc-value">Value</label>
                            <input id="tl-newioc-value" class="form-control form-control-sm" @bind="_newIocValue" @bind:event="oninput" placeholder="e.g. 203.0.113.66" autofocus />
                        </div>
                        <div class="col-sm-8">
                            <label class="form-label small mb-0" for="tl-newioc-label">Label <span class="text-muted">(optional)</span></label>
                            <input id="tl-newioc-label" class="form-control form-control-sm" @bind="_newIocLabel" placeholder="e.g. Foreign ASN egress" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label small mb-0" for="tl-newioc-disp">Disposition</label>
                            <select id="tl-newioc-disp" class="form-select form-select-sm" @bind="_newIocDisposition">
                                @foreach (var d in Ui.Options<EntityDisposition>("EntityDisposition"))
                                {
                                    <option value="@d">@Ui.Label(d)</option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (_newIocError is not null)
                    {
                        <p class="text-danger small mt-2 mb-0" role="alert">@_newIocError</p>
                    }
                </div>
                <div class="modal-footer">
                    <span class="small text-muted me-auto">Added to the case's IOCs &amp; entities. An existing one with the same value is reused.</span>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelNewIoc">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(_newIocValue) || _newIocSaving)">Add and select</button>
                </div>
            </form>
        </div>
    </div>
}

@if (_corr is { Transition: { } ct } cm)
{
    @* INV-05b: correct when an already-recorded transition happened. Append-only; the recorded time stays. *@
    <div class="modal d-block im-trap" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="tl-corr-title"
         style="background:var(--im-scrim)" @onclick="CancelCorrection" @onkeydown="OnCorrectionKey">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="tl-corr-title">Correct when this happened</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelCorrection"></button>
                </div>
                <div class="modal-body">
                    <p class="small mb-2"><strong>@cm.Title</strong></p>
                    <dl class="row g-1 mb-2 small">
                        <dt class="col-4 fw-normal text-muted">Recorded</dt><dd class="col-8 mb-0 im-data">@TimeDisp.Long(cm.RecordedAtUtc ?? cm.AtUtc)</dd>
                        <dt class="col-4 fw-normal text-muted">Currently dated</dt><dd class="col-8 mb-0 im-data">@TimeDisp.Long(cm.AtUtc)</dd>
                    </dl>
                    <label class="form-label small mb-0" for="tl-corr-when">When it happened (@TimeDisp.Label)</label>
                    <DateTimeInput Past="true" id="tl-corr-when" class="form-control form-control-sm" @bind-Value="_corrWhen" />
                    <div class="mb-2"><TimeNudges @bind-Value="_corrWhen" Now="@WallClock.ToWall(DateTimeOffset.UtcNow, TimeDisp.Zone)" /></div>
                    <label class="form-label small mb-0" for="tl-corr-reason">Reason for the correction <span class="text-muted">(required)</span></label>
                    <textarea id="tl-corr-reason" class="form-control form-control-sm" rows="2" maxlength="2000"
                              placeholder="e.g. escalated on the containment call at 14:20; entered after sessions were revoked"
                              @bind="_corrReason" @bind:event="oninput"></textarea>
                    <div class="small mt-3">
                        <div class="fw-semibold mb-1">What this changes</div>
                        <ul class="mb-0 ps-3">
                            @foreach (var line in CorrectionImpact(cm, ct))
                            {
                                <li>@line</li>
                            }
                        </ul>
                    </div>
                    @if (_corrError is not null)
                    {
                        <p class="text-danger small mt-2 mb-0" role="alert">@_corrError</p>
                    }
                </div>
                <div class="modal-footer">
                    <span class="small text-muted me-auto">The original record is kept. This correction is added to the audit trail.</span>
                    <button class="btn btn-outline-secondary" @onclick="CancelCorrection">Cancel</button>
                    <button class="btn btn-primary" disabled="@(_corrWhen is null || string.IsNullOrWhiteSpace(_corrReason) || _corrSaving)"
                            @onclick="SaveCorrection">Save correction</button>
                </div>
            </div>
        </div>
    </div>
}
@if (_retract is { } rt)
{
    @* BUG-413: take a wrong entry off the record. Nothing is deleted (R3): it becomes a stub with the reason. *@
    <div class="modal d-block im-trap" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="tl-retract-title"
         style="background:var(--im-scrim)" @onclick="CancelRetract" @onkeydown="OnRetractKey">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="tl-retract-title">Retract this @(rt.Kind == TimelineKind.Event ? "step" : "entry")</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CancelRetract"></button>
                </div>
                <div class="modal-body">
                    <div class="tl-desc md-body small mb-2">@((MarkupString)(rt.Kind == TimelineKind.Event ? Inline(rt.Description) : Html(rt.Description)))</div>
                    <p class="small text-muted">
                        It leaves the record: the timeline, the report@(rt.Kind == TimelineKind.Event ? ", the attack chain and ATT&CK coverage" : "") and the counts.
                        Nothing is deleted. It stays as a struck-through entry with your reason, and in the audit trail.
                        If it's only partly wrong, edit it instead.
                    </p>
                    <label class="form-label small mb-0" for="tl-retract-reason">Why is it being retracted? <span class="text-muted">(required)</span></label>
                    <textarea id="tl-retract-reason" class="form-control form-control-sm" rows="2" maxlength="2000"
                              placeholder="e.g. logged on the wrong case; duplicate of the 14:20 step; the alert was a false positive"
                              @bind="_retractReason" @bind:event="oninput"></textarea>
                    @if (_retractError is not null)
                    {
                        <p class="text-danger small mt-2 mb-0" role="alert">@_retractError</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CancelRetract">Cancel</button>
                    <button class="btn btn-danger" disabled="@(string.IsNullOrWhiteSpace(_retractReason) || _retractSaving)" @onclick="SaveRetract">
                        <span class="bi bi-slash-circle" aria-hidden="true"></span> Retract
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // BUG-258: each entry's Markdown is rendered once per text, not on every render. The tab re-renders on every
    // keystroke in a composer (oninput) and on the workspace's 30-second tick, and a long imported record (up to 1,000
    // entries) was re-parsed each time, for every viewer. Keyed by the text, so an edit renders afresh.
    private readonly Dictionary<(Guid CaseId, bool Inline, string Text), string> _rendered = new();

    private string Html(string? text) => Rendered(text, inline: false);
    private string Inline(string? text) => Rendered(text, inline: true);

    private string Rendered(string? text, bool inline)
    {
        if (string.IsNullOrEmpty(text)) return inline ? Md.ToInlineHtml(text, CaseId) : Md.ToHtml(text, CaseId);
        var key = (CaseId, inline, text);
        if (_rendered.TryGetValue(key, out var html)) return html;
        if (_rendered.Count > 5000) _rendered.Clear();   // edits leave old texts behind; start over now and then
        return _rendered[key] = inline ? Md.ToInlineHtml(text, CaseId) : Md.ToHtml(text, CaseId);
    }

    [Parameter, EditorRequired] public Case Case { get; set; } = null!;
    [Parameter, EditorRequired] public Guid CaseId { get; set; }
    /// <summary>HR-01: outcome labels by key (admin-managed), for the Closed milestone.</summary>
    [Parameter] public IReadOnlyDictionary<string, string> OutcomeLabels { get; set; } = new Dictionary<string, string>();
    /// <summary>CAP-38 review: the case's clocks, for its standing with its regulators (the reported milestone follows it).</summary>
    [Parameter] public IncidentManager.Application.Compliance.CaseNotificationDeadlines? Notify { get; set; }
    /// <summary>HR-02: each task's latest recorded result.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, IncidentManager.Application.Cases.TaskResult> TaskResults { get; set; } = new Dictionary<Guid, IncidentManager.Application.Cases.TaskResult>();
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public string DetectionLabel { get; set; } = "SIEM";
    /// <summary>Reload the case after a timeline write so the rest of the workspace refreshes.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    /// <summary>Open the parent-owned screenshot lightbox (shared with Evidence) for an evidence id.</summary>
    [Parameter] public EventCallback<Guid> OnPreview { get; set; }
    /// <summary>Live-collab flash hooks (parent owns the flash state); render an entry's flash class / hue.</summary>
    [Parameter] public Func<Guid, string?>? FlashClass { get; set; }
    [Parameter] public Func<Guid, string?>? FlashStyle { get; set; }
    /// <summary>FR-02: parent-owned draft store (survives tab switches). The Investigation add composer stashes
    /// its unsubmitted text here on teardown and re-seeds from it on remount, so hopping tabs doesn't lose an
    /// entry. Scoped to add mode — an in-progress edit is not stashed (it would reappear as a new entry).</summary>
    [Parameter] public Dictionary<string, string>? ComposerDrafts { get; set; }

    private bool IsThirdParty => Case.Origin == CaseOrigin.ThirdParty;

    // Composer / lens state
    private TimelineKind? _tlLens = null;                  // null = All (interleaved); else focus one timeline (U-36)
    private TimelineKind _tlAddKind = TimelineKind.Event;  // which timeline the composer adds/edits
    private TimelineEntryType _tlType = TimelineEntryType.Analysis;
    private DateTime _tlWhen = DateTime.UtcNow;
    // BUG-477: the edited entry's time as shown when its edit opened, and its recorded instant (WF-68's Kept rule).
    private DateTime? _tlWhenShown;
    private DateTimeOffset? _tlWhenRecorded;
    // ST-01: an attack step's time as stated: the precision, the date (or a window's first date) and last date, and
    // for a step with no stated time, the step it comes after ("" = first).
    private TimePrecision _tlPrecision = TimePrecision.Exact;
    private TimePrecision? _tlEditPrecision;   // REV-24: the precision of the step being edited, as it was stored
    private DateTime _tlDay = DateTime.UtcNow.Date;
    private DateTime _tlUntilDay = DateTime.UtcNow.Date.AddDays(1);
    private string _tlAfter = "";
    private string _tlDesc = "";
    private string? _tlSource;

    // U-40: a screenshot pasted into the composer, staged in memory and attached as evidence on Add.
    // UX-55: the View menu (filter, clock or T+, order), and whether the view differs from the default.
    private bool _viewMenu;
    private bool ViewCustomised => FiltersActive || _tPlus || _tlOldestFirst;

    private void ViewMenuKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _viewMenu = false;
    }

    private bool _composerOpen;

    // Whether the composer is popped out (the page's data-tl-docked): set here when it's opened with the top of the timeline
    // out of view, and by the page as the reader scrolls an open composer away or comes back to the top. This is the value
    // as last set from here; IsDockedAsync asks the page.
    private bool _composerDocked;

    private async Task SetDockedAsync(bool docked)
    {
        _composerDocked = docked;
        try { await JS.InvokeVoidAsync("imMotion.setTimelineDocked", docked); }
        catch (JSException) { /* cosmetic */ }
        catch (InvalidOperationException) { /* prerendering */ }
    }

    private bool _undockAfterRender;

    private async Task<bool> IsDockedAsync()
    {
        try { return await JS.InvokeAsync<bool>("imMotion.isTimelineDocked"); }
        catch (JSException) { return _composerDocked; }
        catch (InvalidOperationException) { return false; }
    }

    private async Task<bool> ToolbarAwayAsync()
    {
        try { return await JS.InvokeAsync<bool>("imMotion.timelineToolbarAway", "tl-toolbar"); }
        catch (JSException) { return false; }
        catch (InvalidOperationException) { return false; }   // prerendering
    }

    private async Task OpenComposer()
    {
        await SetDockedAsync(await ToolbarAwayAsync());   // before the render, so it never shows inline first
        if (!_composerOpen && !ComposerHoldsText()) _tlWhen = NowWall();   // FR-50: a fresh entry starts at now
        _composerOpen = true;
    }

    // FR-50: after a save the next entry starts at now, not at the time just used (a finding logged after an 08:15 step
    // took 08:15 and read as recorded late). That time stays one click away, "Same as last", for a burst of entries
    // recorded after the fact.
    private DateTime? _lastWhen;

    private DateTime NowWall() => WallClock.ToWall(DateTimeOffset.UtcNow, TimeDisp.Zone);

    private void TimeUsed(DateTime used)
    {
        _lastWhen = used;
        if (_tlWhen == used) _tlWhen = NowWall();   // BUG-601: a time changed while the save ran is the next entry's
    }

    // Closing the docked form: an edit is let go as Cancel does (back to the draft), a new entry's text stays as its draft.
    private async Task CloseDocked()
    {
        if (_tlEditId is not null) await CancelTimelineEdit();
        _composerOpen = false;
        _undockAfterRender = true;   // once it's hidden: cleared now, the open form would drop back into the page for a frame
    }

    // After a save made in the docked form: it closes, and the reader stays where they were.
    private async Task UndockAfterSave()
    {
        if (!await IsDockedAsync()) return;
        _composerOpen = false;
        _undockAfterRender = true;
    }
    private bool _editFocusPending;
    // Open when asked, while editing, or on a case with nothing on its timeline yet (the first entry is the job).
    private bool ComposerVisible => _composerOpen || _tlEditId is not null || !Case.TimelineEntries.Any(x => x.IsCurrent);
    private byte[]? _tlShotBytes;
    // The staged screenshot's evidence id once uploaded, so a retry after a failed save links the same file
    // instead of uploading a second copy.
    private string? _tlShotName;
    private string _tlShotType = "image/png";

    private TimelineEntryType? _tlFilterType;
    private MitreTactic? _tlFilterTactic;
    private string _tlFilterSource = "";
    private bool _tlOldestFirst;   // default newest-first (most recent activity at top); oldest-first for a closed case (HR-07)
    private Guid? _orderSetFor;
    private bool _showTeamChanges;
    private bool _showRetracted;   // BUG-413
    private bool _showKillChain;    // INV-26: folded by default; the user's choice is remembered (display preferences)
    private bool _showFilters;
    // Open while a filter is set, or while milestones are hidden or only key entries show, so none is invisible.
    private bool FiltersShown => _showFilters || FiltersActive || (_tlLens is null && !_showMilestones);
    private int FilterCount => (_tlFilterType is not null ? 1 : 0) + (_tlFilterTactic is not null ? 1 : 0)
                               + (string.IsNullOrWhiteSpace(_tlFilterSource) ? 0 : 1) + (_tlFilterEntity is not null ? 1 : 0);

    protected override async Task OnInitializedAsync()
    {
        try { _showKillChain = await DisplayPrefs.GetAttackChainOpenAsync(); }
        catch (Exception) { /* a preference is a convenience; the folded default stands */ }
    }

    private async Task ToggleKillChain()
    {
        _showKillChain = !_showKillChain;
        try { await DisplayPrefs.SetAttackChainOpenAsync(_showKillChain); }
        catch (Exception) { /* not saved; the choice still holds for this view */ }
    }

    private string InvEditorId => $"inv-md-{CaseId}";
    private readonly HashSet<string> _mdEditors = new();

    // Event-step (attack narrative) add-form state
    private string _evtActorId = "";
    private string _evtTargetId = "";

    // INV-48: "+ New IOC…" in the actor / target lists opens a dialog; the selection made before it is restored on cancel.
    private const string NewIoc = "new-ioc";
    private string _actorPrev = "", _targetPrev = "";
    private string? _newIocFor;   // "actor" or "target" while the dialog is open
    private EntityType _newIocType = EntityType.IpAddress;
    private string _newIocValue = "";
    private string? _newIocLabel;
    private EntityDisposition _newIocDisposition = EntityDisposition.Unknown;
    private string? _newIocError;
    private bool _newIocSaving;
    private int _newIocOpening;   // BUG-441: counts openings, so a save can tell its dialog was cancelled or reopened

    private void AfterPartyPicked()
    {
        if (_evtActorId == NewIoc) { _newIocFor = "actor"; ResetNewIoc(); } else _actorPrev = _evtActorId;
        if (_evtTargetId == NewIoc) { _newIocFor = "target"; ResetNewIoc(); } else _targetPrev = _evtTargetId;
    }

    private void ResetNewIoc()
    {
        _newIocValue = ""; _newIocLabel = null; _newIocError = null; _newIocSaving = false; _newIocOpening++;
        // BUG-506: a type or verdict an admin has hidden showed nothing in its select while the save used it.
        _newIocType = CaseEntitiesTab.OfferedOr(_newIocType, Ui.Options<EntityType>("EntityType"));
        _newIocDisposition = CaseEntitiesTab.OfferedOr(_newIocDisposition, Ui.Options<EntityDisposition>("EntityDisposition"));
    }

    private void CancelNewIoc()
    {
        if (_newIocFor == "actor") _evtActorId = _actorPrev; else _evtTargetId = _targetPrev;
        _newIocFor = null;
        _newIocOpening++;
    }

    private async Task SaveNewIoc()
    {
        if (_newIocFor is null || string.IsNullOrWhiteSpace(_newIocValue) || _newIocSaving) return;
        _newIocSaving = true; _newIocError = null;
        // BUG-441: the side and text it was added for, read before waiting. Cancelled (or reopened) meanwhile, the entity
        // is still added but isn't selected: Cancel already put back the earlier choice.
        var (side, opening, value) = (_newIocFor, _newIocOpening, _newIocValue.Trim());
        bool Open() => opening == _newIocOpening;
        try
        {
            var r = await Cases.AddOrMatchEntityAsync(CaseId, _newIocType, value, _newIocLabel, _newIocDisposition, null, null);
            var id = r.Id.ToString();
            await OnChanged.InvokeAsync();   // reload so the new entity is in the lists before it's selected
            if (!Open()) { Toasts.Success(r.AlreadyOnCase ? $"{value} is already on this case." : $"Added {value}. It wasn't selected."); return; }
            if (side == "actor") _evtActorId = _actorPrev = id; else _evtTargetId = _targetPrev = id;
            // HR-04: an existing one is selected as it is; its recorded verdict isn't overwritten.
            if (r.AlreadyOnCase) Toasts.Info($"{value} is already on this case ({Ui.Label(r.Disposition)}). Selected it.");
            else Toasts.Success($"Added {value}");
            _newIocFor = null;
        }
        catch (Exception ex) when (!Open()) { Toasts.Error($"Couldn't add {value}. {ex.Message}"); }
        catch (Exception ex) { _newIocError = ex.Message; }
        finally { if (Open()) _newIocSaving = false; }
    }
