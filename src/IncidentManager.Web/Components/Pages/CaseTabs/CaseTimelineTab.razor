            <span class="small text-muted">saved with it, in the same save</span>
            <span class="ms-auto d-flex gap-1 flex-wrap">
                <button type="button" class="btn btn-sm btn-link p-0 me-2" @onclick="() => _fuTasks.Add(new FuTask { Kind = CurrentMode is ComposerMode.Adversary or ComposerMode.Disclosure ? TaskKind.Investigate : TaskKind.General })">
                    <span class="bi bi-plus-lg" aria-hidden="true"></span> Task</button>
                @if (!_fuQuestionOpen) { <button type="button" class="btn btn-sm btn-link p-0 me-2" @onclick="() => _fuQuestionOpen = true"><span class="bi bi-plus-lg" aria-hidden="true"></span> Question</button> }
                @if (!_fuKnownOpen) { <button type="button" class="btn btn-sm btn-link p-0 me-2" @onclick="() => _fuKnownOpen = true"><span class="bi bi-plus-lg" aria-hidden="true"></span> Line for Known</button> }
                @if (!_fuLinkOpen) { <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => _fuLinkOpen = true"><span class="bi bi-plus-lg" aria-hidden="true"></span> Link a case</button> }
                @if (!_fuAnswerOpen && CurrentMode == ComposerMode.Finding && Answerable().Count > 0)
                {
                    <button type="button" class="btn btn-sm btn-link p-0 ms-2" @onclick="() => _fuAnswerOpen = true"><span class="bi bi-plus-lg" aria-hidden="true"></span> Answers an open question</button>
                }
            </span>
        </div>
        @if (_fuAnswerOpen && CurrentMode == ComposerMode.Finding)
        {
            @* CAP-23: the finding is the answer; its question's task is completed with it as the result, in this save. *@
            var answerable = Answerable();
            <div class="im-then-row">
                <span class="bi bi-patch-question" aria-hidden="true"></span>
                <select class="form-select form-select-sm im-then-wide" aria-label="Open question this finding answers" value="@(_fuAnswer is { } chosen && answerable.Contains(chosen) ? AnswerKey(chosen) : "")" @onchange="PickAnswer">
                    <option value="">Choose the question it answers</option>
                    @foreach (var q in answerable)
                    {
                        var task = q.TaskId is { } tid ? Case.ActionItems.FirstOrDefault(t => t.Id == tid) : null;
                        <option value="@AnswerKey(q)">@QuestionLabel(q.Question)@(task is null ? " (no task yet: one is raised and done)" : string.IsNullOrWhiteSpace(task.Owner) ? "" : $" (task: {Users.DisplayFor(task.Owner)})")</option>
                    }
                </select>
                <button type="button" class="btn btn-sm btn-link p-0" aria-label="Remove the answered question" @onclick="() => { _fuAnswerOpen = false; _fuAnswer = null; }"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            </div>
        }
        @foreach (var t in _fuTasks)
        {
            var task = t;
            <div class="im-then-row">
                <span class="bi bi-check2-square" aria-hidden="true"></span>
                <input class="form-control form-control-sm" placeholder="What needs doing" maxlength="@ActionItem.MaxTitleLength" aria-label="Task"
                       @bind="task.Title" @bind:event="oninput" />
                <select class="form-select form-select-sm" aria-label="Owner" @bind="task.Owner">
                    <option value="">Unassigned</option>
                    @foreach (var (id, name) in TaskOwners()) { <option value="@id">@name</option> }
                </select>
                <select class="form-select form-select-sm" aria-label="Kind" @bind="task.Kind">
                    @foreach (var k in Enum.GetValues<TaskKind>()) { <option value="@k">@k</option> }
                </select>
                <DateInput class="form-control form-control-sm" aria-label="Due" @bind-Value="task.Due" />
                <button type="button" class="btn btn-sm btn-link p-0" aria-label="Remove this task" @onclick="() => _fuTasks.Remove(task)"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            </div>
        }
        @if (_fuQuestionOpen)
        {
            <div class="im-then-row">
                <span class="bi bi-question-circle" aria-hidden="true"></span>
                <input class="form-control form-control-sm im-then-wide" placeholder="A question for the brief" maxlength="@ActionItem.MaxTitleLength" aria-label="Question"
                       data-tag-box data-tag-refs="@TagRefLabels" @bind="_fuQuestion" @bind:event="oninput" />
                <div class="form-check small mb-0">
                    <input class="form-check-input" type="checkbox" id="fu-q-task" @bind="_fuQuestionTask" />
                    <label class="form-check-label" for="fu-q-task">and a task to answer it</label>
                </div>
                <button type="button" class="btn btn-sm btn-link p-0" aria-label="Remove the question" @onclick="() => { _fuQuestionOpen = false; _fuQuestion = null; }"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            </div>
        }
        @if (_fuKnownOpen)
        {
            <div class="im-then-row">
                <span class="bi bi-book" aria-hidden="true"></span>
                <input class="form-control form-control-sm im-then-wide im-rec" placeholder="What this establishes, in a line, for the brief's Known" maxlength="2000" aria-label="Line for Known"
                       data-tag-box data-tag-refs="@TagRefLabels" @bind="_fuKnown" @bind:event="oninput" />
                <button type="button" class="btn btn-sm btn-link p-0" aria-label="Remove the line" @onclick="() => { _fuKnownOpen = false; _fuKnown = null; }"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            </div>
        }
        @if (_fuLinkOpen)
        {
            <div class="im-then-row">
                <span class="bi bi-link-45deg" aria-hidden="true"></span>
                @if (_fuLink is { } picked)
                {
                    <span class="small">Link <code>@picked.CaseNumber</code> as</span>
                    <select class="form-select form-select-sm" aria-label="Link type" @bind="_fuLinkType">
                        <option value="@CaseLinkType.RelatedTo">Related to</option>
                        <option value="@CaseLinkType.PartOfCampaign">Part of campaign</option>
                    </select>
                    <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => _fuLink = null">Change</button>
                }
                else
                {
                    <input class="form-control form-control-sm im-then-wide" placeholder="Case number or title" aria-label="Case to link"
                           @bind="_fuLinkQuery" @bind:event="oninput" @bind:after="SearchFuLink" />
                }
                <button type="button" class="btn btn-sm btn-link p-0" aria-label="Remove the link" @onclick="RemoveFuLink"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            </div>
            @if (_fuLink is null && _fuLinkResults.Count > 0)
            {
                <div class="im-then-results">
                    @foreach (var r in _fuLinkResults)
                    {
                        <button type="button" class="btn btn-sm btn-link p-0 d-block text-start" @onclick="() => PickFuLink(r)">
                            <code>@r.CaseNumber</code> <span class="text-muted">@r.Title</span>
                        </button>
                    }
                </div>
            }
        }
        @if (SaveSummary() is { } summary)
        {
            <div class="im-then-summary"><span class="bi bi-check2" aria-hidden="true"></span> @summary.Replace("Saved together", "Saves together")</div>
        }
    </div>;

    // --- RD-07: the composer's five modes ---
    private enum ComposerMode { Finding, Decision, Adversary, Disclosure, Question, Note }
    // Question and Note aren't timeline entries; the others map onto the entry kind and type. Disclosure (third-party
    // cases only) is an event step without ATT&CK; Adversary on a third-party case is the attacker at the vendor.
    private ComposerMode? _special;
    private ComposerMode CurrentMode => _special
        ?? (_tlAddKind == TimelineKind.Event ? (IsThirdParty && !_evtAttackMode ? ComposerMode.Disclosure : ComposerMode.Adversary)
            : _tlType == TimelineEntryType.Decision ? ComposerMode.Decision : ComposerMode.Finding);
    private bool _editorMentions;
    private IReadOnlyList<IncidentManager.Application.Abstractions.UserSummary> _mentionable = [];
    private Guid _mentionsFor;
    private readonly LoadSequence _mentionLoad = new();
    private string? _question;
    private bool _questionTask = true;

    // Event steps and questions are one-line fields: inline Markdown, and [[tags]] typed as in the brief.
    private readonly Dictionary<string, string> _tagRefs = new(StringComparer.Ordinal);

    // BUG-450: the labels Tagged resolves from _tagRefs first, for the boxes' data-tag-refs (text-box.js inserts a pick
    // with one of those names as its link, so it isn't saved as a link to that other target).
    private string TagRefLabels => IncidentManager.Application.Content.TagText.RefLabels(_tagRefs.Keys);

    private string? Tagged(string? text) =>
        IncidentManager.Application.Content.TagText.FromEditable(text, _tagRefs, Case.Entities.Select(x => (x.Id, x.Label, x.Value)));

    // Says the design where the text is typed: one line, inline formatting only, and why.
    private static RenderFragment OneLineHint(string where) => __builder =>
    {
        <div id="tl-oneline-hint" class="form-text im-oneline-hint">
            <strong>One line.</strong> <code>**bold**</code>, <code>*italic*</code>, <code>`code`</code>, links and
            <code>[[</code> to tag an entity work; lists and headings don't, so it reads as one line in @where.
        </div>
    };
    private bool _saving;

    private IEnumerable<(ComposerMode Mode, string Icon, string Label)> Modes()
    {
        yield return (ComposerMode.Finding, "bi-search", "Finding");
        if (DecisionOffered) yield return (ComposerMode.Decision, "bi-signpost-split", "Decision");   // C16
        yield return (ComposerMode.Adversary, "bi-lightning", "Attack step");   // FR-56: was "Adversary step" on our own cases
        if (IsThirdParty) yield return (ComposerMode.Disclosure, "bi-megaphone", "Disclosure milestone");
        yield return (ComposerMode.Question, "bi-question-circle", "Question");
        yield return (ComposerMode.Note, "bi-journal-text", "Working note");
    }

    private void SetMode(ComposerMode m)
    {
        _special = m is ComposerMode.Question or ComposerMode.Note ? m : null;
        switch (m)
        {
            case ComposerMode.Adversary:
            case ComposerMode.Disclosure:
                _tlAddKind = TimelineKind.Event;
                _evtAttackMode = m == ComposerMode.Adversary;
                break;
            case ComposerMode.Decision:
                _tlAddKind = TimelineKind.Investigation;
                _tlType = TimelineEntryType.Decision;
                break;
            default:
                _tlAddKind = TimelineKind.Investigation;
                if (_tlType == TimelineEntryType.Decision) _tlType = OfferedType(TimelineEntryType.Analysis);   // BUG-478
                break;
        }
    }

    private async Task AddQuestion()
    {
        if (string.IsNullOrWhiteSpace(_question) || _saving) return;
        _saving = true;
        try
        {
            var sent = _question;
            await Cases.AddOpenQuestionAsync(CaseId, Tagged(sent) ?? "", _questionTask);
            _question = DraftText.ClearIfUnchanged(_question, sent, null);   // BUG-601: what was typed meanwhile stays
            await OnChanged.InvokeAsync();
            Toasts.Success(_questionTask ? "Question added to the brief, with a task to answer it" : "Question added to the brief");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
        finally { _saving = false; }
    }

    private async Task AddNote()
    {
        if (_saving) return;
        _saving = true;   // WF-101: before the editor calls, which yield to a second Ctrl+Enter or click
        string body;
        string[] mentions = [];
        try
        {
            try { body = await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId); }
            catch (JSException) { return; }
            if (string.IsNullOrWhiteSpace(body)) return;
            try { mentions = await JS.InvokeAsync<string[]>("markdownEditor.getMentions", InvEditorId); } catch (JSException) { }
            await Cases.AddNoteAsync(CaseId, body, mentions);
            ComposerDrafts?.Remove(InvEditorId);
            await ClearEditorIfUnchanged(body);   // BUG-601
            await OnChanged.InvokeAsync();
            Toasts.Success(mentions.Length > 0 ? $"Working note saved; {IncidentManager.Application.Common.Plural.Of(mentions.Length, "person", "people")} emailed" : "Working note saved");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
        finally { _saving = false; }
    }

    // The case's entities as inline "[[" tag candidates ({id, value, hint}) for the Investigation editor.
    private object[] EntityCandidates =>
        Case.Entities
            .Select(e => (object)new
            {
                id = e.Id.ToString(),
                value = string.IsNullOrWhiteSpace(e.Label) ? e.Value : e.Label!,
                hint = Ui.Label(e.Type)   // the display name ("IP address"), not the enum identifier
            })
            .ToArray();

    private async Task OpenNotesNow()
    {
        // BUG-534: an open entry edit isn't left by a lens switch (BUG-578: the switch refuses), so the 'n' shortcut or a
        // link to a note says so, as JumpTo does. Already on the notes lens, 'n' just puts the composer in Working note
        // mode. Either way the request is let go: left set, it switched to the notes lens on a later render.
        if (_tlEditId is not null) Toasts.Info(EditSlot.Refusal(EditWhat));
        else if (!_notesOnly) SwitchToNotes();
        else if (AutofocusComposer && _notesList is not { IsEditing: true }) SetMode(ComposerMode.Note);   // BUG-552: declined
        await OnOpenNotesHandled.InvokeAsync();
        StateHasChanged();
    }

    /// <summary>Ctrl/⌘+Enter from the parent's hotkey dispatcher — submit whichever composer is active. BUG-602: a working
    /// note edited in place has its own keys (.im-own-keys, CaseNotesTab), so this is never that edit's: handing it the
    /// composer's Ctrl+Enter saved the note being edited instead of the note typed in the composer.</summary>
    public async Task SubmitAsync()
    {
        if (!CanEdit) return;
        if (_newIocFor is not null || _corr is not null || _retract is not null) return;   // BUG-328: this tab's own dialog is open
        if (_tlEditId is not null)
        {
            if (_tlAddKind == TimelineKind.Event) await SaveEventEdit(); else await SaveInvestigationEdit();
        }
        else if (_special == ComposerMode.Question) await AddQuestion();
        else if (_special == ComposerMode.Note) await AddNote();
        else if (_tlAddKind == TimelineKind.Event) await AddEventStep();
        else await AddTimeline();
    }

    // CAP-26: the largest file the composer holds until Add (it's kept in memory, so less than the Evidence tab's chunked,
    // resumable upload takes); never more than the evidence limit. A screenshot keeps its 15 MB.
    private const long MaxShotBytes = 15 * 1024 * 1024;
    private const long MaxComposerFileBytes = 50 * 1024 * 1024;
    private long MaxFileBytes => Math.Min(MaxComposerFileBytes, Evidence.Limits.MaxUploadBytes);

    // CAP-26: staged as it came: an image keeps the screenshot path; anything else is cited by the entry. CAP-26 review: an
    // image by its bytes, the raster set the inline endpoint renders (ImageSniffer: PNG, JPEG, GIF, WebP). An SVG, HEIC or
    // TIFF showed as a broken thumbnail and skipped the duplicate check; it's a cited file now.
    private bool _tlShotIsRaster;
    private bool TlShotIsFile => !_tlShotIsRaster;

    // A type the browser says the screenshot path takes (its 15 MB limit applies); the bytes decide in the end.
    private static bool ClaimsRaster(string contentType) =>
        contentType.ToLowerInvariant() is "image/png" or "image/jpeg" or "image/jpg" or "image/gif" or "image/webp";

    private async Task OnTimelinePasted(InputFileChangeEventArgs e)
    {
        // CAP-26 review: an entry being edited takes no file (its save doesn't attach one), so a drop or paste is refused
        // with a word rather than staged out of sight for the next entry.
        if (_tlEditId is not null)
        {
            Toasts.Info("An entry being edited can't take a file. Save or cancel the edit and attach it to a new entry, or upload it on the Evidence tab.");
            return;
        }
        _composerOpen = true; // a pasted screenshot is staged in the form, so show it
        // CAP-26: one file per entry (a drop can carry several; the first is taken). B2 review: however many (BUG-341:
        // GetMultipleFiles threw past 50, outside any catch, and the tab went with it).
        var (f, count) = DroppedFiles.First(e);
        if (f is null) return;
        var image = ClaimsRaster(f.ContentType);
        // WF-31: what the save would refuse is refused before any byte is sent.
        var max = image ? MaxShotBytes : MaxFileBytes;
        if (f.Size > max)
        {
            Toasts.Error(image ? "That image is larger than 15 MB. Upload it on the Evidence tab."
                : $"“{f.Name}” is larger than {EvidenceRoom.Size(max)}, the most the timeline attaches. Upload it on the Evidence tab, then cite it.");
            return;
        }
        if (f.Name.Length > EvidenceService.MaxFileNameLength)
        {
            Toasts.Error($"That file name is longer than {EvidenceService.MaxFileNameLength} characters. Rename the file and attach it again.");
            return;
        }
        try
        {
            await using var s = f.OpenReadStream(max);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var raster = bytes.Length <= MaxShotBytes ? ImageSniffer.RasterContentType(bytes.AsSpan(0, Math.Min(12, bytes.Length))) : null;
            _tlShotBytes = bytes;
            _tlShotName = f.Name;
            _tlShotIsRaster = raster is not null;
            _tlShotType = raster ?? (string.IsNullOrWhiteSpace(f.ContentType) ? "application/octet-stream" : f.ContentType);
            if (count > 1)
                Toasts.Info($"An entry takes one file, so “{f.Name}” is attached. Upload the others on the Evidence tab.");
        }
        catch (Exception)
        {
            Toasts.Error(image ? "Couldn't read the pasted image. Try again, or upload it on the Evidence tab (15 MB max)."
                : "Couldn't read that file. Try again, or upload it on the Evidence tab.");
            ClearTimelineShot();
        }
    }

    private void ClearTimelineShot() { _tlShotBytes = null; _tlShotName = null; }

    // BUG-483 sibling: after a save, clears the screenshot it took, not one pasted while it was saving (that one was
    // cleared too, and lost without a word).
    private void ClearTimelineShot(byte[]? saved) { if (ReferenceEquals(_tlShotBytes, saved)) ClearTimelineShot(); }

    private string TlShotDataUri() =>
        _tlShotBytes is null ? "" : $"data:{_tlShotType};base64,{Convert.ToBase64String(_tlShotBytes)}";

    // WF-31: the staged screenshot goes with the entry, stored as hashed, chain-of-custody evidence in the same save, so a
    // refused entry leaves no evidence behind.
    // CAP-26: a file that isn't an image goes the same way, and the entry cites it.
    private CaseService.Screenshot? TimelineShot() => _tlShotBytes is null ? null
        : TlShotIsFile ? new CaseService.Screenshot(_tlShotName ?? "attached-file", _tlShotType, _tlShotBytes, CaseService.AttachedFromTimeline)
        : new CaseService.Screenshot(_tlShotName ?? "pasted-screenshot.png", _tlShotType, _tlShotBytes);

    // CAP-26: what the save's toast says it took with it.
    private string WithShot(string what, bool withShot, bool asFile, string? name) =>
        !withShot ? what : asFile ? $"{what}, citing {name}" : $"{what} with screenshot";

    // BUG-14: one save at a time. A double-click, or Ctrl+Enter and a click, used to save twice.
    private bool _inFlight;

    private async Task AddTimeline()
    {
        if (_inFlight) return;
        _inFlight = true;
        try { await AddTimelineCore(); }
        finally { _inFlight = false; }
    }

    private async Task AddTimelineCore()
    {
        try { _tlDesc = await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId); }
        catch (JSException) { /* editor not mounted; fall back to bound value */ }

        if (string.IsNullOrWhiteSpace(_tlDesc)) return;
        if (IsDecision && string.IsNullOrWhiteSpace(_decWhy)) { Toasts.Error("Record why the decision was made."); return; }
        if (_fuAnswerOpen && CurrentMode == ComposerMode.Finding && _fuAnswer is null)
        { Toasts.Error("Choose the open question this finding answers, or remove it."); return; }   // CAP-23
        var whenUtc = KeptWhenUtc();   // C3: nothing recorded for a new entry, so as typed
        var withShot = _tlShotBytes is not null;
        var (shotIsFile, shotName) = (TlShotIsFile, _tlShotName);   // CAP-26: for the toast
        var shot = _tlShotBytes;   // BUG-483 sibling: one pasted while this saves stays staged for the next entry
        // BUG-601: what was sent, so only that is cleared after the save; text typed while it ran stays.
        var (sent, sentSource, sentDecision) = (_tlDesc, _tlSource, (_decWhy, _decOptions, _decBy));
        var sentWhen = _tlWhen;
        try
        {
            await Cases.AddTimelineEntryAsync(CaseId, TimelineKind.Investigation, _tlType, whenUtc, sent, sentSource,
                decision: Decision(), followUps: FollowUps(), screenshot: TimelineShot());
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error($"Couldn't add the timeline entry. {ex.Message}");
            // CAP-23: a question answered or followed up meanwhile: reload, so the picker shows it as it now stands. The
            // composer's text stays in its editor.
            // The pick is let go (the refusal says so; its row stays open, and the save waits for a new pick).
            if (_fuAnswer is not null && ex is InvalidOperationException)
            {
                _fuAnswer = null;
                await OnChanged.InvokeAsync();
            }
            return;
        }
        var saved = SaveSummary();
        _tlDesc = DraftText.ClearIfUnchanged(_tlDesc, sent);
        _tlSource = DraftText.ClearIfUnchanged(_tlSource, sentSource, null);
        ClearTimelineShot(shot); ClearDecisionIfUnchanged(sentDecision); ResetFollowUps();
        TimeUsed(sentWhen);
        ComposerDrafts?.Remove(InvEditorId); // FR-02: the draft is now saved
        await OnChanged.InvokeAsync();
        Toasts.Success(saved ?? WithShot("Timeline entry added", withShot, shotIsFile, shotName));
        await UndockAfterSave();
        await ClearEditorIfUnchanged(sent);
    }

    // BUG-601: the composer's editor is emptied after a save only while it still holds what was saved; emptied
    // regardless, it lost what was typed in it while the save ran.
    private async Task ClearEditorIfUnchanged(string sent)
    {
        try
        {
            var now = await JS.InvokeAsync<string?>("markdownEditor.getValue", InvEditorId);
            if (now is null || string.Equals(now, sent, StringComparison.Ordinal))
                await JS.InvokeVoidAsync("markdownEditor.setValue", InvEditorId, "");
        }
        catch (JSException) { /* best effort */ }
    }

    // Event timeline: an adversary action — ATT&CK tactic(s) + actor→target attribution.
    private async Task AddEventStep()
    {
        if (_inFlight) return;
        _inFlight = true;
        try { await AddEventStepCore(); }
        finally { _inFlight = false; }
    }

    private async Task AddEventStepCore()
    {
        if (string.IsNullOrWhiteSpace(_tlDesc)) return;
        var disclosure = IsThirdParty && !_evtAttackMode;
        var withShot = _tlShotBytes is not null;
        var (shotIsFile, shotName) = (TlShotIsFile, _tlShotName);   // CAP-26: for the toast
        var shot = _tlShotBytes;   // BUG-483 sibling
        // BUG-601: what was sent, so only that is cleared after the save; what was typed or picked while it ran stays.
        var (sent, sentSource, sentTechnique, sentActor, sentTarget, sentTactic) =
            (_tlDesc, _tlSource, _evtTechnique, _evtActorId, _evtTargetId, _evtTactic);
        var (sentWhen, sentExact) = (_tlWhen, _tlPrecision == TimePrecision.Exact);
        try
        {
            if (disclosure)
            {
                // REV-24: as stated in the composer (a date, a window), like an attack step.
                await Cases.AddEventStepAsync(CaseId, StepWhenUtc(), Array.Empty<MitreTactic>(), null, null, null,
                    Tagged(sent)!, sentSource, type: _evtStage, followUps: FollowUps(), timing: Timing(), screenshot: TimelineShot());
            }
            else
            {
                Guid? actor = Guid.TryParse(sentActor, out var a) ? a : null;
                Guid? target = Guid.TryParse(sentTarget, out var t) ? t : null;
                var technique = string.IsNullOrWhiteSpace(sentTechnique) ? null : sentTechnique;
                var added = await Cases.AddEventStepAsync(CaseId, StepWhenUtc(), EvtTacticSet(), technique, actor, target, Tagged(sent)!, sentSource,
                    followUps: FollowUps(), environment: StepWhere, timing: Timing(), screenshot: TimelineShot());
                // A run of steps without times is entered in order: the next one comes after this one.
                if (_tlPrecision == TimePrecision.NotStated) _tlAfter = added.ToString();
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
            return;
        }
        _tlDesc = DraftText.ClearIfUnchanged(_tlDesc, sent);
        _tlSource = DraftText.ClearIfUnchanged(_tlSource, sentSource, null);
        _evtTechnique = DraftText.ClearIfUnchanged(_evtTechnique, sentTechnique);
        if (_evtTactic == sentTactic) _evtTactic = MitreTactic.Unspecified;
        _evtActorId = DraftText.ClearIfUnchanged(_evtActorId, sentActor);
        _evtTargetId = DraftText.ClearIfUnchanged(_evtTargetId, sentTarget);
        if (_evtActorId.Length == 0) _actorPrev = "";
        if (_evtTargetId.Length == 0) _targetPrev = "";
        _evtOtherTactics = [];
        ClearTimelineShot(shot);
        if (sentExact) TimeUsed(sentWhen);
        await OnChanged.InvokeAsync();
        var savedStep = SaveSummary();
        ResetFollowUps();
        var what = disclosure ? "Disclosure milestone" : IsThirdParty ? (_evtOurs ? "Attack step in our environment" : "Attack step at the vendor") : "Attack step";
        Toasts.Success(savedStep ?? WithShot($"{what} added", withShot, shotIsFile, shotName));
        await UndockAfterSave();
    }

    // A lens button: switch the timeline lens (All / Event / Investigation).
    private void SwitchLens(TimelineKind? lens)
    {
        if (LensSwitchRefused(toNotes: false)) return;
        ShowLens(lens);
    }

    // BUG-578: a lens button with an entry edit open used to cancel it, losing what was typed (the lens also sets what the
    // composer adds); off the Working notes lens it unmounted a note being edited there. Both are refused now, as a jump
    // is (JumpTo).
    private bool LensSwitchRefused(bool toNotes)
    {
        if (_tlEditId is not null)
        {
            Toasts.Info(EditSlot.Refusal(EditWhat));
            return true;
        }
        return !toNotes && NoteEditKeepsNotes();
    }

    // Show a lens, clearing kind-specific filters that no longer apply. Callers have refused over an open edit.
    private void ShowLens(TimelineKind? lens)
    {
        _decOnly = false;
        _keyOnly = false;
        _notesOnly = false;
        _tlLens = lens;
        if (lens is { } k) { _tlAddKind = k; _special = null; }   // a focused lens drives what the composer adds
        ClearTimelineFilters();
    }

    // In the All lens the composer serves both timelines; pick which one to add to.
    private void SetAddKind(TimelineKind kind) => _tlAddKind = kind;

    // BUG-578: Edit on another entry while one is open is refused with the standard toast; it replaced the open edit and
    // what was typed in it. Edit on the open one again does nothing (it re-seeded over the typing).
    private const string EditWhat = "entry";

    private bool RefusesAnotherEdit(TimelineEntry e)
    {
        if (!_tlEdit.IsOpen) return false;
        if (!_tlEdit.IsOpenFor(e.Id)) Toasts.Info(EditSlot.Refusal(EditWhat));
        return true;
    }

    // Load an Event step into the composer for an in-place correction.
    private async Task StartEventEdit(TimelineEntry e)
    {
        if (RefusesAnotherEdit(e)) return;
        await StashDraftAsync();
        if (!_tlEdit.TryOpen(e.Id, Toasts, EditWhat)) return;   // another Edit opened one while the draft was read
        _special = null;
        _tlAddKind = TimelineKind.Event;
        await SetDockedAsync(await ToolbarAwayAsync());
        _editFocusPending = true;   // BUG-410
        _evtAttackMode = IsThirdParty && IsAttackStep(e); // edit a vendor attack step as one, a milestone as one
        _evtOurs = e.Environment == StepEnvironment.Ours;
        _tlEditStamp = e.RowHash ?? "";   // BUG-196
        _tlReason = null;
        _tlWhen = WallClock.ToWall(e.OccurredAtUtc, TimeDisp.Zone);
        (_tlWhenShown, _tlWhenRecorded) = (_tlWhen, e.OccurredAtUtc);   // BUG-477
        _evtActorId = e.ActorEntityId?.ToString() ?? "";
        _evtTargetId = e.TargetEntityId?.ToString() ?? "";
        _actorPrev = _evtActorId; _targetPrev = _evtTargetId;
        _evtTechnique = e.TechniqueId ?? "";
        _evtTactic = e.Tactics.Select(t => t.Tactic).OrderBy(Ui.TacticRank).FirstOrDefault();   // BUG-507: the first chip shown
        _evtOtherTactics = e.Tactics.Select(t => t.Tactic).Where(t => t != _evtTactic && t != MitreTactic.Unspecified).ToArray();
        _evtStage = e.Type;   // E-32: vendor-disclosure stage for a third-party case
        _tlPrecision = e.OccurredPrecision ?? TimePrecision.Exact;
        _tlEditPrecision = _tlPrecision;
        // A stated date is kept as a UTC calendar date; an exact time's date is the one the user sees (BUG-34), so
        // switching the edit to Date only starts from it.
        _tlDay = _tlPrecision == TimePrecision.Exact ? _tlWhen.Date : e.OccurredAtUtc.UtcDateTime.Date;
        _tlUntilDay = e.OccurredUntilUtc is { } until ? until.UtcDateTime.Date : _tlDay.AddDays(1);
        var chain = AttackSteps();
        var at = chain.FindIndex(x => x.Id == e.Id);
        _tlAfter = at > 0 ? chain[at - 1].Id.ToString() : "";
        _tagRefs.Clear();
        _tlDesc = IncidentManager.Application.Content.TagText.ToEditable(e.Description, _tagRefs) ?? "";
        _tlSource = e.Source;
        _tlEditSeed = TimelineEditValues();   // BUG-611
    }

    private async Task SaveEventEdit()
    {
        if (_inFlight) return;
        _inFlight = true;
        try { await SaveEventEditCore(); }
        finally { _inFlight = false; }
    }

    private async Task SaveEventEditCore()
    {
        if (_tlEdit.Current is not { } edit || string.IsNullOrWhiteSpace(_tlDesc)) return;
        var id = edit.Key;
        // Captured before CancelTimelineEdit resets the composer mode, so the toast names what was edited.
        var savedLabel = IsThirdParty && !_evtAttackMode ? "Disclosure milestone updated" : "Attack step updated";
        try
        {
            if (IsThirdParty && !_evtAttackMode)
            {
                // BUG-122: a milestone keeps its time as stated (a date, a window) through an edit.
                // REV-24: a milestone with no stated time stays where it is (Timing() would put it first in the chain).
                var timing = _tlPrecision == TimePrecision.NotStated ? new StepTiming(TimePrecision.NotStated) : Timing();
                await Cases.EditEventStepAsync(CaseId, id, StepWhenUtc(), Array.Empty<MitreTactic>(), null, null, null,
                    Tagged(_tlDesc)!, _tlSource, _tlReason, type: _evtStage, timing: timing, expectedStamp: _tlEditStamp);
            }
            else
            {
                Guid? actor = Guid.TryParse(_evtActorId, out var a) ? a : null;
                Guid? target = Guid.TryParse(_evtTargetId, out var t) ? t : null;
                var technique = string.IsNullOrWhiteSpace(_evtTechnique) ? null : _evtTechnique;
                await Cases.EditEventStepAsync(CaseId, id, StepWhenUtc(), EvtTacticSet(), technique, actor, target, Tagged(_tlDesc)!, _tlSource, _tlReason,
                    environment: StepWhere, timing: Timing(), expectedStamp: _tlEditStamp);
            }
        }
        catch (StaleEditException ex)
        {
            Toasts.Error(ex.Message);
            if (_tlEdit.IsCurrent(edit)) await CancelTimelineEdit();   // BUG-601: not an edit opened while this ran
            await OnChanged.InvokeAsync();
            return;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
            return;
        }
        if (_tlEdit.IsCurrent(edit)) await CancelEditToRow();   // BUG-410: the step keeps its id, so go back to it
        await OnChanged.InvokeAsync();
        Toasts.Success(savedLabel);
    }

    // Load an Investigation entry into the Markdown composer to edit; saving creates a new version.
    private async Task StartInvestigationEdit(TimelineEntry e)
    {
        if (RefusesAnotherEdit(e)) return;
        await StashDraftAsync();
        if (!_tlEdit.TryOpen(e.Id, Toasts, EditWhat)) return;   // another Edit opened one while the draft was read
        _special = null;   // BUG-33: a Working note or Question composer hides the entry's type, time and source
        _tlAddKind = TimelineKind.Investigation;
        await SetDockedAsync(await ToolbarAwayAsync());
        _editFocusPending = true;   // BUG-410
        _tlReason = null;
        _tlType = e.Type;
        _tlWhen = WallClock.ToWall(e.OccurredAtUtc, TimeDisp.Zone);
        (_tlWhenShown, _tlWhenRecorded) = (_tlWhen, e.OccurredAtUtc);   // BUG-477
        _tlSource = e.Source;
        _tlDesc = e.Description;
        _decWhy = e.Rationale; _decOptions = e.OptionsConsidered; _decBy = e.DecidedBy;
        _tlEditSeed = TimelineEditValues();   // BUG-611
        try { await JS.InvokeVoidAsync("markdownEditor.setValue", InvEditorId, e.Description); }
        catch (JSException) { /* editor not mounted yet; ReconcileEditor seeds it from _tlDesc */ }
    }

    private async Task SaveInvestigationEdit()
    {
        if (_inFlight) return;   // REV-31: a second click (or Ctrl+Enter) while the first save runs
        _inFlight = true;
        try { await SaveInvestigationEditCore(); }
        finally { _inFlight = false; }
    }

    private async Task SaveInvestigationEditCore()
    {
        if (_tlEdit.Current is not { } edit) return;
        var id = edit.Key;
        var desc = _tlDesc;
        try { desc = await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId); }
        catch (JSException) { /* fall back to bound value */ }
        if (!_tlEdit.IsCurrent(edit)) return;   // BUG-601: cancelled while the editor was read (the composer is the draft's now)
        _tlDesc = desc;
        if (string.IsNullOrWhiteSpace(_tlDesc)) return;
        var whenUtc = KeptWhenUtc();
        if (IsDecision && string.IsNullOrWhiteSpace(_decWhy)) { Toasts.Error("Record why the decision was made."); return; }
        try { await Cases.EditInvestigationEntryAsync(CaseId, id, _tlType, whenUtc, _tlDesc, _tlSource, _tlReason, Decision()); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error($"Couldn't save the entry. {ex.Message}"); return; }
        if (_tlEdit.IsCurrent(edit)) await CancelTimelineEdit();   // BUG-601: not an edit opened while this ran
        await OnChanged.InvokeAsync();
        Toasts.Success("Investigation entry saved as a new version");
    }

    // BUG-410: Cancel (and a saved step) takes the user back to the entry they were editing.
    private async Task CancelEditToRow()
    {
        var id = _tlEditId;
        var docked = await IsDockedAsync();
        await CancelTimelineEdit();
        if (id is { } back && !docked) _jumpTo = $"tl-{back}";   // docked, the reader never left the row
    }

    // Leave edit mode and clear the composer. For Investigation, also blank the Markdown editor.
    private async Task CancelTimelineEdit()
    {
        var wasInvestigationEdit = _tlAddKind == TimelineKind.Investigation && _tlEditId is not null;
        await UndockAfterSave();
        _tlEdit.Close(); _tlReason = null; ClearDecision();
        _tlDesc = ""; _tlSource = null; _evtTechnique = ""; _evtActorId = ""; _evtTargetId = ""; _actorPrev = ""; _targetPrev = "";
        _evtTactic = MitreTactic.Unspecified; _evtOtherTactics = []; _evtAttackMode = false; // FR-24: back to the default disclosure composer
        _tlPrecision = TimePrecision.Exact; _tlAfter = ""; _tlEditPrecision = null;
        (_tlWhenShown, _tlWhenRecorded) = (null, null);   // BUG-477
        if (_preEditTimes is { } times && _draft is null) (_tlWhen, _tlDay, _tlUntilDay) = times;
        _preEditTimes = null;
        if (_draft is { } d)
        {
            RestoreDraft(d);
            try { await JS.InvokeVoidAsync("markdownEditor.setValue", InvEditorId, _tlDesc, ""); }   // BUG-611: unsaved
            catch (JSException) { /* not mounted; ReconcileEditor seeds it from _tlDesc */ }
        }
        else if (wasInvestigationEdit)
        {
            try { await JS.InvokeVoidAsync("markdownEditor.setValue", InvEditorId, ""); }
            catch (JSException) { /* best effort */ }
        }
        // BUG-478: an edited entry's type an admin has since hidden isn't the next new entry's (the select can't show it).
        // C16: a Decision too, when an admin has hidden it (offered, it's in the list, and the composer stays a decision).
        if (!InvestigationTypeOptions().Contains(_tlType))
            _tlType = OfferedType(TimelineEntryType.Analysis);
        // C16: likewise an edited milestone's stage that's hidden, or not a disclosure stage at all.
        _evtStage = CaseEntitiesTab.OfferedOr(_evtStage, DisclosureStages());
    }

    // BUG-35: what was being written when an edit started, put back when the edit ends (saved or cancelled).
    private sealed record ComposerDraft(TimelineKind Kind, ComposerMode? Special, TimelineEntryType Type, string Desc,
        string? Source, DateTime When, string? Why, string? Options, string? By, string Technique, string ActorId,
        string TargetId, MitreTactic Tactic, bool AttackMode, TimelineEntryType Stage, bool Ours, TimePrecision Precision,
        DateTime Day, DateTime UntilDay, string After, Dictionary<string, string> TagRefs);
    private ComposerDraft? _draft;
    // BUG-300: the composer's times before an edit loaded an old entry's: with nothing written there was no draft to put
    // back, and the next new entry defaulted to the edited entry's time (last week's, say).
    private (DateTime When, DateTime Day, DateTime UntilDay)? _preEditTimes;

    private async Task StashDraftAsync()
    {
        if (_tlEditId is not null) return;   // an edit is open (Start refuses another): its draft is already kept
        _preEditTimes = (_tlWhen, _tlDay, _tlUntilDay);   // BUG-300: kept even when there's no text to stash
        // BUG-578: the composer as it is now, before the editor is read; a second Edit click that opened an edit while
        // this waited would otherwise have its entry's fields taken as the draft.
        var draft = new ComposerDraft(_tlAddKind, _special, _tlType, _tlDesc, _tlSource, _tlWhen, _decWhy, _decOptions, _decBy,
            _evtTechnique, _evtActorId, _evtTargetId, _evtTactic, _evtAttackMode, _evtStage, _evtOurs, _tlPrecision,
            _tlDay, _tlUntilDay, _tlAfter, new Dictionary<string, string>(_tagRefs, StringComparer.Ordinal));
        var desc = _tlDesc;
        // BUG-371: only a mounted editor holds the text. In Question mode it's gone (read back into _tlDesc), and its
        // getValue is "", which dropped the Finding being written.
        if (_mdEditors.Contains(InvEditorId))
        {
            try { desc = await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId) ?? desc; }
            catch (JSException) { /* use the bound value */ }
            if (_tlEditId is not null) return;   // another Edit click opened an edit (and kept this draft) meanwhile
        }
        _draft = string.IsNullOrWhiteSpace(desc) && string.IsNullOrWhiteSpace(draft.Why) ? null : draft with { Desc = desc };
    }

    private void RestoreDraft(ComposerDraft d)
    {
        _draft = null;
        _tlAddKind = d.Kind; _special = d.Special; _tlType = d.Type; _tlDesc = d.Desc; _tlSource = d.Source; _tlWhen = d.When;
        _decWhy = d.Why; _decOptions = d.Options; _decBy = d.By;
        _evtTechnique = d.Technique; _evtActorId = d.ActorId; _evtTargetId = d.TargetId; _actorPrev = d.ActorId; _targetPrev = d.TargetId;
        _evtTactic = d.Tactic; _evtOtherTactics = []; _evtAttackMode = d.AttackMode; _evtStage = d.Stage; _evtOurs = d.Ours;
        _tlPrecision = d.Precision; _tlDay = d.Day; _tlUntilDay = d.UntilDay; _tlAfter = CurrentAfter(d.After, _tlEditId);   // BUG-442
        _tagRefs.Clear();
        foreach (var (k, v) in d.TagRefs) _tagRefs[k] = v;
    }

    private void ToggleHistory(Guid entryId)
    {
        if (!_tlHistoryOpen.Remove(entryId)) _tlHistoryOpen.Add(entryId);
    }

    // Prior versions of an Investigation entry, newest first, by walking the supersede chain.
    private List<TimelineEntry> InvestigationHistory(TimelineEntry current)
    {
        var all = Case.TimelineEntries;
        var history = new List<TimelineEntry>();
        var cursor = current.SupersedesEntryId;
        while (cursor is { } id && all.FirstOrDefault(x => x.Id == id) is { } prior)
        {
            history.Add(prior);
            cursor = prior.SupersedesEntryId;
        }
        return history;
    }

    // --- INV-10: evidence an entry cites ---
    private readonly EditSlot<Guid> _cite = new();   // the entry whose picker is open (BUG-578: one at a time)
    private readonly HashSet<Guid> _citeSel = new();
    private List<Guid> _citeOpened = [];
    private readonly InFlight _citeSaving = new();

    private List<Evidence> CitedBy(TimelineEntry e) => Case.Citations.Where(x => x.TimelineEntryId == e.Id)
        .Select(x => Case.Evidence.FirstOrDefault(ev => ev.Id == x.EvidenceId)).OfType<Evidence>()
        .OrderBy(ev => ev.OriginalFileName, StringComparer.OrdinalIgnoreCase).ToList();

    private static bool IsImage(Evidence ev) => ev.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    // --- INV-28: tasks started from an entry ---
    private Guid? _taskFor;

    // An entry's first version: what a task about it records, so the link survives edits.
    private Guid RootOf(TimelineEntry e)
    {
        var first = e;
        while (first.SupersedesEntryId is { } prior && Case.TimelineEntries.FirstOrDefault(x => x.Id == prior) is { } p) first = p;
        return first.Id;
    }

    // HR-15: an entry added or edited after the case closed says so; the record isn't locked, it's marked.
    private RenderFragment AfterClosureMark(DateTimeOffset added, DateTimeOffset lastChanged) => @<text>
        @if (Case.ClosureRecordedAtUtc is { } closed && lastChanged > closed)
        {
            <span class="tl-after-closure" title="@($"The case closed {TimeDisp.Long(closed)}; this was {(added > closed ? "added" : "edited")} {TimeDisp.Long(lastChanged)}")">
                <span class="bi bi-pencil-square" aria-hidden="true"></span> @(added > closed ? "added" : "edited") after closure
            </span>
        }
    </text>;

    // HR-08: a task result logged on the timeline says which entry (usually a decision) the task carried out.
    private RenderFragment CarriesOut(TimelineEntry e) => @<text>
        @if (e.ActionItemId is { } tid && Case.ActionItems.FirstOrDefault(t => t.Id == tid) is { About: { Kind: ActionItem.AboutEntry } about }
             && Case.TimelineEntries.FirstOrDefault(x => x.IsCurrent && RootOf(x) == about.Id) is { } origin && origin.Id != e.Id)
        {
            <div class="tl-carries small">
                <span class="bi bi-arrow-return-right" aria-hidden="true"></span>
                Carries out the @(origin.Type == TimelineEntryType.Decision ? "decision" : "entry") of
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => ScrollToEntry(origin.Id)">@TimeDisp.Short(origin.OccurredAtUtc)</button>:
                <span class="text-muted">@IncidentManager.Application.Cases.TaskResults.Excerpt(IncidentManager.Application.Content.RichText.ToText(origin.Description), 100)</span>
            </div>
        }
    </text>;

    private async Task ScrollToEntry(Guid id)
    {
        try { await JS.InvokeVoidAsync("imMotion.scrollToId", $"tl-{id}"); } catch (JSException) { /* motion is optional */ }
    }

    // HR-17: a task started from a decision begins as the decision itself ("Disable j.morales, revoke …"), to be
    // trimmed into the action; anything else starts blank.
    private static string? DecisionTaskTitle(TimelineEntry e)
    {
        if (e.Type != TimelineEntryType.Decision) return null;
        var text = IncidentManager.Application.Content.RichText.ToText(e.Description).ReplaceLineEndings(" ").Trim();
        return IncidentManager.Application.Common.TextFit.Cap(text, ActionItem.MaxTitleLength);   // C12
    }

    private RenderFragment TaskButton(TimelineEntry e) => @<text>
        @if (CanEdit)
        {
            <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => _taskFor = _taskFor == e.Id ? null : e.Id">
                <span class="bi bi-plus-lg" aria-hidden="true"></span> Task
            </button>
        }
    </text>;

    private RenderFragment EntryTasks(TimelineEntry e) => @<text>
        @{
            var about = $"{ActionItem.AboutEntry}:{RootOf(e)}";
            var tasks = Case.ActionItems.Where(t => t.AboutRef == about).OrderByDescending(t => t.IsOpen).ThenBy(t => t.CreatedAtUtc).ToList();
        }
        @if (tasks.Count > 0)
        {
            <div class="tl-tasks" aria-label="@(e.Type == TimelineEntryType.Decision ? "Tasks carrying out this decision" : "Tasks about this entry")">
                @* RD-13: a decision says what carried it out. *@
                @if (e.Type == TimelineEntryType.Decision) { <span class="tl-tasks-h">Carried out by</span> }
                @foreach (var t in tasks)
                {
                    <span class="tl-task @(t.IsOpen ? "" : "tl-task-done")" title="@(t.IsOpen ? "Open task" : "Done")">
                        <span class="bi @(t.IsOpen ? "bi-square" : "bi-check2-square")" aria-hidden="true"></span> @t.Title
                        @if (t.Status == ActionItemStatus.Done && t.CompletedAtUtc is { } doneAt)
                        {
                            <span class="text-muted">&nbsp;· done @TimeDisp.Short(doneAt)@(t.CompletedBy is { } by ? $" by {Users.DisplayFor(by)}" : "")</span>
                        }
                        else if (!string.IsNullOrWhiteSpace(t.Owner)) { <span class="text-muted">· @Users.DisplayFor(t.Owner)</span> }
                    </span>
                    @* HR-02: what the task found or did, right under the entry it follows up. *@
                    @if (t.Status == ActionItemStatus.Done && TaskResults.TryGetValue(t.Id, out var res))
                    {
                        <span class="tl-task-result" title="@res.Text">@IncidentManager.Application.Cases.TaskResults.Excerpt(res.Text)</span>
                    }
                }
            </div>
        }
        @if (_taskFor == e.Id)
        {
            <QuickTask CaseId="CaseId" About="@about" Placeholder="A task about this entry" InitialTitle="@DecisionTaskTitle(e)"
                       OnDone="async () => { _taskFor = null; await OnChanged.InvokeAsync(); }" OnCancel="() => _taskFor = null" />
        }
    </text>;

    private RenderFragment CiteButton(TimelineEntry e) => @<text>
        @if (CanEdit && Case.Evidence.Any(x => !x.IsWithdrawn || Case.Citations.Any(c => c.TimelineEntryId == e.Id && c.EvidenceId == x.Id)))
        {
            <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => StartCite(e)">
                <span class="bi bi-paperclip" aria-hidden="true"></span> Cite evidence
            </button>
        }
    </text>;

    private RenderFragment CitedEvidence(TimelineEntry e) => @<text>
        @{ var cited = CitedBy(e); }
        @if (cited.Count > 0)
        {
            <div class="tl-cites" aria-label="Evidence cited">
                @foreach (var ev in cited)
                {
                    @if (ev.IsWithdrawn)
                    {
                        @* CAP-21: cited before it was withdrawn: struck through, and its panel says why. *@
                        <a class="tl-cite tl-cite-withdrawn" href="cases/@CaseId?evidence=@ev.Id" title="@ev.OriginalFileName was withdrawn from this case">
                            <span class="bi bi-slash-circle" aria-hidden="true"></span> @ev.OriginalFileName <span class="visually-hidden">(withdrawn)</span>
                        </a>
                    }
                    else if (IsImage(ev))
                    {
                        <button type="button" class="tl-cite" @onclick="() => OnPreview.InvokeAsync(ev.Id)" title="Preview @ev.OriginalFileName">
                            <span class="bi bi-image" aria-hidden="true"></span> @ev.OriginalFileName
                        </button>
                    }
                    else
                    {
                        @* RD-06: a cited file opens its panel (preview, integrity, custody) instead of downloading. *@
                        <a class="tl-cite" href="cases/@CaseId?evidence=@ev.Id" title="Open @ev.OriginalFileName">
                            <span class="bi bi-paperclip" aria-hidden="true"></span> @ev.OriginalFileName
                        </a>
                    }
                }
            </div>
        }
        @if (_cite.IsOpenFor(e.Id))
        {
            @* BUG-425: im-own-keys: Ctrl/Cmd+Enter in the picker does nothing, rather than add the composer's entry. *@
            <div class="tl-cite-pick border rounded p-2 mt-2 bg-body-tertiary im-own-keys">
                <div class="small fw-semibold mb-1">Evidence that supports this entry</div>
                @* CAP-21: a withdrawn file isn't offered; one the entry already cites is listed so it can be taken off. *@
                @foreach (var ev in Case.Evidence.Where(x => !x.IsWithdrawn || _citeOpened.Contains(x.Id)).OrderByDescending(x => x.CreatedAtUtc))
                {
                    <div class="form-check small">
                        <input class="form-check-input" type="checkbox" id="@($"cite-{e.Id}-{ev.Id}")" checked="@_citeSel.Contains(ev.Id)"
                               @onchange="x => ToggleCite(ev.Id, (bool)(x.Value ?? false))" />
                        <label class="form-check-label" for="@($"cite-{e.Id}-{ev.Id}")">
                            <span class="@(ev.IsWithdrawn ? "tl-cite-withdrawn" : "")">@ev.OriginalFileName</span>@(ev.IsWithdrawn ? " (withdrawn)" : "") <span class="text-muted">· @TimeDisp.Short(ev.CreatedAtUtc)@(string.IsNullOrWhiteSpace(ev.Description) ? "" : $" · {ev.Description}")</span>
                        </label>
                    </div>
                }
                <div class="d-flex gap-2 justify-content-end mt-1">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="_cite.Close">Cancel</button>
                    <button class="btn btn-sm btn-primary" disabled="@_citeSaving.Busy" @onclick="SaveCite">Save</button>
                </div>
            </div>
        }
    </text>;

    private void StartCite(TimelineEntry e)
    {
        if (!_cite.TryOpen(e.Id, Toasts, "evidence picks")) return;   // BUG-578: another entry's picks stay
        _citeSel.Clear();
        foreach (var ev in CitedBy(e)) _citeSel.Add(ev.Id);
        _citeOpened = [.. _citeSel];   // BUG-297
    }

    private void ToggleCite(Guid id, bool on) { if (on) _citeSel.Add(id); else _citeSel.Remove(id); }

    // BUG-603: one save at a time (a double-click saved twice). BUG-601: the save closes the picker it saved, not one
    // opened on another entry while it ran.
    private Task SaveCite() => _citeSaving.Run(SaveCiteCore);

    private async Task SaveCiteCore()
    {
        if (_cite.Current is not { } s) return;
        try
        {
            await Cases.CiteEvidenceAsync(CaseId, s.Key, _citeSel.ToList(), openedWith: _citeOpened);
            _cite.CloseIf(s);
            await OnChanged.InvokeAsync();
            Toasts.Success("Evidence cited");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); }
    }

    // --- INV-06: decision entries ---
    private string? _decWhy;
    private string? _decOptions;
    private string? _decBy;

    // HR-17: who can be named as having decided: the case team (by role) first, then the rest of the directory.
    private IEnumerable<string> DeciderNames()
    {
        var team = Case.Assignments.Select(a => Users.DisplayFor(a.UserId)).Distinct().ToList();
        return team.Concat(Users.All().Select(u => u.DisplayName).Where(n => !team.Contains(n)).OrderBy(n => n)).Distinct();
    }

    private bool IsDecision => _tlAddKind == TimelineKind.Investigation && _tlType == TimelineEntryType.Decision;

    private CaseService.DecisionDetails? Decision() =>
        IsDecision ? new CaseService.DecisionDetails(_decWhy ?? "", _decOptions, _decBy) : null;

    private void ClearDecision() { _decWhy = null; _decOptions = null; _decBy = null; }

    // BUG-601: after a save, each of the decision's fields is cleared only if it's still what was sent.
    private void ClearDecisionIfUnchanged((string? Why, string? Options, string? By) sent)
    {
        _decWhy = DraftText.ClearIfUnchanged(_decWhy, sent.Why, null);
        _decOptions = DraftText.ClearIfUnchanged(_decOptions, sent.Options, null);
        _decBy = DraftText.ClearIfUnchanged(_decBy, sent.By, null);
    }

    // Catch-up aids: after containment, entries are often recorded in a burst. FR-50: each new entry starts at now;
    // "Same as last" puts back the time of the entry just added, and these step it back or forward, so a busy hour
    // can be rebuilt quickly.
    private RenderFragment TimeNudges() => @<text>
        <div class="tl-nudges" role="group" aria-label="Adjust the time">
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _tlWhen = NowWall()">Now</button>
            @if (_lastWhen is { } last && last != _tlWhen)
            {
                <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _tlWhen = last"
                        title="The time of the entry you just added">Same as last (@(last.Date == NowWall().Date ? last.ToString("HH:mm") : last.ToString("yyyy-MM-dd HH:mm")))</button>
            }
            @* BUG-480: Shifted stops at year 1 and 9999; AddHours threw there and the tab showed its error fallback. *@
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _tlWhen = IncidentManager.Web.Components.Shared.TimeNudges.Shifted(_tlWhen, TimeSpan.FromHours(-1))" aria-label="One hour earlier">&minus;1 h</button>
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _tlWhen = IncidentManager.Web.Components.Shared.TimeNudges.Shifted(_tlWhen, TimeSpan.FromMinutes(-15))" aria-label="15 minutes earlier">&minus;15 min</button>
            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _tlWhen = IncidentManager.Web.Components.Shared.TimeNudges.Shifted(_tlWhen, TimeSpan.FromMinutes(15))" aria-label="15 minutes later">+15 min</button>
        </div>
    </text>;

    // --- ST-01: an attack step's time as stated ---

    // The attack steps in order (the attack chain).
    private List<TimelineEntry> AttackSteps() => Case.TimelineEntries
        .Where(x => x.IsCurrent && IncidentManager.Application.Cases.EventSteps.IsAttack(Case, x)).InTimelineOrder().ToList();

    // REV-24: the disclosure milestones aren't in the attack chain, so for them "Not stated" isn't placed after an attack
    // step: it's offered only for a milestone that already has no stated time, and it keeps its place.
    private RenderFragment StepWhenField(bool disclosure = false) => @<text>
        <label class="form-label small mb-0" for="tl-atk-prec">Occurred</label>
        <select id="tl-atk-prec" class="form-select form-select-sm" @bind="_tlPrecision" @bind:after="PrecisionChanged">
            <option value="@TimePrecision.Exact">Date and time (@TimeDisp.Label)</option>
            <option value="@TimePrecision.Day">Date only</option>
            <option value="@TimePrecision.Window">Between two dates</option>
            <option value="@TimePrecision.OnOrBefore">On or before a date</option>
            @if (!disclosure || _tlEditPrecision == TimePrecision.NotStated)
            {
                <option value="@TimePrecision.NotStated">Not stated</option>
            }
        </select>
        @switch (_tlPrecision)
        {
            case TimePrecision.Exact:
                <DateTimeInput Past="true" id="tl-atk-when" class="form-control form-control-sm mt-1" aria-label="@($"Date and time ({TimeDisp.Label})")" @bind-Value="_tlWhen" />
                @TimeNudges()
                break;
            case TimePrecision.Day:
            case TimePrecision.OnOrBefore:
                <DateInput Past="true" id="tl-atk-day" class="form-control form-control-sm mt-1" aria-label="Date" @bind-Value="_tlDay" />
                break;
            case TimePrecision.Window:
                <div class="d-flex gap-1 align-items-center mt-1">
                    <DateInput Past="true" id="tl-atk-from" class="form-control form-control-sm" aria-label="First date" @bind-Value="_tlDay" />
                    <span class="small text-muted">to</span>
                    <DateInput Past="true" id="tl-atk-until" class="form-control form-control-sm" aria-label="Last date" @bind-Value="_tlUntilDay" />
                </div>
                break;
            case TimePrecision.NotStated when disclosure:
                <div class="form-text small mb-0">It keeps its place in the disclosure.</div>
                break;
            case TimePrecision.NotStated:
                <select id="tl-atk-after" class="form-select form-select-sm mt-1" aria-label="Comes after" @bind="_tlAfter">
                    <option value="">First in the attack chain</option>
                    @{ var steps = AttackSteps(); }
                    @for (var i = 0; i < steps.Count; i++)
                    {
                        var s = steps[i];
                        if (s.Id == _tlEditId) continue;
                        <option value="@s.Id">After @(i + 1). @OneLine(s.Description)</option>
                    }
                </select>
                break;
        }
        @if (_tlPrecision != TimePrecision.Exact)
        {
            @* Say the design: an approximate time is kept as stated, and never used to measure anything. *@
            <div class="form-text small mb-0">
                @(_tlPrecision == TimePrecision.NotStated
                    ? "Placed by order alone. Use the arrows on the Record to adjust it."
                    : "Kept as stated, with no time of day. Nothing is measured from it.")
            </div>
        }
    </text>;

    // BUG-442: a step "Comes after" names that has left the attack chain (retracted, or replaced by an edit) was kept, so
    // the next save was refused with "isn't on this case". It moves to that step's version now, else to the step before it.
    private string CurrentAfter(string after, Guid? editing)
    {
        if (!Guid.TryParse(after, out var id)) return after;
        var steps = AttackSteps().Where(s => s.Id != editing).ToList();
        if (steps.Any(s => s.Id == id)) return after;
        var gone = Case.TimelineEntries.FirstOrDefault(x => x.Id == id);
        for (var hops = 0; gone is not null && hops < 1000; hops++)
        {
            var next = Case.TimelineEntries.FirstOrDefault(x => x.SupersedesEntryId == gone.Id);
            if (next is null) break;
            if (steps.Any(s => s.Id == next.Id)) return next.Id.ToString();
            gone = next;
        }
        // Entries are never deleted, so one this case doesn't hold yet is a step just added whose reload hasn't landed (the
        // render while Reload awaits passes the old case): keep it, or the next "not stated" step would go first.
        if (gone is null) return after;
        var order = steps.Append(gone).InTimelineOrder().ToList();
        var at = order.IndexOf(gone);
        return at > 0 ? order[at - 1].Id.ToString() : "";
    }

    private void PrecisionChanged()
    {
        // Carry what's in the composer across: the date from the time, or the time from the date.
        var day = _tlWhen.Date;
        if (_tlPrecision is TimePrecision.Day or TimePrecision.OnOrBefore or TimePrecision.Window && _tlEditId is null)
        {
            _tlDay = day;
            // BUG-463 sibling: a typed 31 Dec 9999 has no next day; the save refuses a future time anyway.
            if (_tlUntilDay <= _tlDay) _tlUntilDay = _tlDay < DateTime.MaxValue.Date ? _tlDay.AddDays(1) : _tlDay;
        }
        if (_tlPrecision == TimePrecision.NotStated && _tlEditId is null)
            _tlAfter = AttackSteps().LastOrDefault()?.Id.ToString() ?? "";
    }

    private StepTiming? Timing() => _tlPrecision switch
    {
        TimePrecision.Exact => null,
        TimePrecision.Window => new StepTiming(TimePrecision.Window, StepTiming.DateAnchor(DateOnly.FromDateTime(_tlUntilDay))),
        TimePrecision.NotStated => Guid.TryParse(_tlAfter, out var after)
            ? new StepTiming(TimePrecision.NotStated, AfterStepId: after)
            : new StepTiming(TimePrecision.NotStated, First: true),
        var p => new StepTiming(p)
    };

    // The time sent with the step: the date for a stated date or window, else the composer's date and time (for a
    // step whose time wasn't stated, only used when there's no other step to place it by).
    private DateTimeOffset StepWhenUtc() => _tlPrecision is TimePrecision.Day or TimePrecision.Window or TimePrecision.OnOrBefore
        ? StepTiming.DateAnchor(DateOnly.FromDateTime(_tlDay))
        : KeptWhenUtc();

    // BUG-477 (WF-68): an edited entry's time left as shown keeps its recorded instant. Converting it back read a time in
    // the repeated autumn hour as standard time, so editing only the description moved the entry an hour later. A new
    // entry has nothing recorded (CancelTimelineEdit clears it), so its time is read as typed.
    private DateTimeOffset KeptWhenUtc() => WallClock.Kept(_tlWhen, _tlWhenShown, _tlWhenRecorded, TimeDisp.Zone);

    // The arrows show where they can do something: on a step that shares its time with a neighbour, or where either
    // neighbour has no stated time.
    private bool CanReorder(TimelineEntry e)
    {
        var steps = AttackSteps();
        var i = steps.FindIndex(x => x.Id == e.Id);
        if (i < 0 || steps.Count < 2) return false;
        bool Loose(int j) => j >= 0 && j < steps.Count
            && (steps[j].OccurredAtUtc == e.OccurredAtUtc || steps[j].OccurredPrecision == TimePrecision.NotStated);
        return e.OccurredPrecision == TimePrecision.NotStated || Loose(i - 1) || Loose(i + 1);
    }

    // BUG-603: one move at a time; a double-click moved the step twice.
    private readonly InFlight _moving = new();
    private Task MoveStep(TimelineEntry e, bool earlier) => _moving.Run(() => MoveStepCore(e, earlier));

    private async Task MoveStepCore(TimelineEntry e, bool earlier)
    {
        try { await Cases.MoveEventStepAsync(CaseId, e.Id, earlier); }
        catch (Exception ex) when (ex is InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); return; }
        await OnChanged.InvokeAsync();
    }

    // --- INV-14: the 'l' shortcut opens the composer on an investigation entry and focuses it ---
    [Parameter] public bool AutofocusComposer { get; set; }
    [Parameter] public EventCallback OnAutofocusHandled { get; set; }
    private bool _autofocusPending;

    // --- INV-11: open an entity in the panel; filter to one entity when asked from the panel ---
    [Parameter] public EventCallback<Guid> OnOpenEntity { get; set; }
    [Parameter] public Guid? PresetEntityFilter { get; set; }
    /// <summary>REV-38: the preset filter was applied, so the workspace can let it go.</summary>
    [Parameter] public EventCallback OnPresetHandled { get; set; }
    private Guid? _appliedPreset;

    protected override void OnParametersSet()
    {
        // HR-07: an open case is worked newest-first; a closed one is read as a story, oldest-first. Set once per case
        // so the analyst's own toggle sticks.
        if (_orderSetFor != Case.Id)
        {
            _orderSetFor = Case.Id;
            _tlOldestFirst = Case.Phase == CasePhase.Closed;
            _keyOnly = Case.Phase == CasePhase.Closed;   // RD-13: a closed case's Record opens on its Story
        }
        RecheckAnswer();   // CAP-23
        // BUG-442: every reload (a retract here or by someone else, an edit) re-checks the step "Comes after" names.
        _tlAfter = CurrentAfter(_tlAfter, _tlEditId);
        if (_draft is { } d && CurrentAfter(d.After, null) is var after && after != d.After) _draft = d with { After = after };
        if (AutofocusComposer && !_autofocusPending)
        {
            // BUG-534: an open entry edit is the composer, so 'l' or 'n' leaves it be. BUG-535: and 'l' beside a working
            // note being edited (Ctrl+Enter there saves the note). Either way the shortcut is let go, so it can't fire
            // later, once the edit ends. BUG-552: 'n' too: a note typed in the composer was lost when Ctrl+Enter saved
            // the note being edited instead.
            if (!CanEdit || _tlEditId is not null || NoteEditKeepsNotes()) _ = OnAutofocusHandled.InvokeAsync();
            else
            {
                _autofocusPending = true;
                _composerOpen = true;
                if (!OpenNotes)
                {
                    // BUG-535: 'l' logs an investigation finding whatever lens or composer mode was on ('n' opens the
                    // notes lens below, in Working note mode).
                    // BUG-551: and off the Story lens, without a type or tactic filter that would hide the finding (as
                    // SwitchLens does; there's no entry edit open to cancel here).
                    _decOnly = false;
                    _keyOnly = false;
                    _notesOnly = false;
                    if (_tlLens == TimelineKind.Event) _tlLens = null;
                    ClearKindFilters();
                    SetMode(ComposerMode.Finding);
                }
            }
        }
        // BUG-510: "changes since" asked for while on the Working notes lens (which has no such filter) shows the timeline.
        // Before OpenNotes, so a link to a note that arrives with it still opens the note.
        if (ChangedSinceUtc != _appliedSince)
        {
            _appliedSince = ChangedSinceUtc;
            if (ChangedSinceUtc is not null && _notesOnly && !NoteEditKeepsNotes()) _notesOnly = false;
        }
        if (OpenNotes)
        {
            _ = OpenNotesNow();
        }
        if (PresetEntityFilter != _appliedPreset)
        {
            _appliedPreset = PresetEntityFilter;
            if (PresetEntityFilter is { } en)
            {
                // BUG-510: off the Working notes lens too, which hid the filtered timeline (and later threw the filter away).
                // BUG-551: a type or tactic filter isn't shown on Everything, so it goes (as with SwitchLens, but an open
                // entry edit is kept).
                if (!NoteEditKeepsNotes()) { _decOnly = false; _keyOnly = false; _notesOnly = false; _tlLens = null; ClearKindFilters(); _tlFilterEntity = en; }
                _ = OnPresetHandled.InvokeAsync();   // REV-38: applied once; it isn't applied again on the next visit
            }
        }
        // RD-20: a link to one entry (a Find result) brings it into view on Everything.
        if (FocusEntryId != _appliedFocusEntry)
        {
            _appliedFocusEntry = FocusEntryId;
            if (FocusEntryId is { } fe && Case.TimelineEntries.Any(x => x.Id == fe)) _ = FocusEntryNow(fe);
        }
    }

    /// <summary>RD-20: an entry to bring into view (<c>?entry=</c>).</summary>
    [Parameter] public Guid? FocusEntryId { get; set; }
    private Guid? _appliedFocusEntry;

