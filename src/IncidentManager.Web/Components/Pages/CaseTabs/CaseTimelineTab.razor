        && ((_tlAddKind == TimelineKind.Event && HasText(_tlDesc)) || HasText(_tlSource) || HasText(_question)
            || HasText(_decWhy) || HasText(_decOptions) || HasText(_decBy)
            || _fuTasks.Exists(t => HasText(t.Title)) || (_fuQuestionOpen && HasText(_fuQuestion)) || (_fuKnownOpen && HasText(_fuKnown)));

