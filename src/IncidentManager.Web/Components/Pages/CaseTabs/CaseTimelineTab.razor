                @if (!_fuKnownOpen) { <button type="button" class="btn btn-sm btn-link p-0 me-2" @onclick="() => _fuKnownOpen = true"><span class="bi bi-plus-lg" aria-hidden="true"></span> Line for Known</button> }
                @if (!_fuLinkOpen) { <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => _fuLinkOpen = true"><span class="bi bi-plus-lg" aria-hidden="true"></span> Link a case</button> }
