        // asks before losing it. The add composer's Markdown is the workspace's to judge (FR-02 keeps it across a tab
        // switch); an entry edit in that editor isn't kept, so markdown-editor.js reports it (it has saved text behind it).
        // BUG-611: the edit's own fields count once they differ from what it opened with.
        Edits.Track(this, "the timeline entry you're editing", () => _tlEditId is not null && !Equals(TimelineEditValues(), _tlEditSeed), Region);
        Edits.Track(this, "the timeline entry you're writing", ComposerHoldsText, Region);
        Edits.Track(this, "the reason you're writing", () => (_corr is not null && HasText(_corrReason)) || (_retract is not null && HasText(_retractReason)), Region);
        Edits.Track(this, "the IOC you're adding", () => _newIocFor is not null && HasText(_newIocValue), Region);
        // U-46: seed the "Occurred" input to now in the viewer's active display zone (like Details / tasks).
        _tlWhen = WallClock.ToWall(DateTimeOffset.UtcNow, TimeDisp.Zone);
        _tlType = OfferedType(_tlType);   // BUG-478
        _evtStage = CaseEntitiesTab.OfferedOr(_evtStage, DisclosureStages());   // C16: Notified unless an admin hid it
    }

