    // offered as it was picked is let go, and said, rather than sent to be refused or quietly swapped for another task.
    private void RecheckAnswer()
    {
        if (_fuAnswer is not { } a) return;
        if (Answerable().Contains(a)) return;
        _fuAnswer = null;
        Toasts.Error("The question your finding answers was answered, followed up or changed meanwhile. Pick it again if it's still open.");
