    // --- INV-05b: correcting when a transition happened ---
    [Parameter] public bool CanChangeClassification { get; set; }

    private CaseMilestone? _corr;
    private DateTime? _corrWhen;
    private string? _corrReason;
    private string? _corrError;
    private bool _corrSaving;
    private bool _corrTrapArmed;
    private readonly HashSet<Guid> _corrOpen = new();

    private bool CanCorrect(TransitionKind kind) => CanEdit && (kind != TransitionKind.Classification || CanChangeClassification);

    private List<TransitionTimeCorrection> CorrectionsFor(Guid changeId) =>
        Case.TimeCorrections.Where(x => x.ChangeId == changeId).OrderByDescending(x => x.CreatedAtUtc).ToList();

    private void ToggleCorrections(Guid changeId)
    {
        if (!_corrOpen.Remove(changeId)) _corrOpen.Add(changeId);
    }

    // BUG-601: which opening of the dialog a save is for (as _retractForm).
    private readonly FormSession<string> _corrForm = new();

    private void StartCorrection(CaseMilestone m)
    {
        _corrForm.Open(m.Key);
        _corr = m;
        _corrWhen = WallClock.ToWall(m.AtUtc, TimeDisp.Zone);
        _corrReason = null;
        _corrError = null;
    }

    private void CancelCorrection() { _corrForm.Close(); _corr = null; _corrError = null; }

    // BUG-477 sibling (WF-68): a time left as shown is the transition's own instant, not its standard-time reading.
    private DateTimeOffset CorrectedUtc(CaseMilestone m, DateTime w) =>
        WallClock.Kept(w, WallClock.ToWall(m.AtUtc, TimeDisp.Zone), m.AtUtc, TimeDisp.Zone);   // BUG-503

    // --- BUG-413: retract an entry ---
    private TimelineEntry? _retract;
    private string? _retractStamp;   // the entry's row hash when the dialog opened, so a colleague's change is refused
    private string? _retractReason;
    private string? _retractError;
    private bool _retractSaving;

    // BUG-601: which opening of the dialog a save is for, so it closes (or reports into) only that one, not a dialog
    // opened on another entry after this one was dismissed.
    private readonly FormSession<Guid> _retractForm = new();

    private void StartRetract(TimelineEntry e)
    {
        _retractForm.Open(e.Id);
        _retract = e; _retractStamp = e.RowHash ?? ""; _retractReason = null; _retractError = null;
    }

    private void CancelRetract() { _retractForm.Close(); _retract = null; _retractError = null; }

    private void OnRetractKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelRetract();
    }

    private async Task SaveRetract()
    {
        if (_retract is not { } e || _retractForm.Current is not { } form || _retractSaving || string.IsNullOrWhiteSpace(_retractReason)) return;
        _retractSaving = true;
        _retractError = null;
        try
        {
            await Cases.RetractTimelineEntryAsync(CaseId, e.Id, _retractReason.Trim(), _retractStamp);
            if (_tlEditId == e.Id) await CancelTimelineEdit();   // it can't be edited once retracted
            if (_retractForm.CloseIf(form)) _retract = null;
            await OnChanged.InvokeAsync();
            Toasts.Success(e.Kind == TimelineKind.Event ? "Step retracted" : "Entry retracted");
        }
        catch (StaleEditException ex)
        {
            if (_retractForm.CloseIf(form)) _retract = null;
            Toasts.Error(ex.Message);
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            if (_retractForm.IsCurrent(form)) _retractError = ex.Message;
            else Toasts.Error(ex.Message);
        }
        finally { _retractSaving = false; }
    }

    private void OnCorrectionKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CancelCorrection();
    }

    // What the correction moves, stated before saving. Regulatory clocks never move: they start from the
    // materiality decision or detection, not from a transition.
    private IEnumerable<string> CorrectionImpact(CaseMilestone m, (TransitionKind Kind, Guid ChangeId) t)
    {
        var newAt = _corrWhen is { } w ? CorrectedUtc(m, w) : (DateTimeOffset?)null;
        var moves = newAt is { } at && at != m.AtUtc;
        if (moves)
            yield return $"The timeline shows this at {TimeDisp.Long(newAt!.Value)} instead of {TimeDisp.Long(m.AtUtc)}.";
        if (moves && t.Kind == TransitionKind.Phase && Case.StatusChanges.FirstOrDefault(x => x.Id == t.ChangeId) is { } sc)
        {
            var (label, current) = sc.To switch
            {
                CasePhase.Containment => ("Contained", Case.ContainedAtUtc),
                CasePhase.Recovery => ("Resolved", Case.ResolvedAtUtc),
                CasePhase.Closed => ("Closed", Case.ClosedAtUtc),
                _ => ((string?)null, (DateTimeOffset?)null)
            };
            if (label is not null && current == m.AtUtc)
                yield return $"{label} moves with it, so the response-time and SLA figures are recalculated.";
        }
        if (moves && t.Kind == TransitionKind.Contained)   // FR-51
            yield return "Time to contain and the containment target are measured to the new time.";
        if (t.Kind == TransitionKind.Verdict)   // BUG-414
            yield return "The entity's verdict history shows it as determined then.";
        else
            yield return "Regulatory notification deadlines don't change. They start from the materiality decision or detection.";
        yield return $"The recorded time ({TimeDisp.Long(m.RecordedAtUtc ?? m.AtUtc)}) stays as it is.";
    }

    private async Task SaveCorrection()
    {
        if (_inFlight) return;
        _inFlight = true;
        try { await SaveCorrectionCore(); }
        finally { _inFlight = false; }
    }

    private async Task SaveCorrectionCore()
    {
        if (_corr?.Transition is not { } t || _corrForm.Current is not { } form || _corrWhen is not { } w || string.IsNullOrWhiteSpace(_corrReason)) return;
        _corrSaving = true;
        _corrError = null;
        try
        {
            await Cases.CorrectTransitionTimeAsync(CaseId, t.Kind, t.ChangeId, CorrectedUtc(_corr, w), _corrReason);
            if (_corrForm.CloseIf(form)) _corr = null;
            await OnChanged.InvokeAsync();
            Toasts.Success("Time corrected");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            if (_corrForm.IsCurrent(form)) _corrError = ex.Message;
            else Toasts.Error(ex.Message);
        }
        finally
        {
            _corrSaving = false;
        }
    }

    // --- INV-01: response milestones ---
    private bool _decOnly;                // INV-30: the Decisions lens (Investigation, decisions only)
    private bool _keyOnly;                // INV-30 / RD-13: the Story lens (key entries only)
    private bool KeyOnlyApplies => _keyOnly && _tlLens is null;
    private bool StoryLens => _tlLens is null && _keyOnly && !_notesOnly;
    // RD-13: Story and Everything read in two lanes.
    private bool Lanes => _tlLens is null && !_notesOnly && !_decOnly;

    private void SwitchToStory()
    {
        if (LensSwitchRefused(toNotes: false)) return;
        ShowLens(null);
        _keyOnly = true;
        _tlOldestFirst = true;
    }

    // INV-30: the turning points — what happened (event steps), what was decided and handed over, and the response
    // milestones that change the case's standing (not routine work such as completed tasks or evidence uploads).
    private static bool IsKeyEntry(TimelineEntry e) =>
        e.Kind == TimelineKind.Event || e.Type is TimelineEntryType.Decision or TimelineEntryType.Handoff;
    private static bool IsKeyMilestone(CaseMilestone m) =>
        m.Kind is not (MilestoneKind.TaskDone or MilestoneKind.EvidenceAdded or MilestoneKind.EvidenceWithdrawn);

    // --- RD-08: the Working notes lens ---
    private bool _notesOnly;
    private CaseNotesTab? _notesList;
    /// <summary>A note to bring into view (a mention email links to it).</summary>
    [Parameter] public Guid? FocusNoteId { get; set; }
    /// <summary>Open on the Working notes lens (a link to a note, or the 'n' shortcut).</summary>
    [Parameter] public bool OpenNotes { get; set; }
    [Parameter] public EventCallback OnOpenNotesHandled { get; set; }

    // The notes already put on the record, so the list can say so (INV-07).
    private IReadOnlySet<string> PromotedSources =>
        Case.TimelineEntries.Where(e => e.IsCurrent && e.PromotedFrom is not null).Select(e => e.PromotedFrom!).ToHashSet();

    // BUG-510: leaving the Working notes lens unmounts its list, and a note being edited in place there would be lost, so
    // a jump or filter asked for from elsewhere says so instead of switching.
    private bool NoteEditKeepsNotes()
    {
        if (!_notesOnly || _notesList is not { IsEditing: true }) return false;
        Toasts.Info("Save or cancel the working note you're editing, then try again.");
        return true;
    }

    private void SwitchToNotes()
    {
        if (LensSwitchRefused(toNotes: true)) return;
        ShowLens(null);
        _notesOnly = true;
        SetMode(ComposerMode.Note);   // the composer, if opened here, writes a working note
    }

    private void SwitchToDecisions()
    {
        if (LensSwitchRefused(toNotes: false)) return;
        ShowLens(TimelineKind.Investigation);
        _decOnly = true;
        // The composer, if opened here, records a decision. C16: unless an admin has hidden Decision.
        if (DecisionOffered) _tlType = TimelineEntryType.Decision;
    }
    private bool _showMilestones = true;  // include them in the All chronology

    private sealed record TlRow(DateTimeOffset At, DateTimeOffset Tiebreak, TimelineEntry? Entry, CaseMilestone? Milestone);

    private bool FiltersActive =>
        _tlFilterType is not null || _tlFilterTactic is not null || !string.IsNullOrWhiteSpace(_tlFilterSource)
        || _tlFilterEntity is not null;

    // --- INV-03: reading aids ---
    private Guid? _tlFilterEntity;
    private string _tlFilterEntityStr
    {
        get => _tlFilterEntity?.ToString() ?? "";
        set => _tlFilterEntity = Guid.TryParse(value, out var g) ? g : null;
    }
    private bool _tPlus;

    private IEnumerable<TimelineEntry> CurrentEntries => Case.TimelineEntries.Where(x => x.IsCurrent);

    // An entry touches an entity when it names it as actor or target, or tags it inline (#) in its text.
    private static bool Touches(TimelineEntry e, Guid entityId) =>
        e.ActorEntityId == entityId || e.TargetEntityId == entityId
        || e.Description.Contains($"entity:{entityId}", StringComparison.OrdinalIgnoreCase);

    private DateOnly LocalDay(DateTimeOffset utc) => DateOnly.FromDateTime(TimeZoneInfo.ConvertTime(utc, TimeDisp.Zone).DateTime);

    private string DayLabel(DateOnly day)
    {
        var text = day.ToString("ddd d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
        if (Case.DetectedAtUtc is not { } detected) return text;
        var n = day.DayNumber - LocalDay(detected).DayNumber;
        return n >= 0 ? $"{text} · Day {n}" : $"{text} · before detection";
    }

    // ST-02: an event step's time as stated. An approximate one has no clock time, no "ago" and no T+ (nothing is
    // measured from it); an exact one is the usual label.
    private RenderFragment StepTimeLabel(TimelineEntry e) => IncidentManager.Application.Cases.StepTime.Stated(e) is { } stated
        ? @<span class="tl-time tl-approx" title="Time as stated: nothing is measured from it"><span class="tl-time-abs">@stated</span></span>
        : TimeLabel(e.OccurredAtUtc);

    // One time label for every row: clock time (with "5d ago"), or time since detection when T+ is on.
    private RenderFragment TimeLabel(DateTimeOffset at) => @<text>
        @if (_tPlus && Case.DetectedAtUtc is { } detected)
        {
            <time class="tl-time" title="@TimeDisp.Long(at)"><span class="tl-time-abs">@SinceDetection(at - detected)</span><span class="tl-time-rel">@TimeDisp.Short(at)</span></time>
        }
        else
        {
            <time class="tl-time" title="@TimeDisp.Long(at)"><span class="tl-time-abs">@TimeDisp.Short(at)</span><span class="tl-time-rel">@Ui.RelativeTime(at, Clock.UtcNow)</span></time>
        }
    </text>;

    private static string SinceDetection(TimeSpan span)
    {
        var sign = span < TimeSpan.Zero ? "T−" : "T+";
        var a = span.Duration();
        if (a.TotalDays >= 1) return $"{sign}{(int)a.TotalDays}d {a.Hours}h";
        if (a.TotalHours >= 1) return $"{sign}{(int)a.TotalHours}h {a.Minutes:00}m";
        return $"{sign}{a.Minutes}m";
    }

    // --- RD-13: two lanes, phase bands, gaps and the minimap ---
    private const double GapHours = 8;

    private CasePhase PhaseAt(DateTimeOffset at)
    {
        var changes = Case.StatusChanges.OrderBy(s => s.EffectiveAt).ToList();
        var phase = changes.FirstOrDefault()?.From ?? CasePhase.New;
        foreach (var s in changes)
        {
            if (s.EffectiveAt > at) break;
            phase = s.To;
        }
        return phase;
    }

    private static string BandOf(CasePhase p) => p switch
    {
        CasePhase.New => "new", CasePhase.Triage => "triage", CasePhase.Containment => "contain", CasePhase.Eradication => "eradicate",
        CasePhase.Recovery => "recover", CasePhase.PostIncident => "post", _ => "closed"
    };

    private string BandClass(DateTimeOffset at) => Lanes ? "tl-band-" + BandOf(PhaseAt(at)) : "";

    private string? _jumpTo;

    // A minimap mark brings its entry into view on Everything (so a lens or filter can't hide it).
    private async Task JumpTo(string key)
    {
        if (NoteEditKeepsNotes()) return;
        // BUG-510: the Working notes lens hides every entry too.
        if (_notesOnly || !(_tlLens is null && !_keyOnly) || FiltersActive || ChangedSinceUtc is not null)
        {
            // A lens switch doesn't leave an entry edit (BUG-578), so a jump from a panel ("Cited by") or the minimap says
            // so rather than throwing the typed edit away.
            if (_tlEditId is not null)
            {
                Toasts.Info(EditSlot.Refusal(EditWhat));
                return;
            }
            ShowLens(null);
            if (ChangedSinceUtc is not null) await OnClearSince.InvokeAsync();
        }
        _showMilestones = true;
        _jumpTo = "tl-" + key;
    }

    private sealed record MiniPoint(string Key, DateTimeOffset At, string Kind, string Title);

    // The whole case on one line: phase bands behind the adversary's steps (above) and the response (below).
    private RenderFragment MiniMap() => __builder =>
    {
        var pts = Case.TimelineEntries.Where(x => x.IsCurrent)
            .Select(x => new MiniPoint(x.Id.ToString(), x.OccurredAtUtc,
                x.Kind == TimelineKind.Event ? "adv" : x.Type == TimelineEntryType.Decision ? "dec" : "resp",
                $"{IncidentManager.Application.Cases.StepTime.Stated(x) ?? TimeDisp.Short(x.OccurredAtUtc)} · {OneLine(x.Description)}"))
            .Concat(Milestones().Select(m => new MiniPoint(m.Key, m.AtUtc, "ms", $"{TimeDisp.Short(m.AtUtc)} · {m.Title}")))
            .OrderBy(p => p.At).ToList();
        if (pts.Count < 3) return;
        var start = pts[0].At;
        var end = pts[^1].At;
        var span = (end - start).TotalSeconds;
        if (span < 3600) return;
        // Inset a little so the first and last marks aren't cut by the track's edge.
        double Pos(DateTimeOffset t) => 1 + Math.Clamp((t - start).TotalSeconds / span, 0, 1) * 98;
        var changes = Case.StatusChanges.Where(s => s.EffectiveAt < end).OrderBy(s => s.EffectiveAt).ToList();
        var bands = new List<(double From, double To, CasePhase Phase)>();
        var cur = PhaseAt(start);
        var from = 0d;
        foreach (var s in changes.Where(s => s.EffectiveAt > start))
        {
            bands.Add((from, Pos(s.EffectiveAt), cur));
            from = Pos(s.EffectiveAt);
            cur = s.To;
        }
        bands.Add((from, 100, cur));
        <div class="tl-mini" role="group" aria-label="The whole case at a glance">
            <div class="tl-mini-track">
                @foreach (var b in bands.Where(b => b.To > b.From))
                {
                    <span class="tl-mini-band tl-band-@BandOf(b.Phase)" style="left:@Pct(b.From);width:@Pct(b.To - b.From)" title="@Ui.Label(b.Phase)"></span>
                }
                @foreach (var p in pts)
                {
                    <button type="button" class="tl-mini-mark is-@p.Kind" style="left:@Pct(Pos(p.At))" title="@p.Title" aria-label="@p.Title" @onclick="() => JumpTo(p.Key)"></button>
                }
            </div>
            <div class="tl-mini-scale"><span>@TimeDisp.Short(start)</span><span class="tl-mini-legend"><i class="is-adv"></i> adversary <i class="is-resp"></i> response <i class="is-dec"></i> decision</span><span>@TimeDisp.Short(end)</span></div>
        </div>
    };

    private static string Pct(double v) => v.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static string OneLine(string? text)
    {
        var t = (text ?? "").Replace('\n', ' ').Trim();
        return IncidentManager.Application.Common.TextFit.Cap(t, 88);   // C12: as before, 87 characters and the ellipsis
    }

    private IReadOnlyList<CaseMilestone> Milestones() => CaseMilestones.Project(Case, new MilestoneLabels(
        c => Ui.Label(c), s => SevLabels.For(s), p => Ui.Label(p), m => Ui.Label(m),
        k => OutcomeLabels.GetValueOrDefault(k) ?? IncidentManager.Application.Admin.CaseOutcomeCatalog.Label(k),
        d => Ui.Label(d), t => TimeDisp.DateOnly(t), Notify?.Standing));   // CAP-38 review: reported by the standing

    // Interleave entries and milestones by when they happened; the entry list arrives already ordered.
    private List<TlRow> MergeRows(IEnumerable<TimelineEntry> entries, IEnumerable<CaseMilestone> milestones)
    {
        var rows = entries.Select(e => new TlRow(e.OccurredAtUtc, e.CreatedAtUtc, e, null))
            .Concat(milestones.Select(m => new TlRow(m.AtUtc, m.AtUtc, null, m)))
            .OrderBy(r => r.At).ThenBy(r => r.Entry?.StepOrder ?? 0).ThenBy(r => r.Tiebreak)
            .ToList();
        if (!_tlOldestFirst) rows.Reverse();
        return rows;
    }

