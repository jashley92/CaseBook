    private string DayLabel(DateOnly day)
    {
        var text = day.ToString("ddd d MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
        if (Case.DetectedAtUtc is not { } detected) return text;
        var n = day.DayNumber - LocalDay(detected).DayNumber;
        return n >= 0 ? $"{text} · Day {n}" : $"{text} · before detection";
    }

    // One time label for every row: clock time (with "5d ago"), or time since detection when T+ is on.
    private RenderFragment TimeLabel(DateTimeOffset at) => @<text>
        @if (_tPlus && Case.DetectedAtUtc is { } detected)
        {
            <time class="tl-time" title="@TimeDisp.Long(at)"><span class="tl-time-abs">@SinceDetection(at - detected)</span><span class="tl-time-rel">@TimeDisp.Short(at)</span></time>
        }
        else
        {
            <time class="tl-time" title="@TimeDisp.Long(at)"><span class="tl-time-abs">@TimeDisp.Short(at)</span><span class="tl-time-rel">@Ui.RelativeTime(at, Clock.UtcNow)</span></time>
        }
    </text>;

    private static string SinceDetection(TimeSpan span)
    {
        var sign = span < TimeSpan.Zero ? "T−" : "T+";
        var a = span.Duration();
        if (a.TotalDays >= 1) return $"{sign}{(int)a.TotalDays}d {a.Hours}h";
        if (a.TotalHours >= 1) return $"{sign}{(int)a.TotalHours}h {a.Minutes:00}m";
        return $"{sign}{a.Minutes}m";
    }

    private async Task SwitchToMilestones()
    {
        if (_tlEditId is not null) await CancelTimelineEdit();
        _tlLens = null;
        _msOnly = true;
        ClearTimelineFilters();
    }

    private IReadOnlyList<CaseMilestone> Milestones() => CaseMilestones.Project(Case, new MilestoneLabels(
        c => Ui.Label(c), s => SevLabels.For(s), p => Ui.Label(p), m => Ui.Label(m)));

    // Interleave entries and milestones by when they happened; the entry list arrives already ordered.
    private List<TlRow> MergeRows(IEnumerable<TimelineEntry> entries, IEnumerable<CaseMilestone> milestones)
    {
        var rows = entries.Select(e => new TlRow(e.OccurredAtUtc, e.CreatedAtUtc, e, null))
            .Concat(milestones.Select(m => new TlRow(m.AtUtc, m.AtUtc, null, m)))
            .OrderBy(r => r.At).ThenBy(r => r.Tiebreak)
            .ToList();
        if (!_tlOldestFirst) rows.Reverse();
        return rows;
    }

    private static string MilestoneGlyph(MilestoneKind k) => k switch
    {
        MilestoneKind.Opened => "bi-folder-plus",
        MilestoneKind.Classification => "bi-bar-chart-steps",
        MilestoneKind.Severity => "bi-thermometer-half",
        MilestoneKind.Phase => "bi-signpost-split",
        MilestoneKind.Materiality => "bi-bank",
        MilestoneKind.Gate => "bi-shield-check",
        MilestoneKind.Reported => "bi-send-check",
        MilestoneKind.TaskDone => "bi-check2-square",
        MilestoneKind.EvidenceAdded => "bi-paperclip",
        MilestoneKind.ReportFinal => "bi-file-earmark-lock",
        _ => "bi-flag"
    };

    private void ClearTimelineFilters()
    {
        _tlFilterType = null;
        _tlFilterTactic = null;
        _tlFilterSource = "";
        _tlFilterEntity = null;
    }

    private List<TimelineEntry> FilteredTimeline(IEnumerable<TimelineEntry> entries)
    {
        var view = entries
            .Where(x => x.Kind == TimelineKind.Event && !IsThirdParty
                ? (_tlFilterTactic is null || x.Tactics.Any(tac => tac.Tactic == _tlFilterTactic))
                : (_tlFilterType is null || x.Type == _tlFilterType))
            .Where(x => string.IsNullOrWhiteSpace(_tlFilterSource)
                || (x.Source ?? "").Contains(_tlFilterSource, StringComparison.OrdinalIgnoreCase))
            .Where(x => _tlFilterEntity is not { } en || Touches(x, en))
            .OrderBy(x => x.OccurredAtUtc)
            .ThenBy(x => x.CreatedAtUtc)
            .ToList();
        if (!_tlOldestFirst) view.Reverse();
        return view;
    }

    // --- Event-step display helpers ---
    private static MitreTactic PrimaryTactic(TimelineEntry e) =>
        e.Tactics.Count == 0 ? MitreTactic.Unspecified : e.Tactics.Select(t => t.Tactic).OrderBy(x => (int)x).First();

    private CaseEntity? EntityById(Guid? id) =>
        id is { } g ? Case.Entities.FirstOrDefault(x => x.Id == g) : null;

    private static string EntityShort(CaseEntity e) => string.IsNullOrWhiteSpace(e.Label) ? e.Value : e.Label!;

    private static string EntityOptionLabel(CaseEntity e) =>
        $"{Ui.EntityGlyph(e.Type)} {(string.IsNullOrWhiteSpace(e.Label) ? e.Value : $"{e.Label} ({e.Value})")}";

    /// <summary>ATT&CK technique ID → URL path segment (sub-techniques nest, e.g. T1078.001 → T1078/001).</summary>
    private static string TechniquePath(string techniqueId) => techniqueId.Replace('.', '/');

    // --- Wall-clock ⇄ UTC in the viewer's active display zone (U-29/U-46) ---
    private DateTimeOffset WallToUtc(DateTime wall)
    {
        var unspecified = DateTime.SpecifyKind(wall, DateTimeKind.Unspecified);
        try { return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(unspecified, TimeDisp.Zone), TimeSpan.Zero); }
        catch { return new DateTimeOffset(DateTime.SpecifyKind(unspecified, DateTimeKind.Utc), TimeSpan.Zero); } // DST-invalid wall time: treat as UTC
    }

    private DateTime UtcToWall(DateTimeOffset utc)
        => DateTime.SpecifyKind(TimeZoneInfo.ConvertTime(utc, TimeDisp.Zone).DateTime, DateTimeKind.Unspecified);

    // FR-02: in add mode, capture the Investigation composer's unsubmitted text into the parent-owned store
    // before teardown, so a tab switch preserves it. An in-progress edit (_tlEditId set) is intentionally not
    // stashed — it would otherwise resurface as a new add entry after the tab remounts in add mode.
    private async Task StashDraft()
    {
        if (ComposerDrafts is null || _tlEditId is not null) return;
        try
        {
            var val = await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId);
            if (!string.IsNullOrWhiteSpace(val)) ComposerDrafts[InvEditorId] = val;
            else ComposerDrafts.Remove(InvEditorId);
        }
        catch { /* editor not mounted or circuit tearing down — nothing to stash */ }
    }

    public async ValueTask DisposeAsync()
    {
        await StashDraft();
        foreach (var id in _mdEditors)
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); }
            catch { /* circuit may already be gone during teardown */ }
        }
        _mdEditors.Clear();
    }
}
