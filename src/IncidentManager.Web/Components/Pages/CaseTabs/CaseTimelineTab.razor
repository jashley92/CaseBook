    // Prior versions of an Investigation entry, newest first, by walking the supersede chain.
    private List<TimelineEntry> InvestigationHistory(TimelineEntry current)
    {
        var all = Case.TimelineEntries;
        var history = new List<TimelineEntry>();
        var cursor = current.SupersedesEntryId;
        while (cursor is { } id && all.FirstOrDefault(x => x.Id == id) is { } prior)
        {
            history.Add(prior);
            cursor = prior.SupersedesEntryId;
        }
        return history;
    }

    // --- INV-10: evidence an entry cites ---
    private Guid? _citing;
    private readonly HashSet<Guid> _citeSel = new();
