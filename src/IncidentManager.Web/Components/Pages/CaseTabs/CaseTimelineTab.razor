    // --- INV-14: the 'l' shortcut opens the composer on an investigation entry and focuses it ---
    [Parameter] public bool AutofocusComposer { get; set; }
    [Parameter] public EventCallback OnAutofocusHandled { get; set; }
    private bool _autofocusPending;

    // --- INV-11: open an entity in the panel; filter to one entity when asked from the panel ---
    [Parameter] public EventCallback<Guid> OnOpenEntity { get; set; }
    [Parameter] public Guid? PresetEntityFilter { get; set; }
    private Guid? _appliedPreset;

    protected override void OnParametersSet()
    {
        // HR-07: an open case is worked newest-first; a closed one is read as a story, oldest-first. Set once per case
        // so the analyst's own toggle sticks.
        if (_orderSetFor != Case.Id)
        {
            _orderSetFor = Case.Id;
            _tlOldestFirst = Case.Phase == CasePhase.Closed;
            _keyOnly = Case.Phase == CasePhase.Closed;   // RD-13: a closed case's Record opens on its Story
        }
        if (AutofocusComposer && !_autofocusPending && CanEdit && _tlEditId is null)
        {
            _autofocusPending = true;
            _decOnly = false;
            if (_tlLens == TimelineKind.Event) _tlLens = null;
            _tlAddKind = TimelineKind.Investigation;
            _composerOpen = true;
        }
        if (OpenNotes && !_notesOnly)
        {
            _ = OpenNotesNow();
        }
        if (PresetEntityFilter != _appliedPreset)
        {
            _appliedPreset = PresetEntityFilter;
            if (PresetEntityFilter is { } en) { _decOnly = false; _keyOnly = false; _tlLens = null; _tlFilterEntity = en; }
        }
        // RD-20: a link to one entry (a Find result) brings it into view on Everything.
        if (FocusEntryId != _appliedFocusEntry)
        {
            _appliedFocusEntry = FocusEntryId;
            if (FocusEntryId is { } fe && Case.TimelineEntries.Any(x => x.Id == fe)) _ = FocusEntryNow(fe);
        }
    }

    /// <summary>RD-20: an entry to bring into view (<c>?entry=</c>).</summary>
    [Parameter] public Guid? FocusEntryId { get; set; }
    private Guid? _appliedFocusEntry;

    private async Task FocusEntryNow(Guid id)
    {
        await JumpTo(id.ToString());
        StateHasChanged();
    }

