    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("imMotion.watchTimelineToolbar", "tl-toolbar"); } catch (JSException) { /* cosmetic */ }
        }
        if (_undockAfterRender)
        {
            _undockAfterRender = false;
            await SetDockedAsync(false);
        }
        await ReconcileEditor();
        if (_jumpTo is { } jump)
        {
            _jumpTo = null;
            try { await JS.InvokeVoidAsync("imMotion.scrollToId", jump); } catch (JSException) { /* cosmetic */ }
        }
        // BUG-410: Edit loads the entry into the composer at the top of the tab; take the user there, caret in the text.
        if (_editFocusPending && _tlEditId is not null)
        {
            _editFocusPending = false;
            try
            {
                if (_tlAddKind == TimelineKind.Event)
                {
                    await JS.InvokeVoidAsync("imMotion.focusId", "tl-atk-desc");    // whichever of the two is shown
                    await JS.InvokeVoidAsync("imMotion.focusId", "tl-disc-desc");
                }
                else
                {
                    if (!_composerDocked) await JS.InvokeVoidAsync("imMotion.scrollToId", "tl-inv-type");   // docked: already in view
                    await JS.InvokeVoidAsync("markdownEditor.focus", InvEditorId);
                }
            }
            catch (JSException) { /* cosmetic */ }
        }
        // BUG-535: ReconcileEditor has just mounted the editor for this render, so the request ends here whether or not
        // there is one to focus (a Question composer has none, a failed init leaves none); left pending, it ignored every
        // later 'l'.
        if (_autofocusPending)
        {
            _autofocusPending = false;
            if (_mdEditors.Contains(InvEditorId))
            {
                try { await JS.InvokeVoidAsync("markdownEditor.focus", InvEditorId); }
                catch (JSException) { /* editor not ready; harmless */ }
            }
            await OnAutofocusHandled.InvokeAsync();
        }
        // UX-01 focus trap for the correction dialog (INV-05b), as the workspace does for its own modals.
        if ((_corr is not null || _retract is not null) != _corrTrapArmed)
        {
            _corrTrapArmed = _corr is not null || _retract is not null;
            try { await JS.InvokeVoidAsync(_corrTrapArmed ? "imModal.arm" : "imModal.release"); }
            catch (JSException) { /* focus trap is a progressive enhancement */ }
        }
    }

    // This tab owns a single EasyMDE editor — the Investigation composer, shown only when adding/editing
    // an Investigation entry. Mounted/torn down via the shared markdownEditor JS API.
    private async Task ReconcileEditor()
    {
        var desired = new Dictionary<string, string>();
        // BUG-329: a Question has no editor (its markup isn't rendered), so it's torn down and read back like any switch.
        if (CanEdit && _tlAddKind == TimelineKind.Investigation && _special != ComposerMode.Question)
        {
            // FR-02: in add mode, a draft stashed by a tab switch seeds the first editor, unless newer text has been
            // written here since. BUG-329: from then on _tlDesc is kept in step with the editor (read back below),
            // so a stale stash can't win. While editing an existing entry, seed from that entry's text (_tlDesc).
            if (_tlEditId is null && !_stashTaken)
            {
                _stashTaken = true;
                if (string.IsNullOrEmpty(_tlDesc) && ComposerDrafts?.GetValueOrDefault(InvEditorId) is { } stashed)
                {
                    _tlDesc = stashed;
                    // BUG-398: an editor left mounted by an entry edit isn't initialised again below, so it's given the
                    // stash here; otherwise it stayed blank and the next teardown read "" over the stash.
                    if (_mdEditors.Contains(InvEditorId))
                    {
                        try { await JS.InvokeVoidAsync("markdownEditor.setValue", InvEditorId, stashed, ""); }   // BUG-611: unsaved
                        catch (JSException) { /* best effort; _tlDesc still holds it */ }
                    }
                }
            }
            desired[InvEditorId] = _tlDesc ?? "";
        }

        foreach (var id in _mdEditors.Where(id => !desired.ContainsKey(id)).ToList())
        {
            if (id == InvEditorId && _tlEditId is null) await ReadBackAddText();   // BUG-329
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); } catch (JSException) { /* ignore */ }
            _mdEditors.Remove(id);
        }
        // RD-07: @mentions only mean something in a working note (entries don't notify anyone), so the editor offers
        // them only in that mode; switching re-creates it with the text kept.
        var wantMentions = _special == ComposerMode.Note;
        if (_mdEditors.Contains(InvEditorId) && wantMentions != _editorMentions)
        {
            string? keep = null;
            try { keep = await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId); } catch (JSException) { }
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", InvEditorId); } catch (JSException) { }
            _mdEditors.Remove(InvEditorId);
            if (desired.ContainsKey(InvEditorId)) desired[InvEditorId] = keep ?? "";
        }
        if (wantMentions && _mentionsFor != CaseId)
        {
            _mentionsFor = CaseId;
            // BUG-601: a load begun for an earlier case (or before the tab went) doesn't land over this one's.
            var load = _mentionLoad.Begin();
            IReadOnlyList<IncidentManager.Application.Abstractions.UserSummary> found;
            try { found = await Cases.MentionableAsync(CaseId); } catch (Exception) { found = []; }
            if (_mentionLoad.IsCurrent(load)) _mentionable = found;
        }
        foreach (var (id, seed) in desired)
        {
            if (_mdEditors.Contains(id)) continue;
            string? saved = _tlEditId is null ? "" : null;   // BUG-611: a new entry's text is all unsaved; an edit's starts saved
            object options = wantMentions
                ? new { entities = EntityCandidates, mentions = _mentionable.Select(u => (object)new { id = u.UserId, name = u.DisplayName }).ToArray(), saved }
                : new { entities = EntityCandidates, saved };
            try
            {
                await JS.InvokeVoidAsync("markdownEditor.init", id, seed, options);
                // BUG-566: torn down while this ran, so DisposeAsync missed it; left in the shared registry, it would
                // keep a later mount of this editor id from attaching.
                if (Disposed) { try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); } catch { /* circuit may be gone */ } return; }
                _mdEditors.Add(id); _editorMentions = wantMentions;
            }
            catch (JSException) { /* editor is a progressive enhancement */ }
        }
    }

    // BUG-329: switching the lens or the mode away from the Investigation composer used to destroy its editor unread,
    // losing a half-written Finding or Decision. In add mode its text is kept in _tlDesc (it carries to the next mode,
    // as an event step's text already did) and in the FR-02 stash, so the next editor or a tab switch starts from it.
    private bool _stashTaken;   // this tab has seeded from the FR-02 stash once
    private async Task ReadBackAddText()
    {
        string? val;
        try { val = await JS.InvokeAsync<string>("markdownEditor.getValue", InvEditorId); }
        catch (JSException) { return; }   // nothing readable: keep what we had
        if (_tlEditId is not null) return;   // an edit opened while this was read; its draft (BUG-35) holds the text
        _tlDesc = val ?? "";
        // BUG-398: before this tab has shown the stash, the editor held an edit's text (cleared), not the stash's.
        if (_stashTaken) KeepStash(val);
    }

    private void KeepStash(string? text)
    {
        if (ComposerDrafts is null) return;
        if (!string.IsNullOrWhiteSpace(text)) ComposerDrafts[InvEditorId] = text;
        else ComposerDrafts.Remove(InvEditorId);
    }

