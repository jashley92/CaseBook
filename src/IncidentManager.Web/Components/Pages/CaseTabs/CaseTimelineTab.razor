    private object TimelineEditValues() => (_tlType, _tlWhen, _tlDay, _tlUntilDay, _tlPrecision, _tlAfter, _tlSource, _tlReason,
        _tlAddKind == TimelineKind.Event ? _tlDesc : null, (_evtActorId, _evtTargetId, _evtTechnique, _evtTactic,
        string.Join(",", _evtOtherTactics), _evtStage, _evtOurs, _evtAttackMode), (_decWhy, _decOptions, _decBy));
