                </select>
                <select class="form-select form-select-sm" aria-label="Kind" @bind="task.Kind">
                    @foreach (var k in Enum.GetValues<TaskKind>()) { <option value="@k">@k</option> }
                </select>
                <input type="date" class="form-control form-control-sm" aria-label="Due" @bind="task.Due" />
                <button type="button" class="btn btn-sm btn-link p-0" aria-label="Remove this task" @onclick="() => _fuTasks.Remove(task)"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            </div>
        }
        @if (_fuQuestionOpen)
        {
            <div class="im-then-row">
                <span class="bi bi-question-circle" aria-hidden="true"></span>
                <input class="form-control form-control-sm im-then-wide" placeholder="A question for the brief" maxlength="@ActionItem.MaxTitleLength" aria-label="Question"
                       @bind="_fuQuestion" @bind:event="oninput" />
                <div class="form-check small mb-0">
                    <input class="form-check-input" type="checkbox" id="fu-q-task" @bind="_fuQuestionTask" />
                    <label class="form-check-label" for="fu-q-task">and a task to answer it</label>
                </div>
                <button type="button" class="btn btn-sm btn-link p-0" aria-label="Remove the question" @onclick="() => { _fuQuestionOpen = false; _fuQuestion = null; }"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            </div>
        }
        @if (_fuKnownOpen)
        {
            <div class="im-then-row">
                <span class="bi bi-book" aria-hidden="true"></span>
                <input class="form-control form-control-sm im-then-wide im-rec" placeholder="What this establishes, in a line, for the brief's Known" maxlength="2000" aria-label="Line for Known"
                       @bind="_fuKnown" @bind:event="oninput" />
                <button type="button" class="btn btn-sm btn-link p-0" aria-label="Remove the line" @onclick="() => { _fuKnownOpen = false; _fuKnown = null; }"><span class="bi bi-x-lg" aria-hidden="true"></span></button>
            </div>
        }
        @if (_fuLinkOpen)
        {
            <div class="im-then-row">
                <span class="bi bi-link-45deg" aria-hidden="true"></span>
                @if (_fuLink is { } picked)
                {
                    <span class="small">Link <code>@picked.CaseNumber</code> as</span>
                    <select class="form-select form-select-sm" aria-label="Link type" @bind="_fuLinkType">
