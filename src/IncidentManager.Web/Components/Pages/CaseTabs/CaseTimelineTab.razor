    private EntryFollowUps? FollowUps()
    {
        var f = new EntryFollowUps(
            Tasks: _fuTasks.Where(t => !string.IsNullOrWhiteSpace(t.Title))
                .Select(t => new FollowUpTask(t.Title, string.IsNullOrWhiteSpace(t.Owner) ? null : t.Owner, t.Kind,
                    // WF-24: a bare due date means by the end of that day, as on the Tasks tab (F-20); WF-64: 23:59 on the
                    // organization's calendar, not the viewer's.
                    t.Due is { } d ? DayValues.ToUtc(d, null, TimeDisp.Zone, OrgZone.Current) : null)).ToList(),
            Question: _fuQuestionOpen ? Tagged(_fuQuestion) : null, QuestionTask: _fuQuestionTask,   // WF-25: [[tags]] as Question mode
            KnownLine: _fuKnownOpen ? Tagged(_fuKnown) : null,   // WF-104
            LinkCaseId: _fuLinkOpen ? _fuLink?.Id : null, LinkType: _fuLinkType,
            Answers: _fuAnswerOpen && CurrentMode == ComposerMode.Finding ? _fuAnswer : null);   // CAP-23
        return f.Any ? f : null;
    }

    // What the save writes, said before it happens (and as the toast after).
    private string? SaveSummary()
    {
        if (FollowUps() is not { } f) return null;
        var what = CurrentMode switch
        {
            ComposerMode.Decision => "1 decision",
            ComposerMode.Disclosure => "1 disclosure milestone",
            ComposerMode.Adversary => "1 attack step",   // FR-56: one name for it everywhere
            _ => "1 entry"
        };
        var parts = new List<string> { what };
        var tasks = (f.Tasks?.Count ?? 0) + (EntryFollowUps.Clean(f.Question) is not null && f.QuestionTask ? 1 : 0);
        if (tasks > 0) parts.Add(IncidentManager.Application.Common.Plural.Of(tasks, "task"));
        if (f.Answers is { } ans) parts.Add(ans.TaskId is null ? "the answer to a question (a task raised and done)" : "the answer to a question (its task done)");
        var brief = new List<string>();
        if (EntryFollowUps.Clean(f.KnownLine) is not null) brief.Add("Known +1");
        if (EntryFollowUps.Clean(f.Question) is not null) brief.Add("1 question");
        if (brief.Count > 0) parts.Add($"a new brief version ({string.Join(", ", brief)})");
        if (f.LinkCaseId is not null && _fuLink is { } l) parts.Add($"a link to {l.CaseNumber}");
        return "Saved together: " + string.Join(" · ", parts);
    }

    private IReadOnlyList<(string Id, string Name)> TaskOwners() =>
        Case.Assignments.OrderBy(a => a.Role).Select(a => (a.UserId, Users.DisplayFor(a.UserId)))
            .DistinctBy(x => x.UserId).ToList();

    // BUG-482 (as BUG-454): each search takes a ticket, and a pick or clear drops them; only the latest one's results land, so
    // an older (slower) query's, or one for a box since cleared, doesn't replace them.
    private readonly LoadSequence _fuLinkSearch = new();

    private async Task SearchFuLink()
    {
        var search = _fuLinkSearch.Begin();
        if (string.IsNullOrWhiteSpace(_fuLinkQuery)) { _fuLinkResults = []; return; }
        var found = await Cases.SearchLinkableCasesAsync(CaseId, _fuLinkQuery, take: 6);
        if (_fuLinkSearch.IsCurrent(search)) _fuLinkResults = found;
    }

    private void PickFuLink(LinkableCase r) { _fuLinkSearch.Invalidate(); _fuLink = r; _fuLinkResults = []; }

    private void RemoveFuLink() { _fuLinkSearch.Invalidate(); _fuLinkOpen = false; _fuLink = null; _fuLinkQuery = null; _fuLinkResults = []; }

