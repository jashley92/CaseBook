    // Investigation timeline: author Markdown in the EasyMDE editor.
    // U-40: a pasted screenshot arrives here (via the shim) — read it once into memory for the preview and
    // the later upload. Capped to a screenshot-sized payload; the full evidence cap still applies at upload.
    private async Task OnTimelinePasted(InputFileChangeEventArgs e)
    {
        try
        {
            var f = e.File;
            const long maxShot = 15 * 1024 * 1024;
            await using var s = f.OpenReadStream(maxShot);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            _tlShotBytes = ms.ToArray();
            _tlShotName = f.Name;
            _tlShotType = string.IsNullOrWhiteSpace(f.ContentType) ? "image/png" : f.ContentType;
        }
        catch (Exception ex)
        {
            Toasts.Error($"Couldn't read the pasted image: {ex.Message}");
            ClearTimelineShot();
        }
    }

