@page "/cases/{Id:guid}"
@attribute [Authorize(Policy = Policies.ViewCases)]
@implements IAsyncDisposable
@inject CaseService Cases
@inject IncidentManager.Application.Activity.ActivityFeedService Feed
@inject IClock Clock
@inject IJSRuntime JS
@inject IncidentManager.Web.Services.CaseListMemory ListMemory
@inject IncidentManager.Web.Services.CommandPaletteController Palette
@inject NavigationManager Nav
@inject IAuthorizationService AuthZ
@inject IncidentManager.Application.Abstractions.ICaseChangeNotifier Notifier
@inject AuthenticationStateProvider AuthState
@inject IConfiguration Config
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IncidentManager.Application.Content.IMarkdownService Md
@inject ISeverityLabels SevLabels
@inject ToastService Toasts
@inject TimeDisplay TimeDisp
@inject IncidentManager.Application.Sla.ISlaTargetsProvider SlaProvider
@inject IncidentManager.Application.Compliance.NotificationDeadlineService Deadlines
@inject IncidentManager.Application.Abstractions.ICurrentUser CurrentUser
@inject IncidentManager.Application.Access.IAccessLogService AccessLog
@inject IncidentManager.Web.Services.CaseCommandRegistry PaletteActions
@inject IncidentManager.Application.Cases.CaseShortcutService Shortcuts
@inject IncidentManager.Application.Evidence.EvidenceService EvidenceSvc
@inject IncidentManager.Application.Admin.CaseOutcomeService Outcomes
@inject IncidentManager.Web.Services.CaseTabsState OpenTabs

<PageTitle>@(_case?.CaseNumber ?? "Case")</PageTitle>

@if (_notFound)
{
    <div class="empty-state my-5">
        <div class="empty-state-icon"><span class="bi bi-folder-x" aria-hidden="true"></span></div>
        <h1 class="h4 mb-2">Case not found</h1>
        <p class="text-muted mb-3">It may have been archived, or it's restricted to its case team. Ask its incident commander if you need access.</p>
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-primary" href="@ListMemory.BackHref">Back to cases</a>
            <button type="button" class="btn btn-outline-secondary" @onclick="Palette.Open">Search cases</button>
        </div>
    </div>
}
else if (_case is null)
{
    <LoadingBlock Rows="8" Columns="3" Label="Loading the case…" />
}
else
{
    @* UX-08: consistent back affordance — the "Cases" crumb replaces the old "← All cases" button. *@
    <Breadcrumbs Items="@(new Crumb[] { new("Cases", ListMemory.BackHref), new(_case.CaseNumber) })" />
    @* FR-05: warn before leaving the case (in-app SPA nav) with unsubmitted composer text. The browser-level
       beforeunload guard in markdown-editor.js covers refresh / tab-close / external nav; this covers a
       sidebar or case-link click the SPA router handles without a page unload. *@
    <NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNav" />
    @* REL-07 / REL-08 / S-21: what the viewer can do here, when it isn't everything. *@
    <CaseAccessNotice Access="Access" AccessLost="_accessLost" PermissionLost="_permissionLost" />
    @* RD-03 / RD-27: the two-line header (identity, acts, the state line) is CaseHeader. *@
    <CaseHeader Case="_case" Access="Access" IsPinned="_isPinned" Notify="_notifyDeadlines" AfterClosure="_afterClosure"
                OutcomeLabels="_outcomeLabels" OnTogglePin="TogglePin" OnOpenModal="OpenModal" OnAdvanceTo="AdvanceTo"
                OnAssignToMe="AssignToMe" OnSetLegalHold="SetLegalHold" OnSetArchived="SetArchived" OnGoToTab="SetTab"
                OnChanged="Reload" OnForbidden="Forbidden" />

    @* INV-04 / F-12: what changed since you last looked, and a pending legal-hold release. *@
    <CaseNotices Case="_case" Access="Access" SinceCount="_sinceCount" SincePeople="_sincePeople" LastViewed="_lastViewed"
                 SinceDismissed="_sinceDismissed" OnShowSince="ShowSinceOnTimeline" OnDismissSince="() => _sinceDismissed = true" OnChanged="Reload" />

    @* Design review P4: the tabs stay under the top bar while the case scrolls, and once the header above has
       scrolled away a one-line bar keeps the case's identity, state and next step in view. *@
    <div id="ws-sticky" class="ws-sticky mb-3">
        <div class="ws-slim" aria-hidden="true">
            <code class="im-casehead-num">@_case.CaseNumber</code>
            <CaseStateLine Case="_case" Slim="true" CanEdit="_canEdit" Notify="_notifyDeadlines" AfterClosure="_afterClosure"
                           OutcomeLabels="_outcomeLabels" OnAdvanceTo="AdvanceTo" OnGoToTab="SetTab" />
            <span class="ws-slim-title text-muted">@_case.Title</span>
            <span class="ms-auto"></span>
            <CasePrimaryAct Case="_case" Access="Access" Slim="true" OnOpenModal="OpenModal" OnAdvanceTo="AdvanceTo" />
        </div>
    <CaseViewBar Facts="Facts" CloseOutOpen="_closeOut.Open" RailOpen="_railOpen" OnSetView="SetView" OnOpenCloseOut="OpenCloseOut"
                 OnToggleRail="() => _railOpen = !_railOpen" />
    </div>

    @if (_action.Name is not null && _action.IsSheet)
    {
        <section id="ws-sheet" class="im-sheet" role="region" aria-labelledby="im-action-title" @onkeydown="OnModalEscape">
            @ActionDialog()
        </section>
    }

    @* INV-11: an entity in context, over whatever tab is open. *@
    <EvidencePanel Case="_case" EvidenceId="_panelEvidence" CanEdit="_canEdit" OnClose="CloseEvidencePanel" OnChanged="Reload"
                   OnPreviewImage="OpenShot" OnShowCitation="ShowCitation" />
    <EntityPanel Case="_case" EntityId="_panelEntity" OnClose="CloseEntityPanel" CanEdit="_canEdit" OnChanged="Reload"
                          OnShowOnTimeline="ShowEntityOnTimeline" OnGoToTab="EntityPanelGoTo" />

    @* The shared confirm, FR-05's leave guard and U-40's screenshot lightbox. *@
    <WorkspaceDialogs Confirm="@(_confirm is { } cf ? (cf.Message, cf.Verb) : null)" OnCancelConfirm="CancelConfirm" OnRunConfirm="RunConfirm"
                      LeaveOpen="_confirmLeaveOpen" OnStay="CancelLeave" OnLeave="ConfirmLeave"
                      ShotId="_previewShotId" OnCloseShot="CloseShot" OnEscape="OnModalEscape" />

    @* Keyed by the active tab so the subtree is rebuilt on a tab switch, replaying the .tabbody
       fade-in (U-22 motion). The key doesn't change on case/id navigation, so switching cases
       doesn't force an extra remount. *@
    @* INV-12: on wide screens the case's context sits beside every tab. *@
    <div class="ws-body @(PaneShown ? "ws-body-pane" : "")">
    @if (PhoneNowNext)
    {
        <CaseNowNext Show="@(_phoneTab == "Now" ? "now" : "next")" Case="_case" TaskResults="_taskResults" Notify="_notifyDeadlines" Readiness="_readinessEval" CanEdit="_canEdit"
                     OnChanged="Reload" OnGoToTab="async t => { _phoneTab = null; await SetTab(t); }" OnShowSince="ShowSinceAt" OnOpenEntity="OpenEntity"
                     OnFocusTask='async id => { _phoneTab = null; await FocusItem(("Tasks", id)); }' OnAddTask="async () => { _phoneTab = null; await AddTaskFromPane(); }"
                     OnShowReadiness="ShowReadiness" OnAssign='() => OpenModal("assign")' OnUnassign="UnassignFromPanel" />
    }
    else
    {
    if (_phone && ActiveView == "Paper")
    {
        <p class="im-phone-deskonly is-shown">Reports are generated and approved at a desk. You can read what's here.</p>
    }
    <div class="tabbody" @key="_activeTab">
    @* REL-01: a per-tab error boundary. Because .tabbody is @key'd on the active tab, switching tabs mounts
       a fresh boundary — so a tab that throws shows a contained "this tab couldn't load" fallback (the case
       header, tab bar and other tabs stay usable) and recovers when you switch away and back, with no manual
       reset wiring. This sits inside the layout's page-level boundary, which catches anything outside a tab. *@
    <CaseParts Facts="Facts" OnSetTab="SetTab" />
    <ErrorBoundary>
    <ChildContent>
    @if (_activeTab is "Briefing" or "Impact" or "Attack" or "Connections")
    {
        @* UX-13 / RD-11: CaseOverviewTab renders the Briefing view, or the Impact, ATT&CK or Connections part of
           Things; the parent threads the retention alert, the readiness gate, the shared confirm dialog, the
           assign modal (OnOpenModal), and hotkey dispatch. *@
        <CaseOverviewTab @ref="_overviewTab" Section="@_activeTab" Case="_case" CaseId="_case.Id" TaskResults="_taskResults" OutcomeLabels="_outcomeLabels" CanEdit="_canEdit" CanLiftRestriction="@(_canEdit && CanLiftRestriction)"
                         RetentionMessage="@_retentionMsg" ReadinessEval="_readinessEval" BriefInPane="PaneShown" OnEditBrief="() => _nowNext?.BeginBriefEdit()"
                         OnChanged="Reload" RequestConfirm="OnChildRequestConfirm" OnOpenModal="OpenModal"
                         OnFix="FixGateItem" OnGoToTab="SetTab" OnShowSince="ShowSinceAt" RefreshToken="_liveRefresh" />
    }
    else if (_activeTab == "Closeout")
    {
        <CaseCloseOut Case="_case" Draft="_closeOut" TaskResults="_taskResults" Notify="_notifyDeadlines"
                      OnLeave="LeaveCloseOut" OnClosed="ClosedFromView" OnForbidden="Forbidden" OnFix="FixGateItem" />
    }
    else if (_activeTab == "Timeline")
    {
        @* UX-13: extracted to CaseTimelineTab. It owns its Investigation EasyMDE editor; the parent keeps
           the flash, the screenshot lightbox (OnPreview→OpenShot), the Ctrl+Enter hotkey (via @ref), the
           paste-shim registration (element ids kept in the child), and the live-collab "new entries" pill. *@
        <CaseTimelineTab @ref="_timelineTab" Case="_case" CaseId="_case.Id" TaskResults="_taskResults" OutcomeLabels="_outcomeLabels" CanEdit="_canEdit" CanChangeClassification="_canReclassify"
                         DetectionLabel="@DetectionLabel" OnChanged="Reload" OnPreview="OpenShot"
                         FlashClass="FlashClass" FlashStyle="FlashStyle" ComposerDrafts="_composerDrafts"
                         ChangedSinceUtc="_timelineSince" OnClearSince="() => _timelineSince = null"
                         PresetEntityFilter="_timelineEntity" OnOpenEntity="OpenEntity"
                         AutofocusComposer="_timelineAutofocus" OnAutofocusHandled="() => _timelineAutofocus = false"
                         FocusNoteId="QNote" FocusEntryId="QEntry" OpenNotes="_openNotes" OnOpenNotesHandled="() => _openNotes = false" />
        @* U-32: a floating "jump to what just arrived" pill when a collaborator adds timeline entries. *@
        @if (_newTimelineIds.Count > 0)
        {
            <button type="button" class="tl-newpill" @onclick="JumpToNewTimeline">
                <span class="bi bi-arrow-down-circle" aria-hidden="true"></span>
                @_newTimelineIds.Count new @(_newTimelineIds.Count == 1 ? "entry" : "entries")
            </button>
        }
    }
    else if (_activeTab == "Entities")
    {
        @* UX-13: extracted to CaseEntitiesTab. It owns the vis-network graph interop (its own
           DotNetObjectReference + [JSInvokable] OnNodesMoved) and entity/relationship CRUD; the parent keeps
           the shared confirm dialog (RequestConfirm→AskConfirm), the flash, and hotkey dispatch (@ref). *@
        <CaseEntitiesTab @ref="_entitiesTab" Case="_case" CaseId="_case.Id" CanEdit="_canEdit"
                         OnChanged="Reload" RequestConfirm="OnChildRequestConfirm" FocusEntityId="QEntity" OnOpenEntity="OpenEntity"
                         FlashClass="FlashClass" FlashStyle="FlashStyle" RefreshToken="_liveRefresh" />
    }
    else if (_activeTab == "Evidence")
    {
        @* UX-13: extracted to CaseEvidenceTab. The screenshot lightbox (OpenShot) + live-collab flash stay
           in this parent and are threaded in; the paste/drop shim is still registered by this component's
           OnAfterRenderAsync against the element IDs the child keeps (evidence-dropzone / -file-input / -file-drop). *@
        <CaseEvidenceTab CaseId="_case.Id" EvidenceItems="_case.Evidence" Citations="_case.Citations" OnPreview="OpenShot" OnOpenEvidence="OpenEvidence"
                         OnChanged="Reload" FlashClass="FlashClass" FlashStyle="FlashStyle" CanEdit="_canEdit" Tasks="_case.ActionItems"
                         BriefText="@CurrentBriefText()" />
    }
    else if (_activeTab == "Tasks")
    {
        @* UX-13: extracted to CaseTasksTab. Self-loads its playbooks and builds due-dates; the parent keeps
           the flash and hotkey dispatch (@ref) and reloads the case after a write. *@
        <CaseTasksTab @ref="_tasksTab" Case="_case" CaseId="_case.Id" TaskResults="_taskResults" CanEdit="_canEdit" NoticeDeadline="RunningNotice" OnOpenEntity="OpenEntity" OnGoToTab="SetTab" OnFocusItem="FocusItem"
                      OnChanged="Reload" FlashClass="FlashClass" FlashStyle="FlashStyle" RefreshToken="_liveRefresh" OnAdvancePhase="AdvanceWithResult"
                      AutofocusComposer="_tasksAutofocus" OnAutofocusHandled="() => _tasksAutofocus = false" />
    }
    else if (_activeTab == "Review")
    {
        @* E-26/PROD-41: post-incident review + improvement actions + the separate lessons-learned report.
           Self-loading; RefreshToken re-loads it on a collaborator's change. *@
        <CaseReviewTab @ref="_reviewTab" CaseId="_case.Id" Classification="_case.Classification" CanEdit="_canEdit"
                       Entities="_case.Entities" OnChanged="Reload" RefreshToken="_liveRefresh" />
    }
    else if (_activeTab == "Report")
    {
        @* UX-13: extracted to CaseReportTab. Self-lists reports/profiles; _reportState (parent-held) keeps
           the preview open across tab switches; _liveRefresh re-lists on collaborator changes; OnCaseChanged
           reloads the case after a profile save / generate so the rest of the workspace stays in sync. *@
        <CaseReportTab CaseId="_case.Id" CaseProfileId="_case.ReportProfileId" State="_reportState"
                       RefreshToken="_liveRefresh" OnCaseChanged="Reload" />
    }
    else if (_activeTab == "Audit")
    {
        @* UX-13: extracted to CaseAuditTab. Loads its own trail; _auditFilter (parent-held) keeps the
           analyst's filters across tab switches; _liveRefresh re-queries when a collaborator edits. *@
        <CaseAuditTab CaseNumber="@_case.CaseNumber" CaseId="_case.Id" CanViewAll="_canViewAll"
                      State="_auditFilter" RefreshToken="_liveRefresh" />
    }
    </ChildContent>
    <ErrorContent>
        <ErrorFallback Scope="ErrorFallback.ErrorScope.Section" SectionName="@CaseViews.Label(_activeTab)" />
    </ErrorContent>
    </ErrorBoundary>
    </div>@* /.tabbody *@
    }
    @* RD-04: Now and Next beside every tab, where there's room. *@
    @if (PaneShown)
    {
        <CaseNowNext @ref="_nowNext" Case="_case" TaskResults="_taskResults" Notify="_notifyDeadlines" Readiness="_readinessEval" CanEdit="_canEdit"
                     OnChanged="Reload" OnGoToTab="SetTab" OnShowSince="ShowSinceAt" OnOpenEntity="OpenEntity"
                     OnFocusTask='id => FocusItem(("Tasks", id))' OnAddTask="AddTaskFromPane" OnShowReadiness="ShowReadiness"
                     OnAssign='() => OpenModal("assign")' OnUnassign="UnassignFromPanel" />
    }
    </div>@* /.ws-body *@
    @if (_phone)
    {
        <div class="im-phone-spacer" aria-hidden="true"></div>
        <CasePhoneTabs ActiveView="@ActiveView" PhoneTab="@_phoneTab" OnGo="PhoneGo" />
    }

    @* Action modal — rendered outside the tab blocks so Actions works on every tab. RD-15: a change of rung, severity
       or phase is a sheet under the header instead (below). *@
    @if (_action.Name is not null && !_action.IsSheet)
    {
        <div class="modal d-block im-trap" tabindex="-1" role="dialog" aria-modal="true"
             aria-labelledby="im-action-title" data-return-focus="#case-actions-btn"
             style="background:var(--im-scrim)" @onclick="CloseModal" @onkeydown="OnModalEscape">
            <div class="modal-dialog" @onclick:stopPropagation="true">
                <div class="modal-content">
                    @ActionDialog()
                </div>
            </div>
        </div>
    }
    @* UX-13: the ATT&CK matrix picker now lives in CaseOverviewTab (which owns technique tagging). *@
}

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>Deep-link a specific tab, e.g. <c>?tab=Report</c>, so a link can point straight at it.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? QTab { get; set; }

    /// <summary>Deep-link a specific entity (from an inline entity tag chip): <c>?entity={guid}</c> opens it in the
    /// entity panel (INV-11) over the current tab, and focuses its row when the Entities tab is open.</summary>
    [SupplyParameterFromQuery(Name = "entity")] public Guid? QEntity { get; set; }
    /// <summary>RD-06: an evidence file to open in its panel (a cited-file chip links here).</summary>
    [SupplyParameterFromQuery(Name = "evidence")] public Guid? QEvidence { get; set; }

    /// <summary>INV-37: deep-link one note (a mention email's link): <c>?tab=Notes&amp;note={guid}</c> brings it into view.</summary>
    [SupplyParameterFromQuery(Name = "note")] public Guid? QNote { get; set; }
    /// <summary>RD-20: one record entry to bring into view (a Find result): <c>?tab=Timeline&amp;entry={guid}</c>.</summary>
    [SupplyParameterFromQuery(Name = "entry")] public Guid? QEntry { get; set; }

    // RD-11: the case's views and their parts (Workspace/CaseViews); the active part is the routing key.
    private bool _openNotes;
    private string _activeTab = "Timeline";
    private Guid _partsFor;   // the case the active part was chosen for (a different case starts on its default)
    private readonly Dictionary<string, string> _lastPart = new(StringComparer.Ordinal);

    private string ActiveView => CaseViews.ViewOf(_activeTab);
    private CaseViewFacts Facts => new(_case!, _notifyDeadlines, _activeTab, _newOnTab);
    private string DefaultPart() => CaseViews.DefaultPart(_case);
    private string? ResolvePart(string? q) => CaseViews.Resolve(q, _lastPart);

    private Case? _case;
    // HR-02: each task's latest recorded result, shown under brief questions, on tasks and on timeline task chips.
    private IReadOnlyDictionary<Guid, IncidentManager.Application.Cases.TaskResult> _taskResults = new Dictionary<Guid, IncidentManager.Application.Cases.TaskResult>();
    private bool _notFound;


    // Overview: the tab is extracted to CaseOverviewTab (UX-13), which owns details/impact/techniques/links
    // + the Summary editor. The parent keeps a ref for hotkey dispatch (Ctrl+Enter save).
    private CaseOverviewTab? _overviewTab;

    // RD-27: the open action dialog and what's been typed into it (one for the page's life, so a cancelled dialog's
    // text is still there when it's reopened), and a close-out in progress.
    private readonly CaseActionDraft _action = new();
    private readonly CloseOutDraft _closeOut = new();


    // S-08: need-to-know restriction.
    private bool _canViewRestricted;

    /// <summary>The IC or a cleared role may lift a restriction (mirrors CaseRestrictionPolicy.CanLift).</summary>
    private bool CanLiftRestriction => _canViewAll || _canViewRestricted
        || (_case is not null && string.Equals(_case.IncidentCommander, _myId, StringComparison.Ordinal));



    // Timeline: the tab is extracted to CaseTimelineTab (UX-13), which owns its composer/edit state + its
    // Investigation EasyMDE editor. The parent keeps a ref for hotkey dispatch (Ctrl+Enter submit).
    private CaseTimelineTab? _timelineTab;

    // U-40: the attached screenshot currently open in the lightbox preview (null = closed). Parent-owned,
    // shared by the Timeline and Evidence tabs.
    private Guid? _previewShotId;

    // Entities: the tab is extracted to CaseEntitiesTab (UX-13), which owns the graph interop and
    // entity/relationship CRUD. The parent keeps a ref for hotkey dispatch (Ctrl+Enter submit).
    private CaseEntitiesTab? _entitiesTab;

    private bool _canEdit;
    // Case-local keyboard shortcuts (imKeymap → OnCaseHotkey); the entity graph has its own ref in its tab.
    private DotNetObjectReference<CaseWorkspace>? _dotNetRef;

    // Notes: the tab is extracted to CaseNotesTab (UX-13), which owns its editors + note state. The parent
    // keeps a ref for hotkey dispatch (Ctrl+Enter submit) and a flag for the 'n' focus shortcut.
    private bool _timelineAutofocus;   // INV-14
    private bool _tasksAutofocus;      // INV-14

    // Tasks: the tab is extracted to CaseTasksTab (UX-13), which owns the add-task + apply-playbook flow.
    private CaseTasksTab? _tasksTab;
    // Lessons learned (E-26/PROD-41): owns its review + action editors; the parent routes Ctrl+Enter to it.
    private CaseReviewTab? _reviewTab;

    // Retention guard message for legal-hold / archive actions (not notes).
    private string? _retentionMsg;

    // Workspace chrome: per-action permissions.
    private bool _canReclassify;
    private bool _canManageLegal;
    private bool _canAdmin;
    private IDisposable? _caseSub;
    private (string Message, string Verb, Func<Task> OnConfirm)? _confirm;

    // UX-13: the extracted Entities tab raises this to use the parent-owned confirm dialog.
    private void OnChildRequestConfirm((string Message, string Verb, Func<Task> OnConfirm) req) => AskConfirm(req.Message, req.OnConfirm, req.Verb);

    // Evidence: the tab is extracted to CaseEvidenceTab (UX-13). The screenshot lightbox (OpenShot) and the
    // live-collab flash it renders stay here, shared with the Timeline; the child manages its own upload/custody state.

    // Audit (UX-13: the tab is extracted to CaseAuditTab; this state persists its filters across re-mounts).
    private bool _canViewAll;
    private readonly CaseAuditFilter _auditFilter = new();
    // Bumped whenever a collaborator changes the case, so extracted tabs (audit) re-query live.
    private int _liveRefresh;

    // FR-02: unsubmitted composer text, kept in the parent (which survives tab switches, unlike the tab
    // components) so hopping tabs doesn't discard an in-progress note / comment / investigation entry.
    // Keyed by the editor's element id; each composer tab stashes on teardown and re-seeds on remount.
    // Server-memory only — never persisted to the client, so it's gone when the circuit ends (idle-lock /
    // logout), preserving the unattended-workstation posture; also cleared when the case changes.
    private readonly Dictionary<string, string> _composerDrafts = new();
    private Guid _draftsCaseId;

    // FR-05: guard against leaving the case (in-app navigation) with unsubmitted composer text.
    private bool _confirmLeaveOpen;
    private string? _pendingLeave;
    // REL-07: true once a live-collab reload found the case archived/restricted out from under a viewer who
    // still holds unsaved composer text — we hold the (last-known) workspace and show a banner instead of
    // swapping to the not-found page, so the draft can be copied out.
    private bool _accessLost;
    private bool _leaveConfirmed;
    // REL-08: true once this user's permission to act on the case is found to have changed since it loaded —
    // either a live re-check shows edit was revoked, or the server refuses an action (ForbiddenException).
    // Drives a banner and demotes the header edit affordances so a stale control can't throw when clicked.
    private bool _permissionLost;
    private const string PermissionLostMessage = WorkspaceText.PermissionLost;

    // REL-08: (re-)evaluate the current user's action permissions from the live auth state. Called at load and
    // on every live-collab refresh; if a re-check shows edit was revoked mid-session, demote + warn. Under the
    // default (non-revalidating) auth-state provider the claims are fixed for the circuit, so a mid-session
    // change surfaces on a reconnect or as a ForbiddenException — but this keeps the UI correct if the auth
    // state is ever refreshed in place, and centralises the capture.
    private async Task RefreshPermissionsAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        var couldEdit = _canEdit;
        _canEdit = (await AuthZ.AuthorizeAsync(user, Policies.EditCases)).Succeeded;
        _canReclassify = (await AuthZ.AuthorizeAsync(user, Policies.ChangeClassification)).Succeeded;
        _canManageLegal = (await AuthZ.AuthorizeAsync(user, Policies.ManageLegal)).Succeeded;
        _canAdmin = (await AuthZ.AuthorizeAsync(user, Policies.Administer)).Succeeded;
        _canViewAll = (await AuthZ.AuthorizeAsync(user, Policies.ViewAllCases)).Succeeded;
        _canViewRestricted = (await AuthZ.AuthorizeAsync(user, Policies.ViewRestricted)).Succeeded;
        if (couldEdit && !_canEdit) _permissionLost = true;
    }

    // RD-27: the same permissions as one record, for the workspace's regions.
    private CaseAccess Access => new(_canEdit, _canReclassify, _canManageLegal, _canAdmin, _canViewAll, _canViewRestricted, _myId ?? "");

    // A region was refused an act for lack of permission (REL-08).
    private void Forbidden()
    {
        OnForbidden();
        Toasts.Error(PermissionLostMessage);
    }

    // REL-08: the server refused an action for lack of permission — the authoritative signal that this user's
    // access changed since the case loaded. Demote the edit affordances and raise the banner rather than
    // letting a raw ForbiddenException reach the error UI. (Composers are AuthorizeView-gated on the live
    // claims, so clearing these flags never unmounts an in-progress draft.)
    private void OnForbidden()
    {
        _permissionLost = true;
        _canEdit = false;
        _canReclassify = false;
        _canManageLegal = false;
    }

    // Reports (UX-13: the tab is extracted to CaseReportTab; this state persists preview/profiles across re-mounts).
    private readonly CaseReportState _reportState = new();

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        _myId = CurrentUser.UserId;
        await RefreshPermissionsAsync();
        // S-10: an open session's permissions can be refreshed in place; re-check the edit affordances when they are.
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;

        // Live collaboration: refresh when another analyst changes this case.
        _caseSub = Notifier.SubscribeChanges(Id, OnCaseChangedAsync);

        // PROD-19: publish this case's action verbs to the command palette. The provider is a closure over
        // live state, so the palette reflects the case as it currently is (permissions, next phase, hold state).
        // Owner-guarded (see CaseCommandRegistry): MainLayout re-keys this page subtree on a time-zone change,
        // so a fresh instance registers before the old one disposes — pass `this` so teardown clears only ours.
        PaletteActions.Set(this, BuildPaletteActions);

        // U-32: a 30s heartbeat re-renders so relative times ("2m ago") stay live without a reload.
        _relativeTimeTicker = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }


    protected override async Task OnParametersSetAsync()
    {
        await Reload();
        _panelEntity = QEntity;   // INV-11: an entity tag link opens the entity panel
        _panelEvidence = QEntity is null ? QEvidence : null;   // RD-06: a cited-file chip opens the evidence panel
        // Honor an explicit ?tab=, otherwise refresh whatever tab is already active. The Id can change
        // under a reused component (e.g. following an "also in" cross-case link) while the active tab
        // stays the same, so always reload the active tab's data rather than only on a tab-name change.
        // RD-11: a different case opens on its default view.
        if (_partsFor != Id) _closeOut.Discard();   // RD-14: a close-out draft belongs to its case
        var tab = ResolvePart(QTab) ?? (_partsFor != Id ? DefaultPart() : _activeTab);
        _partsFor = Id;
        await SetTab(tab);
        // U-30: a fresh case view starts with a clean slate — nothing is "new" until a collaborator acts.
        _flash.Clear();
        _newOnTab.Clear();
        // RD-20: an entry linked from Find flashes once it's in view, so it's plain which one was meant.
        if (QEntry is { } qe && _case?.TimelineEntries.Any(e => e.Id == qe) == true)
        {
            _flash[qe] = (Ui.AvatarHue(_myId ?? ""), "Timeline");
            _ = ClearFlashesAfter([qe]);
        }
        _newTimelineIds.Clear();
        // FR-02: a different case starts with a clean draft slate; within the same case (e.g. an entity
        // deep-link that re-runs OnParametersSetAsync) keep any in-progress composer text.
        if (_draftsCaseId != Id) { _composerDrafts.Clear(); _draftsCaseId = Id; }
    }

    private async Task Reload() => await ReloadWith(await Cases.GetDetailAsync(Id));
    private Guid _tabOpenedFor;

    // REL-07: reload from an already-fetched detail, so the live-collab path can peek at accessibility
    // before deciding whether to swap the view away (see OnCaseChangedAsync).
    private async Task ReloadWith(Case? detail)
    {
        _case = detail;
        _notFound = _case is null;
        _taskResults = _case is null ? new Dictionary<Guid, IncidentManager.Application.Cases.TaskResult>()
            : await Cases.GetTaskResultsAsync(_case.Id);
        // HR-01: outcome labels (admin-managed) for the header and the Closed milestone; only closed cases show one.
        if (_case?.StatusChanges.Any(s => s.OutcomeKey is not null) == true && _outcomeLabels.Count == 0)
            _outcomeLabels = await Outcomes.LabelsAsync();
        // C-05: record the authorized case-detail open (best-effort; coalesced into a view-session).
        if (_case is not null)
        {
            // INV-04: read when this viewer last had the case open before recording this visit, once per case.
            if (_sinceCheckedFor != _case.Id)
            {
                _sinceCheckedFor = _case.Id;
                _sinceDismissed = false;
                _timelineSince = null;
                _sinceCount = 0;
                _sincePeople = [];
                _lastViewed = await AccessLog.LastViewedAsync(_case.Id);
                if (_lastViewed is { } lv)
                    (_sinceCount, _sincePeople) = await Feed.ChangesSinceAsync(_case.Id, lv);
            }
            // HR-15: a closed case says openly what changed after it closed (it isn't locked).
            _afterClosure = _case.Phase == CasePhase.Closed ? await Feed.ChangesAfterClosureAsync(_case.Id) : null;
            if (_tabOpenedFor != _case.Id)
            {
                _tabOpenedFor = _case.Id;
                try { await OpenTabs.OpenedAsync(_case.Id); }   // RD-21: the case becomes (or comes forward as) a tab
                catch (Exception ex) when (ex is InvalidOperationException or Microsoft.EntityFrameworkCore.DbUpdateException) { /* tabs are a convenience */ }
            }
            await AccessLog.RecordCaseOpenAsync(_case.Id, _case.CaseNumber, _case.IsRestricted);
            _isPinned = await Shortcuts.IsPinnedAsync(_case.Id); // PROD-20: header star + palette action state
        }
        _action.NewClass = _case?.Classification ?? Classification.Incident;
        _action.NewPhase = _case?.Phase ?? CasePhase.Triage;
        _action.NewSeverity = _case?.Severity ?? Severity.Medium;
        // PROD-07: headline regulatory-notification deadline for the header badge (null when the feature is off).
        _notifyDeadlines = _case is null ? null : await Deadlines.EvaluateAsync(Id);
        // Readiness is computed here and passed to CaseOverviewTab for the stage-readiness card.
        _readinessEval = NextGateTrigger() is { } t ? await LoadGateAsync(t) : null;
        SeedKnownIds(); // U-30: absorb the current items so a viewer's own edits don't echo back as "new"
    }

    // --- Overview "Stage readiness" card: the gate for this case's next likely transition (passed to the tab) ---
    private GateEvaluation? _readinessEval;

    // RD-19: the most urgent notification deadline still running (not yet reported).
    private IncidentManager.Application.Compliance.NotificationDeadlineStatus? RunningNotice =>
        _notifyDeadlines is { ReportedAtUtc: null, Headline: { IsActive: true } h } ? h : null;

    // PROD-07: the case's evaluated regulatory-notification deadlines (null when the feature is off).
    private IncidentManager.Application.Compliance.CaseNotificationDeadlines? _notifyDeadlines;

    /// <summary>The gate a case is heading toward next, given its current classification/phase.</summary>
    private StageGateTrigger? NextGateTrigger()
    {
        if (_case is null || _case.Phase == CasePhase.Closed) return null;
        return _case.Classification switch
        {
            null => StageGateTrigger.PromoteToAdverseEvent,
            Classification.AdverseEvent => StageGateTrigger.EscalateToIncident,
            Classification.Incident => StageGateTrigger.EscalateToBreach,
            Classification.Breach => StageGateTrigger.CloseCase,
            _ => null
        };
    }

    // INV-41: bring one item into view on its tab (a task's "about" chip): switch to the tab, flash the item the way a
    // new arrival flashes, and scroll to it once it's rendered.
    private string? _scrollToId;
    private async Task FocusItem((string Tab, Guid Id) target)
    {
        _flash[target.Id] = (Ui.AvatarHue(_myId ?? ""), target.Tab);
        _scrollToId = (target.Tab switch { "Timeline" => "tl-", "Notes" => "note-", "Tasks" => "task-", _ => "ev-" }) + target.Id;   // HR-17: notes; RD-04: tasks
        await SetTab(target.Tab);   // clears the flash a moment after it's seen
    }

    private async Task SetTab(string tab)
    {
        // RD-08: working notes live in the Timeline's lens.
        if (string.Equals(tab, "Notes", StringComparison.OrdinalIgnoreCase)) { _openNotes = true; tab = "Timeline"; }
        _activeTab = tab;
        _lastPart[CaseViews.ViewOf(tab)] = tab;   // RD-11: a view reopens on the part last used there
        // U-30: viewing a tab clears its "new" pulse; any items flashing there fade a moment after they're seen.
        _newOnTab.Remove(tab);
        var seen = _flash.Where(kv => string.Equals(kv.Value.Tab, tab, StringComparison.OrdinalIgnoreCase))
                         .Select(kv => kv.Key).ToList();
        if (seen.Count > 0) _ = ClearFlashesAfter(seen);
        // Reflect the active tab in the URL (?tab=) so a refresh / bookmark reopens the same tab instead of
        // snapping back to Overview. We use history.replaceState rather than NavigationManager so this doesn't
        // fire a Blazor navigation (which would reload the whole case on every tab click). The one-shot
        // ?entity= deep-link is cleared once consumed. No-ops during prerender (JS not yet available).
        await SyncTabUrl(tab);
        // Overview, Audit, Report, Entities, and Tasks self-load in their extracted tab components (UX-13).
    }

    // RD-11: a view opens on the part last used there.
    private Task SetView(string view) =>
        SetTab(_lastPart.TryGetValue(view, out var last) && Facts.PartsShown(view).Contains(last) ? last : Facts.PartsShown(view)[0]);

    private async Task SyncTabUrl(string tab)
    {
        try
        {
            var url = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["tab"] = tab,
                ["entity"] = null,
            });
            await JS.InvokeVoidAsync("history.replaceState", null, "", url);
            OpenTabs.Remember(Id, Nav.ToBaseRelativePath(url));   // RD-21: the tab comes back to this view
        }
        catch (JSException) { /* circuit/JS not ready */ }
        catch (InvalidOperationException) { /* prerendering — JS interop unavailable */ }
    }

    private bool _sheetShown;

    // The action dialog (CaseActionForm), shown in the modal or, for RD-15's transitions, the sheet.
    private RenderFragment ActionDialog() => __builder =>
    {
        <CaseActionForm Case="_case!" D="_action" Access="Access" Notify="_notifyDeadlines" OnClose="CloseModal"
                        OnTargetChanged="TargetChanged" OnApplied="ActionApplied" OnForbidden="ActionForbidden" OnStale="Reload" OnFix="FixGateItem" />
    };

    // --- Detection-source deep-links (used by the Overview header) ---

    /// <summary>Display label for the detection source (configurable); defaults to "SIEM".</summary>
    private string DetectionLabel
    {
        get
        {
            var label = Config["ExternalLinks:DetectionSourceLabel"];
            return string.IsNullOrWhiteSpace(label) ? "SIEM" : label;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // P4: start watching this case's header once it's on screen (again after navigating to another case).
        if (_case is not null && _watchedHeadFor != _case.Id)
        {
            _watchedHeadFor = _case.Id;
            try { await JS.InvokeVoidAsync("imMotion.watchHead", "ws-head", "ws-sticky"); }
            catch (JSException) { } catch (JSDisconnectedException) { }
        }
        if (_scrollToId is { } scrollTo)
        {
            _scrollToId = null;
            try { await JS.InvokeVoidAsync("imMotion.scrollToId", scrollTo); }
            catch (JSException) { } catch (JSDisconnectedException) { }
        }
        if (_pendingOverviewFix is { } fix && _overviewTab is not null)
        {
            _pendingOverviewFix = null;
            await _overviewTab.FixReadiness(fix);
        }
        if (firstRender)
        {
            // Attach the paste/drag-drop listeners once (idempotent in the shim; each zone only acts while
            // its wrapper is in the DOM). Evidence tab (U-39): paste + drop. Timeline tab (U-40): paste only.
            try
            {
                await JS.InvokeVoidAsync("imPasteDrop.register", "evidence-dropzone", "evidence-file-input", "evidence-file-drop");
                await JS.InvokeVoidAsync("imPasteDrop.register", "timeline-dropzone", "timeline-file-paste", null);
            }
            catch (JSException) { /* progressive enhancement — the manual picker still works */ }

            // U-14: case-local keyboard shortcuts (digit 1..9 / 0 = tab, n = new note).
            try { await JS.InvokeVoidAsync("imKeymap.registerCase", _dotNetRef); }
            catch (JSException) { /* shortcuts are a progressive enhancement */ }

            // RD-04: whether the Now/Next pane fits beside the tab.
            try { await JS.InvokeVoidAsync("imMedia.watch", _dotNetRef, "(min-width: 1200px)"); }
            catch (JSException) { /* without it the pane shows, as on a wide screen */ }
            // RD-25: phone layout below 768px.
            try { await JS.InvokeVoidAsync("imMedia.watch", _dotNetRef, "(max-width: 767.98px)", "OnPhoneChanged"); }
            catch (JSException) { /* without it the desktop layout shows */ }
        }

        // Phones: the tab strip scrolls sideways, so keep the active tab in view after it changes.
        if (_case is not null && _revealedTab != _activeTab)
        {
            _revealedTab = _activeTab;
            try { await JS.InvokeVoidAsync("imMotion.revealActiveTab", ".im-workspace-tabs"); }
            catch (JSException) { /* cosmetic */ }
        }

        // RD-15: a sheet opening brings itself into view and takes focus (it doesn't trap it).
        if ((_action.Name is not null && _action.IsSheet) != _sheetShown)
        {
            _sheetShown = !_sheetShown;
            if (_sheetShown)
            {
                try { await JS.InvokeVoidAsync("imModal.focusIn", "#ws-sheet"); }
                catch (JSException) { /* focus is a progressive enhancement */ }
            }
        }

        // UX-01: move focus into a modal when it opens and back to the trigger when it closes.
        if (AnyTrapModalOpen != _modalTrapArmed)
        {
            _modalTrapArmed = AnyTrapModalOpen;
            try { await JS.InvokeVoidAsync(_modalTrapArmed ? "imModal.arm" : "imModal.release"); }
            catch (JSException) { /* focus trap is a progressive enhancement */ }
        }

        // UX-13: all EasyMDE editors and the entity-graph render now live in the extracted tab components;
        // the 'n' shortcut's caret focus is handled inside CaseNotesTab (via AutofocusComposer).
    }

    private void OnAuthStateChanged(Task<AuthenticationState> state) =>
        _ = InvokeAsync(async () => { await RefreshPermissionsAsync(); StateHasChanged(); });

    public async ValueTask DisposeAsync()
    {
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
        _caseSub?.Dispose();
        PaletteActions.Clear(this); // PROD-19: stop offering this case's actions (only if we're still the owner)
        if (_relativeTimeTicker is not null) await _relativeTimeTicker.DisposeAsync();
        // EasyMDE editors and the entity graph are torn down by their own tab components (UX-13).
        try { await JS.InvokeVoidAsync("imKeymap.unregisterCase"); }   // U-14: stop forwarding keys to this circuit
        catch { /* circuit may already be gone during teardown */ }
        _dotNetRef?.Dispose();
    }

}
