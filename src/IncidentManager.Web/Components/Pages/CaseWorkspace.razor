    }
    else if (_activeTab == "Audit")
    {
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
            <p class="text-muted mb-0">Tamper-evident audit trail for this case (most recent first).</p>
            <a class="btn btn-sm btn-outline-secondary" href="@AuditExportHref()">
                <span class="bi bi-download me-1" aria-hidden="true"></span>Export CSV
            </a>
        </div>

        @* E-24: filter the hash-chained trail by actor / action / entity / date range (server-side). *@
        <div class="row g-2 align-items-end mb-3">
            <div class="col-6 col-md-3">
                <label class="form-label small mb-0">Actor</label>
                <select class="form-select form-select-sm" @bind="_aqActor" @bind:after="ApplyAuditFilter">
                    <option value="">Any</option>
                    @foreach (var actor in _auditActors)
                    {
                        <option value="@actor">@Users.DisplayFor(actor)</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label small mb-0">Action</label>
                <select class="form-select form-select-sm" @bind="_aqAction" @bind:after="ApplyAuditFilter">
                    <option value="">Any</option>
                    @foreach (var act in Enum.GetValues<AuditAction>())
                    {
                        <option value="@act">@act</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-0">Entity</label>
                <select class="form-select form-select-sm" @bind="_aqEntity" @bind:after="ApplyAuditFilter">
                    <option value="">Any</option>
                    @foreach (var et in _auditEntityTypes)
                    {
                        <option value="@et">@et</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-0">From (UTC)</label>
                <input type="date" class="form-control form-control-sm" @bind="_aqFrom" @bind:after="ApplyAuditFilter" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-0">To (UTC)</label>
                <input type="date" class="form-control form-control-sm" @bind="_aqTo" @bind:after="ApplyAuditFilter" />
