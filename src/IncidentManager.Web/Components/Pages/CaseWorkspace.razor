        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small text-muted">@_audit.Count entr@(_audit.Count == 1 ? "y" : "ies")@(_auditFiltered ? " (filtered)" : "")@(_audit.Count >= AuditPageSize ? $" — showing the most recent {AuditPageSize}" : "")</span>
