    /// <summary>Deep-link to the case in the detection source, or null when the case or the URL template is unset.</summary>
    private string? DetectionCaseUrl()
    {
        var template = Config["ExternalLinks:DetectionCaseUrlTemplate"];
        if (string.IsNullOrWhiteSpace(template) || _case is null || string.IsNullOrWhiteSpace(_case.DetectionCaseId)) return null;
        return string.Format(template, Uri.EscapeDataString(_case.DetectionCaseId));
