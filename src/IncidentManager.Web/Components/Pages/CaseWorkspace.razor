    private async Task LoadAudit()
    {
        if (_case is null) return;
        if (!_auditFacetsLoaded)
        {
            (_auditActors, _auditEntityTypes) = await Integrity.AuditFacetsAsync(_case.CaseNumber);
            _auditFacetsLoaded = true;
        }
        _audit = await Integrity.QueryAsync(BuildAuditFilter(), AuditPageSize);
        // C-05: leads/admins see who has read this case (coalesced view-sessions).
        if (_canViewAll)
            _viewedBy = await AccessLog.ForCaseAsync(_case.Id);
    }

    // E-24: build the server-side filter from the tab's controls. "To" is inclusive to the end of the day.
    private AuditQueryFilter BuildAuditFilter() => new()
    {
        CaseNumber = _case?.CaseNumber,
        Actor = string.IsNullOrWhiteSpace(_aqActor) ? null : _aqActor,
        Action = Enum.TryParse<AuditAction>(_aqAction, out var a) ? a : null,
        EntityType = string.IsNullOrWhiteSpace(_aqEntity) ? null : _aqEntity,
        FromUtc = _aqFrom is { } f ? new DateTimeOffset(f.Date, TimeSpan.Zero) : null,
        ToUtc = _aqTo is { } t ? new DateTimeOffset(t.Date.AddDays(1).AddTicks(-1), TimeSpan.Zero) : null
    };

    private async Task ApplyAuditFilter() => await LoadAudit();

    private async Task ClearAuditFilter()
    {
        _aqActor = _aqAction = _aqEntity = "";
        _aqFrom = _aqTo = null;
        await LoadAudit();
    }

    // Deep-link to the scoped CSV export mirroring the active filter (dates as yyyy-MM-dd, UTC).
    private string AuditExportHref()
    {
        var f = BuildAuditFilter();
        var qs = new List<string> { $"case={Uri.EscapeDataString(_case!.CaseNumber)}" };
        if (f.Actor is { } actor) qs.Add($"actor={Uri.EscapeDataString(actor)}");
        if (f.Action is { } act) qs.Add($"action={act}");
        if (f.EntityType is { } et) qs.Add($"entity={Uri.EscapeDataString(et)}");
        if (_aqFrom is { } from) qs.Add($"from={from:yyyy-MM-dd}");
        if (_aqTo is { } to) qs.Add($"to={to:yyyy-MM-dd}");
        return "export/case-audit.csv?" + string.Join("&", qs);
    }

    private async Task OpenModal(string name)
    {
        if (_case is null) return;
        _activeModal = name;
        _modalError = null;
        _actionsOpen = false;
        // For a Complex Event (intake) the reclassify modal is a promotion — default to the first rung.
        _newClass = _case.Classification ?? Classification.AdverseEvent;
        _newSeverity = _case.Severity;
        _newPhase = _case.Phase;

        // Open the assign form clean (a prior cancelled attempt may have left a stale selection).
        if (name == "assign") { _assignUserId = ""; _assignRole = CaseAssignmentRole.Analyst; }

        _attested.Clear();
        _gateOverride = null;
        _gateEval = name switch
        {
            "reclass" => await LoadGateAsync(ReclassTrigger()),
            "status" => await LoadGateAsync(StatusTrigger()),
            _ => null
        };
    }

    // --- Stage gates (C-07) ---
    private GateEvaluation? _gateEval;
    private readonly HashSet<Guid> _attested = new();
    private string? _gateOverride;

    /// <summary>The gate governing the reclassify modal's currently-selected target (escalations only).</summary>
    private StageGateTrigger? ReclassTrigger() =>
        _case is not null && (_case.Classification is null || _newClass > _case.Classification)
            ? StageGateTriggers.ForClassification(_newClass) : null;

    /// <summary>The Close gate when the status modal's selected phase is Closed.</summary>
    private StageGateTrigger? StatusTrigger() =>
        _case is { Phase: not CasePhase.Closed } && _newPhase == CasePhase.Closed
            ? StageGateTrigger.CloseCase : null;

    private async Task<GateEvaluation?> LoadGateAsync(StageGateTrigger? trigger)
    {
        if (trigger is not { } t) return null;
        var eval = await Cases.EvaluateGateAsync(Id, t);
        return eval.GateExists ? eval : null;
    }

    private async Task OnReclassTargetChanged()
    {
        _attested.Clear();
        _gateOverride = null;
        _gateEval = await LoadGateAsync(ReclassTrigger());
    }

    private async Task OnStatusTargetChanged()
    {
        _attested.Clear();
        _gateOverride = null;
        _gateEval = await LoadGateAsync(StatusTrigger());
    }

    private void ToggleAttest(Guid id, bool on)
    {
        if (on) _attested.Add(id); else _attested.Remove(id);
    }

    private IReadOnlyList<GateRequirementResult> UnmetBlocking =>
        _gateEval?.UnmetBlocking(_attested) ?? Array.Empty<GateRequirementResult>();

    private bool NeedsOverride => UnmetBlocking.Count > 0;

    // A gate may require a minimum-length rationale — enforced on the transition reason, and on the
    // override justification when the move is being forced through. Returns an error message, or null.
    private string? GateRationaleError(string? reason)
    {
        if (_gateEval is not { RequiresCommentary: true } g) return null;
        var min = g.CommentaryMinLength;
        if ((reason?.Trim().Length ?? 0) < min)
            return $"Record a reason of at least {min} characters to pass this gate.";
        if (NeedsOverride && (_gateOverride?.Trim().Length ?? 0) < min)
            return $"The override justification must be at least {min} characters for this gate.";
        return null;
    }

    // The gate readiness + override block shared by the reclassify and close-status modals.
    private RenderFragment GateModalSection() => @<text>
        @if (_gateEval is { } g)
        {
            <div class="mt-3">
                <GateChecklist Eval="g" Attested="_attested" OnChanged="StateHasChanged" />
                @if (NeedsOverride)
                {
                    <div class="alert alert-warning small mt-2 mb-1 py-2">
                        <span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>
                        @UnmetBlocking.Count required item@(UnmetBlocking.Count == 1 ? "" : "s") outstanding. Override with a recorded justification to proceed anyway.
                    </div>
                    <input class="form-control form-control-sm" placeholder="Override justification (required)" @bind="_gateOverride" @bind:event="oninput" />
                    @if (g.RequiresCommentary)
                    {
                        <div class="form-text @((_gateOverride?.Trim().Length ?? 0) < g.CommentaryMinLength ? "text-danger" : "text-success")">
                            @(_gateOverride?.Trim().Length ?? 0) / @g.CommentaryMinLength characters
                        </div>
                    }
                }
            </div>
        }
    </text>;

    // Live character counter shown under the transition reason when the active gate requires a
    // minimum-length rationale (the reason is what gets recorded on the gate passage).
    private RenderFragment RationaleHint(string? text) => @<text>
        @if (_gateEval is { RequiresCommentary: true } g)
        {
            <div class="form-text @((text?.Trim().Length ?? 0) < g.CommentaryMinLength ? "text-danger" : "text-success")">
                @(text?.Trim().Length ?? 0) / @g.CommentaryMinLength characters — recorded on the gate passage.
            </div>
        }
    </text>;

    private void CloseModal()
    {
        _activeModal = null;
        _modalError = null;
    }

    // Generic confirm for destructive removes: capture a message + the action to run on confirm.
    private void AskConfirm(string message, Func<Task> onConfirm) => _confirm = (message, onConfirm);
    private void CancelConfirm() => _confirm = null;

    private async Task RunConfirm()
    {
        var action = _confirm?.OnConfirm;
        _confirm = null;
        if (action is not null) await action();
    }

    private string ModalTitle() => _activeModal switch
    {
        "reclass" => _case?.Classification is null ? "Promote onto the ladder" : "Reclassify case",
