    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Attach the paste/drag-drop listeners once (idempotent in the shim; each zone only acts while
            // its wrapper is in the DOM). Evidence tab (U-39): paste + drop. Timeline tab (U-40): paste only.
            try
            {
                await JS.InvokeVoidAsync("imPasteDrop.register", "evidence-dropzone", "evidence-file-input", "evidence-file-drop");
                await JS.InvokeVoidAsync("imPasteDrop.register", "timeline-dropzone", "timeline-file-paste", null);
            }
            catch (JSException) { /* progressive enhancement — the manual picker still works */ }

            // U-14: case-local keyboard shortcuts (digit 1..8 = tab, n = new note).
            try { await JS.InvokeVoidAsync("imCaseHotkeys.register", _dotNetRef); }
            catch (JSException) { /* shortcuts are a progressive enhancement */ }
        }

        // UX-01: move focus into a modal when it opens and back to the trigger when it closes.
        if (AnyTrapModalOpen != _modalTrapArmed)
        {
            _modalTrapArmed = AnyTrapModalOpen;
            try { await JS.InvokeVoidAsync(_modalTrapArmed ? "imModal.arm" : "imModal.release"); }
            catch (JSException) { /* focus trap is a progressive enhancement */ }
        }

        await ReconcileMarkdownEditors();

        // U-14: the 'n' shortcut's caret focus is handled inside CaseNotesTab (via AutofocusComposer).
        // The entity graph render lives in CaseEntitiesTab (UX-13).
    }

    /// <summary>
    /// Reconcile the mounted EasyMDE editors against what the current view needs — now just the Overview
    /// Summary editor (the Notes and Timeline tabs own their own editors, UX-13). Mounts what is newly
    /// needed and tears down what is gone. Progressive enhancement — failures ignored.
    /// </summary>
    private async Task ReconcileMarkdownEditors()
    {
        var desired = new Dictionary<string, string>();
        if (_case is not null && _canEdit)
        {
            if (_activeTab == "Overview" && _editingDetails)
                desired[SummaryEditorId] = _edSummary ?? "";
            // Notes and Timeline editors are managed by their own tab components (UX-13), not here.
        }

        // Tear down editors no longer wanted (e.g. tab switch, cancelled edit).
        foreach (var id in _mdEditors.Where(id => !desired.ContainsKey(id)).ToList())
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); } catch (JSException) { /* ignore */ }
            _mdEditors.Remove(id);
        }
        // Mount newly-wanted editors (the seed value applies on first mount only).
        foreach (var (id, seed) in desired)
        {
            if (_mdEditors.Contains(id)) continue;
            try { await JS.InvokeVoidAsync("markdownEditor.init", id, seed); _mdEditors.Add(id); }
            catch (JSException) { /* editor is a progressive enhancement */ }
        }
    }

    /// <summary>U-14: a case-local keyboard shortcut fired by the imCaseHotkeys dispatcher.</summary>
    [JSInvokable]
    public async Task OnCaseHotkey(string cmd)
    {
        if (_case is null || string.IsNullOrEmpty(cmd)) return;

        // Ctrl/Cmd+Enter — submit the composer active on the current tab. Each add/save method guards its
        // required fields, so a submit with nothing to post is a harmless no-op.
        if (cmd == "submit")
        {
            if (!_canEdit) return;
            switch (_activeTab)
            {
                case "Notes":
                    if (_notesTab is not null) await _notesTab.SubmitAsync();
                    break;
                case "Timeline":
                    if (_timelineTab is not null) await _timelineTab.SubmitAsync();
                    break;
                case "Entities": if (_entitiesTab is not null) await _entitiesTab.SubmitAsync(); break;
                case "Tasks": await AddTask(); break;
                case "Overview": if (_editingDetails) await SaveDetails(); break;
            }
            return;
        }

        if (cmd.StartsWith("tab:", StringComparison.Ordinal)
            && int.TryParse(cmd.AsSpan(4), out var n) && n >= 1 && n <= _tabs.Length)
        {
            await SetTab(_tabs[n - 1]);
            StateHasChanged();
            return;
        }

        if (cmd == "note" && _canEdit)
        {
            _notesAutofocus = true;        // CaseNotesTab focuses its composer once mounted, then clears this
            await SetTab("Notes");
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _caseSub?.Dispose();
        if (_relativeTimeTicker is not null) await _relativeTimeTicker.DisposeAsync();
        foreach (var id in _mdEditors)
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); }
            catch { /* circuit may already be gone during teardown */ }
        }
        _mdEditors.Clear();
        try { await JS.InvokeVoidAsync("imCaseHotkeys.unregister"); }   // U-14: stop forwarding keys to this circuit
        catch { /* circuit may already be gone during teardown */ }
        _dotNetRef?.Dispose();
    }

