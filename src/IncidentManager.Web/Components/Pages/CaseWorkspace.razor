    private int? TabCount(string tab)
    {
        if (_case is null) return null;
        var n = tab switch
        {
            "Timeline" => _case.TimelineEntries.Count,
            "Entities" => _case.Entities.Count,
            "Evidence" => _case.Evidence.Count,
            "Notes" => _case.Notes.Count(x => x.IsCurrent),
            "Tasks" => _case.ActionItems.Count(a => a.Status != ActionItemStatus.Done && a.Status != ActionItemStatus.Cancelled),
            _ => -1
        };
        return n <= 0 ? null : n;
    }

