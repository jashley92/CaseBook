    // Prior versions of an Investigation entry, newest first, by walking the supersede chain.
    private List<TimelineEntry> InvestigationHistory(TimelineEntry current)
    {
        var all = _case?.TimelineEntries ?? Enumerable.Empty<TimelineEntry>();
        var history = new List<TimelineEntry>();
        var cursor = current.SupersedesEntryId;
        while (cursor is { } id && all.FirstOrDefault(x => x.Id == id) is { } prior)
        {
            history.Add(prior);
            cursor = prior.SupersedesEntryId;
        }
        return history;
    }

    private void ClearTimelineFilters()
    {
        _tlFilterType = null;
        _tlFilterTactic = null;
        _tlFilterSource = "";
    }

    private List<TimelineEntry> FilteredTimeline(IEnumerable<TimelineEntry> entries)
    {
        var view = entries
            // Filter each entry by its own kind: events by ATT&CK tactic, investigation entries by type.
            // Kind-specific filters are only surfaced (and set) in a focused lens; in All both are null.
            .Where(x => x.Kind == TimelineKind.Event
                ? (_tlFilterTactic is null || x.Tactics.Any(tac => tac.Tactic == _tlFilterTactic))
                : (_tlFilterType is null || x.Type == _tlFilterType))
            .Where(x => string.IsNullOrWhiteSpace(_tlFilterSource)
                || (x.Source ?? "").Contains(_tlFilterSource, StringComparison.OrdinalIgnoreCase))
            // OccurredAtUtc is minute-precision from the datetime-local picker, so several entries can
            // share the same value. CreatedAtUtc (sub-second, set at insert) breaks the tie so equal
            // timestamps keep submission order instead of an arbitrary DB row order.
            .OrderBy(x => x.OccurredAtUtc)
            .ThenBy(x => x.CreatedAtUtc)
            .ToList();
        if (!_tlOldestFirst) view.Reverse();
        return view;
    }

