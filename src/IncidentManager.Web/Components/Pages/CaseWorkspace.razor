    private async Task ApplyModal()
    {
        _modalError = null;
        try
        {
            string done;
            switch (_activeModal)
            {
                case "reclass":
                    if (string.IsNullOrWhiteSpace(_reclassReason)) { _modalError = "A reason is required."; return; }
                    if (NeedsOverride && string.IsNullOrWhiteSpace(_gateOverride))
                    { _modalError = "Provide a justification to override the unmet gate requirements."; return; }
                    if (GateRationaleError(_reclassReason) is { } m1) { _modalError = m1; return; }
                    await Cases.ReclassifyAsync(Id, _newClass, _reclassReason,
                        _attested.Count > 0 ? _attested : null, _gateOverride);
                    _reclassReason = "";
                    done = $"Reclassified to {Ui.Label(_newClass)}";
                    break;
                case "severity":
                    await Cases.ChangeSeverityAsync(Id, _newSeverity, _severityReason);
                    _severityReason = null;
                    done = $"Severity changed to {_newSeverity}";
                    break;
                case "status":
                    if (NeedsOverride && string.IsNullOrWhiteSpace(_gateOverride))
                    { _modalError = "Provide a justification to override the unmet gate requirements."; return; }
                    if (GateRationaleError(_phaseReason) is { } m2) { _modalError = m2; return; }
                    await Cases.ChangePhaseAsync(Id, _newPhase, _phaseReason,
                        _attested.Count > 0 ? _attested : null, _gateOverride);
                    _phaseReason = null;
                    done = $"Status changed to {Ui.Label(_newPhase)}";
                    break;
                case "legal":
                    await Cases.ReferToLegalAsync(Id, _legalContact, _legalNote);
                    done = "Referred to Legal / Privacy";
                    break;
                case "archive":
                    await Cases.SetArchivedAsync(Id, true);
                    done = "Case archived";
                    break;
                case "reopen":
                    if (string.IsNullOrWhiteSpace(_reopenReason)) { _modalError = "A reason is required."; return; }
                    await Cases.ReopenAsync(Id, _reopenReason);
                    _reopenReason = "";
                    done = "Case reopened";
                    break;
                case "assign":
                    if (string.IsNullOrWhiteSpace(_assignUserId)) { _modalError = "Select a user to assign."; return; }
                    var assignName = Users.Resolve(_assignUserId)?.DisplayName ?? _assignUserId;
                    await Cases.AssignAsync(Id, _assignUserId, assignName, _assignRole);
                    _assignUserId = "";
                    _assignRole = CaseAssignmentRole.Analyst;
                    done = $"Assigned {assignName}";
                    break;
                default:
                    done = "";
                    break;
            }
            _activeModal = null;
            await Reload();
            if (done.Length > 0) Toasts.Success(done);
        }
        catch (GateNotSatisfiedException ex)
        {
            _modalError = ex.Message;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _modalError = ex.Message;
        }
    }

    private CasePhase? NextPhase()
    {
        if (_case is null) return null;
        var phases = Enum.GetValues<CasePhase>();
        var i = Array.IndexOf(phases, _case.Phase);
        return (i >= 0 && i < phases.Length - 1) ? phases[i + 1] : null;
    }

