@code {
    [Parameter] public Guid Id { get; set; }

    // One response-SLA vital for the Overview vitals strip (E-16): containment or resolution, with
    // badge + timing. The .im-vital cell supplies the tile background, so no inner wrapper here.
    private RenderFragment SlaVital(SlaStatus st) =>
        @<div class="im-vital">
            <div class="small text-muted">@(st.Clock is { } c ? Ui.SlaClockLabel(c) : "SLA")</div>
            @if (st.State == SlaState.NoTarget)
            {
                <div class="fw-semibold text-muted">No target</div>
            }
            else
            {
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="@Ui.SlaBadge(st.State)"><span class="bi @Ui.SlaGlyph(st.State)" aria-hidden="true"></span> @Ui.SlaLabel(st.State)</span>
                    @if (Ui.SlaTiming(st) is { Length: > 0 } t) { <span class="small fw-semibold">@t</span> }
                </div>
                <div class="small text-muted mt-1">
                    Target @st.TargetHours h@(st.IsActive && st.DueAtUtc is { } due ? $" · due {TimeDisp.Short(due)}" : "")
                </div>
            }
        </div>;

    // C-05: "Viewed by" — coalesced read-sessions for this case, shown only to leads/admins (surveillance data).
    private RenderFragment ViewedByPanel() =>
        @<div class="mt-4">
            <h2 class="h6 d-flex align-items-center gap-2">
                <span class="bi bi-eye" aria-hidden="true"></span> Viewed by
                <span class="im-badge im-b-neutral rounded-pill">@(_viewedBy?.Count ?? 0)</span>
            </h2>
            <p class="small text-muted mb-2">
                Who has opened this case, coalesced into view-sessions. Access logging is out of the
                tamper-evident chain; scope is set in Administration → Settings → Access logging.
            </p>
            @if (_viewedBy is null)
            {
                <p class="small text-muted"><em>Loading&hellip;</em></p>
            }
            else if (_viewedBy.Count == 0)
            {
                <p class="small text-muted">No recorded opens yet (or access logging is off).</p>
            }
            else
            {
                <table class="table table-sm align-middle">
                    <thead><tr><th>Viewer</th><th class="text-end">Opens</th><th>First seen</th><th>Last seen</th></tr></thead>
                    <tbody>
                        @foreach (var v in _viewedBy)
                        {
                            <tr>
                                <td>@Users.DisplayFor(v.ActorUserId)@if (v.WasRestricted) { <span class="im-badge im-b-warn ms-2">restricted</span> }</td>
                                <td class="text-end">@v.Count</td>
                                <td class="small">@TimeDisp.Short(v.FirstSeenUtc)</td>
                                <td class="small">@TimeDisp.Short(v.LastSeenUtc)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>;

    /// <summary>Deep-link a specific tab, e.g. <c>?tab=Report</c>, so a link can point straight at it.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? QTab { get; set; }

    private readonly string[] _tabs = ["Overview", "Timeline", "Entities", "Evidence", "Notes", "Tasks", "Report", "Audit"];
    private string _activeTab = "Overview";

    private Case? _case;
    private bool _notFound;

    // Case-number rename (inline in the header)
    private bool _renumbering;
    private bool _savingNumber;
    private string _editNumber = "";
    private string? _renumberError;

    // Overview actions
    private bool _editingDetails;
    private string _edTitle = "";
    private string? _edSummary;
    private string? _edDetection;
    private string? _edDataTypes;
    private string? _edImpacted;
    private DateTime? _edDetected;   // wall-clock in the viewer's active display zone (U-29), like the task due-date (F-20)
    private DateTime? _edOccurred;
    private string? _detailsError;
    private Classification _newClass = Classification.Incident;
