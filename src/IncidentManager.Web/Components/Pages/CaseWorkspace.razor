                            {
                                <option value="@u.UserId">@u.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Due date</label>
                        <input type="date" class="form-control form-control-sm" @bind="_taskDueDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Time (@TimeDisp.Label)</label>
                        <input type="time" class="form-control form-control-sm" @bind="_taskDueTime"
                               title="Entered in @TimeDisp.Label. Leave blank for end of day." />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-sm btn-primary w-100" @onclick="AddTask" disabled="@string.IsNullOrWhiteSpace(_taskTitle)">Add</button>
                    </div>
                </div>
            </div>
        </AuthorizeView>

        @if (_case.ActionItems.Count == 0)
        {
            <p class="text-muted">No after-action items.</p>
        }
        else
        {
            <table class="table table-sm align-middle">
                <thead><tr><th>Task</th><th>Owner</th><th>Due</th><th>Status</th><th></th></tr></thead>
                <tbody>
                    @foreach (var t in _case.ActionItems.OrderBy(x => x.Status).ThenBy(x => x.DueAtUtc))
                    {
                        <tr class="im-enter @(t.IsOverdue(Clock.UtcNow) ? "table-danger" : "") @FlashClass(t.Id)" style="@FlashStyle(t.Id)" @key="t.Id">
                            <td>@t.Title</td>
                            <td>@Users.DisplayFor(t.Owner)</td>
                            <td>@(t.DueAtUtc is { } due ? TimeDisp.Short(due) : "—")</td>
                            <td>@t.Status</td>
                            <td>
                                <AuthorizeView Policy="@Policies.EditCases">
                                    @if (t.Status != ActionItemStatus.Done)
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => MarkTaskDone(t.Id)">Mark done</button>
                                    }
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else if (_activeTab == "Report")
    {
        <AuthorizeView Policy="@Policies.EditCases">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-5">
                            <label class="form-label small mb-0">Report profile <span class="text-muted">(section layout)</span></label>
                            <select class="form-select form-select-sm" value="@(_selectedProfileId?.ToString() ?? "")"
                                    @onchange="OnProfileChanged">
                                <option value="">Global default</option>
                                @if (_reportProfiles is not null)
                                {
                                    @foreach (var p in _reportProfiles)
                                    {
                                        <option value="@p.Id">@p.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-7">
                            @if (_profileDirty)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="SaveProfile">
                                    <span class="bi bi-save me-1"></span>Save profile choice
                                </button>
                                <span class="small text-muted ms-1">Applies to newly generated reports.</span>
                            }
                            else
                            {
                                <span class="small text-muted">Reports use this profile's sections. Manage profiles in Admin → Report profiles.</span>
                            }
                        </div>
                    </div>

                    <button class="btn btn-sm btn-outline-secondary" @onclick="TogglePreview">
                        <span class="bi bi-eye me-1"></span>@(_showPreview ? "Hide preview" : "Preview")
                    </button>
                    <button class="btn btn-sm btn-primary ms-2" @onclick="() => Generate(ReportFormat.Word)">
                        Generate Word draft
                    </button>
                    <button class="btn btn-sm btn-primary" @onclick="() => Generate(ReportFormat.Pdf)">
                        Generate PDF draft
                    </button>
                    <span class="ms-2 small text-muted">Reports are generated as drafts; a PDF becomes the locked final only when approved below.</span>
                    @if (_reportMsg is not null) { <div class="small text-muted mt-1">@_reportMsg</div> }
                </div>
            </div>

            @if (_showPreview)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><span class="bi bi-eye me-1"></span>Preview <span class="small text-muted">· what Generate / Approve will produce</span></span>
                        <button class="btn-close" aria-label="Hide preview" @onclick="TogglePreview"></button>
                    </div>
                    <div class="card-body bg-body-tertiary">
                        <ReportPreview Model="_previewModel" />
                    </div>
                </div>
            }
        </AuthorizeView>

        @if (_reports is null)
        {
            <p><em>Loading&hellip;</em></p>
        }
        else if (_reports.Count == 0)
        {
            <p class="text-muted">No reports generated yet.</p>
        }
        else
        {
            <table class="table table-sm align-middle">
                <thead><tr><th>File</th><th>Format</th><th>Ver</th><th>Status</th><th>SHA-256</th><th>Generated</th><th></th></tr></thead>
                <tbody>
                    @foreach (var r in _reports)
                    {
                        <tr>
                            <td>@r.FileName</td>
                            <td>@r.Format</td>
                            <td>@r.Version</td>
                            <td>
                                @if (r.IsFinal)
                                {
                                    <span class="im-badge im-b-ok">Final</span>
                                    <div class="small text-muted">@Users.DisplayFor(r.ApprovedBy) · @TimeDisp.Long(r.ApprovedAtUtc)</div>
                                }
                                else
                                {
                                    <span class="im-badge im-b-neutral">Draft</span>
                                }
                            </td>
                            <td><code class="small">@r.ContentSha256[..16]…</code></td>
                            <td class="small text-muted">@TimeDisp.Long(r.CreatedAtUtc)<br />@Users.DisplayFor(r.CreatedBy)</td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary" href="reports/@r.Id" target="_blank">Download</a>
