    private Severity _newSeverity = Severity.Medium;
    private string? _severityReason;
    private string _assignUserId = "";
    private CaseAssignmentRole _assignRole = CaseAssignmentRole.Analyst;
    private bool _techMatrixOpen;

    private void OpenTechMatrix() => _techMatrixOpen = true;
    private void CancelTechMatrix() => _techMatrixOpen = false;

    // The case's current technique tags as id → tactic, seeding the matrix's selection state.
    private IReadOnlyDictionary<string, MitreTactic> CurrentTechniqueMap() =>
        _case is null
            ? new Dictionary<string, MitreTactic>(StringComparer.OrdinalIgnoreCase)
            : _case.Techniques.ToDictionary(t => t.TechniqueId, t => t.Tactic, StringComparer.OrdinalIgnoreCase);

    // Sync the case's techniques to the matrix's chosen set: remove dropped tags, add new ones, and
    // re-tag any whose tactic (column) changed. AddTechniqueAsync upserts, so a tactic change is a re-add.
    private async Task ApplyTechMatrix(IReadOnlyDictionary<string, MitreTactic> desired)
    {
        _techMatrixOpen = false;
        if (_case is null) return;
        var current = _case.Techniques.ToList();

        foreach (var t in current.Where(t => !desired.ContainsKey(t.TechniqueId)))
            await Cases.RemoveTechniqueAsync(Id, t.Id);

        foreach (var kv in desired)
        {
            var existing = current.FirstOrDefault(t => string.Equals(t.TechniqueId, kv.Key, StringComparison.OrdinalIgnoreCase));
            if (existing is null)
                await Cases.AddTechniqueAsync(Id, kv.Key, AttackCatalog.Find(kv.Key)?.Name ?? "", kv.Value);
            else if (existing.Tactic != kv.Value)
                await Cases.AddTechniqueAsync(Id, kv.Key, existing.Name, kv.Value);
        }

        await Reload();
        Toasts.Success("Techniques updated");
    }
