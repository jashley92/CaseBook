    // The data-element reference set (X-03): active options for editing + a key→label map (incl. archived)
    // for display, both loaded with the case so a relabel/reorder in admin reflects here on next load.
    private IReadOnlyList<DataElement> _dataElements = Array.Empty<DataElement>();
