    /// <summary>Deep-link to a VirusTotal search for an IOC-like entity, or null when not applicable.</summary>
    private string? VirusTotalUrl(CaseEntity e)
    {
        if (!Ui.IsIocLike(e.Type) || string.IsNullOrWhiteSpace(e.Value)) return null;
        var template = Config["ExternalLinks:VirusTotalUrlTemplate"];
        if (string.IsNullOrWhiteSpace(template)) return null;
        return string.Format(template, Uri.EscapeDataString(e.Value));
    }

