@page "/cases/{Id:guid}"
@attribute [Authorize(Policy = Policies.ViewCases)]
@implements IAsyncDisposable
@inject CaseService Cases
@inject IncidentManager.Application.Activity.ActivityFeedService Feed
@inject IClock Clock
@inject IJSRuntime JS
@inject IncidentManager.Web.Services.CaseListMemory ListMemory
@inject IncidentManager.Web.Services.CommandPaletteController Palette
@inject NavigationManager Nav
@inject IAuthorizationService AuthZ
@inject IncidentManager.Application.Abstractions.ICaseChangeNotifier Notifier
@inject AuthenticationStateProvider AuthState
@inject IConfiguration Config
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IncidentManager.Application.Content.IMarkdownService Md
@inject ISeverityLabels SevLabels
@inject ToastService Toasts
@inject TimeDisplay TimeDisp
@inject IncidentManager.Application.Sla.ISlaTargetsProvider SlaProvider
@inject IncidentManager.Application.Compliance.NotificationDeadlineService Deadlines
@inject IncidentManager.Application.Abstractions.ICurrentUser CurrentUser
@inject IncidentManager.Application.Access.IAccessLogService AccessLog
@inject IncidentManager.Web.Services.CaseCommandRegistry PaletteActions
@inject IncidentManager.Application.Cases.CaseShortcutService Shortcuts
@inject IncidentManager.Application.Evidence.EvidenceService EvidenceSvc
@inject IncidentManager.Application.Admin.CaseOutcomeService Outcomes

<PageTitle>@(_case?.CaseNumber ?? "Case")</PageTitle>

@if (_notFound)
{
    <div class="empty-state my-5">
        <div class="empty-state-icon"><span class="bi bi-folder-x" aria-hidden="true"></span></div>
        <h1 class="h4 mb-2">Case not found</h1>
        <p class="text-muted mb-3">It may have been archived, or it's restricted to its case team. Ask its incident commander if you need access.</p>
        <div class="d-flex justify-content-center gap-2">
            <a class="btn btn-primary" href="@ListMemory.BackHref">Back to cases</a>
            <button type="button" class="btn btn-outline-secondary" @onclick="Palette.Open">Search cases</button>
        </div>
    </div>
}
else if (_case is null)
{
    <LoadingBlock Rows="8" Columns="3" Label="Loading the case…" />
}
else
{
    @* UX-08: consistent back affordance — the "Cases" crumb replaces the old "← All cases" button. *@
    <Breadcrumbs Items="@(new Crumb[] { new("Cases", ListMemory.BackHref), new(_case.CaseNumber) })" />
    @* FR-05: warn before leaving the case (in-app SPA nav) with unsubmitted composer text. The browser-level
       beforeunload guard in markdown-editor.js covers refresh / tab-close / external nav; this covers a
       sidebar or case-link click the SPA router handles without a page unload. *@
    <NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNav" />
    @* REL-07: the case was archived/restricted out from under us while a composer held unsubmitted text.
       Rather than swap to the "not found" page (which would discard the draft), we hold the last-known
       workspace and warn so the viewer can copy their text out first. *@
    @if (_accessLost)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
            <span class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></span>
            <div>
                <div class="fw-semibold">This case was archived or your access to it changed while you had it open.</div>
                <div class="small mb-0">Your unsaved text is still on screen. Copy anything you need now, because changes can no longer be saved to this case. <a href="cases">Back to cases</a>.</div>
            </div>
        </div>
    }
    @* REL-08: this user's permission to act on the case changed since it loaded (a live re-check, or the
       server refusing an action). Edit controls are demoted; tell the viewer why and how to refresh. *@
    @if (_permissionLost && !_accessLost)
    {
        <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
            <span class="bi bi-shield-lock mt-1" aria-hidden="true"></span>
            <div>
                <div class="fw-semibold">Your access to this case has changed.</div>
                <div class="small mb-0">Some actions are no longer available to you.
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="() => Nav.NavigateTo(Nav.Uri, forceLoad: true)">Reload the page</button>
                    to refresh your view.</div>
            </div>
        </div>
    }
    @* S-21: a view-only role sees the case without edit controls; say so, rather than leave them wondering where the
       controls went, and say who can change things. *@
    @if (!_canEdit && !_permissionLost && !_accessLost)
    {
        <div class="im-viewonly small mb-2" role="note">
            <span class="bi bi-eye" aria-hidden="true"></span>
            <span><strong>View only.</strong> @ViewOnlyText</span>
        </div>
    }
    @* FR-17: wrap so the action group (Advance / Actions) drops below the title on a phone instead of
       overflowing the row and forcing whole-page horizontal scroll. *@
    <div id="ws-head" class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div class="im-casehead-main">
            @* INV-02: the case number and its title share one line, and the state (badges, phase, next step)
               shares the next, so the tabs start about half as far down the page. *@
            <div class="im-casehead-line">
            <h1 class="mb-0">
                <code class="im-casehead-num">@_case.CaseNumber</code>
                @if (_canEdit && !_renumbering)
                {
                    <button class="btn btn-sm btn-link p-0 ms-1 align-baseline" title="Change case number" aria-label="Change case number" @onclick="StartRenumber">
                        <span class="bi bi-pencil" aria-hidden="true"></span>
                    </button>
                }
            </h1>
            @if (_renumbering)
            {
                <div class="d-flex align-items-center gap-2 mb-2" style="max-width:32rem">
                    <input class="form-control form-control-sm font-monospace" @bind="_editNumber" @bind:event="oninput" @bind:after="CheckRenumberAvailable"
                           placeholder="Case number" aria-label="Case number" />
                    <button class="btn btn-sm btn-primary" @onclick="SaveRenumber" disabled="@(_savingNumber || _renumberAvailable == false)">Save</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelRenumber">Cancel</button>
                </div>
                @* FR-22: flag a collision as the analyst types, not only when they click Save. *@
                @if (_renumberAvailable == false)
                {
                    <div class="text-danger small mb-2"><span class="bi bi-x-circle me-1" aria-hidden="true"></span>“@_editNumber?.Trim()” is already in use.</div>
                }
                else if (_renumberAvailable == true)
                {
                    <div class="text-success small mb-2"><span class="bi bi-check-circle me-1" aria-hidden="true"></span>Available.</div>
                }
            }
            @if (_renumberError is not null)
            {
                <div class="text-danger small mb-2">@_renumberError</div>
            }
            @* A pasted-in, very long title would push the tabs off screen: show one line, click for the rest. *@
            <div class="im-casehead-title @(_titleExpanded ? "" : "im-clamp-1")" title="@(_titleExpanded ? null : _case.Title)"
                 @onclick="() => _titleExpanded = !_titleExpanded">@_case.Title</div>
            </div>
        </div>
        @* ms-auto: when a long case number pushes these onto their own line they stay at the right edge, so the
           right-anchored Actions menu opens into view instead of off the left of the screen. *@
        <div class="d-flex align-items-center gap-2 ms-auto">
            <CasePresence CaseId="_case.Id" />
            @* INV-02: the next step sits with the case's actions, so the phase stepper fits beside the badges. *@
            @if (_canEdit && NextPhase() is { } np)
            {
                <button class="btn btn-sm btn-primary" @onclick="() => AdvanceTo(np)">Advance to @Ui.Label(np) →</button>
            }
            @if (_canEdit && _case.Phase == CasePhase.Closed)
            {
                <button class="btn btn-sm btn-outline-primary" @onclick='() => OpenModal("reopen")'>
                    <span class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></span>Reopen case
                </button>
            }
            @* PROD-20: pin this case so it's one keystroke away (palette) and on My Work. Personal, any viewer. *@
            <button type="button" class="btn btn-sm @(_isPinned ? "btn-warning" : "btn-outline-secondary")"
                    title="@(_isPinned ? "Unpin this case" : "Pin this case for quick access")"
                    aria-pressed="@Ui.Aria(_isPinned)" aria-label="@(_isPinned ? "Unpin this case" : "Pin this case")"
                    @onclick="TogglePin">
                <span class="bi @(_isPinned ? "bi-pin-angle-fill" : "bi-pin-angle")" aria-hidden="true"></span>
            </button>
            @if (_canAnyAction)
            {
                <div class="dropdown">
                    @* FR-19: transparent full-viewport backdrop (behind the menu, above the page) so a click
                       anywhere outside closes the custom dropdown — it has no Bootstrap Popper/blur to do it. *@
                    @if (_actionsOpen)
                    {
                        <div style="position:fixed;inset:0;z-index:999" @onclick="() => _actionsOpen = false"></div>
                    }
                    <button id="case-actions-btn" class="btn btn-sm btn-outline-primary dropdown-toggle" @onclick="() => _actionsOpen = !_actionsOpen">Actions</button>
                    <div class="dropdown-menu dropdown-menu-end @(_actionsOpen ? "show" : "")">
                        @if (_canReclassify) { <button class="dropdown-item" @onclick='() => OpenModal("reclass")'>@(_case.Classification is null ? "Promote onto the ladder…" : "Reclassify…")</button> }
                        @if (_canEdit)
                        {
                            @if (!_case.Assignments.Any(a => string.Equals(a.UserId, _myId, StringComparison.OrdinalIgnoreCase)))
                            {
                                <button class="dropdown-item" @onclick="AssignToMe">Assign to me</button>
                            }
                            <button class="dropdown-item" @onclick='() => OpenModal("handoff")'>Hand off…</button>
                            <button class="dropdown-item" @onclick='() => OpenModal("severity")'>Change severity…</button>
                            <button class="dropdown-item" @onclick='() => OpenModal("status")'>Change phase…</button>
                            <button class="dropdown-item" @onclick='() => OpenModal("legal")'>Refer to Legal / Privacy…</button>
                            @* FR-07: the materiality determination gates closing an Incident/Breach, and the
                               analyst who owns the case's timeline/data is the one who records it — so it needs
                               EditCases, not ManageLegal (which only Legal/Privacy hold, and Legal doesn't use the
                               app). The determination stays hash-chained/audited, so who made the call is on record. *@
                            @if (_case.Classification is Classification.Incident or Classification.Breach)
                            {
                                <button class="dropdown-item" @onclick='() => OpenModal("materiality")'>Record materiality determination…</button>
                            }
                        }
                        @if (_canEdit && _case.Phase != CasePhase.Closed)
                        {
                            @* PROD-11: supersede this case by the one work continues on (link + optional IOC copy + notes). *@
                            <button class="dropdown-item" @onclick='() => OpenModal("supersede")'>Supersede as a duplicate…</button>
                        }
                        @* S-08: need-to-know. Anyone who can edit may restrict; only the IC or a cleared role may lift it. *@
                        @if (_canEdit && !_case.IsRestricted)
                        {
                            <button class="dropdown-item" @onclick='() => OpenModal("restrict")'>Restrict to need-to-know…</button>
                        }
                        else if (_canEdit && CanLiftRestriction)
                        {
                            <button class="dropdown-item" @onclick='() => OpenModal("unrestrict")'>Lift restriction…</button>
                        }
                        @if (_canManageLegal)
                        {
                            @if (_case.LegalHold && Cases.LegalHoldReleaseNeedsSecondApprover)
                            {
                                @* F-12: two-person release — request it; a second person approves from the banner. *@
                                @if (!_case.LegalHoldReleasePending)
                                {
                                    <button class="dropdown-item" @onclick='() => OpenModal("holdrelease")'>Request legal hold release…</button>
                                }
                            }
                            else
                            {
                                @* S-15: releasing asks first and needs a reason; placing a hold (protective) stays one click. *@
                                @if (_case.LegalHold)
                                {
                                    <button class="dropdown-item" @onclick='() => OpenModal("holdrelease")'>Release legal hold…</button>
                                }
                                else
                                {
                                    <button class="dropdown-item" @onclick="() => SetLegalHold(true)">Place legal hold</button>
                                }
                            }
                        }
                        @if (_canAdmin)
                        {
                            <div class="dropdown-divider"></div>
                            @if (_case.IsArchived)
                            {
                                <button class="dropdown-item" @onclick="() => SetArchived(false)">Restore from archive</button>
                            }
                            else
                            {
                                <button class="dropdown-item text-danger" @onclick='() => OpenModal("archive")'>Archive case…</button>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* INV-38: the case's state as one line that reads as a sentence (classification · severity, the phase, quiet
       flags). The clocks live in the context panel; an alert chip stands in for them only where the panel isn't
       beside the tab. *@
    <div class="im-casehead-state">@StateLine(slim: false)</div>

    @* INV-04: what other people changed since this viewer last had the case open, with a one-click view of it. *@
    @if (_sinceCount > 0 && !_sinceDismissed && _lastViewed is { } lastViewed)
    {
        <div class="im-since small mb-2" role="status">
            <span class="bi bi-clock-history" aria-hidden="true"></span>
            <span>
                <strong>@IncidentManager.Application.Common.Plural.Of(_sinceCount, "change")</strong>
                since you last viewed this case (@TimeDisp.Short(lastViewed))@(_sincePeople.Count > 0 ? $", by {string.Join(", ", _sincePeople)}" : "").
            </span>
            <button type="button" class="btn btn-sm btn-link p-0" @onclick="ShowSinceOnTimeline">Show on the timeline</button>
            <button type="button" class="btn-close ms-auto" aria-label="Dismiss" @onclick="() => _sinceDismissed = true"></button>
        </div>
    }

    @* F-12: a pending two-person legal-hold release. Anyone can see it; Manage Legal can approve (not the
       requester) or withdraw it. *@
    @if (_case.LegalHold && _case.LegalHoldReleasePending)
    {
        <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2 py-2" role="status">
            <span class="bi bi-unlock" aria-hidden="true"></span>
            <span>
                <strong>Legal hold release requested</strong> by @Users.DisplayFor(_case.LegalHoldReleaseRequestedBy)
                @if (_case.LegalHoldReleaseRequestedAtUtc is { } at) { <span>&nbsp;· @TimeDisp.Short(at)</span> }
                <span class="d-block small">Reason: @_case.LegalHoldReleaseReason</span>
            </span>
            @if (_canManageLegal)
            {
                var own = string.Equals(_case.LegalHoldReleaseRequestedBy, CurrentUser.UserId, StringComparison.OrdinalIgnoreCase);
                <span class="ms-auto d-flex gap-2">
                    <button class="btn btn-sm btn-dark" @onclick="ApproveHoldRelease" disabled="@own"
                            title="@(own ? "Two-person control: someone else must approve your request" : "Release the legal hold")">Approve release</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelHoldRelease">Withdraw request</button>
                </span>
            }
        </div>
    }

    @* Design review P4: the tabs stay under the top bar while the case scrolls, and once the header above has
       scrolled away a one-line bar keeps the case's identity, state and next step in view. *@
    <div id="ws-sticky" class="ws-sticky mb-3">
        <div class="ws-slim" aria-hidden="true">
            <code class="im-casehead-num">@_case.CaseNumber</code>
            @StateLine(slim: true)
            <span class="ws-slim-title text-muted">@_case.Title</span>
            @if (_canEdit && NextPhase() is { } snp)
            {
                <button class="btn btn-sm btn-primary ms-auto" tabindex="-1" @onclick="() => AdvanceTo(snp)">Advance to @Ui.Label(snp) →</button>
            }
        </div>
    <ul class="nav nav-tabs im-workspace-tabs">
        @foreach (var tab in _tabs)
        {
            var _tabNo = (Array.IndexOf(_tabs, tab) + 1) % 10;   // U-14: the digit shortcut for this tab (the 10th is 0)
            @if (tab is "Tasks" or "Review" or "Audit")
            {
                @* INV-02: the record tabs, then the work (tasks), then what's built from them (lessons, report),
                   then the audit trail. *@
                <li class="im-tab-sep" aria-hidden="true"></li>
            }
            <li class="nav-item">
                <button class="nav-link @(_activeTab == tab ? "active" : "") @(TabQuiet(tab) ? "im-tab-quiet" : "")" @onclick="() => SetTab(tab)"
                        title="@($"Shortcut: {_tabNo}")">
                    @TabLabel(tab)@{ var _tc = TabCount(tab); }@if (_tc is { } cnt) { <span class="im-badge im-b-neutral ms-1 im-bump" @key="@($"{tab}:{cnt}")">@cnt</span> }@if (TabHasNew(tab)) { <span class="tab-newdot" title="New activity from a collaborator" aria-label="New activity"></span> }@if (TabWhy(tab) is { } why) { <span class="im-tab-why">@why</span> }
                </button>
            </li>
        }
        <li class="nav-item ms-auto im-rail-toggle">
            <button type="button" class="nav-link" aria-pressed="@Ui.Aria(_railOpen)" @onclick="() => _railOpen = !_railOpen"
                    title="@(_railOpen ? "Hide the case context panel" : "Show the case context panel")">
                <span class="bi @(_railOpen ? "bi-layout-sidebar-inset-reverse" : "bi-layout-sidebar-reverse")" aria-hidden="true"></span>
                <span class="visually-hidden">@(_railOpen ? "Hide" : "Show") case context</span>
            </button>
        </li>
    </ul>
    </div>

    @* INV-11: an entity in context, over whatever tab is open. *@
    <EntityPanel Case="_case" EntityId="_panelEntity" OnClose="CloseEntityPanel" CanEdit="_canEdit" OnChanged="Reload"
                          OnShowOnTimeline="ShowEntityOnTimeline" OnGoToTab="EntityPanelGoTo" />

    @if (_confirm is not null)
    {
        <div class="modal d-block im-trap" tabindex="-1" role="dialog" aria-modal="true"
             aria-labelledby="im-confirm-title" style="background:var(--im-scrim)"
             @onclick="CancelConfirm" @onkeydown="OnModalEscape">
            <div class="modal-dialog" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="im-confirm-title">@ConfirmTitle</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CancelConfirm"></button>
                    </div>
                    <div class="modal-body"><p class="mb-0">@_confirm.Value.Message</p></div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" @onclick="CancelConfirm">Cancel</button>
                        <button class="btn btn-danger" @onclick="RunConfirm">@ConfirmVerb</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* FR-05: confirm before leaving the case with unsubmitted composer text (in-app navigation). *@
    @if (_confirmLeaveOpen)
    {
        <div class="modal d-block im-trap" tabindex="-1" role="dialog" aria-modal="true"
             aria-labelledby="im-leave-title" style="background:var(--im-scrim)"
             @onclick="CancelLeave" @onkeydown="OnModalEscape">
            <div class="modal-dialog" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="im-leave-title">Discard unsaved text?</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CancelLeave"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-0">You have text on this case that hasn't been saved. If you leave now, it's lost.</p>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" @onclick="CancelLeave">Stay on this page</button>
                        <button class="btn btn-danger" @onclick="ConfirmLeave">Leave &amp; discard</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* U-40: screenshot lightbox — preview an attached screenshot in place instead of forcing a download. *@
    @if (_previewShotId is { } previewId)
    {
        <div class="modal d-block im-trap" tabindex="-1" role="dialog" aria-modal="true"
             aria-labelledby="im-shot-title" style="background:var(--im-scrim)"
             @onclick="CloseShot" @onkeydown="OnModalEscape">
            <div class="modal-dialog modal-xl modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h5 class="modal-title" id="im-shot-title"><span class="bi bi-image me-2" aria-hidden="true"></span>Screenshot</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseShot"></button>
                    </div>
                    <div class="modal-body text-center bg-body-tertiary" style="max-height:75vh;overflow:auto">
                        <img src="evidence/@previewId/inline" alt="Attached screenshot"
                             style="max-width:100%;height:auto;border-radius:.375rem" />
                    </div>
                    <div class="modal-footer py-2">
                        <a class="btn btn-outline-primary" href="evidence/@previewId" target="_blank" rel="noopener noreferrer">
                            <span class="bi bi-download me-1" aria-hidden="true"></span>Download
                        </a>
                        <button class="btn btn-outline-secondary" @onclick="CloseShot">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Keyed by the active tab so the subtree is rebuilt on a tab switch, replaying the .tabbody
       fade-in (U-22 motion). The key doesn't change on case/id navigation, so switching cases
       doesn't force an extra remount. *@
    @* INV-12: on wide screens the case's context sits beside every tab. *@
    <div class="ws-body @(_railOpen ? "ws-body-rail" : "")">
    <div class="tabbody" @key="_activeTab">
    @* REL-01: a per-tab error boundary. Because .tabbody is @key'd on the active tab, switching tabs mounts
       a fresh boundary — so a tab that throws shows a contained "this tab couldn't load" fallback (the case
       header, tab bar and other tabs stay usable) and recovers when you switch away and back, with no manual
       reset wiring. This sits inside the layout's page-level boundary, which catches anything outside a tab. *@
    <ErrorBoundary>
    <ChildContent>
    @if (_activeTab == "Overview")
    {
        @* UX-13: extracted to CaseOverviewTab. It owns the Summary EasyMDE editor (so the central reconcile
           retires) + details/impact/techniques/links/history; the parent threads the retention alert, the
           readiness gate, the shared confirm dialog, the assign modal (OnOpenModal), and hotkey dispatch. *@
        @* INV-29: where the panel isn't beside the tab (narrow screens, or hidden), its content is a strip here. *@
        <CaseContextRail Strip="true" AlwaysStrip="!_railOpen" Case="_case" Notify="_notifyDeadlines" CanEdit="_canEdit"
                         OnOpenEntity="OpenEntity" OnGoToTab="SetTab" OnAssign='() => OpenModal("assign")' OnUnassign="UnassignFromPanel" />
        <CaseOverviewTab @ref="_overviewTab" Case="_case" CaseId="_case.Id" TaskResults="_taskResults" OutcomeLabels="_outcomeLabels" CanEdit="_canEdit" CanLiftRestriction="@(_canEdit && CanLiftRestriction)"
                         RetentionMessage="@_retentionMsg" ReadinessEval="_readinessEval"
                         OnChanged="Reload" RequestConfirm="OnChildRequestConfirm" OnOpenModal="OpenModal"
                         OnFix="FixGateItem" OnGoToTab="SetTab" OnShowSince="ShowSinceAt" RefreshToken="_liveRefresh" />
    }
    else if (_activeTab == "Timeline")
    {
        @* UX-13: extracted to CaseTimelineTab. It owns its Investigation EasyMDE editor; the parent keeps
           the flash, the screenshot lightbox (OnPreview→OpenShot), the Ctrl+Enter hotkey (via @ref), the
           paste-shim registration (element ids kept in the child), and the live-collab "new entries" pill. *@
        <CaseTimelineTab @ref="_timelineTab" Case="_case" CaseId="_case.Id" TaskResults="_taskResults" OutcomeLabels="_outcomeLabels" CanEdit="_canEdit" CanChangeClassification="_canReclassify"
                         DetectionLabel="@DetectionLabel" OnChanged="Reload" OnPreview="OpenShot"
                         FlashClass="FlashClass" FlashStyle="FlashStyle" ComposerDrafts="_composerDrafts"
                         ChangedSinceUtc="_timelineSince" OnClearSince="() => _timelineSince = null"
                         PresetEntityFilter="_timelineEntity" OnOpenEntity="OpenEntity"
                         AutofocusComposer="_timelineAutofocus" OnAutofocusHandled="() => _timelineAutofocus = false" />
        @* U-32: a floating "jump to what just arrived" pill when a collaborator adds timeline entries. *@
        @if (_newTimelineIds.Count > 0)
        {
            <button type="button" class="tl-newpill" @onclick="JumpToNewTimeline">
                <span class="bi bi-arrow-down-circle" aria-hidden="true"></span>
                @_newTimelineIds.Count new @(_newTimelineIds.Count == 1 ? "entry" : "entries")
            </button>
        }
    }
    else if (_activeTab == "Entities")
    {
        @* UX-13: extracted to CaseEntitiesTab. It owns the vis-network graph interop (its own
           DotNetObjectReference + [JSInvokable] OnNodesMoved) and entity/relationship CRUD; the parent keeps
           the shared confirm dialog (RequestConfirm→AskConfirm), the flash, and hotkey dispatch (@ref). *@
        <CaseEntitiesTab @ref="_entitiesTab" Case="_case" CaseId="_case.Id" CanEdit="_canEdit"
                         OnChanged="Reload" RequestConfirm="OnChildRequestConfirm" FocusEntityId="QEntity" OnOpenEntity="OpenEntity"
                         FlashClass="FlashClass" FlashStyle="FlashStyle" RefreshToken="_liveRefresh" />
    }
    else if (_activeTab == "Evidence")
    {
        @* UX-13: extracted to CaseEvidenceTab. The screenshot lightbox (OpenShot) + live-collab flash stay
           in this parent and are threaded in; the paste/drop shim is still registered by this component's
           OnAfterRenderAsync against the element IDs the child keeps (evidence-dropzone / -file-input / -file-drop). *@
        <CaseEvidenceTab CaseId="_case.Id" EvidenceItems="_case.Evidence" Citations="_case.Citations" OnPreview="OpenShot"
                         OnChanged="Reload" FlashClass="FlashClass" FlashStyle="FlashStyle" CanEdit="_canEdit" Tasks="_case.ActionItems"
                         BriefText="@CurrentBriefText()" />
    }
    else if (_activeTab == "Notes")
    {
        @* UX-13: extracted to CaseNotesTab. It owns its EasyMDE editors (so the central reconcile no longer
           carries a Notes branch); the parent keeps the flash + the Ctrl+Enter / 'n' hotkeys (dispatched to
           the child via @ref / AutofocusComposer) and reloads the case after a write. *@
        <CaseNotesTab @ref="_notesTab" CaseId="_case.Id" Notes="_case.Notes" Entities="_case.Entities" Tasks="_case.ActionItems" CanEdit="_canEdit" Promoted="PromotedSources()"
                      OnChanged="Reload" FlashClass="FlashClass" FlashStyle="FlashStyle" ComposerDrafts="_composerDrafts"
                      AutofocusComposer="_notesAutofocus" OnAutofocusHandled="() => _notesAutofocus = false" FocusNoteId="QNote" />
    }
    else if (_activeTab == "Tasks")
    {
        @* UX-13: extracted to CaseTasksTab. Self-loads its playbooks and builds due-dates; the parent keeps
           the flash and hotkey dispatch (@ref) and reloads the case after a write. *@
        <CaseTasksTab @ref="_tasksTab" Case="_case" CaseId="_case.Id" TaskResults="_taskResults" CanEdit="_canEdit" OnOpenEntity="OpenEntity" OnGoToTab="SetTab" OnFocusItem="FocusItem"
                      OnChanged="Reload" FlashClass="FlashClass" FlashStyle="FlashStyle" RefreshToken="_liveRefresh" OnAdvancePhase="AdvanceWithResult"
                      AutofocusComposer="_tasksAutofocus" OnAutofocusHandled="() => _tasksAutofocus = false" />
    }
    else if (_activeTab == "Review")
    {
        @* E-26/PROD-41: post-incident review + improvement actions + the separate lessons-learned report.
           Self-loading; RefreshToken re-loads it on a collaborator's change. *@
        <CaseReviewTab @ref="_reviewTab" CaseId="_case.Id" Classification="_case.Classification" CanEdit="_canEdit"
                       Entities="_case.Entities" OnChanged="Reload" RefreshToken="_liveRefresh" />
    }
    else if (_activeTab == "Report")
    {
        @* UX-13: extracted to CaseReportTab. Self-lists reports/profiles; _reportState (parent-held) keeps
           the preview open across tab switches; _liveRefresh re-lists on collaborator changes; OnCaseChanged
           reloads the case after a profile save / generate so the rest of the workspace stays in sync. *@
        <CaseReportTab CaseId="_case.Id" CaseProfileId="_case.ReportProfileId" State="_reportState"
                       RefreshToken="_liveRefresh" OnCaseChanged="Reload" />
    }
    else if (_activeTab == "Audit")
    {
        @* UX-13: extracted to CaseAuditTab. Loads its own trail; _auditFilter (parent-held) keeps the
           analyst's filters across tab switches; _liveRefresh re-queries when a collaborator edits. *@
        <CaseAuditTab CaseNumber="@_case.CaseNumber" CaseId="_case.Id" CanViewAll="_canViewAll"
                      State="_auditFilter" RefreshToken="_liveRefresh" />
    }
    </ChildContent>
    <ErrorContent>
        <ErrorFallback Scope="ErrorFallback.ErrorScope.Section" SectionName="@TabLabel(_activeTab)" />
    </ErrorContent>
    </ErrorBoundary>
    </div>@* /.tabbody *@
    @if (_railOpen)
    {
        <CaseContextRail Case="_case" Notify="_notifyDeadlines" CanEdit="_canEdit" OnOpenEntity="OpenEntity" OnGoToTab="SetTab"
                         OnAssign='() => OpenModal("assign")' OnUnassign="UnassignFromPanel" NextAsSummary='_activeTab == "Overview"' />
    }
    </div>@* /.ws-body *@

    @* Action modal — rendered outside the tab blocks so Actions works on every tab, not just Overview. *@
    @if (_activeModal is not null)
    {
        <div class="modal d-block im-trap" tabindex="-1" role="dialog" aria-modal="true"
             aria-labelledby="im-action-title" data-return-focus="#case-actions-btn"
             style="background:var(--im-scrim)" @onclick="CloseModal" @onkeydown="OnModalEscape">
            <div class="modal-dialog" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="im-action-title">@ModalTitle()</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (_activeModal == "reclass")
                        {
                            @if (_case?.Classification is null)
                            {
                                <p class="small text-muted mb-2">This <strong>Complex Event</strong> hasn't been triaged yet. Promoting it gives it its first formal classification.</p>
                            }
                            <label class="form-label small" for="ws-reclass-to">@(_case?.Classification is null ? "Promote to" : "New classification")</label>
                            <select id="ws-reclass-to" class="form-select mb-2" @bind="_newClass" @bind:after="OnReclassTargetChanged">@foreach (var c in Enum.GetValues<Classification>()) { <option value="@c">@Ui.Label(c)</option> }</select>
                            <label class="form-label small" for="ws-reclass-reason">Reason <span class="text-muted">(required)</span></label>
                            <input id="ws-reclass-reason" class="form-control" placeholder="e.g. new evidence confirms data was exfiltrated" @bind="_reclassReason" @bind:event="oninput" />
                            @RationaleHint(_reclassReason)
                            @WhenItHappened()
                            @GateModalSection()
                        }
                        else if (_activeModal == "handoff")
                        {
                            @* INV-15: a structured handoff, prefilled from the record; edit freely. *@
                            <label class="form-label small mb-0" for="ws-ho-to">Hand the case to</label>
                            <select id="ws-ho-to" class="form-select form-select-sm mb-2" @bind="_hoTo">
                                <option value="">Choose a person…</option>
                                @* INV-37: only people who can see the case (on a restricted one: its IC, team and cleared roles). *@
                                @foreach (var u in _hoPeople.OrderBy(u => u.DisplayName))
                                {
                                    <option value="@u.UserId">@u.DisplayName</option>
                                }
                            </select>
                            <label class="form-label small mb-0" for="ws-ho-state">Where it stands</label>
                            <textarea id="ws-ho-state" class="form-control form-control-sm mb-2" rows="3" @bind="_hoState" @bind:event="oninput"></textarea>
                            <label class="form-label small mb-0" for="ws-ho-done">Done since the last handoff</label>
                            <textarea id="ws-ho-done" class="form-control form-control-sm mb-2" rows="3" @bind="_hoDone" @bind:event="oninput"></textarea>
                            <label class="form-label small mb-0" for="ws-ho-open">Still open</label>
                            <textarea id="ws-ho-open" class="form-control form-control-sm mb-2" rows="3" @bind="_hoOpen" @bind:event="oninput"></textarea>
                            <label class="form-label small mb-0" for="ws-ho-watch">Watch for <span class="text-muted">(optional)</span></label>
                            <textarea id="ws-ho-watch" class="form-control form-control-sm mb-2" rows="2" @bind="_hoWatch" @bind:event="oninput"
                                      placeholder="e.g. if the other two users' sign-ins show new locations, re-open the scope with Privacy"></textarea>
                            <div class="form-check small">
                                <input class="form-check-input" type="checkbox" id="ws-ho-post" @bind="_hoPost" />
                                <label class="form-check-label" for="ws-ho-post">Email it to them</label>
                            </div>
                            <div class="form-check small">
                                <input class="form-check-input" type="checkbox" id="ws-ho-tasks" @bind="_hoTasks" />
                                <label class="form-check-label" for="ws-ho-tasks">Give them my open tasks on this case (@MyOpenTaskCount)</label>
                            </div>
                            <p class="small text-muted mt-2 mb-0">Recorded on the timeline as a handoff.</p>
                        }
                        else if (_activeModal == "severity")
                        {
                            <label class="form-label small" for="ws-severity">New severity</label>
                            <select id="ws-severity" class="form-select mb-2" @bind="_newSeverity">@foreach (var s in Enum.GetValues<Severity>()) { <option value="@s">@SevLabels.For(s)</option> }</select>
                            var raising = _case is { } sc && _newSeverity > sc.Severity;
                            <input class="form-control" maxlength="500" placeholder="@(raising ? "Why is it going up? (required)" : Backdated ? "Reason (required when recording later)" : "Reason (optional)")" aria-label="Reason" @bind="_severityReason" @bind:event="oninput" />
                            @WhenItHappened()
                        }
                        else if (_activeModal == "status")
                        {
                            <label class="form-label small" for="ws-status">New status</label>
                            <select id="ws-status" class="form-select mb-2" @bind="_newPhase" @bind:after="OnStatusTargetChanged">@foreach (var p in Enum.GetValues<CasePhase>()) { <option value="@p">@Ui.Label(p)</option> }</select>
                            @if (Closing)
                            {
                                @ClosingSection()
                            }
                            else
                            {
                                <label class="form-label small" for="ws-status-reason">@(_case is { } cs && _newPhase > cs.Phase ? "What was achieved" : "Reason") <span class="text-muted">@(_gateEval is { RequiresCommentary: true } || Backdated ? "(required)" : "(optional)")</span></label>
                                <input id="ws-status-reason" class="form-control" placeholder="e.g. containment verified across all affected hosts" @bind="_phaseReason" @bind:event="oninput" />
                                @RationaleHint(_phaseReason)
                            }
                            @WhenItHappened()
                            @NotificationWarning()
                            @OpenTasksWarning()
                            @GateModalSection()
                        }
                        else if (_activeModal == "supersede")
                        {
                            <p class="small text-muted mb-2">Marks this case as a duplicate of the one work continues on, links the two and adds a
                                note to both. You then close this case as usual.</p>
                            <label class="form-label small mb-1" for="ws-supersede-query">Case to keep</label>
                            @if (_supersedeTargetId is not null)
                            {
                                <div class="alert alert-info py-1 px-2 small d-flex align-items-center gap-2 mb-2">
                                    <span>Keeping <code>@_supersedeTargetNumber</code></span>
                                    <button type="button" class="btn btn-link btn-sm p-0 ms-auto" @onclick="() => _supersedeTargetId = null">Change</button>
                                </div>
                            }
                            else
                            {
                                @foreach (var l in _supersedeLinked)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1 mb-1" @onclick="() => PickSupersedeTarget(l.OtherCaseId, l.OtherCaseNumber)">
                                        <span class="bi bi-link-45deg" aria-hidden="true"></span> @l.OtherCaseNumber <span class="text-muted">(@Ui.CaseLinkLabel(l.Type, l.Outgoing))</span>
                                    </button>
                                }
                                <div class="input-group input-group-sm mb-1">
                                    <input id="ws-supersede-query" class="form-control" placeholder="Search by case number or title" @bind="_supersedeQuery" @bind:event="oninput"
                                           @onkeydown="@(async e => { if (e.Key == "Enter") await SearchSupersede(); })" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="SearchSupersede">Search</button>
                                </div>
                                @foreach (var r in _supersedeResults)
                                {
                                    <button type="button" class="btn btn-sm btn-link d-block text-start p-0 mb-1" @onclick="() => PickSupersedeTarget(r.Id, r.CaseNumber)">
                                        <code>@r.CaseNumber</code> <span class="text-muted">@r.Title</span>
                                    </button>
                                }
                            }
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" id="supersede-copy" @bind="_supersedeCopy" />
                                <label class="form-check-label small" for="supersede-copy">Copy this case's indicators to the kept case (ones already there are skipped)</label>
                            </div>
                            <label class="form-label small mt-2" for="supersede-reason">Why it's a duplicate</label>
                            <textarea id="supersede-reason" class="form-control" rows="2" @bind="_supersedeReason" @bind:event="oninput"
                                      placeholder="e.g. Same phishing wave; the user report and the SIEM alert were filed separately"></textarea>
                        }
                        else if (_activeModal == "restrict")
                        {
                            <p class="small mb-2">Restricting limits who can see this case. Once restricted:</p>
                            <ul class="small mb-2">
                                <li>@_clearanceNote</li>
                                <li>It disappears for everyone else: case lists, search, My Work, dashboards, the indicator and ATT&amp;CK
                                    views, and exports.</li>
                                <li>Assigning someone later gives them access, and removing them takes it away.</li>
                                <li>Opening it, or downloading its evidence or reports, is flagged at a higher severity in the SIEM stream.</li>
                            </ul>
                            @if (!RestrictKeepsMe)
                            {
                                <div class="alert alert-info py-1 px-2 small mb-2">You'll be added to the case team as an analyst so you keep access.</div>
                            }
                            <label class="form-label small" for="restrict-reason">Reason <span class="text-muted">(optional, recorded in the audit trail)</span></label>
                            <textarea id="restrict-reason" class="form-control" rows="2" maxlength="1000" @bind="_restrictReason" @bind:event="oninput"
                                      placeholder="e.g. Insider investigation involving a named employee; HR and counsel only"></textarea>
                        }
                        else if (_activeModal == "unrestrict")
                        {
                            <p class="small mb-2">Lifting the restriction opens this case to <strong>everyone with case access</strong>. It will show up in
                                their case lists, search, dashboards and exports.</p>
                            <label class="form-label small" for="unrestrict-reason">Reason</label>
                            <textarea id="unrestrict-reason" class="form-control" rows="2" maxlength="1000" @bind="_restrictReason" @bind:event="oninput"
                                      placeholder="e.g. Counsel confirmed the case no longer needs to be restricted"></textarea>
                        }
                        else if (_activeModal == "holdrelease")
                        {
                            @if (Cases.LegalHoldReleaseNeedsSecondApprover)
                            {
                                <p class="small text-muted mb-2">Two-person control is on, so this sends a release request. The hold stays in force
                                    until someone else with Manage Legal approves it from the case.</p>
                            }
                            else
                            {
                                <p class="small mb-2">Once released, the case is no longer exempt from your retention policy and an administrator
                                    can archive it. Release it only after counsel confirms preservation is no longer required.</p>
                            }
                            <label class="form-label small" for="hold-release-reason">Reason</label>
                            <textarea id="hold-release-reason" class="form-control" rows="3" maxlength="1000" @bind="_holdReleaseReason" @bind:event="oninput"
                                      placeholder="e.g. Litigation settled; counsel confirmed preservation is no longer required"></textarea>
                        }
                        else if (_activeModal == "legal")
                        {
                            <label class="form-label small" for="legal-contact">Legal contact <span class="text-muted">(optional)</span></label>
                            <input id="legal-contact" class="form-control mb-2" placeholder="Name or team" @bind="_legalContact" />
                            <label class="form-label small" for="legal-note">Regulatory relevance <span class="text-muted">(optional)</span></label>
                            <input id="legal-note" class="form-control" placeholder="e.g. NY NPI" @bind="_legalNote" />
                        }
                        else if (_activeModal == "materiality")
                        {
                            <p class="small text-muted mb-2">Record <strong>who</strong> made the call (the SOC, Legal / Privacy or a disclosure committee), when, and why.
                                A final determination needs all three. An Incident or Breach can't close while this is open.</p>
                            <WhyThisMatters Class="mb-2">
                                A determination can start disclosure clocks (for SEC registrants, a Form 8-K is due within four business days),
                                and your notification deadlines may count from it. The record shows the call was made deliberately and on time.
                            </WhyThisMatters>
                            <label class="form-label small" for="ws-mat-status">Determination</label>
                            <select id="ws-mat-status" class="form-select mb-2" @bind="_materialityStatus">
                                <option value="@MaterialityStatus.UnderReview">Under review (with Legal / committee)</option>
                                <option value="@MaterialityStatus.Material">Material</option>
                                <option value="@MaterialityStatus.NotMaterial">Not material</option>
                            </select>
                            <label class="form-label small" for="ws-mat-maker">Decision-maker <span class="text-muted">@(MaterialityIsFinal ? "(required)" : "(optional)")</span></label>
                            <input id="ws-mat-maker" class="form-control mb-2" placeholder="e.g. Disclosure Committee, General Counsel" @bind="_materialityDecisionMaker" />
                            <label class="form-label small" for="ws-mat-date">Decision date <span class="text-muted">@(MaterialityIsFinal ? "(required)" : "(optional)")</span></label>
                            <input id="ws-mat-date" type="date" class="form-control mb-2" @bind="_materialityDecidedOn" />
                            <label class="form-label small" for="ws-mat-rationale">Rationale <span class="text-muted">@(MaterialityIsFinal ? "(required)" : "(optional)")</span></label>
                            <textarea id="ws-mat-rationale" class="form-control" rows="2" placeholder="Why the case is or isn't material" @bind="_materialityRationale"></textarea>
                        }
                        else if (_activeModal == "archive")
                        {
                            <p class="mb-0">Archive <code>@_case.CaseNumber</code>? It's hidden from active queues and can be restored later.</p>
                        }
                        else if (_activeModal == "reopen")
                        {
                            <p class="small text-muted mb-2">Reopen <code>@_case.CaseNumber</code>? It returns to the phase it was in before closing and the closure time is cleared. Closing it again re-runs the close gate.</p>
                            <label class="form-label small" for="ws-reopen-reason">Reason <span class="text-muted">(required)</span></label>
                            <input id="ws-reopen-reason" class="form-control" placeholder="Why is this case being reopened?" @bind="_reopenReason" @bind:event="oninput" />
                        }
                        else if (_activeModal == "assign")
                        {
                            @if (AssignableUsers() is { Count: 0 })
                            {
                                <p class="text-muted small mb-0">There's no one in the directory to assign.</p>
                            }
                            else
                            {
                                <label class="form-label small" for="ws-assign-user">Person</label>
                                <select id="ws-assign-user" class="form-select mb-2" @bind="_assignUserId" @bind:after="OnAssignUserChanged">
                                    <option value="">Select a person…</option>
                                    @foreach (var u in AssignableUsers())
                                    {
                                        var current = CurrentRole(u.UserId);
                                        <option value="@u.UserId">@u.DisplayName@(current is { } r ? $" (now {Ui.Label(r)})" : "")</option>
                                    }
                                </select>
                                @if (_case.IsRestricted)
                                {
                                    <p class="small text-muted mb-2"><span class="bi bi-lock-fill" aria-hidden="true"></span> This case is restricted:
                                        assigning someone gives them access to it.</p>
                                }
                                <label class="form-label small" for="ws-assign-role">Role on this case</label>
                                <select id="ws-assign-role" class="form-select" @bind="_assignRole">
                                    @foreach (var r in Enum.GetValues<CaseAssignmentRole>())
                                    {
                                        <option value="@r">@Ui.Label(r)</option>
                                    }
                                </select>
                            }
                        }
                        @if (_modalError is not null) { <p class="text-danger small mt-2 mb-0">@_modalError</p> }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" @onclick="CloseModal">Cancel</button>
                        <button class="@(_activeModal == "archive" ? "btn btn-danger" : "btn btn-primary")" @onclick="ApplyModal" disabled="@ModalPrimaryDisabled()">@ModalPrimaryLabel()</button>
                    </div>
                </div>
            </div>
        </div>
    }
    @* UX-13: the ATT&CK matrix picker now lives in CaseOverviewTab (which owns technique tagging). *@
}

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>Deep-link a specific tab, e.g. <c>?tab=Report</c>, so a link can point straight at it.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? QTab { get; set; }

    /// <summary>Deep-link a specific entity (from an inline entity tag chip): <c>?entity={guid}</c> opens it in the
    /// entity panel (INV-11) over the current tab, and focuses its row when the Entities tab is open.</summary>
    [SupplyParameterFromQuery(Name = "entity")] public Guid? QEntity { get; set; }

    /// <summary>INV-37: deep-link one note (a mention email's link): <c>?tab=Notes&amp;note={guid}</c> brings it into view.</summary>
    [SupplyParameterFromQuery(Name = "note")] public Guid? QNote { get; set; }

    private readonly string[] _tabs = ["Overview", "Timeline", "Entities", "Evidence", "Notes", "Tasks", "Review", "Report", "Audit"];
    private string _activeTab = "Overview";

    // UX-19: each tab string is the stable routing key (?tab=, inline entity-chip deep-links, TabCount /
    // SubmitAsync / feed keys), so it stays "Entities"; this maps a key to its display label so the bar can
    // read in SOC vocabulary without touching any of that wiring.
    private static string TabLabel(string tab) => tab switch
    {
        "Entities" => "IOCs & entities",
        "Review" => "Lessons learned",
        _ => tab,
    };

    private Case? _case;
    // HR-02: each task's latest recorded result, shown under brief questions, on tasks and on timeline task chips.
    private IReadOnlyDictionary<Guid, IncidentManager.Application.Cases.TaskResult> _taskResults = new Dictionary<Guid, IncidentManager.Application.Cases.TaskResult>();
    private bool _notFound;

    // Case-number rename (inline in the header)
    private bool _renumbering;
    private bool _savingNumber;
    private string _editNumber = "";
    private string? _renumberError;
    // FR-22: inline availability of the typed number (debounced), null when blank / unchanged / unchecked.
    private bool? _renumberAvailable;
    private CancellationTokenSource? _renumberCheckCts;

    private async Task CheckRenumberAvailable()
    {
        // Retire the previous keystroke's check (cancel + dispose its source) before starting a new one, so
        // a burst of typing doesn't leak a CancellationTokenSource per keystroke (S2930). The token below is
        // captured into a local so this method never touches a source a later call may have disposed.
        if (_renumberCheckCts is not null)
        {
            await _renumberCheckCts.CancelAsync();   // S6966: async cancel (schedules callbacks off-thread)
            _renumberCheckCts.Dispose();
            _renumberCheckCts = null;
        }

        var v = _editNumber?.Trim();
        if (string.IsNullOrEmpty(v) || string.Equals(v, _case.CaseNumber, StringComparison.Ordinal))
        {
            _renumberAvailable = null;
            return;
        }

        var cts = _renumberCheckCts = new CancellationTokenSource();
        var token = cts.Token;
        try
        {
            await Task.Delay(350, token); // debounce keystrokes
            var ok = await Cases.IsCaseNumberAvailableAsync(v, _case.Id, token);
            if (!token.IsCancellationRequested) { _renumberAvailable = ok; StateHasChanged(); }
        }
        catch (OperationCanceledException) { /* superseded by a newer keystroke */ }
    }

    // Overview: the tab is extracted to CaseOverviewTab (UX-13), which owns details/impact/techniques/links
    // + the Summary editor. The parent keeps a ref for hotkey dispatch (Ctrl+Enter save).
    private CaseOverviewTab? _overviewTab;

    // Action-modal edit buffers (reclass / severity / status / legal / assign) — parent-owned modals.
    private Classification _newClass = Classification.Incident;
    private string _reclassReason = "";
    private CasePhase _newPhase = CasePhase.Triage;
    private string? _phaseReason;

    // INV-05: when a transition actually happened (wall clock, display zone). Defaults to the moment the dialog
    // opened; left untouched it means "now", so an ordinary change is stored exactly as before.
    private DateTime? _when;
    private DateTime? _whenDefault;
    private string? _reopenReason;
    private Severity _newSeverity = Severity.Medium;
    private string? _severityReason;
    private string _assignUserId = "";
    private CaseAssignmentRole _assignRole = CaseAssignmentRole.Analyst;
    private string? _legalContact;
    private string? _holdReleaseReason;   // F-12

    // S-21: the view-only note — which role(s) the user has, what they can still do here, and who can change the case.
    private string ViewOnlyText
    {
        get
        {
            var roles = Ui.OrderRoles(CurrentUser.RoleNames).Select(Ui.RoleLabel).ToList();
            var who = roles.Count switch { 0 => "Your access", 1 => $"Your role ({roles[0]})", _ => $"Your roles ({string.Join(", ", roles)})" };
            var legal = _canManageLegal ? " Legal actions (referral, legal hold) are in the Actions menu." : "";
            return $"{who} can read this case and comment on its tasks, but can't edit it.{legal} " +
                   "Ask the incident commander or an administrator if you need edit access.";
        }
    }

    // S-08: need-to-know restriction.
    private string? _restrictReason;
    private bool _canViewRestricted;
    private string _clearanceNote = "";

    /// <summary>The IC or a cleared role may lift a restriction (mirrors CaseRestrictionPolicy.CanLift).</summary>
    private bool CanLiftRestriction => _canViewAll || _canViewRestricted
