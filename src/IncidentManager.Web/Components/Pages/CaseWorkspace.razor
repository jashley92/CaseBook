    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        _myId = CurrentUser.UserId;
        await RefreshPermissionsAsync();
        // S-10: an open session's permissions can be refreshed in place; re-check the edit affordances when they are.
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;

        // Live collaboration: refresh when another analyst changes this case.
        _caseSub = Notifier.Subscribe(Id, OnCaseChangedAsync);

        // PROD-19: publish this case's action verbs to the command palette. The provider is a closure over
        // live state, so the palette reflects the case as it currently is (permissions, next phase, hold state).
        // Owner-guarded (see CaseCommandRegistry): MainLayout re-keys this page subtree on a time-zone change,
        // so a fresh instance registers before the old one disposes — pass `this` so teardown clears only ours.
        PaletteActions.Set(this, BuildPaletteActions);

        // U-32: a 30s heartbeat re-renders so relative times ("2m ago") stay live without a reload.
        _relativeTimeTicker = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task OnCaseChangedAsync(string actorId)
    {
        await InvokeAsync(async () =>
        {
            if (_accessLost) return; // REL-07: already holding the workspace for a copy-out — don't churn it

            var hadCase = _case is not null;
            var prevKnown = _knownIds; // U-30: snapshot before Reload re-seeds, so we can diff what appeared

            // REL-07: a live-collab change can be an archive/restrict that removes this case from under the
            // viewer. Peek before swapping the view: if it vanished while a composer still holds unsubmitted
            // text, don't yank the workspace out to the "not found" page (which unmounts the editors and
            // silently discards the draft — the FR-05 guard only covers navigation). Hold the workspace with
            // a banner so the viewer can copy the text out first.
            var refreshed = await Cases.GetDetailAsync(Id);
            if (refreshed is null && hadCase && await AnyDraftDirtyAsync())
            {
                _accessLost = true;
                StateHasChanged();
                return;
            }

            await ReloadWith(refreshed);
            await RefreshPermissionsAsync(); // REL-08: demote the UI if this user's access was revoked mid-session
            _liveRefresh++; // UX-13: signal extracted tabs to re-query the case (an in-progress edit in a
                            // tab component survives, since the component isn't re-created by a reload)
            await SetTab(_activeTab); // refresh the visible tab's data
            FlagNewItems(prevKnown, actorId); // U-30: flash / pulse / toast a collaborator's additions
            StateHasChanged();
        });
    }

    // --- U-30: live-collaboration motion --------------------------------------------------------
    // When another analyst adds something to this case, the diff of item ids (before/after reload)
    // tells us exactly what appeared. Each new item flashes in the adder's presence colour; if it
    // landed on a tab you aren't viewing, that tab pulses; and a toast names who added what. A
    // viewer's own additions don't echo, because Reload() re-seeds _knownIds before the notice lands.
    private readonly Dictionary<Guid, (int Hue, string Tab)> _flash = new(); // item id -> flash state
    private readonly Dictionary<string, int> _newOnTab = new();              // tab -> unseen new count
    private readonly HashSet<Guid> _newTimelineIds = new();                  // U-32: unseen new timeline entries
    private HashSet<Guid> _knownIds = new();
    private string? _myId;

    private string FlashClass(Guid id) => _flash.ContainsKey(id) ? "im-flash" : "";
    private string? FlashStyle(Guid id) => _flash.TryGetValue(id, out var f) ? $"--flash-hue:{f.Hue}" : null;
    private bool TabHasNew(string tab) => tab != _activeTab && _newOnTab.GetValueOrDefault(tab) > 0;

    private readonly record struct FeedItem(Guid Id, string Tab, string Kind);

    private IEnumerable<FeedItem> CurrentItems()
    {
        if (_case is null) yield break;
        foreach (var x in _case.TimelineEntries.Where(t => t.IsCurrent)) yield return new FeedItem(x.Id, "Timeline", "timeline entry");
        foreach (var x in _case.Entities) yield return new FeedItem(x.Id, "Entities", "entity");
        foreach (var x in _case.Evidence) yield return new FeedItem(x.Id, "Evidence", "evidence item");
        foreach (var x in _case.Notes.Where(n => n.IsCurrent)) yield return new FeedItem(x.Id, "Notes", "note");
        foreach (var x in _case.ActionItems) yield return new FeedItem(x.Id, "Tasks", "task");
    }

    private void SeedKnownIds() => _knownIds = CurrentItems().Select(i => i.Id).ToHashSet();

    private void FlagNewItems(HashSet<Guid> prevKnown, string actorId)
    {
        if (prevKnown.Count == 0) return; // first population — nothing to diff against yet
        var added = CurrentItems().Where(i => !prevKnown.Contains(i.Id)).ToList();
        if (added.Count == 0) return; // e.g. a status change, or the viewer's own edit already absorbed

        var hue = Ui.AvatarHue(actorId);
        foreach (var it in added)
        {
            _flash[it.Id] = (hue, it.Tab);
            if (!string.Equals(it.Tab, _activeTab, StringComparison.OrdinalIgnoreCase))
                _newOnTab[it.Tab] = _newOnTab.GetValueOrDefault(it.Tab) + 1;
            if (it.Tab == "Timeline") _newTimelineIds.Add(it.Id); // U-32: feeds the "jump to new" pill
        }

        // Attribution toast — never announce your own change back to you.
        if (!string.Equals(actorId, _myId, StringComparison.OrdinalIgnoreCase))
            Toasts.Info($"{Users.DisplayFor(actorId)} {ActivityToast.Compose(added.Select(i => i.Kind))}");

        // Items already visible on the active tab have been seen — start their fade now.
        var visible = added.Where(i => string.Equals(i.Tab, _activeTab, StringComparison.OrdinalIgnoreCase))
                           .Select(i => i.Id).ToList();
        if (visible.Count > 0) _ = ClearFlashesAfter(visible);
    }

    private async Task ClearFlashesAfter(List<Guid> ids)
    {
        await Task.Delay(TimeSpan.FromSeconds(4)); // outlasts the ~3.6s flash animation, then clears the class
        await InvokeAsync(() =>
        {
            var changed = false;
            foreach (var id in ids) changed |= _flash.Remove(id);
            if (changed) StateHasChanged();
        });
    }

    // --- U-32: "jump to what just arrived" on the timeline, and a heartbeat that keeps relative
    // times ("2m ago") advancing on their own without a reload. ---
    private async Task JumpToNewTimeline()
    {
        var target = _newTimelineIds.FirstOrDefault();
        _newTimelineIds.Clear();
        if (target != Guid.Empty)
        {
            try { await JS.InvokeVoidAsync("imMotion.scrollToId", $"tl-{target}"); }
            catch { /* circuit/JS not ready — the pill still cleared */ }
        }
    }

    private System.Threading.Timer? _relativeTimeTicker;

    protected override async Task OnParametersSetAsync()
    {
        await Reload();
        _panelEntity = QEntity;   // INV-11: an entity tag link opens the entity panel
        // Honor an explicit ?tab=, otherwise refresh whatever tab is already active. The Id can change
        // under a reused component (e.g. following an "also in" cross-case link) while the active tab
        // stays the same, so always reload the active tab's data rather than only on a tab-name change.
        var tab = _tabs.FirstOrDefault(t => string.Equals(t, QTab, StringComparison.OrdinalIgnoreCase)) ?? _activeTab;
        await SetTab(tab);
        // U-30: a fresh case view starts with a clean slate — nothing is "new" until a collaborator acts.
        _flash.Clear();
        _newOnTab.Clear();
        _newTimelineIds.Clear();
        // FR-02: a different case starts with a clean draft slate; within the same case (e.g. an entity
        // deep-link that re-runs OnParametersSetAsync) keep any in-progress composer text.
        if (_draftsCaseId != Id) { _composerDrafts.Clear(); _draftsCaseId = Id; }
    }

    private async Task Reload() => await ReloadWith(await Cases.GetDetailAsync(Id));

    // REL-07: reload from an already-fetched detail, so the live-collab path can peek at accessibility
    // before deciding whether to swap the view away (see OnCaseChangedAsync).
    private async Task ReloadWith(Case? detail)
    {
        _case = detail;
        _notFound = _case is null;
        _taskResults = _case is null ? new Dictionary<Guid, IncidentManager.Application.Cases.TaskResult>()
            : await Cases.GetTaskResultsAsync(_case.Id);
        // HR-01: outcome labels (admin-managed) for the header and the Closed milestone; only closed cases show one.
        if (_case?.StatusChanges.Any(s => s.OutcomeKey is not null) == true && _outcomeLabels.Count == 0)
            _outcomeLabels = await Outcomes.LabelsAsync();
        // C-05: record the authorized case-detail open (best-effort; coalesced into a view-session).
        if (_case is not null)
        {
            // INV-04: read when this viewer last had the case open before recording this visit, once per case.
            if (_sinceCheckedFor != _case.Id)
            {
                _sinceCheckedFor = _case.Id;
                _sinceDismissed = false;
                _timelineSince = null;
                _sinceCount = 0;
                _sincePeople = [];
                _lastViewed = await AccessLog.LastViewedAsync(_case.Id);
                if (_lastViewed is { } lv)
                    (_sinceCount, _sincePeople) = await Feed.ChangesSinceAsync(_case.Id, lv);
            }
            // HR-15: a closed case says openly what changed after it closed (it isn't locked).
            _afterClosure = _case.Phase == CasePhase.Closed ? await Feed.ChangesAfterClosureAsync(_case.Id) : null;
            await AccessLog.RecordCaseOpenAsync(_case.Id, _case.CaseNumber, _case.IsRestricted);
            _isPinned = await Shortcuts.IsPinnedAsync(_case.Id); // PROD-20: header star + palette action state
        }
        _newClass = _case?.Classification ?? Classification.Incident;
        _newPhase = _case?.Phase ?? CasePhase.Triage;
        _newSeverity = _case?.Severity ?? Severity.Medium;
        // PROD-07: headline regulatory-notification deadline for the header badge (null when the feature is off).
        _notifyDeadlines = _case is null ? null : await Deadlines.EvaluateAsync(Id);
        // Readiness is computed here and passed to CaseOverviewTab for the stage-readiness card.
        _readinessEval = NextGateTrigger() is { } t ? await LoadGateAsync(t) : null;
        SeedKnownIds(); // U-30: absorb the current items so a viewer's own edits don't echo back as "new"
    }

    // --- Overview "Stage readiness" card: the gate for this case's next likely transition (passed to the tab) ---
    private GateEvaluation? _readinessEval;

    // PROD-07: the case's evaluated regulatory-notification deadlines (null when the feature is off).
    private IncidentManager.Application.Compliance.CaseNotificationDeadlines? _notifyDeadlines;

    /// <summary>The gate a case is heading toward next, given its current classification/phase.</summary>
    private StageGateTrigger? NextGateTrigger()
    {
        if (_case is null || _case.Phase == CasePhase.Closed) return null;
        return _case.Classification switch
        {
            null => StageGateTrigger.PromoteToAdverseEvent,
            Classification.AdverseEvent => StageGateTrigger.EscalateToIncident,
            Classification.Incident => StageGateTrigger.EscalateToBreach,
            Classification.Breach => StageGateTrigger.CloseCase,
            _ => null
        };
    }

    // INV-41: bring one item into view on its tab (a task's "about" chip): switch to the tab, flash the item the way a
    // new arrival flashes, and scroll to it once it's rendered.
    private string? _scrollToId;
    private async Task FocusItem((string Tab, Guid Id) target)
    {
        _flash[target.Id] = (Ui.AvatarHue(_myId ?? ""), target.Tab);
        _scrollToId = (target.Tab switch { "Timeline" => "tl-", "Notes" => "note-", _ => "ev-" }) + target.Id;   // HR-17: notes
        await SetTab(target.Tab);   // clears the flash a moment after it's seen
    }

    private async Task SetTab(string tab)
    {
        _activeTab = tab;
        // U-30: viewing a tab clears its "new" pulse; any items flashing there fade a moment after they're seen.
        _newOnTab.Remove(tab);
        var seen = _flash.Where(kv => string.Equals(kv.Value.Tab, tab, StringComparison.OrdinalIgnoreCase))
                         .Select(kv => kv.Key).ToList();
        if (seen.Count > 0) _ = ClearFlashesAfter(seen);
        // Reflect the active tab in the URL (?tab=) so a refresh / bookmark reopens the same tab instead of
        // snapping back to Overview. We use history.replaceState rather than NavigationManager so this doesn't
        // fire a Blazor navigation (which would reload the whole case on every tab click). The one-shot
        // ?entity= deep-link is cleared once consumed. No-ops during prerender (JS not yet available).
        await SyncTabUrl(tab);
        // Overview, Audit, Report, Entities, and Tasks self-load in their extracted tab components (UX-13).
    }

    private async Task SyncTabUrl(string tab)
    {
        try
        {
            var url = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["tab"] = tab,
                ["entity"] = null,
            });
            await JS.InvokeVoidAsync("history.replaceState", null, "", url);
        }
        catch (JSException) { /* circuit/JS not ready */ }
        catch (InvalidOperationException) { /* prerendering — JS interop unavailable */ }
    }

    private async Task OpenModal(string name)
    {
        if (_case is null) return;
        _activeModal = name;
        _modalError = null;
        _actionsOpen = false;
        // Reclassifying is almost always an escalation, so the picker starts on the next rung up (the first rung
        // for a Complex Event); a Breach, the top, starts on itself. Picking a lower rung is still one change.
        _newClass = _case.Classification switch
        {
            null => Classification.AdverseEvent,
            Classification.AdverseEvent => Classification.Incident,
            Classification.Incident => Classification.Breach,
            var c => c.Value,
        };
        _newSeverity = _case.Severity;
        _newPhase = _case.Phase;
        _when = _whenDefault = UtcToWall(Clock.UtcNow);

        if (name == "holdrelease") _holdReleaseReason = null;   // don't carry a cancelled attempt's text over
        if (name == "handoff")
        {
            _hoPeople = await Cases.MentionableAsync(Id);
            PrefillHandoff();
        }

        if (name is "restrict" or "unrestrict")
        {
            _restrictReason = null;
            var roles = await Cases.GetRestrictedClearanceRolesAsync();
            _clearanceNote = roles.Count > 0
                ? $"Only its incident commander, the people assigned to it and anyone with {Ui.RolePhrase(roles)} can open it."
                : "Only its incident commander and the people assigned to it can open it.";
        }

        if (name == "supersede")
        {
            _supersedeTargetId = null; _supersedeTargetNumber = null; _supersedeQuery = null; _supersedeReason = null;
            _supersedeCopy = true; _supersedeResults = [];
            // Cases already linked to this one are the likely "keep" candidates (a DuplicateOf link first).
            _supersedeLinked = (await Cases.GetCaseLinksAsync(Id))
                .OrderByDescending(l => l.Type == CaseLinkType.DuplicateOf && l.Outgoing).ToList();
        }

        // Open the assign form clean (a prior cancelled attempt may have left a stale selection).
        if (name == "assign") { _assignUserId = ""; _assignRole = CaseAssignmentRole.Analyst; }

        // REL-02: prefill the Legal-referral form from the current referral (edit-in-place) and capture the
        // optimistic-concurrency baseline, so a concurrent referral edit isn't silently overwritten.
        if (name == "legal")
        {
            _legalContact = _case.LegalReferral.ReferredToContact;
            _legalNote = _case.LegalReferral.RegulatoryRelevanceNote;
            _legalBaseline = _case.LegalReferralConcurrencyStamp();
        }

        // Prefill the materiality form from the current determination (edit-in-place); default a fresh one
        // to "Under review" rather than the Undetermined baseline the picker doesn't offer.
        if (name == "materiality")
        {
            var m = _case.Materiality;
            _materialityStatus = m.Status == MaterialityStatus.Undetermined ? MaterialityStatus.UnderReview : m.Status;
            _materialityDecisionMaker = m.DecisionMaker;
            _materialityDecidedOn = m.DecidedOnUtc?.UtcDateTime.Date;
            _materialityRationale = m.Rationale;
            _materialityBaseline = _case.MaterialityConcurrencyStamp(); // REL-02: optimistic-concurrency baseline
        }

        _attested.Clear();
        _gateOverride = null;
        _gateEval = name switch
        {
            "reclass" => await LoadGateAsync(ReclassTrigger()),
            "status" => await LoadGateAsync(StatusTrigger()),
            _ => null
        };
    }

    // --- Stage gates (C-07) ---
    private GateEvaluation? _gateEval;
    private readonly HashSet<Guid> _attested = new();
    private string? _gateOverride;

    /// <summary>The gate governing the reclassify modal's currently-selected target (escalations only).</summary>
    private StageGateTrigger? ReclassTrigger() =>
        _case is not null && (_case.Classification is null || _newClass > _case.Classification)
            ? StageGateTriggers.ForClassification(_newClass) : null;

    /// <summary>The Close gate when the status modal's selected phase is Closed.</summary>
    private StageGateTrigger? StatusTrigger() =>
        _case is { Phase: not CasePhase.Closed } && _newPhase == CasePhase.Closed
            ? StageGateTrigger.CloseCase : null;

    private async Task<GateEvaluation?> LoadGateAsync(StageGateTrigger? trigger)
    {
        if (trigger is not { } t) return null;
        // HR-01: closing writes the summary from the closing brief, so the summary check is met by it.
        var eval = await Cases.EvaluateGateAsync(Id, t, summaryProvided: t == StageGateTrigger.CloseCase);
        return eval.GateExists ? eval : null;
    }

    private async Task OnReclassTargetChanged()
    {
        _attested.Clear();
        _gateOverride = null;
        _gateEval = await LoadGateAsync(ReclassTrigger());
    }

    private async Task OnStatusTargetChanged()
    {
        _attested.Clear();
        _gateOverride = null;
        _gateEval = await LoadGateAsync(StatusTrigger());
        if (Closing) await PrepareClosingAsync();
    }

    // --- HR-01: closing records an outcome and the closing brief ---
    private bool Closing => _activeModal == "status" && _newPhase == CasePhase.Closed && _case is { Phase: not CasePhase.Closed };
    private List<IncidentManager.Application.Admin.CaseOutcomeView> _outcomes = [];
    private string? _closeOutcome, _closeSummary, _closeConclusion;
    private Guid? _closePrefilledFor;
    private IReadOnlyDictionary<string, string> _outcomeLabels = new Dictionary<string, string>();
    private string OutcomeLabel(string key) =>
        _outcomeLabels.GetValueOrDefault(key) ?? IncidentManager.Application.Admin.CaseOutcomeCatalog.Label(key);

    private async Task PrepareClosingAsync()
    {
        _outcomes = await Outcomes.ListActiveAsync();
        if (_case is null || _closePrefilledFor == _case.Id) return;
        // Start from the current brief, so the analyst edits what's there into the conclusion instead of retyping it.
        var brief = _case.Briefs.FirstOrDefault(b => b.IsCurrent);
        _closeSummary = brief?.Summary ?? _case.Summary;
        _closeConclusion = brief?.WorkingAssessment;
        _closeOutcome = null;
        _closePrefilledFor = _case.Id;
    }

    private RenderFragment ClosingSection() => @<text>
        <label class="form-label small" for="ws-close-outcome">Outcome <span class="text-muted">(required)</span></label>
        <select id="ws-close-outcome" class="form-select mb-1" @bind="_closeOutcome">
            <option value="">Choose what the case concluded…</option>
            @foreach (var o in _outcomes)
            {
                <option value="@o.Key">@o.Label</option>
            }
        </select>
        @if (_outcomes.FirstOrDefault(o => o.Key == _closeOutcome)?.Description is { Length: > 0 } hint)
        {
            <div class="form-text mt-0 mb-2">@hint</div>
        }
        <label class="form-label small mt-1" for="ws-close-summary">What happened <span class="text-muted">(required · the case summary, printed in the report)</span></label>
        <textarea id="ws-close-summary" class="form-control mb-2" rows="3" maxlength="@CaseBrief.MaxPartLength"
                  @bind="_closeSummary" @bind:event="oninput"></textarea>
        <label class="form-label small" for="ws-close-conclusion">Conclusion <span class="text-muted">(required · what the team concluded, and on what basis; was the working assessment)</span></label>
        <textarea id="ws-close-conclusion" class="form-control mb-1" rows="3" maxlength="@CaseBrief.MaxPartLength"
                  placeholder="e.g. Account takeover with preparation for payment fraud. No other user affected; no payment made."
                  @bind="_closeConclusion" @bind:event="oninput"></textarea>
        @RationaleHint(_closeConclusion)
        <div class="small text-muted mb-2">Saved as the brief's closing version. Known and the open questions carry over.</div>
        @ClosingQuestions()
    </text>;

    // The brief's open questions and whether each has an answer (HR-02), so a conclusion that rests on an unanswered
    // question is visible before closing. Advisory: the analyst can answer it on the Tasks tab or close anyway.
    private RenderFragment ClosingQuestions() => @<text>
        @{
            var brief = _case?.Briefs.FirstOrDefault(b => b.IsCurrent);
            var questions = brief is null ? null : IncidentManager.Application.Cases.CaseNext.Questions(brief.OpenQuestions);
        }
        @if (questions is { Count: > 0 })
        {
            <div class="small fw-semibold mb-1">Open questions</div>
            <ul class="im-close-q">
                @foreach (var q in questions)
                {
                    var title = Md.ToPlainText(q).Replace('\n', ' ').Trim();
                    var task = _case!.ActionItems.Where(t => t.RaisedFromBriefId is not null && string.Equals(t.Title, title, StringComparison.OrdinalIgnoreCase))
                        .OrderByDescending(t => t.Status == ActionItemStatus.Done).ThenByDescending(t => t.CreatedAtUtc).FirstOrDefault();
                    var answered = task is { Status: ActionItemStatus.Done } && _taskResults.ContainsKey(task.Id);
                    <li class="@(answered ? "im-close-q-ok" : "im-close-q-open")">
                        <span>@title</span>
                        @if (answered)
                        {
                            <span class="d-block text-muted">@IncidentManager.Application.Cases.TaskResults.Excerpt(_taskResults[task!.Id].Text)</span>
                        }
                        else
                        {
                            <span class="d-block">No answer recorded. Answer it on the Tasks tab, or say in the conclusion why it doesn't matter.</span>
                        }
                    </li>
                }
            </ul>
        }
    </text>;

    private void ToggleAttest(Guid id, bool on)
    {
        if (on) _attested.Add(id); else _attested.Remove(id);
    }

    private IReadOnlyList<GateRequirementResult> UnmetBlocking =>
        _gateEval?.UnmetBlocking(_attested) ?? Array.Empty<GateRequirementResult>();

    private bool NeedsOverride => UnmetBlocking.Count > 0;

    // A gate may require a minimum-length rationale — enforced on the transition reason, and on the
    // override justification when the move is being forced through. Returns an error message, or null.
    private string? GateRationaleError(string? reason)
    {
        if (_gateEval is not { RequiresCommentary: true } g) return null;
        var min = g.CommentaryMinLength;
        if ((reason?.Trim().Length ?? 0) < min)
            return $"Record a reason of at least {min} characters to pass this gate.";
        if (NeedsOverride && (_gateOverride?.Trim().Length ?? 0) < min)
            return $"The override justification needs at least {min} characters.";
        return null;
    }

    // The gate readiness + override block shared by the reclassify and close-status modals.
    private RenderFragment GateModalSection() => @<text>
        @if (_gateEval is { } g)
        {
            <div class="mt-3">
                <GateChecklist Eval="g" Attested="_attested" OnChanged="StateHasChanged" OnFix="FixGateItem" />
                @if (NeedsOverride)
                {
                    <div class="alert alert-warning small mt-2 mb-1 py-2">
                        <span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>
                        @{ var toTick = UnmetBlocking.Count(r => r.Kind == GateRequirementKind.Attestation); var toFix = UnmetBlocking.Count - toTick; }
                        @UnmetBlocking.Count required item@(UnmetBlocking.Count == 1 ? "" : "s") not met.
                        @if (toFix == 0)
                        {
                            <span>Tick @(toTick == 1 ? "it" : "them") above if @(toTick == 1 ? "it's" : "they're") true, or enter an override justification to proceed anyway.</span>
                        }
                        else if (toTick > 0)
                        {
                            <span>Tick the statements above that are true. To proceed with anything still unmet, enter an override justification.</span>
                        }
                        else
                        {
                            <span>To proceed anyway, enter an override justification.</span>
                        }
                    </div>
                    <input class="form-control form-control-sm" placeholder="Override justification (required)" aria-label="Override justification" @bind="_gateOverride" @bind:event="oninput" />
                    @if (g.RequiresCommentary)
                    {
                        <div class="form-text @((_gateOverride?.Trim().Length ?? 0) < g.CommentaryMinLength ? "text-danger" : "text-success")">
                            @(_gateOverride?.Trim().Length ?? 0) / @g.CommentaryMinLength characters
                        </div>
                    }
                }
            </div>
        }
    </text>;

    // Live character counter shown under the transition reason when the active gate requires a
    // minimum-length rationale (the reason is what gets recorded on the gate passage).
    private RenderFragment RationaleHint(string? text) => @<text>
        @if (_gateEval is { RequiresCommentary: true } g)
        {
            <div class="form-text @((text?.Trim().Length ?? 0) < g.CommentaryMinLength ? "text-danger" : "text-success")">
                @(text?.Trim().Length ?? 0) / @g.CommentaryMinLength characters (saved with the gate record)
            </div>
        }
    </text>;

    // --- INV-05: when a transition happened ---
    private RenderFragment WhenItHappened() => @<text>
        <div class="mt-2">
            <label class="form-label small mb-0" for="ws-when">When it happened (@TimeDisp.Label)</label>
            <input id="ws-when" type="datetime-local" class="form-control form-control-sm" @bind="_when" @bind:event="oninput" />
            <TimeNudges @bind-Value="_when" Now="@UtcToWall(Clock.UtcNow)" />
            @if (_when is { } w && Math.Abs((w - UtcToWall(Clock.UtcNow)).TotalMinutes) >= 1)
            {
                @* INV-24: both times, side by side, before saving. *@
                <div class="small text-muted">Recorded: now, @TimeDisp.Short(Clock.UtcNow)</div>
            }
            <div class="form-text @(Backdated ? "text-warning-emphasis" : "")">
                @(Backdated
                    ? "More than an hour ago, so give a reason. The record keeps both times: when it happened and when you entered it."
                    : "Leave as now, or set the time it actually happened if you're recording it later.")
            </div>
        </div>
    </text>;

    // INV-43: closing with a notification clock still running. Stated whatever the close gate requires: closing
    // doesn't answer the notification (the dashboard and reminders keep watching), but it should never be a surprise.
    private RenderFragment NotificationWarning() => @<text>
        @if (_newPhase == CasePhase.Closed && _case?.Phase != CasePhase.Closed
             && _notifyDeadlines?.Headline is { IsActive: true } nh)
        {
            <div class="alert alert-danger py-2 px-3 small mt-2 mb-0" role="status">
                <div class="fw-semibold">No notification recorded for @nh.JurisdictionLabel</div>
                <div>It's due @(nh.DueAtUtc is { } due ? TimeDisp.Short(due) : "now"). Closing the case doesn't stop the clock:
                    the dashboard and the reminders keep tracking it until the reported time is recorded.</div>
            </div>
        }
    </text>;

    // INV-13: moving forward, list the tasks still open for the phases being left behind (or every open task when
    // closing). A warning only: the analyst can advance anyway, and the tasks stay open.
    private RenderFragment OpenTasksWarning() => @<text>
        @{ var open = OpenTasksBehind(); }
        @if (open.Count > 0)
        {
            <div class="alert alert-warning py-2 px-3 small mt-2 mb-0" role="status">
                <div class="fw-semibold mb-1">@IncidentManager.Application.Common.Plural.Of(open.Count, "task") still open</div>
                <ul class="mb-1 ps-3">
                    @foreach (var t in open.Take(5))
                    {
                        <li>@t.Title <span class="text-muted">· @CaseTabs.CaseTasksTab.KindLabel(t.Kind)@(string.IsNullOrWhiteSpace(t.Owner) ? "" : $" · {Users.DisplayFor(t.Owner)}")</span></li>
                    }
                </ul>
                @if (open.Count > 5) { <div class="text-muted">…and @(open.Count - 5) more.</div> }
                <div class="text-muted">You can continue anyway. They stay open.</div>
            </div>
        }
    </text>;

    private List<ActionItem> OpenTasksBehind()
    {
        if (_case is null || _newPhase <= _case.Phase) return [];
        return _case.ActionItems
            .Where(t => t.IsOpen && (_newPhase == CasePhase.Closed || (t.Kind.Phase() is { } p && p < _newPhase)))
            .OrderBy(t => t.Kind).ThenBy(t => t.DueAtUtc)
            .ToList();
    }

    /// <summary>The chosen time as UTC, or null when the analyst left it at the default (it happened now).</summary>
    private DateTimeOffset? EffectiveUtc() =>
        _when is { } w && w != _whenDefault ? WallToUtc(w) : null;

    private bool Backdated => CaseService.IsBackdated(EffectiveUtc(), Clock.UtcNow);

    private DateTimeOffset WallToUtc(DateTime wall)
    {
        var unspecified = DateTime.SpecifyKind(wall, DateTimeKind.Unspecified);
        try { return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(unspecified, TimeDisp.Zone), TimeSpan.Zero); }
        catch { return new DateTimeOffset(DateTime.SpecifyKind(unspecified, DateTimeKind.Utc), TimeSpan.Zero); } // DST-invalid wall time: treat as UTC
    }

    private DateTime UtcToWall(DateTimeOffset utc)
        => DateTime.SpecifyKind(TimeZoneInfo.ConvertTime(utc, TimeDisp.Zone).DateTime, DateTimeKind.Unspecified);

    private void CloseModal()
    {
        _activeModal = null;
        _modalError = null;
    }

    // Generic confirm for destructive removes: capture a message + the action to run on confirm.
    private void AskConfirm(string message, Func<Task> onConfirm, string verb = "Remove") => _confirm = (message, verb, onConfirm);

    // The shared confirm serves removes and "Clear the reported milestone?"; label the button with the verb the
    // message leads with so it never reads "Remove" for a clear.
    private string ConfirmVerb => _confirm?.Verb ?? "Remove";
    private string ConfirmTitle => ConfirmVerb == "Clear" ? "Clear reported milestone" : "Remove from case";
    private void CancelConfirm() => _confirm = null;

    // FR-05: intercept in-app navigation away from this case when a composer still holds unsubmitted text,
    // and confirm before it's discarded. Same-case navigation (a tab or entity deep-link keeps the editors
    // mounted) and the security idle-lock's /session-expired landing are never blocked.
    private async Task OnBeforeInternalNav(LocationChangingContext ctx)
    {
        if (_leaveConfirmed) { _leaveConfirmed = false; return; } // already confirmed — let it through
        var target = ctx.TargetLocation;
        if (target.Contains("session-expired", StringComparison.OrdinalIgnoreCase)) return;
        if (target.Contains($"cases/{Id}", StringComparison.OrdinalIgnoreCase)) return; // same case
        if (_accessLost) return; // REL-07: the case is gone; don't block leaving after a copy-out
        if (!await AnyDraftDirtyAsync()) return;
        ctx.PreventNavigation();
        _pendingLeave = target;
        _confirmLeaveOpen = true;
        StateHasChanged();
    }

    // FR-05 / REL-07: whether any composer holds unsubmitted text (the JS editor is the source of truth).
    private async Task<bool> AnyDraftDirtyAsync()
    {
        try { return await JS.InvokeAsync<bool>("markdownEditor.anyDirty"); }
        catch { return false; } // if we can't tell, don't obstruct
    }

    private void CancelLeave()
    {
        _confirmLeaveOpen = false;
        _pendingLeave = null;
    }

    private void ConfirmLeave()
    {
        var target = _pendingLeave;
        _confirmLeaveOpen = false;
        _pendingLeave = null;
        if (target is null) return;
        _leaveConfirmed = true; // the reissued navigation passes straight through the guard
        Nav.NavigateTo(target);
    }

    // UX-01: Esc closes whichever .modal.d-block dialog is open (focus is trapped inside it, so the
    // keydown bubbles here). The JS focus-trap restores focus to the trigger on release.
    private void OnModalEscape(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        if (_confirm is not null) CancelConfirm();
        else if (_confirmLeaveOpen) CancelLeave();
        else if (_previewShotId is not null) CloseShot();
        else if (_activeModal is not null) CloseModal();
    }

    // UX-01: whether any of the three trap modals is currently open (drives arm/release in OnAfterRenderAsync).
    private bool AnyTrapModalOpen => _confirm is not null || _previewShotId is not null || _activeModal is not null || _confirmLeaveOpen
        || _panelEntity is not null;
    private bool _modalTrapArmed;
    private string? _revealedTab;

    private async Task RunConfirm()
    {
        var action = _confirm?.OnConfirm;
        _confirm = null;
        if (action is null) return;
        // One guard for every tab's confirm callback: a refused or stale write shows its reason instead of
        // replacing the page with the error fallback.
        try { await action(); }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
    }

    private string ModalTitle() => _activeModal switch
    {
        "reclass" => _case?.Classification is null ? "Promote onto the ladder" : "Reclassify case",
        "severity" => "Change severity",
        "handoff" => "Hand off the case",
        "status" => "Change phase",
        "legal" => "Refer to Legal / Privacy",
        "holdrelease" => Cases.LegalHoldReleaseNeedsSecondApprover ? "Request legal hold release" : "Release legal hold",
        "supersede" => "Supersede as a duplicate",
        "restrict" => "Restrict to need-to-know",
        "unrestrict" => "Lift restriction",
        "materiality" => "Record materiality determination",
        "archive" => "Archive case",
        "assign" => "Assign someone to this case",
        "reopen" => "Reopen case",
        _ => ""
    };

    /// <summary>Whether the materiality picker's current selection is a final call (needs full provenance).</summary>
    private bool MaterialityIsFinal => _materialityStatus is MaterialityStatus.Material or MaterialityStatus.NotMaterial;

    private string ModalPrimaryLabel() => _activeModal switch
    {
        "archive" => "Archive",
        "assign" => CurrentRole(_assignUserId) is null ? "Assign" : "Change role",
        "reopen" => "Reopen",
        "holdrelease" => Cases.LegalHoldReleaseNeedsSecondApprover ? "Request release" : "Release hold",
        "supersede" => "Supersede",
        "handoff" => "Hand off",
        "restrict" => "Restrict",
        "unrestrict" => "Lift restriction",
        _ => "Apply"
    };

    // Keep the primary disabled until required input is present. FR-14: the predicate mirrors the on-click
    // validation in ApplyModal exactly, so the button is disabled precisely when a submit would be rejected
    // — no modal leaves "Apply" enabled only to error on click. (The on-click checks stay as a safety net.)
    private bool ModalPrimaryDisabled() => _activeModal switch
    {
        "assign" => string.IsNullOrEmpty(_assignUserId) || CurrentRole(_assignUserId) == _assignRole,
        "reopen" => string.IsNullOrWhiteSpace(_reopenReason),
        "holdrelease" => string.IsNullOrWhiteSpace(_holdReleaseReason),
        "supersede" => _supersedeTargetId is null || string.IsNullOrWhiteSpace(_supersedeReason),
        "unrestrict" => string.IsNullOrWhiteSpace(_restrictReason),
        // A final call needs decision-maker, date and rationale; "Under review" needs none of them.
        "materiality" => _materialityStatus is MaterialityStatus.Material or MaterialityStatus.NotMaterial
            && (string.IsNullOrWhiteSpace(_materialityDecisionMaker) || _materialityDecidedOn is null
                || string.IsNullOrWhiteSpace(_materialityRationale)),
        // Reclass always needs a reason; both gated modals need an override justification when a blocking
        // requirement is unmet, and a long-enough rationale when the gate requires commentary.
        "reclass" => string.IsNullOrWhiteSpace(_reclassReason) || _when is null
            || (NeedsOverride && string.IsNullOrWhiteSpace(_gateOverride))
            || GateRationaleError(_reclassReason) is not null,
        "status" => (NeedsOverride && string.IsNullOrWhiteSpace(_gateOverride))
            || GateRationaleError(Closing ? _closeConclusion : _phaseReason) is not null
            || _when is null || (Backdated && !Closing && string.IsNullOrWhiteSpace(_phaseReason))
            || (Closing && (string.IsNullOrWhiteSpace(_closeOutcome) || string.IsNullOrWhiteSpace(_closeSummary)
                            || string.IsNullOrWhiteSpace(_closeConclusion))),
        "severity" => _when is null || ((Backdated || (_case is { } sv && _newSeverity > sv.Severity)) && string.IsNullOrWhiteSpace(_severityReason)),   // HR-11
        "handoff" => string.IsNullOrWhiteSpace(_hoTo) || string.IsNullOrWhiteSpace(_hoState),
        _ => false
    };

    private async Task ApplyModal()
    {
        _modalError = null;
        try
        {
            string done;
            switch (_activeModal)
            {
                case "reclass":
                    if (string.IsNullOrWhiteSpace(_reclassReason)) { _modalError = "Enter a reason."; return; }
                    if (NeedsOverride && string.IsNullOrWhiteSpace(_gateOverride))
                    { _modalError = "Enter an override justification for the unmet requirements."; return; }
                    if (GateRationaleError(_reclassReason) is { } m1) { _modalError = m1; return; }
                    await Cases.ReclassifyAsync(Id, _newClass, _reclassReason,
                        _attested.Count > 0 ? _attested : null, _gateOverride, EffectiveUtc());
                    _reclassReason = "";
                    done = $"Reclassified to {Ui.Label(_newClass)}";
                    break;
                case "handoff":
                {
                    var body = HandoffBody();
                    var moved = await Cases.HandOffAsync(Id, _hoTo!, body, _hoTasks, notify: _hoPost);
                    var toName = Users.DisplayFor(_hoTo);
                    done = $"Handed off to {toName}" + (moved > 0 ? $" · {IncidentManager.Application.Common.Plural.Of(moved, "task")} reassigned" : "");
                    break;
                }
                case "severity":
                    await Cases.ChangeSeverityAsync(Id, _newSeverity, _severityReason, EffectiveUtc());
                    _severityReason = null;
                    done = $"Severity changed to {SevLabels.For(_newSeverity)}";
                    break;
                case "status":
                    if (NeedsOverride && string.IsNullOrWhiteSpace(_gateOverride))
                    { _modalError = "Enter an override justification for the unmet requirements."; return; }
                    if (GateRationaleError(Closing ? _closeConclusion : _phaseReason) is { } m2) { _modalError = m2; return; }
                    var closing = Closing ? new CaseService.CaseClosing(_closeOutcome ?? "", _closeSummary ?? "", _closeConclusion ?? "") : null;
                    await Cases.ChangePhaseAsync(Id, _newPhase, closing is null ? _phaseReason : null,
                        _attested.Count > 0 ? _attested : null, _gateOverride, EffectiveUtc(), closing: closing);
                    _phaseReason = null;
                    done = closing is null ? $"Phase changed to {Ui.Label(_newPhase)}"
                        : $"Case closed: {_outcomes.FirstOrDefault(o => o.Key == closing.OutcomeKey)?.Label ?? closing.OutcomeKey}";
                    _closePrefilledFor = null;
                    break;
                case "supersede":
                {
                    var res = await Cases.SupersedeAsync(Id, _supersedeTargetId!.Value, _supersedeCopy, _supersedeReason ?? "");
                    _closeAfterSupersede = $"Duplicate of {res.PrimaryCaseNumber}: {_supersedeReason?.Trim()}";
                    done = $"Superseded by {res.PrimaryCaseNumber}" + (_supersedeCopy ? $" · {IncidentManager.Application.Common.Plural.Of(res.IndicatorsCopied, "indicator")} copied" : "")
                           + ". Close this case to finish.";
                    break;
                }
                case "restrict":
                    await Cases.SetRestrictedAsync(Id, true, _restrictReason);
                    _restrictReason = null;
                    done = "Case restricted to need-to-know";
                    break;
                case "unrestrict":
                    if (string.IsNullOrWhiteSpace(_restrictReason)) { _modalError = "Enter a reason for lifting the restriction."; return; }
                    await Cases.SetRestrictedAsync(Id, false, _restrictReason);
                    _restrictReason = null;
                    done = "Restriction lifted";
                    break;
                case "holdrelease" when Cases.LegalHoldReleaseNeedsSecondApprover:
                    await Cases.RequestLegalHoldReleaseAsync(Id, _holdReleaseReason ?? "");
                    _holdReleaseReason = null;
                    done = "Release requested. Someone else with Manage Legal must approve it.";
                    break;
                case "holdrelease":
                    await Cases.SetLegalHoldAsync(Id, false, _holdReleaseReason);
                    _holdReleaseReason = null;
                    done = "Legal hold released";
                    break;
                case "legal":
                    await Cases.ReferToLegalAsync(Id, _legalContact, _legalNote, _legalBaseline);
                    done = "Referred to Legal / Privacy";
                    break;
                case "materiality":
                    DateTimeOffset? decidedOn = _materialityDecidedOn is { } d
                        ? new DateTimeOffset(DateTime.SpecifyKind(d.Date, DateTimeKind.Utc)) : null;
                    await Cases.RecordMaterialityAsync(Id, _materialityStatus, _materialityDecisionMaker, decidedOn,
                        _materialityRationale, _materialityBaseline);
                    done = $"Materiality recorded: {Ui.Label(_materialityStatus)}";
                    break;
                case "archive":
                    await Cases.SetArchivedAsync(Id, true);
                    done = "Case archived";
                    break;
                case "reopen":
                    if (string.IsNullOrWhiteSpace(_reopenReason)) { _modalError = "Enter a reason."; return; }
                    await Cases.ReopenAsync(Id, _reopenReason);
                    _reopenReason = "";
                    done = "Case reopened";
                    break;
                case "assign":
                    if (string.IsNullOrWhiteSpace(_assignUserId)) { _modalError = "Select a person to assign."; return; }
                    var assignName = Users.Resolve(_assignUserId)?.DisplayName ?? _assignUserId;
                    var wasOn = CurrentRole(_assignUserId) is not null;
                    await Cases.AssignAsync(Id, _assignUserId, assignName, _assignRole);
                    done = wasOn ? $"{assignName} is now {Ui.Label(_assignRole)}" : $"Assigned {assignName}";
                    _assignUserId = "";
                    _assignRole = CaseAssignmentRole.Analyst;
                    break;
                default:
                    done = "";
                    break;
            }
            _activeModal = null;
            await Reload();
            if (done.Length > 0) Toasts.Success(done);
            // PROD-11: after superseding, hand straight to the gated close step with the reason filled in.
            if (_closeAfterSupersede is { } closeReason)
            {
                _closeAfterSupersede = null;
                await AdvanceTo(CasePhase.Closed);
                // HR-01: a superseded case closes as a duplicate, with the reason as its conclusion.
                if (_outcomes.Any(o => o.Key == IncidentManager.Application.Admin.CaseOutcomeCatalog.Duplicate))
                    _closeOutcome = IncidentManager.Application.Admin.CaseOutcomeCatalog.Duplicate;
                _closeConclusion = closeReason;
            }
        }
        catch (ForbiddenException)
        {
            // REL-08: access was revoked since the case loaded — close the modal, demote the UI, and explain.
            _activeModal = null;
            OnForbidden();
            Toasts.Error(PermissionLostMessage);
        }
        catch (GateNotSatisfiedException ex)
        {
            _modalError = ex.Message;
        }
        catch (StaleEditException ex)
        {
            // REL-02: another author changed the referral / materiality while this modal was open. Keep the
            // modal open with the user's entries intact, refresh the rest of the workspace to the newer values,
            // and re-baseline so a deliberate re-apply overwrites (mirrors the details/impact editors, FR-06).
            if (_activeModal == "legal") _legalBaseline = ex.CurrentStamp;
            else if (_activeModal == "materiality") _materialityBaseline = ex.CurrentStamp;
            _modalError = ex.Message + " Your entries weren't saved. Review the current values, then select Apply again to overwrite them, or Cancel to discard yours.";
            await Reload();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _modalError = ex.Message;
        }
    }

    private CasePhase? NextPhase()
    {
        if (_case is null) return null;
        var phases = Enum.GetValues<CasePhase>();
        var i = Array.IndexOf(phases, _case.Phase);
        return (i >= 0 && i < phases.Length - 1) ? phases[i + 1] : null;
    }

    private async Task AdvanceTo(CasePhase phase)
    {
        // Every advance goes through the status dialog (FR-01 for Close's gate; INV-05 for the rest), so the
        // analyst records what was achieved and, when entering it after the fact, when it actually happened.
        await OpenModal("status");
        _newPhase = phase;
        await OnStatusTargetChanged(); // load the gate (if any) for the selected target
    }

    // HR-10: a finished Contain/Eradicate/Recover task's result becomes what was achieved; the analyst still reviews and
    // applies the change in the dialog (gate, effective time).
    private async Task AdvanceWithResult((CasePhase Phase, string Achieved, DateTimeOffset? At) offer)
    {
        await AdvanceTo(offer.Phase);
        _phaseReason = offer.Achieved;
        if (offer.At is { } at) _when = UtcToWall(at);
    }

    private bool _titleExpanded;

    // --- INV-38: the state line ---

    private RenderFragment StateLine(bool slim) => @<text>
        @{
            var c = _case!;
            var phases = Enum.GetValues<CasePhase>();
            var cur = Array.IndexOf(phases, c.Phase);
        }
        <span class="im-state-words">
            <span class="@Ui.ClassificationBadge(c.Classification) im-word">@Ui.Label(c.Classification)</span><span class="im-state-dot" aria-hidden="true">·</span><span class="@Ui.SeverityBadge(c.Severity) im-word">@SevLabels.For(c.Severity)</span>
        </span>
        <span class="im-phasebar">
            @if (_canEdit && !slim)
            {
                @* The phase dialog, for any phase (on a phone, where the bar folds away, this is the way in). *@
                <button type="button" class="im-phasebar-name" title="Change the phase" @onclick="() => AdvanceTo(c.Phase)">@Ui.Label(c.Phase)</button>
            }
            else
            {
                <strong>@Ui.Label(c.Phase)</strong>
            }
            @if (!slim)
            {
                <span class="im-phasebar-segs" role="list" aria-label="Phases">
                    @for (var i = 0; i < phases.Length; i++)
                    {
                        var ph = phases[i];
                        var state = i < cur ? "done" : i == cur ? "cur" : "";
                        var tip = PhaseTip(ph, i, cur);
                        @if (_canEdit && i != cur)
                        {
                            <button type="button" role="listitem" class="im-phase-seg @state" title="@tip" aria-label="@tip" @onclick="() => AdvanceTo(ph)">@Ui.Label(ph)</button>
                        }
                        else
                        {
                            <span tabindex="0" role="listitem" class="im-phase-seg @state" title="@tip" aria-label="@tip">@Ui.Label(ph)</span>
                        }
                    }
                </span>
                <span class="im-phasebar-step">step @(cur + 1) of @phases.Length</span>
            }
        </span>
        @* HR-01: what a closed case concluded, beside its phase. *@
        @if (c.Phase == CasePhase.Closed && c.OutcomeKey is { } outcome)
        {
            <span class="im-outcome" title="Outcome recorded when the case closed">@OutcomeLabel(outcome)</span>
        }
        @* HR-15: changes after closure are marked, not prevented. *@
        @if (c.Phase == CasePhase.Closed && _afterClosure is { Changes.Count: > 0 } ac)
        {
            <button type="button" class="im-after-closure" @onclick='() => SetTab("Audit")'
                    title="@($"Changed after the case closed on {TimeDisp.Short(ac.Changes.ClosedRecordedAtUtc)}, by {string.Join(", ", ac.People)}. Latest {TimeDisp.Short(ac.Changes.LastAtUtc ?? ac.Changes.ClosedRecordedAtUtc)}. See the audit trail.")">
                <span class="bi bi-pencil-square" aria-hidden="true"></span> @ac.Changes.Count @(ac.Changes.Count == 1 ? "change" : "changes") after closure
            </button>
        }
        @* On the Overview the context strip above the brief already shows the clocks, so only the scrolled bar needs it. *@
        @if ((slim || _activeTab != "Overview") && HeadAlert() is { } alert)
        {
            <span class="im-head-alert @(alert.Danger ? "" : "im-head-alert-warn") @(_railOpen ? "" : "im-head-alert-always")" title="@alert.Title">
                <span class="bi bi-exclamation-triangle-fill" aria-hidden="true"></span> @alert.Text
            </span>
        }
        @if (!slim)
        {
            <span class="im-flags">
                @if (c.Materiality.Status != MaterialityStatus.Undetermined)
                {
                    <span class="@(c.Materiality.Status == MaterialityStatus.Material ? "im-flag-hot" : "")" title="Materiality determination">@Ui.Label(c.Materiality.Status)</span>
                }
                @if (c.LegalReferral.IsReferred) { <span>Legal referred</span> }
                @if (c.LegalHold) { <span class="im-flag-hot">Legal hold</span> }
                @if (c.IsRestricted) { <span>Restricted</span> }
                @if (c.IsExercise) { <span title="Tabletop exercise or drill">Exercise</span> }
                @if (c.IsArchived) { <span>Archived</span> }
            </span>
        }
    </text>;

    // A phase's tooltip: when it was reached (the effective time of the latest change into it), or that it's ahead.
    private string PhaseTip(CasePhase ph, int index, int current)
    {
        var name = Ui.Label(ph);
        if (index > current) return _canEdit ? $"{name}: not reached. Click to move the case here." : $"{name}: not reached";
        DateTimeOffset? at = index == 0 ? _case!.CreatedAtUtc
            : _case!.StatusChanges.Where(x => x.To == ph).OrderByDescending(x => x.EffectiveAt).Select(x => (DateTimeOffset?)x.EffectiveAt).FirstOrDefault();
        var when = at is { } t ? $", reached {TimeDisp.Short(t)}" : "";
        return index == current ? $"{name}: current phase{when}"
            : _canEdit ? $"{name}{when}. Click to move the case back here." : $"{name}{when}";
    }

    private sealed record HeadAlertInfo(string Text, string Title, bool Danger);

    // Something that needs action now: an overdue response clock, or a notification deadline at risk or overdue.
    // Shown in the header only where the context panel isn't beside the tab (CSS hides it otherwise).
    private HeadAlertInfo? HeadAlert()
    {
        if (_case is null) return null;
        if (_notifyDeadlines?.Headline is { IsActive: true, State: SlaState.Breached or SlaState.AtRisk } nh)
            return new($"Notify {nh.JurisdictionCode}: {Ui.SlaLabel(nh.State).ToLowerInvariant()}",
                $"Notification to {nh.JurisdictionLabel}" + (nh.DueAtUtc is { } due ? $", due {TimeDisp.Short(due)}" : ""),
                nh.State == SlaState.Breached);
        var sla = SlaPolicy.Evaluate(_case.Severity, _case.Phase, _case.DetectedAtUtc, _case.ContainedAtUtc,
            _case.ResolvedAtUtc, SlaProvider.Current, Clock.UtcNow, _case.Classification);
        if (sla.State == SlaState.Breached)
        {
            var clock = sla.Clock is { } k ? Ui.SlaClockLabel(k) : "SLA";
            return new($"{clock}: {Ui.SlaShort(sla)}", $"{clock} is overdue" + (sla.DueAtUtc is { } d ? $" (was due {TimeDisp.Short(d)})" : ""), true);
        }
        return null;
    }

    // INV-38: tabs keep their places; the ones built at the end (lessons, report) stay quiet until they matter, and
    // the audit trail always does. Report matters on a breach, while a notification deadline runs, or from Recovery;
    // Lessons learned from Post-Incident.
    private bool ReportMatters => _case is { } c
        && (c.Classification == Classification.Breach || _notifyDeadlines?.Headline is { IsActive: true } || c.Phase >= CasePhase.Recovery);
    private bool LessonsMatter => _case is { Phase: >= CasePhase.PostIncident };

    private bool TabQuiet(string tab) => _activeTab != tab && tab switch
    {
        "Report" => !ReportMatters,
        "Review" => !LessonsMatter,
        "Audit" => true,
        _ => false
    };

    private string? TabWhy(string tab) => tab switch
    {
        "Report" when _notifyDeadlines?.Headline is { IsActive: true } nh => $"{nh.JurisdictionCode} {nh.WindowHours} h",
        "Review" when _case is { Phase: CasePhase.PostIncident } => "Next gate",
        _ => null
    };

    // --- INV-15: structured handoff ---
    private string? _hoTo;
    private string? _hoState;
    private string? _hoDone;
    private string? _hoOpen;
    private string? _hoWatch;
    private bool _hoPost = true;
    private IReadOnlyList<IncidentManager.Application.Abstractions.UserSummary> _hoPeople = [];
    private bool _hoTasks = true;

    private int MyOpenTaskCount => _case?.ActionItems.Count(t => t.IsOpen
        && string.Equals(t.Owner, _myId, StringComparison.OrdinalIgnoreCase)) ?? 0;

    // Prefilled from the record: the brief's situation (or the summary), what was logged since the last handoff,
    // and the open tasks. The analyst edits it before handing off.
    private void PrefillHandoff()
    {
        if (_case is null) return;
        _hoTo = null;
        _hoWatch = null;
        _hoPost = true;
        _hoTasks = true;
        _hoState = _case.Summary;   // INV-36: the summary is the brief's first part
        // INV-21: the team's work and response milestones, not the adversary's steps.
        _hoDone = HandoffDraft.DoneSince(_case, new MilestoneLabels(
            c => Ui.Label(c), s => SevLabels.For(s), p => Ui.Label(p), m => Ui.Label(m)), OneLine);
        // INV-25: the same "next" list the brief and the context panel show.
        var open = CaseNext.Open(_case, Clock.UtcNow)
            .Select(t => $"- {t.Title}" + (string.IsNullOrWhiteSpace(t.Owner) ? "" : $" ({Users.DisplayFor(t.Owner)})"))
            .ToList();
        _hoOpen = open.Count > 0 ? string.Join("\n", open) : null;
    }

    private string OneLine(string markdown)
    {
        var text = Md.ToPlainText(markdown).Replace('\n', ' ').Trim();
        return text.Length <= 140 ? text : text[..137] + "…";
    }

    // The handoff as Markdown: the same text goes on the timeline and, if chosen, in the email to the recipient.
    private string HandoffBody()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("**Handed to ").Append(Users.DisplayFor(_hoTo)).Append("**\n\n");
        void Part(string label, string? text)
        {
            if (string.IsNullOrWhiteSpace(text)) return;
            sb.Append("**").Append(label).Append("**\n\n").Append(text.Trim()).Append("\n\n");
        }
        Part("Where it stands", _hoState);
        Part("Done since the last handoff", _hoDone);
        Part("Still open", _hoOpen);
        Part("Watch for", _hoWatch);
        return sb.ToString().TrimEnd();
    }

