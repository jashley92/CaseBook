    // --- Interactive graph (vis-network via JS interop) ---

    private sealed record GraphColor(string Background, string Border);
    private sealed record GraphNodeDto(string Id, string Label, string Title, string Shape, GraphColor Color, double? X, double? Y);
    private sealed record GraphEdgeDto(string Id, string From, string To, string Label, string? Color, bool Dashes);

    /// <summary>vis-network node shape per entity type, so hosts, IPs, URLs etc. read differently at a glance.</summary>
    private static string ShapeFor(EntityType t) => t switch
    {
        EntityType.Account => "dot",
        EntityType.Host => "hexagon",
        EntityType.IpAddress => "diamond",
        EntityType.Domain => "diamond",
        EntityType.Url => "triangle",
        EntityType.FileHash => "square",
        EntityType.FileName => "triangleDown",
        EntityType.EmailAddress => "star",
        EntityType.Process => "dot",
        EntityType.RegistryKey => "square",
        _ => "dot"
    };

    private IReadOnlyList<GraphNodeDto> GraphNodes()
    {
        if (_case is null) return [];
        var layout = _case.EntityLayouts.ToDictionary(l => l.EntityId);
        return _case.Entities.Select(e =>
        {
            var label = e.Label ?? e.Value;
            if (label.Length > 22) label = label[..21] + "…";
            var color = Ui.DispositionColor(e.Disposition);
            var title = $"{Ui.Label(e.Type)}: {e.Value}" + (string.IsNullOrWhiteSpace(e.Description) ? "" : $" — {e.Description}");
            var pos = layout.TryGetValue(e.Id, out var l) ? l : null;
            return new GraphNodeDto(e.Id.ToString(), $"{Ui.EntityGlyph(e.Type)} {label}", title,
                ShapeFor(e.Type), new GraphColor(color, color), pos?.X, pos?.Y);
        }).ToList();
    }

    private IReadOnlyList<GraphEdgeDto> GraphEdges()
    {
        if (_case is null) return [];
        var edges = _case.EntityRelationships.Select(r =>
            new GraphEdgeDto(r.Id.ToString(), r.SourceEntityId.ToString(), r.TargetEntityId.ToString(),
                Ui.Label(r.Type), null, false)).ToList();

        // Layer the attack narrative: event steps with both an actor and a target become dashed,
        // tactic-coloured edges so the malicious activity graphs over the entity relationships.
        if (_showAttackEdges)
        {
            foreach (var e in _case.TimelineEntries.Where(x => x.Kind == TimelineKind.Event
                && x.ActorEntityId is not null && x.TargetEntityId is not null))
            {
                var tactic = PrimaryTactic(e);
                edges.Add(new GraphEdgeDto($"evt-{e.Id}", e.ActorEntityId!.ToString()!, e.TargetEntityId!.ToString()!,
                    Ui.Label(tactic), Ui.TacticColor(tactic), true));
            }
        }
        return edges;
    }

    /// <summary>Signature of the graph's data so we only push to JS when something actually changed.</summary>
    private string GraphSignature() => _case is null ? "" : string.Concat(
        string.Join("|", _case.Entities.Select(e => $"{e.Id:N}:{(int)e.Type}:{(int)e.Disposition}:{e.Label}:{e.Value}")),
        "#",
        string.Join("|", _case.EntityRelationships.Select(r => $"{r.Id:N}:{r.SourceEntityId:N}>{r.TargetEntityId:N}:{(int)r.Type}")),
        "#att:", _showAttackEdges ? "1" : "0", ":",
        string.Join("|", _case.TimelineEntries.Where(x => x.Kind == TimelineKind.Event && x.ActorEntityId is not null && x.TargetEntityId is not null)
            .Select(e => $"{e.Id:N}:{e.ActorEntityId:N}>{e.TargetEntityId:N}")));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Attach the paste/drag-drop listeners once (idempotent in the shim; each zone only acts while
            // its wrapper is in the DOM). Evidence tab (U-39): paste + drop. Timeline tab (U-40): paste only.
            try
            {
                await JS.InvokeVoidAsync("imPasteDrop.register", "evidence-dropzone", "evidence-file-input", "evidence-file-drop");
                await JS.InvokeVoidAsync("imPasteDrop.register", "timeline-dropzone", "timeline-file-paste", null);
            }
            catch (JSException) { /* progressive enhancement — the manual picker still works */ }
        }

        await ReconcileMarkdownEditors();

        if (_case is null || _activeTab != "Entities" || _case.Entities.Count == 0) return;

        var sig = GraphSignature();
        if (!_graphNeedsPush && sig == _lastGraphSig) return;

        _graphNeedsPush = false;
        _lastGraphSig = sig;
        try
        {
            await JS.InvokeVoidAsync("entityGraph.render", GraphContainerId, GraphNodes(), GraphEdges(), _dotNetRef, _canEdit);
        }
        catch (JSException) { /* graph is a progressive enhancement; ignore transient interop errors */ }
    }

    /// <summary>
    /// Reconcile the set of mounted EasyMDE editors against what the current view needs — the Investigation
    /// composer, the Overview Summary editor, and the Notes add/edit editors. Id-keyed so several coexist;
    /// mounts what is newly needed and tears down what is gone. Progressive enhancement — failures ignored.
    /// </summary>
    private async Task ReconcileMarkdownEditors()
    {
        var desired = new Dictionary<string, string>();
        if (_case is not null && _canEdit)
        {
            if (_activeTab == "Timeline" && _tlAddKind == TimelineKind.Investigation)
                desired[InvEditorId] = _tlDesc ?? "";
            if (_activeTab == "Overview" && _editingDetails)
                desired[SummaryEditorId] = _edSummary ?? "";
            if (_activeTab == "Notes")
            {
                desired[NoteAddEditorId] = _noteBody ?? "";
                if (_editNoteId is { } nid) desired[NoteEditEditorId(nid)] = _editNoteBody ?? "";
            }
        }

        // Tear down editors no longer wanted (e.g. tab switch, cancelled edit).
        foreach (var id in _mdEditors.Where(id => !desired.ContainsKey(id)).ToList())
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); } catch (JSException) { /* ignore */ }
            _mdEditors.Remove(id);
        }
        // Mount newly-wanted editors (the seed value applies on first mount only).
        foreach (var (id, seed) in desired)
        {
            if (_mdEditors.Contains(id)) continue;
            try { await JS.InvokeVoidAsync("markdownEditor.init", id, seed); _mdEditors.Add(id); }
            catch (JSException) { /* editor is a progressive enhancement */ }
        }
    }

    /// <summary>Called from JS when the user finishes dragging node(s). Persists the arranged layout (editors only).</summary>
    [JSInvokable]
    public async Task OnNodesMoved(EntityPosition[] positions)
    {
        if (!_canEdit || positions is null || positions.Length == 0) return;
        await Cases.SaveGraphLayoutAsync(Id, positions);
    }

    private async Task GraphFit() => await SafeGraphCall("entityGraph.fit", GraphContainerId);

    private async Task GraphTogglePhysics()
    {
        _physicsOn = !_physicsOn;
        await SafeGraphCall("entityGraph.setPhysics", GraphContainerId, _physicsOn);
    }

    private async Task GraphRelayout()
    {
        _physicsOn = true;
        await SafeGraphCall("entityGraph.relayout", GraphContainerId);
    }

    private void ToggleAttackEdges()
    {
        _showAttackEdges = !_showAttackEdges;
        _graphNeedsPush = true;   // edge set changed → re-render the graph on next after-render
    }

    private async Task SafeGraphCall(string fn, params object[] args)
    {
        try { await JS.InvokeVoidAsync(fn, args); }
        catch (JSException) { /* ignore */ }
    }

    public async ValueTask DisposeAsync()
    {
        _caseSub?.Dispose();
        if (_relativeTimeTicker is not null) await _relativeTimeTicker.DisposeAsync();
        try { await JS.InvokeVoidAsync("entityGraph.destroy", GraphContainerId); }
        catch { /* circuit may already be gone during teardown */ }
        foreach (var id in _mdEditors)
        {
            try { await JS.InvokeVoidAsync("markdownEditor.destroy", id); }
            catch { /* circuit may already be gone during teardown */ }
        }
        _mdEditors.Clear();
        _dotNetRef?.Dispose();
    }

    // Manual picker or a pasted screenshot (via the shim) stages one file to describe + Upload.
    private void OnFileSelected(InputFileChangeEventArgs e) => _file = e.File;

    private const long MaxEvidenceBytes = 50 * 1024 * 1024;

    private async Task Upload()
    {
        if (_file is null || _case is null) return;
        _uploadError = null;
        try
        {
            await using var stream = _file.OpenReadStream(MaxEvidenceBytes);
            var name = _file.Name;
            await Evidence.UploadAsync(_case.Id, _file.Name, _file.ContentType, stream, _evDesc);
            _file = null; _evDesc = null;
            await Reload();
            Toasts.Success($"Uploaded {name}");
        }
        catch (Exception ex)
        {
            _uploadError = ex.Message;
        }
    }

    // U-39: files dropped onto the Evidence tab (via the paste-drop shim) upload immediately — a drop is a
    // bulk gesture, so we don't stage them for a per-file description. Same hashed/custody UploadAsync path.
    private async Task OnDropped(InputFileChangeEventArgs e)
    {
        if (_case is null) return;
        _uploadError = null;
        var uploaded = 0;
        foreach (var f in e.GetMultipleFiles(maximumFileCount: 50))
        {
            try
            {
                await using var stream = f.OpenReadStream(MaxEvidenceBytes);
                await Evidence.UploadAsync(_case.Id, f.Name, f.ContentType, stream, _evDesc);
                uploaded++;
            }
            catch (Exception ex)
            {
                _uploadError = $"{f.Name}: {ex.Message}";
            }
        }
        if (uploaded > 0)
        {
            _evDesc = null;
            await Reload();
            Toasts.Success($"Uploaded {uploaded} file{(uploaded == 1 ? "" : "s")}");
        }
    }

    // Only image evidence can be previewed inline (the /inline endpoint serves image/* only).
    private static bool IsImageEvidence(Evidence ev) =>
        ev.ContentType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;

    private static string FormatSize(long bytes) => bytes switch
    {
        >= 1024 * 1024 => $"{bytes / (1024.0 * 1024):0.0} MB",
        >= 1024 => $"{bytes / 1024.0:0.0} KB",
        _ => $"{bytes} B"
    };
