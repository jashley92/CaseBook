    // The case's involved element keys in the reference display order (active first by SortOrder), any
    // unknown/archived keys trailing — matches the report's ordering.
    private IEnumerable<string> SelectedElementKeysOrdered()
    {
        if (_case is null) return Array.Empty<string>();
        var keys = _case.DataElements.Select(d => d.ElementKey).ToHashSet(StringComparer.Ordinal);
        var ordered = _dataElements.Where(e => keys.Contains(e.Key)).Select(e => e.Key).ToList();
        ordered.AddRange(keys.Where(k => ordered.All(o => o != k)).OrderBy(k => k, StringComparer.Ordinal));
        return ordered;
    }

