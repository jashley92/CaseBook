@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>Deep-link a specific tab, e.g. <c>?tab=Report</c>, so a link can point straight at it.</summary>
    [SupplyParameterFromQuery(Name = "tab")] public string? QTab { get; set; }

    /// <summary>Deep-link a specific entity (from an inline "#" tag chip): <c>?tab=Entities&amp;entity={guid}</c>
    /// focuses that row on the Entities tab.</summary>
    [SupplyParameterFromQuery(Name = "entity")] public Guid? QEntity { get; set; }

    private readonly string[] _tabs = ["Overview", "Timeline", "Entities", "Evidence", "Notes", "Discussion", "Tasks", "Review", "Report", "Audit"];
    private string _activeTab = "Overview";

    // UX-19: each tab string is the stable routing key (?tab=, inline "#"-chip deep-links, TabCount /
    // SubmitAsync / feed keys), so it stays "Entities"; this maps a key to its display label so the bar can
    // read in SOC vocabulary without touching any of that wiring.
    private static string TabLabel(string tab) => tab switch
    {
        "Entities" => "IOCs & entities",
        "Review" => "Lessons learned",
        _ => tab,
    };

    private Case? _case;
    private bool _notFound;

    // Case-number rename (inline in the header)
    private bool _renumbering;
    private bool _savingNumber;
    private string _editNumber = "";
    private string? _renumberError;
    // FR-22: inline availability of the typed number (debounced), null when blank / unchanged / unchecked.
    private bool? _renumberAvailable;
    private CancellationTokenSource? _renumberCheckCts;

    private async Task CheckRenumberAvailable()
    {
        // Retire the previous keystroke's check (cancel + dispose its source) before starting a new one, so
        // a burst of typing doesn't leak a CancellationTokenSource per keystroke (S2930). The token below is
        // captured into a local so this method never touches a source a later call may have disposed.
        if (_renumberCheckCts is not null)
        {
            await _renumberCheckCts.CancelAsync();   // S6966: async cancel (schedules callbacks off-thread)
            _renumberCheckCts.Dispose();
            _renumberCheckCts = null;
        }

        var v = _editNumber?.Trim();
        if (string.IsNullOrEmpty(v) || string.Equals(v, _case.CaseNumber, StringComparison.Ordinal))
        {
            _renumberAvailable = null;
            return;
        }

        var cts = _renumberCheckCts = new CancellationTokenSource();
        var token = cts.Token;
        try
        {
            await Task.Delay(350, token); // debounce keystrokes
            var ok = await Cases.IsCaseNumberAvailableAsync(v, _case.Id, token);
            if (!token.IsCancellationRequested) { _renumberAvailable = ok; StateHasChanged(); }
        }
        catch (OperationCanceledException) { /* superseded by a newer keystroke */ }
    }

    // Overview: the tab is extracted to CaseOverviewTab (UX-13), which owns details/impact/techniques/links
    // + the Summary editor. The parent keeps a ref for hotkey dispatch (Ctrl+Enter save).
    private CaseOverviewTab? _overviewTab;

    // Action-modal edit buffers (reclass / severity / status / legal / assign) — parent-owned modals.
    private Classification _newClass = Classification.Incident;
    private string _reclassReason = "";
    private CasePhase _newPhase = CasePhase.Triage;
    private string? _phaseReason;
    private string? _reopenReason;
    private Severity _newSeverity = Severity.Medium;
    private string? _severityReason;
    private string _assignUserId = "";
    private CaseAssignmentRole _assignRole = CaseAssignmentRole.Analyst;
    private string? _legalContact;
    private string? _holdReleaseReason;   // F-12

    // S-08: need-to-know restriction.
    private string? _restrictReason;
    private bool _canViewRestricted;
    private string _clearanceNote = "";

    /// <summary>The IC or a cleared role may lift a restriction (mirrors CaseRestrictionPolicy.CanLift).</summary>
    private bool CanLiftRestriction => _canViewAll || _canViewRestricted
        || (_case is not null && string.Equals(_case.IncidentCommander, _myId, StringComparison.Ordinal));

    /// <summary>Whether the current user would still see the case once restricted (else the service adds them).</summary>
    private bool RestrictKeepsMe => CanLiftRestriction
        || (_case?.Assignments.Any(a => string.Equals(a.UserId, _myId, StringComparison.Ordinal)) ?? false);

    // PROD-11: supersede-as-duplicate modal state.
    private Guid? _supersedeTargetId;
    private string? _supersedeTargetNumber;
    private string? _supersedeQuery;
    private string? _supersedeReason;
    private bool _supersedeCopy = true;
    private IReadOnlyList<LinkableCase> _supersedeResults = [];
    private IReadOnlyList<CaseLinkView> _supersedeLinked = [];
    private string? _closeAfterSupersede;

    private void PickSupersedeTarget(Guid id, string number)
    {
        _supersedeTargetId = id;
        _supersedeTargetNumber = number;
    }

    private async Task SearchSupersede() =>
        _supersedeResults = await Cases.SearchLinkableCasesAsync(Id, _supersedeQuery, take: 8);
    private string? _legalNote;
    // REL-02: optimistic-concurrency baselines captured when the Legal-referral / materiality modal opens,
    // sent back on apply so a concurrent edit surfaces a StaleEditException instead of silently clobbering.
    private string? _legalBaseline;
    private string? _materialityBaseline;
    // Materiality determination (PROD-18). Recorded by any case editor (FR-07); the decision itself may be
    // the SOC's or an external Legal/committee call, captured in the decision-maker field either way.
    private MaterialityStatus _materialityStatus = MaterialityStatus.UnderReview;
    private string? _materialityDecisionMaker;
    private DateTime? _materialityDecidedOn;
    private string? _materialityRationale;

    // Timeline: the tab is extracted to CaseTimelineTab (UX-13), which owns its composer/edit state + its
    // Investigation EasyMDE editor. The parent keeps a ref for hotkey dispatch (Ctrl+Enter submit).
    private CaseTimelineTab? _timelineTab;

    // U-40: the attached screenshot currently open in the lightbox preview (null = closed). Parent-owned,
    // shared by the Timeline and Evidence tabs.
    private Guid? _previewShotId;

    // Entities: the tab is extracted to CaseEntitiesTab (UX-13), which owns the graph interop and
    // entity/relationship CRUD. The parent keeps a ref for hotkey dispatch (Ctrl+Enter submit).
    private CaseEntitiesTab? _entitiesTab;

    private bool _canEdit;
    // Case-local keyboard shortcuts (imCaseHotkeys → OnCaseHotkey); the entity graph has its own ref in its tab.
    private DotNetObjectReference<CaseWorkspace>? _dotNetRef;

    // Notes: the tab is extracted to CaseNotesTab (UX-13), which owns its editors + note state. The parent
    // keeps a ref for hotkey dispatch (Ctrl+Enter submit) and a flag for the 'n' focus shortcut.
    private CaseNotesTab? _notesTab;
    private bool _notesAutofocus;

    // Tasks: the tab is extracted to CaseTasksTab (UX-13), which owns the add-task + apply-playbook flow.
    private CaseTasksTab? _tasksTab;
    // Lessons learned (E-26/PROD-41): owns its review + action editors; the parent routes Ctrl+Enter to it.
    private CaseReviewTab? _reviewTab;

    // Retention guard message for legal-hold / archive actions (not notes).
    private string? _retentionMsg;

    // Workspace chrome: actions menu, action modals, collapsible history, and per-action permissions.
    private bool _actionsOpen;
    private string? _activeModal;
    private string? _modalError;
    private bool _canReclassify;
    private bool _canManageLegal;
    private bool _canAdmin;
    private bool _canAnyAction => _canEdit || _canReclassify || _canManageLegal || _canAdmin;
    private IDisposable? _caseSub;
    private (string Message, Func<Task> OnConfirm)? _confirm;

    // UX-13: the extracted Entities tab raises this to use the parent-owned confirm dialog.
    private void OnChildRequestConfirm((string Message, Func<Task> OnConfirm) req) => AskConfirm(req.Message, req.OnConfirm);

    // Evidence: the tab is extracted to CaseEvidenceTab (UX-13). The screenshot lightbox (OpenShot) and the
    // live-collab flash it renders stay here, shared with the Timeline; the child manages its own upload/custody state.

    // Audit (UX-13: the tab is extracted to CaseAuditTab; this state persists its filters across re-mounts).
    private bool _canViewAll;
    private readonly CaseAuditFilter _auditFilter = new();
    // Bumped whenever a collaborator changes the case, so extracted tabs (audit) re-query live.
    private int _liveRefresh;

    // FR-02: unsubmitted composer text, kept in the parent (which survives tab switches, unlike the tab
    // components) so hopping tabs doesn't discard an in-progress note / comment / investigation entry.
    // Keyed by the editor's element id; each composer tab stashes on teardown and re-seeds on remount.
    // Server-memory only — never persisted to the client, so it's gone when the circuit ends (idle-lock /
    // logout), preserving the unattended-workstation posture; also cleared when the case changes.
    private readonly Dictionary<string, string> _composerDrafts = new();
    private Guid _draftsCaseId;

    // FR-05: guard against leaving the case (in-app navigation) with unsubmitted composer text.
    private bool _confirmLeaveOpen;
    private string? _pendingLeave;
    // REL-07: true once a live-collab reload found the case archived/restricted out from under a viewer who
    // still holds unsaved composer text — we hold the (last-known) workspace and show a banner instead of
    // swapping to the not-found page, so the draft can be copied out.
    private bool _accessLost;
    private bool _leaveConfirmed;
    // REL-08: true once this user's permission to act on the case is found to have changed since it loaded —
    // either a live re-check shows edit was revoked, or the server refuses an action (ForbiddenException).
    // Drives a banner and demotes the header edit affordances so a stale control can't throw when clicked.
    private bool _permissionLost;
    private const string PermissionLostMessage =
        "You no longer have permission to do that — your access to this case may have changed. Reload the page to refresh your view.";

    // REL-08: (re-)evaluate the current user's action permissions from the live auth state. Called at load and
    // on every live-collab refresh; if a re-check shows edit was revoked mid-session, demote + warn. Under the
    // default (non-revalidating) auth-state provider the claims are fixed for the circuit, so a mid-session
    // change surfaces on a reconnect or as a ForbiddenException — but this keeps the UI correct if the auth
    // state is ever refreshed in place, and centralises the capture.
    private async Task RefreshPermissionsAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        var couldEdit = _canEdit;
        _canEdit = (await AuthZ.AuthorizeAsync(user, Policies.EditCases)).Succeeded;
        _canReclassify = (await AuthZ.AuthorizeAsync(user, Policies.ChangeClassification)).Succeeded;
        _canManageLegal = (await AuthZ.AuthorizeAsync(user, Policies.ManageLegal)).Succeeded;
        _canAdmin = (await AuthZ.AuthorizeAsync(user, Policies.Administer)).Succeeded;
        _canViewAll = (await AuthZ.AuthorizeAsync(user, Policies.ViewAllCases)).Succeeded;
        _canViewRestricted = (await AuthZ.AuthorizeAsync(user, Policies.ViewRestricted)).Succeeded;
        if (couldEdit && !_canEdit) _permissionLost = true;
    }

    // REL-08: the server refused an action for lack of permission — the authoritative signal that this user's
    // access changed since the case loaded. Demote the edit affordances and raise the banner rather than
    // letting a raw ForbiddenException reach the error UI. (Composers are AuthorizeView-gated on the live
    // claims, so clearing these flags never unmounts an in-progress draft.)
    private void OnForbidden()
    {
        _permissionLost = true;
        _canEdit = false;
        _canReclassify = false;
        _canManageLegal = false;
    }

    // Reports (UX-13: the tab is extracted to CaseReportTab; this state persists preview/profiles across re-mounts).
    private readonly CaseReportState _reportState = new();

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        _myId = CurrentUser.UserId;
        await RefreshPermissionsAsync();

        // Live collaboration: refresh when another analyst changes this case.
        _caseSub = Notifier.Subscribe(Id, OnCaseChangedAsync);

        // PROD-19: publish this case's action verbs to the command palette. The provider is a closure over
        // live state, so the palette reflects the case as it currently is (permissions, next phase, hold state).
        // Owner-guarded (see CaseCommandRegistry): MainLayout re-keys this page subtree on a time-zone change,
        // so a fresh instance registers before the old one disposes — pass `this` so teardown clears only ours.
        PaletteActions.Set(this, BuildPaletteActions);

        // U-32: a 30s heartbeat re-renders so relative times ("2m ago") stay live without a reload.
        _relativeTimeTicker = new System.Threading.Timer(
            _ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    private async Task OnCaseChangedAsync(string actorId)
    {
        await InvokeAsync(async () =>
        {
            if (_accessLost) return; // REL-07: already holding the workspace for a copy-out — don't churn it

            var hadCase = _case is not null;
            var prevKnown = _knownIds; // U-30: snapshot before Reload re-seeds, so we can diff what appeared

            // REL-07: a live-collab change can be an archive/restrict that removes this case from under the
            // viewer. Peek before swapping the view: if it vanished while a composer still holds unsubmitted
            // text, don't yank the workspace out to the "not found" page (which unmounts the editors and
            // silently discards the draft — the FR-05 guard only covers navigation). Hold the workspace with
            // a banner so the viewer can copy the text out first.
            var refreshed = await Cases.GetDetailAsync(Id);
            if (refreshed is null && hadCase && await AnyDraftDirtyAsync())
            {
                _accessLost = true;
                StateHasChanged();
                return;
            }

            await ReloadWith(refreshed);
            await RefreshPermissionsAsync(); // REL-08: demote the UI if this user's access was revoked mid-session
            _liveRefresh++; // UX-13: signal extracted tabs to re-query the case (an in-progress edit in a
                            // tab component survives, since the component isn't re-created by a reload)
            await SetTab(_activeTab); // refresh the visible tab's data
            FlagNewItems(prevKnown, actorId); // U-30: flash / pulse / toast a collaborator's additions
            StateHasChanged();
        });
    }

    // --- U-30: live-collaboration motion --------------------------------------------------------
    // When another analyst adds something to this case, the diff of item ids (before/after reload)
    // tells us exactly what appeared. Each new item flashes in the adder's presence colour; if it
    // landed on a tab you aren't viewing, that tab pulses; and a toast names who added what. A
    // viewer's own additions don't echo, because Reload() re-seeds _knownIds before the notice lands.
    private readonly Dictionary<Guid, (int Hue, string Tab)> _flash = new(); // item id -> flash state
    private readonly Dictionary<string, int> _newOnTab = new();              // tab -> unseen new count
    private readonly HashSet<Guid> _newTimelineIds = new();                  // U-32: unseen new timeline entries
    private HashSet<Guid> _knownIds = new();
    private string? _myId;

    private string FlashClass(Guid id) => _flash.ContainsKey(id) ? "im-flash" : "";
    private string? FlashStyle(Guid id) => _flash.TryGetValue(id, out var f) ? $"--flash-hue:{f.Hue}" : null;
    private bool TabHasNew(string tab) => tab != _activeTab && _newOnTab.GetValueOrDefault(tab) > 0;

    private readonly record struct FeedItem(Guid Id, string Tab, string Kind);

    private IEnumerable<FeedItem> CurrentItems()
    {
        if (_case is null) yield break;
        foreach (var x in _case.TimelineEntries.Where(t => t.IsCurrent)) yield return new FeedItem(x.Id, "Timeline", "timeline entry");
        foreach (var x in _case.Entities) yield return new FeedItem(x.Id, "Entities", "entity");
        foreach (var x in _case.Evidence) yield return new FeedItem(x.Id, "Evidence", "evidence item");
        foreach (var x in _case.Notes.Where(n => n.IsCurrent)) yield return new FeedItem(x.Id, "Notes", "note");
        foreach (var x in _case.ActionItems) yield return new FeedItem(x.Id, "Tasks", "task");
    }

    private void SeedKnownIds() => _knownIds = CurrentItems().Select(i => i.Id).ToHashSet();

    private void FlagNewItems(HashSet<Guid> prevKnown, string actorId)
    {
        if (prevKnown.Count == 0) return; // first population — nothing to diff against yet
        var added = CurrentItems().Where(i => !prevKnown.Contains(i.Id)).ToList();
        if (added.Count == 0) return; // e.g. a status change, or the viewer's own edit already absorbed

        var hue = Ui.AvatarHue(actorId);
        foreach (var it in added)
        {
            _flash[it.Id] = (hue, it.Tab);
            if (!string.Equals(it.Tab, _activeTab, StringComparison.OrdinalIgnoreCase))
                _newOnTab[it.Tab] = _newOnTab.GetValueOrDefault(it.Tab) + 1;
            if (it.Tab == "Timeline") _newTimelineIds.Add(it.Id); // U-32: feeds the "jump to new" pill
        }

        // Attribution toast — never announce your own change back to you.
        if (!string.Equals(actorId, _myId, StringComparison.OrdinalIgnoreCase))
            Toasts.Info($"{Users.DisplayFor(actorId)} {ActivityToast.Compose(added.Select(i => i.Kind))}");

        // Items already visible on the active tab have been seen — start their fade now.
        var visible = added.Where(i => string.Equals(i.Tab, _activeTab, StringComparison.OrdinalIgnoreCase))
                           .Select(i => i.Id).ToList();
        if (visible.Count > 0) _ = ClearFlashesAfter(visible);
    }

    private async Task ClearFlashesAfter(List<Guid> ids)
    {
        await Task.Delay(TimeSpan.FromSeconds(4)); // outlasts the ~3.6s flash animation, then clears the class
        await InvokeAsync(() =>
        {
            var changed = false;
            foreach (var id in ids) changed |= _flash.Remove(id);
            if (changed) StateHasChanged();
        });
    }

    // --- U-32: "jump to what just arrived" on the timeline, and a heartbeat that keeps relative
    // times ("2m ago") advancing on their own without a reload. ---
    private async Task JumpToNewTimeline()
    {
        var target = _newTimelineIds.FirstOrDefault();
        _newTimelineIds.Clear();
        if (target != Guid.Empty)
        {
            try { await JS.InvokeVoidAsync("imMotion.scrollToId", $"tl-{target}"); }
            catch { /* circuit/JS not ready — the pill still cleared */ }
        }
    }

    private System.Threading.Timer? _relativeTimeTicker;

    protected override async Task OnParametersSetAsync()
    {
        await Reload();
        // Honor an explicit ?tab=, otherwise refresh whatever tab is already active. The Id can change
        // under a reused component (e.g. following an "also in" cross-case link) while the active tab
        // stays the same, so always reload the active tab's data rather than only on a tab-name change.
        var tab = _tabs.FirstOrDefault(t => string.Equals(t, QTab, StringComparison.OrdinalIgnoreCase)) ?? _activeTab;
        await SetTab(tab);
        // U-30: a fresh case view starts with a clean slate — nothing is "new" until a collaborator acts.
        _flash.Clear();
        _newOnTab.Clear();
        _newTimelineIds.Clear();
        // FR-02: a different case starts with a clean draft slate; within the same case (e.g. an entity
        // deep-link that re-runs OnParametersSetAsync) keep any in-progress composer text.
        if (_draftsCaseId != Id) { _composerDrafts.Clear(); _draftsCaseId = Id; }
    }

    private async Task Reload() => await ReloadWith(await Cases.GetDetailAsync(Id));

    // REL-07: reload from an already-fetched detail, so the live-collab path can peek at accessibility
    // before deciding whether to swap the view away (see OnCaseChangedAsync).
    private async Task ReloadWith(Case? detail)
    {
        _case = detail;
        _notFound = _case is null;
        // C-05: record the authorized case-detail open (best-effort; coalesced into a view-session).
        if (_case is not null)
        {
            await AccessLog.RecordCaseOpenAsync(_case.Id, _case.CaseNumber, _case.IsRestricted);
            _isPinned = await Shortcuts.IsPinnedAsync(_case.Id); // PROD-20: header star + palette action state
        }
        _newClass = _case?.Classification ?? Classification.Incident;
        _newPhase = _case?.Phase ?? CasePhase.Triage;
        _newSeverity = _case?.Severity ?? Severity.Medium;
        // PROD-07: headline regulatory-notification deadline for the header badge (null when the feature is off).
        _notifyDeadlines = _case is null ? null : await Deadlines.EvaluateAsync(Id);
        // Readiness is computed here and passed to CaseOverviewTab for the stage-readiness card.
        _readinessEval = NextGateTrigger() is { } t ? await LoadGateAsync(t) : null;
        SeedKnownIds(); // U-30: absorb the current items so a viewer's own edits don't echo back as "new"
    }

    // --- Overview "Stage readiness" card: the gate for this case's next likely transition (passed to the tab) ---
    private GateEvaluation? _readinessEval;

    // PROD-07: the case's evaluated regulatory-notification deadlines (null when the feature is off).
    private IncidentManager.Application.Compliance.CaseNotificationDeadlines? _notifyDeadlines;

    /// <summary>The gate a case is heading toward next, given its current classification/phase.</summary>
    private StageGateTrigger? NextGateTrigger()
    {
        if (_case is null || _case.Phase == CasePhase.Closed) return null;
        return _case.Classification switch
        {
            null => StageGateTrigger.PromoteToAdverseEvent,
            Classification.AdverseEvent => StageGateTrigger.EscalateToIncident,
            Classification.Incident => StageGateTrigger.EscalateToBreach,
            Classification.Breach => StageGateTrigger.CloseCase,
            _ => null
        };
    }

    private async Task SetTab(string tab)
    {
        _activeTab = tab;
        // U-30: viewing a tab clears its "new" pulse; any items flashing there fade a moment after they're seen.
        _newOnTab.Remove(tab);
        var seen = _flash.Where(kv => string.Equals(kv.Value.Tab, tab, StringComparison.OrdinalIgnoreCase))
                         .Select(kv => kv.Key).ToList();
        if (seen.Count > 0) _ = ClearFlashesAfter(seen);
        // Reflect the active tab in the URL (?tab=) so a refresh / bookmark reopens the same tab instead of
        // snapping back to Overview. We use history.replaceState rather than NavigationManager so this doesn't
        // fire a Blazor navigation (which would reload the whole case on every tab click). The one-shot
        // ?entity= deep-link is cleared once consumed. No-ops during prerender (JS not yet available).
        await SyncTabUrl(tab);
        // Overview, Audit, Report, Entities, and Tasks self-load in their extracted tab components (UX-13).
    }

    private async Task SyncTabUrl(string tab)
    {
        try
        {
            var url = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["tab"] = tab,
                ["entity"] = null,
            });
            await JS.InvokeVoidAsync("history.replaceState", null, "", url);
        }
        catch (JSException) { /* circuit/JS not ready */ }
        catch (InvalidOperationException) { /* prerendering — JS interop unavailable */ }
    }

    private async Task OpenModal(string name)
    {
        if (_case is null) return;
        _activeModal = name;
        _modalError = null;
        _actionsOpen = false;
        // For a Complex Event (intake) the reclassify modal is a promotion — default to the first rung.
        _newClass = _case.Classification ?? Classification.AdverseEvent;
        _newSeverity = _case.Severity;
        _newPhase = _case.Phase;

        if (name is "restrict" or "unrestrict")
        {
            _restrictReason = null;
            var roles = await Cases.GetRestrictedClearanceRolesAsync();
            _clearanceNote = roles.Count > 0
                ? $"Only its incident commander, the people assigned to it and anyone with {Ui.RolePhrase(roles)} can open it."
                : "Only its incident commander and the people assigned to it can open it.";
        }

        if (name == "supersede")
        {
            _supersedeTargetId = null; _supersedeTargetNumber = null; _supersedeQuery = null; _supersedeReason = null;
            _supersedeCopy = true; _supersedeResults = [];
            // Cases already linked to this one are the likely "keep" candidates (a DuplicateOf link first).
            _supersedeLinked = (await Cases.GetCaseLinksAsync(Id))
                .OrderByDescending(l => l.Type == CaseLinkType.DuplicateOf && l.Outgoing).ToList();
        }

        // Open the assign form clean (a prior cancelled attempt may have left a stale selection).
        if (name == "assign") { _assignUserId = ""; _assignRole = CaseAssignmentRole.Analyst; }

        // REL-02: prefill the Legal-referral form from the current referral (edit-in-place) and capture the
        // optimistic-concurrency baseline, so a concurrent referral edit isn't silently overwritten.
        if (name == "legal")
        {
            _legalContact = _case.LegalReferral.ReferredToContact;
            _legalNote = _case.LegalReferral.RegulatoryRelevanceNote;
            _legalBaseline = _case.LegalReferralConcurrencyStamp();
        }

        // Prefill the materiality form from the current determination (edit-in-place); default a fresh one
        // to "Under review" rather than the Undetermined baseline the picker doesn't offer.
        if (name == "materiality")
        {
            var m = _case.Materiality;
            _materialityStatus = m.Status == MaterialityStatus.Undetermined ? MaterialityStatus.UnderReview : m.Status;
            _materialityDecisionMaker = m.DecisionMaker;
            _materialityDecidedOn = m.DecidedOnUtc?.UtcDateTime.Date;
            _materialityRationale = m.Rationale;
            _materialityBaseline = _case.MaterialityConcurrencyStamp(); // REL-02: optimistic-concurrency baseline
        }

        _attested.Clear();
        _gateOverride = null;
        _gateEval = name switch
        {
            "reclass" => await LoadGateAsync(ReclassTrigger()),
            "status" => await LoadGateAsync(StatusTrigger()),
            _ => null
        };
    }

    // --- Stage gates (C-07) ---
    private GateEvaluation? _gateEval;
    private readonly HashSet<Guid> _attested = new();
    private string? _gateOverride;

    /// <summary>The gate governing the reclassify modal's currently-selected target (escalations only).</summary>
    private StageGateTrigger? ReclassTrigger() =>
        _case is not null && (_case.Classification is null || _newClass > _case.Classification)
            ? StageGateTriggers.ForClassification(_newClass) : null;

    /// <summary>The Close gate when the status modal's selected phase is Closed.</summary>
    private StageGateTrigger? StatusTrigger() =>
        _case is { Phase: not CasePhase.Closed } && _newPhase == CasePhase.Closed
            ? StageGateTrigger.CloseCase : null;

    private async Task<GateEvaluation?> LoadGateAsync(StageGateTrigger? trigger)
    {
        if (trigger is not { } t) return null;
        var eval = await Cases.EvaluateGateAsync(Id, t);
        return eval.GateExists ? eval : null;
    }

    private async Task OnReclassTargetChanged()
    {
        _attested.Clear();
        _gateOverride = null;
        _gateEval = await LoadGateAsync(ReclassTrigger());
    }

    private async Task OnStatusTargetChanged()
    {
        _attested.Clear();
        _gateOverride = null;
        _gateEval = await LoadGateAsync(StatusTrigger());
    }

    private void ToggleAttest(Guid id, bool on)
    {
        if (on) _attested.Add(id); else _attested.Remove(id);
    }

    private IReadOnlyList<GateRequirementResult> UnmetBlocking =>
        _gateEval?.UnmetBlocking(_attested) ?? Array.Empty<GateRequirementResult>();

    private bool NeedsOverride => UnmetBlocking.Count > 0;

    // A gate may require a minimum-length rationale — enforced on the transition reason, and on the
    // override justification when the move is being forced through. Returns an error message, or null.
    private string? GateRationaleError(string? reason)
    {
        if (_gateEval is not { RequiresCommentary: true } g) return null;
        var min = g.CommentaryMinLength;
        if ((reason?.Trim().Length ?? 0) < min)
            return $"Record a reason of at least {min} characters to pass this gate.";
        if (NeedsOverride && (_gateOverride?.Trim().Length ?? 0) < min)
            return $"The override justification must be at least {min} characters for this gate.";
        return null;
    }

    // The gate readiness + override block shared by the reclassify and close-status modals.
    private RenderFragment GateModalSection() => @<text>
        @if (_gateEval is { } g)
        {
            <div class="mt-3">
                <GateChecklist Eval="g" Attested="_attested" OnChanged="StateHasChanged" />
                @if (NeedsOverride)
                {
                    <div class="alert alert-warning small mt-2 mb-1 py-2">
                        <span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>
                        @UnmetBlocking.Count required item@(UnmetBlocking.Count == 1 ? "" : "s") outstanding. Override with a recorded justification to proceed anyway.
                    </div>
                    <input class="form-control form-control-sm" placeholder="Override justification (required)" @bind="_gateOverride" @bind:event="oninput" />
                    @if (g.RequiresCommentary)
                    {
                        <div class="form-text @((_gateOverride?.Trim().Length ?? 0) < g.CommentaryMinLength ? "text-danger" : "text-success")">
                            @(_gateOverride?.Trim().Length ?? 0) / @g.CommentaryMinLength characters
                        </div>
                    }
                }
            </div>
        }
    </text>;

    // Live character counter shown under the transition reason when the active gate requires a
    // minimum-length rationale (the reason is what gets recorded on the gate passage).
    private RenderFragment RationaleHint(string? text) => @<text>
        @if (_gateEval is { RequiresCommentary: true } g)
        {
            <div class="form-text @((text?.Trim().Length ?? 0) < g.CommentaryMinLength ? "text-danger" : "text-success")">
                @(text?.Trim().Length ?? 0) / @g.CommentaryMinLength characters — recorded on the gate passage.
            </div>
        }
    </text>;

    private void CloseModal()
    {
        _activeModal = null;
        _modalError = null;
    }

    // Generic confirm for destructive removes: capture a message + the action to run on confirm.
    private void AskConfirm(string message, Func<Task> onConfirm) => _confirm = (message, onConfirm);
    private void CancelConfirm() => _confirm = null;

    // FR-05: intercept in-app navigation away from this case when a composer still holds unsubmitted text,
    // and confirm before it's discarded. Same-case navigation (a tab or entity deep-link keeps the editors
    // mounted) and the security idle-lock's /session-expired landing are never blocked.
    private async Task OnBeforeInternalNav(LocationChangingContext ctx)
    {
        if (_leaveConfirmed) { _leaveConfirmed = false; return; } // already confirmed — let it through
        var target = ctx.TargetLocation;
        if (target.Contains("session-expired", StringComparison.OrdinalIgnoreCase)) return;
        if (target.Contains($"cases/{Id}", StringComparison.OrdinalIgnoreCase)) return; // same case
        if (_accessLost) return; // REL-07: the case is gone; don't block leaving after a copy-out
        if (!await AnyDraftDirtyAsync()) return;
        ctx.PreventNavigation();
        _pendingLeave = target;
        _confirmLeaveOpen = true;
        StateHasChanged();
    }

    // FR-05 / REL-07: whether any composer holds unsubmitted text (the JS editor is the source of truth).
    private async Task<bool> AnyDraftDirtyAsync()
    {
        try { return await JS.InvokeAsync<bool>("markdownEditor.anyDirty"); }
        catch { return false; } // if we can't tell, don't obstruct
    }

    private void CancelLeave()
    {
        _confirmLeaveOpen = false;
        _pendingLeave = null;
    }

    private void ConfirmLeave()
    {
        var target = _pendingLeave;
        _confirmLeaveOpen = false;
        _pendingLeave = null;
        if (target is null) return;
        _leaveConfirmed = true; // the reissued navigation passes straight through the guard
        Nav.NavigateTo(target);
    }

    // UX-01: Esc closes whichever .modal.d-block dialog is open (focus is trapped inside it, so the
    // keydown bubbles here). The JS focus-trap restores focus to the trigger on release.
    private void OnModalEscape(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        if (_confirm is not null) CancelConfirm();
        else if (_confirmLeaveOpen) CancelLeave();
        else if (_previewShotId is not null) CloseShot();
        else if (_activeModal is not null) CloseModal();
    }

    // UX-01: whether any of the three trap modals is currently open (drives arm/release in OnAfterRenderAsync).
    private bool AnyTrapModalOpen => _confirm is not null || _previewShotId is not null || _activeModal is not null || _confirmLeaveOpen;
    private bool _modalTrapArmed;

    private async Task RunConfirm()
    {
        var action = _confirm?.OnConfirm;
        _confirm = null;
        if (action is not null) await action();
    }

    private string ModalTitle() => _activeModal switch
    {
        "reclass" => _case?.Classification is null ? "Promote onto the ladder" : "Reclassify case",
        "severity" => "Change severity",
        "status" => "Change status",
        "legal" => "Refer to Legal / Privacy",
        "holdrelease" => "Request legal hold release",
        "supersede" => "Supersede as a duplicate",
        "restrict" => "Restrict to need-to-know",
        "unrestrict" => "Lift restriction",
        "materiality" => "Record materiality determination",
        "archive" => "Archive case",
        "assign" => "Assign someone to this case",
        "reopen" => "Reopen case",
        _ => ""
    };

    /// <summary>Whether the materiality picker's current selection is a final call (needs full provenance).</summary>
    private bool MaterialityIsFinal => _materialityStatus is MaterialityStatus.Material or MaterialityStatus.NotMaterial;

    private static string MaterialityLabel(MaterialityStatus s) => s switch
    {
        MaterialityStatus.UnderReview => "Under review",
        MaterialityStatus.Material => "Material",
        MaterialityStatus.NotMaterial => "Not material",
        _ => "Undetermined"
    };

    private static string MaterialityBadgeClass(MaterialityStatus s) => s switch
    {
        MaterialityStatus.Material => "im-badge im-b-danger",
        MaterialityStatus.NotMaterial => "im-badge im-b-ok",
        MaterialityStatus.UnderReview => "im-badge im-b-warn",
        _ => "im-badge im-b-neutral"
    };

    private string ModalPrimaryLabel() => _activeModal switch
    {
        "archive" => "Archive",
        "assign" => "Assign",
        "reopen" => "Reopen",
        "holdrelease" => "Request release",
        "supersede" => "Supersede",
        "restrict" => "Restrict",
        "unrestrict" => "Lift restriction",
        _ => "Apply"
    };

    // Keep the primary disabled until required input is present. FR-14: the predicate mirrors the on-click
    // validation in ApplyModal exactly, so the button is disabled precisely when a submit would be rejected
    // — no modal leaves "Apply" enabled only to error on click. (The on-click checks stay as a safety net.)
    private bool ModalPrimaryDisabled() => _activeModal switch
    {
        "assign" => string.IsNullOrEmpty(_assignUserId),
        "reopen" => string.IsNullOrWhiteSpace(_reopenReason),
        "holdrelease" => string.IsNullOrWhiteSpace(_holdReleaseReason),
        "supersede" => _supersedeTargetId is null || string.IsNullOrWhiteSpace(_supersedeReason),
        "unrestrict" => string.IsNullOrWhiteSpace(_restrictReason),
        // A final call needs decision-maker, date and rationale; "Under review" needs none of them.
        "materiality" => _materialityStatus is MaterialityStatus.Material or MaterialityStatus.NotMaterial
            && (string.IsNullOrWhiteSpace(_materialityDecisionMaker) || _materialityDecidedOn is null
                || string.IsNullOrWhiteSpace(_materialityRationale)),
        // Reclass always needs a reason; both gated modals need an override justification when a blocking
        // requirement is unmet, and a long-enough rationale when the gate requires commentary.
        "reclass" => string.IsNullOrWhiteSpace(_reclassReason)
            || (NeedsOverride && string.IsNullOrWhiteSpace(_gateOverride))
            || GateRationaleError(_reclassReason) is not null,
        "status" => (NeedsOverride && string.IsNullOrWhiteSpace(_gateOverride))
            || GateRationaleError(_phaseReason) is not null,
        _ => false
    };

    private async Task ApplyModal()
    {
        _modalError = null;
        try
        {
            string done;
            switch (_activeModal)
            {
                case "reclass":
                    if (string.IsNullOrWhiteSpace(_reclassReason)) { _modalError = "A reason is required."; return; }
                    if (NeedsOverride && string.IsNullOrWhiteSpace(_gateOverride))
                    { _modalError = "Provide a justification to override the unmet gate requirements."; return; }
                    if (GateRationaleError(_reclassReason) is { } m1) { _modalError = m1; return; }
                    await Cases.ReclassifyAsync(Id, _newClass, _reclassReason,
                        _attested.Count > 0 ? _attested : null, _gateOverride);
                    _reclassReason = "";
                    done = $"Reclassified to {Ui.Label(_newClass)}";
                    break;
                case "severity":
                    await Cases.ChangeSeverityAsync(Id, _newSeverity, _severityReason);
                    _severityReason = null;
                    done = $"Severity changed to {_newSeverity}";
                    break;
                case "status":
                    if (NeedsOverride && string.IsNullOrWhiteSpace(_gateOverride))
                    { _modalError = "Provide a justification to override the unmet gate requirements."; return; }
                    if (GateRationaleError(_phaseReason) is { } m2) { _modalError = m2; return; }
                    await Cases.ChangePhaseAsync(Id, _newPhase, _phaseReason,
                        _attested.Count > 0 ? _attested : null, _gateOverride);
                    _phaseReason = null;
                    done = $"Status changed to {Ui.Label(_newPhase)}";
                    break;
                case "supersede":
                {
                    var res = await Cases.SupersedeAsync(Id, _supersedeTargetId!.Value, _supersedeCopy, _supersedeReason ?? "");
                    _closeAfterSupersede = $"Duplicate of {res.PrimaryCaseNumber}: {_supersedeReason?.Trim()}";
                    done = $"Superseded by {res.PrimaryCaseNumber}" + (_supersedeCopy ? $" · {res.IndicatorsCopied} indicator(s) copied" : "")
                           + ". Close this case to finish.";
                    break;
                }
                case "restrict":
                    await Cases.SetRestrictedAsync(Id, true, _restrictReason);
                    _restrictReason = null;
                    done = "Case restricted to need-to-know";
                    break;
                case "unrestrict":
                    if (string.IsNullOrWhiteSpace(_restrictReason)) { _modalError = "Say why the restriction is being lifted."; return; }
                    await Cases.SetRestrictedAsync(Id, false, _restrictReason);
                    _restrictReason = null;
                    done = "Restriction lifted";
                    break;
                case "holdrelease":
                    await Cases.RequestLegalHoldReleaseAsync(Id, _holdReleaseReason ?? "");
                    _holdReleaseReason = null;
                    done = "Release requested. A second person with Manage Legal approves it.";
                    break;
                case "legal":
                    await Cases.ReferToLegalAsync(Id, _legalContact, _legalNote, _legalBaseline);
                    done = "Referred to Legal / Privacy";
                    break;
                case "materiality":
                    DateTimeOffset? decidedOn = _materialityDecidedOn is { } d
                        ? new DateTimeOffset(DateTime.SpecifyKind(d.Date, DateTimeKind.Utc)) : null;
                    await Cases.RecordMaterialityAsync(Id, _materialityStatus, _materialityDecisionMaker, decidedOn,
                        _materialityRationale, _materialityBaseline);
                    done = $"Materiality: {MaterialityLabel(_materialityStatus)} recorded";
                    break;
                case "archive":
                    await Cases.SetArchivedAsync(Id, true);
                    done = "Case archived";
                    break;
                case "reopen":
                    if (string.IsNullOrWhiteSpace(_reopenReason)) { _modalError = "A reason is required."; return; }
                    await Cases.ReopenAsync(Id, _reopenReason);
                    _reopenReason = "";
                    done = "Case reopened";
                    break;
                case "assign":
                    if (string.IsNullOrWhiteSpace(_assignUserId)) { _modalError = "Select a user to assign."; return; }
                    var assignName = Users.Resolve(_assignUserId)?.DisplayName ?? _assignUserId;
                    await Cases.AssignAsync(Id, _assignUserId, assignName, _assignRole);
                    _assignUserId = "";
                    _assignRole = CaseAssignmentRole.Analyst;
                    done = $"Assigned {assignName}";
                    break;
                default:
                    done = "";
                    break;
            }
            _activeModal = null;
            await Reload();
            if (done.Length > 0) Toasts.Success(done);
            // PROD-11: after superseding, hand straight to the gated close step with the reason filled in.
            if (_closeAfterSupersede is { } closeReason)
            {
                _closeAfterSupersede = null;
                await AdvanceTo(CasePhase.Closed);
                _phaseReason = closeReason;
            }
        }
        catch (ForbiddenException)
        {
            // REL-08: access was revoked since the case loaded — close the modal, demote the UI, and explain.
            _activeModal = null;
            OnForbidden();
            Toasts.Error(PermissionLostMessage);
        }
        catch (GateNotSatisfiedException ex)
        {
            _modalError = ex.Message;
        }
        catch (StaleEditException ex)
        {
            // REL-02: another author changed the referral / materiality while this modal was open. Keep the
            // modal open with the user's entries intact, refresh the rest of the workspace to the newer values,
            // and re-baseline so a deliberate re-apply overwrites (mirrors the details/impact editors, FR-06).
            if (_activeModal == "legal") _legalBaseline = ex.CurrentStamp;
            else if (_activeModal == "materiality") _materialityBaseline = ex.CurrentStamp;
            _modalError = ex.Message + " Your entries are unsaved — review the current values, then apply again to overwrite, or Cancel to discard yours.";
            await Reload();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _modalError = ex.Message;
        }
    }

    private CasePhase? NextPhase()
    {
        if (_case is null) return null;
        var phases = Enum.GetValues<CasePhase>();
        var i = Array.IndexOf(phases, _case.Phase);
        return (i >= 0 && i < phases.Length - 1) ? phases[i + 1] : null;
    }

    private async Task AdvanceTo(CasePhase phase)
    {
        // FR-01: closing is gated (CloseCase). Route the stepper button through the status modal so the
        // readiness checklist + override justification are shown — rather than calling the bare API, which
        // throws GateNotSatisfiedException and (with no try/catch here) hit the generic Blazor error UI.
        if (phase == CasePhase.Closed)
        {
            await OpenModal("status");
            _newPhase = phase;
            await OnStatusTargetChanged(); // load the CloseCase gate for the newly-selected target
            return;
        }

        // Ungated forward steps: apply directly, but surface any domain error as a toast instead of
        // letting it reach the unhandled-error bar.
        try
        {
            await Cases.ChangePhaseAsync(Id, phase, null);
            await Reload();
            Toasts.Success($"Status changed to {Ui.Label(phase)}");
        }
        catch (ForbiddenException)
        {
            OnForbidden(); // REL-08
            Toasts.Error(PermissionLostMessage);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or GateNotSatisfiedException)
        {
            Toasts.Error(ex.Message);
        }
    }

    private int? TabCount(string tab)
    {
        if (_case is null) return null;
        var n = tab switch
        {
            "Timeline" => _case.TimelineEntries.Count,
            "Entities" => _case.Entities.Count,
            "Evidence" => _case.Evidence.Count,
            "Notes" => _case.Notes.Count(x => x.IsCurrent),
            "Tasks" => _case.ActionItems.Count(a => a.Status != ActionItemStatus.Done && a.Status != ActionItemStatus.Cancelled),
            _ => -1
        };
        return n <= 0 ? null : n;
    }

    private void StartRenumber()
    {
        if (_case is null) return;
        _editNumber = _case.CaseNumber;
        _renumberError = null;
        _renumberAvailable = null;
        _renumbering = true;
    }

    private void CancelRenumber()
    {
        _renumbering = false;
        _renumberError = null;
        _renumberCheckCts?.Cancel();
        _renumberAvailable = null;
    }

    private async Task SaveRenumber()
    {
        if (_case is null) return;
        _savingNumber = true;
        _renumberError = null;
        try
        {
            await Cases.RenumberAsync(_case.Id, _editNumber);
            _renumbering = false;
            await Reload();
            Toasts.Success("Case number updated");
        }
        catch (ForbiddenException)
        {
            _renumbering = false;
            OnForbidden(); // REL-08
            Toasts.Error(PermissionLostMessage);
        }
        catch (Exception ex)
        {
            _renumberError = ex.Message;
        }
        finally
        {
            _savingNumber = false;
        }
    }


    // Quick self-assign from the Actions menu — picks the case up as an Analyst without opening the modal.
    // Self-assignments never notify (the notifier skips assignee == assigner).
    private async Task AssignToMe()
    {
        _actionsOpen = false;
        try
        {
            await Cases.AssignAsync(Id, _myId, CurrentUser.DisplayName, CaseAssignmentRole.Analyst);
            await Reload();
            Toasts.Success("Assigned to you.");
        }
        catch (ForbiddenException)
        {
            OnForbidden(); // REL-08
            Toasts.Error(PermissionLostMessage);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Toasts.Error(ex.Message);
        }
    }

    // Directory users not yet assigned to this case — the pool the assign modal offers.
    private List<UserSummary> AssignableUsers() =>
        _case is null
            ? new List<UserSummary>()
            : Users.All()
                .Where(u => _case.Assignments.All(a => !string.Equals(a.UserId, u.UserId, StringComparison.OrdinalIgnoreCase)))
                .ToList();

    private async Task OpenShot(Guid evidenceId)
    {
        _previewShotId = evidenceId;
        // PROD-13: opening the preview is a deliberate look at the evidence, so it lands in the chain of custody
        // as "Viewed" (the thumbnails that load on their own never do). Best-effort: a failed write must not
        // stop the person seeing the image.
        try { await EvidenceSvc.RecordViewedAsync(evidenceId); }
        catch (Exception ex) when (ex is InvalidOperationException or Microsoft.EntityFrameworkCore.DbUpdateException) { }
    }
    private void CloseShot() => _previewShotId = null;

