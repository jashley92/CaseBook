@page "/cases/{Id:guid}"
@attribute [Authorize(Policy = Policies.ViewCases)]
@implements IAsyncDisposable
@inject CaseService Cases
@inject EvidenceService Evidence
@inject IntegrityService Integrity
@inject ReportService Reports
@inject IClock Clock
@inject IJSRuntime JS
@inject IAuthorizationService AuthZ
@inject IncidentManager.Application.Abstractions.ICaseChangeNotifier Notifier
@inject AuthenticationStateProvider AuthState
@inject IConfiguration Config
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IncidentManager.Application.Content.IMarkdownService Md
@inject ISeverityLabels SevLabels
@inject ToastService Toasts
@inject IncidentManager.Application.Admin.CaseTemplateService Templates
@inject IncidentManager.Application.Admin.ReportProfileService ReportProfiles
@inject TimeDisplay TimeDisp
@inject IncidentManager.Application.Sla.ISlaTargetsProvider SlaProvider
@inject IncidentManager.Application.Abstractions.ICurrentUser CurrentUser
@inject IncidentManager.Application.Access.IAccessLogService AccessLog

<PageTitle>@(_case?.CaseNumber ?? "Case")</PageTitle>

@if (_notFound)
{
    <h1>Case not found</h1>
    <p>The case does not exist or you don't have access to it. <a href="cases">Back to cases</a>.</p>
}
else if (_case is null)
{
    <p><em>Loading&hellip;</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h1 class="mb-1">
                <code>@_case.CaseNumber</code>
                @if (_canEdit && !_renumbering)
                {
                    <button class="btn btn-sm btn-link p-0 ms-1 align-baseline" title="Change case number" @onclick="StartRenumber">
                        <span class="bi bi-pencil" aria-hidden="true"></span>
                    </button>
                }
            </h1>
            @if (_renumbering)
            {
                <div class="d-flex align-items-center gap-2 mb-2" style="max-width:32rem">
                    <input class="form-control form-control-sm font-monospace" @bind="_editNumber" @bind:event="oninput"
                           placeholder="Case number" aria-label="Case number" />
                    <button class="btn btn-sm btn-primary" @onclick="SaveRenumber" disabled="@_savingNumber">Save</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelRenumber">Cancel</button>
                </div>
            }
            @if (_renumberError is not null)
            {
                <div class="text-danger small mb-2">@_renumberError</div>
            }
            <div class="mb-2">@_case.Title</div>
            <div>
                <span class="@Ui.ClassificationBadge(_case.Classification)">@Ui.Label(_case.Classification)</span>
                <span class="@Ui.SeverityBadge(_case.Severity)">@SevLabels.For(_case.Severity)</span>
                @{
                    var slaHead = SlaPolicy.Evaluate(_case.Severity, _case.Phase, _case.DetectedAtUtc,
                        _case.ContainedAtUtc, _case.ResolvedAtUtc, SlaProvider.Current, Clock.UtcNow);
                    var slaHeadClock = slaHead.Clock is { } hc ? Ui.SlaClockLabel(hc) : "SLA";
                    var slaHeadTiming = Ui.SlaTiming(slaHead);
                    var slaHeadTitle = slaHeadTiming.Length > 0 ? $"{slaHeadClock} · {slaHeadTiming}" : slaHeadClock;
                }
                @if (slaHead.State != SlaState.NoTarget)
                {
                    <span class="@Ui.SlaBadge(slaHead.State)" title="@slaHeadTitle">
                        <span class="bi @Ui.SlaGlyph(slaHead.State)" aria-hidden="true"></span> SLA: @Ui.SlaLabel(slaHead.State)
                    </span>
                }
                @if (_case.LegalReferral.IsReferred) { <span class="im-badge im-b-neutral">Legal referred</span> }
                @if (_case.IsRestricted) { <span class="im-badge im-b-warn">Restricted</span> }
                @if (_case.LegalHold) { <span class="im-badge im-b-danger">Legal hold</span> }
                @if (_case.IsArchived) { <span class="im-badge im-b-neutral">Archived</span> }
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <CasePresence CaseId="_case.Id" />
            @if (_canAnyAction)
            {
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" @onclick="() => _actionsOpen = !_actionsOpen">Actions</button>
                    <div class="dropdown-menu dropdown-menu-end @(_actionsOpen ? "show" : "")">
                        @if (_canReclassify) { <button class="dropdown-item" @onclick='() => OpenModal("reclass")'>@(_case.Classification is null ? "Promote to ladder…" : "Reclassify…")</button> }
                        @if (_canEdit)
                        {
                            <button class="dropdown-item" @onclick='() => OpenModal("severity")'>Change severity…</button>
                            <button class="dropdown-item" @onclick='() => OpenModal("status")'>Change status…</button>
                            <button class="dropdown-item" @onclick='() => OpenModal("legal")'>Refer to Legal / Privacy…</button>
                        }
                        @if (_canManageLegal)
                        {
                            <button class="dropdown-item" @onclick="() => SetLegalHold(!_case.LegalHold)">@(_case.LegalHold ? "Release legal hold" : "Place legal hold")</button>
                        }
                        @if (_canAdmin)
                        {
                            <div class="dropdown-divider"></div>
                            @if (_case.IsArchived)
                            {
                                <button class="dropdown-item" @onclick="() => SetArchived(false)">Restore from archive</button>
                            }
                            else
                            {
                                <button class="dropdown-item text-danger" @onclick='() => OpenModal("archive")'>Archive case…</button>
                            }
                        }
                    </div>
                </div>
            }
            <a class="btn btn-sm btn-outline-secondary" href="cases">← All cases</a>
        </div>
    </div>

    <div class="d-flex align-items-center flex-wrap gap-1 my-3">
        @{ var _phases = Enum.GetValues<CasePhase>(); var _curIdx = Array.IndexOf(_phases, _case.Phase); }
        @for (var i = 0; i < _phases.Length; i++)
        {
            var isDone = i < _curIdx;
            var isCur = i == _curIdx;
            <span class="im-badge rounded-pill @(isCur ? "im-b-info" : isDone ? "im-b-ok" : "im-b-neutral")">@Ui.Label(_phases[i])</span>
            @if (i < _phases.Length - 1) { <span class="text-muted small">›</span> }
        }
        @if (_canEdit && NextPhase() is { } np)
        {
            <button class="btn btn-sm btn-primary ms-2" @onclick="() => AdvanceTo(np)">Advance to @Ui.Label(np) →</button>
        }
        @if (_canEdit && _case.Phase == CasePhase.Closed)
        {
            <button class="btn btn-sm btn-outline-primary ms-2" @onclick='() => OpenModal("reopen")'>
                <span class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></span>Reopen case
            </button>
        }
    </div>

    <ul class="nav nav-tabs mb-3">
        @foreach (var tab in _tabs)
        {
            <li class="nav-item">
                <button class="nav-link @(_activeTab == tab ? "active" : "")" @onclick="() => SetTab(tab)">
                    @tab@{ var _tc = TabCount(tab); }@if (_tc is { } cnt) { <span class="im-badge im-b-neutral ms-1 im-bump" @key="@($"{tab}:{cnt}")">@cnt</span> }@if (TabHasNew(tab)) { <span class="tab-newdot" title="New activity from a collaborator" aria-label="New activity"></span> }
                </button>
            </li>
        }
    </ul>

    @if (_confirm is not null)
    {
        <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5)" @onclick="CancelConfirm">
            <div class="modal-dialog" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Please confirm</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CancelConfirm"></button>
                    </div>
                    <div class="modal-body"><p class="mb-0">@_confirm.Value.Message</p></div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" @onclick="CancelConfirm">Cancel</button>
                        <button class="btn btn-danger" @onclick="RunConfirm">Remove</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* U-40: screenshot lightbox — preview an attached screenshot in place instead of forcing a download. *@
    @if (_previewShotId is { } previewId)
    {
        <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.65)" @onclick="CloseShot">
            <div class="modal-dialog modal-xl modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h5 class="modal-title"><span class="bi bi-image me-2" aria-hidden="true"></span>Screenshot</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseShot"></button>
                    </div>
                    <div class="modal-body text-center bg-body-tertiary" style="max-height:75vh;overflow:auto">
                        <img src="evidence/@previewId/inline" alt="attached screenshot"
                             style="max-width:100%;height:auto;border-radius:.375rem" />
                    </div>
                    <div class="modal-footer py-2">
                        <a class="btn btn-outline-primary" href="evidence/@previewId" target="_blank" rel="noopener noreferrer">
                            <span class="bi bi-download me-1" aria-hidden="true"></span>Download
                        </a>
                        <button class="btn btn-outline-secondary" @onclick="CloseShot">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Keyed by the active tab so the subtree is rebuilt on a tab switch, replaying the .tabbody
       fade-in (U-22 motion). The key doesn't change on case/id navigation, so switching cases
       doesn't force an extra remount. *@
    <div class="tabbody" @key="_activeTab">
    @if (_activeTab == "Overview")
    {
        var (slaContain, slaResolve) = SlaPolicy.Breakdown(_case.Severity, _case.Phase,
            _case.DetectedAtUtc, _case.ContainedAtUtc, _case.ResolvedAtUtc, SlaProvider.Current, Clock.UtcNow);
        var hasSla = slaContain.State != SlaState.NoTarget || slaResolve.State != SlaState.NoTarget;
        var openTasks = _case.ActionItems.Count(a => a.Status != ActionItemStatus.Done && a.Status != ActionItemStatus.Cancelled);

        if (_retentionMsg is not null)
        {
            <div class="alert alert-danger py-2 small">@_retentionMsg</div>
        }

        @* Vitals strip — the at-a-glance row (response SLA, lifecycle timestamps, dwell, counts) spanning
           the full width, so the "how's this case doing" scan is the first thing on the pane, not the last. *@
        <div class="im-vitals mb-4">
            @if (hasSla)
            {
                @SlaVital(slaContain)
                @SlaVital(slaResolve)
            }
            <div class="im-vital"><div class="small text-muted">Detected</div><div class="fw-semibold">@TimeDisp.Long(_case.DetectedAtUtc)</div></div>
            <div class="im-vital"><div class="small text-muted">Contained</div><div class="fw-semibold">@TimeDisp.Long(_case.ContainedAtUtc)</div></div>
            <div class="im-vital"><div class="small text-muted">Resolved</div><div class="fw-semibold">@TimeDisp.Long(_case.ResolvedAtUtc)</div></div>
            @if (_case.OccurredAtUtc is { } occ && _case.DetectedAtUtc is { } det)
            {
                <div class="im-vital"><div class="small text-muted">Dwell</div><div class="fw-semibold">@DwellLabel(det - occ)</div><div class="small text-muted">before detection</div></div>
            }
            <div class="im-vital"><div class="small text-muted">Evidence · open tasks</div><div class="fw-semibold">@_case.Evidence.Count · @openTasks</div></div>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                @* Case narrative — details and impact assessment folded into one card. *@
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>Details</span>
                        <AuthorizeView Policy="@Policies.EditCases" Context="ed">
                            @if (!_editingDetails)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="BeginEditDetails">Edit</button>
                            }
                        </AuthorizeView>
                    </div>
                    <div class="card-body">
                        @if (_editingDetails)
                        {
                            <div class="mb-2">
                                <label class="form-label small mb-0">Title</label>
                                <input class="form-control form-control-sm" @bind="_edTitle" @bind:event="oninput" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small mb-0">@DetectionLabel Case ID</label>
                                <input class="form-control form-control-sm" @bind="_edDetection" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small mb-0">Data types involved</label>
                                <input class="form-control form-control-sm" @bind="_edDataTypes" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small mb-0">Impacted assets</label>
                                <input class="form-control form-control-sm" @bind="_edImpacted" />
                            </div>
                            <div class="row g-2 mb-2">
                                <div class="col-sm-6">
                                    <label class="form-label small mb-0">Detected (@TimeDisp.Label)</label>
                                    <input type="datetime-local" class="form-control form-control-sm" @bind="_edDetected"
                                           title="When the matter was first detected or reported. Drives the response-SLA clock and dwell metrics. Set it to the real detection time, not when the case was filed. Entered in @TimeDisp.Label." />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small mb-0">Initial activity <span class="text-muted">(optional)</span></label>
                                    <input type="datetime-local" class="form-control form-control-sm" @bind="_edOccurred"
                                           title="When adversary activity actually began (initial access / first malicious activity), if known. Detected minus this is the dwell time. Entered in @TimeDisp.Label." />
                                </div>
                            </div>
                            @if (_detailsError is { } derr)
                            {
                                <div class="alert alert-warning py-1 px-2 small mb-2">@derr</div>
                            }
                            <div class="mb-2">
                                <label class="form-label small mb-0">Summary <span class="text-muted">· Markdown: headings, <strong>**bold**</strong>, lists, links</span></label>
                                @* EasyMDE enhances this textarea (managed in OnAfterRenderAsync); value pulled on Save. *@
                                <textarea id="@SummaryEditorId" class="form-control"></textarea>
                            </div>
                            <button class="btn btn-sm btn-primary" @onclick="SaveDetails" disabled="@(string.IsNullOrWhiteSpace(_edTitle) || _edDetected is null)">Save</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => _editingDetails = false)">Cancel</button>
                        }
                        else
                        {
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Origin</dt>
                                <dd class="col-sm-8">@(_case.Origin == CaseOrigin.ThirdParty ? "Third-party / vendor" : "Internal detection")</dd>
                                @if (_case.ThirdParty is not null)
                                {
                                    <dt class="col-sm-4">Vendor</dt>
                                    <dd class="col-sm-8">@_case.ThirdParty.VendorName
                                        @if (!string.IsNullOrWhiteSpace(_case.ThirdParty.VendorContact)) { <text>(@_case.ThirdParty.VendorContact)</text> }
                                    </dd>
                                }
                                <dt class="col-sm-4">@DetectionLabel Case</dt>
                                <dd class="col-sm-8">@(_case.DetectionCaseId ?? "—")
                                    @{ var detectionUrl = DetectionCaseUrl(); }
                                    @if (detectionUrl is not null)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary py-0 ms-2" href="@detectionUrl" target="_blank" rel="noopener noreferrer">Open in @DetectionLabel</a>
                                    }
                                </dd>
                                <dt class="col-sm-4">Data types</dt>
                                <dd class="col-sm-8">@(_case.DataTypesInvolved ?? "—")</dd>
                                <dt class="col-sm-4">Impacted assets</dt>
                                <dd class="col-sm-8">@(_case.ImpactedAssets ?? "—")</dd>
                                <dt class="col-sm-4">Opened</dt>
                                <dd class="col-sm-8">@TimeDisp.Long(_case.CreatedAtUtc) by @Users.DisplayFor(_case.CreatedBy)</dd>
                                <dt class="col-sm-4">Summary</dt>
                                <dd class="col-sm-8">
                                    @if (string.IsNullOrWhiteSpace(_case.Summary))
                                    {
                                        <text>—</text>
                                    }
                                    else
                                    {
                                        <div class="md-body">@((MarkupString)Md.ToHtml(_case.Summary))</div>
                                    }
                                </dd>
                            </dl>
                        }

                        <hr class="my-3" />

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h3 class="h6 mb-0">Impact assessment</h3>
                            <AuthorizeView Policy="@Policies.EditCases" Context="ie">
                                @if (!_editingImpact)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="BeginEditImpact">Edit</button>
                                }
                            </AuthorizeView>
                        </div>
                        @if (_editingImpact)
                        {
                            <div class="mb-2">
                                <label class="form-label small mb-0">Affected individuals (estimate)</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="_impCount" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label small mb-1 d-block">Data elements involved</label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var el in _dataElements)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="de-@el.Key"
                                                   checked="@_impElementKeys.Contains(el.Key)"
                                                   @onchange="e => ToggleElement(el.Key, (bool)(e.Value ?? false))" />
                                            <label class="form-check-label small" for="de-@el.Key">@el.Label</label>
                                        </div>
                                    }
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small mb-0">Affected jurisdictions (state codes, comma-separated)</label>
                                <input class="form-control form-control-sm" placeholder="e.g. NY, NJ, CT" @bind="_impStates" />
                            </div>
                            <button class="btn btn-sm btn-primary" @onclick="SaveImpact">Save</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _editingImpact = false">Cancel</button>
                        }
                        else if (_case.AffectedIndividualsCount is null && _case.DataElements.Count == 0 && string.IsNullOrWhiteSpace(_case.AffectedStates))
                        {
                            <p class="text-muted small mb-0">Not yet assessed. This captures the structured facts (affected count, data elements, jurisdictions) for the Legal / regulatory handoff.</p>
                        }
                        else
                        {
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Affected individuals</dt>
                                <dd class="col-sm-8">@(_case.AffectedIndividualsCount?.ToString("N0") ?? "—")</dd>
                                <dt class="col-sm-4">Data elements</dt>
                                <dd class="col-sm-8">
                                    @if (_case.DataElements.Count == 0)
                                    {
                                        <text>—</text>
                                    }
                                    else
                                    {
                                        @foreach (var key in SelectedElementKeysOrdered())
                                        {
                                            <span class="im-badge im-b-neutral me-1 mb-1">@DataElementLabel(key)</span>
                                        }
                                    }
                                </dd>
                                <dt class="col-sm-4">Jurisdictions</dt>
                                <dd class="col-sm-8">@(_case.AffectedStates ?? "—")</dd>
                            </dl>
                        }
                    </div>
                </div>

                @if (_readinessEval is { } rg)
                {
                    <div class="im-sec mt-3">
                        <div class="im-sec-head">
                            <h3>Stage readiness</h3>
                            <div class="d-flex align-items-center gap-2">
                                @if (ReadinessMachineOutstanding == 0)
                                {
                                    <span class="im-badge im-b-ok">Data complete</span>
                                }
                                else
                                {
                                    <span class="im-badge im-b-warn">@ReadinessMachineOutstanding outstanding</span>
                                }
                                <button class="btn btn-sm btn-link p-0 text-decoration-none" @onclick="() => _showReadiness = !_showReadiness" aria-label="Toggle stage readiness">
                                    <span class="bi @(_showReadiness ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></span>
                                </button>
                            </div>
                        </div>
                        @if (_showReadiness)
                        {
                            <p class="text-muted small mb-2">Completeness required to <strong>@StageGateTriggers.Label(rg.Trigger).ToLowerInvariant()</strong>. Enforced when you make the transition, and overridable with a recorded justification.</p>
                            <GateChecklist Eval="rg" Attested="_readinessAttested" Interactive="false" />
                        }
                    </div>
                }

                <div class="im-sec mt-3">
                    <div class="im-sec-head"><h3>Assignments</h3></div>
                    <div class="im-chips">
                        @if (_case.Assignments.Count == 0)
                        {
                            <span class="text-muted small">No one assigned yet.</span>
                        }
                        @foreach (var a in _case.Assignments.OrderBy(x => x.Role))
                        {
                            <span class="im-chip" title="@a.UserDisplayName · @a.Role">
                                <span class="bi bi-person" aria-hidden="true"></span>
                                <span class="im-chip-name">@a.UserDisplayName</span>
                                <span class="im-chip-role">@a.Role</span>
                                <AuthorizeView Policy="@Policies.EditCases" Context="rm">
                                    <button type="button" class="im-chip-x" aria-label="Remove @a.UserDisplayName"
                                            @onclick='() => AskConfirm($"Remove {a.UserDisplayName} from this case?", () => DoUnassign(a.UserId))'>×</button>
                                </AuthorizeView>
                            </span>
                        }
                        <AuthorizeView Policy="@Policies.EditCases" Context="asg">
                            <button type="button" class="im-chip-add" @onclick='() => OpenModal("assign")'>
                                <span class="bi bi-plus-lg" aria-hidden="true"></span> Assign
                            </button>
                        </AuthorizeView>
                    </div>
                </div>

                <div class="im-sec mt-3">
                    <div class="im-sec-head"><h3>MITRE ATT&CK</h3></div>
                    <div class="im-chips">
                        @if (_case.Techniques.Count == 0)
                        {
                            <span class="text-muted small">No techniques tagged.</span>
                        }
                        @foreach (var t in _case.Techniques.OrderBy(x => x.Tactic).ThenBy(x => x.TechniqueId))
                        {
                            <span class="im-chip im-chip-tac" style="--tac:@Ui.TacticColor(t.Tactic)" title="@(t.TechniqueId + (string.IsNullOrWhiteSpace(t.Name) ? "" : " — " + t.Name) + " · " + Ui.Label(t.Tactic))">
                                <a href="https://attack.mitre.org/techniques/@(t.TechniqueId.Replace('.', '/'))/" target="_blank" rel="noopener noreferrer"><code>@t.TechniqueId</code></a>
                                @if (t.Tactic != MitreTactic.Unspecified) { <span class="im-chip-role">@Ui.Label(t.Tactic)</span> }
                                <AuthorizeView Policy="@Policies.EditCases" Context="tq">
                                    <button type="button" class="im-chip-x" aria-label="Remove @t.TechniqueId"
                                            @onclick='() => AskConfirm($"Remove technique {t.TechniqueId}?", () => RemoveTechnique(t.Id))'>×</button>
                                </AuthorizeView>
                            </span>
                        }
                        <AuthorizeView Policy="@Policies.EditCases" Context="tqadd">
                            <button type="button" class="im-chip-add" @onclick="OpenTechMatrix">
                                <span class="bi bi-diagram-3 me-1" aria-hidden="true"></span> Techniques
                            </button>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                @* Context rail — related cases and the change log. *@
                <div class="im-sec">
                    <div class="im-sec-head">
                        <h3>Related cases</h3>
                        <div class="d-flex align-items-center gap-2">
                            @if (_links.Count > 0) { <span class="im-badge im-b-neutral">@_links.Count</span> }
                            <AuthorizeView Policy="@Policies.EditCases" Context="lk">
                                @if (!_addingLink)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="BeginAddLink">Link a case</button>
                                }
                            </AuthorizeView>
                        </div>
                    </div>
                    @if (_addingLink)
                    {
                        <div class="mb-2">
                            <label class="form-label small mb-0">Relationship</label>
                            <select class="form-select form-select-sm" @bind="_linkType">
                                @foreach (var t in Enum.GetValues<CaseLinkType>())
                                {
                                    <option value="@t">@Ui.CaseLinkLabel(t, true)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small mb-0">Case</label>
                            @if (_linkTargetId is not null)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <span class="im-badge im-b-info">@_linkTargetLabel</span>
                                    <button class="btn btn-sm btn-link p-0" @onclick="ClearLinkTarget">change</button>
                                </div>
                            }
                            else
                            {
                                <input class="form-control form-control-sm" placeholder="Search by number or title"
                                       @bind="_linkQuery" @bind:event="oninput" @bind:after="SearchLinkTargets" />
                                @if (_linkResults.Count > 0)
                                {
                                    <ul class="list-group mt-1">
                                        @foreach (var r in _linkResults)
                                        {
                                            <li class="list-group-item list-group-item-action py-1 small" role="button" @onclick="() => SelectLinkTarget(r)">
                                                <strong>@r.CaseNumber</strong> — @r.Title
                                                <span class="@Ui.ClassificationBadge(r.Classification) ms-1">@Ui.Label(r.Classification)</span>
                                            </li>
                                        }
                                    </ul>
                                }
                                else if (!string.IsNullOrWhiteSpace(_linkQuery))
                                {
                                    <div class="form-text">No matching visible cases.</div>
                                }
                            }
                        </div>
                        <div class="mb-2">
                            <label class="form-label small mb-0">Note (optional)</label>
                            <input class="form-control form-control-sm" @bind="_linkDesc" placeholder="Why are these related?" />
                        </div>
                        <button class="btn btn-sm btn-primary" @onclick="AddLink" disabled="@(_linkTargetId is null)">Add link</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelAddLink">Cancel</button>
                    }
                    @if (_links.Count == 0 && !_addingLink)
                    {
                        <p class="text-muted small mb-0">No related cases yet. Link duplicates, related cases, or others in the same campaign.</p>
                    }
                    else if (_links.Count > 0)
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var l in _links)
                            {
                                <li class="list-group-item px-0 d-flex justify-content-between align-items-start">
                                    <div>
                                        <span class="@Ui.CaseLinkBadge(l.Type)">@Ui.CaseLinkLabel(l.Type, l.Outgoing)</span>
                                        <a href="cases/@l.OtherCaseId" class="ms-1 fw-semibold text-decoration-none">@l.OtherCaseNumber</a>
                                        <div class="small text-muted">@l.OtherTitle</div>
                                        @if (!string.IsNullOrWhiteSpace(l.Description)) { <div class="small fst-italic text-muted">@l.Description</div> }
                                    </div>
                                    <AuthorizeView Policy="@Policies.EditCases" Context="rl">
                                        <button class="btn btn-sm btn-outline-danger py-0" title="Remove link"
                                                @onclick='() => AskConfirm($"Remove the link to {l.OtherCaseNumber}?", () => RemoveLink(l.LinkId))'>×</button>
                                    </AuthorizeView>
                                </li>
                            }
                        </ul>
                    }
                </div>

                <div class="im-sec">
                    <button class="btn btn-sm btn-link p-0 text-decoration-none" @onclick="() => _showHistory = !_showHistory">
                        <span class="bi @(_showHistory ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></span>
                        Change history (@History().Count())
                    </button>
                    @if (_showHistory)
                    {
                        @if (!History().Any())
                        {
                            <p class="text-muted small mt-2 mb-0">No changes recorded.</p>
                        }
                        else
                        {
                            <table class="table table-sm mt-2 mb-0">
                                <thead><tr><th>When (@TimeDisp.Label)</th><th>Attribute</th><th>Change</th><th>By</th></tr></thead>
                                <tbody>
                                    @foreach (var h in History().OrderByDescending(x => x.At))
                                    {
                                        <tr>
                                            <td class="small">@TimeDisp.Long(h.At)</td>
                                            <td class="small">@h.Attribute</td>
                                            <td class="small">@h.Change</td>
                                            <td class="small">@h.By</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            </div>
        </div>
    }
    else if (_activeTab == "Timeline")
    {
        <div class="btn-group mb-2" role="group" aria-label="Timeline lens">
            <button class="btn btn-sm @(_tlLens is null ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SwitchLens(null)">All</button>
            <button class="btn btn-sm @(_tlLens == TimelineKind.Event ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SwitchLens(TimelineKind.Event)">Event</button>
            <button class="btn btn-sm @(_tlLens == TimelineKind.Investigation ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SwitchLens(TimelineKind.Investigation)">Investigation</button>
        </div>
        <p class="text-muted small">
            @(_tlLens switch
            {
                TimelineKind.Event => "Facts and timing of the actual event: the attack narrative.",
                TimelineKind.Investigation => "Analyst and team actions during the investigation.",
                _ => "The full chronology: what happened and what the team did, interleaved."
            })
        </p>

        <AuthorizeView Policy="@Policies.EditCases">
            <div id="timeline-dropzone" class="card mb-3 @(_tlEditId is not null ? "border-primary" : "")">
                <div class="card-body">
                    @* U-40: hidden sink the paste shim feeds a pasted screenshot into; staged then attached on Add. *@
                    <InputFile id="timeline-file-paste" class="d-none" accept="image/*" OnChange="OnTimelinePasted" />
                    @if (_tlEditId is null)
                    {
                        <div class="small text-muted mb-2 d-flex align-items-center gap-2 flex-wrap">
                            <span><span class="bi bi-clipboard me-1"></span>Paste a screenshot to attach it to this entry. It's stored as hashed, chain-of-custody evidence.</span>
                            @if (_tlShotBytes is not null)
                            {
                                <span class="im-badge im-b-info">
                                    <span class="bi bi-paperclip me-1"></span>@_tlShotName
                                </span>
                                <img src="@TlShotDataUri()" alt="pasted screenshot preview" style="max-height:40px;border-radius:.25rem;border:1px solid var(--bs-border-color)" />
                                <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="ClearTimelineShot">Remove</button>
                            }
                        </div>
                    }
                    @if (_tlEditId is not null)
                    {
                        <div class="alert alert-primary py-1 px-2 small d-flex justify-content-between align-items-center mb-2">
                            <span>
                                <span class="bi bi-pencil-square" aria-hidden="true"></span>
                                @(_tlAddKind == TimelineKind.Event
                                    ? "Editing this event step. The audit trail records the change."
                                    : "Editing this entry. A new version is saved; the prior one is kept.")
                            </span>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none p-0"
                                    @onclick="CancelTimelineEdit">Cancel</button>
                        </div>
                    }
                    @if (_tlEditId is null && _tlLens is null)
                    {
                        @* All lens: the composer serves both timelines, so pick which to add. *@
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="text-muted small">Add:</span>
                            <div class="btn-group btn-group-sm" role="group" aria-label="What to add">
                                <button type="button" class="btn @(_tlAddKind == TimelineKind.Event ? "btn-secondary" : "btn-outline-secondary")"
                                        @onclick="() => SetAddKind(TimelineKind.Event)">Event step</button>
                                <button type="button" class="btn @(_tlAddKind == TimelineKind.Investigation ? "btn-secondary" : "btn-outline-secondary")"
                                        @onclick="() => SetAddKind(TimelineKind.Investigation)">Investigation entry</button>
                            </div>
                        </div>
                    }
                    @if (_tlAddKind == TimelineKind.Event)
                    {
                        @* Event = the attack narrative: ATT&CK tactic(s) + actor→target attribution to IOCs. *@
                        <div class="row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Occurred (UTC)</label>
                                <input type="datetime-local" class="form-control form-control-sm" @bind="_tlWhen" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Actor <span class="text-muted">(from IOCs)</span></label>
                                <select class="form-select form-select-sm" @bind="_evtActorId">
                                    <option value="">— none —</option>
                                    @foreach (var en in _case.Entities)
                                    {
                                        <option value="@en.Id">@EntityOptionLabel(en)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Target <span class="text-muted">(from IOCs)</span></label>
                                <select class="form-select form-select-sm" @bind="_evtTargetId">
                                    <option value="">— none —</option>
                                    @foreach (var en in _case.Entities)
                                    {
                                        <option value="@en.Id">@EntityOptionLabel(en)</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="mt-2">
                            <label class="form-label small mb-0">ATT&amp;CK <span class="text-muted">(technique or tactic, optional)</span></label>
                            <AttackStepPicker @bind-TechniqueId="_evtTechnique" @bind-Tactic="_evtTactic" />
                        </div>
                        <div class="mt-2">
                            <label class="form-label small mb-1">What the adversary did</label>
                            <textarea class="form-control form-control-sm" rows="2" @bind="_tlDesc" @bind:event="oninput"
                                      placeholder="e.g. Authenticated to the VPN from 203.0.113.66 with valid credentials"></textarea>
                        </div>
                        <div class="row g-2 align-items-end mt-1">
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Source</label>
                                <input class="form-control form-control-sm" @bind="_tlSource" placeholder="@($"{DetectionLabel}…")" />
                            </div>
                            @if (_tlEditId is not null)
                            {
                                <div class="col-md-4">
                                    <label class="form-label small mb-0">Reason for change <span class="text-muted">(optional)</span></label>
                                    <input class="form-control form-control-sm" @bind="_tlReason" placeholder="e.g. corrected source IP" />
                                </div>
                            }
                            <div class="col d-flex justify-content-end align-items-end gap-2">
                                @if (_tlEditId is null)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="AddEventStep">
                                        <span class="bi bi-plus-lg" aria-hidden="true"></span> Add step
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelTimelineEdit">Cancel</button>
                                    <button class="btn btn-sm btn-primary" @onclick="SaveEventEdit">
                                        <span class="bi bi-check-lg" aria-hidden="true"></span> Save changes
                                    </button>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        @* Investigation = the analyst's working log: response type + Markdown notes. *@
                        <div class="row g-2 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label small mb-0">Type</label>
                                <select class="form-select form-select-sm" @bind="_tlType">
                                    @foreach (var t in Ui.Options<TimelineEntryType>("TimelineEntryType"))
                                    {
                                        <option value="@t">@Ui.Label(t)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-0">Occurred (UTC)</label>
                                <input type="datetime-local" class="form-control form-control-sm" @bind="_tlWhen" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-0">Source</label>
                                <input class="form-control form-control-sm" @bind="_tlSource" placeholder="@($"{DetectionLabel}…")" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label small mb-1">
                                Notes <span class="text-muted">· Markdown: headings, <strong>**bold**</strong>, bullet/numbered lists, links</span>
                            </label>
                            @* EasyMDE enhances this textarea (managed in OnAfterRenderAsync); value pulled on Add/Save. *@
                            <textarea id="@InvEditorId" class="form-control"></textarea>
                            @if (_tlEditId is not null)
                            {
                                <div class="mt-2">
                                    <label class="form-label small mb-0">Reason for change <span class="text-muted">(optional)</span></label>
                                    <input class="form-control form-control-sm" @bind="_tlReason" placeholder="e.g. clarified meeting outcome" />
                                </div>
                            }
                            <div class="mt-2 d-flex justify-content-end gap-2">
                                @if (_tlEditId is null)
                                {
                                    <button class="btn btn-sm btn-primary" @onclick="AddTimeline">
                                        <span class="bi bi-plus-lg" aria-hidden="true"></span> Add entry
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelTimelineEdit">Cancel</button>
                                    <button class="btn btn-sm btn-primary" @onclick="SaveInvestigationEdit">
                                        <span class="bi bi-check-lg" aria-hidden="true"></span> Save new version
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </AuthorizeView>

        <div class="tl-region">
        @{
            // Only current versions are shown; superseded Investigation edits live in history (below) and the audit trail.
            var tlAll = _case.TimelineEntries.Where(x => (_tlLens is null || x.Kind == _tlLens) && x.IsCurrent).ToList();
            var tlView = FilteredTimeline(tlAll);
            // The attack chain is always event-only, regardless of lens (shown under All and Event).
            var tlChain = _case.TimelineEntries.Where(x => x.Kind == TimelineKind.Event && x.IsCurrent)
                .OrderBy(x => x.OccurredAtUtc).ThenBy(x => x.CreatedAtUtc).ToList();
        }

        @if (_tlLens != TimelineKind.Investigation && tlChain.Count > 0)
        {
            <div class="killchain-wrap mb-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="fw-semibold small"><span class="bi bi-diagram-3 me-1" aria-hidden="true"></span>Attack chain</span>
                    <button type="button" class="btn btn-sm btn-link text-decoration-none py-0"
                            @onclick="() => _showKillChain = !_showKillChain">@(_showKillChain ? "Hide" : "Show")</button>
                </div>
                @if (_showKillChain)
                {
                    <div class="killchain">
                        @for (var i = 0; i < tlChain.Count; i++)
                        {
                            var step = tlChain[i];
                            if (i > 0)
                            {
                                <div class="killchain-arrow" aria-hidden="true"><span class="bi bi-arrow-right"></span></div>
                            }
                            <div class="killchain-node" style="--tl-color:@Ui.TacticColor(PrimaryTactic(step))">
                                <div class="killchain-node-head">
                                    <span class="killchain-idx">@(i + 1)</span>
                                    <span class="bi @Ui.TacticGlyph(PrimaryTactic(step))" aria-hidden="true"></span>
                                    <time class="killchain-time" title="@TimeDisp.Long(step.OccurredAtUtc)">@TimeDisp.Short(step.OccurredAtUtc)</time>
                                </div>
                                <div class="killchain-tactics">
                                    @foreach (var tt in step.Tactics.Select(x => x.Tactic).OrderBy(x => (int)x))
                                    {
                                        <span class="tactic-chip" style="--tac:@Ui.TacticColor(tt)">@Ui.Label(tt)</span>
                                    }
                                </div>
                                @if (EntityById(step.ActorEntityId) is not null || EntityById(step.TargetEntityId) is not null)
                                {
                                    <div class="killchain-attrib">
                                        @if (EntityById(step.ActorEntityId) is { } a)
                                        {
                                            <span class="tl-ent">@Ui.EntityGlyph(a.Type) @EntityShort(a)</span>
                                        }
                                        <span class="tl-arrow">&rarr;</span>
                                        @if (EntityById(step.TargetEntityId) is { } tgt)
                                        {
                                            <span class="tl-ent">@Ui.EntityGlyph(tgt.Type) @EntityShort(tgt)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">?</span>
                                        }
                                    </div>
                                }
                                <div class="killchain-desc">@step.Description</div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (tlAll.Count > 0)
        {
            <div class="tl-filters d-flex flex-wrap align-items-center gap-2 mb-3">
                @if (_tlLens == TimelineKind.Event)
                {
                    <select class="form-select form-select-sm w-auto" @bind="_tlFilterTacticStr" aria-label="Filter by tactic">
                        <option value="">All tactics</option>
                        @foreach (var t in Enum.GetValues<MitreTactic>().Where(x => x != MitreTactic.Unspecified))
                        {
                            <option value="@t">@Ui.Label(t)</option>
                        }
                    </select>
                }
                else if (_tlLens == TimelineKind.Investigation)
                {
                    <select class="form-select form-select-sm w-auto" @bind="_tlFilterTypeStr" aria-label="Filter by type">
                        <option value="">All types</option>
                        @foreach (var t in Ui.Options<TimelineEntryType>("TimelineEntryType"))
                        {
                            <option value="@t">@Ui.Label(t)</option>
                        }
                    </select>
                }
                <input class="form-control form-control-sm w-auto" style="max-width:14rem" @bind="_tlFilterSource"
                       @bind:event="oninput" placeholder="Filter by source…" aria-label="Filter by source" />
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        @onclick="() => _tlOldestFirst = !_tlOldestFirst"
                        title="Toggle chronological order">
                    <span class="bi @(_tlOldestFirst ? "bi-sort-down-alt" : "bi-sort-up-alt")" aria-hidden="true"></span>
                    @(_tlOldestFirst ? "Oldest first" : "Newest first")
                </button>
                @if (_tlFilterType is not null || _tlFilterTactic is not null || !string.IsNullOrWhiteSpace(_tlFilterSource))
                {
                    <button type="button" class="btn btn-sm btn-link text-decoration-none px-1"
                            @onclick="ClearTimelineFilters">Clear</button>
                    <span class="text-muted small">@tlView.Count of @tlAll.Count</span>
                }
            </div>
        }

        @if (tlAll.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon"><span class="bi bi-clock-history" aria-hidden="true"></span></div>
                <div class="empty-state-title">No entries in this timeline yet</div>
                <div class="empty-state-msg">
                    @(_tlLens switch
                    {
                        TimelineKind.Event => "Record the facts and timing of what happened.",
                        TimelineKind.Investigation => "Log the actions you and the team take as the investigation unfolds.",
                        _ => "Record what happened and log the team's actions as the investigation unfolds."
                    })
                </div>
            </div>
        }
        else if (tlView.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon"><span class="bi bi-funnel" aria-hidden="true"></span></div>
                <div class="empty-state-title">No entries match your filters</div>
                <div class="empty-state-actions">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearTimelineFilters">Clear filters</button>
                </div>
            </div>
        }
        else
        {
            <ol class="tl">
                @foreach (var e in tlView)
                {
                    if (e.Kind == TimelineKind.Event)
                    {
                        <li class="tl-item tl-kind-event im-enter @FlashClass(e.Id)" style="@FlashStyle(e.Id)" id="tl-@e.Id" @key="e.Id">
                            <span class="tl-dot" style="--tl-color:@Ui.TacticColor(PrimaryTactic(e))" aria-hidden="true">
                                <span class="bi @Ui.TacticGlyph(PrimaryTactic(e))"></span>
                            </span>
                            <div class="tl-body">
                                <div class="tl-head">
                                    <span class="tl-kind-label"><span class="bi bi-lightning-charge" aria-hidden="true"></span> Event</span>
                                    <span class="tl-tactics">
                                        @foreach (var tt in e.Tactics.Select(x => x.Tactic).OrderBy(x => (int)x))
                                        {
                                            <span class="tactic-chip" style="--tac:@Ui.TacticColor(tt)">
                                                <span class="bi @Ui.TacticGlyph(tt)" aria-hidden="true"></span> @Ui.Label(tt)
                                            </span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(e.TechniqueId))
                                        {
                                            <a class="tactic-chip" style="--tac:#6c757d" target="_blank" rel="noopener noreferrer"
                                               href="https://attack.mitre.org/techniques/@TechniquePath(e.TechniqueId)/">
                                                <span class="bi bi-diagram-2" aria-hidden="true"></span> @e.TechniqueId
                                            </a>
                                        }
                                    </span>
                                    <time class="tl-time" title="@TimeDisp.Long(e.OccurredAtUtc)"><span class="tl-time-abs">@TimeDisp.Short(e.OccurredAtUtc)</span><span class="tl-time-rel">@Ui.RelativeTime(e.OccurredAtUtc, Clock.UtcNow)</span></time>
                                </div>
                                <div class="tl-desc">@e.Description</div>
                                @if (e.EvidenceId is { } shotId)
                                {
                                    @* U-40: attached screenshot — click the thumbnail to preview it in a lightbox. *@
                                    <button type="button" class="tl-shot d-inline-block mt-1 btn p-0 border-0 bg-transparent" @onclick="() => OpenShot(shotId)" title="Preview the attached screenshot">
                                        <img src="evidence/@shotId/inline" alt="attached screenshot" loading="lazy"
                                             style="max-height:120px;max-width:100%;border-radius:.375rem;border:1px solid var(--bs-border-color);cursor:zoom-in" />
                                    </button>
                                }
                                <div class="tl-meta">
                                    @if (EntityById(e.ActorEntityId) is { } actor || EntityById(e.TargetEntityId) is not null)
                                    {
                                        <span class="tl-attrib">
                                            @if (EntityById(e.ActorEntityId) is { } a)
                                            {
                                                <span class="tl-ent">@Ui.EntityGlyph(a.Type) @EntityShort(a)</span>
                                            }
                                            <span class="tl-arrow">&rarr;</span>
                                            @if (EntityById(e.TargetEntityId) is { } tgt)
                                            {
                                                <span class="tl-ent">@Ui.EntityGlyph(tgt.Type) @EntityShort(tgt)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">(unspecified)</span>
                                            }
                                        </span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(e.Source))
                                    {
                                        <span class="tl-source"><span class="bi bi-tag" aria-hidden="true"></span> @e.Source</span>
                                    }
                                    <span>logged by @Users.DisplayFor(e.CreatedBy)</span>
                                    @if (e.ModifiedAtUtc is { } mod)
                                    {
                                        <span class="text-muted" title="@TimeDisp.Long(mod)">· edited by @Users.DisplayFor(e.ModifiedBy)</span>
                                    }
                                    @if (_canEdit)
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => StartEventEdit(e)">
                                            <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                                        </button>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="tl-item tl-kind-inv im-enter @FlashClass(e.Id)" style="@FlashStyle(e.Id)" id="tl-@e.Id" @key="e.Id">
                            <span class="tl-dot" style="--tl-color:@Ui.TimelineColor(e.Type)" aria-hidden="true">
                                <span class="bi @Ui.TimelineGlyph(e.Type)"></span>
                            </span>
                            <div class="tl-body">
                                <div class="tl-head">
                                    <span class="tl-kind-label"><span class="bi bi-search" aria-hidden="true"></span> Investigation</span>
                                    <span class="tactic-chip" style="--tac:@Ui.TimelineColor(e.Type)">
                                        <span class="bi @Ui.TimelineGlyph(e.Type)" aria-hidden="true"></span> @e.Type
                                    </span>
                                    @if (e.Version > 1)
                                    {
                                        <span class="im-badge im-b-neutral">v@(e.Version)</span>
                                    }
                                    <time class="tl-time" title="@TimeDisp.Long(e.OccurredAtUtc)"><span class="tl-time-abs">@TimeDisp.Short(e.OccurredAtUtc)</span><span class="tl-time-rel">@Ui.RelativeTime(e.OccurredAtUtc, Clock.UtcNow)</span></time>
                                </div>
                                <div class="tl-desc md-body">@((MarkupString)Md.ToHtml(e.Description))</div>
                                @if (e.EvidenceId is { } shotId)
                                {
                                    @* U-40: attached screenshot — click the thumbnail to preview it in a lightbox. *@
                                    <button type="button" class="tl-shot d-inline-block mt-1 btn p-0 border-0 bg-transparent" @onclick="() => OpenShot(shotId)" title="Preview the attached screenshot">
                                        <img src="evidence/@shotId/inline" alt="attached screenshot" loading="lazy"
                                             style="max-height:120px;max-width:100%;border-radius:.375rem;border:1px solid var(--bs-border-color);cursor:zoom-in" />
                                    </button>
                                }
                                <div class="tl-meta">
                                    @if (!string.IsNullOrWhiteSpace(e.Source))
                                    {
                                        <span class="tl-source"><span class="bi bi-tag" aria-hidden="true"></span> @e.Source</span>
                                    }
                                    <span>logged by @Users.DisplayFor(e.CreatedBy)</span>
                                    @{ var history = InvestigationHistory(e); }
                                    @if (history.Count > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => ToggleHistory(e.Id)">
                                            <span class="bi bi-clock-history" aria-hidden="true"></span>
                                            @(_tlHistoryOpen.Contains(e.Id) ? "Hide" : "Show") @history.Count earlier version@(history.Count == 1 ? "" : "s")
                                        </button>
                                    }
                                    @if (_canEdit)
                                    {
                                        <button type="button" class="btn btn-sm btn-link p-0 tl-edit" @onclick="() => StartInvestigationEdit(e)">
                                            <span class="bi bi-pencil" aria-hidden="true"></span> Edit
                                        </button>
                                    }
                                </div>
                                @if (_tlHistoryOpen.Contains(e.Id))
                                {
                                    <div class="tl-history mt-2">
                                        @foreach (var prior in InvestigationHistory(e))
                                        {
                                            <div class="tl-history-item">
                                                <div class="small text-muted">
                                                    <span class="im-badge im-b-neutral">v@(prior.Version)</span>
                                                    @Users.DisplayFor(prior.CreatedBy) · @TimeDisp.Long(prior.CreatedAtUtc)
                                                </div>
                                                <div class="md-body">@((MarkupString)Md.ToHtml(prior.Description))</div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </li>
                    }
                }
            </ol>
        }
        @* U-32: a floating "jump to what just arrived" pill when a collaborator adds timeline entries. *@
        @if (_newTimelineIds.Count > 0)
        {
            <button type="button" class="tl-newpill" @onclick="JumpToNewTimeline">
                <span class="bi bi-arrow-down-circle" aria-hidden="true"></span>
                @_newTimelineIds.Count new @(_newTimelineIds.Count == 1 ? "entry" : "entries")
            </button>
        }
        </div>
    }
    else if (_activeTab == "Entities")
    {
        <p class="text-muted small">
            Artifacts and indicators of compromise (IOCs) tied to this case &mdash; accounts, hosts, IPs,
            domains, URLs, file hashes &mdash; and the relationships between them.
        </p>

        <AuthorizeView Policy="@Policies.EditCases">
            <div class="card mb-3 @(_enEditId is not null ? "border-primary" : "")">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@(_enEditId is null ? "Add entity / IOC" : "Edit entity / IOC")</span>
                    @if (_enEditId is not null)
                    {
                        <span class="small text-muted"><span class="bi bi-pencil-square" aria-hidden="true"></span> correcting an existing indicator · change recorded in the audit trail</span>
                    }
                </div>
                <div class="card-body row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Type</label>
                        <select class="form-select form-select-sm" @bind="_enType">
                            @foreach (var t in Ui.Options<EntityType>("EntityType"))
                            {
                                <option value="@t">@Ui.Label(t)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small mb-0">Value</label>
                        <input class="form-control form-control-sm" @bind="_enValue" @bind:event="oninput" placeholder="e.g. 203.0.113.66" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Label</label>
                        <input class="form-control form-control-sm" @bind="_enLabel" placeholder="optional" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Disposition</label>
                        <select class="form-select form-select-sm" @bind="_enDisposition">
                            @foreach (var d in Ui.Options<EntityDisposition>("EntityDisposition"))
                            {
                                <option value="@d">@Ui.Label(d)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Source</label>
                        <input class="form-control form-control-sm" @bind="_enSource" placeholder="@($"{DetectionLabel}…")" />
                    </div>
                    @if (_enEditId is null)
                    {
                        <div class="col-md-1">
                            <button class="btn btn-sm btn-primary w-100" @onclick="AddEntity" disabled="@string.IsNullOrWhiteSpace(_enValue)">Add</button>
                        </div>
                    }
                    <div class="col-12">
                        <input class="form-control form-control-sm" @bind="_enDescription" placeholder="Description / context (optional)" />
                    </div>
                    @if (_enEditId is not null)
                    {
                        <div class="col-md-6">
                            <label class="form-label small mb-0">Reason for change <span class="text-muted">(optional)</span></label>
                            <input class="form-control form-control-sm" @bind="_enReason" placeholder="e.g. re-assessed as benign after review" />
                        </div>
                        <div class="col-md-6 d-flex justify-content-end align-items-end gap-2">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEntityEdit">Cancel</button>
                            <button class="btn btn-sm btn-primary" @onclick="SaveEntityEdit" disabled="@string.IsNullOrWhiteSpace(_enValue)">
                                <span class="bi bi-check-lg" aria-hidden="true"></span> Save changes
                            </button>
                        </div>
                    }
                    @if (_entityError is not null) { <div class="col-12"><div class="text-danger small">@_entityError</div></div> }
                </div>
            </div>
        </AuthorizeView>

        @if (_case.Entities.Count == 0)
        {
            <p class="text-muted">No entities added yet.</p>
        }
        else
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Relationship graph</span>
                    <div class="btn-group btn-group-sm">
                        <button class="btn @(_showAttackEdges ? "btn-primary" : "btn-outline-secondary")" @onclick="ToggleAttackEdges"
                                title="Overlay event steps (actor → target) as dashed, tactic-coloured attack edges">Attack steps</button>
                        <button class="btn btn-outline-secondary" @onclick="GraphFit" title="Fit graph to view">Fit</button>
                        <button class="btn btn-outline-secondary" @onclick="GraphTogglePhysics">
                            @(_physicsOn ? "Freeze" : "Physics")
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="GraphRelayout" title="Re-run the force layout">Re-layout</button>
                        <a class="btn btn-outline-secondary" href="cases/@Id/graph.stix.json"
                           title="Export this investigation graph as a STIX 2.1 bundle (share with a partner / ingest into a TIP or XSIAM)">
                            <span class="bi bi-box-arrow-up" aria-hidden="true"></span> STIX
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div id="@GraphContainerId" style="height:460px;border:1px solid var(--bs-border-color);border-radius:.375rem;background:var(--bs-body-bg);"></div>
                    <div class="d-flex flex-wrap gap-3 mt-2 small text-muted align-items-center">
                        <span>Disposition:</span>
                        <span><span class="d-inline-block rounded-circle" style="width:10px;height:10px;background:#dc3545;"></span> @Ui.Label(EntityDisposition.Malicious)</span>
                        <span><span class="d-inline-block rounded-circle" style="width:10px;height:10px;background:#fd7e14;"></span> @Ui.Label(EntityDisposition.Suspicious)</span>
                        <span><span class="d-inline-block rounded-circle" style="width:10px;height:10px;background:#198754;"></span> @Ui.Label(EntityDisposition.Benign)</span>
                        <span><span class="d-inline-block rounded-circle" style="width:10px;height:10px;background:#6c757d;"></span> @Ui.Label(EntityDisposition.Unknown)</span>
                        <span class="ms-auto fst-italic">Drag nodes to arrange · scroll to zoom · drag background to pan</span>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Entities (@_case.Entities.Count)</span>
                    <span class="seg" role="radiogroup" aria-label="Indicator display"
                          title="Defanged renders network/URL indicators as hxxp://evil[.]com so they're safe to copy out of the tool.">
                        <button type="button" class="seg-opt @(!_defangView ? "on" : "")"
                                role="radio" aria-checked="@(!_defangView)"
                                @onclick="() => _defangView = false">Live</button>
                        <button type="button" class="seg-opt @(_defangView ? "on" : "")"
                                role="radio" aria-checked="@_defangView"
                                @onclick="() => _defangView = true">Defanged</button>
                    </span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Type</th><th>Value</th><th>Label</th><th>Disposition</th><th>Source</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var e in _case.Entities.OrderBy(x => x.Type).ThenBy(x => x.Value))
                            {
                                <tr class="im-enter @FlashClass(e.Id)" style="@FlashStyle(e.Id)" @key="e.Id">
                                    <td class="text-nowrap">@Ui.EntityGlyph(e.Type) @Ui.Label(e.Type)</td>
                                    <td><code class="small">@DisplayValue(e)</code>
                                        @if (!string.IsNullOrWhiteSpace(e.Description)) { <br /><small class="text-muted">@e.Description</small> }
                                        @if (_overlaps.TryGetValue(e.Id, out var alsoIn) && alsoIn.Count > 0)
                                        {
                                            <br />
                                            <small><span class="im-badge im-b-info">also in</span>
                                                @foreach (var o in alsoIn)
                                                {
                                                    <a class="ms-1" href="cases/@o.OtherCaseId"><code class="small">@o.OtherCaseNumber</code></a>
                                                }
                                            </small>
                                        }
                                    </td>
                                    <td class="small">@(e.Label ?? "—")</td>
                                    <td><span class="@Ui.DispositionBadge(e.Disposition)">@Ui.Label(e.Disposition)</span></td>
                                    <td class="small text-muted">@(e.Source ?? "—")</td>
                                    <td class="text-nowrap">
                                        @{ var vtUrl = VirusTotalUrl(e); }
                                        @if (vtUrl is not null)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary py-0 me-1" href="@vtUrl" target="_blank" rel="noopener noreferrer">VirusTotal</a>
                                        }
                                        <AuthorizeView Policy="@Policies.EditCases" Context="rm">
                                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => StartEntityEdit(e)">Edit</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick='() => AskConfirm($"Remove entity {e.Value}? Its relationships are removed too.", () => RemoveEntity(e.Id))'>Remove</button>
                                        </AuthorizeView>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <AuthorizeView Policy="@Policies.EditCases">
                @if (_case.Entities.Count >= 2)
                {
                    <div class="card mb-3">
                        <div class="card-header">Add relationship</div>
                        <div class="card-body row g-2 align-items-end">
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Source</label>
                                <select class="form-select form-select-sm" @bind="_relSource">
                                    <option value="">— select —</option>
                                    @foreach (var e in _case.Entities.OrderBy(x => x.Type))
                                    {
                                        <option value="@e.Id">@Ui.Label(e.Type): @(e.Label ?? e.Value)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small mb-0">Relationship</label>
                                <select class="form-select form-select-sm" @bind="_relType">
                                    @foreach (var t in Ui.Options<EntityRelationshipType>("EntityRelationshipType"))
                                    {
                                        <option value="@t">@Ui.Label(t)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small mb-0">Target</label>
                                <select class="form-select form-select-sm" @bind="_relTarget">
                                    <option value="">— select —</option>
                                    @foreach (var e in _case.Entities.OrderBy(x => x.Type))
                                    {
                                        <option value="@e.Id">@Ui.Label(e.Type): @(e.Label ?? e.Value)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-1">
                                <button class="btn btn-sm btn-primary w-100" @onclick="AddRelationship"
                                        disabled="@(string.IsNullOrEmpty(_relSource) || string.IsNullOrEmpty(_relTarget))">Link</button>
                            </div>
                            @if (_relError is not null) { <div class="col-12"><div class="text-danger small">@_relError</div></div> }
                        </div>
                    </div>
                }
            </AuthorizeView>

            @if (_case.EntityRelationships.Count > 0)
            {
                <div class="card">
                    <div class="card-header">Relationships (@_case.EntityRelationships.Count)</div>
                    <div class="card-body p-0">
                        <table class="table table-sm align-middle mb-0">
                            <tbody>
                                @foreach (var r in _case.EntityRelationships.OrderBy(x => x.CreatedAtUtc))
                                {
                                    <tr>
                                        <td>
                                            <span class="fw-semibold">@EntityName(r.SourceEntityId)</span>
                                            <span class="text-muted">@Ui.Label(r.Type)</span>
                                            <span class="fw-semibold">@EntityName(r.TargetEntityId)</span>
                                            @if (!string.IsNullOrWhiteSpace(r.Description)) { <br /><small class="text-muted">@r.Description</small> }
                                        </td>
                                        <td class="text-end">
                                            <AuthorizeView Policy="@Policies.EditCases" Context="rm">
                                                <button class="btn btn-sm btn-outline-danger" @onclick='() => AskConfirm("Remove this relationship?", () => RemoveRelationship(r.Id))'>Remove</button>
                                            </AuthorizeView>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    }
    else if (_activeTab == "Evidence")
    {
      <div id="evidence-dropzone">
        <AuthorizeView Policy="@Policies.EditCases">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small mb-0">File</label>
                            <InputFile id="evidence-file-input" class="form-control form-control-sm" OnChange="OnFileSelected" />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label small mb-0">Description</label>
                            <input class="form-control form-control-sm" @bind="_evDesc" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-sm btn-primary w-100" @onclick="Upload" disabled="@(_file is null)">Upload</button>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        <span class="bi bi-clipboard me-1"></span>Paste a screenshot, or drag files onto this tab. They're hashed and logged to the chain of custody like any upload.
                        @if (_file is not null) { <span class="ms-1">Ready: <strong>@_file.Name</strong>. Add a description and click Upload.</span> }
                    </div>
                    @if (_uploadError is not null) { <div class="text-danger small mt-2">@_uploadError</div> }

                    @* Hidden sinks the paste-drop shim (wwwroot/js/paste-drop.js) feeds: paste stages one
                       screenshot in the picker; a drop bulk-uploads immediately. Both reuse InputFile streaming. *@
                    <InputFile id="evidence-file-drop" class="d-none" multiple OnChange="OnDropped" />
                </div>
            </div>
        </AuthorizeView>

        @if (_case.Evidence.Count == 0)
        {
            <p class="text-muted">No evidence attached.</p>
        }
        else
        {
            <table class="table table-sm align-middle">
                <thead><tr><th>File</th><th>Size</th><th>SHA-256</th><th>Uploaded</th><th></th></tr></thead>
                <tbody>
                    @foreach (var ev in _case.Evidence.OrderByDescending(x => x.CreatedAtUtc))
                    {
                        <tr class="im-enter @FlashClass(ev.Id)" style="@FlashStyle(ev.Id)" @key="ev.Id">
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (IsImageEvidence(ev))
                                    {
                                        @* Click the thumbnail to preview the image in a lightbox (U-40 preview, reused). *@
                                        <button type="button" class="btn p-0 border-0 bg-transparent" @onclick="() => OpenShot(ev.Id)" title="Preview">
                                            <img src="evidence/@ev.Id/inline" alt="" loading="lazy"
                                                 style="max-height:36px;max-width:56px;border-radius:.25rem;border:1px solid var(--bs-border-color);cursor:zoom-in" />
                                        </button>
                                    }
                                    <div>@ev.OriginalFileName<br /><small class="text-muted">@ev.Description</small></div>
                                </div>
                            </td>
                            <td>@FormatSize(ev.SizeBytes)</td>
                            <td><code class="small">@ev.Sha256[..16]…</code></td>
                            <td class="small text-muted">@TimeDisp.Long(ev.CreatedAtUtc)<br />@Users.DisplayFor(ev.CreatedBy)</td>
                            <td class="text-nowrap">
                                @if (IsImageEvidence(ev))
                                {
                                    <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OpenShot(ev.Id)">Preview</button>
                                }
                                <a class="btn btn-sm btn-outline-primary" href="evidence/@ev.Id" target="_blank">Download</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
      </div>
    }
    else if (_activeTab == "Notes")
    {
        <AuthorizeView Policy="@Policies.EditCases">
            <div class="card mb-3">
                <div class="card-body">
                    <label class="form-label small mb-1">Note <span class="text-muted">· Markdown: headings, <strong>**bold**</strong>, lists, links</span></label>
                    @* EasyMDE enhances this textarea (managed in OnAfterRenderAsync); value pulled on Add. *@
                    <textarea id="@NoteAddEditorId" class="form-control mb-2"></textarea>
                    <button class="btn btn-sm btn-primary" @onclick="AddNote">Add note</button>
                </div>
            </div>
        </AuthorizeView>

        @if (_case.Notes.Count == 0)
        {
            <p class="text-muted">No notes yet.</p>
        }
        else
        {
            @foreach (var n in _case.Notes.Where(x => x.IsCurrent).OrderByDescending(x => x.CreatedAtUtc))
            {
                <div class="card mb-2 im-enter @FlashClass(n.Id)" style="@FlashStyle(n.Id)" @key="n.Id">
                    <div class="card-body py-2">
                        @if (_editNoteId == n.Id)
                        {
                            @* EasyMDE enhances this textarea; keyed by note id so switching notes remounts a fresh editor. *@
                            <textarea id="@NoteEditEditorId(n.Id)" class="form-control mb-2"></textarea>
                            <button class="btn btn-sm btn-primary" @onclick="SaveNoteEdit">Save new version</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelNoteEdit">Cancel</button>
                        }
                        else
                        {
                            <div class="md-body">@((MarkupString)Md.ToHtml(n.Body))</div>
                            <small class="text-muted">
                                @Users.DisplayFor(n.CreatedBy) · @TimeDisp.Long(n.CreatedAtUtc)
                                @if (n.Version > 1)
                                {
                                    <span class="im-badge im-b-neutral ms-1">v@(n.Version)</span>
                                }
                            </small>
                            <AuthorizeView Policy="@Policies.EditCases">
                                <button class="btn btn-sm btn-link p-0 ms-2" @onclick="() => StartNoteEdit(n)">Edit</button>
                            </AuthorizeView>
                        }
                    </div>
                </div>
            }
        }
    }
    else if (_activeTab == "Tasks")
    {
        <AuthorizeView Policy="@Policies.EditCases">
            @if (_applyTemplates is { Count: > 0 })
            {
                <div class="d-flex justify-content-end mb-2">
                    @if (!_applyingTemplate)
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="BeginApplyTemplate">
                            <span class="bi bi-clipboard-check me-1"></span>Apply playbook
                        </button>
                    }
                </div>
                @if (_applyingTemplate)
                {
                    <div class="card mb-3 border-primary">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><span class="bi bi-clipboard-check me-1"></span>Apply a playbook</span>
                            <button class="btn-close" aria-label="Cancel" @onclick="CancelApplyTemplate"></button>
                        </div>
                        <div class="card-body">
                            <label class="form-label small mb-0">Playbook</label>
                            <select class="form-select form-select-sm mb-3" style="max-width:28rem" @onchange="OnApplyTemplateChanged"
                                    value="@(_applyTemplate?.Id.ToString() ?? "")">
                                <option value="">— choose a template —</option>
                                @foreach (var t in _applyTemplates)
                                {
                                    <option value="@t.Id">@t.Name@(t.Steps.Count > 0 ? $" ({t.Steps.Count} steps)" : "")</option>
                                }
                            </select>

                            @if (_applyTemplate is not null)
                            {
                                @if (_applyTemplate.Steps.Count == 0)
                                {
                                    <p class="text-muted small">This template has no steps to add.</p>
                                }
                                else
                                {
                                    <p class="small text-muted mb-2">Uncheck any step you don't need. Owners default to the case owner; due dates are computed from now.</p>
                                    <div class="border rounded p-2 mb-2">
                                        @foreach (var s in _applyTemplate.Steps)
                                        {
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="apply-step-@s.Id"
                                                       checked="@_applySelected.Contains(s.Id)"
                                                       @onchange="e => ToggleApplyStep(s.Id, (bool)(e.Value ?? false))" />
                                                <label class="form-check-label" for="apply-step-@s.Id">
                                                    @s.Title
                                                    @if (s.DueOffsetHours is { } h) { <span class="im-badge im-b-warn ms-1">+@FormatOffset(h)</span> }
                                                    @if (!string.IsNullOrWhiteSpace(s.OwnerHint)) { <span class="im-badge im-b-neutral ms-1">@s.OwnerHint</span> }
                                                </label>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                        <div class="card-footer d-flex gap-2">
                            <button class="btn btn-sm btn-primary" @onclick="ApplyTemplate"
                                    disabled="@(_applyTemplate is null || _applySelected.Count == 0)">
                                Add @_applySelected.Count action item(s)
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelApplyTemplate">Cancel</button>
                        </div>
                    </div>
                }
            }
            <div class="card mb-3">
                <div class="card-body row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small mb-0">Follow-up</label>
                        <input class="form-control form-control-sm" @bind="_taskTitle" @bind:event="oninput" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-0">Owner</label>
                        <select class="form-select form-select-sm" @bind="_taskOwner">
