    private void MoveSection(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _layout.Count) return;
        (_layout[index], _layout[target]) = (_layout[target], _layout[index]);
    }

    private void ToggleSection(int index, bool enabled) =>
        _layout[index] = _layout[index] with { Enabled = enabled };

    private async Task SaveLayout()
    {
        await Settings.SetAsync("Reporting:SectionLayout", ReportLayout.Serialize(_layout));
        await LoadAsync();
        Toasts.Success("Saved report section layout.");
    }

    // --- Brand colours (X-08 white-label palette) ---
    private string? _accentColor;
    private string? _inkColor;
    private string? _brandError;
    private const string DefaultAccent = "#ffcf31";
    private const string DefaultInk = "#232a33";

    // Colour inputs need a concrete hex; fall back to the built-in default when unset/invalid.
    private string AccentOrDefault => BrandPalette.IsValidHex(_accentColor) ? _accentColor!.Trim() : DefaultAccent;
    private string InkOrDefault => BrandPalette.IsValidHex(_inkColor) ? _inkColor!.Trim() : DefaultInk;

    private bool IsOverridden(string key) =>
        _effective?.FirstOrDefault(e => e.Definition.Key == key)?.IsOverridden ?? false;

    private static string? NullIfBlank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    // Live preview: push the pending palette into the current page without saving. Invalid/partial input
    // derives to null → the built-in defaults show. Saved separately so a preview never persists on its own.
    private Task OnAccentInput(string? value) { _accentColor = value; return PreviewBrand(); }
    private Task OnInkInput(string? value) { _inkColor = value; return PreviewBrand(); }

    private async Task PreviewBrand()
    {
        _brandError = null;
        var css = BrandPalette.BuildCss(NullIfBlank(_accentColor), NullIfBlank(_inkColor)) ?? "";
        await JS.InvokeVoidAsync("imBrand.apply", css);
    }

    private async Task SaveBrand()
    {
        _brandError = null;
        var accent = NullIfBlank(_accentColor);
        var ink = NullIfBlank(_inkColor);
        if (accent is not null && !BrandPalette.IsValidHex(accent)) { _brandError = "Accent colour must be a hex value like #2563eb."; return; }
        if (ink is not null && !BrandPalette.IsValidHex(ink)) { _brandError = "Primary colour must be a hex value like #232a33."; return; }

        if (accent is null) await Settings.ResetAsync("Branding:AccentColor"); else await Settings.SetAsync("Branding:AccentColor", accent);
        if (ink is null) await Settings.ResetAsync("Branding:InkColor"); else await Settings.SetAsync("Branding:InkColor", ink);

        await LoadAsync();
        await JS.InvokeVoidAsync("imBrand.apply", BrandPalette.BuildCss(accent, ink) ?? "");
        Toasts.Success("Saved brand colours.");
    }

    private async Task ResetBrand()
    {
        await Settings.ResetAsync("Branding:AccentColor");
        await Settings.ResetAsync("Branding:InkColor");
        _accentColor = null;
        _inkColor = null;
        _brandError = null;
        await LoadAsync();
        await JS.InvokeVoidAsync("imBrand.apply", "");
        Toasts.Info("Brand colours reset to defaults.");
    }

    // --- Report logo (IReportBrandingStore) ---
    private string? _logoDataUri;
    private string? _logoError;

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        _logoError = null;
        var file = e.File;
        if (file is null) return;

        var ct = file.ContentType ?? "";
        if (!ct.Contains("png", StringComparison.OrdinalIgnoreCase) && !ct.Contains("jpeg", StringComparison.OrdinalIgnoreCase))
        {
            _logoError = "Please choose a PNG or JPEG image.";
            return;
        }

        try
        {
            const long maxBytes = 2 * 1024 * 1024;
            await using var stream = file.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            await Branding.SaveLogoAsync(ms.ToArray(), ct);
            await LoadAsync();
            Toasts.Success("Report logo updated.");
        }
        catch (IOException)
        {
            _logoError = "That image is larger than the 2 MB limit.";
        }
        catch (Exception ex) when (ex is ArgumentException)
        {
            _logoError = ex.Message;
        }
    }

    private async Task RemoveLogo()
    {
        await Branding.ClearLogoAsync();
        await LoadAsync();
        Toasts.Info("Report logo removed.");
    }

    private bool IsTrue(string key) =>
        bool.TryParse(_form.GetValueOrDefault(key), out var b) && b;

    private void SetBool(string key, bool on) => _form[key] = on ? "true" : "false";

    private async Task SaveGroup(string group)
    {
        if (_effective is null) return;

        var changed = 0;
        try
        {
            foreach (var s in _effective.Where(e => e.Definition.Group == group))
            {
                var key = s.Definition.Key;
                var current = s.Value ?? "";
                var next = _form.GetValueOrDefault(key) ?? "";
                if (!string.Equals(current, next, StringComparison.Ordinal))
                {
                    await Settings.SetAsync(key, _form.GetValueOrDefault(key));
                    changed++;
                }
            }
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Toasts.Error(ex.Message);
            return;
        }

        await LoadAsync();
        Toasts.Success(changed == 0 ? $"No changes in {group}." : $"Saved {changed} {group} setting(s).");
    }

    private async Task ResetOne(string key)
    {
        await Settings.ResetAsync(key);
        await LoadAsync();
        Toasts.Info("Reverted to default.");
    }

    private bool SigningKeyPresent()
    {
        var path = Config["Integrity:SigningKeyPath"];
        if (string.IsNullOrWhiteSpace(path)) return false;
        var full = Path.IsPathRooted(path) ? path : Path.Combine(Env.ContentRootPath, path);
        return File.Exists(full);
    }

