    private async Task<List<HealthCheck>> RunHealthChecksAsync()
    {
        var checks = new List<HealthCheck>();

        bool dbOk;
        await using var db = await DbFactory.CreateDbContextAsync();
        try { dbOk = await db.Database.CanConnectAsync(); } catch { dbOk = false; }
        checks.Add(new HealthCheck("Database connectivity", dbOk, dbOk ? db.Database.ProviderName ?? "" : "cannot connect"));

        // PROD-56: the store's own probe, in time (a share that's down answers rather than hangs the page) and never
        // recreating a store that held evidence and has vanished (this check used to, just by being looked at).
        var storeProblem = await EvidenceStoreFiles.ProbeAsync();
        checks.Add(new HealthCheck("Evidence store writable", storeProblem is null, storeProblem ?? EvidenceStoreFiles.Location));
        checks.Add(WritableCheck("Report output writable", Config["ReportOutput:RootPath"]));
        checks.Add(new HealthCheck("Seal signing key present", SigningKeyPresent(),
            SigningKeyPresent() ? Signer.KeyId : "missing, so seals can't be signed"));
        // A value saved before today's limits (or set in appsettings) blocks saving its section until corrected.
        var invalid = SettingsCatalog.FindInvalid(key => Config[key]);
        checks.Add(new HealthCheck("Settings within limits", invalid.Count == 0, invalid.Count == 0
            ? "every setting passes its rules"
            : string.Join(" ", invalid.Select(i => $"{i.Problem} It's currently {i.Value}."))));
        // CAP-05: a relay sign-in that can't be used stops every email; a plain-text password is said too.
        var mail = EmailOptions.CurrentValue;
        if (IncidentManager.Infrastructure.Notifications.SmtpSignIn.InServerConfig(mail))
        {
            var problem = IncidentManager.Infrastructure.Notifications.SmtpSignIn.Problem(mail);
            var warnings = IncidentManager.Infrastructure.Notifications.SmtpSignIn.Warnings(mail);
            checks.Add(new HealthCheck("Email relay sign-in", problem is null && warnings.Count == 0,
                problem ?? (warnings.Count > 0 ? string.Join(" ", warnings) : IncidentManager.Infrastructure.Notifications.SmtpSignIn.Describe(mail))));
        }
        else if (_smtpSignIn is { } saved)
        {
            checks.Add(new HealthCheck("Email relay sign-in", !saved.PasswordUnreadable, saved.PasswordUnreadable
                ? "The SMTP password saved in Administration can't be decrypted on this server: re-enter the SMTP password (Settings, Notifications, Email sign-in)."
                : saved.Mode == IncidentManager.Infrastructure.Notifications.SmtpSignInMode.None ? "none (the relay takes mail without a sign-in)" : "set in Administration"));
        }
        // CAP-40: a secret saved in Administration that can't be decrypted here stops its sends: re-enter it.
        foreach (var d in IncidentManager.Web.Secrets.StoredSecretDefinition.All)
        {
            if (StoredSecretAdmin.SetInServerConfiguration(d.Kind)) continue;
            var saved = await StoredSecrets.StatusAsync(d.Kind);
            if (!saved.Set) continue;
            checks.Add(new HealthCheck(char.ToUpperInvariant(d.Label[0]) + d.Label[1..], !saved.Unreadable, saved.Unreadable
                ? $"The {d.Label} saved in Administration can't be decrypted on this server: re-enter the {d.Label} ({d.Where})."
                : "saved in Administration"));
        }
        checks.Add(new HealthCheck("Schema up to date", _pendingMigrations is { Count: 0 },
            _pendingMigrations is { Count: > 0 } ? $"{_pendingMigrations.Count} pending" : "no pending migrations"));

        return checks;
    }

    private HealthCheck WritableCheck(string label, string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return new HealthCheck(label, false, "path not configured");
        var full = Path.IsPathRooted(path) ? path : Path.Combine(Env.ContentRootPath, path);
        try
        {
            Directory.CreateDirectory(full);
            var probe = Path.Combine(full, $".health-{Guid.NewGuid():N}.tmp");
            File.WriteAllText(probe, "ok");
            File.Delete(probe);
            return new HealthCheck(label, true, full);
        }
        catch (Exception ex)
        {
            return new HealthCheck(label, false, ex.GetType().Name);
        }
    }

    // BUG-601: a logo change's reload and a section save's can overlap; only the newest lands (an older one put back the
    // values from before the newer save). False when a newer load took over.
    private readonly LoadSequence _load = new();

    private async Task<bool> LoadAsync()
    {
        var t = _load.Begin();
        var effective = await Settings.GetEffectiveAsync();
        var ledger = await Ledger.GetAsync();
        var logo = await Branding.GetLogoAsync();
        if (!_load.IsCurrent(t)) return false;
        _effective = effective;
        _ledger = ledger;
        _logoDataUri = logo is null ? null : $"data:{logo.ContentType};base64,{Convert.ToBase64String(logo.Bytes)}";
        _form.Clear();
        foreach (var s in _effective)
            _form[s.Definition.Key] = s.Value;

        _accentColor = _effective.FirstOrDefault(e => e.Definition.Key == "Branding:AccentColor")?.Value;
        _inkColor = _effective.FirstOrDefault(e => e.Definition.Key == "Branding:InkColor")?.Value;

        var layoutSetting = _effective.FirstOrDefault(e => e.Definition.Key == "Reporting:SectionLayout");
        _layout = ReportLayout.Parse(layoutSetting?.Value).ToList();
        _layoutLoadedFrom = layoutSetting is { IsOverridden: true } ? layoutSetting.Value : null;
        return true;
    }

