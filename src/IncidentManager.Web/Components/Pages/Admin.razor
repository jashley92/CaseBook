    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", ok ? "im-badge im-b-ok"
                                             : "im-badge im-b-danger");
        builder.AddContent(2, ok ? yes : no);
        builder.CloseElement();
    };

    private static RenderFragment BackupBadge(BackupHealthState state) => builder =>
    {
        var (css, text) = state switch
        {
            BackupHealthState.Ok => ("im-badge im-b-ok", "Fresh"),
            BackupHealthState.Stale => ("im-badge im-b-warn", "Stale"),
            BackupHealthState.Missing => ("im-badge im-b-danger", "Missing"),
            _ => ("im-badge im-b-neutral", "Not configured"),
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, text);
        builder.CloseElement();
    };
