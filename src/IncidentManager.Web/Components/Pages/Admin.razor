    private async Task ResetBrand()
    {
        // BUG-437: one save or reset at a time (a double click, or Reset during a Save).
        if (_savingSection) return;
        _savingSection = true;
        try
        {
            string? notInEffect = null;   // BUG-526
            try
            {
                notInEffect = await SavedEvenIfNotInEffect(() => Settings.ResetAsync("Branding:AccentColor")) ?? notInEffect;
                notInEffect = await SavedEvenIfNotInEffect(() => Settings.ResetAsync("Branding:InkColor")) ?? notInEffect;
            }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
            {
                _brandError = ex.Message;
                return;
            }
            _accentColor = null;
            _inkColor = null;
            _brandError = null;
            await ReloadKeepingEdits(dropBrand: true);
            await JS.InvokeVoidAsync("imBrand.apply", "");
            if (notInEffect is not null) Toasts.Error(notInEffect);
            else Toasts.Info("Brand colors reset to defaults.");
        }
        finally { _savingSection = false; }
    }

