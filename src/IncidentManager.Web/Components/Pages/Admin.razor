    // BUG-601: a logo change's reload and a section save's can overlap; only the newest lands (an older one put back the
    // values from before the newer save). False when a newer load took over.
    private readonly LoadSequence _load = new();

    private async Task<bool> LoadAsync()
    {
        var t = _load.Begin();
        var effective = await Settings.GetEffectiveAsync();
        var ledger = await Ledger.GetAsync();
        var logo = await Branding.GetLogoAsync();
        if (!_load.IsCurrent(t)) return false;
        _effective = effective;
        _ledger = ledger;
        _logoDataUri = logo is null ? null : $"data:{logo.ContentType};base64,{Convert.ToBase64String(logo.Bytes)}";
        _form.Clear();
        foreach (var s in _effective)
            _form[s.Definition.Key] = s.Discovered is null ? s.Value : null;   // CAP-28 discovery: untouched (see Differs)

        _accentColor = _effective.FirstOrDefault(e => e.Definition.Key == "Branding:AccentColor")?.Value;
        _inkColor = _effective.FirstOrDefault(e => e.Definition.Key == "Branding:InkColor")?.Value;

        var layoutSetting = _effective.FirstOrDefault(e => e.Definition.Key == "Reporting:SectionLayout");
        _layout = ReportLayout.Parse(layoutSetting?.Value).ToList();
        _layoutLoadedFrom = layoutSetting is { IsOverridden: true } ? layoutSetting.Value : null;
        return true;
    }

