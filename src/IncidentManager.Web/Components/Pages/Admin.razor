    // CAP-40: where a secret comes from, for Server configuration: the server's configuration, Administration, or nowhere.
    // Status only, never the value; a saved one that won't decrypt here says so.
    private RenderFragment SecretSource(IncidentManager.Web.Secrets.StoredSecretKind kind, string what, string none) => builder =>
    {
        var saved = StoredSecretAdmin.SetInServerConfiguration(kind) ? null : StoredSecrets.Peek(kind);
        var (css, text) = saved switch
        {
            null => ("im-badge im-b-ok", $"{what} set in server configuration"),
            { Unreadable: true } => ("im-badge im-b-danger", $"{what} saved in Administration can't be decrypted: re-enter it"),
            { Unread: true } => ("im-badge im-b-warn", $"{what}: can't tell, the database isn't answering"),   // CAP-40 review
            { Set: true } => ("im-badge im-b-ok", $"{what} saved in Administration"),
            _ => ("im-badge im-b-warn", none),
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, text);
        builder.CloseElement();
    };

