    // BUG-603: one test send of each kind at a time (a double-click sent two test messages).
    private readonly InFlight _testingEmail = new();
    private readonly InFlight _testingChat = new();

    private Task SendTest() => _testingEmail.Run(SendTestCore);

    private async Task SendTestCore()
    {
        var to = _testRecipient?.Trim();
        if (string.IsNullOrWhiteSpace(to)) { Toasts.Warning("Enter a recipient address."); return; }

        // Admins need the relay's actual complaint to fix the configuration, so the reason is shown here.
        var outcome = await Email.SendTestAsync(new EmailMessage([to], "[CaseBook] Test notification",
            "<p>This is a test notification from CaseBook confirming the email configuration.</p>",
            "This is a test notification from CaseBook confirming the email configuration."));
        switch (outcome.Status)
        {
            case EmailSendStatus.Sent: Toasts.Success($"Test email sent to {to}."); break;
            case EmailSendStatus.Disabled: Toasts.Info($"Email delivery is off. Logged a test message for {to} instead."); break;
            default: Toasts.Error($"Couldn't send the test email. {outcome.Error} Check the relay host, port, sender address and sign-in."); break;
        }
    }

    // PROD-02: post a sample message through the configured chat webhook so an admin can verify it end to end.
    private Task SendTestChat() => _testingChat.Run(SendTestChatCore);

    private async Task SendTestChatCore()
    {
        if (!Chat.Enabled) { Toasts.Warning("No chat webhook is configured. Turn on Chat:Webhook:Enabled on the server and set the URL under Team chat webhook."); return; }

        var baseUrl = (Config["App:BaseUrl"] ?? "").TrimEnd('/');
        var error = await Chat.SendTestAsync(new IncidentManager.Application.Abstractions.ChatNotification(
            "CaseBook test message",
            "This is a test notification confirming the chat webhook configuration.",
            baseUrl.Length == 0 ? null : baseUrl));
        if (error is not null)
        {
            Toasts.Error($"Couldn't post the test message. {error} Check the webhook URL.");
            return;
        }

        Toasts.Success("Test chat message posted to the configured channel.");
    }

