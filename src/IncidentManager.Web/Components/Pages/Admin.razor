    private bool Differs(string key) =>
        !string.Equals(_form.GetValueOrDefault(key) ?? "", SavedValue(key) ?? "", StringComparison.Ordinal);
    private bool GroupDirty(string group) =>
        _effective?.Any(e => e.Definition.Group == group && Differs(e.Definition.Key)) ?? false;
    private bool BrandDirty =>
        _effective is not null
        && (NullIfBlank(_accentColor) != NullIfBlank(SavedValue("Branding:AccentColor"))
            || NullIfBlank(_inkColor) != NullIfBlank(SavedValue("Branding:InkColor")));
    private bool LayoutDirty =>
        _effective is not null
        && ReportLayout.Serialize(_layout) != ReportLayout.Serialize(ReportLayout.Parse(SavedValue("Reporting:SectionLayout")).ToList());
    private bool HasUnsavedChanges =>
        (_effective?.Any(e => Differs(e.Definition.Key)) ?? false) || BrandDirty || LayoutDirty;

    private bool _leaveConfirmed;
    private void OnBeforeLeave(LocationChangingContext ctx)
    {
        if (_leaveConfirmed) { _leaveConfirmed = false; return; }
        var path = Nav.ToBaseRelativePath(ctx.TargetLocation).Split('?', '#')[0].TrimEnd('/');
        if (path is "admin" || path.StartsWith("admin/settings", StringComparison.OrdinalIgnoreCase)) return; // same page
        if (path.Contains("session-expired", StringComparison.OrdinalIgnoreCase) || !HasUnsavedChanges) return;
        ctx.PreventNavigation();
        var target = ctx.TargetLocation;
        _confirm.Ask(this, "Leave without saving?",
            "You have settings changes that haven't been saved. If you leave now, they're lost.",
            "Leave without saving", async () =>
            {
                // Drop a live palette preview so the next page shows the saved colors.
                if (BrandDirty)
                    await JS.InvokeVoidAsync("imBrand.apply",
                        BrandPalette.BuildCss(NullIfBlank(SavedValue("Branding:AccentColor")), NullIfBlank(SavedValue("Branding:InkColor"))) ?? "");
                if (_disposed) return;   // BUG-601: left another way meanwhile; don't move the page now shown
                _leaveConfirmed = true;
                Nav.NavigateTo(target);
            });
    }

