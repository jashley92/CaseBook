    // A link to a setting (a search result, a Diagnostics fix, an error naming the setting behind it) ends in #its-key. The
    // settings load after the page does, so it's brought into view once it's on the page, and again when a link lands on
    // another setting of this page.
    private string? _reveal;
    private int _revealTries;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        TakeFragment(Nav.Uri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed || !TakeFragment(e.Location)) return;
        _ = InvokeAsync(StateHasChanged);
    }

    private bool TakeFragment(string uri)
    {
        var hash = uri.IndexOf('#');
        if (hash < 0 || hash == uri.Length - 1) return false;
        _reveal = Uri.UnescapeDataString(uri[(hash + 1)..]);
        _revealTries = 0;
        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_reveal is not { } id || _disposed) return;
        bool shown;
        try { shown = await JS.InvokeAsync<bool>("imAdmin.reveal", id); }
        catch (JSDisconnectedException) { return; }
        catch (InvalidOperationException) { return; }   // prerendering: no browser yet
        // Not on the page yet (still loading): try again on the next renders, then give up.
        if (shown || ++_revealTries >= 5) _reveal = null;
    }

