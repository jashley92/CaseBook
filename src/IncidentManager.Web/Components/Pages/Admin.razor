    private async Task ResetBrand()
    {
        // BUG-437: one save or reset at a time (a double click, or Reset during a Save).
        if (_savingSection) return;
        _savingSection = true;
        try
        {
            string? notInEffect = null;   // BUG-526
            try
            {
                notInEffect = await SavedEvenIfNotInEffect(() => Settings.ResetAsync("Branding:AccentColor")) ?? notInEffect;
                notInEffect = await SavedEvenIfNotInEffect(() => Settings.ResetAsync("Branding:InkColor")) ?? notInEffect;
            }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
            {
                _brandError = ex.Message;
                return;
            }
            _accentColor = null;
            _inkColor = null;
            _brandError = null;
            await ReloadKeepingEdits(dropBrand: true);
            await JS.InvokeVoidAsync("imBrand.apply", "");
            if (notInEffect is not null) Toasts.Error(notInEffect);
            else Toasts.Info("Brand colors reset to defaults.");
        }
        finally { _savingSection = false; }
    }

    // --- Report logo (IReportBrandingStore) ---
    private string? _logoDataUri;
    private string? _logoError;

    // BUG-603: one logo change at a time (a second pick, or Remove during an upload, raced the first).
    private readonly InFlight _logoBusy = new();

    private Task OnLogoSelected(InputFileChangeEventArgs e) => _logoBusy.Run(() => SaveLogo(e));

    private async Task SaveLogo(InputFileChangeEventArgs e)
    {
        _logoError = null;
        // BUG-341 sibling: never InputFileChangeEventArgs.File, which throws for two or more files; the first is the logo.
        if (DroppedFiles.First(e).First is not { } file) return;

        var ct = file.ContentType ?? "";
        if (!ct.Contains("png", StringComparison.OrdinalIgnoreCase) && !ct.Contains("jpeg", StringComparison.OrdinalIgnoreCase))
        {
            _logoError = "Choose a PNG or JPEG image.";
            return;
        }

        // BUG-215: the size is checked up front, so a failure saving the file isn't reported as the file being too big.
        const long maxBytes = 2 * 1024 * 1024;
        if (file.Size > maxBytes)
        {
            _logoError = "That image is over 2 MB. Choose a smaller file.";
            return;
        }
        try
        {
            await using var stream = file.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            await Branding.SaveLogoAsync(ms.ToArray(), ct);
            await ReloadKeepingEdits();
            Toasts.Success("Report logo updated.");
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _logoError = LogoNotSaved;
        }
        catch (Exception ex) when (ex is ArgumentException)
        {
            _logoError = ex.Message;
        }
    }

    private const string LogoNotSaved = "The logo couldn't be saved, so the current one is unchanged. Try again; if it keeps failing, " +
        "check that the app can write to its branding folder.";

    private async Task RemoveLogo()
    {
        try { await Branding.ClearLogoAsync(); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException)
        {
            _logoError = "The logo couldn't be removed. Try again; if it keeps failing, check that the app can write to its branding folder.";
            return;
        }
        await ReloadKeepingEdits();
        Toasts.Info("Report logo removed.");
    }

    private bool IsTrue(string key) =>
        bool.TryParse(_form.GetValueOrDefault(key), out var b) && b;

    private void SetBool(string key, bool on) => _form[key] = on ? "true" : "false";

    // --- Section save (design review Phase 3): one Save for everything on the active section ---
    private bool _savingSection;
    private IEnumerable<string> SectionGroups => ActiveGroups ?? [];
    private bool SectionHasBrand => SectionGroups.Contains("Organization");
    private bool SectionHasLayout => SectionGroups.Contains("Report defaults");
    private bool SectionDirty =>
        SectionGroups.Any(GroupDirty) || (SectionHasBrand && BrandDirty) || (SectionHasLayout && LayoutDirty);

    // A changed value that breaks its setting's rules is said under it as it's typed, and holds the section's Save; a value
    // already saved isn't re-judged here (Diagnostics lists those).
    private string? FieldProblem(SettingDefinition def) =>
        _effective is not null && Differs(def.Key) ? SettingsCatalog.Problem(def, _form.GetValueOrDefault(def.Key)) : null;
    private string InvalidClass(SettingDefinition def) => FieldProblem(def) is null ? "" : "is-invalid";
    private int SectionProblems =>
        _effective?.Count(e => SectionGroups.Contains(e.Definition.Group) && FieldProblem(e.Definition) is not null) ?? 0;
    private static string Plural(int n, string word) => IncidentManager.Application.Common.Plural.Of(n, word);

    // What a save changed, for its message: each setting's label, with old and new values when they're short.
    private string Described(string key, string? before)
    {
        var def = SettingsCatalog.ByKey[key];
        var label = DisplayLabel(def);
        var after = _form.GetValueOrDefault(key);
        static string Show(SettingDefinition d, string? v) => d.Kind == SettingKind.Bool
            ? (bool.TryParse(v, out var on) && on ? "on" : "off")
            : d.Options?.FirstOrDefault(o => string.Equals(o.Value, v, StringComparison.OrdinalIgnoreCase))?.Label ?? ShownValue(v);
        var (from, to) = (Show(def, before), Show(def, after));
        return def.Kind == SettingKind.MultiText || from.Length + to.Length > 60 ? label : $"{label} ({from} → {to})";
    }

    private async Task SaveSection()
    {
        // BUG-394: a double-click mustn't run a second save, which could insert the same new AppSettings key twice.
        if (_effective is null || _savingSection) return;
        // BUG-461: the section is fixed at the click. Switching sections during the awaits mustn't change what is
        // saved, which edits the reload drops, or the section the toast names.
        var groups = SectionGroups.ToHashSet();
        var keys = SectionKeys();
        var hasBrand = SectionHasBrand;
        var hasLayout = SectionHasLayout;
        var title = ActiveTitle;
        _brandError = null;
        var saveBrand = hasBrand && BrandDirty;
        var saveLayout = hasLayout && LayoutDirty;
        var accent = NullIfBlank(_accentColor);
        var ink = NullIfBlank(_inkColor);
        if (saveBrand && accent is not null && !BrandPalette.IsValidHex(accent)) { _brandError = "Accent color must be a hex value like #2563eb."; return; }
        if (saveBrand && ink is not null && !BrandPalette.IsValidHex(ink)) { _brandError = "Primary action color must be a hex value like #232a33."; return; }

        // BUG-394: busy until the saved values have reloaded, so a click in between can't save them again.
        _savingSection = true;
        try
        {
            var changed = 0;
            var saved = new List<string>();   // REV-40: the keys already in effect if a later one fails
            var changes = new List<string>();   // what each saved setting changed, for the message
            var layoutSaved = false;
            // BUG-526: a key whose settings reload failed is saved all the same (not yet in effect). Treated as nothing saved,
            // the layout kept its old stamp and the retry was refused as stale. So carry on with the rest, then warn.
            string? notInEffect = null;
            try
            {
                foreach (var s in _effective.Where(e => groups.Contains(e.Definition.Group)).ToList())
                {
                    if (!Differs(s.Definition.Key)) continue;
                    var value = _form.GetValueOrDefault(s.Definition.Key);
                    var described = Described(s.Definition.Key, s.Value);
                    notInEffect = await SavedEvenIfNotInEffect(() => Settings.SetAsync(s.Definition.Key, value)) ?? notInEffect;
                    saved.Add(s.Definition.Key);
                    changes.Add(described);
                    changed++;
                }
                if (saveLayout)
                {
                    // BUG-438: the layout is saved whole, so one another administrator saved since this page loaded is refused.
                    var layout = ReportLayout.Serialize(_layout);
                    var loadedFrom = _layoutLoadedFrom;
                    notInEffect = await SavedEvenIfNotInEffect(() => Settings.SetAsync("Reporting:SectionLayout", layout, loadedFrom)) ?? notInEffect;
                    layoutSaved = true;
                    changed++;
                }
                if (saveBrand)
                {
                    notInEffect = await SavedEvenIfNotInEffect(() => accent is null
                        ? Settings.ResetAsync("Branding:AccentColor") : Settings.SetAsync("Branding:AccentColor", accent)) ?? notInEffect;
                    notInEffect = await SavedEvenIfNotInEffect(() => ink is null
                        ? Settings.ResetAsync("Branding:InkColor") : Settings.SetAsync("Branding:InkColor", ink)) ?? notInEffect;
                    changed++;
                }
            }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
            {
                if (saved.Count == 0 && !layoutSaved) { Toasts.Error(ex.Message); return; }
                // REV-40: each key saves on its own, so the ones before the failure are in effect. Show them as saved, keep the
                // rest as unsaved edits, and say which is which, rather than leave everything looking unsaved.
                // BUG-461: a layout already saved is dropped too, or it would stay "unsaved" on its old stamp and be refused as stale.
                var names = saved.Select(k => _effective.FirstOrDefault(e => e.Definition.Key == k)?.Definition.Label ?? k).ToList();
                if (layoutSaved) names.Add("the report layout");
                await ReloadKeepingEdits(saved, dropLayout: layoutSaved);
                Toasts.Error($"Saved {string.Join(", ", names)}, but not the rest: {ex.Message}");
                if (notInEffect is not null) Toasts.Error(notInEffect);
                return;
            }

            await ReloadKeepingEdits(keys, dropBrand: hasBrand, dropLayout: hasLayout);
            if (saveBrand) await JS.InvokeVoidAsync("imBrand.apply", BrandPalette.BuildCss(accent, ink) ?? "");
            if (notInEffect is not null) Toasts.Error(notInEffect);
            else
            {
                // Say what changed and, when any of it waits for a background job or a new sign-in, when it applies.
                var what = changes.Count is > 0 and <= 4 ? $": {string.Join("; ", changes)}" : "";
                // "It applies within about 10 minutes." / "2 of them apply to new sign-ins."
                var when = string.Concat(saved.GroupBy(SettingsCatalog.EffectOf).Where(g => g.Key != SettingEffect.Immediate).Select(g =>
                {
                    var phrase = SettingsCatalog.EffectText(g.Key)!["Applies ".Length..];
                    var n = g.Count();
                    return n == changed ? $" {(n == 1 ? "It applies" : "They apply")} {phrase}."
                        : $" {n} of them {(n == 1 ? "applies" : "apply")} {phrase}.";
                }));
                Toasts.Success($"Saved {Plural(changed, "change")} to {title}{what}.{when}");
            }
        }
        finally
        {
            _savingSection = false;
        }
    }

    private async Task DiscardSection()
    {
        var brandWasDirty = SectionHasBrand && BrandDirty;
        _brandError = null;
        await ReloadKeepingEdits(SectionKeys(), dropBrand: SectionHasBrand, dropLayout: SectionHasLayout);
        if (brandWasDirty)
            await JS.InvokeVoidAsync("imBrand.apply",
                BrandPalette.BuildCss(NullIfBlank(SavedValue("Branding:AccentColor")), NullIfBlank(SavedValue("Branding:InkColor"))) ?? "");
        Toasts.Info("Discarded unsaved changes.");
    }

    private HashSet<string> SectionKeys() =>
        _effective?.Where(e => SectionGroups.Contains(e.Definition.Group)).Select(e => e.Definition.Key)
            .ToHashSet(StringComparer.OrdinalIgnoreCase) ?? [];

    // Reload the saved settings but carry every other unsaved edit over: the form keeps edits while the admin moves
    // between sections, so saving, discarding or resetting one thing mustn't silently wipe the rest.
    private async Task ReloadKeepingEdits(IReadOnlyCollection<string>? drop = null, bool dropBrand = false, bool dropLayout = false)
    {
        var keep = _effective?
            .Where(e => Differs(e.Definition.Key) && (drop is null || !drop.Contains(e.Definition.Key)))
            .ToDictionary(e => e.Definition.Key, e => _form.GetValueOrDefault(e.Definition.Key))
            ?? new Dictionary<string, string?>();
        var keepBrand = !dropBrand && BrandDirty ? (_accentColor, _inkColor) : ((string?, string?)?)null;
        var keepLayout = !dropLayout && LayoutDirty ? _layout.ToList() : null;
        var keepLayoutFrom = _layoutLoadedFrom;

        if (!await LoadAsync()) return;   // BUG-601: the newer reload keeps the edits as they are then

        foreach (var (k, v) in keep) _form[k] = v;
        if (keepBrand is { } b) (_accentColor, _inkColor) = b;
        if (keepLayout is not null) (_layout, _layoutLoadedFrom) = (keepLayout, keepLayoutFrom);
    }

    private async Task ResetOne(string key)
    {
        // BUG-437: one save or reset at a time. A double click ran the reset twice, and the second lost the delete.
        if (_savingSection) return;
        _savingSection = true;
        try
        {
            string? notInEffect;
            try { notInEffect = await SavedEvenIfNotInEffect(() => Settings.ResetAsync(key)); }   // BUG-526
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { Toasts.Error(ex.Message); return; }
            await ReloadKeepingEdits([key]);
            if (notInEffect is not null) Toasts.Error(notInEffect);
            else Toasts.Info("Reverted to default.");
        }
        finally { _savingSection = false; }
    }

    // BUG-526: runs one settings save. A save whose reload failed is saved, so its warning is returned, not thrown.
    private static async Task<string?> SavedEvenIfNotInEffect(Func<Task> save)
    {
        try { await save(); return null; }
        catch (SettingsNotInEffectException ex) { return ex.Message; }
    }

    private static RenderFragment StatusBadge(bool ok, string yes, string no) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", ok ? "im-badge im-b-ok"
                                             : "im-badge im-b-danger");
        builder.AddContent(2, ok ? yes : no);
        builder.CloseElement();
    };

    private static RenderFragment BackupBadge(BackupHealthState state) => builder =>
    {
        var (css, text) = state switch
        {
            BackupHealthState.Ok => ("im-badge im-b-ok", "Fresh"),
            BackupHealthState.Stale => ("im-badge im-b-warn", "Stale"),
            BackupHealthState.Missing => ("im-badge im-b-danger", "Missing"),
            BackupHealthState.Failed => ("im-badge im-b-danger", "Failed"),
            _ => ("im-badge im-b-neutral", "Not configured"),
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, text);
        builder.CloseElement();
    };
