@page "/admin/settings/{Section?}"
@using Microsoft.EntityFrameworkCore
@using IncidentManager.Application.Ops
@using IncidentManager.Application.Reporting
@using IncidentManager.Application.Abstractions
@using IncidentManager.Application.Branding
@using IncidentManager.Domain.Common
@attribute [Authorize(Policy = Policies.Administer)]
@inject IncidentManager.Web.Siem.SiemTestService SiemTest
@layout AdminLayout
@inject AdminSettingsService Settings
@inject IReportBrandingStore Branding
@inject ToastService Toasts
@inject IConfiguration Config
@inject IWebHostEnvironment Env
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<IncidentManager.Infrastructure.Persistence.AppDbContext> DbFactory
@inject IncidentManager.Application.Abstractions.ISealSigner Signer
@inject IncidentManager.Application.Abstractions.ILedgerStatus Ledger
@inject IncidentManager.Application.Abstractions.IEmailSender Email
@inject IncidentManager.Application.Abstractions.IChatNotifier Chat
@inject IncidentManager.Web.Ops.BackupHealthReader Backup
@inject IncidentManager.Web.Services.AdminHealth Health
@inject IncidentManager.Application.Abstractions.IEvidenceKeyring EvidenceKey
@inject IncidentManager.Application.Integrity.IEvidenceIntegrityMonitor EvidenceIntegrity
@inject IncidentManager.Application.Integrity.IntegrityCheckState IntegrityCheck
@inject IncidentManager.Application.Evidence.EvidenceService EvidenceStorage
@inject IncidentManager.Application.Evidence.EvidenceUploadSessions EvidenceUploads
@inject IncidentManager.Web.BackgroundJobs.EvidenceStoreStatus EvidenceStoreProbe
@inject IncidentManager.Application.Abstractions.IEvidenceStore EvidenceStoreFiles
@inject IncidentManager.Application.Abstractions.ISecretResolutionHealth SecretHealth
@inject IncidentManager.Web.Notifications.SmtpSignInStore SmtpSignIns
@inject IncidentManager.Application.Abstractions.IOrganizationDomains OrgDomains
@inject IncidentManager.Application.Abstractions.IRelatedExclusionsProvider RelatedExclusionsInForce
@inject IncidentManager.Web.Secrets.StoredSecretStore StoredSecrets
@inject IncidentManager.Web.Secrets.StoredSecretAdminService StoredSecretAdmin
@inject Microsoft.Extensions.Options.IOptionsMonitor<IncidentManager.Infrastructure.Notifications.EmailOptions> EmailOptions
@inject ISeverityLabels SevLabels
@inject TimeDisplay TimeDisp
@inject IUserDirectory Users
@inject IncidentManager.Application.Notifications.RetentionReviewState RetentionCount
@inject AccessReviewService AccessReviews
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Administration</PageTitle>

@* Edits are kept while moving between settings sections (one page), but leaving for anywhere else drops
   them, so ask first. The browser's own prompt covers refresh and tab close (a security lock stops it in
   markdown-editor.js, BUG-369). *@
<NavigationLock OnBeforeInternalNavigation="OnBeforeLeave" ConfirmExternalNavigation="@HasUnsavedChanges" />

<PageHeader Title="@ActiveTitle"
           Subtitle="@ActiveSubtitle">
    <Actions>
        <span class="im-badge im-b-neutral"><span class="bi bi-shield-lock me-1"></span>SysAdmin only</span>
    </Actions>
</PageHeader>

@{ var activeGroups = ActiveGroups; }

@* Pages that are more than settings: the taxonomy editor (its own saves) above the severity labels. *@
@if (_activeId == "taxonomy")
{
    <TaxonomyEditor />
}

@if (activeGroups is not null)
{
            @if (_effective is null)
            {
                <LoadingBlock />
            }
            else
            {
                @foreach (var group in activeGroups)
                {
                    @* Delivery-readiness panel (PROD-01): the notification settings only *deliver* when
                       Send email is on, a From address is set, and a trigger is enabled with a reachable
                       recipient. Surface that whole chain at a glance so enabling a trigger while email is
                       off (a silent "logged, not sent") is obvious rather than a surprise. Reads the pending
                       form values so it updates live as switches flip; applies on Save. *@
                    @if (group == "Email delivery")
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span><span class="bi bi-broadcast me-1"></span>Delivery readiness</span>
                                @if (NotifyLive) { <span class="im-badge im-b-ok">Live</span> }
                                else if (!EmailOn) { <span class="im-badge im-b-warn">Not delivering</span> }
                                else { <span class="im-badge im-b-neutral">Nothing enabled</span> }
                            </div>
                            <div class="card-body">
                                <p class="small text-muted mb-2">
                                    A notification is delivered only when <strong>Send email</strong> is on, a
                                    <strong>From address</strong> is set, and the trigger is enabled with a reachable
                                    recipient. This panel reflects unsaved selections. Click <strong>Save changes</strong> to apply them.
                                    Reminder scans pick up changes within a few minutes.
                                </p>
                                <ul class="list-unstyled mb-0 small">
                                    <li class="mb-1 d-flex align-items-start gap-2">
                                        @ReadyIcon(EmailOn)
                                        <span><strong>Email delivery:</strong> @(EmailOn ? "on, sending through the configured relay" : "off. Messages are logged, not sent.")</span>
                                    </li>
                                    <li class="mb-1 d-flex align-items-start gap-2">
                                        @ReadyIcon(FromSet)
                                        <span><strong>From address:</strong> @(FromSet ? FormText("Email:From")! : "not set (required to send)")</span>
                                    </li>
                                    <li class="mb-1 d-flex align-items-center justify-content-between">
                                        <span>Breach&nbsp;&rarr; Legal/Privacy <span class="text-muted">(on escalation)</span></span>
                                        @if (EmailOn && FromSet && !LegalDistributionSet) { <span class="im-badge im-b-warn">No recipients set</span> }
                                        else { @TriggerState(true, EmailOn && FromSet && LegalDistributionSet) }
                                    </li>
                                    <li class="mb-1 d-flex align-items-center justify-content-between">
                                        <span>Assignment notifications</span>
                                        @TriggerState(FormBool("Email:AssignmentNotifications"), EmailOn && FromSet)
                                    </li>
                                    <li class="mb-1 d-flex align-items-center justify-content-between">
                                        <span>Overdue task reminders</span>
                                        @TriggerState(FormBool("Notifications:OverdueScan:Enabled"), EmailOn && FromSet)
                                    </li>
                                    <li class="mb-1 d-flex align-items-center justify-content-between">
                                        <span>Due-soon task reminders</span>
                                        @TriggerState(FormBool("Notifications:DueSoonScan:Enabled"), EmailOn && FromSet)
                                    </li>
                                    <li class="mb-1 d-flex align-items-center justify-content-between">
                                        <span>Regulatory deadline reminders <span class="text-muted">(needs the deadline clock on)</span></span>
                                        @if (FormBool("Notifications:DeadlineScan:Enabled") && !DeadlineClockOn)
                                        { <span class="im-badge im-b-warn">On but clock off</span> }
                                        else { @TriggerState(FormBool("Notifications:DeadlineScan:Enabled"), EmailOn && FromSet) }
                                    </li>
                                    <li class="mb-1 d-flex align-items-center justify-content-between">
                                        <span>Stale-case nudges</span>
                                        @TriggerState(FormBool("Notifications:StaleScan:Enabled"), EmailOn && FromSet)
                                    </li>
                                    <li class="mb-1 d-flex align-items-center justify-content-between">
                                        <span>Personal work digests <span class="text-muted">(per-user opt-in)</span></span>
                                        @TriggerState(FormBool("Notifications:DigestScan:Enabled"), EmailOn && FromSet)
                                    </li>
                                    @* CAP-01 *@
                                    <li class="mb-1 d-flex align-items-center justify-content-between">
                                        <span>Imports waiting for review <span class="text-muted">(to whoever can confirm them)</span></span>
                                        @TriggerState(FormBool("Notifications:ImportSubmitted:Email"), EmailOn && FromSet)
                                    </li>
                                    <li class="d-flex align-items-center justify-content-between">
                                        <span>Team chat channel <span class="text-muted">(Slack/Teams webhook)</span></span>
                                        @if (ChatConfigured) { <span class="im-badge im-b-ok">Configured</span> }
                                        else if (AnyChatTypeOn) { <span class="im-badge im-b-warn">No webhook set</span> }
                                        else { <span class="im-badge im-b-neutral">Not configured</span> }
                                    </li>
                                </ul>
                                @if (!EmailOn && (AnyTriggerOn || LegalDistributionSet))
                                {
                                    <div class="alert alert-warning small mt-2 mb-0 py-2">
                                        <span class="bi bi-exclamation-triangle-fill me-1"></span>
                                        Notifications are enabled but <strong>Send email</strong> is off, so they're logged, not
                                        delivered. Turn on Send email below to go live.
                                    </div>
                                }
                                else if (EmailOn && !FromSet)
                                {
                                    <div class="alert alert-warning small mt-2 mb-0 py-2">
                                        <span class="bi bi-exclamation-triangle-fill me-1"></span>
                                        Email is on but the <strong>From address</strong> is blank. Set it below or sends will fail.
                                    </div>
                                }
                                else if (EmailOn && FromSet && !AnyTriggerOn && !LegalDistributionSet)
                                {
                                    <div class="alert alert-info small mt-2 mb-0 py-2">
                                        <span class="bi bi-info-circle me-1"></span>
                                        Email is ready, but no notifications are enabled. Turn on the ones you want below.
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            @* A page with one card doesn't repeat its own title on it. *@
                            <span>@(group == ActiveTitle ? "Settings" : group)</span>
                            <div class="d-flex align-items-center gap-2">
                                @if (GroupDirty(group))
                                {
                                    <span class="small text-warning-emphasis">Unsaved changes</span>
                                }
                            </div>
                        </div>
                        <div class="card-body">
                            @foreach (var s in _effective.Where(e => e.Definition.Group == group && !e.Definition.CustomEditor))
                            {
                                var def = s.Definition;
                                <div class="row mb-3 align-items-start">
                                    <div class="col-md-6 col-xl-5">
                                        <label class="form-label mb-0 fw-semibold" for="@def.Key">@DisplayLabel(def)</label>
                                        <div class="small text-muted">@def.Description</div>
                                        @* Only a changed setting is marked; the default is the unremarkable state. *@
                                        @if (s.IsOverridden)
                                        {
                                            <div class="mt-1">
                                                <span class="im-badge im-b-info">Changed in CaseBook</span>
                                                @if (s.ChangedAtUtc is { } changedAt)
                                                {
                                                    <span class="small text-muted ms-1">by @Users.DisplayFor(s.ChangedBy), @TimeDisp.DateOnly(changedAt)</span>
                                                }
                                                <button class="btn btn-link btn-sm p-0 ms-2 align-baseline"
                                                        title="@(s.ServerValueFromFile ? $"Back to the server's settings file: {ShownValue(s.ServerValue)}" : $"Back to the default: {ShownValue(s.ServerValue)}")"
                                                        @onclick="() => ResetOne(def.Key)" disabled="@_savingSection">@(s.ServerValueFromFile ? "Reset to the server's value" : "Reset to default")</button>
                                            </div>
                                        }
                                        else if (s.ServerValueFromFile && !string.Equals(s.ServerValue ?? "", def.Default ?? "", StringComparison.OrdinalIgnoreCase))
                                        {
                                            @* BUG-245: say where a value that isn't the default comes from. *@
                                            <div class="mt-1 small text-muted">Set in the server's settings file (the default is @ShownValue(def.Default)).</div>
                                        }
                                    </div>
                                    <div class="col-md-6 col-xl-7">
                                        @switch (def.Kind)
                                        {
                                            case SettingKind.Text when def.Options is { } opts:
                                                <select class="form-select @InvalidClass(def)" id="@def.Key" style="max-width:20rem"
                                                        value="@_form[def.Key]" @onchange="e => _form[def.Key] = e.Value?.ToString()">
                                                    @if (!opts.Any(o => string.Equals(o.Value, _form[def.Key], StringComparison.OrdinalIgnoreCase)) && !string.IsNullOrEmpty(_form[def.Key]))
                                                    {
                                                        <option value="@_form[def.Key]">@_form[def.Key] (not recognized)</option>
                                                    }
                                                    @foreach (var o in opts)
                                                    {
                                                        <option value="@o.Value" selected="@string.Equals(o.Value, _form[def.Key], StringComparison.OrdinalIgnoreCase)">@o.Label</option>
                                                    }
                                                </select>
                                                break;
                                            case SettingKind.Bool:
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" id="@def.Key"
                                                           checked="@IsTrue(def.Key)"
                                                           @onchange="e => SetBool(def.Key, (bool)(e.Value ?? false))" />
                                                    <label class="form-check-label" for="@def.Key">@(IsTrue(def.Key) ? "Enabled" : "Disabled")</label>
                                                </div>
                                                break;
                                            case SettingKind.MultiText:
                                                <textarea class="form-control font-monospace @InvalidClass(def)" id="@def.Key" rows="4"
                                                          value="@_form[def.Key]"
                                                          aria-describedby="@(def.Key == RelatedExclusionSettings.DomainsKey ? "org-domains-found" : null)"
                                                          @oninput="e => _form[def.Key] = e.Value?.ToString()"></textarea>
                                                @if (def.Key == RelatedExclusionSettings.DomainsKey)
                                                {
                                                    @DiscoveredDomains(s, OrgDomains.Current)
                                                }
                                                break;
                                            case SettingKind.Int:
                                                <input class="form-control @InvalidClass(def)" id="@def.Key" type="number" min="@def.Min" max="@def.Max" style="max-width:12rem"
                                                       value="@_form[def.Key]"
                                                       @oninput="e => _form[def.Key] = e.Value?.ToString()" />
                                                break;
                                            default:
                                                <input class="form-control @InvalidClass(def)" id="@def.Key" type="text"
                                                       value="@_form[def.Key]"
                                                       @oninput="e => _form[def.Key] = e.Value?.ToString()" />
                                                break;
                                        }
                                        @if (FieldProblem(def) is { } problem)
                                        {
                                            <div class="invalid-feedback d-block" role="alert">@problem</div>
                                        }
                                        <div class="form-text"><code class="small">@def.Key</code>
                                            @if (SettingsCatalog.EffectText(SettingsCatalog.EffectOf(def.Key)) is { } effect)
                                            {
                                                <span class="im-badge im-b-neutral ms-2" title="When a saved change applies">@effect</span>
                                            }
                                            @* CAP-03: who changed it and when, on the Integrity page's trail (the key isn't personal data). *@
                                            <a class="ms-2" href="@($"integrity?entity=AppSetting&key={Uri.EscapeDataString(def.Key)}#audit-trail")"
                                               aria-label="@($"History of {DisplayLabel(def)}")">History</a></div>
                                    </div>
                                </div>
                            }
                            @if (HostRows(group) is { Count: > 0 } host)
                            {
                                <div class="border-top pt-3">
                                    <div class="small fw-semibold mb-2">Set on the host
                                        <a class="fw-normal ms-1" href="admin/settings/server">Server configuration</a></div>
                                    @foreach (var (label, value) in host)
                                    {
                                        <div class="row mb-1 small">
                                            <div class="col-md-6 col-xl-5 text-muted">@label</div>
                                            <div class="col-md-6 col-xl-7">@value</div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* Report logo + brand colours are part of the Organization profile, so they sit with it (X-01). *@
                    @if (group == "Organization")
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center"><span><span class="bi bi-image me-1"></span>Report logo</span><span class="im-badge im-b-neutral" title="Uploading or removing the logo saves it at once; it doesn't wait for Save changes">Saves on its own</span></div>
                            <div class="card-body">
                                <p class="small text-muted">
                                    Shown above the organization and team names in the report header. PNG or JPEG,
                                    up to 2&nbsp;MB. Landscape images work best. Without a logo, the header is text only.
                                </p>
                                <div class="row g-3 align-items-center">
                                    <div class="col-sm-5">
                                        @if (_logoDataUri is not null)
                                        {
                                            <img src="@_logoDataUri" alt="Current report logo"
                                                 style="max-height:64px;max-width:100%;background:#fff;border:1px solid var(--bs-border-color);border-radius:.25rem;padding:.25rem" />
                                        }
                                        else
                                        {
                                            <span class="im-badge im-b-neutral">No logo set</span>
                                        }
                                    </div>
                                    <div class="col-sm-7">
                                        <InputFile class="form-control form-control-sm mb-2" accept="image/png,image/jpeg" OnChange="OnLogoSelected" disabled="@_logoBusy.Busy" />
                                        @if (_logoDataUri is not null)
                                        {
                                            <button class="btn btn-outline-danger btn-sm" @onclick="ConfirmRemoveLogo" disabled="@_logoBusy.Busy">Remove logo</button>
                                        }
                                        @if (_logoError is not null)
                                        {
                                            <div class="text-danger small mt-1">@_logoError</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span><span class="bi bi-palette me-1"></span>Brand colors</span>
                                <div class="d-flex align-items-center gap-2">
                                    @if (BrandDirty)
                                    {
                                        <span class="small text-warning-emphasis">Unsaved changes</span>
                                    }
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="ResetBrand" disabled="@_savingSection">Reset to defaults</button>
                                </div>
                            </div>
                            <div class="card-body">
                                <p class="small text-muted">
                                    <strong>Accent color</strong> sets links, active states, selected rows, focus rings and highlights.
                                    <strong>Primary action color</strong> sets primary buttons in the light theme and structural ink; in
                                    the dark theme primary buttons are light ink so they never look like a warning. Link shades are
                                    adjusted automatically to keep AA contrast in light and dark themes. Severity, phase and status
                                    colors don't change.
                                </p>
                                <div class="row g-3">
                                    <div class="col-sm-6">
                                        <label class="form-label mb-1 fw-semibold" for="adm-brand-accent">Accent color</label>
                                        @if (IsOverridden("Branding:AccentColor")) { <span class="im-badge im-b-info ms-1">Custom</span> }
                                        else { <span class="im-badge im-b-neutral ms-1">Default</span> }
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <input id="adm-brand-accent" type="color" class="form-control form-control-color" value="@AccentOrDefault"
                                                   @oninput="e => OnAccentInput(e.Value?.ToString())" />
                                            <input type="text" class="form-control font-monospace" style="max-width:9rem" aria-label="Accent color hex value" placeholder="#ffcf31"
                                                   value="@_accentColor" @oninput="e => OnAccentInput(e.Value?.ToString())" />
                                        </div>
                                        <div class="form-text">Blank uses the built-in gold.</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <label class="form-label mb-1 fw-semibold" for="adm-brand-ink">Primary action color</label>
                                        @if (IsOverridden("Branding:InkColor")) { <span class="im-badge im-b-info ms-1">Custom</span> }
                                        else { <span class="im-badge im-b-neutral ms-1">Default</span> }
                                        <div class="d-flex align-items-center gap-2 mt-1">
                                            <input id="adm-brand-ink" type="color" class="form-control form-control-color" value="@InkOrDefault"
                                                   @oninput="e => OnInkInput(e.Value?.ToString())" />
                                            <input type="text" class="form-control font-monospace" style="max-width:9rem" aria-label="Primary action color hex value" placeholder="#232a33"
                                                   value="@_inkColor" @oninput="e => OnInkInput(e.Value?.ToString())" />
                                        </div>
                                        <div class="form-text">Blank uses the built-in charcoal.</div>
                                    </div>
                                </div>
                                @if (_brandError is not null)
                                {
                                    <div class="text-danger small mt-2">@_brandError</div>
                                }
                                <div class="mt-3 d-flex align-items-center gap-2 flex-wrap">
                                    <span class="small text-muted">Live preview:</span>
                                    <button type="button" class="btn btn-primary btn-sm" disabled>Primary button</button>
                                    <a href="admin" @onclick:preventDefault>Example link</a>
                                    <span class="im-badge im-b-danger">Critical (fixed)</span>
                                    <span class="im-badge im-b-ok">Resolved (fixed)</span>
                                </div>
                            </div>
                        </div>
                    }

                    @* The report-section designer belongs with the rest of the report settings. *@
                    @if (group == "Report defaults")
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span><span class="bi bi-list-ol me-1"></span>Report sections</span>
                                <div class="d-flex align-items-center gap-2">
                                    @if (LayoutDirty)
                                    {
                                        <span class="small text-warning-emphasis">Unsaved changes</span>
                                    }
                                </div>
                            </div>
                            <div class="card-body">
                                <p class="small text-muted">
                                    Choose which sections appear in reports, and in what order. The title, header,
                                    footer and integrity stamp always appear.
                                </p>
                                <ol class="list-group">
                                    @for (var i = 0; i < _layout.Count; i++)
                                    {
                                        var idx = i;
                                        var st = _layout[idx];
                                        <li class="list-group-item d-flex align-items-center gap-2">
                                            <div class="btn-group btn-group-sm" role="group">
                                                <button class="btn btn-outline-secondary" title="Move up" aria-label="Move @SectionLabel(st.Section) up"
                                                        disabled="@(idx == 0)" @onclick="() => MoveSection(idx, -1)">
                                                    <span class="bi bi-arrow-up" aria-hidden="true"></span>
                                                </button>
                                                <button class="btn btn-outline-secondary" title="Move down" aria-label="Move @SectionLabel(st.Section) down"
                                                        disabled="@(idx == _layout.Count - 1)" @onclick="() => MoveSection(idx, 1)">
                                                    <span class="bi bi-arrow-down" aria-hidden="true"></span>
                                                </button>
                                            </div>
                                            <div class="form-check form-switch mb-0 flex-grow-1">
                                                <input class="form-check-input" type="checkbox" id="sec-@st.Section"
                                                       checked="@st.Enabled" @onchange="e => ToggleSection(idx, (bool)(e.Value ?? false))" />
                                                <label class="form-check-label @(st.Enabled ? "" : "text-muted")" for="sec-@st.Section">
                                                    @SectionLabel(st.Section)
                                                    @if (!st.Enabled) { <span class="im-badge im-b-neutral ms-1">Hidden</span> }
                                                </label>
                                            </div>
                                            <span class="text-muted small">@(idx + 1)</span>
                                        </li>
                                    }
                                </ol>
                            </div>
                        </div>

                        @* UX-16: reusable report profiles live on the same Reports page as the defaults and
                           the section designer, not a separate rail entry. *@
                        <ReportTemplateLibrary @ref="_templateLibrary" OnChanged="() => _profilesEditor.ReloadAsync()" />
                        <ReportProfilesEditor @ref="_profilesEditor" OnChanged="() => _templateLibrary.ReloadAsync()" />
                    }

                    @* UX-15: the per-jurisdiction rules editor sits directly beneath the deadline-clock
                       settings, so the regulatory-deadline feature is one page (clock + rules), not two. *@
                    @if (group == "Deadline clock")
                    {
                        <RegulatoryDeadlineRules />
                    }

                    @if (group == "Evidence storage")
                    {
                    <div class="card mb-3">
                        <div class="card-header"><span class="bi bi-hdd me-1" aria-hidden="true"></span>Where evidence is stored</div>
                        <div class="card-body">
                    <p class="small text-muted mb-2">
                        Where evidence is stored, whether CaseBook can write and read there, and how much it takes against the limits
                        above.
                    </p>
                    <table class="table table-sm">
                        <tbody>
                            <tr>
                                <td style="width:32%">Store</td>
                                <td>
                                    @if (EvidenceStoreProbe.CheckedAtUtc is null)
                                    {
                                        <span class="im-badge im-b-neutral">Not checked yet</span>
                                    }
                                    else
                                    {
                                        @StatusBadge(EvidenceStoreProbe.Problem is null, "Writable", "Problem")
                                    }
                                    <code class="small ms-2" style="word-break:break-all">@EvidenceStoreFiles.Location</code>
                                    @if (EvidenceStoreProbe.Problem is { } why) { <div class="small text-danger">@why</div> }
                                </td>
                            </tr>
                            @if (_evidenceUseError is not null)
                            {
                                <tr><td>Used</td><td class="small text-danger">Couldn't be read: @_evidenceUseError</td></tr>
                            }
                            <tr>
                                <td>Large uploads in progress</td>
                                <td class="small">@EvidenceUploads.InProgress</td>
                            </tr>
                        </tbody>
                    </table>
                    @if (_evidenceUse is { } use)
                    {
                        <div class="mb-3"><IncidentManager.Web.Components.Shared.StorageMeter Use="use" /></div>
                    }
                        </div>
                    </div>
                    }

                    @if (group == "Integrity")
                    {
                    <div class="card mb-3">
                        <div class="card-header"><span class="bi bi-shield-check me-1" aria-hidden="true"></span>Evidence-at-rest results</div>
                        <div class="card-body">
                    <p class="small text-muted mb-2">
                        A background job re-hashes stored evidence and compares it to the SHA-256 recorded in the
                        audit chain, catching bit-rot or tampering. Each run checks a share of the files, so that every file is
                        checked within the full-pass days. A problem found stays listed until that file is checked again. Turn it
                        on and set the interval and full pass above. Alerts go to the integrity-alert distribution.
                    </p>
                    <table class="table table-sm">
                        <tbody>
                            @if (EvidenceIntegrity.Current is not { } ev)
                            {
                                <tr>
                                    <td style="width:32%">Status</td>
                                    <td>
                                        <span class="im-badge im-b-neutral">Not run</span>
                                        <span class="small text-muted ms-2">
                                            @(Config.GetValue<bool>("Integrity:EvidenceVerify:Enabled")
                                                ? "enabled, awaiting first pass"
                                                : "disabled")
                                        </span>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                <tr>
                                    <td style="width:32%">Overall</td>
                                    <td>
                                        @if (ev.IsClean)
                                        {
                                            <span class="im-badge im-b-ok">Clean</span>
                                        }
                                        else
                                        {
                                            <span class="im-badge im-b-danger">Drift: @ev.DriftCount</span>
                                        }
                                        <span class="small text-muted ms-2">
                                            @if (ev.TotalCount > ev.CheckedCount)
                                            {
                                                @($"{ev.CheckedCount:N0} of {ev.TotalCount:N0} checked in the latest run (every file at least every {Math.Max(1, Config.GetValue("Integrity:EvidenceVerify:PassDays", 7))} days)")
                                            }
                                            else
                                            {
                                                @($"{ev.CheckedCount:N0} checked")
                                            }
                                            · @ev.CheckedAtUtc.ToString("u")
                                        </span>
                                    </td>
                                </tr>
                                @foreach (var d in ev.Drifts)
                                {
                                    <tr>
                                        <td>@(d.Kind switch { IncidentManager.Application.Integrity.EvidenceDriftKind.StoreUnreachable => "Evidence store", IncidentManager.Application.Integrity.EvidenceDriftKind.KeyUnavailable => "Evidence key", _ => d.CaseNumber ?? d.CaseId.ToString() })</td>
                                        <td>
                                            <span class="im-badge im-b-danger">@d.Kind</span>
                                            <span class="small text-muted ms-2">@d.OriginalFileName: @d.Detail</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                        </div>
                    </div>
                    }

                    @* The SIEM, team chat and CyberArk are set on the host; their status shows here with the settings that use them. *@
                    @if (group == "Related indicators")
                    {
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span><span class="bi bi-broadcast-pin me-1" aria-hidden="true"></span>SIEM, team chat and CyberArk</span>
                                <span class="im-badge im-b-neutral">Set on the host</span>
                            </div>
                            <div class="card-body">
                                <p class="small text-muted mb-2">Turned on and pointed at their endpoints in the server's configuration
                                    (<a href="admin/settings/server">Server configuration</a>); shown here read-only.</p>
                                <table class="table table-sm mb-0"><tbody>@IntegrationRows()</tbody></table>
                            </div>
                        </div>
                @* CAP-40: the one SIEM webhook value that may be entered here rather than on the server: its token. *@
                <div id="siem-token"></div>
                <IncidentManager.Web.Components.Shared.StoredSecretCard Kind="IncidentManager.Web.Secrets.StoredSecretKind.SiemWebhookToken"
                    Title="SIEM webhook token" FieldLabel="Token"
                    Help="The collector's bearer token or API key, sent in the header set by Siem:Webhook:AuthHeader. The collector URL stays in the server's configuration."
                    Note="@(Config.GetValue<bool>("Siem:Webhook:Enabled") ? null : "The SIEM webhook is off in the server's configuration (Siem:Webhook:Enabled), so nothing is sent until it's turned on there. The token is kept until then.")" />
                    }

                    @* CAP-10: the review of closed cases past the period set above, on the same page. *@
                    @if (group == "Retention")
                    {
                        <RetentionReviewPanel />
                    }

                    @* PROD-49/50: what's newer than this build, its notes, and the one command that upgrades. *@
                    @if (group == "Updates")
                    {
                        <UpdatesPanel />
                    }

                    @* CAP-05: how CaseBook signs in to the relay, entered here (server configuration wins when it sets one). *@
                    @if (group == "Email delivery")
                    {
                        <div id="email-sign-in"><IncidentManager.Web.Components.Shared.EmailSignInCard /></div>
                    }

                    @* CAP-40: the team-chat webhook URL, entered here (server configuration wins when it sets one). *@
                    @if (group == "Team chat")
                    {
                        <div id="chat-webhook"></div>
                        <IncidentManager.Web.Components.Shared.StoredSecretCard Kind="IncidentManager.Web.Secrets.StoredSecretKind.ChatWebhookUrl"
                            Title="Team chat webhook" FieldLabel="Webhook URL"
                            Help="The Slack incoming webhook or Teams workflow URL for the channel. It's the channel's credential, so it's kept like a password. It must be https."
                            Note="@(Config.GetValue<bool>("Chat:Webhook:Enabled") ? null : "Chat is off in the server's configuration (Chat:Webhook:Enabled), so nothing posts until it's turned on there. The URL is kept until then.")" />
                    }

                    @* Send-a-test-email sits with the notification settings it exercises, after the last of them. *@
                    @if (group == "Team chat")
                    {
                        <div class="card mb-3">
                            <div class="card-header">Test notifications</div>
                            <div class="card-body">
                                <div class="row g-2 align-items-end" style="max-width:38rem">
                                    <div class="col-sm-8">
                                        <label class="form-label mb-0" for="adm-test-recipient">Send a test email to</label>
                                        <input id="adm-test-recipient" class="form-control" type="email" @bind="_testRecipient" @bind:event="oninput"
                                               placeholder="you@insurer.example" />
                                    </div>
                                    <div class="col-sm-4">
                                        <button class="btn btn-outline-primary w-100" @onclick="SendTest" disabled="@_testingEmail.Busy">Send test</button>
                                    </div>
                                </div>
                                <div class="form-text">
                                    @if (EmailSettingsUnsaved)
                                    {
                                        <span class="text-warning-emphasis">The test uses the saved settings. Save your email changes first to test them.</span>
                                    }
                                    else
                                    {
                                        @(Config.GetValue<bool>("Email:Enabled")
                                            ? "Email delivery is on. This sends through the configured relay."
                                            : "Email delivery is off. The message is written to the log, not sent.")
                                    }
                                </div>

                                <hr class="my-3" />

                                <label class="form-label mb-1 fw-semibold">Team chat</label>
                                <div>
                                    <button class="btn btn-outline-primary" @onclick="SendTestChat" disabled="@(!ChatConfigured || _testingChat.Busy)">Send a test chat message</button>
                                </div>
                                <div class="form-text">
                                    @(ChatConfigured
                                        ? "Posts a test message to the configured Slack/Teams channel."
                                        : "No chat webhook is configured. Turn on Chat:Webhook:Enabled on the server and set the URL under Team chat webhook above.")
                                </div>
                            </div>
                        </div>
                    }
                }

                @* Design review Phase 3: one Save for the whole section, pinned to the bottom while anything in it is
                   unsaved. Saving everything at once also means saving one card can't discard edits in another. *@
                @if (SectionDirty)
                {
                    <div class="adm-savebar" role="region" aria-label="Unsaved changes">
                        <span class="bi bi-pencil-square" aria-hidden="true"></span>
                        @if (SectionProblems is > 0 and var problems)
                        {
                            <span class="text-danger">@Plural(problems, "setting") to correct before saving</span>
                        }
                        else
                        {
                            <span>Unsaved changes in <strong>@ActiveTitle</strong></span>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" @onclick="DiscardSection" disabled="@_savingSection">Discard</button>
                        <button type="button" class="btn btn-sm btn-primary" @onclick="SaveSection" disabled="@(_savingSection || SectionProblems > 0)">Save changes</button>
                    </div>
                }
            }
        }
        else if (_activeId == "server")
        {
            <p class="text-muted">Set in <code>appsettings.json</code> or environment variables. Secrets show status only.</p>
            <table class="table table-sm">
                <thead><tr><th style="width:32%">Setting</th><th>Value / status</th></tr></thead>
                <tbody>
                    <tr><td>Authentication mode</td><td><code>@(Config["Auth:Mode"] ?? "(unset)")</code></td></tr>
                    <tr><td>Database provider</td><td><code>@(Config["Database:Provider"] ?? "(unset)")</code></td></tr>
                    <tr><td>Database connection</td><td>@StatusBadge(!string.IsNullOrWhiteSpace(Config.GetConnectionString("Default")), "Configured", "Not configured")</td></tr>
                    <tr><td>Evidence store path</td><td><code>@(Config["EvidenceStore:RootPath"] ?? "(unset)")</code></td></tr>
                    <tr><td>Report output path</td><td><code>@(Config["ReportOutput:RootPath"] ?? "(unset)")</code></td></tr>
                    <tr>
                        <td>Seal signing key</td>
                        <td>
                            @StatusBadge(true, "Loaded", "")
                            <span class="small ms-2">@Signer.KeySource</span>
                        </td>
                    </tr>
                    <tr>
                        <td>Seal signing key id</td>
                        <td><code class="small">@Signer.KeyId</code> <span class="small text-muted ms-2">@Signer.Algorithm</span></td>
                    </tr>
                    <tr>
                        <td>SQL Server ledger</td>
                        <td>
                            @if (_ledger is not { Applicable: true } lg)
                            {
                                <span class="small text-muted">Not applicable on this database provider.</span>
                            }
                            else if (lg.AllOn)
                            {
                                @StatusBadge(true, "On", "")
                                <span class="small text-muted ms-2">Audit log, seals and custody events are append-only ledger tables. Schedule Export-LedgerDigest.ps1 and verify with Verify-LedgerDigests.ps1.</span>
                            }
                            else
                            {
                                @StatusBadge(false, "", lg.OnCount == 0 ? "Off" : $"{lg.OnCount} of {lg.Tables.Count} tables")
                                <span class="small text-muted ms-2">Turn on with deploy\Enable-Ledger.ps1 (one-way). See OPERATIONS.md, "SQL Server ledger".</span>
                            }
                        </td>
                    </tr>
                    <tr><td>AD group → role mapping</td><td><span class="im-badge im-b-neutral">DB-managed</span> <span class="small text-muted ms-2">edit under Roles &amp; access</span></td></tr>
                    <tr>
                        <td>Email relay sign-in</td>
                        <td>
                            @* CAP-05: how, never with what: no username's password, reference or value is shown. *@
                            @if (IncidentManager.Infrastructure.Notifications.SmtpSignIn.InServerConfig(EmailOptions.CurrentValue))
                            {
                                var o = EmailOptions.CurrentValue;
                                var mode = IncidentManager.Infrastructure.Notifications.SmtpSignIn.Mode(o);
                                @StatusBadge(mode != IncidentManager.Infrastructure.Notifications.SmtpSignInMode.Invalid, "Server configuration", "Not usable")
                                <span class="small ms-2">@IncidentManager.Infrastructure.Notifications.SmtpSignIn.Describe(o)</span>
                            }
                            else if (_smtpSignIn is { } saved)
                            {
                                <span class="im-badge im-b-neutral">@(saved.Mode == IncidentManager.Infrastructure.Notifications.SmtpSignInMode.None ? "None" : "Set in Administration")</span>
                                <span class="small ms-2">@(saved.Mode switch
                                {
                                    IncidentManager.Infrastructure.Notifications.SmtpSignInMode.Password => saved.PasswordUnreadable
                                        ? "Username, with a saved password that can't be decrypted here: re-enter it"
                                        : "Username, with a password saved in Administration (encrypted with Data Protection)",
                                    IncidentManager.Infrastructure.Notifications.SmtpSignInMode.Integrated => "Integrated Windows authentication, as the app-pool account",
                                    _ => "The relay takes mail from this host without a sign-in",
                                })</span>
                            }
                            <span class="small text-muted ms-2">time limit @IncidentManager.Infrastructure.Notifications.SmtpSignIn.Timeout(EmailOptions.CurrentValue).TotalSeconds s</span>
                        </td>
                    </tr>
                    @IntegrationRows()
                </tbody>
            </table>
            <p class="small text-muted mt-2">Auto-seal is set in-app under <a href="admin/settings/integrity">Records &amp; evidence › Integrity</a>.
            To verify or seal on demand, go to <a href="integrity">Integrity &amp; audit</a>.</p>

            <p class="small text-muted mb-0">The SIEM webhook token is entered under <a href="admin/settings/integrations#siem-token">Integrations</a>.</p>
        }
        else if (_activeId == "source")
        {
            <p class="text-muted">For operational settings, a database override wins over <code>appsettings.json</code>.
            Everything else is server-side only. Secrets show status only.</p>

            <h6 class="text-uppercase small text-muted mt-3">Operational (admin-editable)</h6>
            <table class="table table-sm">
                <thead><tr><th style="width:34%">Key</th><th>Effective value</th><th style="width:22%">Source</th></tr></thead>
                <tbody>
                    @foreach (var def in SettingsCatalog.Editable)
                    {
                        var (value, source) = OperationalResolution(def);
                        <tr>
                            <td><code class="small">@def.Key</code></td>
                            <td>@(string.IsNullOrEmpty(value) ? EmptyDash : value)</td>
                            <td>@SourceBadge(source)</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h6 class="text-uppercase small text-muted mt-4">Server-side (read-only)</h6>
            <table class="table table-sm">
                <thead><tr><th style="width:34%">Key</th><th>Effective value</th><th style="width:22%">Source</th></tr></thead>
                <tbody>
                    @foreach (var (label, key, secret) in ServerKeys)
                    {
                        var r = ConfigSource.Resolve(Config, key);
                        <tr>
                            <td>@label <code class="small text-muted d-block">@key</code></td>
                            <td>
                                @if (secret && !string.IsNullOrEmpty(r.Value)) { <span class="text-muted">•••• (set)</span> }
                                else { @(string.IsNullOrEmpty(r.Value) ? EmptyDash : r.Value) }
                            </td>
                            <td>@SourceBadge(r.Source)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <AttentionSummary Items="_attention" CheckedAtUtc="Health.CheckedAtUtc" />

            <h2 class="h5 mt-4 mb-2" id="diag-service">Service health</h2>
            <h6 class="text-uppercase small text-muted mt-3" id="diag-checks">Health checks</h6>
            <table class="table table-sm">
                <tbody>
                    @if (_health is null)
                    {
                        <tr><td><em>Running checks&hellip;</em></td></tr>
                    }
                    else
                    {
                        @foreach (var h in _health)
                        {
                            <tr>
                                <td style="width:32%">@h.Label</td>
                                <td>
                                    @StatusBadge(h.Ok, "OK", h.Level == IncidentManager.Web.Services.AttentionLevel.Problem ? "Problem" : "See to it")
                                    <span class="small text-muted ms-2">@h.Detail</span>
                                    @if (!h.Ok && h.FixHref is { } fix) { <a class="small ms-2" href="@fix">Fix it</a> }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <h6 class="text-uppercase small text-muted mt-3" id="diag-delivery">Delivery health</h6>
            <IncidentManager.Web.Components.Shared.DeliveryHealthPanel />

            @* CAP-29: every background job's last run, next due and last error; Run now for the read-only scans. *@
            <h6 class="text-uppercase small text-muted mt-3" id="diag-jobs">Scheduled jobs</h6>
            <IncidentManager.Web.Components.Shared.ScheduledJobsPanel />

            <h6 class="text-uppercase small text-muted mt-3" id="diag-backup">Backup &amp; restore health</h6>
            @if (_backup is null)
            {
                <p class="small text-muted mb-2"><em>Reading status&hellip;</em></p>
            }
            else
            {
                <p class="small text-muted mb-2">
                    Read from <code>@_backup.Source</code>, which the backup and restore-drill scripts write
                    (<code>deploy\Backup-CaseBook.ps1</code> or <code>Update-CaseBookBackupStatus.ps1</code>, and
                    <code>Test-CaseBookRestore.ps1</code>). CaseBook only reads it. See OPERATIONS.md §1.
                </p>
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td style="width:32%">Overall</td>
                            <td>@BackupBadge(_backup.Overall)</td>
                        </tr>
                        @foreach (var item in _backup.Items)
                        {
                            <tr>
                                <td>@item.Label</td>
                                <td>@BackupBadge(item.State) <span class="small text-muted ms-2">@item.Detail</span></td>
                            </tr>
                        }
                        @if (!string.IsNullOrWhiteSpace(_backup.Note))
                        {
                            <tr><td>Note</td><td class="small text-muted">@_backup.Note</td></tr>
                        }
                    </tbody>
                </table>
            }

            @* CAP-19: every path to back up, and the manifest a backup job reads. *@
            <h2 class="h5 mt-4 mb-2" id="diag-storage-keys">Storage and keys</h2>
            <h6 class="text-uppercase small text-muted mt-3" id="diag-storage">Evidence storage</h6>
            <p class="small mb-2">
                @if (EvidenceStoreProbe.CheckedAtUtc is null) { <span class="im-badge im-b-neutral">Not checked yet</span> }
                else { @StatusBadge(EvidenceStoreProbe.Problem is null, "Writable", "Problem") }
                @if (_evidenceUse is { } storageUse)
                {
                    <span class="ms-2">@IncidentManager.Application.Evidence.EvidenceRoom.Size(storageUse.UsedBytes) used@(storageUse.QuotaBytes is { } q ? $" of {IncidentManager.Application.Evidence.EvidenceRoom.Size(q)}" : "")@(storageUse.FreeBytes is { } f ? $" · {IncidentManager.Application.Evidence.EvidenceRoom.Size(f)} free on the store" : "")</span>
                }
                <a class="ms-2" href="admin/settings/evidence">Evidence storage</a>
            </p>
            @* Withdrawn files: reinstatable for a while, then an administrator can purge their contents here. *@
            <h6 class="text-uppercase small text-muted mt-3" id="diag-withdrawn">Withdrawn evidence</h6>
            <WithdrawnEvidencePanel WindowDays="@IncidentManager.Application.Evidence.EvidenceWithdrawal.WindowDays(EvidenceStorage.Limits)" />
            <h6 class="text-uppercase small text-muted mt-3" id="diag-evidence-key">Evidence encryption</h6>
            <p class="small text-muted mb-2">
                Evidence and reports encrypted at rest with a key protected by the server's integrity certificate, kept in three
                places and backed up offline. Set in the server's configuration (OPERATIONS.md, Evidence key); the keys never show
                here.
            </p>
            <IncidentManager.Web.Components.Shared.EvidenceKeyPanel />

            <h6 class="text-uppercase small text-muted mt-3" id="diag-keys">Integrity keys and seal copies</h6>
            <p class="small text-muted mb-2">
                Set in the server's configuration (OPERATIONS §2), never here. Key ids are public thumbprints; no key is shown.
            </p>
            <div class="mb-3"><IntegrityKeyStatus /></div>

            <h6 class="text-uppercase small text-muted mt-3" id="diag-secrets">Secret resolution (CyberArk)</h6>
            <p class="small text-muted mb-2">
                Whether externalized secrets, such as a SIEM webhook token written as a
                <code>@("@cyberark:…")</code> reference, resolve from CyberArk CCP. Shows the last success and
                last error, never a secret value. Held in memory since the last restart and not audited.
            </p>
            @if (!Config.GetValue<bool>("Secrets:CyberArk:Enabled"))
            {
                <p class="small mb-3">
                    <span class="im-badge im-b-neutral">Disabled</span>
                    <span class="small text-muted ms-2">secrets are read literally from config/env. Enable
                    <code>Secrets:CyberArk</code> on the host (see OPERATIONS §6).</span>
                </p>
            }
            else if (SecretHealth.Current is { } sh)
            {
                <table class="table table-sm">
                    <tbody>
                        <tr>
                            <td style="width:32%">Status</td>
                            <td>
                                @if (!sh.AnyActivity)
                                {
                                    <span class="im-badge im-b-neutral">No activity</span>
                                    <span class="small text-muted ms-2">enabled, but no secret referenced since restart</span>
                                }
                                else if (sh.LastAttemptFailed)
                                {
                                    <span class="im-badge im-b-danger">Last attempt failed</span>
                                }
                                else
                                {
                                    <span class="im-badge im-b-ok">Healthy</span>
                                }
                                <span class="small text-muted ms-2">@sh.SuccessCount ok · @sh.FailureCount failed</span>
                            </td>
                        </tr>
                        @if (sh.LastSuccessUtc is { } ls)
                        {
                            <tr>
                                <td>Last success</td>
                                <td>
                                    <span class="small text-muted">@ls.ToString("u")</span>
                                    <code class="small ms-2">@sh.LastSuccessReference</code>
                                </td>
                            </tr>
                        }
                        @if (sh.LastFailureUtc is { } lf)
                        {
                            <tr>
                                <td>Last error</td>
                                <td>
                                    <span class="small text-muted">@lf.ToString("u")</span>
                                    <code class="small ms-2">@sh.LastFailureReference</code>
                                    <span class="small text-danger ms-2">@sh.LastFailureReason</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <h6 class="text-uppercase small text-muted mt-3" id="diag-backup-set">Backup set</h6>
            <IncidentManager.Web.Components.Shared.BackupSetPanel />

            <h2 class="h5 mt-4 mb-2" id="diag-capacity">Capacity</h2>
            <h6 class="text-uppercase small text-muted mt-3" id="diag-cost">Integrity check cost</h6>
            <p class="small text-muted mb-2">
                The integrity check runs every 10 minutes. Each run checks every record and the audit entries written
                since the last run, and re-hashes the whole audit trail every 6 hours. These figures show how long the
                latest run took, so you can see the check's cost grow with your data. They're held in memory since the
                last restart.
            </p>
            <table class="table table-sm">
                <tbody>
                    @if (IntegrityCheck.LastCycle is not { } cycle)
                    {
                        <tr><td style="width:32%">Latest run</td><td><span class="im-badge im-b-neutral">Not run yet</span></td></tr>
                    }
                    else
                    {
                        <tr>
                            <td style="width:32%">Latest run</td>
                            <td>
                                @StatusBadge(cycle.Total < IncidentManager.Application.Integrity.IntegrityCheckState.SlowCycle, "Quick", "Slow")
                                <span class="small text-muted ms-2">
                                    @(cycle.Full ? "Full" : "Incremental") · @cycle.Total.TotalSeconds.ToString("N1") s ·
                                    @(cycle.Intact ? "intact" : "found a problem") · @cycle.FinishedAtUtc.ToString("u")
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <td>Audit trail</td>
                            <td class="small">@cycle.EntriesHashed.ToString("N0") entries hashed in @cycle.Chain.TotalSeconds.ToString("N1") s</td>
                        </tr>
                        <tr>
                            <td>Records</td>
                            <td class="small">
                                @cycle.RecordsChecked.ToString("N0") checked in @cycle.Records.TotalSeconds.ToString("N1") s ·
                                @cycle.RecordsKept.ToString("N0") held in memory between runs
                            </td>
                        </tr>
                        @if (IntegrityCheck.NextWait(IncidentManager.Web.BackgroundJobs.IntegritySealHostedService.VerifyPoll) is var wait
                             && wait > IncidentManager.Web.BackgroundJobs.IntegritySealHostedService.VerifyPoll)
                        {
                            <tr>
                                <td>Next run</td>
                                <td class="small">
                                    <span class="im-badge im-b-warn">In @wait.TotalMinutes.ToString("N0") minutes</span>
                                    <span class="text-muted ms-2">
                                        The last run was slow, so the check waits longer to keep the database's load down. A
                                        change made outside CaseBook may take that long to be found.
                                    </span>
                                </td>
                            </tr>
                        }
                        <tr>
                            <td>Largest tables</td>
                            <td class="small text-muted">
                                @string.Join(" · ", cycle.RecordsByTable.OrderByDescending(t => t.Value).Take(5).Select(t => $"{t.Key} {t.Value:N0}"))
                            </td>
