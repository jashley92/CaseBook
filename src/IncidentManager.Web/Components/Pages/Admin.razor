    private string ActiveTitle => ActiveSection.Title;
    private string[]? ActiveGroups => ActiveSection.Groups;

    // A one-line orientation on the two read-only System views; the Configuration sections are self-describing.
    private string? ActiveSubtitle => _activeId switch
    {
        "server" => "Managed in server-side configuration and shown read-only; change these on the host.",
        "source" => "Where each setting's effective value resolves from right now.",
        _ => null,
    };

    private const string EmptyDash = "—";

    // The per-severity SLA rows embed the severity's name in their label (e.g. "Containment — Critical
    // (hours)"). Show the org's configured severity label instead, so a renamed level (e.g. Critical → SEV-1)
    // stays consistent here too. Only Sla:{Clock}:{Severity} keys are affected.
    private string DisplayLabel(SettingDefinition def)
    {
        var parts = def.Key.Split(':');
        return parts is ["Sla", _, var sevName] && Enum.TryParse<Severity>(sevName, out var sev)
            ? def.Label.Replace(sev.ToString(), SevLabels.For(sev))
            : def.Label;
    }

    // Server-side keys surfaced in the config-source map (secrets shown as status only).
    private static readonly (string Label, string Key, bool Secret)[] ServerKeys =
    [
        ("Authentication mode", "Auth:Mode", false),
        ("Database provider", "Database:Provider", false),
        ("Database connection", "ConnectionStrings:Default", true),
        ("Evidence store path", "EvidenceStore:RootPath", false),
        ("Report output path", "ReportOutput:RootPath", false),
        ("Seal signing key path", "Integrity:SigningKeyPath", false),
        ("Backup status file", "BackupStatus:FilePath", false),
    ];

    private (string? Value, string Source) OperationalResolution(SettingDefinition def)
    {
        if (def.Kind == SettingKind.MultiText)
        {
            var arr = Config.GetSection(def.Key).Get<string[]>() ?? [];
            // A list binds to indexed children, so resolve the first element's provider for the source.
            var source = arr.Length == 0 ? "Default (unset)" : ConfigSource.Resolve(Config, $"{def.Key}:0").Source;
            return (arr.Length == 0 ? null : string.Join(", ", arr), source);
        }
        var r = ConfigSource.Resolve(Config, def.Key);
        return (r.Value, r.Source);
    }

    private static RenderFragment SourceBadge(string source) => builder =>
