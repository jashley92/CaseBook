@* FR-12: friendly, branded error fallback. UseExceptionHandler re-executes here on an unhandled exception
   (production only; Development still shows the developer page). Matches the SessionExpired / AccessDenied
   quality bar — a short apology, a copyable Request ID for support, and a way back — and it leaks no
   framework internals or exception detail. AllowAnonymous + the chromeless BlankLayout so it always renders
   and reveals nothing sensitive, even if the failure was auth-related. *@
@page "/Error"
@using System.Diagnostics
@layout Layout.BlankLayout
@attribute [AllowAnonymous]

<PageTitle>Something went wrong · CaseBook</PageTitle>

<div class="error-notice">
    <div class="error-notice-card">
        <div class="error-notice-icon" aria-hidden="true"><span class="bi bi-exclamation-triangle-fill"></span></div>
        <h1 class="error-notice-title">Something went wrong</h1>
        <p class="error-notice-text">
            CaseBook couldn't complete your request. Anything you already saved is safe. Try again, and if it
            keeps happening, contact your CaseBook administrator.
        </p>
        @if (ShowRequestId)
        {
            <p class="error-notice-text error-notice-muted">
                Give support this reference:<br />
                <code>@RequestId</code>
            </p>
        }
        <a href="/cases" class="btn btn-primary">Back to cases</a>
    </div>
</div>

@code {
    // The exception handler passes the correlation id here (?ref=…); the cascading HttpContext is a fallback
    // for a direct visit, though it's null under this app's interactive render (hence the query hand-off).
    [SupplyParameterFromQuery(Name = "ref")] public string? Ref { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = !string.IsNullOrWhiteSpace(Ref) ? Ref : (Activity.Current?.Id ?? HttpContext?.TraceIdentifier);
}
