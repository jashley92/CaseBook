@page "/work"
@page "/my"
@* UX-14: this page is the caller's *personal* queue only. Team workload moved out to its own
   Overview-cluster page (/team, ViewAllCases) — it's oversight, not "my" work. *@
@attribute [Authorize(Policy = Policies.ViewCases)]
@inject MyWorkService Svc
@inject IncidentManager.Application.Cases.CaseService Cases
@inject IncidentManager.Application.Cases.CaseShortcutService Shortcuts
@inject IncidentManager.Web.Services.ToastService Toasts
@inject IncidentManager.Application.Abstractions.ICurrentUser CurrentUser
@inject IClock Clock
@inject TimeDisplay TimeDisp
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IAuthorizationService Authz
@inject AuthenticationStateProvider AuthState
@inject ISeverityLabels SevLabels

<PageTitle>My Work</PageTitle>

<div class="mywork">
    <PageHeader Title="My Work">
        <Actions>
            @* UX-06: leadership lands on the dashboard, but may drop into their own queue here; give them
               a one-click way back. Shown only to all-cases roles (the ones who have a dashboard). *@
            @if (_hasDashboard)
            {
                <a class="btn btn-sm btn-outline-secondary" href=""
                   title="Go to the leadership dashboard">
                    <span class="bi bi-speedometer2" aria-hidden="true"></span> Dashboard
                </a>
            }
            <a class="btn btn-sm btn-outline-secondary" href="cases?scope=mine">
                <span class="bi bi-inbox" aria-hidden="true"></span> Full queue
            </a>
        </Actions>
    </PageHeader>

    <div class="tabbody">
        @if (_work is null)
        {
            <span class="visually-hidden" role="status">Loading your work…</span>
            <div class="im-tiles">
                @for (var i = 0; i < 4; i++)
                {
                    <span class="skel" style="height:4.6rem;border-radius:0.7rem"></span>
                }
            </div>
            <div class="mw-grid">
                @for (var i = 0; i < 2; i++)
                {
                    <section class="im-card">
                        <span class="skel skel-line" style="width:40%;display:block;margin-bottom:0.9rem"></span>
                        <SkeletonTable Rows="4" Columns="4" TableClass="table-sm" />
                    </section>
                }
            </div>
        }
        else
        {
            var overdueCount = _work.Tasks.Count(t => IsOverdue(t.DueAtUtc));
            <div class="im-tiles">
                <StatTile Icon="bi-folder2-open" Value="_work.OpenCases.Count" Label="Open cases" Tone="accent" Href="work#cases" />
                <StatTile Icon="bi-list-check" Value="_work.Tasks.Count" Label="Open tasks" Tone="accent" Href="work#tasks" />
                <StatTile Icon="bi-alarm" Value="overdueCount" Label="Overdue"
                          Tone="@(overdueCount > 0 ? "danger" : "ok")" Href="work#tasks" />
                <StatTile Icon="bi-arrow-up-right-circle" Value="_work.RecentEscalations.Count"
                          Label="@($"Escalated ({MyWorkService.EscalationWindowDays}d)")"
                          Tone="@(_work.RecentEscalations.Count > 0 ? "warn" : "accent")" Href="work#escalations" />
            </div>

            <div class="mw-grid">
                @* PROD-20: the cases you pinned for quick access. Only shown when you have some. *@
                @if (_pinned is { Count: > 0 })
                {
                    <section class="im-card" id="pinned">
                        <div class="im-section-head">
                            <span><span class="bi bi-pin-angle-fill" aria-hidden="true"></span> Pinned</span>
                            <span class="im-section-note">@_pinned.Count pinned</span>
                        </div>
                        <table class="table table-sm table-hover align-middle im-table mb-0">
                            <thead>
                                <tr><th>Case #</th><th>Title</th><th>Class.</th><th>Phase</th><th>Sev.</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in _pinned)
                                {
                                    <tr>
                                        <td><code>@c.CaseNumber</code>
                                            @if (c.IsRestricted) { <span class="bi bi-lock-fill text-warning" title="Restricted"></span> }
                                        </td>
                                        <td>@c.Title</td>
                                        <td><span class="@Ui.ClassificationBadge(c.Classification)">@Ui.Label(c.Classification)</span></td>
                                        <td><span class="@Ui.PhaseBadge(c.Phase)">@Ui.Label(c.Phase)</span></td>
                                        <td><span class="@Ui.SeverityBadge(c.Severity)">@SevLabels.For(c.Severity)</span></td>
                                        <td class="text-end text-nowrap">
                                            <button class="btn btn-sm btn-outline-secondary py-0 me-1" title="Unpin this case"
                                                    aria-label="@($"Unpin {c.CaseNumber}")" @onclick="() => Unpin(c.Id)">
                                                <span class="bi bi-pin-angle" aria-hidden="true"></span>
                                            </button>
                                            <a class="btn btn-sm btn-outline-primary py-0" href="cases/@c.Id">Open</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </section>
                }

                <section class="im-card" id="cases">
                    <div class="im-section-head">
                        <span><span class="bi bi-folder2-open" aria-hidden="true"></span> My open cases</span>
                        <span class="im-section-note">@_work.OpenCases.Count open</span>
                    </div>
                    @if (_work.OpenCases.Count == 0)
                    {
                        <div class="mw-empty">Nothing assigned to you right now.
                            <a href="cases">Browse all cases</a>.</div>
                    }
                    else
                    {
                        <div class="mw-phasebar">
                            @foreach (var g in _work.OpenCases.GroupBy(c => c.Phase).OrderBy(g => g.Key))
                            {
                                <a class="mw-chip" href="cases?scope=mine&phase=@g.Key" title="@g.Count() in @Ui.Label(g.Key)">
                                    @Ui.Label(g.Key) <span class="mw-chip-n">@g.Count()</span>
                                </a>
                            }
                        </div>
                        <table class="table table-sm table-hover align-middle im-table mb-0">
                            <thead>
                                <tr><th>Case #</th><th>Title</th><th>Class.</th><th>Phase</th><th>Sev.</th><th>Age</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in _work.OpenCases)
                                {
                                    <tr>
                                        <td><code>@c.CaseNumber</code>
                                            @if (c.IsRestricted) { <span class="bi bi-lock-fill text-warning" title="Restricted"></span> }
                                        </td>
                                        <td>@c.Title
                                            @if (c.LegalReferred) { <span class="im-badge im-b-neutral ms-1">Legal</span> }
                                        </td>
                                        <td><span class="@Ui.ClassificationBadge(c.Classification)">@Ui.Label(c.Classification)</span></td>
                                        <td><span class="@Ui.PhaseBadge(c.Phase)">@Ui.Label(c.Phase)</span></td>
                                        <td><span class="@Ui.SeverityBadge(c.Severity)">@SevLabels.For(c.Severity)</span></td>
                                        <td class="text-muted small">@Ui.Age(c.CreatedAtUtc, Clock.UtcNow)</td>
                                        <td><a class="btn btn-sm btn-outline-primary py-0" href="cases/@c.Id">Open</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>

                <section class="im-card" id="tasks">
                    <div class="im-section-head">
                        <span><span class="bi bi-list-check" aria-hidden="true"></span> My after-action tasks</span>
                        <span class="im-section-note">@_work.Tasks.Count open@(overdueCount > 0 ? $" · {overdueCount} overdue" : "")</span>
                    </div>

                    @* PROD-21: add a follow-up without leaving the page. Owned by you; pick which of your open
                       cases it belongs to. Shown only when you can edit and have an open case to attach it to. *@
                    <AuthorizeView Policy="@Policies.EditCases">
                        @if (_work.OpenCases.Count > 0)
                        {
                            <div class="d-flex flex-wrap align-items-end gap-2 mb-3">
                                <div>
                                    <label class="form-label small mb-0" for="mw-task-title">Quick-add a follow-up</label>
                                    <input id="mw-task-title" class="form-control form-control-sm" style="min-width:15rem"
                                           placeholder="Task title" @bind="_newTaskTitle" @bind:event="oninput" @onkeydown="OnQuickAddKey" />
                                </div>
                                <div>
                                    <label class="form-label small mb-0" for="mw-task-case">On case</label>
                                    <select id="mw-task-case" class="form-select form-select-sm" @bind="_newTaskCaseId">
                                        @foreach (var c in _work.OpenCases)
                                        {
                                            <option value="@c.Id">@c.CaseNumber — @c.Title</option>
                                        }
                                    </select>
                                </div>
                                <button class="btn btn-sm btn-primary" @onclick="AddQuickTask"
                                        disabled="@string.IsNullOrWhiteSpace(_newTaskTitle)" title="Add — Enter">
                                    <span class="bi bi-plus-lg" aria-hidden="true"></span> Add
                                </button>
                            </div>
                        }
                    </AuthorizeView>

                    @if (_work.Tasks.Count == 0)
                    {
                        <div class="mw-empty">No open tasks assigned to you.</div>
                    }
                    else
                    {
                        <table class="table table-sm table-hover align-middle im-table mb-0">
                            <thead>
                                <tr><th>Case #</th><th>Task</th><th>Owner</th><th>Due</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var t in _work.Tasks)
                                {
                                    <tr>
                                        <td><code>@t.CaseNumber</code></td>
                                        <td>@t.Title</td>
                                        <td class="small">
                                            @if (t.OwnedByMe) { <span class="im-badge im-b-info">You</span> }
                                            else { @Users.DisplayFor(t.Owner) }
                                        </td>
                                        <td>@DueBadge(t.DueAtUtc)</td>
                                        <td class="text-end text-nowrap">
                                            @* PROD-21: complete a task in place — no trip into the case's Tasks tab. *@
                                            <AuthorizeView Policy="@Policies.EditCases">
                                                <button class="btn btn-sm btn-outline-success py-0 me-1" @onclick="() => MarkDone(t)"
                                                        title="Mark this task done">
                                                    <span class="bi bi-check2" aria-hidden="true"></span> Done
                                                </button>
                                            </AuthorizeView>
                                            <a class="btn btn-sm btn-outline-primary py-0" href="cases/@t.CaseId?tab=Tasks">Open</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </section>

                <section class="im-card" id="escalations">
                    <div class="im-section-head">
                        <span><span class="bi bi-arrow-up-right-circle" aria-hidden="true"></span> Recently escalated</span>
                        <span class="im-section-note">last @MyWorkService.EscalationWindowDays days</span>
                    </div>
                    @if (_work.RecentEscalations.Count == 0)
                    {
                        <div class="mw-empty">No escalations in the window.</div>
                    }
                    else
                    {
                        <ul class="mw-esc">
                            @foreach (var e in _work.RecentEscalations)
                            {
                                <li>
                                    <a class="mw-esc-case" href="cases/@e.CaseId"><code>@e.CaseNumber</code> @e.Title</a>
                                    <span class="mw-esc-move">
                                        <span class="@Ui.ClassificationBadge(e.From)">@Ui.Label(e.From)</span>
                                        <span class="bi bi-arrow-right" aria-hidden="true"></span>
                                        <span class="@Ui.ClassificationBadge(e.To)">@Ui.Label(e.To)</span>
                                    </span>
                                    <span class="mw-esc-meta text-muted small">@Ui.Age(e.ChangedAtUtc, Clock.UtcNow)</span>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </div>
        }
    </div>
</div>

@code {
    private MyWork? _work;
    private bool _hasDashboard;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _hasDashboard = (await Authz.AuthorizeAsync(auth.User, Policies.ViewAllCases)).Succeeded;
        await Reload();
    }

    // PROD-21: quick-add + inline complete, so a task can be created or closed without opening its case.
    private string _newTaskTitle = "";
    private Guid _newTaskCaseId;

    // PROD-20: the current user's pinned cases.
    private IReadOnlyList<IncidentManager.Application.Cases.CaseListItem>? _pinned;

    private async Task Reload()
    {
        _work = await Svc.GetAsync();
        _pinned = await Shortcuts.PinnedAsync();
        // Default the quick-add case picker to the first open case (and recover if the prior pick closed).
        if (_work.OpenCases.All(c => c.Id != _newTaskCaseId))
            _newTaskCaseId = _work.OpenCases.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private async Task Unpin(Guid caseId)
    {
        try
        {
            await Shortcuts.TogglePinAsync(caseId);
            await Reload();
            Toasts.Info("Unpinned.");
        }
        catch (InvalidOperationException ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task OnQuickAddKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddQuickTask();
    }

    private async Task AddQuickTask()
    {
        var title = _newTaskTitle.Trim();
        if (string.IsNullOrWhiteSpace(title) || _newTaskCaseId == Guid.Empty) return;
        try
        {
            // Owned by me (it's my work); no due date on a quick capture — the case Tasks tab has the full form.
            await Cases.AddActionItemAsync(_newTaskCaseId, title, CurrentUser.UserId, null);
            _newTaskTitle = "";
            Toasts.Success("Task added");
            await Reload();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException
                                   or IncidentManager.Application.Security.ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task MarkDone(MyTask t)
    {
        try
        {
            await Cases.SetActionItemStatusAsync(t.CaseId, t.Id, ActionItemStatus.Done);
            Toasts.Success("Task completed");
            await Reload();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException
                                   or IncidentManager.Application.Security.ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
    }

    private bool IsOverdue(DateTimeOffset? due) => due is { } d && d < Clock.UtcNow;

    /// <summary>Status badge for a task's due date: overdue (red), due-soon (amber), later (plain), or none.</summary>
    private RenderFragment DueBadge(DateTimeOffset? due)
    {
        if (due is not { } d) return @<span class="text-muted small">no due date</span>;

        var span = d - Clock.UtcNow;
        if (span < TimeSpan.Zero)
        {
            var overdue = Clock.UtcNow - d;
            var by = overdue.TotalDays >= 1 ? $"{(int)overdue.TotalDays}d" : $"{Math.Max(1, (int)overdue.TotalHours)}h";
            return @<span class="im-badge im-b-danger" title="Due @TimeDisp.Short(d)">overdue @by</span>;
        }
        if (span.TotalDays < 3)
        {
            var inDays = (int)span.TotalDays;
            var label = inDays >= 1 ? $"in {inDays}d" : $"in {Math.Max(1, (int)span.TotalHours)}h";
            return @<span class="im-badge im-b-warn" title="Due @TimeDisp.Short(d)">due @label</span>;
        }
        return @<span class="small text-muted">@TimeDisp.Short(d)</span>;
    }
}
