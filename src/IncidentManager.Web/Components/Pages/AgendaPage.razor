@page "/program/due"
@* RD-17: Program › Due work: open tasks across the cases you can see, by when they're due, for any owner.
   Your own are on the Desk; your calendar feed is in your notification settings. *@
@attribute [Authorize(Policy = Policies.ViewAllCases)]
@inject AgendaService Svc
@inject IClock Clock
@inject TimeDisplay TimeDisp
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IncidentManager.Application.Abstractions.ICurrentUser Me
@inject IncidentManager.Web.Services.ToastService Toasts
@inject ISeverityLabels SevLabels
@inject NavigationManager Nav

<PageTitle>Due work</PageTitle>

<div class="agenda">
    <PageHeader Title="Program" Subtitle="Open tasks across the team, by when they're due.">
        <Actions>
            <div class="agenda-owner">
                <label class="form-label mb-0 me-1 small text-muted" for="agenda-owner">Owner</label>
                <select id="agenda-owner" class="form-select form-select-sm d-inline-block w-auto"
                        value="@_owner" @onchange="OnOwnerChanged">
                    <option value="">Everyone</option>
                    <option value="@AgendaService.MineOwnerFilter">Me</option>
                    @if (_board is not null)
                    {
                        @foreach (var o in _board.Owners)
                        {
                            <option value="@o.OwnerUserId">@Users.DisplayFor(o.OwnerUserId) (@o.Count)</option>
                        }
                    }
                </select>
            </div>
        </Actions>
    </PageHeader>
    <ProgramNav />

    @if (_board is null)
    {
        <span class="visually-hidden" role="status">Loading the agenda…</span>
        <div class="mw-grid">
            @for (var i = 0; i < 3; i++)
            {
                <section class="im-card">
                    <span class="skel skel-line" style="width:35%;display:block;margin-bottom:0.9rem"></span>
                    <SkeletonTable Rows="3" Columns="5" TableClass="table-sm" />
                </section>
            }
        </div>
    }
    else
    {
        @if (_board.TotalCount == 0)
        {
            <section class="im-card">
                <div class="mw-empty">
                    Nothing due here.
                    @if (!string.IsNullOrEmpty(_owner)) { <text>Try <button class="btn btn-link p-0 align-baseline" @onclick='() => ChangeOwner("")'>everyone</button>.</text> }
                    else { <text>No open tasks have a due date.</text> }
                </div>
            </section>
        }
        else
        {
            @foreach (var bucket in _board.Buckets)
            {
                var meta = Meta(bucket.Kind);
                <section class="im-card">
                    <div class="im-section-head">
                        <span><span class="bi @meta.Icon" aria-hidden="true"></span> @meta.Label</span>
                        <span class="im-badge @meta.Badge">@bucket.Items.Count</span>
                    </div>
                    <table class="table table-sm table-hover align-middle im-table im-list mb-0">
                        <thead>
                            <tr><th>Task</th><th>Case</th><th>Sev.</th><th>Owner</th><th>Due</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var i in Shown(bucket))
                            {
                                <tr>
                                    <td class="im-cell-fill" style="min-width:12rem"><span class="im-ellipsis" title="@i.Title">@i.Title</span></td>
                                    <td style="max-width:18rem">
                                        <code>@i.CaseNumber</code>
                                        <span class="im-ellipsis text-muted small" title="@i.CaseTitle">@i.CaseTitle</span>
                                    </td>
                                    <td><span class="@Ui.SeverityBadge(i.Severity)">@SevLabels.For(i.Severity)</span></td>
                                    <td class="small">
                                        @if (i.OwnedByMe) { <span class="im-badge im-b-info">You</span> }
                                        else if (!string.IsNullOrWhiteSpace(i.OwnerUserId)) { @Users.DisplayFor(i.OwnerUserId) }
                                        else { <span class="text-muted">Unassigned</span> }
                                    </td>
                                    <td>@DueCell(i.DueAtUtc, bucket.Kind)</td>
                                    <td class="text-nowrap">
                                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 me-1 im-peek-open" title="Preview this case"
                                                    aria-label="@($"Preview {i.CaseNumber}")" aria-pressed="@Ui.Aria(_peekId == i.CaseId)" @onclick="() => TogglePeek(i.CaseId)">
                                                <span class="bi bi-layout-sidebar-reverse" aria-hidden="true"></span>
                                            </button>
                                        <a class="btn btn-sm btn-outline-primary py-0" href="cases/@i.CaseId?tab=Tasks">Open</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (bucket.Items.Count > PageRows && !_expanded.Contains(bucket.Kind))
                    {
                        <button type="button" class="btn btn-link btn-sm mt-2 p-0" @onclick="() => _expanded.Add(bucket.Kind)">
                            Show all @bucket.Items.Count
                        </button>
                    }
                </section>
            }
        }

    }
</div>

@if (_peekId is { } peek)
{
    <CasePeek CaseId="peek" Drawer="true" OnClose="() => _peekId = null" />
}

@code {
    // Design review P3: a read-only case preview drawer, so checking a case doesn't mean leaving this page.
    private Guid? _peekId;
    private void TogglePeek(Guid id) => _peekId = _peekId == id ? null : id;

    private AgendaBoard? _board;
    private string _owner = "";      // "" = everyone, "@me" = mine, else a specific owner id

    [SupplyParameterFromQuery(Name = "owner")] private string? OwnerQuery { get; set; }

    // A long bucket (a backlog of overdue tasks) shows its first rows until asked for the rest.
    private const int PageRows = 25;
    private readonly HashSet<AgendaBucketKind> _expanded = [];
    private IEnumerable<AgendaItem> Shown(AgendaBucket b) => _expanded.Contains(b.Kind) ? b.Items : b.Items.Take(PageRows);

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(OwnerQuery)) _owner = OwnerQuery!;
        await Load();
    }

    // Today / this week follow the zone the viewer's timestamps are shown in (UTC, or their local zone), so the
    // groups agree with the times on each row.
    private async Task Load() => _board = await Svc.GetBoardAsync(string.IsNullOrEmpty(_owner) ? null : _owner, TimeDisp.Zone);

    private async Task OnOwnerChanged(ChangeEventArgs e) => await ChangeOwner(e.Value?.ToString() ?? "");

    private async Task ChangeOwner(string owner)
    {
        _owner = owner;
        _board = null;
        _expanded.Clear();
        // Keep the choice in the address so Back, a refresh or a shared link returns to the same view.
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("owner", string.IsNullOrEmpty(owner) ? null : owner), replace: true);
        await Load();
    }

    private sealed record BucketMeta(string Label, string Icon, string Badge);

    private static BucketMeta Meta(AgendaBucketKind kind) => kind switch
    {
        AgendaBucketKind.Overdue => new("Overdue", "bi-alarm", "im-b-danger"),
        AgendaBucketKind.Today => new("Due today", "bi-hourglass-split", "im-b-warn"),
        AgendaBucketKind.ThisWeek => new("Due this week", "bi-calendar-week", "im-b-info"),
        AgendaBucketKind.Later => new("Later", "bi-calendar3", "im-b-neutral"),
        _ => new("No due date", "bi-dash-circle", "im-b-neutral"),
    };

    private RenderFragment DueCell(DateTimeOffset? due, AgendaBucketKind kind)
    {
        if (due is not { } d) return @<span class="text-muted">—</span>;
        if (kind == AgendaBucketKind.Overdue)
        {
            var by = Clock.UtcNow - d;
            var span = by.TotalDays >= 1 ? $"{(int)by.TotalDays}d" : $"{Math.Max(1, (int)by.TotalHours)}h";
            return @<span class="im-badge im-b-danger" title="Due @TimeDisp.Short(d)">overdue @span</span>;
        }
        return @<span class="small">@TimeDisp.Short(d)</span>;
    }
}
