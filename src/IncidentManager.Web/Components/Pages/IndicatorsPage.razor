@page "/intel/indicators"
@attribute [Authorize(Policy = Policies.ViewCases)]
@* PROD-10: the cross-case indicator pivot. Every IOC/entity analysts have recorded, deduped by type + value
   across the cases the viewer can see, most-shared first — "this indicator appears in N cases" as a first-class
   surface instead of a badge buried inside one case. Read-only: entities are edited on their case's IOCs tab.
   A case's IOC table links here by entity id (?entity=…) so the indicator value never rides in a URL. *@
@using IncidentManager.Application.Intel
@using IncidentManager.Domain.Common
@using IncidentManager.Domain.Observables
@inject IndicatorService Indicators
@inject TimeDisplay TimeDisp
@inject IncidentManager.Application.Abstractions.ICurrentUser CurrentUser
@inject IncidentManager.Web.Services.ExportSearchRefs SearchRefs
@implements IDisposable

<PageTitle>Indicators</PageTitle>

<PageHeader Title="Intel"
            Subtitle="Indicators from all your cases, deduplicated so repeat IPs, domains and hashes stand out." />
<IntelNav />

@if (_library is null)
{
    <span class="visually-hidden" role="status">Loading indicators…</span>
    <section class="im-card"><SkeletonTable Rows="5" Columns="5" TableClass="table-sm" /></section>
    return;
}

<div class="im-tiles mb-3">
    <StatTile Icon="bi-crosshair" Value="_library.Summary.Indicators" Label="Indicators" Tone="accent" />
    <StatTile Icon="bi-intersect" Value="_library.Summary.Shared" Label="Seen in 2+ cases"
              Tone="@(_library.Summary.Shared > 0 ? "warn" : "neutral")" />
    <StatTile Icon="bi-bug" Value="_library.Summary.Malicious" Label="Malicious" Tone="danger" />
    <StatTile Icon="bi-folder2-open" Value="_library.Summary.InOpenCases" Label="In open cases" Tone="neutral" />
</div>

<section class="im-card">
    <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
        <div style="min-width:16rem">
            <label class="form-label small mb-0" for="ind-search">Search</label>
            <input id="ind-search" class="form-control form-control-sm" placeholder="IP, domain, URL, hash… (defanged is fine)"
                   value="@_search" @oninput="OnSearch" />
        </div>
        <div>
            <label class="form-label small mb-0" for="ind-type">Type</label>
            <select id="ind-type" class="form-select form-select-sm" value="@_typeKey" @onchange="OnTypeChanged">
                <option value="ioc">Indicators (IP, domain, URL, hash)</option>
                <option value="all">All entity types</option>
                @foreach (var t in Enum.GetValues<EntityType>())
                {
                    <option value="@t">@Ui.Label(t)</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label small mb-0" for="ind-verdict">Worst verdict</label>
            <select id="ind-verdict" class="form-select form-select-sm" value="@(_disposition?.ToString() ?? "")" @onchange="OnVerdictChanged">
                <option value="">Any</option>
                @foreach (var d in Enum.GetValues<EntityDisposition>().OrderByDescending(IndicatorService.Severity))
                {
                    <option value="@d">@Ui.Label(d)</option>
                }
            </select>
        </div>
        <div class="form-check mb-1">
            <input class="form-check-input" type="checkbox" id="ind-shared" checked="@_sharedOnly" @onchange="OnSharedChanged" />
            <label class="form-check-label small" for="ind-shared">Seen in 2+ cases only</label>
        </div>
        <div class="form-check mb-1">
            <input class="form-check-input" type="checkbox" id="ind-exercises" checked="@_includeExercises" @onchange="OnExercisesChanged" />
            <label class="form-check-label small" for="ind-exercises">Include exercise cases</label>
        </div>
        <div class="ms-auto d-flex flex-wrap align-items-end gap-2">
            <span class="seg" role="radiogroup" aria-label="Indicator display"
                  title="Defanged shows addresses and URLs as hxxp://evil[.]com, safe to copy out">
                <button type="button" class="seg-opt @(!_defang ? "on" : "")" role="radio" aria-checked="@Ui.Aria(!_defang)"
                        @onclick="() => _defang = false">Live</button>
                <button type="button" class="seg-opt @(_defang ? "on" : "")" role="radio" aria-checked="@Ui.Aria(_defang)"
                        @onclick="() => _defang = true">Defanged</button>
            </span>
            @* CAP-27: every indicator these filters match (not only this page), whatever the verdict, with its cases. *@
            <a class="btn btn-sm btn-outline-secondary text-nowrap" href="@_exportHref" download
               title="Every indicator these filters match, not only this page, as CSV with each one's verdicts and cases"
               aria-label="Export the indicators these filters match as CSV">
                <span class="bi bi-download me-1" aria-hidden="true"></span>Export these
            </a>
            @* UX-59: Exports is the home for the standing exports; a screen offers only "Export these", what its filters hold. *@
        </div>
    </div>

    @if (_library.Rows.Count > 0 || _library.HasPrevious)
    {
        @* CAP-27: pages from the server, by the row the page shown starts or ends at (keyset), not by page number. *@
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
            <span class="small text-muted" aria-live="polite">@IndicatorQuery.PageRange(_library)@(Filtered ? " (filtered)" : "")</span>
            @if (_library.HasPrevious || _library.HasNext)
            {
                <span class="btn-group btn-group-sm" role="group" aria-label="Pages of indicators">
                    <button type="button" class="btn btn-outline-secondary" disabled="@(!_library.HasPrevious)" @onclick="Previous">
                        <span class="bi bi-chevron-left" aria-hidden="true"></span> Previous
                    </button>
                    <button type="button" class="btn btn-outline-secondary" disabled="@(!_library.HasNext || _library.Rows.Count == 0)" @onclick="Next">
                        Next <span class="bi bi-chevron-right" aria-hidden="true"></span>
                    </button>
                </span>
            }
        </div>
    }

    @if (_library.Rows.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-state-icon"><span class="bi bi-crosshair" aria-hidden="true"></span></div>
            <div class="empty-state-title">@(_library.HasPrevious ? "No more indicators" : Filtered ? "No indicators match" : "No indicators yet")</div>
            <div class="empty-state-msg">
                @if (_library.HasPrevious)
                {
                    <text>The indicators after the last page you saw have changed. Go back to the previous page.</text>
                }
                else if (Filtered)
                {
                    <text>Try a shorter search, another type, or clear the filters.</text>
                }
                else
                {
                    <text>Indicators appear here as analysts add them on a case's <em>IOCs &amp; entities</em> tab.</text>
                }
            </div>
        </div>
    }
    else
    {
        <table class="table table-sm align-middle im-table im-list mb-0">
            <thead>
                <tr><th>Indicator</th><th>Worst verdict</th><th>Cases</th><th>First seen</th><th>Last seen</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var r in _library.Rows)
                {
                    var key = RowKey(r);
                    var open = _expanded.Contains(key);
                    <tr @key="key">
                        <td class="im-wrap">
                            <span class="text-nowrap small text-muted me-1">@Ui.EntityGlyph(r.Type) @Ui.Label(r.Type)</span>
                            <code class="small text-break">@Display(r)</code>
                        </td>
                        <td><span class="@Ui.DispositionBadge(r.WorstDisposition)">@Ui.Label(r.WorstDisposition)</span></td>
                        <td class="text-nowrap">
                            <span class="im-badge @(r.CaseCount > 1 ? "im-b-warn" : "im-b-neutral")">@r.CaseCount</span>
                            @if (r.OpenCaseCount > 0) { <span class="small text-muted ms-1">@r.OpenCaseCount open</span> }
                        </td>
                        <td class="small im-data text-nowrap">@TimeDisp.DateOnly(r.FirstSeenUtc)</td>
                        <td class="small im-data text-nowrap">@TimeDisp.DateOnly(r.LastSeenUtc)</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Toggle(key)"
                                    aria-expanded="@(open ? "true" : "false")" title="Show the cases this indicator appears on">
                                <span class="bi @(open ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></span> Cases
                            </button>
                        </td>
                    </tr>
                    @if (open)
                    {
                        <tr class="im-custody-row">
                            <td colspan="6" class="bg-body-tertiary">
                                <table class="table table-sm mb-0 im-table">
                                    <thead><tr><th>Case</th><th>Classification</th><th>Phase</th><th>Verdict on this case</th><th>Added</th></tr></thead>
                                    <tbody>
                                        @foreach (var c in _allCases.Contains(key) ? r.Cases : r.Cases.Take(CasesShown))
                                        {
                                            <tr>
                                                <td>
                                                    <a href="@($"cases/{c.CaseId}?tab=Entities")"><code class="small">@c.CaseNumber</code></a>
                                                    @if (c.IsExercise) { <span class="im-badge im-b-neutral ms-1">Exercise</span> }
                                                    <div class="small text-muted text-truncate" style="max-width:22rem" title="@c.Title">@c.Title</div>
                                                </td>
                                                <td><span class="@Ui.ClassificationBadge(c.Classification)">@Ui.Label(c.Classification)</span></td>
                                                <td><span class="@Ui.PhaseBadge(c.Phase)">@Ui.Label(c.Phase)</span></td>
                                                <td><span class="@Ui.DispositionBadge(c.Disposition)">@Ui.Label(c.Disposition)</span></td>
                                                <td class="small im-data text-nowrap">@TimeDisp.DateOnly(c.AddedAtUtc)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                @if (r.Cases.Count > CasesShown && !_allCases.Contains(key))
                                {
                                    @* A widespread indicator can sit on hundreds of cases: show the first few, the rest on request.
                                       In place rather than a link, so the indicator value never rides in a URL (PROD-10). *@
                                    <button type="button" class="btn btn-link btn-sm p-0 mt-1" @onclick="() => _allCases.Add(key)">
                                        Show all @r.Cases.Count cases
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    }
</section>

@code {
    /// <summary>Pivot from a case's IOC table: the entity id is resolved server-side (need-to-know scoped).</summary>
    [SupplyParameterFromQuery(Name = "entity")] public string? EntityIdRaw { get; set; }
    private Guid? EntityId => QueryValue.Id(EntityIdRaw);   // BUG-31: a bad value is ignored, not an error

    private IndicatorLibrary? _library;
    private string _search = "";
    private string _typeKey = "ioc";
    private EntityDisposition? _disposition;
    private bool _sharedOnly;
    private bool _includeExercises;
    private bool _defang;
    private readonly HashSet<string> _expanded = new();
    private readonly HashSet<string> _allCases = new();
    private CancellationTokenSource? _searchDebounce;

    private bool Filtered => _search.Length > 0 || _typeKey != "ioc" || _disposition is not null || _sharedOnly;

    /// <summary>WF-91: "Across cases" from Find for an entity on an exercise opens with exercises included.</summary>
    [SupplyParameterFromQuery(Name = "exercises")] public string? ExercisesRaw { get; set; }

    // BUG-343: the query as last applied. A pivot to this page while it is open (the palette, a case's IOC link) only
    // sets parameters, so it is read here rather than once on first load; the page's own filter edits leave it alone.
    private bool _queryRead;
    private string? _lastEntityRaw, _lastExercisesRaw;
    private int _loadSeq;   // the newest load wins: a pivot can overtake a filter change still loading

    protected override async Task OnParametersSetAsync()
    {
        if (_queryRead && EntityIdRaw == _lastEntityRaw && ExercisesRaw == _lastExercisesRaw) return;
        var pivot = _queryRead;
        _queryRead = true;
        _lastEntityRaw = EntityIdRaw;
        _lastExercisesRaw = ExercisesRaw;
        if (pivot)
        {
            // A new pivot starts from the default filters, as a first load does, and drops the old rows' expansion.
            if (_searchDebounce is not null) await _searchDebounce.CancelAsync();
            _search = "";
            _typeKey = "ioc";
            _disposition = null;
            _sharedOnly = false;
            _expanded.Clear();
            _allCases.Clear();
        }
        _includeExercises = QueryValue.Flag(ExercisesRaw);
        var (raw, rawEx) = (EntityIdRaw, ExercisesRaw);
        if (EntityId is { } id && await Indicators.ResolveEntityAsync(id) is { } hit)
        {
            if (raw != _lastEntityRaw || rawEx != _lastExercisesRaw) return;   // a newer pivot took over
            _search = hit.Value;
            _typeKey = hit.Type.ToString();
        }
        _at = IndicatorPageAt.First;
        await Load();
        if (raw != _lastEntityRaw || rawEx != _lastExercisesRaw) return;
        // A pivot lands on one indicator: open its case list straight away.
        if (EntityId is not null && _library is { Rows.Count: 1 }) _expanded.Add(RowKey(_library.Rows[0]));
    }

    // CAP-27: the page by where it starts or ends in the library (keyset), as the Integrity page's audit trail is paged. A
    // filter change, a search or a pivot starts again from the first page.
    private IndicatorPageAt _at = IndicatorPageAt.First;
    private string _exportHref = "export/indicators.csv";
    private bool _disposed;

    private async Task Load(CancellationToken ct = default)
    {
        var seq = ++_loadSeq;
        // CAP-27 (C2): the filter through the function the export reads its link with.
        var filter = IndicatorQuery.Filter(_search, _typeKey, _disposition, _sharedOnly, _includeExercises);
        var library = await Indicators.SearchAsync(filter, _at, IndicatorService.PageSize, ct);
        if (seq != _loadSeq || _disposed) return;
        _library = library;
        if (!library.HasPrevious) _at = IndicatorPageAt.First;   // a Previous that reached the start is the first page
        // BUG-388: the link describes the rows shown. The search is held for this person, never put in the link (C7).
        _exportHref = IndicatorQuery.ExportHref(filter,
            string.IsNullOrWhiteSpace(_search) ? null : SearchRefs.Hold(CurrentUser.UserId, _search));
    }

    private async Task Next()
    {
        if (_library is not { Rows.Count: > 0 } lib) return;
        _at = IndicatorPageAt.Next(lib.Rows[^1], lib.Rows[0]);   // B4 review: and where the page left starts, for Previous
        await Load();
    }

    private async Task Previous()
    {
        if (_library is null) return;
        // An empty page past the end (the rows after it changed) goes back to the page Next left, from its first row.
        _at = _at.PreviousFrom(_library.Rows);
        await Load();
    }

    private const int CasesShown = 10;

    private static string RowKey(IndicatorRow r) => $"{r.Type}|{r.Value.ToLowerInvariant()}";

    private void Toggle(string key)
    {
        if (!_expanded.Add(key)) _expanded.Remove(key);
    }

    private string Display(IndicatorRow r) =>
        _defang && IocObservable.IsRefangable(r.Type) ? IocObservable.Defang(r.Value) : r.Value;

    // CAP-27: a changed filter lists from its first page.
    private Task Reload(CancellationToken ct = default)
    {
        _at = IndicatorPageAt.First;
        return Load(ct);
    }

    private async Task OnTypeChanged(ChangeEventArgs e) { _typeKey = e.Value?.ToString() ?? "ioc"; await Reload(); }

    private async Task OnVerdictChanged(ChangeEventArgs e)
    {
        _disposition = EnumNames.OrNull<EntityDisposition>(e.Value?.ToString());
        await Reload();
    }

    private async Task OnSharedChanged(ChangeEventArgs e) { _sharedOnly = e.Value is true; await Reload(); }

    private async Task OnExercisesChanged(ChangeEventArgs e) { _includeExercises = e.Value is true; await Reload(); }

    // Debounced so typing doesn't re-query on every keystroke.
    private async Task OnSearch(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        if (_searchDebounce is not null) await _searchDebounce.CancelAsync();
        _searchDebounce?.Dispose();
        _searchDebounce = new CancellationTokenSource();
        var token = _searchDebounce.Token;
        // BUG-253: the token goes to the search too, so a query a newer keystroke superseded stops instead of running on.
        try
        {
            await Task.Delay(250, token);
            await Reload(token);
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _disposed = true;
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
    }
}
