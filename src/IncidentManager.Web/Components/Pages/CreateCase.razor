@page "/cases/new"
@attribute [Authorize(Policy = Policies.EditCases)]
@using IncidentManager.Application.Admin
@inject CaseService Cases
@inject CaseTemplateService Templates
@inject NavigationManager Nav
@inject IConfiguration Config
@inject ISeverityLabels SevLabels
@inject TimeDisplay TimeDisp

<PageTitle>New Case</PageTitle>

<PageHeader Title="New case"
           Subtitle="File a new security matter — set its classification (Adverse Event, Incident, or Breach), or choose Complex Event to capture and triage it before classifying." />

<EditForm Model="_request" OnValidSubmit="Submit" FormName="createCase">
    <div class="nc-form">
        @* Optional quick-start from a curated playbook. *@
        @if (_templates is { Count: > 0 })
        {
            <div class="nc-template">
                <span class="bi bi-clipboard-check nc-template-ic" aria-hidden="true"></span>
                <div class="nc-template-body">
                    <label class="form-label small mb-1">Start from a template <span class="text-muted">(optional)</span></label>
                    <select class="form-select form-select-sm" @onchange="OnTemplateChanged" value="@(_selectedTemplate?.Id.ToString() ?? "")">
                        <option value="">No template</option>
                        @foreach (var t in _templates)
                        {
                            <option value="@t.Id">@t.Name@(t.Steps.Count > 0 ? $" ({t.Steps.Count} steps)" : "")</option>
                        }
                    </select>
                    @if (_selectedTemplate is not null)
                    {
                        <div class="small text-muted mt-1">
                            @_selectedTemplate.Description@if (_selectedTemplate.Steps.Count > 0) { <text> · @_selectedTemplate.Steps.Count action item(s) added on create.</text> }
                        </div>
                    }
                </div>
            </div>
        }

        @* Case details *@
        <div class="im-card nc-card">
            <div class="mb-3">
                <label class="form-label">Title <span class="text-danger">*</span></label>
                <InputText class="form-control form-control-lg" @bind-Value="_request.Title" @bind-Value:after="SyncSlug"
                           placeholder="e.g. Credential-phishing wave targeting Finance" />
                <div class="form-text">Case number <code>@PreviewNumber</code> is assigned automatically.</div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Classification</label>
                    <InputSelect class="form-select" @bind-Value="_request.Classification">
                        <option value="">Complex Event</option>
                        @foreach (var c in Enum.GetValues<Classification>())
                        {
                            <option value="@c">@Ui.Label(c)</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Severity</label>
                    <InputSelect class="form-select" @bind-Value="_request.Severity">
                        @foreach (var s in Enum.GetValues<Severity>())
                        {
                            <option value="@s">@SevLabels.For(s)</option>
                        }
                    </InputSelect>
                    <div class="form-text">Sets the response-time SLA clock — confirm it matches the matter's impact (defaults to @SevLabels.For(Severity.Medium)).</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Origin</label>
                    <InputSelect class="form-select" @bind-Value="_request.Origin">
                        <option value="@CaseOrigin.InternalDetection">Internal detection</option>
                        <option value="@CaseOrigin.ThirdParty">Third-party / vendor</option>
                    </InputSelect>
                </div>

                @if (_request.Origin == CaseOrigin.ThirdParty)
                {
                    <div class="col-md-4">
                        <label class="form-label">Vendor name <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_request.VendorName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Vendor contact</label>
                        <InputText class="form-control" @bind-Value="_request.VendorContact" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Vendor reference</label>
                        <InputText class="form-control" @bind-Value="_request.VendorReference" />
                    </div>
                }

                @* FR-03: capture the real detection time at intake — it anchors the response-SLA clock and
                   the dwell metric. Defaults to now (in the viewer's display zone); set it back to when the
                   matter was actually detected, not when the case is being filed. *@
                <div class="col-md-4">
                    <label class="form-label">Detected (@TimeDisp.Label) <span class="text-danger">*</span></label>
                    <input type="datetime-local" class="form-control" @bind="_detectedWall"
                           title="When the matter was first detected or reported. Drives the response-SLA clock and dwell metrics. Set it to the real detection time, not when the case was filed. Entered in @TimeDisp.Label." />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Initial activity <span class="text-muted">(optional)</span></label>
                    <input type="datetime-local" class="form-control" @bind="_occurredWall"
                           title="When adversary activity actually began (initial access / first malicious activity), if known. Detected minus this is the dwell time. Entered in @TimeDisp.Label." />
                </div>

                <div class="col-md-6">
                    <label class="form-label">@DetectionLabel Case ID <span class="text-muted">(optional)</span></label>
                    <InputText class="form-control" @bind-Value="_request.DetectionCaseId" placeholder="@($"e.g. {DetectionLabel}-40122")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Data types involved</label>
                    <InputText class="form-control" @bind-Value="_request.DataTypesInvolved" placeholder="@(_dataTypesPrompt ?? "e.g. PII, PHI, credentials")" />
                </div>

                <div class="col-12">
                    <label class="form-label">Summary</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_request.Summary"
                                   placeholder="@(_summaryPrompt ?? "What happened, current status, and immediate impact.")" />
                </div>
            </div>

            @* Power-user override of the auto-assigned number; hidden by default. *@
            <details class="nc-advanced">
                <summary>Advanced</summary>
                <div class="mt-2 nc-advanced-body">
                    <label class="form-label">Case number <span class="text-muted">(optional)</span></label>
                    <InputText class="form-control" @bind-Value="_request.CaseNumber" placeholder="@PreviewNumber" />
                    <div class="form-text">Leave blank to auto-generate. Must be unique.</div>
                </div>
            </details>
        </div>

        @* Indicators + duplicate / campaign detection (E-23) *@
        <div class="im-card nc-card">
            <label class="form-label">Indicators / IOCs <span class="text-muted">(optional, one per line)</span></label>
            <textarea class="form-control" rows="3" @bind="_indicators" @bind:event="oninput" @bind:after="OnIndicatorsChanged"
                      placeholder="One indicator per line, e.g. 1.2.3.4, evil.example.com, hxxp://bad[.]site/x, or a file hash"
                      @onblur="CheckOverlaps"></textarea>
            <div class="form-text">
                Checked against open cases for duplicates, and added as entities on create (defanged notation is refanged; types auto-detected).
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="CheckOverlaps" disabled="@_checking">Check now</button>
            </div>

            @if (_checking)
            {
                <div class="mt-2"><span class="spinner-border spinner-border-sm text-muted" role="status"></span> <span class="text-muted small">Checking open cases…</span></div>
            }
            else if (ShowNoMatches)
            {
                <div class="alert alert-success py-2 mt-2 mb-0">
                    <span class="bi bi-check2-circle me-1" aria-hidden="true"></span>
                    No open cases reference these indicators. This looks like a new matter.
                </div>
            }
            else if (_matches.Count > 0)
            {
                <div class="alert alert-warning mt-2 mb-0">
                    <div class="fw-semibold mb-2">
                        <span class="bi bi-diagram-3 me-1" aria-hidden="true"></span>
                        @_matches.Count open case(s) already reference these indicators. Relate one to avoid fragmenting a campaign:
                    </div>
                    @foreach (var m in _matches)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2 pb-2 border-bottom">
                            <a href="cases/@m.CaseId" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                <code>@m.CaseNumber</code> @m.Title
                            </a>
                            <span class="@Ui.PhaseBadge(m.Phase)">@Ui.Label(m.Phase)</span>
                            <span class="small text-muted">shared: @string.Join(", ", m.Indicators)</span>
                            <div class="ms-auto">
                                <select class="form-select form-select-sm d-inline-block w-auto"
                                        @onchange="e => SetLink(m.CaseId, e.Value?.ToString())">
                                    <option value="">Don't link</option>
                                    <option value="@CaseLinkType.RelatedTo">Related to</option>
                                    <option value="@CaseLinkType.DuplicateOf">Duplicate of</option>
                                    <option value="@CaseLinkType.PartOfCampaign">Part of campaign</option>
                                </select>
                            </div>
                        </div>
                    }
                    <div class="small text-muted">Relationships are applied when you create the case; filing is never blocked.</div>
                </div>
            }
        </div>

        @* FR-04: the check ran on Create and surfaced related cases the analyst hadn't seen — pause once so
           they can relate one above, then Create again to file (or file as-is). *@
        @if (_overlapPrompt)
        {
            <div class="alert alert-warning mb-0">
                <span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>
                Open case(s) already reference these indicators (see above). Relate one to avoid fragmenting a
                campaign, then click <strong>Create case</strong> again — or click again to file as a separate matter.
            </div>
        }

        @if (_error is not null)
        {
            <div class="alert alert-danger mb-0">@_error</div>
        }

        <div class="nc-actions">
            <button type="submit" class="btn btn-primary" disabled="@(_saving || _checking)">Create case</button>
            <a class="btn btn-outline-secondary" href="cases">Cancel</a>
        </div>
    </div>
</EditForm>

@code {
    private readonly CreateCaseRequest _request = new();
    private bool _saving;
    private string? _error;

    // FR-03: intake detection/dwell timestamps entered as wall-clock in the viewer's display zone (U-29),
    // converted to UTC on submit. Detected defaults to now; initial-activity is optional.
    private DateTime? _detectedWall;
    private DateTime? _occurredWall;

    private List<TemplateView>? _templates;
    private TemplateView? _selectedTemplate;

    // E-23: creation-time IOC entry + duplicate/related-case detection.
    private string? _indicators;
    private List<CaseIocMatch> _matches = new();
    private bool _checking;
    private string? _checkedInput; // the indicator text last checked — so "no matches" feedback clears once it's edited
    private readonly Dictionary<Guid, CaseLinkType?> _linkChoice = new();
    // FR-04: set when Create ran the overlap check itself and found matches the analyst hadn't seen — the first
    // Create pauses on it so the check can't be skipped; a second Create then files.
    private bool _overlapPrompt;

    private static IEnumerable<string> IndicatorLines(string? raw) =>
        (raw ?? "").Replace("\r", "").Split('\n').Select(l => l.Trim()).Where(l => l.Length > 0);

    // Show the "no matches" note only after a check whose input still matches what's in the box.
    private bool ShowNoMatches =>
        !_checking && _matches.Count == 0 && _checkedInput == _indicators && IndicatorLines(_indicators).Any();

    private void SetLink(Guid caseId, string? raw)
        => _linkChoice[caseId] = Enum.TryParse<CaseLinkType>(raw, out var t) ? t : (CaseLinkType?)null;

    // FR-04: any edit or re-check clears the "paused for review" state so a stale prompt never lingers.
    private void OnIndicatorsChanged() => _overlapPrompt = false;

    private async Task CheckOverlaps()
    {
        _overlapPrompt = false;
        var lines = IndicatorLines(_indicators).ToList();
        _checkedInput = _indicators;
        if (lines.Count == 0) { _matches = new(); return; }
        _checking = true;
        try { _matches = (await Cases.FindOpenCaseMatchesForIocsAsync(lines)).ToList(); }
        finally { _checking = false; }
        // Drop choices for cases that are no longer matched (indicators edited).
        foreach (var id in _linkChoice.Keys.Where(k => _matches.All(m => m.CaseId != k)).ToList())
            _linkChoice.Remove(id);
    }

    protected override async Task OnInitializedAsync()
    {
        _templates = await Templates.ListActiveAsync();
        // FR-03: default Detected to now in the viewer's display zone. If the display zone resolves after
        // first render (U-29 reconfigures TimeDisp, remounting this page via the layout @key), this re-seeds
        // with the correct zone — the user hasn't interacted yet at that point.
        _detectedWall = UtcToWall(DateTimeOffset.UtcNow);
    }

    // Wall-clock ⇄ UTC in the viewer's active display zone (U-29), matching the Overview details editor.
    private DateTimeOffset WallToUtc(DateTime wall)
    {
        var unspecified = DateTime.SpecifyKind(wall, DateTimeKind.Unspecified);
        try { return new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(unspecified, TimeDisp.Zone), TimeSpan.Zero); }
        catch { return new DateTimeOffset(DateTime.SpecifyKind(unspecified, DateTimeKind.Utc), TimeSpan.Zero); } // DST-invalid wall time: treat as UTC
    }

    private DateTime UtcToWall(DateTimeOffset utc)
        => DateTime.SpecifyKind(TimeZoneInfo.ConvertTime(utc, TimeDisp.Zone).DateTime, DateTimeKind.Unspecified);

    private void OnTemplateChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _selectedTemplate = Guid.TryParse(raw, out var id) ? _templates?.FirstOrDefault(t => t.Id == id) : null;
        if (_selectedTemplate is null) return;

        // Quick-fill the structured field defaults (classification/severity) — these are safe to pre-set.
        if (_selectedTemplate.DefaultClassification is { } c) _request.Classification = c;
        if (_selectedTemplate.DefaultSeverity is { } s) _request.Severity = s;

        // U-47b: the free-text defaults become *placeholder prompts*, not pre-filled values, so a template's
        // generic wording can never be filed verbatim — the analyst must write the real summary/data types.
        _dataTypesPrompt = string.IsNullOrWhiteSpace(_selectedTemplate.DefaultDataTypes) ? null : _selectedTemplate.DefaultDataTypes;
        _summaryPrompt = string.IsNullOrWhiteSpace(_selectedTemplate.SummaryBoilerplate) ? null : _selectedTemplate.SummaryBoilerplate;
    }

    // U-47b: template-supplied prompts shown as ghost text (watermarks) on the free-text fields.
    private string? _summaryPrompt;
    private string? _dataTypesPrompt;

    // U-42: one Title field drives the case-number slug. Keep the (validator-required) DescriptiveName in
    // sync with a compacted slug source so the auto number stays short instead of echoing the full title.
    private void SyncSlug() => _request.DescriptiveName = SlugSource(_request.Title);

    private static string SlugSource(string? title)
    {
        var t = (title ?? "").Trim();
        if (t.Length == 0) return "";
        var s = string.Join(' ', t.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(6));
        return s.Length <= 42 ? s : s[..42].TrimEnd();
    }

    // Reflects the scheme the auto-number would use. The per-year sequence is only known at save time, so
    // show a neutral NN placeholder rather than implying a specific number (U-43). Complex Event numbers are
    // date-based, so their preview is exact.
    private string PreviewNumber
    {
        get
        {
            var now = DateTimeOffset.UtcNow;
            var slug = Case.Slug(SlugSource(_request.Title));
            return _request.Classification is null
                ? Case.FormatComplexEventNumber(now, slug)
                : $"{now.Year}-NN_{slug}";
        }
    }

    /// <summary>Configurable display label for the detection source; defaults to "SIEM".</summary>
    private string DetectionLabel
    {
        get
        {
            var label = Config["ExternalLinks:DetectionSourceLabel"];
            return string.IsNullOrWhiteSpace(label) ? "SIEM" : label;
        }
    }

    private async Task Submit()
    {
        _error = null;

        // FR-04: the duplicate/campaign check must not be skippable. If indicators were entered but the check
        // is stale (typed then clicked Create without ever blurring / checking), run it now; if it surfaces
        // open cases sharing these indicators for the first time, pause once so the analyst can relate one —
        // then a second Create files. Filing is never blocked; this only guarantees the check is seen.
        var lines = IndicatorLines(_indicators).ToList();
        if (lines.Count > 0 && _checkedInput != _indicators)
        {
            await CheckOverlaps();
            if (_matches.Count > 0)
            {
                _overlapPrompt = true;
                return;
            }
        }

        _saving = true;
        _overlapPrompt = false;
        try
        {
            // FR-03: fold the intake timestamps (entered as wall-clock) into the request as UTC.
            _request.DetectedAtUtc = _detectedWall is { } dw ? WallToUtc(dw) : null;
            _request.OccurredAtUtc = _occurredWall is { } ow ? WallToUtc(ow) : null;
            var created = await Cases.CreateAsync(_request);
            // E-23: seed entered indicators as entities (best-effort typed; correctable on the Entities tab).
            foreach (var raw in IndicatorLines(_indicators))
                await Cases.AddEntityAsync(created.Id, IocObservable.DetectType(raw), raw, null,
                    EntityDisposition.Unknown, null, "Filed at case creation");
            // Apply the analyst's chosen relationships to the matched open cases (E-14).
            foreach (var (relatedCaseId, choice) in _linkChoice)
                if (choice is { } type)
                    await Cases.LinkCaseAsync(created.Id, relatedCaseId, type, "Linked at case creation (shared indicator)");
            // Seed the template's playbook steps as action items on the fresh case.
            if (_selectedTemplate is { Steps.Count: > 0 })
                await Cases.ApplyTemplateAsync(created.Id, _selectedTemplate.Id);
            Nav.NavigateTo($"cases/{created.Id}");
        }
        catch (FluentValidation.ValidationException ex)
        {
            _error = string.Join(" ", ex.Errors.Select(e => e.ErrorMessage));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
