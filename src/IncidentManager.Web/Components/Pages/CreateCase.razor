@page "/cases/new"
@attribute [Authorize(Policy = Policies.EditCases)]
@using IncidentManager.Application.Admin
@using Microsoft.Extensions.Logging
@implements IDisposable
@inject CaseService Cases
@inject ILogger<CreateCase> Logger
@inject CaseTemplateService Templates
@inject IncidentManager.Application.Admin.CaseOutcomeService Outcomes
@inject IncidentManager.Application.Admin.TeamService TeamsSvc
@inject NavigationManager Nav
@inject IConfiguration Config
@inject ISeverityLabels SevLabels
@inject TimeDisplay TimeDisp
@inject IJSRuntime JS
@inject ICurrentUser CurrentUser
@inject IOrganizationTimeZone OrgZone
@inject IClock Clock
@inject CaseListMemory ListMemory

<PageTitle>New case</PageTitle>

<PageHeader Title="New case"
           Subtitle="Pick Adverse Event, Incident or Breach, or file as a Complex Event and classify after triage." />

<EditForm Model="_request" OnValidSubmit="Submit" FormName="createCase">
    <div class="nc-form">
        @* Optional quick-start from a curated playbook. *@
        @if (_templates is { Count: > 0 })
        {
            <div class="nc-template">
                <span class="bi bi-clipboard-check nc-template-ic" aria-hidden="true"></span>
                <div class="nc-template-body">
                    <label class="form-label small mb-1" for="nc-template">Start from a template <span class="text-muted">(optional)</span></label>
                    <select id="nc-template" class="form-select form-select-sm" @onchange="OnTemplateChanged" value="@(_selectedTemplate?.Id.ToString() ?? "")">
                        <option value="">No template</option>
                        @foreach (var t in _templates)
                        {
                            <option value="@t.Id">@t.Name@(t.Steps.Count > 0 ? $" ({t.Steps.Count} steps)" : "")</option>
                        }
                    </select>
                    @if (_selectedTemplate is not null)
                    {
                        <div class="small text-muted mt-1">
                            @_selectedTemplate.Description@if (_selectedTemplate.Steps.Count > 0) { <text> · Adds @_selectedTemplate.Steps.Count task@(_selectedTemplate.Steps.Count == 1 ? "" : "s") to the case.</text> }
                        </div>
                    }
                </div>
            </div>
        }

        @* Case details *@
        <div class="im-card nc-card">
            <div class="mb-3">
                <label class="form-label" for="cc-title">Title <span class="text-danger">*</span></label>
                <InputText id="cc-title" class="@($"form-control form-control-lg {Invalid("cc-title")}")" @bind-Value="_request.Title" @bind-Value:after="SyncSlug"
                           placeholder="e.g. Credential-phishing wave targeting Finance"
                           aria-invalid="@(_fieldErrors.ContainsKey("cc-title") ? "true" : null)" aria-describedby="cc-title-err" />
                @if (_fieldErrors.TryGetValue("cc-title", out var titleErr)) { <div id="cc-title-err" class="invalid-feedback d-block">@titleErr</div> }
                <div class="form-text">Case number <code>@PreviewNumber</code> is assigned automatically.</div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="cc-classification">Classification</label>
                    <InputSelect id="cc-classification" class="form-select" @bind-Value="_request.Classification" @bind-Value:after="RefreshGates">
                        <option value="">Complex Event</option>
                        @if (CanClassify)
                        {
                            @foreach (var c in Enum.GetValues<Classification>())
                            {
                                <option value="@c">@Ui.Label(c)</option>
                            }
                        }
                    </InputSelect>
                    @if (!CanClassify)
                    {
                        @* REV-14: say why the other rungs aren't offered. *@
                        <div class="form-text">Your role files Complex Events. Someone who can change a case's classification
                            promotes it onto the ladder.</div>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="cc-severity">Severity</label>
                    <InputSelect id="cc-severity" class="form-select" @bind-Value="_request.Severity">
                        @foreach (var s in Enum.GetValues<Severity>())
                        {
                            <option value="@s">@SevLabels.For(s)</option>
                        }
                    </InputSelect>
                    <div class="form-text">Sets the response SLA clock. Defaults to @SevLabels.For(Severity.Medium).</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="cc-origin">Origin</label>
                    <InputSelect id="cc-origin" class="form-select" @bind-Value="_request.Origin">
                        <option value="@CaseOrigin.InternalDetection">Internal detection</option>
                        <option value="@CaseOrigin.ThirdParty">Third-party / vendor</option>
                    </InputSelect>
                </div>
                @* CAP-36: the team that owns it: routes its chat posts and detection link, and filters lists. It never
                   changes who can see the case. A member of one team has it chosen to start with. *@
                @if (_teams.Count > 0)
                {
                    <div class="col-md-4">
                        <label class="form-label" for="cc-team">Team <span class="text-muted">(optional)</span></label>
                        <select id="cc-team" class="form-select" value="@(_request.TeamId?.ToString() ?? "")" @onchange="OnTeamChanged">
                            <option value="">No team</option>
                            @foreach (var t in _teams)
                            {
                                <option value="@t.Id">@t.Name</option>
                            }
                        </select>
                        <div class="form-text">Picks its chat channel and detection link; who can see it is unchanged.</div>
                    </div>
                }

                @if (_request.Origin == CaseOrigin.ThirdParty)
                {
                    <div class="col-md-4">
                        <label class="form-label" for="cc-vendor-name">Vendor name <span class="text-danger">*</span></label>
                        @* CAP-24: the vendors on cases you can see, to pick from; the value stays free text. *@
                        <input id="cc-vendor-name" class="@($"form-control {Invalid("cc-vendor-name")}")" maxlength="300" list="cc-vendor-names"
                               autocomplete="off" @bind="_request.VendorName" @bind:event="oninput" @bind:after="OnVendorChanged" @onfocus="LoadVendorNames"
                               aria-invalid="@(_fieldErrors.ContainsKey("cc-vendor-name") ? "true" : null)" aria-describedby="cc-vendor-name-err cc-vendor-seen" />
                        <datalist id="cc-vendor-names">
                            @foreach (var v in _vendorNames) { <option value="@v"></option> }
                        </datalist>
                        @if (_fieldErrors.TryGetValue("cc-vendor-name", out var vendorErr)) { <div id="cc-vendor-name-err" class="invalid-feedback d-block">@vendorErr</div> }
                    </div>
                    @* CAP-24: a vendor seen before, as an indicator is (HR-03): how many earlier cases, and how the last one ended. *@
                    <div class="col-12" id="cc-vendor-seen" aria-live="polite">
                        @if (_vendorHistory is { } vh && !_request.IsExercise && SameVendor(vh.Vendor, _request.VendorName))
                        {
                            <div class="im-seen-box">
                                <div class="fw-semibold small">
                                    <span class="bi bi-clock-history me-1" aria-hidden="true"></span>
                                    Seen before: @vh.Vendor has @(vh.Cases == 1 ? "1 earlier case" : $"{vh.Cases} earlier cases")@(vh.Open > 0 ? $" ({vh.Open} open)" : "")
                                    <a class="ms-1 fw-normal" href="@VendorCasesHref(vh.Vendor)" target="_blank" rel="noopener noreferrer">View them</a>
                                </div>
                                @if (vh.LastClosed is { } h)
                                {
                                    <CaseHistoryItem CaseId="h.CaseId" CaseNumber="@h.CaseNumber" Title="@h.Title" Classification="h.Classification"
                                                     ClosedAtUtc="h.ClosedAtUtc" OutcomeLabel="@OutcomeLabel(h.OutcomeKey)" ClosingLine="@h.ClosingLine" NewTab="true" />
                                }
                                else
                                {
                                    <div class="small text-muted">None has closed yet.</div>
                                }
                            </div>
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="cc-vendor-contact">Vendor contact</label>
                        <InputText id="cc-vendor-contact" class="form-control" @bind-Value="_request.VendorContact" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="cc-vendor-ref">Vendor reference</label>
                        <InputText id="cc-vendor-ref" class="form-control" @bind-Value="_request.VendorReference" />
                    </div>
                }

                @* PROD-43: mark a drill so it never pollutes real metrics. Fixed at creation. *@
                <div class="col-12">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="isExercise" @bind-Value="_request.IsExercise" @bind-Value:after="OnExerciseChanged" />
                        <label class="form-check-label" for="isExercise">
                            <span class="bi bi-mortarboard me-1" aria-hidden="true"></span>Tabletop / exercise case
                        </label>
                    </div>
                    <div class="form-text">
                        A drill for IRP testing (NYDFS 500.16). It's badged and kept out of dashboards, reminders,
                        the IOC feed and cross-case correlation. This <strong>can't be changed</strong> after the case is created.
                    </div>
                </div>

                @* S-08: open the case restricted to need-to-know from the start. *@
                <div class="col-12">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="isRestricted" @bind-Value="_request.IsRestricted" />
                        <label class="form-check-label" for="isRestricted">
                            <span class="bi bi-lock me-1" aria-hidden="true"></span>Restricted (need-to-know)
                        </label>
                    </div>
                    <div class="form-text">
                        Visible only to the incident commander, people assigned to the case and roles cleared for restricted cases.
                        If your role isn't cleared, you're added to the case team. You can change this later.
                    </div>
                </div>

                @* Whoever files a case usually works it: put them on the team so it lands in My work. *@
                <div class="col-12">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="assignToMe" @bind-Value="_request.AssignToMe" />
                        <label class="form-check-label" for="assignToMe">
                            <span class="bi bi-person-check me-1" aria-hidden="true"></span>Assign it to me
                        </label>
                    </div>
                    <div class="form-text">Adds you to the case team as an analyst, so it shows in My work. Untick to leave it unassigned.</div>
                </div>

                @* FR-03: capture the real detection time at intake — it anchors the response-SLA clock and
                   the dwell metric. Defaults to now (in the viewer's display zone); set it back to when the
                   matter was actually detected, not when the case is being filed. *@
                <div class="col-md-4">
                    <label class="form-label" for="nc-detected">Detected (@TimeDisp.Label) <span class="text-danger">*</span></label>
                    <DateTimeInput Past="true" id="nc-detected" class="form-control" @bind-Value="_detectedWall"
                           title="When the activity was first detected or reported, not when the case was filed. Starts the response SLA clock." />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="nc-occurred">Initial activity <span class="text-muted">(optional)</span></label>
                    <DateTimeInput Past="true" id="nc-occurred" class="form-control" @bind-Value="_occurredWall"
                           title="When adversary activity began (initial access), if known. Used to calculate dwell time." />
                </div>

                <div class="col-md-6">
                    <label class="form-label" for="cc-detection-id">@DetectionLabel Case ID <span class="text-muted">(optional)</span></label>
                    <InputText id="cc-detection-id" class="form-control" @bind-Value="_request.DetectionCaseId" placeholder="@($"e.g. {DetectionLabel}-40122")" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="cc-data-context">Data context <span class="text-muted">(optional)</span></label>
                    <InputText id="cc-data-context" class="form-control" @bind-Value="_request.DataTypesInvolved" placeholder="@(_dataTypesPrompt ?? "e.g. PII, PHI, credentials")" />
                    @* E-36: the structured data elements (Impact assessment) are the authoritative record. *@
                    <div class="form-text">Free-text notes only. Notification decisions use the data elements recorded in the case's Impact assessment.</div>
                </div>

                <div class="col-12">
                    <label class="form-label" for="cc-summary">Summary</label>
                    <InputTextArea id="cc-summary" class="form-control" rows="3" @bind-Value="_request.Summary" @bind-Value:after="RefreshGates"
                                   placeholder="@(_summaryPrompt ?? "What happened, current status, and immediate impact.")" />
                    @* FR-21: a template's summary shows as grey prompt text (U-47b), never a filled value, so a
                       hurried user can mistake it for content and file an empty summary. Nudge softly (no block). *@
                    @if (_selectedTemplate is not null && string.IsNullOrWhiteSpace(_request.Summary))
                    {
                        <div class="form-text text-warning">
                            <span class="bi bi-info-circle me-1" aria-hidden="true"></span>The gray text is the template's prompt, not content. Write your own summary, or the case is created without one.
                        </div>
                    }
                </div>
            </div>

            @* Power-user override of the auto-assigned number; hidden by default. *@
            <details class="nc-advanced">
                <summary>Advanced</summary>
                <div class="mt-2 nc-advanced-body">
                    <label class="form-label" for="cc-case-number">Case number <span class="text-muted">(optional)</span></label>
                    <InputText id="cc-case-number" class="form-control" @bind-Value="_request.CaseNumber" @bind-Value:after="CheckNumberAvailable" placeholder="@PreviewNumber" />
                    @* FR-22: flag a collision here instead of only on submit. *@
                    @if (_numberAvailable == false)
                    {
                        <div class="form-text text-danger"><span class="bi bi-x-circle me-1" aria-hidden="true"></span>“@(_request.CaseNumber?.Trim())” is in use, or was used before by another case (its audit trail keeps the number). Pick another or leave it blank.</div>
                    }
                    else if (_numberAvailable == true)
                    {
                        <div class="form-text text-success"><span class="bi bi-check-circle me-1" aria-hidden="true"></span>Available.</div>
                    }
                    else
                    {
                        <div class="form-text">Leave blank to assign one automatically.</div>
                    }
                </div>
            </details>
        </div>

        @* Indicators + duplicate / campaign detection (E-23) *@
        <div class="im-card nc-card">
            <label class="form-label" for="nc-indicators">Indicators <span class="text-muted">(optional, one per line)</span></label>
            <textarea id="nc-indicators" class="form-control" rows="3" @bind="_indicators" @bind:event="oninput" @bind:after="OnIndicatorsChanged"
                      placeholder="e.g. 1.2.3.4, evil.example.com, hxxp://bad[.]site/x, or a file hash"
                      @onblur="CheckOverlaps"></textarea>
            <div class="form-text">
                Checked against open cases for duplicates and against closed ones for history, then added as entities when the case is created. Defanged values are fine.
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="CheckOverlaps" disabled="@_checking">Check now</button>
            </div>

            @if (_checking)
            {
                <div class="mt-2"><span class="spinner-border spinner-border-sm text-muted" role="status"></span> <span class="text-muted small">Checking open cases…</span></div>
            }
            else if (ShowNoMatches)
            {
                <div class="alert alert-success py-2 mt-2 mb-0">
                    <span class="bi bi-check2-circle me-1" aria-hidden="true"></span>
                    No open cases reference these indicators.
                </div>
            }
            else if (_matches.Count > 0)
            {
                <div class="alert alert-warning mt-2 mb-0">
                    <div class="fw-semibold mb-2">
                        <span class="bi bi-diagram-3 me-1" aria-hidden="true"></span>
                        @(_matches.Count == 1 ? "1 open case already references" : $"{_matches.Count} open cases already reference") these indicators. Link related ones to keep a campaign together:
                    </div>
                    @foreach (var m in _matches)
                    {
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2 pb-2 border-bottom">
                            <a href="cases/@m.CaseId" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                <code>@m.CaseNumber</code> @m.Title
                            </a>
                            <span class="@Ui.PhaseBadge(m.Phase)">@Ui.Label(m.Phase)</span>
                            <span class="small text-muted">shared: @string.Join(", ", m.Indicators)</span>
                            <div class="ms-auto">
                                <select class="form-select form-select-sm d-inline-block w-auto" aria-label="Link to @m.CaseNumber"
                                        @onchange="e => SetLink(m.CaseId, e.Value?.ToString())">
                                    <option value="">Don't link</option>
                                    <option value="@CaseLinkType.RelatedTo">Related to</option>
                                    <option value="@CaseLinkType.DuplicateOf">Duplicate of</option>
                                    <option value="@CaseLinkType.PartOfCampaign">Part of campaign</option>
                                </select>
                            </div>
                        </div>
                    }
                    <div class="small text-muted">Links are optional and are applied when you create the case.</div>
                </div>
            }
            @* HR-03: closed cases that recorded these indicators: what was concluded there, before this one is filed. *@
            @if (!_checking && _history.Count > 0 && _checkedInput == _indicators)
            {
                <div class="im-seen-box mt-2">
                    <div class="fw-semibold small mb-1">
                        <span class="bi bi-clock-history me-1" aria-hidden="true"></span>
                        Seen before: @(_history.Count == 1 ? "1 closed case" : $"{_history.Count} closed cases") recorded these indicators
                    </div>
                    @foreach (var h in _history)
                    {
                        <CaseHistoryItem CaseId="h.CaseId" CaseNumber="@h.CaseNumber" Title="@h.Title" Classification="h.Classification"
                                         ClosedAtUtc="h.ClosedAtUtc" OutcomeLabel="@OutcomeLabel(h.OutcomeKey)" ClosingLine="@h.ClosingLine" NewTab="true"
                                         Verdicts="@string.Join(", ", h.Indicators.Select(i => $"{i.Value}: {Ui.Label(i.Disposition)} there"))" />
                    }
                </div>
            }
            @* CAP-28: not these values, but close to them by fixed rules, on cases you can see. A suggestion, never a link. *@
            @if (!_checking && _related.Count == 0 && _related.ScanLimitHit && _checkedInput == _indicators)
            {
                @* CAP-28 review: past the scan limit, "nothing" is only for the newest checked; say so rather than nothing. *@
                <div class="small text-muted mt-2" role="status">Possibly related: checked the newest @CaseService.RelatedScanLimit candidates for each shared part; none is close to these. Older ones weren't checked.</div>
            }
            @if (!_checking && _related.Count > 0 && _checkedInput == _indicators)
            {
                <div class="im-seen-box mt-2" role="region" aria-label="Possibly related indicators">
                    <div class="fw-semibold small mb-1">
                        <span class="bi bi-diagram-3 me-1" aria-hidden="true"></span>
                        Possibly related: @(_related.Select(r => r.OtherCaseId).Distinct().Count() is 1 ? "1 case has" : $"{_related.Select(r => r.OtherCaseId).Distinct().Count()} cases have") indicators close to these
                    </div>
                    @foreach (var g in _related.GroupBy(r => r.OtherCaseId))
                    {
                        <div class="im-seen">
                            <div class="im-seen-h">
                                <a href="cases/@g.Key" target="_blank" rel="noopener noreferrer" class="im-data">@g.First().OtherCaseNumber</a>
                                <span class="im-seen-title">@g.First().OtherTitle</span>
                                <span class="small text-muted">@(g.First().IsClosed ? "closed" : $"open · {Ui.Label(g.First().OtherPhase)}")</span>
                            </div>
                            @foreach (var r in g)
                            {
                                <div class="im-seen-meta text-break"><code>@r.OtherValue</code> <span class="text-muted">· @r.Why as @r.Indicator · @Ui.Label(r.DispositionThere) there</span></div>
                            }
                        </div>
                    }
                    <div class="small text-muted">A suggestion by a fixed rule (domain, /24 or /48, email domain), not a match. Nothing is linked.@(_related.ScanLimitHit ? $" Checked the newest {CaseService.RelatedScanLimit} candidates for each shared part only." : "")</div>
                </div>
            }
        </div>

        @* FR-04: the check ran on Create and surfaced related cases the analyst hadn't seen — pause once so
           they can relate one above, then file. BUG-602: only this alert's own button files past the pause; a second
           click on Create case (a double-click, or Enter in a field) used to satisfy it unseen. *@
        @if (_overlapPrompt)
        {
            <div class="alert alert-warning mb-0 d-flex flex-wrap align-items-center gap-2">
                <span>
                    <span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>
                    Open cases already reference these indicators (see above). Link any that are related, then click
                    <strong>Create anyway</strong>. To keep it separate, click it without linking.
                </span>
                <button type="button" class="btn btn-sm btn-warning" @onclick="CreateAnyway" disabled="@(_saving || _checking || GateUnresolved)">Create anyway</button>
            </div>
        }

        @* BUG-61: a case filed straight onto a rung passes that rung's gate (and those below it), as reclassifying does. *@
        @if (_created is null && _gate.Gate is { } gate)
        {
            <section class="mb-3" aria-labelledby="nc-gate-h">
                <h2 class="h6 mb-1" id="nc-gate-h">Filing as @(Ui.Label(_request.Classification)): @gate.GateName</h2>
                <p class="small text-muted mb-0">The same readiness checks as escalating a case to this rung. Tick what's true;
                    anything required that's still unmet needs an override reason, which is recorded with the case.</p>
                <IncidentManager.Web.Components.Pages.Workspace.GateSection Draft="_gate" OnChanged="StateHasChanged" />
            </section>
        }

        @if (_error is not null)
        {
            @* REL-04: distinguish "couldn't file the case" (red — nothing was created, safe to retry from
               scratch) from "case was filed but a later setup step failed" (amber — retrying resumes the
               remaining setup on the same case; it will not create a duplicate). *@
            @if (_created is not null)
            {
                <div class="alert alert-warning mb-0">
                    <div class="fw-semibold"><span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>Case <code>@_created.CaseNumber</code> was created, but its setup didn’t finish.</div>
                    <div class="small mt-1">Click <strong>Finish setup</strong> to add the remaining indicators, links and tasks without creating a duplicate. Or open the case and add them there.</div>
                    <div class="small text-muted mt-1">Detail: @_error</div>
                </div>
            }
            else
            {
                <div class="alert alert-danger mb-0">@_error</div>
            }
        }

        <div class="nc-actions">
            <button type="submit" class="btn btn-primary" disabled="@(_saving || _checking || GateUnresolved || _overlapPrompt)">@(_created is null ? "Create case" : "Finish setup")</button>
            @if (_created is not null)
            {
                <a class="btn btn-outline-primary" href="cases/@_created.Id">Open case as-is</a>
            }
            <a class="btn btn-outline-secondary" href="@ListMemory.BackHref">Cancel</a>   @* BUG-593: the list as it was left *@
        </div>
    </div>
</EditForm>

@code {
    private readonly CreateCaseRequest _request = new() { AssignToMe = true };
    private bool _saving;
    private string? _error;

    // REL-04: case creation is a multi-step sequence (create, then seed indicator entities, related-case
    // links, and template steps). Once CreateAsync commits, the case exists — so if a later seeding step
    // throws we must NOT leave the analyst on the form where a second "Create" would file a *duplicate*
    // case. Instead we hold the created case and resume the remaining seeding on retry, with each step
    // tracking its own progress so nothing is ever applied twice.
    private Case? _created;
    private int _entitiesSeeded;                            // indicator entities already added (loop index)
    private readonly HashSet<Guid> _linksApplied = new();   // related cases already linked
    private bool _templateApplied;

    // FR-03: intake detection/dwell timestamps entered as wall-clock in the viewer's display zone (U-29),
    // converted to UTC on submit. Detected defaults to now; initial-activity is optional.
    private DateTime? _detectedWall;
    private DateTime? _occurredWall;

    private List<TemplateView>? _templates;
    private TemplateView? _selectedTemplate;

    // FR-22: inline availability of a custom (Advanced) case number — null = blank/unchecked, true/false checked.
    private bool? _numberAvailable;
    private async Task CheckNumberAvailable()
    {
        var v = _request.CaseNumber?.Trim();
        _numberAvailable = string.IsNullOrEmpty(v) ? null : await Cases.IsCaseNumberAvailableAsync(v);
    }

    // E-23: creation-time IOC entry + duplicate/related-case detection.
    private string? _indicators;
    private List<CaseIocMatch> _matches = new();
    private IReadOnlyList<CaseHistoryMatch> _history = [];   // HR-03
    private RelatedIndicators _related = RelatedIndicators.None;   // CAP-28: possibly related, a suggestion only
    private IReadOnlyDictionary<string, string> _outcomeLabels = new Dictionary<string, string>();
    private string? OutcomeLabel(string? key) => key is null ? null
        : _outcomeLabels.GetValueOrDefault(key) ?? IncidentManager.Application.Admin.CaseOutcomeCatalog.Label(key);
    private bool _checking;
    private string? _checkedInput; // the indicator text last checked — so "no matches" feedback clears once it's edited
    private readonly Dictionary<Guid, CaseLinkType?> _linkChoice = new();
    // FR-04: set when Create ran the overlap check itself and found matches the analyst hadn't seen — the first
    // Create pauses on it so the check can't be skipped; a second Create then files.
    private bool _overlapPrompt;

    // WF-51: what the seeding will add: one entity per distinct value as stored (refanged, normalised), since a value
    // already on the case is kept, not added again. Counting raw lines let "1.2.3.4", "1.2.3[.]4" meet "at least 2 entities".
    private int PlannedIndicatorCount() => IndicatorLines(_indicators)
        .Select(l => DetectedOr(l) is var t ? (t, IocObservable.Normalize(t, l).ToLowerInvariant()) : default)
        .Distinct().Count();

    // BUG-506 sibling: an indicator is filed as a type the admin offers: the detected one, else Other, else the first
    // offered (as the Things tab). With every type hidden the detected one stands.
    private static EntityType DetectedOr(string raw)
    {
        var detected = IocObservable.DetectType(raw);
        var offered = Ui.Options<EntityType>("EntityType");
        if (offered.Count == 0 || offered.Contains(detected)) return detected;
        return offered.Contains(EntityType.Other) ? EntityType.Other : offered[0];
    }

    private static IEnumerable<string> IndicatorLines(string? raw) =>
        (raw ?? "").Replace("\r", "").Split('\n').Select(l => l.Trim()).Where(l => l.Length > 0);

    // Show the "no matches" note only after a check whose input still matches what's in the box.
    private bool ShowNoMatches =>
        !_checking && _matches.Count == 0 && _checkedInput == _indicators && IndicatorLines(_indicators).Any();

    private void SetLink(Guid caseId, string? raw)
        => _linkChoice[caseId] = IncidentManager.Domain.Common.EnumNames.OrNull<CaseLinkType>(raw);

    // FR-04: any edit or re-check clears the "paused for review" state so a stale prompt never lingers.
    private async Task OnIndicatorsChanged()
    {
        _overlapPrompt = false;
        await RefreshGates();   // indicators count toward "at least one entity"
    }

    // BUG-496: a drill is checked against no live case, so the last check (and its matches, history, link choices and
    // prompt) no longer holds once the box changes. Re-check now, superseding one still running, so Create sees fresh
    // matches; a drill's gates can differ too.
    private async Task OnExerciseChanged()
    {
        _overlapPrompt = false;
        _checkedInput = null;
        _matches = new();
        _history = [];
        _related = RelatedIndicators.None;   // CAP-28
        _linkChoice.Clear();
        if (IndicatorLines(_indicators).Any()) await CheckOverlaps();
        else { ++_checkSeq; _checking = false; }
        _vendorHistory = null;   // CAP-24: a drill shows no vendor history either
        await LookUpVendor();
        await RefreshGates();
    }

    // BUG-61: the gates the case would pass if filed as the form stands. Ticks survive a re-check of the same gates.
    private readonly IncidentManager.Web.Components.Pages.Workspace.TransitionDraft _gate = new();

    private bool GateUnresolved => _created is null && _gate.NeedsOverride && string.IsNullOrWhiteSpace(_gate.Override);

    // BUG-447: classification, summary, template and indicator edits each re-check, so checks can overlap; only the
    // newest one's result is kept (as CaseImport, BUG-385).
    private int _gateSeq;

    private async Task RefreshGates()
    {
        if (_created is not null) return;
        var seq = ++_gateSeq;
        _request.PlannedEntityCount = PlannedIndicatorCount();
        var eval = await Cases.EvaluateNewCaseGatesAsync(_request);
        if (seq != _gateSeq) return;
        if (eval is not { GateExists: true }) { _gate.UseGate(null); return; }
        if (_gate.Gate?.GateName == eval.GateName) _gate.Gate = eval;   // same gates: keep the ticks
        else _gate.UseGate(eval);
    }

    // BUG-356: the check in progress, so Create can wait for one the blur started (the click on Create blurs the box,
    // so the check is already marked as done for this text when Create runs). _checkTaskNew: it checks text whose
    // matches haven't been shown yet (a re-check of the same text doesn't pause Create a second time).
    private Task? _checkTask;
    private bool _checkTaskNew;
    private Task CheckOverlaps()
    {
        _checkTaskNew = (_checkTask is { IsCompleted: false } && _checkTaskNew) || _checkedInput != _indicators;
        return _checkTask = CheckOverlapsCore();
    }

    // BUG-384: checks overlap (a blur, then Check now or Create after an edit). Only the newest one's matches are kept and
    // only it ends "checking", so an earlier check's results can't show (and be linked) for edited indicators, and its
    // finish can't re-enable Create while the newer one runs.
    private int _checkSeq;

    private async Task CheckOverlapsCore()
    {
        var seq = ++_checkSeq;
        _overlapPrompt = false;
        var lines = IndicatorLines(_indicators).ToList();
        _checkedInput = _indicators;
        // WF-48: a drill is checked against no live case (and links to none).
        if (lines.Count == 0 || _request.IsExercise) { _matches = new(); _history = []; _related = RelatedIndicators.None; _linkChoice.Clear(); _checking = false; return; }
        _checking = true;
        List<CaseIocMatch> matches;
        IReadOnlyList<CaseHistoryMatch> history;
        RelatedIndicators related;
        IReadOnlyDictionary<string, string>? labels = null;
        try
        {
            matches = (await Cases.FindOpenCaseMatchesForIocsAsync(lines)).ToList();
            history = await Cases.FindCaseHistoryForIocsAsync(lines);
            related = await Cases.FindRelatedIndicatorsForIocsAsync(lines);   // CAP-28
            if (history.Count > 0 && _outcomeLabels.Count == 0) labels = await Outcomes.LabelsAsync();
        }
        finally { if (seq == _checkSeq) _checking = false; }
        if (seq != _checkSeq) return;
        (_matches, _history, _related) = (matches, history, related);
        if (labels is not null) _outcomeLabels = labels;   // BUG-601: with the check they came with, as the rest
        // Drop choices for cases that are no longer matched (indicators edited).
        foreach (var id in _linkChoice.Keys.Where(k => _matches.All(m => m.CaseId != k)).ToList())
            _linkChoice.Remove(id);
    }

    private bool CanClassify => CurrentUser.Has(Permission.ChangeClassification);   // REV-14

    // CAP-24: the vendor names offered (loaded once, on first focus), and the history of the one typed, when it's known.
    private IReadOnlyList<string> _vendorNames = [];
    private bool _vendorNamesLoaded;
    private VendorHistory? _vendorHistory;
    private int _vendorSeq;

    private async Task LoadVendorNames()
    {
        if (_vendorNamesLoaded) return;
        _vendorNamesLoaded = true;
        var names = await Cases.ListVendorNamesAsync();
        if (_disposed) return;
        _vendorNames = names;
        await LookUpVendor();   // a name typed before the list arrived
    }

    private async Task OnVendorChanged()
    {
        _fieldErrors.Remove("cc-vendor-name");
        await LookUpVendor();
    }

    private static bool SameVendor(string? a, string? b) =>
        string.Equals(a?.Trim(), b?.Trim(), StringComparison.OrdinalIgnoreCase);

    // C5: a name typed on while a look-up ran keeps only the newest answer; a name that isn't one offered looks up nothing.
    private async Task LookUpVendor()
    {
        var seq = ++_vendorSeq;
        var name = _request.VendorName?.Trim() ?? "";
        if (_request.IsExercise || !_vendorNames.Any(v => SameVendor(v, name))) { _vendorHistory = null; return; }
        if (_vendorHistory is { } shown && SameVendor(shown.Vendor, name)) return;
        var history = await Cases.FindVendorHistoryAsync(name);
        IReadOnlyDictionary<string, string>? labels = null;
        if (history?.LastClosed is not null && _outcomeLabels.Count == 0) labels = await Outcomes.LabelsAsync();
        if (seq != _vendorSeq || _disposed) return;
        if (labels is not null) _outcomeLabels = labels;
        _vendorHistory = history;
    }

    // CAP-24: the case list filtered to the vendor, closed cases included. A vendor's name isn't personal data, and no
    // indicator goes in this link (C7).
    private string VendorCasesHref(string vendor) =>
        Nav.ToBaseRelativePath(Nav.GetUriWithQueryParameters(Nav.ToAbsoluteUri("cases").ToString(),
            new Dictionary<string, object?> { ["scope"] = "all", ["vendor"] = vendor, ["closed"] = "true" }));

    // CAP-36: the active teams, and the one this user is in when they're in exactly one (the default).
    private List<IncidentManager.Application.Admin.TeamView> _teams = [];

    private void OnTeamChanged(ChangeEventArgs e) =>
        _request.TeamId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;

    protected override async Task OnInitializedAsync()
    {
        _templates = await Templates.ListActiveAsync();
        _teams = (await TeamsSvc.ListAsync()).Where(t => t.IsActive).ToList();
        if (await TeamsSvc.MineAsync() is [var only]) _request.TeamId ??= only.Id;
        // FR-03: default Detected to now in the viewer's display zone. If the display zone resolves after
        // first render (U-29 reconfigures TimeDisp, remounting this page via the layout @key), this re-seeds
        // with the correct zone — the user hasn't interacted yet at that point.
        _detectedWall = IncidentManager.Web.Components.Pages.Workspace.WallClock.ToWall(DateTimeOffset.UtcNow, TimeDisp.Zone);
        await RefreshGates();
    }

    // PROD-26: prefill severity/origin from what this user last filed — the highest-frequency form, and a
    // per-viewer convenience (localStorage). A chosen template still overrides these. Read after first render
    // (localStorage needs interop); wrapped so a private/blocked store just leaves the defaults in place.
    private const string SevKey = "im.newcase.severity";
    private const string OriginKey = "im.newcase.origin";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusField is { } f)
        {
            _focusField = null;
            try { await JS.InvokeVoidAsync("imMotion.focusId", f); } catch (JSException) { }
        }
        if (!firstRender) return;
        try
        {
            var sev = await JS.InvokeAsync<string?>("localStorage.getItem", SevKey);
            var org = await JS.InvokeAsync<string?>("localStorage.getItem", OriginKey);
            var changed = false;
            if (IncidentManager.Domain.Common.EnumNames.TryParse<Severity>(sev, out var s)) { _request.Severity = s; changed = true; }
            if (IncidentManager.Domain.Common.EnumNames.TryParse<CaseOrigin>(org, out var o)) { _request.Origin = o; changed = true; }
            if (changed) StateHasChanged();
        }
        catch { /* localStorage unavailable — the form's own defaults stand */ }
    }

    private async Task OnTemplateChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        _selectedTemplate = Guid.TryParse(raw, out var id) ? _templates?.FirstOrDefault(t => t.Id == id) : null;
        if (_selectedTemplate is null) return;

        // Quick-fill the structured field defaults (classification/severity) — these are safe to pre-set.
        if (_selectedTemplate.DefaultClassification is { } c && CanClassify) _request.Classification = c;
        if (_selectedTemplate.DefaultSeverity is { } s) _request.Severity = s;
        await RefreshGates();

        // U-47b: the free-text defaults become *placeholder prompts*, not pre-filled values, so a template's
        // generic wording can never be filed verbatim — the analyst must write the real summary/data types.
        _dataTypesPrompt = string.IsNullOrWhiteSpace(_selectedTemplate.DefaultDataTypes) ? null : _selectedTemplate.DefaultDataTypes;
        _summaryPrompt = string.IsNullOrWhiteSpace(_selectedTemplate.SummaryBoilerplate) ? null : _selectedTemplate.SummaryBoilerplate;
    }

    // U-47b: template-supplied prompts shown as ghost text (watermarks) on the free-text fields.
    private string? _summaryPrompt;
    private string? _dataTypesPrompt;

    // U-42: one Title field drives the case-number slug. Keep the (validator-required) DescriptiveName in
    // sync with a compacted slug source so the auto number stays short instead of echoing the full title.
    private void SyncSlug()
    {
        _request.DescriptiveName = SlugSource(_request.Title);
        if (!string.IsNullOrWhiteSpace(_request.Title)) _fieldErrors.Remove("cc-title");
    }

    private static string SlugSource(string? title)
    {
        var t = (title ?? "").Trim();
        if (t.Length == 0) return "";
        var s = string.Join(' ', t.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(6));
        return IncidentManager.Application.Common.TextFit.Cap(s, 42, "").TrimEnd();   // C12: never half a surrogate pair
    }

    // Reflects the scheme the auto-number would use. The per-year sequence is only known at save time, so
    // show a neutral NN placeholder rather than implying a specific number (U-43). Complex Event numbers are
    // date-based, so their preview is exact.
    private string PreviewNumber
    {
        get
        {
            // REV-39: the organization's calendar date and year, as the number itself is given (BUG-112).
            var now = TimeZoneInfo.ConvertTime(Clock.UtcNow, OrgZone.Current);
            var slug = Case.Slug(SlugSource(_request.Title));
            return _request.Classification is null
                ? Case.FormatComplexEventNumber(now, slug)
                : $"{now.Year}-NN_{slug}";
        }
    }

    /// <summary>Configurable display label for the detection source; defaults to "SIEM". CAP-36: the chosen team's own, when
    /// it sets one.</summary>
    private string DetectionLabel => DetectionSource.Label(Config, _teams.FirstOrDefault(t => t.Id == _request.TeamId));

    // Required fields, checked here so the message sits under the field (and focus goes there) rather than in
    // a summary. The service validates again.
    private readonly Dictionary<string, string> _fieldErrors = new();
    private string? _focusField;
    private string Invalid(string id) => _fieldErrors.ContainsKey(id) ? "is-invalid" : "";

    private bool CheckRequired()
    {
        _fieldErrors.Clear();
        if (string.IsNullOrWhiteSpace(_request.Title))
            _fieldErrors["cc-title"] = "Give the case a title. It also becomes the case number.";
        if (_request.Origin == CaseOrigin.ThirdParty && string.IsNullOrWhiteSpace(_request.VendorName))
            _fieldErrors["cc-vendor-name"] = "Name the vendor that reported it.";
        _focusField = _fieldErrors.Keys.FirstOrDefault();
        return _fieldErrors.Count == 0;
    }

    // BUG-14: one save at a time. A double-click, or Ctrl+Enter and a click, used to save twice.
    private readonly InFlight _submitting = new();

    private Task Submit() => _submitting.Run(() => SubmitCore(pastOverlapPause: false));

    // BUG-602: the duplicate pause's own button, the one way past it.
    private Task CreateAnyway() => _submitting.Run(() => SubmitCore(pastOverlapPause: true));

    private async Task SubmitCore(bool pastOverlapPause)
    {
        _error = null;
        if (_created is null && !CheckRequired()) return;
        // BUG-602: paused on matches the analyst hadn't seen, a second Create case (a double-click's second click, Enter in a
        // field) filed without a look. The pause holds until "Create anyway", or an edit that re-checks.
        if (_created is null && _overlapPrompt && !pastOverlapPause) return;

        // FR-04: the duplicate/campaign check must not be skippable. If indicators were entered but the check
        // is stale (typed then clicked Create without ever blurring / checking), run it now; if it surfaces
        // open cases sharing these indicators for the first time, pause once so the analyst can relate one —
        // then a second Create files. Filing is never blocked; this only guarantees the check is seen.
        // REL-04: only gate on the overlap check before the case exists; once created, a retry is just
        // resuming the seeding, so the pre-create duplicate/campaign prompt no longer applies.
        var lines = IndicatorLines(_indicators).ToList();
        var running = _checkTask is { IsCompleted: false } t && _checkTaskNew ? t : null;   // BUG-356: matches not seen yet
        if (_created is null && lines.Count > 0 && (running is not null || _checkedInput != _indicators))
        {
            // BUG-384: the newest check's matches, should another have started (a blur) while this one ran.
            if (running is not null)
                while (_checkTask is { IsCompleted: false } latest) await latest;
            if (_checkedInput != _indicators) await CheckOverlaps();
            if (_matches.Count > 0)
            {
                _overlapPrompt = true;
                return;
            }
        }

        _saving = true;
        _overlapPrompt = false;
        try
        {
            // FR-03: fold the intake timestamps (entered as wall-clock) into the request as UTC.
            _request.DetectedAtUtc = _detectedWall is { } dw ? IncidentManager.Web.Components.Pages.Workspace.WallClock.ToUtc(dw, TimeDisp.Zone) : null;
            _request.OccurredAtUtc = _occurredWall is { } ow ? IncidentManager.Web.Components.Pages.Workspace.WallClock.ToUtc(ow, TimeDisp.Zone) : null;
            _request.PlannedEntityCount = PlannedIndicatorCount();
            _request.AttestedRequirementIds = _gate.Attested.ToHashSet();
            _request.OverrideJustification = _gate.NeedsOverride ? _gate.Override?.Trim() : null;
            // REL-04: create exactly once — a retry after a partial-seed failure reuses this case rather
            // than filing a duplicate.
            _created ??= await Cases.CreateAsync(_request);

            // E-23: seed entered indicators as entities (best-effort typed; correctable on the Entities tab).
            // Skip any already added so a resumed run never duplicates them. BUG-420: added together, so the accounts among
            // them share one directory-lookup allowance rather than each getting its own (and a retry matches, not repeats).
            var seed = IndicatorLines(_indicators).Skip(_entitiesSeeded)
                .Select(raw => new CaseService.EntityToAdd(DetectedOr(raw), raw, null,
                    EntityDisposition.Unknown, null, "Filed at case creation"))
                .ToList();
            if (seed.Count > 0) await Cases.AddOrMatchEntitiesAsync(_created.Id, seed);
            _entitiesSeeded += seed.Count;
            // Apply the analyst's chosen relationships to the matched open cases (E-14), tracking which
            // are done so a resume doesn't re-link.
            foreach (var (relatedCaseId, choice) in _linkChoice)
                if (choice is { } type && !_request.IsExercise && !_linksApplied.Contains(relatedCaseId))   // WF-48
                {
                    await Cases.LinkCaseAsync(_created.Id, relatedCaseId, type, "Linked at case creation (shared indicator)");
                    _linksApplied.Add(relatedCaseId);
                }
            // Seed the template's playbook steps as action items on the fresh case (once).
            if (_selectedTemplate is { Steps.Count: > 0 } && !_templateApplied)
            {
                await Cases.ApplyTemplateAsync(_created.Id, _selectedTemplate.Id);
                _templateApplied = true;
            }
            // PROD-26: remember this filing's severity/origin to prefill the next new case.
            try
            {
                await JS.InvokeVoidAsync("localStorage.setItem", SevKey, _request.Severity.ToString());
                await JS.InvokeVoidAsync("localStorage.setItem", OriginKey, _request.Origin.ToString());
            }
            catch { /* non-fatal — the case is already created */ }
            if (!_disposed) Nav.NavigateTo($"cases/{_created.Id}");   // BUG-601: not from a page already left
        }
        catch (Exception ex)
        {
            // REL-06: show domain/validation messages verbatim; replace cryptic EF/SQLite/internal errors
            // with a plain line and log the detail. The amber "was filed" state renders this the same way.
            _error = UserFacingError.Describe(ex, Logger, "creating a case",
                "Couldn't create the case. Try again, and contact an admin if it keeps failing.");
        }
        finally
        {
            _saving = false;
        }
    }

    private bool _disposed;
    public void Dispose() => _disposed = true;
}
