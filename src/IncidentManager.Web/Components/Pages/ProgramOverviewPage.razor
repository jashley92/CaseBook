@page "/program"
@* RD-17: Program › Overview, the leadership dashboard (it was the landing at /). *@
@attribute [Authorize(Policy = Policies.ViewAllCases)]
@using IncidentManager.Application.Sla
@using IncidentManager.Application.Common
@inject DashboardService Dashboard
@inject ISeverityLabels SevLabels
@inject ProgramReportService ProgramFigures
@inject NeedsActionService NeedsActionSvc
@inject VendorCasesService Vendors
@inject IncidentManager.Application.Mitre.AttackCoverageService Coverage
@inject IncidentManager.Application.Abstractions.IOrganizationTimeZone OrgZone
@inject IClock Clock
@inject TimeDisplay TimeDisp
@inject NavigationManager Nav
@inject IncidentManager.Application.Admin.TeamService TeamsSvc
@implements IDisposable

<PageTitle>Program</PageTitle>

<div class="dash">
<PageHeader Title="Program"
           Subtitle="@(_asOf is null ? null : $"As of {_asOf} · exercise cases {(Exercises ? "included" : "excluded")}")">
    <Actions>
        <span class="btn-group btn-group-sm" role="group" aria-label="Period for the timing and target figures">
            @foreach (var (key, label) in PeriodChoices)
            {
                var on = OverviewWindows.Key(_period) == key;
                <a class="btn btn-outline-secondary @(on ? "active" : "")" aria-current="@(on ? "true" : null)"
                   href="@Href(key, Exercises)">@label</a>
            }
            <button type="button" class="btn btn-outline-secondary @(_period == OverviewPeriod.Custom ? "active" : "")"
                    aria-expanded="@Ui.Aria(_customOpen)" aria-controls="po-custom"
                    @onclick="() => _customOpen = !_customOpen">
                @(_period == OverviewPeriod.Custom ? _windows?.Current.Label : "Custom")
                <span class="bi bi-calendar-range" aria-hidden="true"></span>
            </button>
        </span>
        <a class="btn btn-sm btn-outline-secondary" href="@SameRange(!Exercises)"
           title="Exercise cases are left out of these figures unless you include them">
            <span class="bi @(Exercises ? "bi-check2-square" : "bi-square")" aria-hidden="true"></span> Include exercises
        </a>
        @* UX-06: quick jump to the caller's own queue (the opposite-view cross-link). *@
        <a class="btn btn-sm btn-outline-secondary" href="desk"
           title="Your cases, tasks and what needs you">
            <span class="bi bi-person-workspace" aria-hidden="true"></span> Desk
        </a>
        @* CAP-36: one team's cases (by the team each case belongs to now), after need-to-know. *@
        @if (_teams.Count > 0)
        {
            <select class="form-select form-select-sm" style="width:auto" aria-label="Team" value="@IncidentManager.Application.Admin.TeamService.PickerValue(_teams, TeamRaw)" @onchange="PickTeam">
                <option value="">All teams</option>
                <option value="@TeamScope.NoneKey">No team</option>
                @foreach (var t in _teams)
                {
                    <option value="@t.Key">@t.Name@(t.IsActive ? "" : " (retired)")</option>
                }
            </select>
        }
        <a class="btn btn-sm btn-outline-secondary" href="@MetricsHref" download
           title="Current metrics and 12-month trend, for a board or regulatory pack">
            <span class="bi bi-download" aria-hidden="true"></span> Export this view
        </a>
    </Actions>
</PageHeader>
@if (_customOpen)
{
    <form id="po-custom" class="po-custom" @onsubmit="ApplyCustom" @onsubmit:preventDefault>
        <div>
            <label class="form-label small mb-0" for="po-from">From</label>
            <DateInput Past="true" id="po-from" class="form-control form-control-sm" min="@RangeMin" max="@Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" @bind-Value="_from" />
        </div>
        <div>
            <label class="form-label small mb-0" for="po-to">To</label>
            <DateInput Past="true" id="po-to" class="form-control form-control-sm" min="@RangeMin" max="@Today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)" @bind-Value="_to" />
        </div>
        <button type="submit" class="btn btn-sm btn-primary">Show</button>
        <span class="po-custom-hint">Both days included, in the reporting time zone. It's compared with the same number of
            days just before it; the trend lines stay on the last 12 months.</span>
        @if (_customError is { } err) { <span class="po-custom-err" role="alert">@err</span> }
    </form>
}
<ProgramNav Team="@TeamRaw" />

@if (_metrics is null)
{
    <span class="visually-hidden" role="status">Loading dashboard…</span>
    <div class="skel" style="height:1.5rem;max-width:36rem;border-radius:var(--im-radius);margin-bottom:var(--im-space-5)"></div>
    <div class="po-split">
        <div class="po-main">
            <div class="skel" style="min-height:10rem;border-radius:var(--im-radius-lg)"></div>
            <div class="skel" style="min-height:17rem;border-radius:var(--im-radius-lg)"></div>
        </div>
        <div class="po-rail">
            <div class="skel" style="min-height:16rem;border-radius:var(--im-radius-lg)"></div>
        </div>
    </div>
}
else
{
    var m = _metrics;
    var compTotal = m.Breaches + m.Incidents + m.AdverseEvents;
    var qs = Questions();

    @* Program redesign (B with C): one sentence first, then a question per card in the main column, each answered in a
       line (coloured only when it needs attention) with its evidence beneath; the rail holds the answers at a glance,
       the period's numbers, the targets and the learning loop. One gap and one card padding throughout. *@
    <p class="po-lede">@Lede()</p>

    <div class="po-split">
    <div class="po-main">

    @if (qs.FirstOrDefault(q => q.Id == "po-q-reg") is { } qReg && _needs is { } na0)
    {
        <section class="po-q" id="@qReg.Id" aria-labelledby="@($"{qReg.Id}-t")">
            @QHead(qReg, null, null)
            @foreach (var nc in na0.Clocks)
            {
                <a class="nc-clock dash-link" href="cases/@nc.CaseId">
                    <span class="nc-top"><span class="nc-rule">@nc.Jurisdiction · @nc.WindowHours h window</span>
                        <span class="na-when @(nc.State == SlaState.Breached ? "over" : nc.State == SlaState.AtRisk ? "soon" : "")">@ClockDue(nc)</span></span>
                    <span class="na-case">@nc.CaseNumber</span>
                    <span class="cmp-track"><span class="cmp-fill @(nc.State == SlaState.Breached ? "bad" : nc.State == SlaState.AtRisk ? "warn" : "ok")"
                                                  style="width:@(Math.Min(100, (int)(nc.ElapsedHours * 100 / Math.Max(1, nc.WindowHours))))%"></span></span>
                    <span class="cmp-note">@Num(Math.Min(nc.ElapsedHours, nc.WindowHours)) of @nc.WindowHours h used</span>
                </a>
            }
            @if (_cur is { } rc)
            {
                <div class="po-note">@rc.ReportedToRegulators reported in @_windows!.Current.Label@(rc.NoticesMet + rc.NoticesMissed > 0 ? $", {rc.NoticesMet} of {rc.NoticesMet + rc.NoticesMissed} regulator notices inside their window" : "")@(rc.DetectToReport.MedianHours is { } dr ? $" · median detect → report {Num(dr)} h" : "").</div>
            }
        </section>
    }

    @if (_needs is { } na)
    {
        var qLate = qs.First(q => q.Id == "po-q-late");
        <section class="po-q" id="@qLate.Id" aria-labelledby="@($"{qLate.Id}-t")">
            @QHead(qLate, null, null)
            @if (na.Items.Count > 0)
            {
                <ul class="na-list">
                    @foreach (var it in _showAllNeeds ? na.Items : na.Items.Take(NeedsShown))
                    {
                        <li class="na-item">
                            <span class="na-kind @KindTone(it)">@KindLabel(it.Kind)</span>
                            <span class="na-body">
                                <span class="na-what">@it.What</span>
                                @if (it.CaseId is { } id) { <a class="na-case" href="cases/@id">@it.CaseNumber</a> }
                                else if (it.Href is { } href) { <a class="na-case" href="@href">Improvement actions</a> }
                            </span>
                            <span class="na-when @(it.Over && it.Kind != NeedsActionKind.Brief ? "over" : it.Kind == NeedsActionKind.Notify ? "soon" : "")">@When(it)</span>
                        </li>
                    }
                </ul>
                @if (na.Items.Count > NeedsShown)
                {
                    <button type="button" class="btn btn-link btn-sm na-more" @onclick="() => _showAllNeeds = !_showAllNeeds">
                        @(_showAllNeeds ? "Show fewer" : $"Show {na.Items.Count - NeedsShown} more")
                    </button>
                }
            }
        </section>
    }

    @{ var qOpen = qs.First(q => q.Id == "po-q-open"); }
    <section class="po-q" id="@qOpen.Id" aria-labelledby="@($"{qOpen.Id}-t")">
        @QHead(qOpen, "All open cases", CasesHref())
        <div class="compo" role="img" aria-label="Classification mix of open cases">
            @if (compTotal == 0) { <span class="seg empty" style="flex:1"></span> }
            else
            {
                <span class="seg danger" style="flex:@Flex(m.Breaches)" title="Breaches"></span>
                <span class="seg amber" style="flex:@Flex(m.Incidents)" title="Incidents"></span>
                <span class="seg low" style="flex:@Flex(m.AdverseEvents)" title="Adverse events"></span>
            }
        </div>
        <div class="legend po-legend">
            <a class="dash-link" href="@CasesHref("classification=Breach")"><i class="sw danger"></i>@m.Breaches Breach@(m.Breaches == 1 ? "" : "es")@(m.BreachesAtVendor > 0 ? $" ({m.BreachesAtVendor} at a vendor)" : "")</a>
            <a class="dash-link" href="@CasesHref("classification=Incident")"><i class="sw amber"></i>@m.Incidents Incident@(m.Incidents == 1 ? "" : "s")</a>
            <a class="dash-link" href="@CasesHref("classification=AdverseEvent")"><i class="sw low"></i>@m.AdverseEvents Adverse</a>
        </div>

        <div class="c-head ca-head">
            <span class="c-title">Case activity
                <span class="c-note" title="Months follow the reporting time zone@(_metrics?.TrendZone is { } z ? $": {z}" : "")">last 12 months · @_openedTotal opened · @_closedTotal closed</span></span>
            <span class="ca-split">
                <span id="ca-split-label">Color by</span>
                <span class="btn-group btn-group-sm" role="group" aria-labelledby="ca-split-label">
                    <button type="button" class="btn btn-outline-secondary @(_byClass ? "" : "active")" aria-pressed="@Ui.Aria(!_byClass)" @onclick="() => _byClass = false">Nothing</button>
                    <button type="button" class="btn btn-outline-secondary @(_byClass ? "active" : "")" aria-pressed="@Ui.Aria(_byClass)" @onclick="() => _byClass = true">Classification</button>
                </span>
            </span>
        </div>
        <div class="bc-legend ca-legend">
            @if (_byClass)
            {
                <span><i class="lg danger"></i>Breach</span>
                <span><i class="lg amber"></i>Incident</span>
                <span><i class="lg low"></i>Adverse event</span>
                @if (_bars.Any(b => b.OpenedBy.Other + b.ClosedBy.Other > 0)) { <span><i class="lg other"></i>Not classified</span> }
            }
            else
            {
                <span><i class="lg accent"></i>New</span>
            }
            <span><i class="lg carry"></i>Carried over, still open</span>
            <span><i class="lg @(_byClass ? "closed-faded" : "ok")"></i>Closed (below the line@(_byClass ? ", faded" : ""))</span>
        </div>
        <div class="ca-scroll">
            <div class="ca-plot">
                @for (var i = 0; i < _bars.Count; i++)
                {
                    var b = _bars[i];
                    var idx = i;
                    <button type="button" class="ca-col @(idx == _sel ? "is-sel" : "")"
                            aria-label="@b.Label: @b.Start carried in, @b.Opened new, @b.Closed closed, @b.End still open at month end"
                            aria-pressed="@Ui.Aria(idx == _sel)"
                            @onclick="() => _sel = idx" @onmouseenter="() => _sel = idx" @onfocus="() => _sel = idx">
                        <span class="ca-up" style="height:@(Px(_topMax))px">
                            <span class="ca-stack">
                                @if (_byClass)
                                {
                                    <span class="ca-seg danger" style="height:@(Px(b.OpenedBy.Breach))px"></span>
                                    <span class="ca-seg amber" style="height:@(Px(b.OpenedBy.Incident))px"></span>
                                    <span class="ca-seg low" style="height:@(Px(b.OpenedBy.AdverseEvent))px"></span>
                                    <span class="ca-seg other" style="height:@(Px(b.OpenedBy.Other))px"></span>
                                }
                                else
                                {
                                    <span class="ca-seg accent" style="height:@(Px(b.Opened))px"></span>
                                }
                                <span class="ca-seg carry" style="height:@(Px(b.Start))px"></span>
                            </span>
                        </span>
                        <span class="ca-down" style="height:@(Px(_downMax))px">
                            <span class="ca-stack down">
                                @if (_byClass)
                                {
                                    <span class="ca-seg danger faded" style="height:@(Px(b.ClosedBy.Breach))px"></span>
                                    <span class="ca-seg amber faded" style="height:@(Px(b.ClosedBy.Incident))px"></span>
                                    <span class="ca-seg low faded" style="height:@(Px(b.ClosedBy.AdverseEvent))px"></span>
                                    <span class="ca-seg other faded" style="height:@(Px(b.ClosedBy.Other))px"></span>
                                }
                                else
                                {
                                    <span class="ca-seg ok" style="height:@(Px(b.Closed))px"></span>
                                }
                            </span>
                        </span>
                        <span class="ca-x">@b.Short</span>
                    </button>
                }
            </div>
        </div>
        @if (_bars.Count > 0)
        {
            var sel = _bars[_sel];
            <div class="ca-detail" aria-live="polite">
                <strong>@sel.Label</strong>
                <span><b>@sel.Start</b> carried in</span>
                <span><b>@sel.Opened</b> new@(_byClass ? ClassText(sel.OpenedBy) : "")</span>
                <span><b>@sel.Closed</b> closed@(_byClass ? ClassText(sel.ClosedBy) : "")</span>
                <span><b>@sel.End</b> still open at month end</span>
                <a class="ca-go" href="@CasesHref($"opened={sel.Key}&closed=true")">Cases opened in @sel.Short →</a>
            </div>
        }
    </section>

    @{ var qStuck = qs.First(q => q.Id == "po-q-stuck"); var maxPhase = Math.Max(1, _phases.Count == 0 ? 1 : _phases.Max(p => p.Count)); }
    <section class="po-q" id="@qStuck.Id" aria-labelledby="@($"{qStuck.Id}-t")">
        @QHead(qStuck, null, null)
        <div class="pipe">
            @foreach (var ph in _phases)
            {
                <a class="prow dash-link @(ph.Count == 0 ? "off" : "")" href="@CasesHref($"phase={ph.Phase}")"
                   aria-label="@($"{Ui.Label(ph.Phase)}: {ph.Count} open{PhaseDetail(ph)}")">
                    <span class="pl">@Ui.Label(ph.Phase)</span>
                    <span class="pbar">
                        <span class="track">
                            @foreach (var sv in ph.BySeverity.Where(x => x.Count > 0))
                            {
                                <span class="pseg sev-@sv.Key.ToString().ToLowerInvariant()" style="width:@Num(sv.Count * 100.0 / maxPhase)%"
                                      title="@($"{SevLabels.For(sv.Key)}: {sv.Count}")"></span>
                            }
                        </span>
                        <span class="pdetail">@(ph.Count == 0 ? "none open" : PhaseDetail(ph).TrimStart(' ', '·'))</span>
                    </span>
                    <span class="pc">@ph.Count</span>
                </a>
            }
        </div>
        <div class="bc-legend plegend">
            @foreach (var sv in Enum.GetValues<Severity>().OrderByDescending(x => x))
            {
                <span><i class="lg sev-@sv.ToString().ToLowerInvariant()"></i>@SevLabels.For(sv)</span>
            }
        </div>
    </section>

    @if (_vendor is { } v)
    {
        var qVendor = qs.First(q => q.Id == "po-q-vendor");
        <section class="po-q" id="@qVendor.Id" aria-labelledby="@($"{qVendor.Id}-t")">
            @QHead(qVendor, v.OpenCases.Count > 4 ? $"All {v.OpenCases.Count} vendor cases" : null, CasesHref("origin=ThirdParty"))
            @if (v.OpenCases.Count > 0)
            {
                <ul class="na-list">
                    @foreach (var vc in v.OpenCases.Take(4))
                    {
                        <li class="na-item po-vc">
                            <span class="na-body">
                                <span class="na-what">@vc.Vendor · @(vc.StepsAtVendor + vc.StepsInOurs == 0 ? "no attack steps recorded yet" : $"{vc.StepsAtVendor} attack step{(vc.StepsAtVendor == 1 ? "" : "s")} at the vendor{(vc.StepsInOurs > 0 ? $", {vc.StepsInOurs} in ours" : "")}")</span>
                                <a class="na-case" href="cases/@vc.Id">@vc.CaseNumber</a>
                            </span>
                            @if (vc.StepsInOurs > 0) { <span class="na-when over">In our environment</span> }
                            else if (!vc.Notified) { <span class="na-when soon">Not yet notified</span> }
                        </li>
                    }
                </ul>
            }
            <div class="po-note">
                @v.Vendors vendor@(v.Vendors == 1 ? "" : "s") with a case opened in @_windows?.Current.Label ·
                <span title="@(v.TellUsBasis > 0 ? $"Over {v.TellUsBasis} case{(v.TellUsBasis == 1 ? "" : "s")} with a first attack step at the vendor and a 'vendor notified us' milestone" : "No case yet has both a first attack step at the vendor and a 'vendor notified us' milestone")">median from the first attack step at the vendor to them telling us: @(v.MedianDaysToTellUs is { } d ? $"{Num(d)} d" : "—")</span>
            </div>
        </section>
    }

    @{ var qAttack = qs.First(q => q.Id == "po-q-attack"); }
    <section class="po-q" id="@qAttack.Id" aria-labelledby="@($"{qAttack.Id}-t")">
        @QHead(qAttack, "ATT&CK coverage", "intel/attack")
        @if (_techniques.Count > 0)
        {
            var maxTech = Math.Max(1, _techniques.Max(t => t.Cases));
            <ul class="na-list">
                @foreach (var t in _techniques)
                {
                    <li class="tq-row">
                        <span class="tq-id">@t.Id</span>
                        <span class="pbar">
                            <span class="tq-name">@t.Name</span>
                            <span class="track tq-track">
                                <span class="pseg tq-ours" style="width:@Num((t.Cases - t.AtVendor) * 100.0 / maxTech)%"></span>
                                <span class="pseg tq-vendor" style="width:@Num(t.AtVendor * 100.0 / maxTech)%"></span>
                            </span>
                        </span>
                        <span class="tq-tag">@(t.AtVendor > 0 ? $"at a vendor ×{t.AtVendor}" : "")</span>
                        <span class="pc">@t.Cases</span>
                    </li>
                }
            </ul>
            <div class="bc-legend plegend">
                <span><i class="lg tq-ours"></i>Seen in our environment</span>
                <span><i class="lg tq-vendor"></i>At a vendor</span>
            </div>
        }
    </section>

    </div>

    <aside class="po-rail" aria-label="At a glance">
        <section class="po-rc" aria-labelledby="po-glance-h">
            <h2 class="po-rc-h" id="po-glance-h">At a glance · @_windows?.Current.Label</h2>
            @foreach (var q in qs)
            {
                <a class="po-glance" href="@Anchor(q.Id)">
                    <span class="po-dot @q.Tone" aria-hidden="true"></span>
                    <span class="po-glance-q">@q.Short</span>
                    <span class="po-glance-a">@q.Brief</span>
                </a>
            }
        </section>

        <section class="po-rc" aria-labelledby="po-num-h">
            <h2 class="po-rc-h" id="po-num-h">The numbers</h2>
            <a class="po-num dash-link" href="@CasesHref()" title="View all open cases">
                <span class="po-num-l">Open cases</span><span class="po-num-v">@m.OpenCount</span>
                <span class="po-num-f">@if (_openDelta != 0) { <span class="k-delta @(_openDelta > 0 ? "up" : "down")">@(_openDelta > 0 ? "▲" : "▼") @Math.Abs(_openDelta)</span><span class="k-delta-note"> vs last month</span> } else { <span class="k-delta-note">same as last month</span> }</span>
            </a>
            @if (_cur is { } cur && _prev is { } prev)
            {
                @TimingRow("Time to detect", cur.TimeToDetect, prev.TimeToDetect, x => x.TimeToDetect)
                @TimingRow("Time to contain", cur.TimeToContain, prev.TimeToContain, x => x.TimeToContain)
                @TimingRow("Time to resolve", cur.TimeToResolve, prev.TimeToResolve, x => x.TimeToResolve)
                @TimingRow("Detect → report", cur.DetectToReport, prev.DetectToReport, x => x.DetectToReport)
            }
        </section>

        <section class="po-rc" id="po-q-target" aria-labelledby="po-target-h">
            <h2 class="po-rc-h" id="po-target-h">Within target</h2>
            @if (_cur is { } c)
            {
                var det = c.Sla.First(x => x.Clock == SlaClock.Detection);
                var con = c.Sla.First(x => x.Clock == SlaClock.Containment);
                var res = c.Sla.First(x => x.Clock == SlaClock.Resolution);
                @if (det.Met + det.Missed > 0)
                {
                    @* PROD-08: only once a detection target is set and cases carry an occurred time. *@
                    @ComplianceRow("Detection", det.Percent, det.Met, det.Missed)
                }
                @ComplianceRow("Containment", con.Percent, con.Met, con.Missed)
                @ComplianceRow("Resolution", res.Percent, res.Met, res.Missed)
                @if (m.NotifyDeadlinesEnabled)
                {
                    @ComplianceRow("Regulatory notice", c.NoticesPercent, c.NoticesMet, c.NoticesMissed)
                }
                @if (c.ContainmentBySeverity?.Where(x => x.TargetHours is not null || x.Met + x.Missed > 0).ToList() is { Count: > 0 } sev
                     && sev.Any(x => x.Met + x.Missed > 0))
                {
                    <div class="sev-wrap">
                        <table class="sev-table">
                            <caption>Containment by severity</caption>
                            <thead><tr><th scope="col"></th>@foreach (var x in sev) { <th scope="col">@SevLabels.For(x.Severity)</th> }</tr></thead>
                            <tbody>
                                <tr><th scope="row">Target</th>@foreach (var x in sev)
                                {
                                    <td title="@(x.OwnTargets ? "Breach or third-party cases of this severity have targets of their own" : null)">@(x.TargetHours is { } h ? $"{h} h" : "—")@(x.OwnTargets ? "*" : "")</td>
                                }</tr>
                                <tr><th scope="row">Met</th>@foreach (var x in sev)
                                {
                                    var judged = x.Met + x.Missed;
                                    <td class="@(judged > 0 && x.Met * 100 / judged < 75 ? "sev-bad" : "")">@(judged == 0 ? "—" : $"{x.Met} of {judged}")</td>
                                }</tr>
                            </tbody>
                        </table>
                        @if (sev.Any(x => x.OwnTargets))
                        {
                            <div class="small text-muted mt-1">* The general target. Breach or third-party cases of that severity have targets of their own.</div>
                        }
                    </div>
                }
            }
            <div class="po-note">Per-severity targets in <a class="dash-link u-link" href="admin/settings/sla">Response &amp; SLA</a>, over the milestones reached in @_windows?.Current.Label.</div>
        </section>

        <section class="po-rc" id="po-q-learn" aria-labelledby="po-learn-h">
            <h2 class="po-rc-h" id="po-learn-h">Learning loop</h2>
            @if (_cur is { } lc)
            {
                var reviewPct = lc.Closed == 0 ? (int?)null : (int)Math.Round(lc.ClosedWithReview * 100.0 / lc.Closed);
                <div class="cmp @(reviewPct is null ? "cmp-na" : "")">
                    <div class="cmp-head"><span class="cmp-label">Closed with a post-incident review</span>
                        <span class="cmp-val">@(reviewPct is { } rp ? $"{rp}%" : "—")</span></div>
                    <div class="cmp-track">@if (reviewPct is { } rpv) { <span class="cmp-fill @ComplianceTone(rpv)" style="width:@rpv%"></span> }</div>
                    <div class="cmp-note">@(lc.Closed == 0 ? $"no cases closed in {_windows!.Current.Label}" : $"{lc.ClosedWithReview} of {lc.Closed} · {lc.Closed - lc.ClosedWithReview} without one")</div>
                </div>
                <div class="po-figs">
                    <div><b>@lc.ActionsOpenAtEnd</b><span>actions open</span></div>
                    <div><b class="@(lc.ActionsPastTargetAtEnd > 0 ? "ll-warn" : "")">@lc.ActionsPastTargetAtEnd</b><span>past target</span></div>
                    <div><b class="@(lc.ActionsCompleted > 0 ? "ll-ok" : "")">@lc.ActionsCompleted</b><span>completed</span></div>
                    <div><b>@lc.ActionsNotPursued</b><span>not pursued</span></div>
                </div>
                @if (lc.OpenActionAreas is { Count: > 0 } areas)
                {
                    var maxArea = Math.Max(1, areas.Max(x => x.Count));
                    <div class="k-label ll-label">Open actions by area</div>
                    <div class="pipe">
                        @foreach (var ar in areas.Take(5))
                        {
                            <div class="prow ll-row">
                                <span class="pl">@ar.Key</span>
                                <span class="track"><span class="pseg tq-ours" style="width:@Num(ar.Count * 100.0 / maxArea)%"></span></span>
                                <span class="pc">@ar.Count</span>
                            </div>
                        }
                    </div>
                }
            }
            <a class="po-rc-go" href="@ActionsHref">Improvement actions →</a>
        </section>
    </aside>
    </div>

    <p class="dash-foot">Medians lead and means sit beneath them, since one long case pulls a mean far off. Every figure
        covers the cases you can see@(Exercises ? ", exercises included" : "; exercise cases are left out").</p>
}
</div>

@code {
    [SupplyParameterFromQuery(Name = "period")] public string? Period { get; set; }
    [SupplyParameterFromQuery(Name = "exercises")] public string? ExercisesRaw { get; set; }
    private bool Exercises => QueryValue.Flag(ExercisesRaw);   // BUG-31: a bad value is ignored, not an error
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? To { get; set; }
    [SupplyParameterFromQuery(Name = "team")] public string? TeamRaw { get; set; }   // CAP-36: a team key, or none

    // CAP-36: the teams for the picker, and the team kept on every link the page writes (C15: from its own state).
    private List<IncidentManager.Application.Admin.TeamView> _teams = [];
    private string TeamSuffix => string.IsNullOrWhiteSpace(TeamRaw) ? "" : "&team=" + Uri.EscapeDataString(TeamRaw.Trim());
    private string MetricsHref => $"export/metrics.csv?exercises={(Exercises ? "true" : "false")}{TeamSuffix}";
    // CAP-36 review (C15): the register for the team shown here (its learning-loop figures are that team's).
    private string ActionsHref => ProgramNav.WithTeam("program/improvement-actions", TeamRaw);

    protected override async Task OnInitializedAsync() => _teams = await TeamsSvc.ListAsync();

    private void PickTeam(ChangeEventArgs e) =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("team", e.Value?.ToString() is { Length: > 0 } key ? key : null));

    private bool _customOpen;
    private DateTime? _from, _to;
    private string? _customError;
    private DateOnly Today => IncidentManager.Application.Abstractions.ZonedDays.Of(Clock.UtcNow, OrgZone.Current);

    private DashboardMetrics? _metrics;
    private NeedsAction? _needs;
    private IReadOnlyList<PhaseAging> _phases = [];
    private VendorCases? _vendor;
    private sealed record TopTechnique(string Id, string Name, int Cases, int AtVendor);
    private IReadOnlyList<TopTechnique> _techniques = [];
    private int _tacticsSeen, _tacticsAll;
    private bool _showAllNeeds;
    private const int NeedsShown = 6;
    private string? _asOf;
    // BUG-614: the field takes the years the server does (the date fields' own min is 1970).
    private static readonly string RangeMin = OverviewWindows.MinRangeYear.ToString("D4", System.Globalization.CultureInfo.InvariantCulture) + "-01-01";
    private OverviewPeriod _period;
    private OverviewWindows? _windows;
    private ProgramSnapshot? _cur, _prev;
    private IReadOnlyList<ProgramSnapshot> _monthly = [];

    private static readonly (string Key, string Label)[] PeriodChoices =
        [("30d", "30 days"), ("quarter", "This quarter"), ("12m", "12 months")];

    // BUG-434: a drill-in to the Cases list includes exercises when the overview does, so the list matches its count.
    private string CasesHref(string? query = null)
    {
        // CAP-36: and the team the overview is filtered to, so the list holds the cases the figure counted.
        var q = string.Join("&", new[] { query, Exercises ? "exercises=true" : null, TeamSuffix.TrimStart('&') }.Where(x => !string.IsNullOrEmpty(x)));
        // BUG-453: never a bare "cases", which bounces to the user's default view; scope=all is read as All.
        return q.Length == 0 ? "cases?scope=all" : $"cases?{q}";
    }

    private string Href(string period, bool exercises) =>
        $"program?period={period}{(exercises ? "&exercises=true" : "")}{TeamSuffix}";

    // The current period, with or without exercises: a custom range keeps its dates.
    private string SameRange(bool exercises) => _period == OverviewPeriod.Custom
        ? $"program?from={From}&to={To}{(exercises ? "&exercises=true" : "")}{TeamSuffix}"
        : Href(OverviewWindows.Key(_period), exercises);

    private void ApplyCustom()
    {
        var (f, t) = (_from is { } a ? DateOnly.FromDateTime(a).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) : null,
                      _to is { } b ? DateOnly.FromDateTime(b).ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) : null);
        if (OverviewWindows.TryRange(f, t, Today, out var error) is null)
        {
            _customError = error ?? "Give both dates.";
            return;
        }
        _customError = null;
        Nav.NavigateTo($"program?from={f}&to={t}{(Exercises ? "&exercises=true" : "")}{TeamSuffix}");
    }

    private IReadOnlyList<BarPoint> _bars = [];
    private int _openDelta, _openedTotal, _closedTotal, _topMax, _downMax;
    private double _unit;
    private bool _byClass;
    private int _sel;
    private static readonly ClassificationCounts None = new(0, 0, 0, 0);

    private sealed record BarPoint(string Key, string Label, string Short, int Start, int Opened, int Closed, int End,
        ClassificationCounts OpenedBy, ClassificationCounts ClosedBy);

    // BUG-346: a period picked while the last is still loading supersedes it: the older load is cancelled, and its
    // answer dropped if it lands anyway, so it can't overwrite the newer figures (or mix with them, one tile at a time).
    private CancellationTokenSource? _cts;
    private int _seq;

    protected override async Task OnParametersSetAsync()
    {
        var now = Clock.UtcNow;
        OverviewPeriod period;
        OverviewWindows windows;
        if (OverviewWindows.TryRange(From, To, Today, out var rangeError) is { } range)
        {
            period = OverviewPeriod.Custom;
            windows = OverviewWindows.ForRange(range.From, range.To, now, OrgZone.Current);
            (_from, _to, _customOpen, _customError) = (range.From.ToDateTime(TimeOnly.MinValue), range.To.ToDateTime(TimeOnly.MinValue), false, null);
        }
        else
        {
            // A bad range in the URL opens the form and says why; the figures fall back to the chosen period.
            period = OverviewWindows.Parse(Period);
            windows = OverviewWindows.For(period, now, OrgZone.Current);
            if (rangeError is not null) (_customOpen, _customError) = (true, rangeError);
        }

        var previous = _cts;   // replaced before the await, so a load started meanwhile never has its own disposed
        var seq = ++_seq;
        var cts = _cts = new CancellationTokenSource();
        var ct = cts.Token;   // read now: the page may be disposed (and cts with it) while the last load is cancelled
        if (previous is not null)
        {
            await previous.CancelAsync();
            previous.Dispose();
        }
        var exercises = Exercises;
        TeamScope team;
        DashboardMetrics metrics;
        NeedsAction needs;
        IReadOnlyList<PhaseAging> phases;
        VendorCases vendor;
        IncidentManager.Application.Mitre.AttackCoverage coverage;
        IReadOnlyList<ProgramSnapshot> snaps;
        try
        {
            team = await TeamsSvc.ScopeAsync(TeamRaw, ct);   // CAP-36: read as the Cases list reads team=
            metrics = await Dashboard.GetAsync(exercises, withSlaHistory: true, team, ct);
            needs = await NeedsActionSvc.GetAsync(exercises, team, ct);
            phases = await Dashboard.PhaseAgingAsync(exercises, team, ct);
            vendor = await Vendors.GetAsync(windows.Current, exercises, team, ct);
            coverage = await Coverage.GetForPeriodAsync(windows.Current.StartUtc, windows.Current.EndUtc, exercises, team, ct);
            snaps = await ProgramFigures.SnapshotsAsync([windows.Current, windows.Previous, .. windows.Months], exercises, team, ct);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested) { return; }   // superseded
        if (seq != _seq) return;

        (_period, _windows) = (period, windows);
        (_metrics, _needs, _phases, _vendor) = (metrics, needs, phases, vendor);
        _techniques = coverage.Tactics.SelectMany(t => t.Techniques).GroupBy(t => t.TechniqueId)
            .Select(g => new TopTechnique(g.Key, g.First().Name,
                g.SelectMany(t => t.Cases).Select(c => c.CaseId).Distinct().Count(),
                g.SelectMany(t => t.Cases).Where(c => c.ThirdParty).Select(c => c.CaseId).Distinct().Count()))
            .OrderByDescending(t => t.Cases).ThenBy(t => t.Id, StringComparer.Ordinal).Take(6).ToList();
        _tacticsSeen = coverage.Tactics.Count(t => t.Tactic != MitreTactic.Unspecified && t.CaseCount > 0);
        _tacticsAll = Enum.GetValues<MitreTactic>().Count(t => t != MitreTactic.Unspecified);
        (_cur, _prev, _monthly) = (snaps[0], snaps[1], snaps.Skip(2).ToList());
        _asOf = TimeDisp.TimeOnly(now);

        var t = _metrics.Trend;
        _openedTotal = t.Sum(x => x.Opened);
        _closedTotal = t.Sum(x => x.Closed);
        _openDelta = t.Count >= 2 ? t[^1].OpenAtEnd - t[^2].OpenAtEnd : 0;

        _bars = t.Select(x =>
        {
            var d = new DateTime(x.Year, x.Month, 1);
            // BUG-476: the key drives the Cases opened= drill-in, so it is Gregorian whatever the server culture.
            return new BarPoint(d.ToString("yyyy-MM", System.Globalization.CultureInfo.InvariantCulture), d.ToString("MMMM yyyy"), d.ToString("MMM"),
                x.OpenAtStart, x.Opened, x.Closed, x.OpenAtEnd, x.OpenedBy ?? None, x.ClosedBy ?? None);
        }).ToList();
        _sel = Math.Max(0, _bars.Count - 1);   // the latest month until another is picked

        // One scale above and below the line, so a closed bar as tall as a new one is the same number of cases.
        _topMax = Math.Max(1, _bars.Count == 0 ? 1 : _bars.Max(b => b.Start + b.Opened));
        _downMax = Math.Max(1, _bars.Count == 0 ? 1 : _bars.Max(b => b.Closed));
        _unit = Math.Min(16, 150.0 / _topMax);
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private string Px(int cases) => (cases * _unit).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static string ClassText(ClassificationCounts c)
    {
        var parts = new List<string>();
        if (c.Breach > 0) parts.Add($"{c.Breach} breach{(c.Breach == 1 ? "" : "es")}");
        if (c.Incident > 0) parts.Add($"{c.Incident} incident{(c.Incident == 1 ? "" : "s")}");
        if (c.AdverseEvent > 0) parts.Add($"{c.AdverseEvent} adverse");
        if (c.Other > 0) parts.Add($"{c.Other} not classified");
        return parts.Count == 0 ? "" : $" ({string.Join(", ", parts)})";
    }

    // A timing row in the rail: the period's median, a 12-month trend line of the monthly medians, its change on the period
    // before and the mean. Lower is better for every timing here.
    private RenderFragment TimingRow(string label, Interval cur, Interval prev, Func<ProgramSnapshot, Interval> pick) => __builder =>
    {
        var points = _monthly.Select(pick).Select(i => i.MedianHours).ToList();
        <div class="po-num">
            <span class="po-num-l">@label</span>
            <span class="po-num-v">@(cur.MedianHours is { } md ? $"{Num(md)} h" : "—")</span>
            @if (Spark(points) is { } line)
            {
                <svg class="po-spark" viewBox="0 0 100 24" preserveAspectRatio="none" role="img"
                     aria-label="@($"{label}, monthly median over the last 12 months")">
                    <polyline points="@line" fill="none" stroke-width="2" vector-effect="non-scaling-stroke"
                              stroke-linejoin="round" stroke-linecap="round" style="stroke: var(--accent)" />
                </svg>
            }
            <span class="po-num-f">
                @if (cur.MedianHours is { } c && prev.MedianHours is { } p && Math.Abs(c - p) >= 0.05)
                {
                    <span class="k-delta @(c < p ? "down" : "up")">@(c < p ? "▼" : "▲") @Num(Math.Abs(c - p)) h</span><span class="k-delta-note"> vs @_windows!.Previous.Label</span>
                }
                else if (cur.MedianHours is null)
                {
                    <span class="k-delta-note">none in @_windows!.Current.Label</span>
                }
                @if (cur.MeanHours is { } mean) { <span class="k-delta-note"> · median; mean @Num(mean) h, @Plural.Of(cur.Count, "case")</span> }
            </span>
        </div>
    };

    // Program redesign: each card's question, its one-line answer (Lead coloured by Tone when it needs attention), and
    // the short form the rail's "At a glance" shows. Tone: dan, warn, ok, mut (a dot's colour; mut is no signal).
    private sealed record Q(string Id, string Question, string Short, string Tone, RenderFragment Answer, string Brief);

    private static RenderFragment Ans(string prefix, string? tone, string lead, string rest) => __builder =>
    {
        <text>@prefix</text>
        if (tone is null) { <text>@lead</text> }
        else { <span class="po-a-@tone">@lead</span> }
        <text>@rest</text>
    };

    private static string S(int n, string one, string many) => n == 1 ? one : many;

    private List<Q> Questions()
    {
        var now = Clock.UtcNow;
        var list = new List<Q>();

        if (_needs is { NotifyDeadlinesEnabled: true } n)
        {
            var worst = n.Clocks.OrderBy(c => c.State == SlaState.Breached ? 0 : c.State == SlaState.AtRisk ? 1 : 2).ThenBy(c => c.DueAtUtc).FirstOrDefault();
            const string q = "Do we owe a regulator anything?";
            if (worst is null)
                list.Add(new("po-q-reg", q, "Owed to a regulator", "ok", Ans("", "ok", "No.", " No notification clock is running."), "nothing running"));
            else
            {
                var span = Dur((worst.DueAtUtc - now).Duration());
                var more = n.Clocks.Count > 1 ? $" {n.Clocks.Count - 1} more running." : "";
                list.Add(worst.State switch
                {
                    SlaState.Breached => new Q("po-q-reg", q, "Owed to a regulator", "dan",
                        Ans("", "dan", $"Yes. {worst.Jurisdiction} is {span} overdue", $" on {worst.CaseNumber}.{more}"), $"{worst.Jurisdiction}, {span} overdue"),
                    SlaState.AtRisk => new Q("po-q-reg", q, "Owed to a regulator", "warn",
                        Ans("", "warn", $"Yes. {worst.Jurisdiction} is due in {span}", $" on {worst.CaseNumber}.{more}"), $"{worst.Jurisdiction}, due in {span}"),
                    _ => new Q("po-q-reg", q, "Owed to a regulator", "mut",
                        Ans("", null, $"Yes, {n.Clocks.Count} {S(n.Clocks.Count, "notice", "notices")} running", $"; the next is due in {span}."), $"{n.Clocks.Count} running, none at risk"),
                });
            }
        }

        if (_needs is { } na)
        {
            const string q = "What needs action?";
            var over = na.Items.Where(i => i.Over && i.Kind != NeedsActionKind.Brief).ToList();
            if (over.Count > 0)
            {
                var oldest = Dur(over.Max(i => now - i.DueAtUtc));
                list.Add(new("po-q-late", q, "Needs action", "dan", Ans("", "dan", $"{over.Count} past due", $"; the oldest by {oldest}."), $"{over.Count} past due, oldest {oldest}"));
            }
            else if (na.Items.Count > 0)
                list.Add(new("po-q-late", q, "Needs action", "warn", Ans("", "warn", $"{na.Items.Count} {S(na.Items.Count, "item needs", "items need")} action", ", none past due yet."), $"{na.Items.Count}, none past due"));
            else
                list.Add(new("po-q-late", q, "Needs action", "ok", Ans("", "ok", "Nothing.", " No notice at risk, no target missed, no overdue task."), "nothing"));
        }

        var open = _metrics?.OpenCount ?? 0;
        var delta = _openDelta == 0 ? ", the same as last month." : $", {(_openDelta > 0 ? "up" : "down")} {Math.Abs(_openDelta)} on last month.";
        list.Add(new("po-q-open", "How much is open?", "How much is open", "mut",
            Ans("", null, Plural.Of(open, "open case"), delta), _openDelta == 0 ? $"{open}" : $"{open}, {(_openDelta > 0 ? "up" : "down")} {Math.Abs(_openDelta)}"));

        if (_cur?.Sla.FirstOrDefault(x => x.Clock == SlaClock.Containment) is { } con)
        {
            var judged = con.Met + con.Missed;
            list.Add(con.Percent is { } pct
                ? new Q("po-q-target", "Are we containing in time?", "Containing in time", pct >= 90 ? "ok" : pct >= 75 ? "warn" : "dan",
                    Ans("", null, "", ""), $"{con.Met} of {judged} within target")
                : new Q("po-q-target", "Are we containing in time?", "Containing in time", "mut", Ans("", null, "", ""), "no case with a target yet"));
        }

        {
            const string q = "Where are open cases stuck?";
            var busy = _phases.Where(p => p.Count > 0).ToList();
            if (busy.Count == 0)
                list.Add(new("po-q-stuck", q, "Where cases are stuck", "ok", Ans("", "ok", "Nowhere.", " No case is open."), "none open"));
            else
            {
                var top = busy.OrderByDescending(p => p.Count).ThenByDescending(p => p.LongestInPhase).First();
                var overTarget = busy.Sum(p => p.OverTarget);
                var longest = top.LongestInPhase is { } l ? $", the longest {Dur(l)}" : "";
                list.Add(new("po-q-stuck", q, "Where cases are stuck", overTarget > 0 ? "warn" : "mut",
                    Ans($"{Ui.Label(top.Phase)} holds the most: ", overTarget > 0 ? "warn" : null, $"{top.Count}{longest}", "."),
                    $"{Ui.Label(top.Phase)}: {top.Count}{(top.LongestInPhase is { } l2 ? $", longest {Dur(l2)}" : "")}"));
            }
        }

        if (_vendor is { } v)
        {
            const string q = "Anything from our vendors?";
            var inOurs = v.OpenCases.Count(x => x.StepsInOurs > 0);
            var notTold = v.OpenCases.Count(x => !x.Notified);
            var cases = Plural.Of(v.Open, "open vendor case");
            if (v.Open == 0)
                list.Add(new("po-q-vendor", q, "Vendors", "mut", Ans("", null, "No vendor case is open.", ""), "none open"));
            else if (inOurs > 0)
                list.Add(new("po-q-vendor", q, "Vendors", "dan", Ans("", "dan", cases, $"; {inOurs} with attack steps in our environment."), $"{v.Open} open, {inOurs} in ours"));
            else if (notTold > 0)
            {
                var who = notTold == v.Open ? (v.Open == 1 ? "the vendor hasn't" : v.Open == 2 ? "neither vendor has" : "no vendor has") : $"{notTold} vendors haven't";
                list.Add(new("po-q-vendor", q, "Vendors", "warn", Ans("", "warn", $"{cases}, and {who} told us yet.", ""), $"{v.Open} open, {notTold} not told us"));
            }
            else
                list.Add(new("po-q-vendor", q, "Vendors", "mut", Ans("", null, cases, "; every vendor has told us."), $"{v.Open} open"));
        }

        {
            const string q = "What are attackers doing?";
            if (_techniques.FirstOrDefault() is { } t)
                list.Add(new("po-q-attack", q, "What attackers do", "mut",
                    Ans("", null, $"{t.Name} ({t.Id}), on {Plural.Of(t.Cases, "case")}.", $" {_tacticsSeen} of {_tacticsAll} tactics seen."), $"{t.Name}, {Plural.Of(t.Cases, "case")}"));
            else
                list.Add(new("po-q-attack", q, "What attackers do", "mut", Ans("", null, $"No ATT&CK technique recorded in {_windows?.Current.Label}.", ""), "none recorded"));
        }

        if (_cur is { } lc)
        {
            var (openA, past) = (lc.ActionsOpenAtEnd, lc.ActionsPastTargetAtEnd);
            list.Add(new("po-q-learn", "Are we learning?", "Are we learning", past > 0 ? "warn" : openA > 0 ? "ok" : "mut", Ans("", null, "", ""),
                past > 0 ? $"{openA} open, {past} past target" : openA > 0 ? $"{openA} open, none late" : "no action open"));
        }
        return list;
    }

    // The page's first line: what's open, then what is overdue to a regulator and past due.
    private RenderFragment Lede() => __builder =>
    {
        var open = _metrics?.OpenCount ?? 0;
        var late = _needs?.Clocks.Count(c => c.State == SlaState.Breached) ?? 0;
        var over = _needs?.Items.Count(i => i.Over && i.Kind != NeedsActionKind.Brief) ?? 0;
        <b>@open open</b><text>@(_openDelta == 0 ? "" : $", {(_openDelta > 0 ? "up" : "down")} {Math.Abs(_openDelta)} on last month").</text>
        if (late > 0)
        {
            <text>@(" ")</text><span class="po-a-dan">@late regulator @S(late, "notice is", "notices are") overdue</span><text>@(over > 0 ? " and" : ".")</text>
        }
        if (over > 0)
        {
            <text>@($" {over} {S(over, "item is", "items are")} past due.")</text>
        }
        else if (late == 0)
        {
            <text>@(" Nothing is past due.")</text>
        }
    };

    private RenderFragment QHead(Q q, string? goText, string? goHref) => __builder =>
    {
        <div class="po-q-head">
            <span class="po-dot @q.Tone" aria-hidden="true"></span>
            <h2 class="po-q-q" id="@($"{q.Id}-t")">@q.Question</h2>
            @if (goText is not null && goHref is not null) { <a class="po-q-go" href="@goHref">@goText →</a> }
        </div>
        <p class="po-q-a">@q.Answer</p>
    };

    // The rail's links to a card on this page: the page's own address (base-relative, so not the site root) with the anchor.
    private string Anchor(string id) => $"{Nav.ToBaseRelativePath(Nav.Uri).Split('#')[0]}#{id}";

    private static string PhaseDetail(PhaseAging p) =>
        p.Count == 0 ? "" : $" · longest {Dur(p.LongestInPhase ?? TimeSpan.Zero)}{(p.OverTarget > 0 ? $" · {p.OverTarget} over target" : "")}";

    private static string KindLabel(NeedsActionKind k) => k switch
    {
        NeedsActionKind.Notify => "Notify",
        NeedsActionKind.Sla => "Target",
        NeedsActionKind.Brief => "Brief",
        NeedsActionKind.Tasks => "Tasks",
        _ => "Actions"
    };

    private static string KindTone(NeedsActionItem it) => it.Kind switch
    {
        NeedsActionKind.Notify => "warn",
        NeedsActionKind.Sla => it.Over ? "bad" : "warn",
        NeedsActionKind.Brief => "info",
        _ => "neutral"
    };

    private string When(NeedsActionItem it)
    {
        var span = (it.DueAtUtc - Clock.UtcNow).Duration();
        return it.Kind switch
        {
            NeedsActionKind.Brief => $"{Dur(span)} ago",
            NeedsActionKind.Tasks or NeedsActionKind.Actions => $"oldest {Dur(span)} over",
            _ => it.Over ? $"{Dur(span)} over" : $"due in {Dur(span)}"
        };
    }

    private string ClockDue(NotificationClock c)
    {
        var span = (c.DueAtUtc - Clock.UtcNow).Duration();
        return c.State == SlaState.Breached ? $"{Dur(span)} over" : $"due in {Dur(span)}";
    }

    private static string Dur(TimeSpan t) =>
        t.TotalHours < 1 ? $"{Math.Max(1, (int)t.TotalMinutes)} min"
        : t.TotalHours < 48 ? $"{(int)t.TotalHours} h"
        : $"{(int)t.TotalDays} d{(t.Hours > 0 ? $" {t.Hours} h" : "")}";

    private static string Num(double v) => v.ToString(v >= 100 ? "0" : "0.#", System.Globalization.CultureInfo.InvariantCulture);

    // Points for a 0..100 × 0..24 trend line over the months that have a value; null with fewer than two.
    private static string? Spark(IReadOnlyList<double?> values)
    {
        var known = values.Select((v, i) => (v, i)).Where(x => x.v is not null).ToList();
        if (known.Count < 2) return null;
        double lo = known.Min(x => x.v!.Value), hi = known.Max(x => x.v!.Value), span = Math.Max(hi - lo, 0.001);
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        return string.Join(" ", known.Select(x =>
            $"{(x.i * 100.0 / Math.Max(1, values.Count - 1)).ToString("0.#", inv)},{(22 - (x.v!.Value - lo) / span * 20).ToString("0.#", inv)}"));
    }

    private static string Flex(int n) => Math.Max(0.0001, n).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private RenderFragment ComplianceRow(string label, int? pct, int met, int missed) => @<div class="cmp @(pct is null ? "cmp-na" : "")">
        <div class="cmp-head">
            <span class="cmp-label">@label</span>
            <span class="cmp-val">@(pct is { } p ? $"{p}%" : "—")</span>
        </div>
        <div class="cmp-track">
            @if (pct is { } pv)
            {
                <span class="cmp-fill @ComplianceTone(pv)" style="width:@pv%"></span>
            }
        </div>
        <div class="cmp-note">@(pct is null ? "no cases with a target yet" : $"{met} met · {missed} missed of {met + missed}")</div>
    </div>;

    private static string ComplianceTone(int pct) => pct >= 90 ? "ok" : pct >= 75 ? "warn" : "bad";
}
