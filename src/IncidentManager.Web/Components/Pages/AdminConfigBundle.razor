@page "/admin/config-bundle"
@using IncidentManager.Application.Config
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize(Policy = Policies.Administer)]
@layout AdminLayout
@inject ConfigBundleService Config
@inject ToastService Toasts
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IncidentManager.Application.Abstractions.ISealSigner Signer

<PageTitle>Configuration bundle</PageTitle>

<PageHeader Title="Configuration bundle">
    <Actions>
        <span class="im-badge im-b-neutral"><span class="bi bi-shield-lock me-1"></span>SysAdmin only</span>
    </Actions>
</PageHeader>
<p class="text-muted">
    Export this instance's <strong>editable configuration</strong> as one signed, versioned JSON file. Use it to
    <strong>snapshot</strong> the current setup, <strong>diff</strong> it against an IRP revision,
    <strong>promote</strong> config from test to production, or <strong>stand up a new white-label instance</strong>
    from a known baseline. The file carries its signature and public key, so authenticity can be checked offline.
</p>
<p class="text-muted small">
    <span class="bi bi-info-circle me-1"></span>The bundle covers operational and taxonomy <strong>settings</strong>,
    <strong>roles</strong> and AD mappings, <strong>case templates</strong>, <strong>stage gates</strong>,
    <strong>report profiles</strong> with their <strong>Word templates</strong>, <strong>data elements</strong> and <strong>notification rules</strong>. It
    excludes cases, evidence and the audit trail, and server-side security and infrastructure config such as
    connection strings, auth mode, signing keys and the SIEM endpoint.
</p>

<div class="card mb-3">
    <div class="card-header"><span class="bi bi-box-arrow-down me-1"></span>Export</div>
    <div class="card-body">
        @if (_bundle is null)
        {
            <LoadingBlock />
        }
        else
        {
            <p class="small text-muted mb-2">This instance's bundle currently contains:</p>
            <ul class="mb-3">
                <li>@_bundle.Settings.Count setting(s)</li>
                <li>@_bundle.Roles.Count role(s) and @_bundle.RoleMappings.Count AD mapping(s)</li>
                <li>@_bundle.CaseTemplates.Count case template(s)</li>
                <li>@_bundle.StageGates.Count stage gate(s)</li>
                <li>@_bundle.ReportProfiles.Count report profile(s) and @(_bundle.ReportTemplates?.Count ?? 0) Word template(s)</li>
                <li>@_bundle.DataElements.Count data element(s)</li>
                <li>@_bundle.NotificationRules.Count notification rule(s)</li>
            </ul>
            <a class="btn btn-sm btn-primary" href="/export/config-bundle.json" download
               title="Download the signed configuration bundle">
                <span class="bi bi-download me-1"></span>Download configuration bundle
            </a>
            <p class="small text-muted mt-2 mb-0">The download is recorded in the audit trail.</p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-header"><span class="bi bi-box-arrow-in-up me-1"></span>Import</div>
    <div class="card-body">
        <p class="small text-muted">
            Upload a bundle to apply it here. The signature is checked first, then you'll see a <strong>preview</strong> of
            every change before anything is written. Import is <strong>additive</strong>: existing items are updated and
            new ones added, but nothing is deleted. Word templates are checked again, as on upload. Every change is audited.
        </p>
        <div class="alert alert-warning small py-2">
            <span class="bi bi-exclamation-triangle me-1"></span>Importing <strong>roles</strong> and <strong>AD mappings</strong>
            changes who can access this instance. Review the preview carefully, since AD group names differ between organizations.
        </div>

        <InputFile OnChange="OnFileSelected" accept=".json" class="form-control form-control-sm" style="max-width:28rem" disabled="@_applying" />
        <div class="form-text">A bundle file of up to @(MaxBundleBytes / 1024 / 1024) MB, the size of a large Word template library.</div>

        @if (_verification is not null)
        {
            <div class="mt-3">
                @if (!_verification.SignatureValid)
                {
                    <div class="alert alert-danger py-2 mb-2">
                        <span class="bi bi-shield-x me-1"></span><strong>Signature invalid.</strong> This bundle was altered
                        after it was signed, or is corrupt. It can't be imported. Export a fresh bundle from the source instance.
                    </div>
                }
                else
                {
                    <div class="alert @(_verification.Trust == ConfigBundleTrust.Unknown ? "alert-warning" : "alert-success") py-2 mb-2">
                        <span class="bi bi-shield-check me-1"></span>Signature valid:
                        @(_verification.Trust switch
                        {
                            ConfigBundleTrust.ThisServer => "signed by this instance",
                            ConfigBundleTrust.TrustedKey => $"signed with a trusted key ({_verification.TrustedKeyFile})",
                            _ => "signed by another instance",
                        })
                        (key <code>@(_verification.CarriedKeyId ?? _verification.KeyId)</code>). Exported by <strong title="@_verification.ExportedBy">@Users.DisplayFor(_verification.ExportedBy)</strong>
                        from <strong>@_verification.SourceHost</strong> on @TimeDisplay.UtcLabelled(_verification.ExportedAtUtc).
                        @if (_verification.Trust == ConfigBundleTrust.Unknown)
                        {
                            @* BUG-19: say what the signature does and doesn't prove, before anyone relies on it. CAP-16: the admin
                               names the key by typing its id, checked against the source, rather than ticking a box. *@
                            <div class="mt-1">This server neither holds nor trusts that key, so the signature shows the bundle wasn't
                                changed after it was signed, not who signed it: anyone can sign a bundle with a key of their own, and the
                                exporter, host and date above are part of what was signed. Check the key id on the source server's
                                <strong>Integrity</strong> page (Signing key), then type it here to import. To trust that source from now
                                on, put its public key in the trusted keys folder (below).</div>
                            <label class="form-label small mt-2 mb-1" for="cfg-keyid">Key id, as the source server shows it</label>
                            <input class="form-control form-control-sm font-monospace" id="cfg-keyid" style="max-width:20rem"
                                   autocomplete="off" spellcheck="false" maxlength="64" disabled="@_applying"
                                   aria-describedby="cfg-keyid-help" @bind="_confirmedKeyId" @bind:event="oninput" />
                            <div id="cfg-keyid-help" class="form-text">@(KeyIdTyped ? "That's the key this bundle carries." : "16 characters, letters a to f and digits.")</div>
                        }
                    </div>
                }

                @if (_diff is not null)
                {
                    @foreach (var w in _diff.Warnings ?? [])
                    {
                        <div class="alert alert-warning py-2 small mb-2"><span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>@w</div>
                    }
                    <p class="mb-1">
                        <span class="im-badge im-b-success">@_diff.Added to add</span>
                        <span class="im-badge im-b-info ms-1">@_diff.Updated to update</span>
                        <span class="im-badge im-b-neutral ms-1">@_diff.Unchanged unchanged</span>
                    </p>
                    @if (_diff.HasChanges)
                    {
                        <div class="table-responsive" style="max-height:16rem;overflow:auto">
                            <table class="table table-sm mb-2">
                                <thead><tr><th style="width:9rem"></th><th style="width:8rem">Section</th><th>Item</th></tr></thead>
                                <tbody>
                                    @foreach (var c in _diff.Changes)
                                    {
                                        <tr>
                                            <td>
                                                @if (c.Change == ConfigChange.Add) { <span class="im-badge im-b-success">Add</span> }
                                                else { <span class="im-badge im-b-info">Update</span> }
                                            </td>
                                            <td class="small text-muted">@c.Section</td>
                                            <td>@c.Name</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <button class="btn btn-sm btn-primary" @onclick="Apply"
                                disabled="@(!_verification.SignatureValid || _applying || (_verification.Trust == ConfigBundleTrust.Unknown && !KeyIdTyped))">
                            <span class="bi bi-check2-circle me-1"></span>Apply import (@IncidentManager.Application.Common.Plural.Of(_diff.Changes.Count, "change"))
                        </button>
                    }
                    else
                    {
                        <p class="text-muted mb-0">This bundle matches the live configuration. Nothing to apply.</p>
                    }
                    <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="ClearUpload" disabled="@_applying">Cancel</button>
                }
            </div>
        }
    </div>
</div>

@* CAP-16: the keys a bundle may be signed with and import without asking. Read-only: they're set on the server, so the
   people an import could give access to can't add one. Public keys only. *@
<div class="card mb-3">
    <div class="card-header"><span class="bi bi-key me-1" aria-hidden="true"></span>Trusted signing keys</div>
    <div class="card-body">
        <p class="small text-muted">
            A bundle imports without asking when it's signed by this server (key <code>@Signer.KeyId</code>) or with one of
            these keys. Any other key's id has to be typed to import its bundle. They're public keys in PEM form, kept in the
            folder named by <code>Config:TrustedBundleKeys</code> in the server's configuration, and read when CaseBook
            starts (see <code>docs/operations/configuration.md</code>).
        </p>
        @if (Config.TrustedKeysFolder is not { } folder)
        {
            <p class="small mb-0"><span class="im-badge im-b-neutral">None</span>
                <span class="text-muted ms-1">no folder is set, so only this server's own bundles import without a typed key id.</span></p>
        }
        else
        {
            <p class="small mb-2">Folder: <code style="word-break:break-all">@folder</code></p>
            @if (Config.TrustedKeys.Count == 0)
            {
                <p class="small mb-0"><span class="im-badge im-b-neutral">None</span>
                    <span class="text-muted ms-1">the folder holds no <code>.pem</code> keys, or wasn't there when CaseBook started.</span></p>
            }
            else
            {
                <table class="table table-sm mb-0">
                    <thead><tr><th scope="col" style="width:12rem">Key id</th><th scope="col">File</th></tr></thead>
                    <tbody>
                        @foreach (var k in Config.TrustedKeys)
                        {
                            <tr><td><code>@k.KeyId</code></td><td class="small" style="word-break:break-all">@k.FileName</td></tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>

@code {
    private ConfigBundle? _bundle;
    private ConfigBundleEnvelope? _incoming;   // signed: ImportAsync re-verifies it
    private ConfigVerification? _verification;
    private ConfigDiff? _diff;
    private bool _applying;
    // BUG-19, CAP-16: a bundle signed with a key this server neither holds nor trusts needs the key's id typed.
    private string? _confirmedKeyId;
    private bool KeyIdTyped => _verification?.CarriedKeyId is { } id
                               && string.Equals(_confirmedKeyId?.Trim(), id, StringComparison.OrdinalIgnoreCase);

    // Above the 8 MB rule-of-thumb on purpose: the bundle carries the Word template library (up to
    // ReportTemplateService.MaxTemplateBytes each, base64-inflated by a third), and only SysAdmins reach this page.
    private const long MaxBundleBytes = 64 * 1024 * 1024;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // BUG-601: an import applied while the first build still runs: the older bundle (from before the import) mustn't
    // land last and be what's exported.
    private readonly LoadSequence _load = new();

    private async Task LoadAsync()
    {
        var t = _load.Begin();
        var bundle = await Config.BuildBundleAsync();
        if (_load.IsCurrent(t)) _bundle = bundle;
    }

    // BUG-440: bumped by each file chosen and by Cancel, so only the newest choice's preview is shown (and applied). One
    // that finishes after another file was chosen, or after Cancel, is dropped.
    private int _uploadSeq;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        if (_applying) return;   // BUG-440: the bundle being applied stays the one shown
        // BUG-341 sibling: never InputFileChangeEventArgs.File, which throws for two or more files; the first is the bundle.
        if (DroppedFiles.First(e).First is not { } file) return;
        ClearUpload();
        var seq = _uploadSeq;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: MaxBundleBytes).CopyToAsync(ms); // NOSONAR S5693: sized for the template library, see MaxBundleBytes
            var (envelope, verification) = Config.ParseAndVerify(ms.ToArray());
            var diff = await Config.PreviewAsync(envelope.Bundle);
            if (seq != _uploadSeq) return;
            // BUG-440: set together, once the preview is in, so the diff shown is always the bundle Apply sends.
            (_incoming, _verification, _diff) = (envelope, verification, diff);
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            if (seq != _uploadSeq) return;
            ClearUpload();
            Toasts.Error(ex.Message);
        }
        catch (IOException)
        {
            if (seq != _uploadSeq) return;
            // OpenReadStream throws this when the file is over maxAllowedSize.
            ClearUpload();
            Toasts.Error($"That file is larger than {MaxBundleBytes / 1024 / 1024} MB, too big to be a configuration bundle.");
        }
    }

    private void ClearUpload()
    {
        _uploadSeq++;
        _incoming = null;
        _verification = null;
        _diff = null;
        _confirmedKeyId = null;
    }

    private async Task Apply()
    {
        // BUG-440: a double click mustn't apply the bundle twice.
        if (_applying || _incoming is null || _verification is not { SignatureValid: true }) return;
        _applying = true;
        try
        {
            var result = await Config.ImportAsync(_incoming, _confirmedKeyId);
            Toasts.Success($"Import applied: {result.Added} added, {result.Updated} updated.");
            if (!result.RolesInEffect) Toasts.Error(IncidentManager.Application.Admin.RoleService.NotInEffectMessage);
            if (result.SettingsReloadError is { } reload) Toasts.Error(SettingsReloads.NotInEffectMessage(reload));   // BUG-270
            if (result.TemplatesNotPlacedMessage is { } notPlaced) Toasts.Error(notPlaced);   // BUG-238
            ClearUpload();
            await LoadAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            // BUG-567: a save the import can't word (the database refused it) mustn't end the circuit. Nothing was imported.
            Toasts.Error("The bundle couldn't be imported: the database refused the change, so nothing was imported. " +
                         "Reload the page to see the current configuration, then try again.");
        }
        finally
        {
            _applying = false;
        }
    }
}
