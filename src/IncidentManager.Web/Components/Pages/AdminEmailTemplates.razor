@page "/admin/email-templates"
@using IncidentManager.Application.Admin
@using IncidentManager.Application.Abstractions
@attribute [Authorize(Policy = Policies.Administer)]
@layout AdminLayout
@inject EmailTemplateAdminService Templates
@inject IEmailComposer Composer
@inject IEmailSender Email
@inject IUserDirectory Users
@inject ICurrentUser CurrentUser
@inject ToastService Toasts

<PageTitle>Email templates</PageTitle>

<PageHeader Title="Email templates">
    <Actions>
        <span class="im-badge im-b-neutral"><span class="bi bi-shield-lock me-1"></span>SysAdmin only</span>
    </Actions>
</PageHeader>
<p class="text-muted">
    Customize the wording of notification emails. Every message shares one <strong>branded shell</strong> —
    your logo, the console's brand colours, and a footer — assembled automatically; here you edit each
    template's <strong>subject</strong> and <strong>body</strong>. Use the tokens listed for each template to
    drop in live values (case-supplied text is escaped, so it can't break the layout). Changes are audited and
    take effect without a restart. Set a <a href="admin/settings/notifications">Public base URL</a> so links
    and the logo appear.
</p>

@if (_views is null)
{
    <p class="text-muted"><em>Loading…</em></p>
}
else
{
    <div class="row g-3">
        <div class="col-lg-3">
            <div class="list-group">
                @foreach (var t in _views)
                {
                    <button type="button"
                            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(t.Id == _selectedId ? "active" : "")"
                            @onclick="() => Select(t.Id)">
                        <span>@t.Title</span>
                        @if (t.IsOverridden)
                        {
                            <span class="im-badge im-b-info">Customized</span>
                        }
                    </button>
                }
            </div>
        </div>

        <div class="col-lg-9">
            @if (Selected is { } sel)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h6 mb-1">@sel.Title @if (sel.IsOverridden) { <span class="im-badge im-b-info ms-1">Customized</span> }</h2>
                        <p class="text-muted small mb-3">@sel.Description</p>

                        <label class="form-label small mb-0">Subject</label>
                        <input class="form-control form-control-sm mb-3" @bind="_subject" @bind:event="oninput" />

                        <label class="form-label small mb-0">Body</label>
                        <textarea class="form-control form-control-sm font-monospace mb-2" rows="12"
                                  style="line-height:1.5" @bind="_body" @bind:event="oninput"></textarea>

                        <div class="mb-3">
                            <div class="small text-muted mb-1">Available tokens (click to append):</div>
                            @foreach (var tok in sel.Tokens)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm me-1 mb-1 font-monospace"
                                        title="@tok.Description" @onclick="() => AppendToken(tok.Name)">@($"{{{{{tok.Name}}}}}")</button>
                            }
                            @if (sel.CtaLabel is not null)
                            {
                                <div class="small text-muted mt-1">
                                    <span class="bi bi-cursor me-1"></span>A “@sel.CtaLabel” button is added automatically when a Public base URL is set.
                                </div>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@(_busy || string.IsNullOrWhiteSpace(_subject))">Save</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="UpdatePreview" disabled="@_busy">Update preview</button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="Reset" disabled="@(_busy || !sel.IsOverridden)">Reset to default</button>
                            <span class="vr mx-1"></span>
                            <input class="form-control form-control-sm" style="max-width:16rem" placeholder="you@example.com"
                                   @bind="_testRecipient" />
                            <button class="btn btn-outline-secondary btn-sm" @onclick="SendTest" disabled="@(_busy || string.IsNullOrWhiteSpace(_testRecipient))">Send test</button>
                        </div>
                        @if (_error is not null) { <p class="text-danger small mt-2 mb-0">@_error</p> }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><span class="bi bi-eye me-1"></span>Preview</span>
                        <span class="small text-muted">rendered with sample values</span>
                    </div>
                    <div class="card-body p-0">
                        @if (_previewHtml is not null)
                        {
                            <iframe title="Email preview" srcdoc="@_previewHtml"
                                    style="width:100%;height:620px;border:0;display:block;background:#fff"></iframe>
                        }
                        else
                        {
                            <p class="text-muted small m-3">Click <strong>Update preview</strong> to render.</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private IReadOnlyList<EmailTemplateView>? _views;
    private string _selectedId = "";
    private string _subject = "";
    private string _body = "";
    private string? _previewHtml;
    private string? _testRecipient;
    private string? _error;
    private bool _busy;

    private EmailTemplateView? Selected => _views?.FirstOrDefault(v => v.Id == _selectedId);

    protected override async Task OnInitializedAsync()
    {
        _views = await Templates.GetAllAsync();
        _testRecipient = Users.EmailFor(CurrentUser.UserId);
        if (_views.Count > 0) await Select(_views[0].Id);
    }

    private async Task Select(string id)
    {
        _selectedId = id;
        _error = null;
        var v = Selected;
        if (v is null) return;
        _subject = v.EffectiveSubject;
        _body = v.EffectiveBody;
        await UpdatePreview();
    }

    private void AppendToken(string name)
    {
        _body += $"{{{{{name}}}}}";
    }

    private async Task UpdatePreview()
    {
        try
        {
            var (_, html) = await Composer.PreviewAsync(_selectedId, _subject, _body);
            _previewHtml = html;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task Save()
    {
        _busy = true;
        _error = null;
        try
        {
            await Templates.SaveAsync(_selectedId, _subject, _body);
            _views = await Templates.GetAllAsync();
            await UpdatePreview();
            Toasts.Success("Template saved");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Reset()
    {
        _busy = true;
        _error = null;
        try
        {
            await Templates.ResetAsync(_selectedId);
            _views = await Templates.GetAllAsync();
            var v = Selected;
            if (v is not null) { _subject = v.EffectiveSubject; _body = v.EffectiveBody; }
            await UpdatePreview();
            Toasts.Success("Reverted to the default");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SendTest()
    {
        if (string.IsNullOrWhiteSpace(_testRecipient)) return;
        _busy = true;
        _error = null;
        try
        {
            // Save first so the test reflects exactly what's live, then send with sample values.
            await Templates.SaveAsync(_selectedId, _subject, _body);
            _views = await Templates.GetAllAsync();
            var message = await Composer.ComposeSampleAsync(_selectedId, [_testRecipient!]);
            await Email.SendAsync(message);
            Toasts.Success($"Test sent to {_testRecipient} (logged if email delivery is off)");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
