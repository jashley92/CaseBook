@page "/admin/email-templates"
@using IncidentManager.Application.Admin
@using IncidentManager.Application.Abstractions
@attribute [Authorize(Policy = Policies.Administer)]
@layout AdminLayout
@inject EmailTemplateAdminService Templates
@inject IEmailComposer Composer
@inject IEmailSender Email
@inject IUserDirectory Users
@inject ICurrentUser CurrentUser
@inject ToastService Toasts

<PageTitle>Email templates</PageTitle>

<PageHeader Title="Email templates" />
<p class="text-muted">
    Edit the <strong>subject</strong> and <strong>body</strong> of each notification email. Every message is
    wrapped in the same <strong>branded shell</strong> with your logo, brand colors and footer. Tokens insert live
    values, and case text is escaped so it can't break the layout. Changes are audited and apply without a restart.
    Set <a href="admin/settings/notifications#App:BaseUrl">this server's address</a> so links and the logo appear.
</p>

@if (_views is null)
{
    <LoadingBlock />
}
else
{
    <div class="row g-3">
        <div class="col-lg-3">
            <div class="list-group">
                @foreach (var t in _views)
                {
                    <button type="button"
                            class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(t.Id == _selectedId ? "active" : "")"
                            @onclick="() => Select(t.Id)" disabled="@_busy">
                        <span>@t.Title</span>
                        @if (_drafts.ContainsKey(t.Id) || (t.Id == _selectedId && Unsaved))
                        {
                            @* REV-28: switching templates keeps what was typed; this says which have unsaved edits. *@
                            <span class="im-badge im-b-warn">Unsaved</span>
                        }
                        else if (t.IsOverridden)
                        {
                            <span class="im-badge im-b-info">Customized</span>
                        }
                    </button>
                }
            </div>
        </div>

        <div class="col-lg-9">
            @if (Selected is { } sel)
            {
                <div class="card mb-3">
                    <div class="card-body">
                        <h2 class="h6 mb-1">@sel.Title @if (sel.IsOverridden) { <span class="im-badge im-b-info ms-1">Customized</span> }</h2>
                        <p class="text-muted small mb-3">@sel.Description</p>

                        <label class="form-label small mb-0" for="etpl-subject">Subject</label>
                        <input id="etpl-subject" class="form-control form-control-sm mb-3" @bind="_subject" @bind:event="oninput" />

                        <label class="form-label small mb-0" for="etpl-body">Body</label>
                        <textarea id="etpl-body" class="form-control form-control-sm font-monospace mb-2" rows="12"
                                  style="line-height:1.5" @bind="_body" @bind:event="oninput"></textarea>

                        <div class="mb-3">
                            <div class="small text-muted mb-1">Tokens (click to add to the body):</div>
                            @foreach (var tok in sel.Tokens)
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm me-1 mb-1 font-monospace"
                                        title="@tok.Description" @onclick="() => AppendToken(tok.Name)">@($"{{{{{tok.Name}}}}}")</button>
                            }
                            @if (sel.CtaLabel is not null)
                            {
                                <div class="small text-muted mt-1">
                                    <span class="bi bi-cursor me-1"></span>A “@sel.CtaLabel” button is added automatically when this server's address is set (Notifications, Email delivery).
                                </div>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <button class="btn btn-primary btn-sm" @onclick="Save" disabled="@(_busy || string.IsNullOrWhiteSpace(_subject))">Save</button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="UpdatePreview" disabled="@_busy">Update preview</button>
                            <button class="btn btn-outline-danger btn-sm" @onclick="Reset" disabled="@(_busy || !sel.IsOverridden)">Reset to default</button>
                            <span class="vr mx-1"></span>
                            <input class="form-control form-control-sm" style="max-width:16rem" aria-label="Test email recipient" placeholder="you@example.com"
                                   @bind="_testRecipient" />
                            <button class="btn btn-outline-secondary btn-sm" @onclick="SendTest" disabled="@(_busy || string.IsNullOrWhiteSpace(_testRecipient))" title="Sends the draft on screen. Doesn't save it.">Send test</button>
                        </div>
                        @if (_error is not null) { <p class="text-danger small mt-2 mb-0">@_error</p> }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><span class="bi bi-eye me-1"></span>Preview</span>
                        <span class="small text-muted">rendered with sample values</span>
                    </div>
                    <div class="card-body p-0">
                        @if (_previewHtml is not null)
                        {
                            <iframe title="Email preview" srcdoc="@_previewHtml"
                                    style="width:100%;height:620px;border:0;display:block;background:#fff"></iframe>
                        }
                        else
                        {
                            <p class="text-muted small m-3">Click <strong>Update preview</strong> to render.</p>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private IReadOnlyList<EmailTemplateView>? _views;
    private string _selectedId = "";
    private string _subject = "";
    private string _body = "";
    private string _stamp = "";   // BUG-396: the template as the editor opened it, so a stale page can't write it back
    private string? _previewHtml;
    private string? _testRecipient;
    private string? _error;
    private bool _busy;

    private EmailTemplateView? Selected => _views?.FirstOrDefault(v => v.Id == _selectedId);

    protected override async Task OnInitializedAsync()
    {
        _views = await Templates.GetAllAsync();
        _testRecipient = Users.EmailFor(CurrentUser.UserId);
        if (_views.Count > 0) await Select(_views[0].Id);
    }

    // REV-28: what was typed into a template not yet saved, by template, so moving to another one doesn't lose it. BUG-396:
    // with the stamp of the template it was typed over.
    private readonly Dictionary<string, (string Subject, string Body, string Stamp)> _drafts = new();

    // BUG-486: judged on the text as Save would store it (trimmed; a blank body is the default), so a saved final newline
    // doesn't leave the badge on and whitespace alone isn't parked as a draft.
    private bool Unsaved => Selected is { } v && (_subject.Trim() != v.EffectiveSubject || BodyAsSaved(v) != v.EffectiveBody);

    private string BodyAsSaved(EmailTemplateView v) => _body.Trim() is { Length: > 0 } body ? body : v.DefaultBody;

    private async Task Select(string id)
    {
        // BUG-462: no switching while Save, Reset or Send test runs. Each writes the editor back once it lands, which
        // would overwrite the newly picked template's draft or carry a stale stamp into it.
        if (_busy) return;
        if (Unsaved) _drafts[_selectedId] = (_subject, _body, _stamp);
        else _drafts.Remove(_selectedId);
        _selectedId = id;
        _error = null;
        var v = Selected;
        if (v is null) return;
        (_subject, _body, _stamp) = _drafts.Remove(id, out var draft) ? draft : (v.EffectiveSubject, v.EffectiveBody, v.Stamp);
        await UpdatePreview();
    }

    private void AppendToken(string name)
    {
        _body += $"{{{{{name}}}}}";
    }

    private async Task UpdatePreview()
    {
        // BUG-462: a preview that lands after another template was picked is dropped, so it can't show over that one.
        var id = _selectedId;
        try
        {
            var (_, html) = await Composer.PreviewAsync(id, _subject, _body);
            if (id != _selectedId) return;
            _previewHtml = html;
            _error = null;
        }
        catch (Exception ex)
        {
            if (id == _selectedId) _error = ex.Message;
        }
    }

    // BUG-393: Save, Reset and Send test return early while one is running. The buttons are disabled, but a double click
    // lands before the re-render, and a second first-override insert hit the unique index.
    private async Task Save()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            // BUG-526: saved but not in effect (the settings reload failed) is saved: the stamp moves on as for a save, or the
            // retry was refused as a stale edit.
            string? notInEffect = null;
            try { await Templates.SaveAsync(_selectedId, _subject, _body, _stamp); }
            catch (SettingsNotInEffectException ex) { notInEffect = ex.Message; }
            if (!await ReloadViewsAsync()) return;
            if (Selected is { } saved) _stamp = saved.Stamp;
            await UpdatePreview();
            if (notInEffect is not null) _error = notInEffect;
            else Toasts.Success("Template saved");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    // BUG-601: Save and Reset each read the list back. They can't overlap today (_busy), but an older read landing last
    // would show the template as it was before the newer change, and seed its stamp; only the newest read lands.
    private readonly LoadSequence _viewsLoad = new();

    private async Task<bool> ReloadViewsAsync()
    {
        var t = _viewsLoad.Begin();
        var views = await Templates.GetAllAsync();
        if (!_viewsLoad.IsCurrent(t)) return false;
        _views = views;
        return true;
    }

    private async Task Reset()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            string? notInEffect = null;   // BUG-526: as for Save
            try { await Templates.ResetAsync(_selectedId); }
            catch (SettingsNotInEffectException ex) { notInEffect = ex.Message; }
            if (!await ReloadViewsAsync()) return;
            var v = Selected;
            if (v is not null) { _subject = v.EffectiveSubject; _body = v.EffectiveBody; _stamp = v.Stamp; }
            await UpdatePreview();
            if (notInEffect is not null) _error = notInEffect;
            else Toasts.Success("Reverted to the default");
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SendTest()
    {
        if (string.IsNullOrWhiteSpace(_testRecipient) || _busy) return;
        _busy = true;
        _error = null;
        try
        {
            // Sends the draft on screen with sample values. Nothing is saved, so live emails don't change.
            var message = await Composer.ComposeSampleAsync(_selectedId, [_testRecipient!], _subject, _body);
            var outcome = await Email.SendTestAsync(message);
            if (outcome.Status == EmailSendStatus.Failed) _error = $"Couldn't send the test. {outcome.Error}";
            else if (outcome.Status == EmailSendStatus.Disabled) Toasts.Info($"Email delivery is off, so the draft was logged instead of sent. It isn't saved.");
            else Toasts.Success($"Draft sent to {_testRecipient}. It isn't saved.");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _error = $"Couldn't send the test. {ex.Message}";
        }
        finally { _busy = false; }
    }
}
