@page "/account/keyboard"
@* RD-24 (Casefile): your keyboard shortcuts. Every shortcut from the one keymap, with the keys in force for you; change
   any, clear one, put it back, or switch every single-key shortcut off (WCAG 2.1.4). Saved to your account. *@
@attribute [Authorize]
@using IncidentManager.Application.Preferences
@inject UserDisplayPreferenceService Prefs
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>Keyboard shortcuts</PageTitle>

<PageHeader Title="Keyboard shortcuts"
            Subtitle="The keys CaseBook listens for. These settings apply only to you, on any computer you sign in from." />

@if (_keys is null)
{
    <LoadingBlock />
}
else
{
    <div class="im-card im-keys" style="max-width:48rem">
        <div class="form-check form-switch mb-1">
            <input class="form-check-input" type="checkbox" role="switch" id="keys-single" checked="@(!_singleOff)"
                   @onchange="e => _singleOff = !(bool)(e.Value ?? false)" />
            <label class="form-check-label fw-semibold" for="keys-single">Single-key shortcuts</label>
        </div>
        <p class="text-muted small">
            Shortcuts made of one key (like <kbd>/</kbd> or <kbd>l</kbd>) or <kbd>g</kbd> and a key. They never fire
            while you're typing in a field. Turn them off if you use speech input or press keys by accident; shortcuts
            with <kbd>Ctrl</kbd> or <kbd>Alt</kbd> keep working.
            @if (_singleOff) { <strong>They're off: the struck-out keys below do nothing until you turn them back on.</strong> }
        </p>

        <table class="table table-sm align-middle im-table mb-2">
            <thead><tr><th>Shortcut</th><th style="width:14rem">Keys</th><th></th></tr></thead>
            <tbody>
                @foreach (var group in Keymap.Actions.GroupBy(a => a.Scope))
                {
                    <tr class="im-keys-group"><th colspan="3">@(group.Key == KeyScope.Case ? "With a case open" : "Anywhere")</th></tr>
                    @foreach (var a in group)
                    {
                        var action = a;
                        var off = _singleOff && _keys[a.Id].Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).All(Keymap.IsSingleKey);
                        <tr>
                            <td><label for="key-@a.Id">@a.Label</label></td>
                            <td>
                                <input id="key-@a.Id" class="form-control form-control-sm im-keys-input @(off ? "is-off" : "")" autocomplete="off" spellcheck="false"
                                       value="@_keys[a.Id]" @onchange='e => _keys[action.Id] = e.Value?.ToString() ?? ""'
                                       placeholder="none" aria-describedby="keys-help" />
                            </td>
                            <td class="text-end">
                                @if (_keys[a.Id] != a.DefaultKeys)
                                {
                                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => _keys[action.Id] = action.DefaultKeys">Default (@a.DefaultKeys)</button>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        <p id="keys-help" class="small text-muted">
            Write one key (<code>/</code>, <code>n</code>, <code>1</code>), <code>g</code> and a key (<code>g d</code>), or
            <code>Ctrl</code> or <code>Alt</code> with a key (<code>Alt+N</code>, <code>Ctrl+Shift+F</code>). Separate two
            bindings with a comma; leave it empty to have none. <kbd>Ctrl</kbd>+<kbd>K</kbd>, <kbd>Esc</kbd> and
            <kbd>Ctrl</kbd>+<kbd>Enter</kbd> always work and can't be changed.
        </p>
        @if (_problems.Count > 0)
        {
            <div class="alert alert-warning small" role="alert">
                <ul class="mb-0 ps-3">@foreach (var p in _problems) { <li>@p</li> }</ul>
            </div>
        }
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-primary" @onclick="Save">Save</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetAll">Put every key back</button>
        </div>
    </div>
}

@code {
    private Dictionary<string, string>? _keys;
    private bool _singleOff;
    private List<string> _problems = [];

    protected override async Task OnInitializedAsync()
    {
        var s = await Prefs.GetKeymapAsync();
        _singleOff = s.SingleKeysOff;
        _keys = Keymap.Actions.ToDictionary(a => a.Id, s.KeysFor);
    }

    private void ResetAll()
    {
        _keys = Keymap.Actions.ToDictionary(a => a.Id, a => a.DefaultKeys);
        _singleOff = false;
        _problems = [];
    }

    private async Task Save()
    {
        var (_, problems) = Keymap.Validate(_singleOff, _keys!);
        _problems = problems.ToList();
        if (_problems.Count > 0) return;
        try
        {
            var saved = await Prefs.SaveKeymapAsync(_singleOff, _keys!);
            _keys = Keymap.Actions.ToDictionary(a => a.Id, saved.KeysFor);   // normalized
            await IncidentManager.Web.Services.KeymapClient.ApplyAsync(JS, saved);
            Toasts.Success("Keyboard shortcuts saved");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            _problems = [ex.Message];
        }
    }
}
