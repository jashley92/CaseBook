@page "/admin"
@* The Administration landing: what needs an administrator now (the same list Diagnostics heads), and, while a new install
   still needs them, the first steps. Identity & branding, which this page used to be, is admin/settings/identity. *@
@attribute [Authorize(Policy = Policies.Administer)]
@layout AdminLayout
@using IncidentManager.Web.Services
@inject AdminHealth Health
@implements IDisposable

<PageTitle>Administration</PageTitle>

<PageHeader Title="Overview" Subtitle="What needs you, and where everything is set." />

<AttentionSummary Items="_attention" CheckedAtUtc="Health.CheckedAtUtc" />

@if (_setup is { } steps && steps.Any(s => !s.Done))
{
    <section class="card mb-3" aria-labelledby="setup-title">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span id="setup-title"><span class="bi bi-list-check me-1" aria-hidden="true"></span>Getting started</span>
            <span class="small text-muted">@steps.Count(s => s.Done) of @steps.Count done</span>
        </div>
        <ul class="list-group list-group-flush">
            @foreach (var step in steps)
            {
                <li class="list-group-item d-flex align-items-start gap-2">
                    <span class="bi @(step.Done ? "bi-check-circle-fill text-success" : "bi-circle text-muted") mt-1" aria-hidden="true"></span>
                    <div class="flex-grow-1">
                        <div class="@(step.Done ? "text-muted" : "fw-semibold")">@step.Title <span class="visually-hidden">@(step.Done ? "(done)" : "(to do)")</span></div>
                        @if (!step.Done) { <div class="small text-muted">@step.Detail</div> }
                    </div>
                    @if (!step.Done) { <a class="btn btn-sm btn-outline-secondary text-nowrap" href="@step.Href">Go</a> }
                </li>
            }
        </ul>
    </section>
}

@code {
    private IReadOnlyList<AttentionItem>? _attention;
    private IReadOnlyList<SetupStep>? _setup;
    private readonly CancellationTokenSource _gone = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _attention = await Health.AttentionAsync(ct: _gone.Token);
            _setup = await Health.SetupAsync(_gone.Token);
        }
        catch (OperationCanceledException) when (_gone.IsCancellationRequested) { /* left the page */ }
    }

    public void Dispose()
    {
        _gone.Cancel();
        _gone.Dispose();
    }
}
