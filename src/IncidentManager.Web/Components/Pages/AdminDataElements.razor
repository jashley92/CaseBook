@page "/admin/data-elements"
@using IncidentManager.Application.Admin
@attribute [Authorize(Policy = Policies.Administer)]
@layout AdminLayout
@inject DataElementService DataElements
@inject ToastService Toasts

<PageTitle>Data elements</PageTitle>

<PageHeader Title="Data elements">
    <Actions>
        <span class="im-badge im-b-neutral"><span class="bi bi-shield-lock me-1"></span>SysAdmin only</span>
    </Actions>
</PageHeader>
<p class="text-muted">
    Categories of personal and non-public information an impact assessment can record. <strong>Add</strong>,
    <strong>rename</strong>, <strong>reorder</strong> or <strong>archive</strong> them to fit your organization.
    Archiving an element, even a built-in one, removes it from new selections but keeps it on cases that recorded
    it, so past records and their tamper-evident hashes stay intact. An element no case uses can be deleted.
    Changes are audited.
</p>

@if (_active is null)
{
    <LoadingBlock />
}
else
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><span class="bi bi-collection me-1"></span>Active elements</span>
            <button class="btn btn-sm btn-primary" @onclick="Save" disabled="@_saving">Save changes</button>
        </div>
        <div class="card-body">
            @if (_active.Count == 0)
            {
                <p class="text-muted small">No active elements. Add one, or restore an archived element below.</p>
            }
            else
            {
                <ol class="list-group mb-3">
                    @for (var i = 0; i < _active.Count; i++)
                    {
                        var idx = i;
                        var r = _active[idx];
                        <li class="list-group-item d-flex align-items-center gap-2">
                            <div class="btn-group btn-group-sm" role="group">
                                <button class="btn btn-outline-secondary" title="Move up"
                                        disabled="@(idx == 0)" @onclick="() => Move(idx, -1)"><span class="bi bi-arrow-up"></span></button>
                                <button class="btn btn-outline-secondary" title="Move down"
                                        disabled="@(idx == _active.Count - 1)" @onclick="() => Move(idx, 1)"><span class="bi bi-arrow-down"></span></button>
                            </div>
                            <div style="min-width:6.5rem">
                                @if (r.IsNew) { <span class="im-badge im-b-info">New</span> }
                                else if (r.IsSystem) { <span class="im-badge im-b-neutral">Built-in</span> }
                                else { <span class="im-badge im-b-info">Custom</span> }
                            </div>
                            <input class="form-control form-control-sm" style="max-width:18rem" type="text" aria-label="Data element @(idx + 1) label" maxlength="200"
                                   placeholder="Label" @bind="r.Label" @bind:event="oninput" />
                            <input class="form-control form-control-sm flex-grow-1" type="text" aria-label="Data element @(idx + 1) notifies" maxlength="400"
                                   placeholder="Notifies (optional, e.g. US, NY)" @bind="r.NotificationJurisdictions" @bind:event="oninput"
                                   title="Jurisdictions whose breach-notification law this element triggers" />
                            @if (r.IsNew)
                            {
                                <button class="btn btn-sm btn-outline-danger" title="Discard this new row" @onclick="() => _active.RemoveAt(idx)"><span class="bi bi-x-lg"></span></button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" title="Remove from the picker; stays on existing cases" @onclick="() => Archive(r.Id!.Value)">Archive</button>
                            }
                        </li>
                    }
                </ol>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="AddRow"><span class="bi bi-plus-lg me-1"></span>Add element</button>
        </div>
    </div>

    @if (_archived.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><span class="bi bi-archive me-1"></span>Archived (@_archived.Count)</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showArchived = !_showArchived">
                    @(_showArchived ? "Hide" : "Show")
                </button>
            </div>
            @if (_showArchived)
            {
                <div class="card-body">
                    <p class="small text-muted">Archived elements don't appear in the impact picker but still label the cases
                    that recorded them. Restore one to offer it again, or delete one that no case uses.</p>
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            @foreach (var a in _archived)
                            {
                                <tr>
                                    <td>
                                        @a.Label
                                        @if (a.IsSystem) { <span class="im-badge im-b-neutral ms-1">Built-in</span> }
                                        @if (a.IsReferenced) { <span class="im-badge im-b-neutral ms-1" title="Recorded on one or more cases">In use</span> }
                                    </td>
                                    <td class="text-end" style="width:12rem">
                                        <button class="btn btn-sm btn-outline-primary py-0" @onclick="() => Restore(a.Id)">Restore</button>
                                        @if (a.IsDeletable)
                                        {
                                            <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => ConfirmDelete(a.Id, a.Label)">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}


@* S-23: destructive actions state their consequence and ask first. *@
<ConfirmDialog @ref="_confirm" />

@code {
    private ConfirmDialog _confirm = null!;

    private void ConfirmDelete(Guid id, string label) => _confirm.Ask(this, "Delete data element",
        $"Permanently delete “{label}”? This can't be undone.",
        "Delete element", () => Delete(id));

    private sealed class Row
    {
        public Guid? Id { get; init; }
        public string? Stamp { get; init; }   // BUG-235: as loaded, so another admin's change since isn't undone
        public bool IsSystem { get; init; }
        public string Label { get; set; } = "";
        public string? NotificationJurisdictions { get; set; }
        public bool IsNew => Id is null;
        public string OriginalLabel { get; init; } = "";        // REV-28: as loaded
        public string? OriginalJurisdictions { get; init; }
        public bool Edited => IsNew || Label != OriginalLabel || NotificationJurisdictions != OriginalJurisdictions;
    }

    private List<Row>? _active;
    private List<DataElementView> _archived = new();
    private bool _showArchived;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (await ReadAsync() is { } read) (_active, _archived) = read;
    }

    // BUG-601: a save's reload and an archive's can overlap; only the newest read is used (null for an older one).
    private readonly LoadSequence _load = new();

    private async Task<(List<Row> Active, List<DataElementView> Archived)?> ReadAsync()
    {
        var t = _load.Begin();
        var all = await DataElements.ListAllAsync();
        if (!_load.IsCurrent(t)) return null;
        return (all.Where(e => e.IsActive)
            .Select(e => new Row { Id = e.Id, Stamp = e.RowHash, IsSystem = e.IsSystem, Label = e.Label, NotificationJurisdictions = e.NotificationJurisdictions,
                                   OriginalLabel = e.Label, OriginalJurisdictions = e.NotificationJurisdictions })
            .ToList(),
            all.Where(e => !e.IsActive).ToList());
    }

    private void AddRow() => _active?.Add(new Row());

    private void Move(int index, int delta)
    {
        if (_active is null) return;
        var target = index + delta;
        if (target < 0 || target >= _active.Count) return;
        (_active[index], _active[target]) = (_active[target], _active[index]);
    }

    // BUG-339: a double click on Save inserted the new rows twice; the second hit the unique key index.
    private bool _saving;

    private async Task Save()
    {
        if (_active is null || _saving) return;
        _saving = true;
        try { await SaveCore(); }
        finally { _saving = false; }
    }

    private async Task SaveCore()
    {
        if (_active is null) return;
        var payload = _active.Select(r => new DataElementRow(r.Id, r.Label, r.NotificationJurisdictions, r.Stamp)).ToList();
        try
        {
            await DataElements.SaveAsync(payload);
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
        {
            Toasts.Error(ex.Message);
            return;
        }
        catch (Microsoft.EntityFrameworkCore.DbUpdateException)
        {
            // BUG-567: any other refused save (the service words the ones it can tell apart) mustn't end the circuit.
            Toasts.Error("The data elements couldn't be saved. Reload the page to see the current list, then try again.");
            return;
        }
        await LoadAsync();
        Toasts.Success("Data elements saved");
    }

    private async Task Archive(Guid id) => await Lifecycle(id, () => DataElements.SetArchivedAsync(id, true), "Element archived");
    private async Task Restore(Guid id) => await Lifecycle(id, () => DataElements.SetArchivedAsync(id, false), "Element restored");
    private async Task Delete(Guid id) => await Lifecycle(id, () => DataElements.DeleteAsync(id), "Element deleted");

    // BUG-603: one change per element at a time (a double-click on Archive, Restore or Delete ran it twice).
    private readonly HashSet<Guid> _changing = [];

    private async Task Lifecycle(Guid id, Func<Task> action, string ok)
    {
        if (!_changing.Add(id)) return;
        try
        {
            try
            {
                await action();
            }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
            {
                Toasts.Error(ex.Message);
                return;
            }
            catch (Microsoft.EntityFrameworkCore.DbUpdateException)   // BUG-567: as on save
            {
                Toasts.Error("The data element couldn't be changed. Reload the page and try again.");
                return;
            }
            await ReloadKeepingEdits();
            Toasts.Info(ok);
        }
        finally { _changing.Remove(id); }
    }

    // REV-28: archiving, restoring or deleting one element reloads the list, but the rows being edited (and their order,
    // and any added) are kept as they are, with the stamps they were opened with.
    private async Task ReloadKeepingEdits()
    {
        if (await ReadAsync() is not { } read) return;   // BUG-601: a newer reload lands instead
        var before = _active ?? [];   // as it is now, with what was typed or added meanwhile
        var fresh = read.Active.ToDictionary(r => r.Id!.Value);
        var kept = before.Where(r => r.IsNew || fresh.ContainsKey(r.Id!.Value))
            .Select(r => r.IsNew || r.Edited ? r : fresh[r.Id!.Value]).ToList();
        kept.AddRange(fresh.Values.Where(r => before.All(b => b.Id != r.Id)));   // one just restored
        (_active, _archived) = (kept, read.Archived);
    }
}
