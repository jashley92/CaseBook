@page "/access-log"
@* UX-17: a forensic/oversight surface, so it lives at the top level in the "Audit & Exports" group beside
   Integrity & Audit (in the main layout) rather than buried in the admin hub. Still SysAdmin-only. *@
@attribute [Authorize(Policy = Policies.Administer)]
@implements IDisposable
@using IncidentManager.Application.Access
@inject IAccessLogService AccessLog
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject TimeDisplay TimeDisp

<PageTitle>Access log</PageTitle>

<PageHeader Title="Access log">
    <Actions>
        <span class="im-badge im-b-neutral"><span class="bi bi-shield-lock me-1"></span>SysAdmin only</span>
    </Actions>
</PageHeader>
<p class="text-muted">
    Who <strong>read</strong> a case or opened a sensitive artifact (evidence, report, export), grouped into
    per-user view sessions. This log sits <strong>outside</strong> the tamper-evident audit chain and is pruned
    separately. Set its scope and grouping window in
    <a href="admin/settings/governance">Administration → Governance &amp; security → Access logging</a>.
</p>

<div class="row g-2 align-items-end mb-3">
    <div class="col-6 col-md-3">
        <label class="form-label small mb-0" for="acl-actor">Actor</label>
        <select id="acl-actor" class="form-select form-select-sm" @bind="_actor" @bind:after="Load">
            <option value="">Any</option>
            @foreach (var a in _actors)
            {
                <option value="@a">@Users.DisplayFor(a)</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="acl-type">Access type</label>
        <select id="acl-type" class="form-select form-select-sm" @bind="_type" @bind:after="Load">
            <option value="">Any</option>
            @foreach (var t in Enum.GetValues<AccessType>())
            {
                <option value="@t">@Ui.AccessTypeLabel(t)</option>
            }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="acl-case">Case #</label>
        <input id="acl-case" class="form-control form-control-sm" @bind="_caseNumber" @bind:after="Load" @bind:event="onchange" placeholder="e.g. 2026-01_…" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="acl-from">From (UTC)</label>
        <input id="acl-from" type="date" class="form-control form-control-sm" @bind="_from" @bind:after="Load" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="acl-to">To (UTC)</label>
        <input id="acl-to" type="date" class="form-control form-control-sm" @bind="_to" @bind:after="Load" />
    </div>
    <div class="col-6 col-md-1">
        <div class="form-check mt-4">
            <input class="form-check-input" type="checkbox" id="restrictedOnly" @bind="_restrictedOnly" @bind:after="Load" />
            <label class="form-check-label small" for="restrictedOnly">Restricted</label>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-1">
    <span class="small text-muted">
        @(_rows?.Count ?? 0) session@(_rows?.Count == 1 ? "" : "s")@(_rows is { Count: >= PageSize } ? $" (showing the most recent {PageSize})" : "")
    </span>
    <a class="btn btn-sm btn-outline-secondary" href="@ExportHref()">
        <span class="bi bi-download me-1" aria-hidden="true"></span>Export CSV
    </a>
</div>

@if (_rows is null)
{
    <LoadingBlock />
}
else if (_rows.Count == 0)
{
    <p class="text-muted">No access recorded for the current filters.</p>
}
else
{
    <table class="table table-sm align-middle">
        <thead>
            <tr><th>Actor</th><th>Type</th><th>Case</th><th>Target</th><th class="text-end">Count</th><th>First seen</th><th>Last seen</th></tr>
        </thead>
        <tbody>
            @foreach (var r in _rows)
            {
                <tr>
                    <td>@Users.DisplayFor(r.ActorUserId)</td>
                    <td><span class="bi @Ui.AccessTypeGlyph(r.AccessType) me-1" aria-hidden="true"></span>@Ui.AccessTypeLabel(r.AccessType)</td>
                    <td>
                        @if (string.IsNullOrEmpty(r.CaseNumber)) { <span class="text-muted">—</span> }
                        else { <code>@r.CaseNumber</code> }
                        @if (r.WasRestricted) { <span class="im-badge im-b-warn ms-2">Restricted</span> }
                    </td>
                    <td class="small">@(string.IsNullOrWhiteSpace(r.TargetLabel) ? "" : r.TargetLabel)</td>
                    <td class="text-end">@r.Count</td>
                    <td class="small im-data">@TimeDisp.Short(r.FirstSeenUtc)</td>
                    <td class="small im-data">@TimeDisp.Short(r.LastSeenUtc)</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const int PageSize = 500;

    private IReadOnlyList<CaseAccessEvent>? _rows;
    private List<string> _actors = new();
    private string _actor = "";
    private string _type = "";
    private string? _caseNumber;
    private bool _restrictedOnly;
    private DateTime? _from;
    private DateTime? _to;
    // BUG-395: the filter the shown rows were loaded with (for the CSV link), and the load in flight.
    private AccessLogFilter? _shownFilter;
    private DateTime? _shownFrom, _shownTo;
    private CancellationTokenSource? _cts;
    private int _seq;

    protected override async Task OnInitializedAsync()
    {
        _actors = (await AccessLog.ActorsAsync()).ToList();
        await Load();
    }

    private AccessLogFilter BuildFilter() => new()
    {
        Actor = string.IsNullOrWhiteSpace(_actor) ? null : _actor,
        CaseNumber = string.IsNullOrWhiteSpace(_caseNumber) ? null : _caseNumber.Trim(),
        AccessType = Enum.TryParse<AccessType>(_type, out var t) ? t : null,
        RestrictedOnly = _restrictedOnly,
        FromUtc = _from is { } f ? new DateTimeOffset(f.Date, TimeSpan.Zero) : null,
        ToUtc = _to is { } dt ? new DateTimeOffset(dt.Date.AddDays(1).AddTicks(-1), TimeSpan.Zero) : null
    };

    // BUG-395 (sibling of BUG-346): a filter change supersedes the load before it, which is cancelled, and its rows are
    // dropped if they land anyway, so an earlier filter's rows never overwrite a later one's.
    private async Task Load()
    {
        var previous = _cts;   // replaced before the await, so a load started meanwhile never has its own disposed
        var seq = ++_seq;
        var cts = _cts = new CancellationTokenSource();
        var ct = cts.Token;   // read now: the page may be disposed (and cts with it) while the last load is cancelled
        if (previous is not null)
        {
            await previous.CancelAsync();
            previous.Dispose();
        }
        var filter = BuildFilter();
        var (from, to) = (_from, _to);
        try
        {
            var rows = await AccessLog.QueryAsync(filter, PageSize, ct);
            if (seq != _seq) return;
            _rows = rows;
            (_shownFilter, _shownFrom, _shownTo) = (filter, from, to);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { /* superseded */ }
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private string ExportHref()
    {
        // BUG-395: the filter the table was loaded with (the controls can be ahead of it while a load runs).
        var (f, fromDay, toDay) = _shownFilter is { } shown ? (shown, _shownFrom, _shownTo) : (BuildFilter(), _from, _to);
        var qs = new List<string>();
        if (f.Actor is { } actor) qs.Add($"actor={Uri.EscapeDataString(actor)}");
        if (f.CaseNumber is { } cn) qs.Add($"case={Uri.EscapeDataString(cn)}");
        if (f.AccessType is { } t) qs.Add($"type={t}");
        if (f.RestrictedOnly) qs.Add("restricted=true");
        if (fromDay is { } from) qs.Add($"from={from:yyyy-MM-dd}");
        if (toDay is { } to) qs.Add($"to={to:yyyy-MM-dd}");
        return "export/access-log.csv" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
    }
}
