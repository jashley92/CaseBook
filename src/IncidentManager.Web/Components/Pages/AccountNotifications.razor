@page "/account/notifications"
@attribute [Authorize]
@using IncidentManager.Application.Notifications
@inject UserNotificationPreferenceService Prefs
@inject IConfiguration Config
@inject ToastService Toasts
@inject IncidentManager.Application.Work.AgendaFeedService Feeds
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject TimeDisplay TimeDisp

<PageTitle>Notification settings</PageTitle>

<PageHeader Title="Notification settings"
           Subtitle="How CaseBook emails you about your own work. These settings apply only to you." />

@if (!_loaded)
{
    <LoadingBlock />
}
else
{
    <div class="im-card nc-card" style="max-width:44rem">
        <div class="fw-semibold mb-1"><span class="bi bi-envelope-paper me-1" aria-hidden="true"></span>Work digest</div>
        <p class="text-muted small mb-3">
            One email summarizing your overdue tasks and those due today or this week, instead of a separate
            reminder for each.
        </p>
        <div class="mb-1">
            @foreach (var c in new[] { DigestCadence.Off, DigestCadence.Daily, DigestCadence.Weekly })
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="cadence" id="cadence-@c"
                           checked="@(_cadence == c)" @onchange="() => _cadence = c" />
                    <label class="form-check-label" for="cadence-@c">
                        <strong>@CadenceLabel(c)</strong>
                        <span class="text-muted small d-block">@CadenceHint(c)</span>
                    </label>
                </div>
            }
        </div>
    </div>

    <div class="im-card nc-card mt-3" style="max-width:44rem">
        <div class="fw-semibold mb-1"><span class="bi bi-bell me-1" aria-hidden="true"></span>Individual emails</div>
        <p class="text-muted small mb-3">
            Turn off the reminders you don't want. Breach escalations to Legal / Privacy are a compliance
            obligation and are always sent.
            @if (_cadence != DigestCadence.Off)
            {
                <span class="d-block mt-1"><span class="bi bi-info-circle me-1" aria-hidden="true"></span>
                    Your digest already covers overdue and due-soon tasks, so you can turn those off here.</span>
            }
        </p>

        @Toggle("New case assignments", "when you're assigned to a case", () => _receiveAssignment, v => _receiveAssignment = v, _mandAssignment)
        @Toggle("Overdue reminders", "when one of your tasks passes its due date", () => _receiveOverdue, v => _receiveOverdue = v, _mandOverdue)
        @Toggle("Due-soon reminders", "shortly before one of your tasks is due", () => _receiveDueSoon, v => _receiveDueSoon = v, _mandDueSoon)
    </div>

    <div class="mt-3">
        <button class="btn btn-sm btn-primary" @onclick="Save" disabled="@_saving">
            @if (_saving) { <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> }
            Save
        </button>
    </div>
    <p class="text-muted small mt-3 mb-0" style="max-width:44rem">
        <span class="bi bi-info-circle me-1" aria-hidden="true"></span>
        Emails go out only once an administrator turns on the feature for this deployment. Your choices are
        saved and apply from then.
    </p>

    @* RD-17: your due tasks in your own calendar (it was on the Agenda page). *@
    <div class="im-card nc-card mt-4" style="max-width:44rem" id="calendar">
        <div class="fw-semibold mb-1"><span class="bi bi-calendar-week me-1" aria-hidden="true"></span>Calendar</div>
        @if (Feeds.Enabled && _feedUrl is not null)
        {
            <p class="text-muted small mb-2">
                Subscribe to this private URL in your calendar (Outlook: <em>Add calendar → Subscribe from web</em>) to keep
                your due tasks in sync. The link is personal to you, so treat it like a password.
            </p>
            <div class="input-group input-group-sm">
                <input class="form-control" readonly value="@_feedUrl" aria-label="Calendar feed URL" />
                <button class="btn btn-outline-secondary" type="button" @onclick="CopyFeed">
                    <span class="bi @(_copied ? "bi-check2" : "bi-clipboard")" aria-hidden="true"></span>
                    @(_copied ? "Copied" : "Copy")
                </button>
            </div>
            @* S-12: the link lasts a year and can be voided without affecting anyone else's. *@
            <p class="text-muted small mt-2 mb-2">
                Works until @TimeDisp.DateOnly(_feedExpires). If the link may have been shared or exposed,
                <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="ConfirmResetFeed">reset it</button>.
            </p>
            <ConfirmDialog @ref="_confirm" />
        }
        else
        {
            <p class="text-muted small mb-2">
                Syncing calendar subscriptions aren't turned on; download a one-time file instead.
                <AuthorizeView Policy="@Policies.Administer">
                    To turn them on, set <code>Agenda:FeedKey</code> in the server configuration.
                </AuthorizeView>
            </p>
        }
        <a class="btn btn-sm btn-outline-secondary" href="agenda/agenda.ics" title="Download an .ics file of your due tasks">
            <span class="bi bi-calendar-plus" aria-hidden="true"></span> Download your due tasks (.ics)
        </a>
    </div>

}

@code {
    private DigestCadence _cadence = DigestCadence.Off;
    private bool _receiveAssignment = true, _receiveOverdue = true, _receiveDueSoon = true;
    private bool _mandAssignment, _mandOverdue, _mandDueSoon;
    private bool _loaded;
    private bool _saving;
    private string? _feedUrl;
    private DateTimeOffset _feedExpires;
    private bool _copied;
    private ConfirmDialog _confirm = null!;

    private void SetFeed(IncidentManager.Application.Work.AgendaFeedLink? link)
    {
        _feedUrl = link is null ? null : Nav.ToAbsoluteUri($"agenda/feed.ics?token={Uri.EscapeDataString(link.Token)}").ToString();
        _feedExpires = link?.ExpiresAtUtc ?? default;
        _copied = false;
    }

    private void ConfirmResetFeed() => _confirm.Ask(this, "Reset calendar link",
        "Your current link stops working immediately, and any calendar subscribed to it stops updating. " +
        "You'll need to subscribe again with the new link.",
        "Reset link", async () => { SetFeed(await Feeds.ResetMyLinkAsync()); Toasts.Success("New calendar link ready. Re-subscribe with it."); });

    private async Task CopyFeed()
    {
        if (_feedUrl is null) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _feedUrl); _copied = true; }
        catch { /* clipboard blocked; the field stays selectable as a fallback */ }
    }

    protected override async Task OnInitializedAsync()
    {
        SetFeed(await Feeds.GetMyLinkAsync());
        _mandAssignment = Config.GetValue<bool>("Notifications:Mandatory:Assignment");
        _mandOverdue = Config.GetValue<bool>("Notifications:Mandatory:Overdue");
        _mandDueSoon = Config.GetValue<bool>("Notifications:Mandatory:DueSoon");

        var p = await Prefs.GetMineAsync();
        _cadence = p.DigestCadence;
        _receiveAssignment = !p.SuppressAssignment;
        _receiveOverdue = !p.SuppressOverdue;
        _receiveDueSoon = !p.SuppressDueSoon;
        _loaded = true;
    }

    private async Task Save()
    {
        _saving = true;
        try
        {
            // A mandatory type can't be opted out — never store it as suppressed.
            await Prefs.SetMineAsync(new NotificationPrefsView(
                _cadence,
                SuppressAssignment: !_mandAssignment && !_receiveAssignment,
                SuppressOverdue: !_mandOverdue && !_receiveOverdue,
                SuppressDueSoon: !_mandDueSoon && !_receiveDueSoon));
            Toasts.Success("Notification settings saved.");
        }
        catch (Exception) { Toasts.Error("Couldn't save your notification settings. Try again."); }
        finally { _saving = false; }
    }

    // A receive/don't-receive toggle. Mandatory types render checked + locked with an explanatory note.
    private RenderFragment Toggle(string title, string hint, Func<bool> get, Action<bool> set, bool mandatory) => __builder =>
    {
        <div class="form-check form-switch mb-2">
            <input class="form-check-input" type="checkbox" role="switch" id="notif-@(title.ToLowerInvariant().Replace(' ', '-'))"
                   checked="@(mandatory || get())" disabled="@mandatory"
                   @onchange="e => set((bool)(e.Value ?? false))" />
            <label class="form-check-label" for="notif-@(title.ToLowerInvariant().Replace(' ', '-'))">
                <strong>@title</strong>
                <span class="text-muted small d-block">@hint@(mandatory ? " · required by your organization" : "")</span>
            </label>
        </div>
    };

    private static string CadenceLabel(DigestCadence c) => c switch
    {
        DigestCadence.Daily => "Daily",
        DigestCadence.Weekly => "Weekly",
        _ => "Off"
    };

    private static string CadenceHint(DigestCadence c) => c switch
    {
        DigestCadence.Daily => "One digest each day you have open items.",
        DigestCadence.Weekly => "One digest each week you have open items.",
        _ => "No digest. You'll still get the individual emails turned on below."
    };
}
