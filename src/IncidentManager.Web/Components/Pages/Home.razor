@page "/"
@attribute [Authorize(Policy = Policies.ViewCases)]
@inject DashboardService Dashboard
@inject TimeDisplay TimeDisp
@inject NavigationManager Nav
@inject IAuthorizationService AuthZ
@inject AuthenticationStateProvider AuthState

<PageTitle>Dashboard</PageTitle>

<div class="dash">
<PageHeader Title="Leadership Dashboard"
           Subtitle="@(_asOf is null ? null : $"As of {_asOf}")">
    <Actions>
        @* UX-06: quick jump to the caller's own queue (the opposite-view cross-link). *@
        <a class="btn btn-sm btn-outline-secondary" href="work"
           title="Go to your own open cases and after-action tasks">
            <span class="bi bi-person-workspace" aria-hidden="true"></span> My work
        </a>
        <a class="btn btn-sm btn-outline-secondary" href="export/metrics.csv" download
           title="Download current metrics and 12-month trend as CSV for a board / regulatory pack">
            <span class="bi bi-download" aria-hidden="true"></span> Export metrics (CSV)
        </a>
    </Actions>
</PageHeader>

@if (_metrics is null)
{
    <span class="visually-hidden" role="status">Loading dashboard…</span>
    <div class="kpi-strip">
        @for (var i = 0; i < 5; i++)
        {
            <div class="skel" style="min-height:6.5rem;border-radius:0.9rem"></div>
        }
    </div>
    <div class="skel" style="min-height:17rem;border-radius:0.9rem;margin-bottom:14px"></div>
    <div class="dash-secondary">
        <div class="skel" style="min-height:11rem;border-radius:0.9rem"></div>
        <div class="skel" style="min-height:11rem;border-radius:0.9rem"></div>
    </div>
}
else
{
    var m = _metrics;
    var compTotal = m.Breaches + m.Incidents + m.AdverseEvents;

    @if (m.Breaches > 0 || m.OverdueActionItems > 0 || m.SlaBreached > 0)
    {
        <div class="dash-attn">
            <span class="dash-dot danger"></span>
            <strong>Needs attention:</strong>&nbsp;
            @{ var bits = new List<string>();
               if (m.Breaches > 0) bits.Add($"{m.Breaches} open breach{(m.Breaches == 1 ? "" : "es")}");
               if (m.SlaBreached > 0) bits.Add($"{m.SlaBreached} SLA breach{(m.SlaBreached == 1 ? "" : "es")}");
               if (m.OverdueActionItems > 0) bits.Add($"{m.OverdueActionItems} overdue task{(m.OverdueActionItems == 1 ? "" : "s")}"); }
            @string.Join(" · ", bits)
        </div>
    }

    @* ─── KPI strip ─────────────────────────────────────────────────────────── *@
    <div class="kpi-strip">
        <div class="kpi kpi-lead">
            <a class="kpi-open dash-link" href="cases" title="View all open cases">
                <span class="k-label">Open items</span>
                <span class="k-row">
                    <span class="k-value">@m.OpenCount</span>
                    @if (_openDelta != 0)
                    {
                        <span class="k-delta @(_openDelta > 0 ? "up" : "down")">
                            @(_openDelta > 0 ? "▲" : "▼") @Math.Abs(_openDelta)<span class="k-delta-note"> vs last month</span>
                        </span>
                    }
                </span>
            </a>
            <div class="compo" role="img" aria-label="Classification mix of open items">
                @if (compTotal == 0)
                {
                    <span class="seg empty" style="flex:1"></span>
                }
                else
                {
                    <span class="seg danger" style="flex:@Flex(m.Breaches)" title="Breaches"></span>
                    <span class="seg amber" style="flex:@Flex(m.Incidents)" title="Incidents"></span>
                    <span class="seg low" style="flex:@Flex(m.AdverseEvents)" title="Adverse events"></span>
                }
            </div>
            <div class="legend">
                <a class="dash-link" href="cases?classification=Breach"><i class="sw danger"></i>@m.Breaches Breaches</a>
                <a class="dash-link" href="cases?classification=Incident"><i class="sw amber"></i>@m.Incidents Incidents</a>
                <a class="dash-link" href="cases?classification=AdverseEvent"><i class="sw low"></i>@m.AdverseEvents Adverse</a>
            </div>
        </div>

        <StatTile Icon="bi-shield-exclamation" Value="m.Breaches" Label="Open breaches"
                  Tone="@(m.Breaches > 0 ? "danger" : "ok")" Href="cases?classification=Breach" />
        <StatTile Icon="bi-diagram-2" Value="m.ThirdPartyOrigin" Label="Third-party origin" Tone="accent" Href="cases?origin=ThirdParty" />
        <StatTile Icon="bi-hdd-network" Value="m.InternalOrigin" Label="Internal detection" Tone="accent" Href="cases?origin=InternalDetection" />
        <StatTile Icon="bi-list-check" Value="m.OverdueActionItems" Label="Overdue tasks"
                  Tone="@(m.OverdueActionItems > 0 ? "danger" : "ok")"
                  Href="@(m.OverdueActionItems > 0 ? "cases?overdue=true&closed=true" : null)" />
    </div>

    @* ─── Centerpiece: interactive 12-month activity chart ──────────────────── *@
    <div class="dash-card chart-card">
        <div class="c-head">
            <span class="c-title">Case activity
                <span class="c-note">last 12 months · @_openedTotal opened · @_closedTotal closed</span></span>
            <span class="bc-legend">
                <span><i class="lg accent"></i>Opened</span>
                <span><i class="lg ok"></i>Closed</span>
                <span><i class="lg line"></i>Open backlog</span>
            </span>
        </div>

        <div class="chart">
            <div class="chart-y">
                @foreach (var t in _yTicks)
                {
                    <span class="chart-y-lab" style="bottom:@(t.Pct)%">@t.Value</span>
                }
            </div>
            <div class="chart-plot">
                @foreach (var t in _yTicks)
                {
                    <span class="chart-grid" style="bottom:@(t.Pct)%"></span>
                }

                @* Open-backlog trend line, drawn over the bars (non-interactive visual layer). *@
                @if (_chartMax > 0 && _bars.Count > 1)
                {
                    <svg class="chart-line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                        <polyline points="@_backlogPoints" fill="none" stroke-width="2"
                                  vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round"
                                  style="stroke: var(--line)" />
                    </svg>
                }

                <div class="chart-cols">
                    @foreach (var b in _bars)
                    {
                        <a class="col dash-link@(b.Opened == 0 && b.Closed == 0 ? " col-empty" : "")"
                           href="cases?opened=@b.Key&closed=true"
                           aria-label="@b.Label: @b.Opened opened, @b.Closed closed, @b.End open at month end">
                            <span class="col-bars">
                                <span class="bar opened" style="height:@BarPct(b.Opened)%"></span>
                                <span class="bar closed" style="height:@BarPct(b.Closed)%"></span>
                            </span>
                            <span class="col-tip" role="tooltip">
                                <span class="tip-title">@b.Label</span>
                                <span class="tip-row"><i class="sw accent"></i>Opened<b>@b.Opened</b></span>
                                <span class="tip-row"><i class="sw ok"></i>Closed<b>@b.Closed</b></span>
                                <span class="tip-row"><i class="sw line"></i>Open backlog<b>@b.End</b></span>
                            </span>
                        </a>
                    }
                </div>
            </div>
            <div class="chart-x">
                @foreach (var b in _bars) { <span>@b.Short</span> }
            </div>
        </div>
    </div>

    @* ─── Secondary row: response & SLA · phase pipeline ────────────────────── *@
    <div class="dash-secondary">
        <div class="dash-card">
            <div class="c-head"><span class="c-title">Response &amp; SLA <span class="c-note">vs administered targets</span></span></div>

            <div class="rt-grid">
                <div class="rt-fig">
                    <div class="rt-fig-val @(m.MeanHoursToContain is null ? "muted" : "")">
                        @(m.MeanHoursToContain is { } hc ? $"{hc:0.#}" : "—")<span class="u">@(m.MeanHoursToContain is null ? "" : "h")</span>
                    </div>
                    <div class="rt-fig-lab">Mean time to contain</div>
                </div>
                <div class="rt-fig">
                    <div class="rt-fig-val @(m.MeanHoursToResolve is null ? "muted" : "")">
                        @(m.MeanHoursToResolve is { } hr ? $"{hr:0.#}" : "—")<span class="u">@(m.MeanHoursToResolve is null ? "" : "h")</span>
                    </div>
                    <div class="rt-fig-lab">Mean time to resolve</div>
                </div>
            </div>

            @ComplianceRow("Containment within target", m.ContainmentCompliancePercent, m.ContainmentMet, m.ContainmentMissed)
            @ComplianceRow("Resolution within target", m.ResolutionCompliancePercent, m.ResolutionMet, m.ResolutionMissed)

            @if (m.SlaBreached > 0 || m.SlaAtRisk > 0)
            {
                <a class="sla-line breached dash-link" href="cases?sla=true"
                   title="View open cases at or past their per-severity response-time target">
                    <span class="bi bi-clock-history" aria-hidden="true"></span>
                    <span><strong>@m.SlaBreached</strong> overdue · <strong>@m.SlaAtRisk</strong> at risk</span>
                    <span class="sla-go">View →</span>
                </a>
            }
            else
            {
                <div class="sla-line ok">
                    <span class="bi bi-check-circle" aria-hidden="true"></span>
                    <span>All open cases within SLA</span>
                </div>
            }
            <div class="rt-foot">Compliance and SLA flags are judged against the administered per-severity
                targets (<a class="dash-link u-link" href="admin/settings/sla">Settings → Response &amp; SLA</a>);
                mean times average every case that reached the milestone.</div>
        </div>

        <div class="dash-card">
            <div class="c-head"><span class="c-title">Open items by phase</span></div>
            @{ var maxPhase = Math.Max(1, m.ByPhase.Count == 0 ? 1 : m.ByPhase.Max(p => p.Count)); }
            <div class="pipe">
                @foreach (var phase in OpenPhases)
                {
                    var count = m.ByPhase.FirstOrDefault(p => p.Phase == phase)?.Count ?? 0;
                    <a class="prow dash-link @(count == 0 ? "off" : "")" href="cases?phase=@phase" title="View cases in @Ui.Label(phase)">
                        <span class="pl">@Ui.Label(phase)</span>
                        <span class="track">@if (count > 0) { <span class="fill" style="width:@(count * 100 / maxPhase)%"></span> }</span>
                        <span class="pc">@count</span>
                    </a>
                }
            </div>
        </div>
    </div>
}
</div>

@code {
    private DashboardMetrics? _metrics;
    private string? _asOf;

    private IReadOnlyList<BarPoint> _bars = [];
    private IReadOnlyList<YTick> _yTicks = [];
    private int _openDelta, _openedTotal, _closedTotal, _chartMax;
    private string _backlogPoints = "";

    private sealed record BarPoint(string Key, string Label, string Short, int Opened, int Closed, int End);
    private sealed record YTick(int Value, double Pct);

    // Lifecycle phases shown in the open-items pipeline (everything except Closed).
    private static readonly CasePhase[] OpenPhases =
        Enum.GetValues<CasePhase>().Where(p => p != CasePhase.Closed).ToArray();

    protected override async Task OnInitializedAsync()
    {
        // UX-06: role-aware landing. This is the leadership dashboard; only users who can see all cases
        // (Manager / Legal / SysAdmin) land here. Everyone else (analysts, ICs) starts on their own queue.
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        if (!(await AuthZ.AuthorizeAsync(user, Policies.ViewAllCases)).Succeeded)
        {
            Nav.NavigateTo("work", replace: true);
            return;
        }

        _metrics = await Dashboard.GetAsync();
        _asOf = TimeDisp.TimeOnly(DateTimeOffset.UtcNow);

        var t = _metrics.Trend;
        _openedTotal = t.Sum(x => x.Opened);
        _closedTotal = t.Sum(x => x.Closed);
        _openDelta = t.Count >= 2 ? t[^1].OpenAtEnd - t[^2].OpenAtEnd : 0;

        // One honest axis for bars and the backlog line: the tallest of any month's opened/closed/backlog.
        _chartMax = Math.Max(1, t.Count == 0 ? 1 : t.Max(x => Math.Max(Math.Max(x.Opened, x.Closed), x.OpenAtEnd)));

        _bars = t.Select(x =>
        {
            var d = new DateTime(x.Year, x.Month, 1);
            return new BarPoint(d.ToString("yyyy-MM"), d.ToString("MMM yyyy"), d.ToString("MMM"),
                x.Opened, x.Closed, x.OpenAtEnd);
        }).ToList();

        _yTicks = BuildYTicks(_chartMax);

        // Backlog polyline in a 0..100 viewBox: x centred on each column, y inverted (SVG origin top-left).
        if (_bars.Count > 1)
        {
            var n = _bars.Count;
            _backlogPoints = string.Join(" ", _bars.Select((b, i) =>
            {
                var x = (i + 0.5) / n * 100;
                var y = 100 - (double)b.End / _chartMax * 100;
                return $"{x.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}," +
                       $"{y.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}";
            }));
        }
    }

    // 0 / mid / max gridlines, rounded to readable values.
    private static IReadOnlyList<YTick> BuildYTicks(int max) =>
        new[] { 0, (int)Math.Round(max / 2.0), max }
            .Distinct()
            .Select(v => new YTick(v, max == 0 ? 0 : (double)v / max * 100))
            .ToList();

    // Non-zero counts get a small minimum height so a value of 1 is still visible against a tall max.
    private int BarPct(int value) => value == 0 ? 0 : Math.Max(4, value * 100 / _chartMax);

    private static string Flex(int n) => Math.Max(0.0001, n).ToString(System.Globalization.CultureInfo.InvariantCulture);

    private RenderFragment ComplianceRow(string label, int? pct, int met, int missed) => @<div class="cmp @(pct is null ? "cmp-na" : "")">
        <div class="cmp-head">
            <span class="cmp-label">@label</span>
            <span class="cmp-val">@(pct is { } p ? $"{p}%" : "—")</span>
        </div>
        <div class="cmp-track">
            @if (pct is { } pv)
            {
                <span class="cmp-fill @ComplianceTone(pv)" style="width:@pv%"></span>
            }
        </div>
        <div class="cmp-note">@(pct is null ? "no cases with a target yet" : $"{met} met · {missed} missed of {met + missed}")</div>
    </div>;

    private static string ComplianceTone(int pct) => pct >= 90 ? "ok" : pct >= 75 ? "warn" : "bad";
}
