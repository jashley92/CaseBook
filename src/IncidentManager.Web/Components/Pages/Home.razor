@page "/"
@* RD-17: the landing. Roles that see every case start on Program; everyone else on their Desk. *@
@attribute [Authorize(Policy = Policies.ViewCases)]
@inject NavigationManager Nav
@inject IAuthorizationService AuthZ
@inject AuthenticationStateProvider AuthState

<PageTitle>CaseBook</PageTitle>

@code {
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState.GetAuthenticationStateAsync()).User;
        var all = (await AuthZ.AuthorizeAsync(user, Policies.ViewAllCases)).Succeeded;
        Nav.NavigateTo(all ? "program" : "desk", replace: true);
    }
}
