@page "/admin/report-profiles"
@attribute [Authorize(Policy = Policies.Administer)]
@inject NavigationManager Nav

@* UX-16: report profiles moved onto the consolidated "Reports" settings page (with report defaults and the
   section-layout designer), so this old standalone route just forwards there for bookmarks and back-links. *@

@code {
    protected override void OnInitialized() =>
        Nav.NavigateTo("admin/settings/reporting", replace: true);
}
