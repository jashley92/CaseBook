@page "/integrity"
@attribute [Authorize(Policy = Policies.ViewCases)]
@inject IntegrityService IntegritySvc
@inject TimeDisplay TimeDisp
@inject IncidentManager.Application.Abstractions.IUserDirectory Users
@inject IncidentManager.Application.Abstractions.ILedgerStatus Ledger
@inject ICurrentUser CurrentUser
@implements IDisposable

<PageTitle>Integrity &amp; audit</PageTitle>

<PageHeader Title="Integrity & audit"
           Subtitle="Check that the audit trail is complete and unaltered." />

@* The persistent tamper banner is rendered app-wide for admins from MainLayout, so it already
   appears above this page — no page-level copy needed. The card below shows on-demand results. *@

<WhyThisMatters Class="mb-3">
    <p class="mb-1">Every change to a case is written to an append-only log where each entry carries a hash of the one before it,
        so altering, inserting or deleting any past entry breaks the chain from that point on. <strong>Verify</strong> recomputes it end to end.</p>
    <p class="mb-1">Periodic <strong>seals</strong> sign the chain head with a key held outside the database, so even a full rewrite
        by someone with database access is detectable against the last seal.</p>
    <p>Together they show an examiner that the case record is complete and unaltered, which NYDFS Part 500
        expects of audit trails.</p>
</WhyThisMatters>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">Audit entries</div>
            <div class="card-body">
                <span class="fs-3 fw-bold">@_count</span>
                @* E-10: the SQL Server ledger, when the deploy step has turned it on. Hidden on SQLite (dev). *@
                @if (_ledger is { Applicable: true } lg)
                {
                    <div class="small mt-2" title="SQL Server append-only ledger on the audit trail, seals and custody events. The database itself refuses changes to these rows, and saved digests prove they're unaltered.">
                        @if (lg.AllOn)
                        {
                            <span class="im-badge im-b-ok">Ledger on</span> <span class="text-muted">Database refuses edits to these rows.</span>
                        }
                        else
                        {
                            <span class="im-badge im-b-neutral">Ledger off</span> <span class="text-muted">@(lg.OnCount == 0 ? "Audit rows are protected by the hash chain and seals." : $"{lg.OnCount} of {lg.Tables.Count} tables. Rerun Enable-Ledger.ps1.")</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Chain verification</span>
                <div>
                    <button class="btn btn-sm btn-primary" @onclick="Verify">Verify now</button>
                    <AuthorizeView Policy="@Policies.Administer">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="Seal" disabled="@_sealing"
                                title="Verifies the whole chain first, and seals only if it's intact">Seal chain head</button>
                    </AuthorizeView>
                </div>
            </div>
            <div class="card-body">
                @if (_result is null)
                {
                    <span class="text-muted">Not verified this session.</span>
                }
                else if (_result.IsValid)
                {
                    <span class="im-badge im-b-ok">VALID</span>
                    <span class="ms-2">The audit chain is intact.</span>
                }
                else
                {
                    <span class="im-badge im-b-danger">BROKEN</span>
                    <span class="ms-2">First break at sequence @_result.FirstBrokenSequence: @_result.Detail</span>
                }
                @if (_result is not null && _verifiedAt is { } at)
                {
                    <div class="small text-muted mt-2">Verified @TimeDisp.Short(at)@(_verifiedShared ? " (reused from a check in the last minute)" : "").</div>
                }
                @if (_sealMessage is not null) { <div class="small text-muted mt-2">@_sealMessage</div> }
            </div>
        </div>
    </div>
</div>

<AuthorizeView Policy="@Policies.Administer">
    @* F-28: where the keys come from and where seal copies go; set in server configuration, shown here read-only. *@
    <div class="card mb-4">
        <div class="card-header">Keys and seal copies</div>
        <div class="card-body p-0"><IntegrityKeyStatus /></div>
    </div>
</AuthorizeView>

<AuthorizeView Policy="@Policies.Administer">
    <div class="card mb-4">
        <div class="card-header">Compliance evidence bundle</div>
        <div class="card-body">
            <p class="text-muted small mb-3">
                For a NYDFS §500.17(b) certification file or a DFS examination request. Contains the audit-chain
                segment for the date range, a full-chain verification, the signed seals covering it, and the public
                key with instructions to verify it independently. Each download is recorded in the audit trail.
            </p>
            <div class="row g-2 align-items-end">
                <div class="col-6 col-sm-4 col-md-3">
                    <label class="form-label small mb-1" for="bundleFrom">From (UTC)</label>
                    <DateInput Past="true" id="bundleFrom" class="form-control form-control-sm" @bind-Value="_bundleFrom" />
                </div>
                <div class="col-6 col-sm-4 col-md-3">
                    <label class="form-label small mb-1" for="bundleTo">To (UTC)</label>
                    <DateInput Past="true" id="bundleTo" class="form-control form-control-sm" @bind-Value="_bundleTo" />
                </div>
                <div class="col-12 col-sm-4 col-md-3">
                    <a class="btn btn-sm btn-primary" href="@BundleHref" download
                       title="Bundle for the selected date range">
                        <span class="bi bi-file-earmark-zip" aria-hidden="true"></span> Download bundle
                    </a>
                </div>
            </div>
        </div>
    </div>
</AuthorizeView>

<h4>Integrity seals</h4>
<p class="text-muted small">Each seal is an RSA-signed snapshot of the chain head, also exported outside the
database. Verifying a seal confirms its signature is authentic and that history at that point is unchanged.</p>
@if (_seals is null)
{
    <LoadingBlock />
}
else if (_seals.Count == 0)
{
    <p class="text-muted">No seals recorded yet.</p>
}
else
{
    <table class="table table-sm">
        <thead><tr><th>Sealed (UTC)</th><th>Up to #</th><th>Algorithm</th><th>Key</th><th>By</th><th>Verify</th></tr></thead>
        <tbody>
            @foreach (var s in _seals)
            {
                <tr>
                    <td class="small im-time">@TimeDisplay.UtcLabelled(s.SealedAtUtc)</td>
                    <td>@s.UpToSequence</td>
                    <td class="small">@s.Algorithm</td>
                    <td><code class="small">@s.KeyId</code></td>
                    <td class="small">@Users.DisplayFor(s.SealedBy)</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary py-0" @onclick="() => VerifySeal(s.Id)">Verify</button>
                        @if (_sealResults.TryGetValue(s.Id, out var r))
                        {
                            <span class="im-badge @(r.IsValid ? "im-b-ok" : "im-b-danger") ms-1">@(r.IsValid ? "VALID" : "BROKEN")</span>
                            <span class="small ms-1">@r.Detail</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* CAP-03: the whole trail, searchable and exportable: the filter row a case's Audit tab has, plus a case number, paged.
   Need-to-know scoped by the service (ScopedAuditLog), so the list and the export hold only cases the viewer can see. *@
<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
    <h4 id="audit-trail" class="mb-0">Audit trail</h4>
    <a class="btn btn-sm btn-outline-secondary" href="@AuditExportHref()"
       title="The filtered trail as CSV, newest first (up to 1,000,000 rows; a cut file says so)">
        <span class="bi bi-download me-1" aria-hidden="true"></span>Export these
    </a>
</div>
@if (!CurrentUser.Has(Permission.ViewAllCases) && !CurrentUser.Has(Permission.Administer))
{
    <p class="text-muted small">Showing entries for the cases you can see.</p>
}
<AuditFilterRow State="_filter" OnChanged="ApplyFilter" ShowCase="true" IdPrefix="trail" />
@if (_page is null)
{
    <LoadingBlock />
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
        <span class="small text-muted" aria-live="polite">@PageSummary()</span>
        @* UX-61: fifty entries a page (it was a hundred, 7,600px), under the shared table's sticky header; Newer and Older
           page through the trail by where a page starts (keyset, CAP-03), above the table and again below it. *@
        <span class="d-flex align-items-center gap-2">
            @if (Filtered)
            {
                <button type="button" class="btn btn-sm btn-link p-0" @onclick="ClearFilter">Clear filters</button>
            }
            @TrailPager(_page)
        </span>
    </div>
    @if (_page.Entries.Count == 0)
    {
        <p class="text-muted">No audit entries match the current filters.</p>
    }
    else
    {
        <DataTable TItem="IncidentManager.Domain.Entities.AuditLogEntry" Items="_page.Entries" PageSize="PageSize" Label="Audit entries" Key="a => a.Sequence">
            <Header><th>#</th><th>When (UTC)</th><th>Actor</th><th>Action</th><th>Entity</th><th>Case</th><th>What changed</th><th>Entry hash</th></Header>
            <Row Context="a">
                            <td>@a.Sequence</td>
                            <td class="small im-time text-nowrap">@TimeDisplay.Utc(a.AtUtc)</td>
                            <td>@Users.DisplayFor(a.Actor)</td>
                            <td>@AuditLabels.Label(a.Action)</td>
                            <td>
                                @AuditLabels.Entity(a.EntityType)
                                @if (!string.IsNullOrWhiteSpace(a.EntityLabel))
                                {
                                    <div class="small text-muted" title="@a.EntityLabel">@Trunc(a.EntityLabel!, 40)</div>
                                }
                            </td>
                            <td class="small">@a.CaseNumber</td>
                            <td class="small">@ChangeLine(a)</td>
                            @* BUG-573: a tampered row's hash can be shorter; the page that shows the break mustn't throw on it. *@
                            <td><code class="small">@IncidentManager.Application.Common.ShortHash.Of(a.EntryHash)</code></td>
            </Row>
        </DataTable>
        <div class="d-flex justify-content-end mt-2">@TrailPager(_page)</div>
    }
}

@code {
    private int _count;
    private ChainVerificationResult? _result;
    // CAP-03: the cross-case trail's filter (seeded from the address, so Administration's "History" link and a shared link
    // open it filtered), the page shown and the filter it was loaded with (BUG-388: the count and the CSV link describe
    // the table, not controls a load hasn't caught up with).
    private const int PageSize = 50;

    private RenderFragment TrailPager(AuditPage page) =>
        @<span class="btn-group btn-group-sm" role="group" aria-label="Pages of the audit trail">
            <button type="button" class="btn btn-outline-secondary" disabled="@(!page.HasNewer || page.Entries.Count == 0)" @onclick="Newer">
                <span class="bi bi-chevron-left" aria-hidden="true"></span> Newer
            </button>
            <button type="button" class="btn btn-outline-secondary" disabled="@(!page.HasOlder || page.Entries.Count == 0)" @onclick="Older">
                Older <span class="bi bi-chevron-right" aria-hidden="true"></span>
            </button>
        </span>;
    private readonly AuditFilterState _filter = new();
    private AuditPage? _page;
    // CAP-03 review: the page by where it starts in the trail (keyset), not by its number: an offset moved as entries were
    // written, so Older repeated some and Newer skipped some.
    private AuditPageAt _at = AuditPageAt.Newest;
    private AuditQueryFilter? _shownFilter;
    private DateTime? _shownFrom, _shownTo;
    private CancellationTokenSource? _loadCts;
    private int _loadSeq;

    // Never personal data in the page's own address (an actor is picked on the page, not read from it): a case number, an
    // action, a record type, a setting key and dates. CAP-03 review: the Export CSV link does carry actor= when one is
    // picked, as the case Audit tab's /export/case-audit.csv link always has; that's kept deliberately (a download link
    // the viewer clicks, for a filter they chose, not an address the page is shared by).
    [SupplyParameterFromQuery(Name = "case")] public string? QCase { get; set; }
    [SupplyParameterFromQuery(Name = "action")] public string? QAction { get; set; }
    [SupplyParameterFromQuery(Name = "entity")] public string? QEntity { get; set; }
    [SupplyParameterFromQuery(Name = "key")] public string? QKey { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? QFrom { get; set; }
    [SupplyParameterFromQuery(Name = "to")] public string? QTo { get; set; }
    private List<IntegritySeal>? _seals;
    private readonly Dictionary<Guid, SealVerificationResult> _sealResults = new();
    private string? _sealMessage;

    // Compliance evidence bundle range (UTC). Defaults to year-to-date — the natural §500.17(b) window.
    private DateOnly _bundleFrom = new(DateTime.UtcNow.Year, 1, 1);
    private DateOnly _bundleTo = DateOnly.FromDateTime(DateTime.UtcNow);
    // BUG-511: Gregorian whatever the server culture, as the endpoint reads it.
    private string BundleHref => string.Create(System.Globalization.CultureInfo.InvariantCulture,
        $"export/compliance-bundle.zip?from={_bundleFrom:yyyy-MM-dd}&to={_bundleTo:yyyy-MM-dd}");

    protected override async Task OnInitializedAsync()
    {
        _count = await IntegritySvc.AuditCountAsync();
        _seals = await IntegritySvc.RecentSealsAsync();
        _ledger = await Ledger.GetAsync();
    }

    // CAP-03 review (C15): the trail is seeded from the address here, not once in OnInitializedAsync. The nav menu's
    // "Integrity" from /integrity?entity=AppSetting&key=Email:From (a History link), and Back and Forward, reuse this
    // component, so a filter seeded only on first load stayed on the table, the "(filtered)" summary and the CSV link.
    // Only a change in what the address asks for reseeds, so a filter picked on the page isn't reset by a re-render.
    private (string?, string?, string?, string?, string?, string?)? _addressSeeded;
    private bool _disposed;

    protected override async Task OnParametersSetAsync()
    {
        if (_disposed) return;   // BUG-566: ComponentBase still runs this after a disposed OnInitializedAsync
        var address = (QCase, QAction, QEntity, QKey, QFrom, QTo);
        if (_addressSeeded == address) return;
        _addressSeeded = address;
        SeedFilterFromAddress();
        _at = AuditPageAt.Newest;
        await LoadTrail();
    }

    // CAP-03: what the address asks for; a value that doesn't parse is ignored (BUG-31), not an error.
    private void SeedFilterFromAddress()
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        _filter.Case = QCase?.Trim() ?? "";
        _filter.Action = IncidentManager.Domain.Common.EnumNames.OrNull<AuditAction>(QAction)?.ToString() ?? "";   // BUG-592
        _filter.Entity = QEntity?.Trim() ?? "";
        _filter.SettingKey = QKey?.Trim() ?? "";
        _filter.From = DateOnly.TryParse(QFrom, inv, System.Globalization.DateTimeStyles.None, out var f) ? f.ToDateTime(TimeOnly.MinValue) : null;
        _filter.To = DateOnly.TryParse(QTo, inv, System.Globalization.DateTimeStyles.None, out var t) ? t.ToDateTime(TimeOnly.MinValue) : null;
    }

    private bool Filtered => (_shownFilter ?? _filter.ToQuery(_filter.Case)) is { } f && (!f.IsEmpty || f.CaseNumber is not null);

    private string PageSummary()
    {
        if (_page is null || _page.Entries.Count == 0) return Filtered ? "No entries (filtered)" : "No entries";
        // CAP-03 review: the range by sequence (the # column), not "Entries 101–200": with keyset paging the page's place
        // counted from the newest isn't known, and entries written since would make it wrong anyway.
        var e = _page.Entries;
        var range = e.Count == 1 ? $"#{e[0].Sequence:N0}" : $"#{e[0].Sequence:N0} to #{e[^1].Sequence:N0}";
        return $"{e.Count:N0} entr{(e.Count == 1 ? "y" : "ies")}, {range}, newest first{(_page.HasNewer ? "" : " (the latest)")}{(Filtered ? " (filtered)" : "")}";
    }

    private async Task ApplyFilter()
    {
        _at = AuditPageAt.Newest;
        await LoadTrail();
    }

    private async Task ClearFilter()
    {
        _filter.Clear();
        await ApplyFilter();
    }

    // CAP-03 review: from the page shown, by its last (Older) or first (Newer) sequence.
    private async Task Older()
    {
        if (_page is not { Entries.Count: > 0 } p) return;
        _at = AuditPageAt.Older(p.Entries[^1].Sequence);
        await LoadTrail();
    }

    private async Task Newer()
    {
        if (_page is not { Entries.Count: > 0 } p) return;
        _at = AuditPageAt.Newer(p.Entries[0].Sequence);
        await LoadTrail();
    }

    // BUG-388 (as the case Audit tab): a newer load supersedes the one before it, which is cancelled, and its rows are
    // dropped if they land anyway.
    private async Task LoadTrail()
    {
        var previous = _loadCts;
        var seq = ++_loadSeq;
        var cts = _loadCts = new CancellationTokenSource();
        var ct = cts.Token;
        if (previous is not null)
        {
            await previous.CancelAsync();
            previous.Dispose();
        }
        var filter = _filter.ToQuery(_filter.Case);
        var (from, to, at) = (_filter.From, _filter.To, _at);
        try
        {
            if (!_filter.FacetsLoaded)
            {
                var facets = await IntegritySvc.AuditFacetsAsync(null, ct);
                if (seq != _loadSeq) return;
                (_filter.Actors, _filter.EntityTypes) = facets;
                _filter.FacetsLoaded = true;
            }
            var page = await IntegritySvc.QueryPageAsync(filter, at, PageSize, ct);
            if (seq != _loadSeq) return;
            (_page, _shownFilter, _shownFrom, _shownTo) = (page, filter, from, to);
            if (!page.HasNewer) _at = AuditPageAt.Newest;   // a Newer that reached the top is the newest page
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { /* superseded */ }
    }

    public void Dispose()
    {
        _disposed = true;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }

    // CAP-03: the CSV of the filter the table was loaded with.
    private string AuditExportHref()
    {
        var (f, fromDay, toDay) = _shownFilter is { } shown ? (shown, _shownFrom, _shownTo) : (_filter.ToQuery(_filter.Case), _filter.From, _filter.To);
        var qs = AuditFilterState.QueryString(f, fromDay, toDay);
        return qs.Length == 0 ? "export/audit.csv" : "export/audit.csv?" + qs;
    }

    // What moved, in one line (the case Audit tab shows it field by field, with the raw JSON).
    private static string ChangeLine(AuditLogEntry a)
    {
        var line = AuditChangeDetail.ToLine(AuditChangeDetail.Changes(a));
        if (!string.IsNullOrWhiteSpace(line)) return Trunc(line, 120);
        return a.Action switch { AuditAction.Create => "created", AuditAction.Delete => "removed", _ => a.Summary is { } s ? Trunc(s, 120) : "" };
    }

    private static string Trunc(string value, int max) => IncidentManager.Application.Common.TextFit.Cap(value, max) ?? "";   // C12

    private IncidentManager.Application.Abstractions.LedgerStatus? _ledger;

    // Track the result so the app-wide banner + monitor reflect this manual check and a break here
    // raises the same alarm (email + SIEM) as the background monitor — de-duplicated per episode.
    private async Task Verify()
    {
        var run = await IntegritySvc.VerifyOnDemandAsync();
        _result = run.Result;
        _verifiedAt = run.VerifiedAtUtc;
        _verifiedShared = run.Shared;
    }

    private DateTimeOffset? _verifiedAt;
    private bool _verifiedShared;   // S-20: the result came from a verification run under a minute ago

    private async Task VerifySeal(Guid sealId) =>
        _sealResults[sealId] = await IntegritySvc.VerifySealAsync(sealId);

    private bool _sealing;   // a double click verified the whole chain twice and could seal twice

    private async Task Seal()
    {
        if (_sealing) return;
        _sealing = true;
        try
        {
            IntegritySeal? seal;
            try { seal = await IntegritySvc.SealAsync(); }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException) { _sealMessage = ex.Message; return; }
            _sealMessage = seal is null
                ? "Nothing to seal yet."
                : $"Sealed through sequence {seal.UpToSequence} at {seal.SealedAtUtc:u} (key {seal.KeyId}).";
            _count = await IntegritySvc.AuditCountAsync();
            await LoadTrail();
            _seals = await IntegritySvc.RecentSealsAsync();
        }
        finally { _sealing = false; }
    }
}
