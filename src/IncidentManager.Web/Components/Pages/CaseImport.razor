@page "/cases/import"
@using IncidentManager.Application.Import
@using Microsoft.Extensions.Logging
@attribute [Authorize(Policy = Policies.EditCases)]
@implements IDisposable
@inject CaseImportService Import
@inject ToastService Toasts
@inject NavigationManager Nav
@inject ILogger<CaseImport> Logger
@inject IJSRuntime JS
@inject CaseService Cases
@inject ISeverityLabels SevLabels
@inject ICurrentUser CurrentUser
@inject CaseListMemory ListMemory

<PageTitle>Import case</PageTitle>

<PageHeader Title="Import case"
           Subtitle="Import a case-import JSON document, STIX 2.1 bundle or IOC CSV. Nothing is written until you review the preview and apply it." />

@* PROD-33: programmatic submissions awaiting human review, and the reviewing banner. *@
@if (_reviewingPendingId is not null)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2">
        <span class="bi bi-inbox" aria-hidden="true"></span>
        <span>Reviewing a <strong>submitted</strong> import. Nothing has been written yet. Confirm to write it into a case, or reject it.</span>
        <a class="btn btn-sm btn-outline-secondary ms-auto" href="cases/import">Back to queue</a>
    </div>
    @if (_preview is null) { <LoadingBlock /> }
}
else if (_pending.Count > 0)
{
    <div class="im-card nc-card">
        <div class="fw-semibold mb-1"><span class="bi bi-inbox me-1" aria-hidden="true"></span>Pending imports <span class="im-badge im-b-info">@_pending.Count</span></div>
        <p class="text-muted small mb-2">Submitted through the import API (for example, by a SOAR playbook). Nothing is written until you confirm.</p>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Submission</th><th style="width:11rem">Origin</th><th style="width:11rem">Submitted by</th><th style="width:12rem">When (@TimeDisp.Label)</th><th style="width:6rem"></th></tr></thead>
                <tbody>
                    @foreach (var pi in _pending)
                    {
                        <tr>
                            <td>@pi.Summary
                                @if (pi.StuckClaimedBy is { } who)
                                {
                                    @* WF-18: an apply that stopped part-way; any reviewer can put it back in the queue. *@
                                    <div class="small text-warning-emphasis">
                                        <span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>An apply by @who stopped without finishing
                                        @(pi.StuckSinceUtc is { } since ? $"({TimeDisp.Long(since)})" : "").
                                    </div>
                                }
                            </td>
                            <td class="small text-muted">@(pi.Origin ?? "—")</td>
                            <td class="small">@pi.SubmittedBy</td>
                            <td class="small text-muted">@TimeDisp.Short(pi.SubmittedAtUtc)</td>
                            <td>
                                @if (pi.StuckClaimedBy is null)
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="cases/import?pending=@pi.Id">Review</a>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning" @onclick="() => ReopenStuck(pi.Id)" disabled="@_reopening.Busy">Reopen</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (_reviewingPendingId is null)
{
@* Step 1 (PROD-32): generate a prompt for the analyst's own AI. CaseBook never calls an LLM. *@
<div class="im-card nc-card">
    <div class="d-flex justify-content-between align-items-center">
        <div class="fw-semibold"><span class="bi bi-robot me-1" aria-hidden="true"></span>Step 1: Generate a prompt for your AI <span class="text-muted small fw-normal">(optional)</span></div>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showPromptBuilder = !_showPromptBuilder">@(_showPromptBuilder ? "Hide" : "Show")</button>
    </div>
    @if (_showPromptBuilder)
    {
        <p class="text-muted small mt-2 mb-2">
            CaseBook never calls an AI. Paste this prompt into your <strong>own</strong> tool, such as Copilot, along with
            the incident's emails, chat logs and notes. It includes the import schema, so the JSON it returns can be
            pasted straight into Step 2.
        </p>
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1" for="imp-ai-tool">Your AI tool</label>
                <input id="imp-ai-tool" class="form-control form-control-sm" @bind="_promptTool" placeholder="e.g. Copilot" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1" for="imp-target">Target</label>
                @* BUG-638: Blazor renders a bool attribute as present/absent, so value="@bool" left no option selected (a blank box) once Existing case was picked. *@
                <select id="imp-target" class="form-select form-select-sm" value="@(_promptExisting ? "True" : "False")" @onchange="OnPromptTargetChanged">
                    <option value="False">New case</option>
                    <option value="True">Existing case</option>
                </select>
            </div>
            @if (!_promptExisting)
            {
                <div class="col-md-3">
                    <label class="form-label small mb-1" for="imp-class-hint">Classification hint</label>
                    <select id="imp-class-hint" class="form-select form-select-sm" value="@(_promptClassification?.ToString() ?? "")"
                            @onchange="e => _promptClassification = IncidentManager.Domain.Common.EnumNames.OrNull<Classification>(e.Value?.ToString())">
                        <option value="">Let the AI choose</option>
                        @* BUG-542: a rung this role can't file (REV-14) would only be dropped from the document. *@
                        @if (CanClassify) { @foreach (var cl in Enum.GetValues<Classification>()) { <option value="@cl">@Ui.Label(cl)</option> } }
                    </select>
                </div>
            }
            @if (!_promptExisting)
            {
                @* BUG-635 *@
                <div class="col-md-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="imp-ai-exercise" @bind="_promptExercise" />
                        <label class="form-check-label small" for="imp-ai-exercise"><span class="bi bi-mortarboard me-1" aria-hidden="true"></span>Tabletop / exercise</label>
                    </div>
                </div>
            }
            <div class="col-md-3">
                <button class="btn btn-sm btn-primary" @onclick="GeneratePrompt"><span class="bi bi-stars me-1" aria-hidden="true"></span>Generate prompt</button>
            </div>
        </div>
        @if (_prompt is not null)
        {
            <textarea class="form-control font-monospace mt-2" rows="10" readonly aria-label="Generated prompt">@_prompt</textarea>
            <button class="btn btn-sm btn-outline-primary mt-2" @onclick="CopyPrompt"><span class="bi bi-clipboard me-1" aria-hidden="true"></span>Copy prompt</button>
        }
    }
</div>

@* Step 2 (PROD-31): paste/upload the resulting JSON and review the preview. *@
<div class="im-card nc-card">
    <div class="fw-semibold mb-2"><span class="bi bi-box-arrow-in-down me-1" aria-hidden="true"></span>Step 2: Paste or upload the import</div>
    <p class="text-muted small mb-2">
        The document is treated as <strong>untrusted</strong>. You can edit or exclude each item before anything is written,
        and unknown values are flagged. For the format, see the <a href="#" @onclick="ToggleSample" @onclick:preventDefault>sample</a>
        or the <a href="api/import/cases/schema" target="_blank" rel="noopener noreferrer">JSON Schema</a>.
        <br />A <strong>STIX 2.1 bundle</strong> or <strong>IOC CSV</strong> also works. A CSV needs a <code>value</code> or <code>indicator</code>
        column (optional: <code>type</code>, <code>disposition</code>, <code>label</code>, <code>description</code>, <code>source</code>), or one indicator per line.
    </p>

    <label class="form-label" for="imp-json">Import JSON, STIX bundle or CSV</label>
    @* BUG-605: not bound. A pasted document went to the server whole in one input event, and one over the hub's 32 KB
       message limit dropped the connection, so the paste never arrived (an upload streams, so it worked). Preview streams
       the box's text instead, as an upload does. *@
    <textarea id="imp-json" class="form-control font-monospace" rows="6"
              placeholder='{ "format": "casebook-case-import", "schemaVersion": 1, ... }'></textarea>

    <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
        <button class="btn btn-sm btn-primary" @onclick="PreviewFromBox" disabled="@_readingBox">
            <span class="bi bi-eye me-1" aria-hidden="true"></span>Preview import
        </button>
        @* BUG-636: what a time written without a zone means (a document's own "timeZone" wins). *@
        <label class="small text-muted ms-1" for="imp-zone">Times without a zone are in</label>
        @* BUG-655: a change re-reads the document shown; not once part of it is applied (the rest follows that reading). *@
        <select id="imp-zone" class="form-select form-select-sm w-auto" @bind="_unzonedZoneId" @bind:after="ZoneChanged"
                disabled="@(_applying || _preview is { } zp && TargetLocked(zp))">
            @foreach (var (id, label) in ZoneChoices())
            {
                <option value="@id">@label</option>
            }
        </select>
        <span class="text-muted small">or upload a file:</span>
        <InputFile OnChange="OnFileSelected" accept=".json,.stix,.csv,.txt" class="form-control form-control-sm" style="max-width:20rem" />
        @if (_preview is not null)
        {
            <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="Reset">Clear</button>
        }
    </div>
    @if (_zoneNote is not null)
    {
        <div class="alert alert-info small mt-2 mb-0" role="status">@_zoneNote</div>
    }
    @if (_parseError is not null)
    {
        @* Stays put next to the document (not a toast) so it can be read while fixing the text. *@
        <div class="alert alert-danger small mt-2 mb-0" role="alert">@_parseError</div>
    }

    @if (_showSample)
    {
        <pre class="border rounded bg-body-tertiary p-2 mt-2 small" style="max-height:16rem;overflow:auto">@SampleJson</pre>
    }
</div>
}

@if (_preview is { } p)
{
    @if (p.Warnings.Count > 0)
    {
        <div class="alert alert-warning py-2">
            <div class="fw-semibold mb-1"><span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>@(p.Warnings.Count == 1 ? "1 note" : $"{p.Warnings.Count} notes") to review before applying</div>
            <ul class="mb-0 small">@foreach (var w in p.Warnings) { <li>@w</li> }</ul>
        </div>
    }

    @* Target *@
    <div class="im-card nc-card">
        <div class="fw-semibold mb-2">Target</div>
        @if (TargetLocked(p))
        {
            @* BUG-120: say why the choice is fixed: the rest has to follow what's already in. *@
            <div class="form-text mb-2">Part of this import is already in a case, so the rest goes there too. The target can't change now.</div>
        }
        <div class="form-check">
            <input class="form-check-input" type="radio" id="tgtNew" checked="@(p.TargetKind == CaseImportTargetKind.NewCase)" disabled="@TargetLocked(p)"
                   @onchange="async () => { p.TargetKind = CaseImportTargetKind.NewCase; await RefreshGates(); }" />
            <label class="form-check-label" for="tgtNew">Create a new case</label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input" type="radio" id="tgtExisting" checked="@(p.TargetKind == CaseImportTargetKind.ExistingCase)" disabled="@TargetLocked(p)"
                   @onchange="() => p.TargetKind = CaseImportTargetKind.ExistingCase" />
            <label class="form-check-label" for="tgtExisting">Add to an existing case</label>
        </div>

        @if (p.TargetKind == CaseImportTargetKind.NewCase && p.NewCase is { } nc)
        {
            <div class="row g-2">
                <div class="col-md-6">
                    <label class="form-label small mb-1" for="imp-nc-title">Title <span class="text-danger">*</span></label>
                    <input id="imp-nc-title" class="form-control form-control-sm" @bind="nc.Title"
                           @bind:after="() => nc.DescriptiveName = CaseImportService.SlugSource(nc.Title)" />
                    @* BUG-637: as the New case form: the number the case will get, from the title. *@
                    @if (string.IsNullOrWhiteSpace(nc.CaseNumber))
                    {
                        <div class="form-text">Case number <code>@PreviewNumber(nc)</code> is assigned automatically.</div>
                    }
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="imp-nc-class">Classification</label>
                    <select id="imp-nc-class" class="form-select form-select-sm" value="@(nc.Classification?.ToString() ?? "")"
                            @onchange="async e => { SetClassification(nc, e.Value?.ToString()); await RefreshGates(); }">
                        <option value="">Complex Event</option>
                        @* BUG-542: REV-14, as CreateCase: only the rungs this role can file (the preview drops any other). *@
                        @if (CanClassify) { @foreach (var c in Enum.GetValues<Classification>()) { <option value="@c">@Ui.Label(c)</option> } }
                    </select>
                    @if (!CanClassify)
                    {
                        <div class="form-text">Your role files Complex Events. Someone who can change a case's classification
                            promotes it onto the ladder.</div>
                    }
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="imp-nc-severity">Severity</label>
                    <select id="imp-nc-severity" class="form-select form-select-sm" @bind="nc.Severity">
                        @foreach (var s in Enum.GetValues<Severity>()) { <option value="@s">@SevLabels.For(s)</option> }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small mb-1" for="imp-nc-origin">Origin</label>
                    <select id="imp-nc-origin" class="form-select form-select-sm" @bind="nc.Origin">
                        <option value="@CaseOrigin.InternalDetection">Internal detection</option>
                        <option value="@CaseOrigin.ThirdParty">Third-party / vendor</option>
                    </select>
                </div>
                @if (nc.Origin == CaseOrigin.ThirdParty)
                {
                    <div class="col-md-4">
                        <label class="form-label small mb-1" for="imp-nc-vendor">Vendor</label>
                        <input id="imp-nc-vendor" class="form-control form-control-sm" maxlength="300" @bind="nc.VendorName" @bind:event="oninput"
                               placeholder="Who disclosed it" />
                    </div>
                }
                @* BUG-637: as the New case form's Advanced: choose the case number instead of the automatic one. *@
                <div class="col-12">
                    <details class="nc-advanced" open="@(!string.IsNullOrWhiteSpace(nc.CaseNumber))">
                        <summary class="small">Advanced</summary>
                        <div class="mt-2" style="max-width: 28rem">
                            <label class="form-label small mb-1" for="imp-nc-number">Case number <span class="text-muted">(optional)</span></label>
                            <input id="imp-nc-number" class="form-control form-control-sm" @bind="nc.CaseNumber" @bind:after="() => CheckNumberAvailable(nc)"
                                   placeholder="@PreviewNumber(nc)" maxlength="64" />
                            @if (_numberAvailable == false)
                            {
                                <div class="form-text text-danger"><span class="bi bi-x-circle me-1" aria-hidden="true"></span>“@(nc.CaseNumber?.Trim())” is in use, or was used before by another case (its audit trail keeps the number). Pick another or leave it blank.</div>
                            }
                            else if (_numberAvailable == true)
                            {
                                <div class="form-text text-success"><span class="bi bi-check-circle me-1" aria-hidden="true"></span>Available.</div>
                            }
                            else
                            {
                                <div class="form-text">Leave blank to number it automatically.</div>
                            }
                        </div>
                    </details>
                </div>
                @* WF-54: as the New case form: restricted to need-to-know from the start, and put on the team. Off by default. *@
                <div class="col-12">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="imp-nc-restricted" @bind="nc.IsRestricted" />
                        <label class="form-check-label small" for="imp-nc-restricted">
                            <span class="bi bi-lock me-1" aria-hidden="true"></span>Restricted (need-to-know)
                        </label>
                    </div>
                    @* BUG-635: a tabletop case, as the New case form: fixed once created, and kept away from live cases. *@
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="imp-nc-exercise" @bind="nc.IsExercise" @bind:after="ExerciseChanged" />
                        <label class="form-check-label small" for="imp-nc-exercise">
                            <span class="bi bi-mortarboard me-1" aria-hidden="true"></span>Tabletop / exercise case
                        </label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="imp-nc-assign" @bind="nc.AssignToMe" />
                        <label class="form-check-label small" for="imp-nc-assign">
                            <span class="bi bi-person-check me-1" aria-hidden="true"></span>Assign it to me
                        </label>
                    </div>
                    @if (nc.IsExercise)
                    {
                        <div class="form-text">A drill: badged, and kept out of dashboards, reminders, the IOC feed and cross-case correlation. This can't be changed after the case is created.</div>
                    }
                    @if (nc.IsRestricted)
                    {
                        <div class="form-text">Visible only to the incident commander, the case team and roles cleared for restricted cases. If your role isn't cleared, you're added to the team.</div>
                    }
                </div>
            </div>
            @if (nc.Origin == CaseOrigin.ThirdParty && string.IsNullOrWhiteSpace(nc.VendorName))
            {
                <div class="form-text text-danger">Name the vendor to create a third-party case.</div>
            }
            @if (string.IsNullOrWhiteSpace(nc.Title))
            {
                <div class="form-text text-danger">Enter a title to create the case.</div>
            }
            @* BUG-61: a case created at a rung passes that rung's gate (and those below it), as escalating one does. *@
            @if (_gate.Gate is { } gate)
            {
                <div class="mt-2">
                    <div class="small fw-semibold">Creating it as @(Ui.Label(nc.Classification)): @gate.GateName</div>
                    <div class="form-text mt-0">The same readiness checks as escalating a case to this rung, judged from what this
                        import adds. Anything required that's still unmet needs an override reason, recorded with the case.</div>
                    <IncidentManager.Web.Components.Pages.Workspace.GateSection Draft="_gate" OnChanged="StateHasChanged" />
                </div>
            }
        }
        else if (p.TargetKind == CaseImportTargetKind.ExistingCase)
        {
            @if (p.ExistingCaseId is not null)
            {
                <div class="alert alert-info py-2 mb-0">
                    Importing into <code>@p.ExistingCaseNumber</code> — @p.ExistingTitle
                    <button class="btn btn-link btn-sm p-0 ms-2 align-baseline" @onclick="() => ClearExisting(p)">change</button>
                </div>
            }
            else
            {
                <div class="d-flex flex-wrap gap-2 align-items-end">
                    <div>
                        <label class="form-label small mb-1" for="imp-existing-number">Case number</label>
                        <input id="imp-existing-number" class="form-control form-control-sm" style="max-width:16rem" @bind="_existingNumber"
                               placeholder="e.g. 2026-04_Phishing_Wave" />
                    </div>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ResolveExisting(p)" disabled="@string.IsNullOrWhiteSpace(_existingNumber)">Find</button>
                    @if (_existingError is not null) { <span class="text-danger small">@_existingError</span> }
                </div>
            }
        }
    </div>

    @* Provenance + summary *@
    <div class="im-card nc-card">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small mb-1" for="imp-origin">Origin (provenance)</label>
                <input id="imp-origin" class="form-control form-control-sm" @bind="p.Origin" placeholder="e.g. AI-assisted (Copilot), manual, XSIAM" />
                <div class="form-text">Recorded as the source of imported indicators and timeline entries.</div>
            </div>
            <div class="col-md-6">
                <div class="form-check mb-1">
                    <input class="form-check-input" type="checkbox" id="incSummary" @bind="p.IncludeSummary" disabled="@string.IsNullOrWhiteSpace(p.Summary)" />
                    <label class="form-check-label small" for="incSummary">Import summary as an analyst note</label>
                </div>
                <textarea class="form-control form-control-sm" rows="2" aria-label="Summary" @bind="p.Summary" placeholder="(no summary in the document)"></textarea>
            </div>
        </div>
    </div>

    @* Timeline *@
    @if (p.Timeline.Count > 0)
    {
        <div class="im-card nc-card">
            <div class="fw-semibold mb-2">Timeline <span class="text-muted small">(@p.Timeline.Count(r => r.Include) of @p.Timeline.Count)</span></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th style="width:2rem"></th><th style="width:12rem">When (@TimeDisp.Label)</th><th style="width:8rem">Kind</th><th style="width:9rem">Type</th><th>Description</th><th style="width:10rem">Source</th></tr></thead>
                    <tbody>
                        @foreach (var t in p.Timeline)
                        {
                            <tr class="@(t.Include ? "" : "opacity-50")">
                                <td><input class="form-check-input" type="checkbox" aria-label="Include timeline entry @(p.Timeline.IndexOf(t) + 1)" @bind="t.Include" /></td>
                                <td>
                                    @if (t.Kind == TimelineKind.Event && IncidentManager.Application.Cases.StepTime.Stated(t.Precision, t.OccurredAtUtc, t.OccurredUntilUtc) is { } stated)
                                    {
                                        @* ST-03: kept as the source stated it; an exact time can still be given here. *@
                                        <div class="small fst-italic">@stated</div>
                                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => t.Precision = TimePrecision.Exact">Give an exact time</button>
                                    }
                                    else
                                    {
                                        @* BUG-664: in the viewer's own time display, as everywhere else, not UTC. *@
                                        <DateTimeInput Past="true" TValue="DateTime" class="form-control form-control-sm" aria-label="@($"When ({TimeDisp.Label})")"
                                                       Value="@WallClock.ToWall(t.OccurredAtUtc, TimeDisp.Zone)" ValueChanged="v => SetOccurred(t, v)" />
                                    }
                                    @if (t.Warning is not null) { <div class="form-text text-warning small">@t.Warning</div> }
                                </td>
                                <td><select class="form-select form-select-sm" aria-label="Kind" @bind="t.Kind">@foreach (var k in Enum.GetValues<TimelineKind>()) { <option value="@k">@k</option> }</select></td>
                                <td><select class="form-select form-select-sm" aria-label="Type" @bind="t.Type">@foreach (var ty in Enum.GetValues<TimelineEntryType>().Where(x => x != TimelineEntryType.Handoff)) { <option value="@ty">@Ui.Label(ty)</option> }</select></td>
                                <td><input class="form-control form-control-sm" aria-label="Description" @bind="t.Description" /></td>
                                <td><input class="form-control form-control-sm" aria-label="Source" @bind="t.Source" /></td>
                            </tr>
                            @if (t.Type == TimelineEntryType.Decision)
                            {
                                @* INV-18: a decision is imported with its why. *@
                                <tr class="@(t.Include ? "" : "opacity-50")">
                                    <td></td>
                                    <td colspan="5">
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <input class="form-control form-control-sm @(t.Include && string.IsNullOrWhiteSpace(t.Rationale) ? "is-invalid" : "")"
                                                       aria-label="Why it was decided" placeholder="Why it was decided (required)" @bind="t.Rationale" @bind:event="oninput" />
                                            </div>
                                            <div class="col-md-3"><input class="form-control form-control-sm" aria-label="Options considered" placeholder="Options considered" @bind="t.OptionsConsidered" /></div>
                                            <div class="col-md-3"><input class="form-control form-control-sm" aria-label="Decided by" placeholder="Decided by" @bind="t.DecidedBy" /></div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* PROD-06: indicators already on other open cases — a prompt to relate them, never an automatic link. *@
    @if (_related.Count > 0)
    {
        <div class="im-card nc-card">
            <div class="fw-semibold mb-1"><span class="bi bi-intersect me-1" aria-hidden="true"></span>Already seen on open cases</div>
            <p class="text-muted small mb-2">Some of these indicators appear on other open cases. After applying, you can link related cases from the case's Overview.</p>
            <ul class="list-unstyled small mb-0">
                @foreach (var m in _related)
                {
                    <li class="mb-1">
                        <a href="@($"cases/{m.CaseId}")" target="_blank" rel="noopener noreferrer"><code>@m.CaseNumber</code></a>
                        <span class="text-muted">@m.Title</span> ·
                        @string.Join(", ", m.Indicators.Take(5))@(m.Indicators.Count > 5 ? $" +{m.Indicators.Count - 5} more" : "")
                    </li>
                }
            </ul>
        </div>
    }

    @* Entities *@
    @if (p.Entities.Count > 0)
    {
        <div class="im-card nc-card">
            <div class="fw-semibold mb-2">Entities <span class="text-muted small">(@p.Entities.Count(r => r.Include) of @p.Entities.Count)</span></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th style="width:2rem"></th><th style="width:9rem">Type</th><th>Value</th><th style="width:9rem">Disposition</th><th style="width:7rem">TLP</th><th style="width:10rem">Source</th></tr></thead>
                    <tbody>
                        @foreach (var e in p.Entities)
                        {
                            <tr class="@(e.Include ? "" : "opacity-50")">
                                <td><input class="form-check-input" type="checkbox" aria-label="Include entity @(p.Entities.IndexOf(e) + 1)" @bind="e.Include" @bind:after="RefreshGates" /></td>
                                <td>
                                    <select class="form-select form-select-sm" aria-label="Type" @bind="e.Type">@foreach (var ty in Enum.GetValues<EntityType>()) { <option value="@ty">@Ui.Label(ty)</option> }</select>
                                    @if (e.Type == EntityType.Other) { <div class="form-text text-warning small">Check the type</div> }
                                </td>
                                <td><input class="form-control form-control-sm font-monospace" aria-label="Value" @bind="e.Value" /></td>
                                <td><select class="form-select form-select-sm" aria-label="Disposition" @bind="e.Disposition" @bind:after="RefreshGates">@foreach (var d in Enum.GetValues<EntityDisposition>()) { <option value="@d">@Ui.Label(d)</option> }</select></td>
                                <td class="small" title="The document's marking, kept on the indicator. None: the case's default applies.">@(e.Tlp is { } tlp ? IncidentManager.Domain.Enums.Tlp.Label(tlp) : "—")</td>
                                <td><input class="form-control form-control-sm" aria-label="Source" @bind="e.Source" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* Action items *@
    @if (p.ActionItems.Count > 0)
    {
        <div class="im-card nc-card">
            <div class="fw-semibold mb-2">Tasks <span class="text-muted small">(@p.ActionItems.Count(r => r.Include) of @p.ActionItems.Count)</span></div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th style="width:2rem"></th><th>Title</th><th style="width:12rem">Owner</th><th style="width:12rem">Due (@TimeDisp.Label)</th></tr></thead>
                    <tbody>
                        @foreach (var a in p.ActionItems)
                        {
                            <tr class="@(a.Include ? "" : "opacity-50")">
                                <td><input class="form-check-input" type="checkbox" aria-label="Include task @(p.ActionItems.IndexOf(a) + 1)" @bind="a.Include" /></td>
                                <td><input class="form-control form-control-sm" aria-label="Title" @bind="a.Title" /></td>
                                <td><input class="form-control form-control-sm" aria-label="Owner" @bind="a.Owner" /></td>
                                <td class="small text-muted">@(a.DueAtUtc is { } due ? TimeDisp.Short(due) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (_error is not null) { <div class="alert alert-danger">@_error</div> }

    @if (_rejecting)
    {
        @* Rejecting is a decision on someone else's submission, so it takes one explicit step and an optional
           reason (recorded with the rejection) rather than firing on the first click. *@
        <div class="card border-danger-subtle mb-3">
            <div class="card-body">
                <label class="form-label fw-semibold" for="reject-note">Reject this import?</label>
                <textarea id="reject-note" class="form-control form-control-sm mb-2" rows="2" maxlength="1000"
                          placeholder="Reason (optional), for example: duplicate of an existing case" @bind="_rejectNote"></textarea>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-danger" @onclick="Reject" disabled="@_applying">Reject import</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _rejecting = false">Keep reviewing</button>
                </div>
                <div class="form-text">Nothing from the submission is written to a case.</div>
            </div>
        </div>
    }

    <div class="nc-actions">
        <button class="btn btn-primary" @onclick="Apply" disabled="@(_applying || !CanApply(p) || GateUnresolved || !PreviewIsCurrent)">
            <span class="bi bi-check2-circle me-1" aria-hidden="true"></span>@(_reviewingPendingId is null ? "Apply import" : "Confirm & apply") (@IncidentManager.Application.Common.Plural.Of(p.IncludedItemCount, "item"))
        </button>
        @if (_reviewingPendingId is not null)
        {
            <button class="btn btn-outline-danger" @onclick="() => _rejecting = true" disabled="@(_applying || _rejecting)">Reject…</button>
        }
        <a class="btn btn-outline-secondary" href="@ListMemory.BackHref">Cancel</a>   @* BUG-593: the list as it was left *@
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "into")] public string? IntoCaseIdRaw { get; set; }
    private Guid? IntoCaseId => QueryValue.Id(IntoCaseIdRaw);   // BUG-31: a bad value is ignored, not an error
    [SupplyParameterFromQuery(Name = "pending")] public string? PendingIdRaw { get; set; }
    private Guid? PendingId => QueryValue.Id(PendingIdRaw);

    // PROD-06: the uploaded file's name (provenance for a CSV) and open cases sharing the previewed indicators.
    private string? _fileName;
    private List<IncidentManager.Application.Cases.CaseIocMatch> _related = [];

    // PROD-33: the pending programmatic-import queue + the one currently under review.
    private Guid? _reviewingPendingId;
    private List<PendingImportSummary> _pending = new();

    // BUG-601 (C5): what's shown comes from awaited reads, and the page moves on while they run (another Review link,
    // Back to queue, a newer Preview, Clear, leaving). Each read takes a ticket and lands only while it is current:
    // _navigations for each visit to the page's address, _previews for the preview shown (a pasted, uploaded or queued
    // one; Apply and Reject act only on the current one), _reads for a file or the box being read, _queue for the pending
    // list, _finds for the case lookup.
    private readonly LoadSequence _navigations = new();
    private readonly LoadSequence _reads = new();
    private readonly LoadSequence _previews = new();
    private readonly LoadSequence _queue = new();
    private readonly LoadSequence _finds = new();
    private LoadSequence.Ticket? _shown;   // the _previews ticket of the preview on screen
    private bool PreviewIsCurrent => _shown is { } s && _previews.IsCurrent(s);
    private readonly InFlight _reopening = new();   // BUG-603

    private async Task LoadQueue()
    {
        var t = _queue.Begin();
        var pending = await Import.ListPendingAsync();
        if (_queue.IsCurrent(t)) _pending = pending.ToList();
    }

    // WF-18: puts a stuck import back in the queue (audited) and opens it for review.
    private Task ReopenStuck(Guid id) => _reopening.Run(() => ReopenStuckCore(id));

    private async Task ReopenStuckCore(Guid id)
    {
        try
        {
            if (!await Import.ReopenStuckAsync(id))
            {
                Toasts.Error("That import isn't stuck any more. Reload to see where it is.");
                await LoadQueue();
                return;
            }
            // BUG-601: not if the page was left, or a Review opened, while it ran.
            if (!_disposed && PendingId is null) Nav.NavigateTo($"cases/import?pending={id}");
        }
        catch (Exception ex) when (ex is ForbiddenException or InvalidOperationException) { Toasts.Error(ex.Message); }
    }
    private string? _rejectNote;
    private bool _rejecting;

    protected override async Task OnParametersSetAsync()
    {
        var nav = _navigations.Begin();
        if (PendingId is null) LeaveReview();   // Back to queue, or the plain address: no queued review open
        await LoadQueue();
        if (PendingId is not { } pid || (pid == _reviewingPendingId && _preview is not null) || !_navigations.IsCurrent(nav)) return;

        // BUG-601: the review in the address is the one open from here on; the last one (and a file or paste still being
        // read, which would preview over it) is let go while it loads.
        _reads.Invalidate();
        ClearReviewState();
        _reviewingPendingId = pid;
        (_preview, _shown) = (null, null);
        var shown = _previews.Begin();
        var preview = await Import.BuildPreviewForPendingAsync(pid);
        // BUG-601: a later visit (another Review link, Back to queue) or leaving took over while it loaded; shown, Apply /
        // Reject would have acted on a submission other than the one in the address.
        if (!_navigations.IsCurrent(nav) || !_previews.IsCurrent(shown)) return;
        if (preview is null)
        {
            Toasts.Error("That submitted import is no longer available. It may already have been reviewed.");
            Nav.NavigateTo("cases/import");
            return;
        }
        (_preview, _shown) = (preview, shown);
        _text = null;
        _error = null;
        await ShowInBox(null);
        await RefreshGates();
    }

    // The queued review shown is closed (Back to queue, a reject): the plain import page shows. A pasted preview isn't a
    // review and stays; a review still loading is dropped by its _navigations ticket.
    private void LeaveReview()
    {
        if (_reviewingPendingId is null) return;
        _previews.Invalidate();
        _finds.Invalidate();
        _reviewingPendingId = null;
        (_preview, _shown) = (null, null);
        ClearReviewState();
    }

    // BUG-386: what belonged to the last preview or review (its related cases, a half-written rejection, a parse error, the
    // case looked up, the gate's ticks) mustn't carry into the next queued review, or back out of one.
    private void ClearReviewState()
    {
        _numberAvailable = null;   // BUG-637
        _related = [];
        _rejecting = false;
        _rejectNote = null;
        _parseError = null;
        _existingNumber = null;
        _existingError = null;
        _fileName = null;
        (_zoneNote, _readZoneId) = (null, null);   // BUG-655
        _gate.UseGate(null);
    }

    private async Task Reject()
    {
        // BUG-603: one decision at a time: a double-click, or Reject while an Apply runs (the buttons share _applying).
        if (_applying || _reviewingPendingId is not { } pid || _shown is not { } shown || !_previews.IsCurrent(shown)) return;
        _applying = true;
        try
        {
            bool rejected;
            try { rejected = await Import.RejectPendingAsync(pid, string.IsNullOrWhiteSpace(_rejectNote) ? null : _rejectNote.Trim()); }
            catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or IncidentManager.Application.Security.ForbiddenException)
            {
                Toasts.Error($"Couldn't reject the import. {ex.Message}");
                return;
            }
            // BUG-92: say so when someone else got to it first; it may have been applied to a case.
            if (rejected) Toasts.Success("Import rejected. Nothing was written.");
            else Toasts.Error("This import was no longer waiting: someone else applied or rejected it first.");
            // BUG-601: the page moved to another review (or was left) while this ran: that one stays as it is.
            if (!_previews.IsCurrent(shown)) return;
            LeaveReview();
            Nav.NavigateTo("cases/import");
        }
        finally { _applying = false; }
    }

    private string? _text;
    private CaseImportPreview? _preview;
    private bool _applying;
    private string? _error;
    private string? _parseError;
    private bool _showSample;
    private string? _existingNumber;
    private string? _existingError;

    // PROD-32: AI prompt generator state.
    private bool _showPromptBuilder;
    private string? _promptTool;
    private bool _promptExisting;
    private Classification? _promptClassification;
    private string? _prompt;

    private void OnPromptTargetChanged(ChangeEventArgs e) => _promptExisting = e.Value?.ToString() == "True";

    private bool _promptExercise;   // BUG-635

    // BUG-636: local times in the material without a zone are in the zone picked for Step 2 (the organization's by
    // default), and the AI is told to keep them as written and name it.
    private void GeneratePrompt() => _prompt = CaseImportPrompt.Build(
        new CaseImportPromptOptions(_promptExisting, _promptExisting ? null : _promptClassification, _promptTool,
            UnzonedZone().Id, Exercise: !_promptExisting && _promptExercise));

    private async Task CopyPrompt()
    {
        if (_prompt is null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _prompt);
            Toasts.Success("Prompt copied. Paste it into your AI tool with the incident material.");
        }
        catch
        {
            Toasts.Error("Couldn't copy the prompt. Select the text and copy it manually.");
        }
    }

    private void ToggleSample() => _showSample = !_showSample;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var r = _reads.Begin();   // BUG-601: a later file or paste, a Clear or a queued review supersedes this one
        try
        {
            var name = e.File.Name;
            using var reader = new StreamReader(e.File.OpenReadStream(maxAllowedSize: 4 * 1024 * 1024));
            var text = await reader.ReadToEndAsync();
            if (!_reads.IsCurrent(r)) return;
            (_text, _fileName) = (text, name);
            await ShowInBox(_text);   // BUG-605: the box isn't bound, so it's shown there explicitly
            if (!_reads.IsCurrent(r)) return;
            _zoneNote = null;   // BUG-655: about the document before this one
            await Preview();
        }
        catch (Exception ex)
        {
            if (_reads.IsCurrent(r)) _error = "Couldn't read the file. Check that it's a JSON, STIX or CSV file under 4 MB.";
            Logger.LogWarning(ex, "Case-import file read failed");
        }
    }

    // BUG-605: the pasted or typed document, read from the box as a stream (no 32 KB hub message limit), up to the size an
    // upload takes.
    private const long MaxDocumentBytes = 4 * 1024 * 1024;
    private bool _readingBox;

    private async Task PreviewFromBox()
    {
        if (_readingBox) return;
        _readingBox = true;
        var r = _reads.Begin();   // BUG-601: as OnFileSelected
        string text;
        try
        {
            var stream = await JS.InvokeAsync<IJSStreamReference>("imTextValue.read", "imp-json");
            await using (stream)
            {
                await using var s = await stream.OpenReadStreamAsync(MaxDocumentBytes);
                using var reader = new StreamReader(s, System.Text.Encoding.UTF8);
                text = await reader.ReadToEndAsync();
            }
        }
        catch (ArgumentOutOfRangeException ex)   // BUG-613: what the stream refuses past MaxDocumentBytes, before reading any
        {
            Logger.LogInformation(ex, "Case-import paste over the size limit");
            if (!_reads.IsCurrent(r)) return;
            (_preview, _shown) = (null, null);
            _parseError = "That's more than 4 MB of text. Upload it as a file instead, or split it.";
            return;
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException or JSException)
        {
            // BUG-613: a read that broke off (a stale script, a dropped transfer) isn't the text's size.
            Logger.LogWarning(ex, "Case-import paste read failed");
            if (!_reads.IsCurrent(r)) return;
            (_preview, _shown) = (null, null);
            _parseError = "Couldn't read the text in the box. Try again, or upload it as a file.";
            return;
        }
        catch (Exception ex) when (ex is TaskCanceledException or JSDisconnectedException)
        {
            return;   // BUG-613: the page is going (or the connection went); nothing to say
        }
        finally { _readingBox = false; }
        if (!_reads.IsCurrent(r)) return;
        // BUG-655: the upload's name (a CSV's provenance) is kept only while the box still holds that file's text.
        if (!string.Equals(text, _text, StringComparison.Ordinal)) _fileName = null;
        _text = text;
        _zoneNote = null;
        await Preview();
    }

    private async Task ShowInBox(string? text)
    {
        try { await JS.InvokeVoidAsync("imTextValue.set", "imp-json", text ?? ""); }
        catch (JSException) { /* the box shows what it showed */ }
        catch (JSDisconnectedException) { }
    }

    private async Task Preview()
    {
        // BUG-601: the preview shown from now on is this one's, once it lands; the last one goes now, so Apply can't import
        // it while the new document is read.
        var t = _previews.Begin();
        (_preview, _shown) = (null, null);
        _finds.Invalidate();
        _error = null;
        _related = [];
        _numberAvailable = null;   // BUG-637
        // BUG-446: a new document starts with no gate ticks or override, and a gate check still running for the last one
        // is dropped.
        ++_gateSeq;
        _gate.UseGate(null);
        // PROD-06: a STIX bundle or IOC CSV is converted into an entities-only import document first.
        var zone = UnzonedZone();
        _readZoneId = zone.Id;   // BUG-655
        var converted = IocImportConverter.Convert(_text, _fileName, unzonedIn: zone);
        _parseError = null;
        if (!converted.Ok)
        {
            (_preview, _shown) = (null, null);
            _parseError = converted.Error;
            return;
        }
        // CAP-14: a case id and a detection case id that name different cases are refused, as the API refuses them (a page
        // opened from a case imports into that one, whatever the document names).
        if (IntoCaseId is null && await Import.CheckTargetAsync(converted.Document!) is { } conflict)
        {
            if (_previews.IsCurrent(t)) _parseError = conflict;
            return;
        }
        var preview = await Import.BuildPreviewAsync(converted.Document!, IntoCaseId);
        // BUG-601: a newer preview, a Clear or a queued review took over while this one was built; showing it would let
        // Apply import a document that is no longer the one in the box.
        if (!_previews.IsCurrent(t)) return;
        preview.Warnings.InsertRange(0, converted.Notes);
        if (converted.Format != ImportSourceFormat.CaseImport && preview.TargetKind == CaseImportTargetKind.NewCase)
        {
            // Indicator shares land in an investigation someone chose; ask for the case rather than inventing one.
            preview.TargetKind = CaseImportTargetKind.ExistingCase;
            preview.Warnings.Insert(0, "Choose the case to add these indicators to, or switch to creating a new case.");
        }
        (_preview, _shown) = (preview, t);
        await LoadRelated(t);
        await RefreshGates();
    }

    // Open cases that already carry any of the previewed indicators (need-to-know scoped), excluding the target.
    // BUG-636: the zone a pasted or uploaded document's times without an offset are read in, unless it names one: the
    // organization's by default (most reports give local times), UTC, or the viewer's own display zone.
    [Inject] private TimeDisplay TimeDisp { get; set; } = default!;
    private string? _unzonedZoneId;

    private IEnumerable<(string Id, string Label)> ZoneChoices()
    {
        var org = OrgZone.Current;
        yield return (org.Id, $"{IocImportConverter.ZoneName(org)} (organization)");
        if (org != TimeZoneInfo.Utc && org.Id is not ("UTC" or "Etc/UTC")) yield return (TimeZoneInfo.Utc.Id, "UTC");
        var mine = TimeDisp.Zone;
        if (mine.Id != org.Id && mine != TimeZoneInfo.Utc && mine.Id is not ("UTC" or "Etc/UTC"))
            yield return (mine.Id, $"{IocImportConverter.ZoneName(mine)} (yours)");
    }

    private TimeZoneInfo UnzonedZone()
    {
        var id = _unzonedZoneId ??= OrgZone.Current.Id;
        return Zone(id);
    }

    private TimeZoneInfo Zone(string id) => TimeZoneInfo.TryFindSystemTimeZoneById(id, out var z) ? z : OrgZone.Current;

    // BUG-655: the zone the document shown (or loading) was read in, and what the page says about a re-read.
    private string? _readZoneId;
    private string? _zoneNote;

    // BUG-655: a zone picked after Preview went unused, and Apply imported the reading the picker no longer showed. The
    // document is read again in the new zone, and the page says so, since the changes made to the preview go with it.
    // Not when the zone changes nothing (the document names its own, or has no time without one): the preview stays.
    // A queued review never sees the picker (its rule stays the document's own zone, else UTC).
    private async Task ZoneChanged()
    {
        var zone = UnzonedZone();
        if (_reviewingPendingId is not null || _text is null || _readZoneId is not { } readIn || readIn == zone.Id) return;
        if (_applying || _preview is { } p && TargetLocked(p))
        {
            _unzonedZoneId = readIn;   // the rest of a part-applied import follows the reading already applied
            return;
        }
        var now = Clock.UtcNow;
        var before = IocImportConverter.Convert(_text, _fileName, now, Zone(readIn));
        var after = IocImportConverter.Convert(_text, _fileName, now, zone);
        if (before.Error == after.Error && (before.Document is null) == (after.Document is null)
            && (before.Document is null || System.Text.Json.JsonSerializer.Serialize(before.Document, CaseImportJson.Options)
                == System.Text.Json.JsonSerializer.Serialize(after.Document, CaseImportJson.Options)))
        {
            _readZoneId = zone.Id;
            return;
        }
        _zoneNote = _preview is null ? null
            : $"Times without a zone are now read as {IocImportConverter.ZoneName(zone)}. The preview was read again from the document, so any changes made to it were undone.";
        await Preview();
    }

    // BUG-637: the number a new case would get (as the New case form shows it), and whether a chosen one is free.
    [Inject] private IClock Clock { get; set; } = default!;
    [Inject] private IOrganizationTimeZone OrgZone { get; set; } = default!;
    private bool? _numberAvailable;

    private string PreviewNumber(CreateCaseRequest nc)
    {
        // REV-39: the organization's calendar date and year, as the number itself is given (BUG-112).
        var now = TimeZoneInfo.ConvertTime(Clock.UtcNow, OrgZone.Current);
        var slug = Case.Slug(string.IsNullOrWhiteSpace(nc.DescriptiveName) ? CaseImportService.SlugSource(nc.Title) : nc.DescriptiveName);
        return nc.Classification is null ? Case.FormatComplexEventNumber(now, slug) : $"{now.Year}-NN_{slug}";
    }

    private async Task CheckNumberAvailable(CreateCaseRequest nc)
    {
        var v = nc.CaseNumber?.Trim();
        _numberAvailable = string.IsNullOrEmpty(v) ? null : await Cases.IsCaseNumberAvailableAsync(v);
    }

    // BUG-635: switching to (or off) a drill changes which open cases count as related.
    private async Task ExerciseChanged() { if (_shown is { } shown) await LoadRelated(shown); }

    private async Task LoadRelated(LoadSequence.Ticket t)
    {
        if (_preview is not { Entities.Count: > 0 } p) { _related = []; return; }
        // BUG-635 (WF-48): a drill correlates with no live case, so no live case is offered as related.
        if (p.TargetKind == CaseImportTargetKind.NewCase && p.NewCase?.IsExercise == true) { _related = []; return; }
        var matches = await Cases.FindOpenCaseMatchesForIocsAsync(p.Entities.Select(e => e.Value));
        if (!_previews.IsCurrent(t)) return;   // BUG-601: for a preview no longer shown
        _related = matches.Where(m => m.CaseId != p.ExistingCaseId).ToList();
    }

    private async Task Reset()
    {
        // BUG-601: a read, preview or lookup still running is for what's being cleared.
        _reads.Invalidate();
        _previews.Invalidate();
        _finds.Invalidate();
        _parseError = null;
        (_preview, _shown) = (null, null);
        _text = null;
        _error = null;
        _existingNumber = null;
        _existingError = null;
        _fileName = null;
        (_zoneNote, _readZoneId) = (null, null);   // BUG-655
        _related = [];
        ++_gateSeq;   // BUG-446: as Preview
        _gate.UseGate(null);
        await ShowInBox(null);
    }

    // BUG-61: the gates a new case created by this import passes, judged from the case details and the indicators it adds.
    private readonly IncidentManager.Web.Components.Pages.Workspace.TransitionDraft _gate = new();

    private bool NewCaseTarget => _preview is { TargetKind: CaseImportTargetKind.NewCase, NewCase: not null, CreatedCaseId: null };

    private bool GateUnresolved => NewCaseTarget && _gate.NeedsOverride && string.IsNullOrWhiteSpace(_gate.Override);

    // BUG-385: an entity's Include or Disposition changes the gate (WF-16) too, so quick changes can overlap; only the
    // newest evaluation is kept.
    private int _gateSeq;

    private async Task RefreshGates()
    {
        var seq = ++_gateSeq;
        if (!NewCaseTarget) { _gate.UseGate(null); return; }
        var nc = _preview!.NewCase!;
        nc.PlannedEntityCount = _preview.Entities.Count(e => e.Include && !e.Applied);
        nc.PlannedDispositions = _preview.Entities.Where(e => e.Include && !e.Applied).Select(e => e.Disposition).ToList();   // WF-16
        var eval = await Cases.EvaluateNewCaseGatesAsync(nc);
        if (seq != _gateSeq) return;
        if (eval is not { GateExists: true }) { _gate.UseGate(null); return; }
        if (_gate.Gate?.GateName == eval.GateName) _gate.Gate = eval;   // same gates: keep the ticks
        else _gate.UseGate(eval);
    }

    // BUG-120: once a case was created, or any item applied, the rest of the import follows it.
    private static bool TargetLocked(CaseImportPreview p) => CaseImportService.HasApplied(p);

    private static bool CanApply(CaseImportPreview p)
    {
        if (!p.HasAnything) return false;
        // INV-18: an included decision needs its why.
        if (p.Timeline.Any(t => t.Include && t.Type == TimelineEntryType.Decision && string.IsNullOrWhiteSpace(t.Rationale))) return false;
        // BUG-119: and an included entry something to say.
        if (p.Timeline.Any(t => t.Include && !t.Applied && string.IsNullOrWhiteSpace(t.Description))) return false;
        return p.TargetKind == CaseImportTargetKind.NewCase
            ? p.NewCase is { } nc && !string.IsNullOrWhiteSpace(nc.Title)
              && (nc.Origin != CaseOrigin.ThirdParty || !string.IsNullOrWhiteSpace(nc.VendorName))   // BUG-117
            : p.ExistingCaseId is not null;
    }

    private bool CanClassify => CurrentUser.Has(Permission.ChangeClassification);   // BUG-542: REV-14

    private void SetClassification(CreateCaseRequest nc, string? raw)
        => nc.Classification = IncidentManager.Domain.Common.EnumNames.OrNull<Classification>(raw);

    private void SetOccurred(ImportTimelineRow t, DateTime dt)
    {
        t.OccurredAtUtc = WallClock.ToUtc(dt, TimeDisp.Zone, Clock.UtcNow);   // BUG-664: typed in the viewer's zone
        t.Warning = null; // a manual correction clears the auto-note (e.g. future/no-timestamp)
    }

    private void ClearExisting(CaseImportPreview p)
    {
        p.ExistingCaseId = null;
        p.ExistingCaseNumber = null;
        p.ExistingTitle = null;
        _existingNumber = null;
        _existingError = null;
        _finds.Invalidate();   // BUG-601: a Find still running is for the target just cleared
    }

    private async Task ResolveExisting(CaseImportPreview p)
    {
        _existingError = null;
        var t = _finds.Begin();
        var found = await Import.ResolveCaseByNumberAsync(_existingNumber ?? "");
        // BUG-601: an earlier Find landing after a later one (or after "change", a new preview, a Clear) set the target to
        // the case it found, and Apply imported into it.
        if (!_finds.IsCurrent(t) || !ReferenceEquals(_preview, p)) return;
        if (found is { } c)
        {
            p.ExistingCaseId = c.Id;
            p.ExistingCaseNumber = c.CaseNumber;
            p.ExistingTitle = c.Title;
        }
        else
        {
            _existingError = "No case with that number is visible to you. Check the number and try again.";
        }
    }

    private async Task Apply()
    {
        if (_applying || _preview is not { } p || !CanApply(p)) return;   // BUG-14: one apply at a time
        // BUG-601: the preview shown is superseded (a newer one is loading): apply that one, once it's shown.
        if (_shown is not { } shown || !PreviewIsCurrent) return;
        _applying = true;
        _error = null;
        // BUG-601: the queued submission under review now; a Review link followed while this runs mustn't make it mark
        // (or put back) another one.
        var pendingId = _reviewingPendingId;
        Guid? claimed = null;
        DateTimeOffset? claim = null;
        try
        {
            if (NewCaseTarget)
            {
                var nc = p.NewCase!;
                nc.PlannedEntityCount = p.Entities.Count(e => e.Include && !e.Applied);
                nc.PlannedDispositions = p.Entities.Where(e => e.Include && !e.Applied).Select(e => e.Disposition).ToList();   // WF-16
                nc.AttestedRequirementIds = _gate.Attested.ToHashSet();
                nc.OverrideJustification = _gate.NeedsOverride ? _gate.Override?.Trim() : null;
            }
            // BUG-13: a queued import is claimed first, so it can't be applied twice.
            if (pendingId is { } pending && (claim = await Import.ClaimPendingAsync(pending)) is null)
            {
                if (_previews.IsCurrent(shown))
                    _error = "This import is being applied (perhaps in another tab), or was already applied or rejected. " +
                             "Reload the queue to see it.";
                return;
            }
            claimed = pendingId;
            var result = await Import.ApplyAsync(p, pendingId);   // CAP-06: the SIEM event names the queued submission
            if (pendingId is { } pid) await Import.MarkPendingAppliedAsync(pid, result, claim);
            var what = result.CaseCreated ? $"Case {result.CaseNumber} created" : $"Imported into {result.CaseNumber}";
            Toasts.Success($"{what}. {IncidentManager.Application.Common.Plural.Of(result.Total, "item")} imported.");
            if (_previews.IsCurrent(shown)) Nav.NavigateTo($"cases/{result.CaseId}");   // BUG-601: not once the page moved on
        }
        catch (Exception ex)
        {
            // Domain/validation messages show verbatim; internal errors are replaced and logged. A retry
            // resumes (already-applied items are skipped) rather than duplicating.
            var message = UserFacingError.Describe(ex, Logger, "importing a case",
                "Couldn't complete the import. Try again; items already imported won't be duplicated.");
            if (_previews.IsCurrent(shown)) _error = message;
            else Toasts.Error(message);
            // BUG-116: back in the queue, so it isn't stranded if this page is left.
            if (claimed is { } c)
            {
                try { await Import.ReleaseClaimAsync(c, p, claim); }
                catch (Exception releaseEx) { Logger.LogWarning(releaseEx, "Couldn't put a failed import back in the queue."); }
            }
        }
        finally
        {
            _applying = false;
        }
    }

    // BUG-601: left while a read, preview or lookup ran: none of them lands, and nothing navigates the page now showing.
    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        _navigations.Invalidate();
        _reads.Invalidate();
        _previews.Invalidate();
        _queue.Invalidate();
        _finds.Invalidate();
    }

