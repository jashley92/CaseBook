@page "/admin/notification-deadlines"
@attribute [Authorize(Policy = Policies.Administer)]
@inject NavigationManager Nav

@* UX-15: the per-jurisdiction rules editor moved onto the consolidated "Regulatory deadlines" settings
   page (beside the deadline clock), so this old standalone route just forwards there for bookmarks and
   back-links. Kept as a redirect rather than deleted so existing links never 404. *@

@code {
    protected override void OnInitialized() =>
        Nav.NavigateTo("admin/settings/regulatory-deadlines", replace: true);
}
