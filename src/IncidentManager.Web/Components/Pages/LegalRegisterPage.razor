@page "/program/legal"
@* RD-17: the legal and regulatory obligations register (PROD-12) on screen, beside its CSV. Legal doesn't use the
   app; this is the SOC's view of what it hands over. Each row opens the case's Briefing. Need-to-know scoped by
   LegalRegisterService; read only. *@
@attribute [Authorize(Policy = Policies.ViewCases)]
@inject IncidentManager.Application.Compliance.LegalRegisterService Register
@inject IClock Clock
@inject TimeDisplay TimeDisp
@inject ISeverityLabels SevLabels

<PageTitle>Legal register</PageTitle>

@* UX-59: the register's CSV is on Exports (the page has no filter to export "these" from). *@
<PageHeader Title="Program" Subtitle="Cases carrying a legal or regulatory obligation: a referral, a hold, a breach, or a materiality call." />
<ProgramNav />

@if (_rows is null)
{
    <LoadingBlock />
}
else if (_rows.Count == 0)
{
    <p class="text-muted">No case you can see carries a legal or regulatory obligation.</p>
}
else
{
    var now = Clock.UtcNow;
    <div class="table-responsive">
        <table class="table table-sm align-middle im-table">
            <thead>
                <tr><th>Case</th><th>State</th><th>Legal</th><th>Materiality</th><th>Affected</th><th>Notification</th></tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td>
                            @* UX-53: the title first, the number quiet under it. *@
                            <a href="cases/@Uri.EscapeDataString(r.CaseNumber)?tab=Briefing" class="im-list-title im-clamp-2" title="@r.Title">@r.Title</a>
                            <div class="small text-muted"><span class="im-casenum" title="@r.CaseNumber">@r.CaseNumber</span></div>
                        </td>
                        <td class="text-nowrap small"><RungMark Value="r.Classification" /> <SeverityMark Value="r.Severity" /><div class="text-muted">@Ui.Label(r.Phase)</div></td>
                        <td class="small">
                            @if (r.ReferredAtUtc is { } refd) { <div>Referred @TimeDisp.DateOnly(refd)</div> }
                            @if (!string.IsNullOrWhiteSpace(r.LegalContact)) { <div class="text-muted">@r.LegalContact</div> }
                            @if (r.LegalHold) { <div><span class="bi bi-lock" aria-hidden="true"></span> Legal hold</div> }
                            @if (r.OutsideParties is { } parties) { <div class="text-muted" title="Outside parties and their references">@parties</div> }   @* CAP-34 *@
                            @if (r.ReferredAtUtc is null && !r.LegalHold && r.OutsideParties is null) { <span class="text-muted">—</span> }
                        </td>
                        <td class="small">
                            @Ui.Label(r.Materiality)
                            @if (!string.IsNullOrWhiteSpace(r.MaterialityDecisionMaker)) { <div class="text-muted">@r.MaterialityDecisionMaker@(r.MaterialityDecidedOnUtc is { } md ? $", {TimeDisp.DateOnly(md)}" : "")</div> }
                        </td>
                        <td class="small">
                            @if (r.AffectedIndividuals is { } n) { <div>@n.ToString("N0") individuals</div> }
                            @if (!string.IsNullOrWhiteSpace(r.AffectedJurisdictions)) { <div class="text-muted">@r.AffectedJurisdictions</div> }
                            @if (r.AffectedIndividuals is null && string.IsNullOrWhiteSpace(r.AffectedJurisdictions)) { <span class="text-muted">—</span> }
                        </td>
                        <td class="small">
                            @if (r.ReportedAtUtc is { } rep) { <div>Reported @TimeDisp.DateOnly(rep)</div> }
                            else if (r.DeadlineDueAtUtc is { } due)
                            {
                                <div class="@(due < now ? "text-danger" : "")">@r.DeadlineJurisdiction · due @TimeDisp.Brief(due, now)</div>
                                @if (!string.IsNullOrWhiteSpace(r.DeadlineState)) { <div class="text-muted">@Spaced(r.DeadlineState)</div> }
                            }
                            else { <span class="text-muted">—</span> }
                            @* CAP-38: a partly reported case says which regulators were notified and which are due. *@
                            @if (r.PartlyReported && r.NotificationStanding is { } standing) { <div class="text-muted">@standing</div> }
                            @if (r.NoticeReferences is { } refs) { <div class="text-muted" title="The regulators' reference numbers">@refs</div> }   @* CAP-07 *@
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<IncidentManager.Application.Compliance.LegalRegisterRow>? _rows;

    protected override async Task OnInitializedAsync() => _rows = await Register.BuildAsync();

    // "OnTrack" reads "On track".
    private static string Spaced(string? s) => string.IsNullOrEmpty(s) ? "" :
        s[0] + string.Concat(s[1..].Select(ch => char.IsUpper(ch) ? " " + char.ToLowerInvariant(ch) : ch.ToString()));
}
