@* UX-09: one discoverable home for the export / download artifacts that are otherwise lone inline links
   scattered across the dashboard, Cases, Integrity, the admin console and Agenda. These "produce the
   regulator / SIEM / board artifact" jobs are the app's reason for existing, so gather them with
   plain-language "what this is for / who it's for" copy. Each links the same rate-limited endpoint the
   inline links use; admin-only artifacts sit behind an AuthorizeView. Per-case exports (STIX graph,
   per-case audit CSV, campaign rollup) stay on the case — noted at the bottom. *@
@page "/exports"
@attribute [Authorize(Policy = Policies.ViewCases)]

<PageTitle>Exports</PageTitle>

<PageHeader Title="Exports"
            Subtitle="Download metrics, feeds and regulator or examiner artifacts." />

<section class="im-card mb-3">
    <div class="im-section-head">
        <span><span class="bi bi-graph-up" aria-hidden="true"></span> SOC &amp; reporting</span>
    </div>
    <div class="dl-list">
        <div class="dl-item">
            <span class="dl-ic bi bi-bar-chart-line" aria-hidden="true"></span>
            <div class="dl-body">
                <div class="dl-name">Incident metrics <span class="dl-fmt">CSV</span></div>
                <div class="dl-desc">A point-in-time leadership snapshot for a metrics deck or status update: open caseload, breaches, SLA posture and throughput.</div>
            </div>
            <a class="btn btn-sm btn-outline-primary dl-btn" href="export/metrics.csv" download>
                <span class="bi bi-download" aria-hidden="true"></span> Download
            </a>
        </div>
        <div class="dl-item">
            <span class="dl-ic bi bi-clipboard-data" aria-hidden="true"></span>
            <div class="dl-body">
                <div class="dl-name">Program report <span class="dl-fmt">CSV</span></div>
                <div class="dl-desc">The quarterly roll-up against the previous quarter: volumes, response times, SLA attainment, regulatory reporting and follow-through. Pick the quarter on the <a href="program-report">Program report</a> page.</div>
            </div>
            <a class="btn btn-sm btn-outline-primary dl-btn" href="program-report">
                <span class="bi bi-box-arrow-up-right" aria-hidden="true"></span> Open
            </a>
        </div>
        <div class="dl-item">
            <span class="dl-ic bi bi-bank" aria-hidden="true"></span>
            <div class="dl-body">
                <div class="dl-name">Legal &amp; regulatory obligations register <span class="dl-fmt">CSV</span></div>
                <div class="dl-desc">Every case with a Legal referral, a legal hold, a Breach classification or a materiality determination, with the referral, hold, affected population, regulator report and notification deadline side by side. For Legal and Privacy, who work from files rather than the app.</div>
            </div>
            <a class="btn btn-sm btn-outline-primary dl-btn" href="export/legal-register.csv" download>
                <span class="bi bi-download" aria-hidden="true"></span> Download
            </a>
        </div>
        <div class="dl-item">
            <span class="dl-ic bi bi-shield-exclamation" aria-hidden="true"></span>
            <div class="dl-body">
                <div class="dl-name">Malicious IOC feed <span class="dl-fmt">CSV</span></div>
                <div class="dl-desc">Confirmed-malicious indicators from the cases you can see, as a flat blocklist for your SIEM, firewalls or EDR.</div>
            </div>
            <a class="btn btn-sm btn-outline-primary dl-btn" href="export/iocs.csv" download>
                <span class="bi bi-download" aria-hidden="true"></span> Download
            </a>
        </div>
        <div class="dl-item">
            <span class="dl-ic bi bi-calendar-week" aria-hidden="true"></span>
            <div class="dl-body">
                <div class="dl-name">My agenda <span class="dl-fmt">ICS</span></div>
                <div class="dl-desc">Your task due dates as a calendar file to import into Outlook. For a syncing subscription, use the feed link on the <a href="agenda">Agenda</a> page.</div>
            </div>
            <a class="btn btn-sm btn-outline-primary dl-btn" href="agenda/agenda.ics" download>
                <span class="bi bi-download" aria-hidden="true"></span> Download
            </a>
        </div>
    </div>
</section>

<AuthorizeView Policy="@Policies.Administer">
    <section class="im-card mb-3">
        <div class="im-section-head">
            <span><span class="bi bi-shield-lock" aria-hidden="true"></span> Examiner &amp; compliance</span>
            <span class="im-badge im-b-neutral"><span class="bi bi-shield-lock me-1"></span>SysAdmin only</span>
        </div>
        <div class="dl-list">
            <div class="dl-item">
                <span class="dl-ic bi bi-file-earmark-zip" aria-hidden="true"></span>
                <div class="dl-body">
                    <div class="dl-name">Compliance evidence bundle <span class="dl-fmt">ZIP</span></div>
                    <div class="dl-desc">The tamper-evident audit-chain segment for a date range, its covering integrity seals and a verification report, packaged for a regulator or examiner. Defaults to year-to-date.</div>
                    <div class="dl-range">
                        <label class="form-label small mb-0">From <input type="date" class="form-control form-control-sm" @bind="_from" /></label>
                        <label class="form-label small mb-0">To <input type="date" class="form-control form-control-sm" @bind="_to" /></label>
                    </div>
                </div>
                <a class="btn btn-sm btn-outline-primary dl-btn" href="@ComplianceHref()" download>
                    <span class="bi bi-download" aria-hidden="true"></span> Download
                </a>
            </div>
            <div class="dl-item">
                <span class="dl-ic bi bi-eye" aria-hidden="true"></span>
                <div class="dl-body">
                    <div class="dl-name">Access log <span class="dl-fmt">CSV</span></div>
                    <div class="dl-desc">Who opened which case or artifact, and when, for an access review or an examiner's "who saw this" question. To filter it first, use the <a href="access-log">Access log</a> page.</div>
                </div>
                <a class="btn btn-sm btn-outline-primary dl-btn" href="export/access-log.csv" download>
                    <span class="bi bi-download" aria-hidden="true"></span> Download
                </a>
            </div>
            <div class="dl-item">
                <span class="dl-ic bi bi-box-seam" aria-hidden="true"></span>
                <div class="dl-body">
                    <div class="dl-name">Configuration bundle <span class="dl-fmt">JSON</span></div>
                    <div class="dl-desc">A signed, versioned snapshot of the editable configuration, such as templates, taxonomy, gates and report profiles. Use it for backup or to move settings to another deployment. Managed on <a href="admin/config-bundle">Configuration bundle</a>.</div>
                </div>
                <a class="btn btn-sm btn-outline-primary dl-btn" href="export/config-bundle.json" download>
                    <span class="bi bi-download" aria-hidden="true"></span> Download
                </a>
            </div>
        </div>
    </section>
</AuthorizeView>

<section class="im-card">
    <div class="im-section-head">
        <span><span class="bi bi-folder2-open" aria-hidden="true"></span> Per-case exports</span>
    </div>
    <p class="text-muted small mb-0">
        The <strong>STIX 2.1 graph bundle</strong> and <strong>per-case audit CSV</strong> are on a case's
        <em>IOCs &amp; entities</em> and <em>Audit</em> tabs. The <strong>campaign rollup JSON</strong> is on a
        campaign's page.
    </p>
</section>

@code {
    private DateTime? _from;
    private DateTime? _to;

    // Build the compliance-bundle href, appending whichever date bounds were set (yyyy-MM-dd, UTC).
    // The endpoint defaults to year-to-date when a bound is omitted.
    private string ComplianceHref()
    {
        var qs = new List<string>();
        if (_from is { } f) qs.Add($"from={f:yyyy-MM-dd}");
        if (_to is { } t) qs.Add($"to={t:yyyy-MM-dd}");
        return "export/compliance-bundle.zip" + (qs.Count > 0 ? "?" + string.Join("&", qs) : "");
    }
}
