@page "/cases"
@page "/cases/mine"
@using IncidentManager.Application.Views
@attribute [Authorize(Policy = Policies.ViewCases)]
@inject CaseService CaseSvc
@inject DashboardService Dashboard
@inject SavedViewService Views
@inject IClock Clock
@inject ISlaTargetsProvider SlaProvider
@inject ISeverityLabels SevLabels
@inject NavigationManager Nav
@inject ToastService Toasts
@inject IAuthorizationService Authz
@inject AuthenticationStateProvider AuthState
@inject IncidentManager.Application.Abstractions.IUserDirectory Users

<PageTitle>Cases</PageTitle>

<PageHeader Title="Cases">
    <Actions>
        <div class="btn-group btn-group-sm" role="group" aria-label="Case scope">
            <button type="button" class="btn @(_onlyMine ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => SetScope(true)" aria-pressed="@_onlyMine" title="Only cases I own or am assigned to">Mine</button>
            <button type="button" class="btn @(!_onlyMine ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => SetScope(false)" aria-pressed="@(!_onlyMine)" title="All cases I'm allowed to see">All</button>
        </div>
        <a class="btn btn-sm btn-outline-secondary" href="export/iocs.csv" download
           title="Download confirmed-malicious IOCs across your visible cases as a CSV blocklist for SIEM / firewalls / EDR">
            <span class="bi bi-shield-exclamation" aria-hidden="true"></span> Export IOC feed (CSV)
        </a>
        <AuthorizeView Policy="@Policies.EditCases">
            <a class="btn btn-sm btn-outline-secondary" href="cases/import"
               title="Import a structured case-import document (paste or upload JSON) into a new or existing case">
                <span class="bi bi-box-arrow-in-down" aria-hidden="true"></span> Import
            </a>
            <a class="btn btn-sm btn-primary" href="cases/new">
                <span class="bi bi-plus-square" aria-hidden="true"></span> New Case
            </a>
        </AuthorizeView>
    </Actions>
</PageHeader>

@* Summary of the caller's open caseload — same figures as the dashboard, so the two stay in step.
   Each tile deep-links into the matching filtered list below. *@
@if (_dash is { } d)
{
    <div class="im-tiles">
        <StatTile Icon="bi-folder2-open" Value="d.OpenCount" Label="Open cases" Tone="accent" Href="cases" />
        <StatTile Icon="bi-shield-exclamation" Value="d.Breaches" Label="Open breaches"
                  Tone="@(d.Breaches > 0 ? "danger" : "accent")" Href="cases?classification=Breach" />
        <StatTile Icon="bi-clock-history" Value="@(d.SlaBreached + d.SlaAtRisk)" Label="SLA at risk / overdue"
                  Tone="@(d.SlaBreached > 0 ? "danger" : (d.SlaAtRisk > 0 ? "warn" : "ok"))" Href="cases?sla=true" />
        <StatTile Icon="bi-list-check" Value="d.OverdueActionItems" Label="Overdue tasks"
                  Tone="@(d.OverdueActionItems > 0 ? "danger" : "ok")"
                  Href="@(d.OverdueActionItems > 0 ? "cases?overdue=true&closed=true" : null)" />
    </div>
}

@* PROD-09: saved / shared case-queue views. Each view is a name + the current filter query string;
   personal by default, or shared to the whole team. *@
<div class="d-flex flex-wrap align-items-center gap-2 mt-3">
    <span class="text-muted small"><span class="bi bi-bookmark-star" aria-hidden="true"></span> Views</span>
    @if (_views is { Count: > 0 })
    {
        @foreach (var v in _views)
        {
            <span class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn @(IsActiveView(v) ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => ApplyView(v)" title="@ViewTooltip(v)">
                    @if (v.IsShared) { <span class="bi bi-people me-1" aria-hidden="true"></span> }
                    @v.Name
                    @if (!v.IsMine) { <span class="opacity-75 ms-1">· @v.OwnerName</span> }
                </button>
                @if (v.IsMine)
                {
                    @* PROD-24: mark one of your own views as the default Cases landing (captures Mine/All too). *@
                    <button type="button" class="btn @(v.IsDefault ? "btn-warning" : "btn-outline-secondary")"
                            title="@(v.IsDefault ? "Your default view — Cases lands here" : "Set as your default view")"
                            aria-pressed="@v.IsDefault" aria-label="@($"{(v.IsDefault ? "Unset" : "Set")} {v.Name} as default view")"
                            @onclick="() => ToggleDefault(v)">
                        <span class="bi @(v.IsDefault ? "bi-star-fill" : "bi-star")" aria-hidden="true"></span>
                    </button>
                    <button type="button" class="btn btn-outline-secondary" title="Delete this view"
                            aria-label="@($"Delete view {v.Name}")" @onclick="() => DeleteView(v)">
                        <span class="bi bi-x" aria-hidden="true"></span>
                    </button>
                }
            </span>
        }
    }
    else
    {
        <span class="text-muted small fst-italic">none yet</span>
    }
    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ToggleSaveForm">
        <span class="bi bi-plus-lg" aria-hidden="true"></span> Save current view
    </button>
</div>

@if (_savingView)
{
    <div class="card my-2" style="max-width:32rem">
        <div class="card-body">
            <label class="form-label small mb-1 fw-semibold" for="view-name">Save these filters as a view</label>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <input id="view-name" class="form-control form-control-sm" style="max-width:16rem" placeholder="e.g. My triage queue"
                       @bind="_newViewName" @bind:event="oninput" @bind:after="() => _confirmOverwrite = false" @onkeydown="OnSaveKeyDown" />
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="view-share" @bind="_newViewShared" />
                    <label class="form-check-label small" for="view-share" title="Everyone on the team sees this view">Share with team</label>
                </div>
                <button class="btn btn-sm btn-primary" @onclick="SaveView" disabled="@string.IsNullOrWhiteSpace(_newViewName)">Save</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _savingView = false">Cancel</button>
            </div>
            @* FR-15: a name that matches one of the user's own views overwrites it — confirm before clobbering. *@
            @if (_confirmOverwrite)
            {
                <div class="alert alert-warning small mt-2 mb-0 py-2 d-flex flex-wrap align-items-center gap-2">
                    <span><span class="bi bi-exclamation-triangle me-1" aria-hidden="true"></span>You already have a view named “<strong>@_newViewName.Trim()</strong>”. Overwrite it?</span>
                    <button class="btn btn-sm btn-warning py-0" @onclick="SaveView">Overwrite</button>
                    <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => _confirmOverwrite = false">Cancel</button>
                </div>
            }
            else
            {
                <div class="form-text">Saving over an existing name of yours updates it (you'll be asked to confirm). Captures the current filters and Mine/All scope.</div>
            }
        </div>
    </div>
}

<div class="row g-2 align-items-end my-3">
    <div class="col-auto">
        <label class="form-label small mb-0">Classification</label>
        <select class="form-select form-select-sm" @bind="_classification" @bind:after="ApplyFilters">
            <option value="">All</option>
            @foreach (var c in Enum.GetValues<Classification>())
            {
                <option value="@c">@Ui.Label(c)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0">Phase</label>
        <select class="form-select form-select-sm" @bind="_phase" @bind:after="ApplyFilters">
            <option value="">All</option>
            @foreach (var p in Enum.GetValues<CasePhase>())
            {
                <option value="@p">@Ui.Label(p)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0">Min severity</label>
        <select class="form-select form-select-sm" @bind="_minSeverity" @bind:after="ApplyFilters">
            <option value="">Any</option>
            @foreach (var s in Enum.GetValues<Severity>())
            {
                <option value="@s">@SevLabels.For(s)</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0">Origin</label>
        <select class="form-select form-select-sm" @bind="_origin" @bind:after="ApplyFilters">
            <option value="">All</option>
            <option value="@nameof(CaseOrigin.InternalDetection)">Internal</option>
            <option value="@nameof(CaseOrigin.ThirdParty)">Third-party</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label small mb-0">Search</label>
        <input class="form-control form-control-sm" placeholder="Number, title, note, or IOC"
               @bind="_search" @bind:after="ApplyFilters" />
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="closed" @bind="_includeClosed" @bind:after="ApplyFilters" />
            <label class="form-check-label small" for="closed">Include closed</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="exercises" @bind="_includeExercises" @bind:after="ApplyFilters" />
            <label class="form-check-label small" for="exercises" title="Tabletop / exercise (drill) cases are hidden by default">Show exercises</label>
        </div>
    </div>
    @* FR-16: the four status roll-up toggles collapse behind "More filters" to cut the density; they auto-
       reveal whenever one is active so a set filter is never hidden (and each also shows as a chip below). *@
    @{ var showAdvanced = _showMoreFilters || _overdueOnly || _slaAtRiskOnly || _referredOnly || _onHoldOnly; }
    <div class="col-auto">
        <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => _showMoreFilters = !_showMoreFilters">
            <span class="bi @(showAdvanced ? "bi-chevron-down" : "bi-chevron-right")" aria-hidden="true"></span> More filters
        </button>
    </div>
    @if (showAdvanced)
    {
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="overdue" @bind="_overdueOnly" @bind:after="ApplyFilters" />
                <label class="form-check-label small" for="overdue">Overdue only</label>
            </div>
        </div>
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="sla" @bind="_slaAtRiskOnly" @bind:after="ApplyFilters" />
                <label class="form-check-label small" for="sla" title="Open cases approaching or past their response-time target">SLA at risk</label>
            </div>
        </div>
        @* UX-10: SOC/IC roll-up of Legal obligations across the queue — Legal reads the reports, not the app. *@
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="referred" @bind="_referredOnly" @bind:after="ApplyFilters" />
                <label class="form-check-label small" for="referred" title="Cases referred to Legal / Privacy">Referred to Legal</label>
            </div>
        </div>
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="hold" @bind="_onHoldOnly" @bind:after="ApplyFilters" />
                <label class="form-check-label small" for="hold" title="Cases under a legal hold (preserve — do not delete)">On legal hold</label>
            </div>
        </div>
    }
    @if (_hasActiveFilter)
    {
        <div class="col-auto">
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear</button>
        </div>
    }
</div>

@* FR-16: removable active-filter chips, so it's obvious what's applied and a zero-row result can be
   unwound one filter at a time instead of reasoning backward about which of ten filters killed it. The
   row is always rendered (with a reserved height and a muted hint when empty) so toggling a filter never
   shifts the table down — it fills the reserved space instead of inserting a new row. *@
@{ var chips = ActiveFilterChips().ToList(); }
<div class="im-chips mb-3" style="min-height: 2rem;">
    @if (chips.Count > 0)
    {
        @foreach (var chip in chips)
        {
            <span class="im-chip" title="Remove this filter">
                <span class="im-chip-name">@chip.Label</span>
                <button type="button" class="im-chip-x" aria-label="Remove filter: @chip.Label" @onclick="() => RemoveFilter(chip.Clear)">×</button>
            </span>
        }
        @if (chips.Count > 1)
        {
            <button type="button" class="btn btn-sm btn-link p-0 ms-1 align-baseline" @onclick="ClearFilters">Clear all</button>
        }
    }
    else
    {
        <span class="text-muted small">No filters applied</span>
    }
</div>

@if (_assignee is not null)
{
    <div class="mb-2">
        <span class="im-badge im-b-info">
            <span class="bi bi-person-badge" aria-hidden="true"></span>
            @(_assignee == "none" ? "Unassigned queue" : $"Assigned to {(_assigneeName ?? "this analyst")}")
        </span>
        <a class="btn btn-sm btn-link p-0 ms-1 align-baseline" href="team">← Team workload</a>
    </div>
}

@if (_openedLabel is not null)
{
    <div class="mb-2">
        <span class="im-badge im-b-info">Opened @_openedLabel</span>
    </div>
}

@if (_page is null)
{
    <span class="visually-hidden" role="status">Loading cases…</span>
    <SkeletonTable Rows="6" Columns="9" />
}
else if (_page.Total == 0)
{
    @if (_hasActiveFilter)
    {
        <div class="empty-state">
            <span class="bi bi-funnel empty-state-icon" aria-hidden="true"></span>
            <div class="empty-state-title">No cases match your filters</div>
            <div class="empty-state-msg">Try widening or clearing the filters to see more.</div>
            <div class="empty-state-actions">
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear filters</button>
            </div>
        </div>
    }
    else if (_onlyMine)
    {
        <div class="empty-state">
            <span class="bi bi-inbox empty-state-icon" aria-hidden="true"></span>
            <div class="empty-state-title">Nothing is assigned to you</div>
            <div class="empty-state-msg">Cases you own or are assigned to will appear here. Switch to <strong>All</strong> to see the team's cases.</div>
            <div class="empty-state-actions">
                <button class="btn btn-sm btn-primary" @onclick="() => SetScope(false)">View all cases</button>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <span class="bi bi-folder2-open empty-state-icon" aria-hidden="true"></span>
            <div class="empty-state-title">No cases yet</div>
            <div class="empty-state-msg">When an adverse event, incident or breach is opened, it will show up here.</div>
            <AuthorizeView Policy="@Policies.EditCases">
                <div class="empty-state-actions">
                    <a class="btn btn-sm btn-primary" href="cases/new">
                        <span class="bi bi-plus-square" aria-hidden="true"></span> Create the first case
                    </a>
                </div>
            </AuthorizeView>
        </div>
    }
}
else
{
    <div class="im-card">
    <div class="im-section-head">
        <span><span class="bi bi-folder2-open" aria-hidden="true"></span> Case list</span>
        <span class="im-section-note">@_page.Total case@(_page.Total == 1 ? "" : "s")@(_hasActiveFilter ? " · filtered" : "")</span>
    </div>

    @* E-18 / U-15: metered bulk-action bar. Surfaces only over a coherent cohort (a filter is set, or the
       Mine scope) — never the naked All queue — and only for editors. Count-capped at @MaxBulk, and every
       verb routes through an enumerate-and-confirm step. Reversible verbs only (assign / refer-to-Legal);
       reclassify and close are deliberately absent — those keep the per-case human-gated stage transition. *@
    @if (BulkEligible && _selected.Count > 0)
    {
        <div class="im-bulkbar d-flex flex-wrap align-items-center gap-2 mb-2 p-2 rounded"
             style="background:var(--im-accent-weak, rgba(13,110,253,.08));border:1px solid var(--im-accent)">
            <span class="fw-semibold small">
                <span class="bi bi-check2-square me-1" aria-hidden="true"></span>@_selected.Count selected
                <span class="text-muted fw-normal">of @MaxBulk max</span>
            </span>
            <div class="vr d-none d-sm-block"></div>
            <button class="btn btn-sm btn-primary" @onclick="() => OpenBulk(BulkVerb.Assign)">
                <span class="bi bi-person-plus me-1" aria-hidden="true"></span>Assign…
            </button>
            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenBulk(BulkVerb.Refer)">
                <span class="bi bi-briefcase me-1" aria-hidden="true"></span>Refer to Legal…
            </button>
            <button class="btn btn-sm btn-link ms-auto" @onclick="ClearSelection">Clear selection</button>
        </div>
    }
    @* PROD-25: keyboard row navigation. Focus the table (click or Tab) then j/k (or ↑/↓) move the cursor and
       Enter/o opens it — no default to prevent, so Tab still leaves the table. (x-to-select waits on E-18's
       metered bulk bar to have something to act on.) *@
    <table class="table table-hover align-middle im-table" tabindex="0" @onkeydown="OnListKey"
           aria-label="Case list — press j and k to move, Enter to open">
        <thead>
            <tr>
                @if (BulkEligible)
                {
                    <th style="width:1%" title="Select cases for a bulk action">
                        <input class="form-check-input" type="checkbox" aria-label="Select this page (up to @MaxBulk)"
                               checked="@PageAllSelected" @onchange="e => TogglePage((bool)(e.Value ?? false))" />
                    </th>
                }
                <th>Case #</th>
                <th>Title</th>
                <th>Classification</th>
                <th>Phase</th>
                <th>Severity</th>
                <th>SLA</th>
                <th>Origin</th>
                <th>Opened</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < _page.Items.Count; i++)
            {
                var c = _page.Items[i];
                <tr class="@(i == _cursor ? "table-active" : "") @(_selected.Contains(c.Id) ? "im-row-selected" : "")">
                    @if (BulkEligible)
                    {
                        var atCap = !_selected.Contains(c.Id) && _selected.Count >= MaxBulk;
                        <td style="width:1%">
                            <input class="form-check-input" type="checkbox" checked="@_selected.Contains(c.Id)"
                                   disabled="@atCap" aria-label="@($"Select {c.CaseNumber}")"
                                   @onchange="e => ToggleSelect(c.Id, (bool)(e.Value ?? false))" />
                        </td>
                    }
                    <td class="case-num" style="@(i == _cursor ? "box-shadow:inset 3px 0 0 var(--im-accent)" : null)">
                        <code title="@c.CaseNumber">@c.CaseNumber</code>
                        @if (c.IsRestricted) { <span class="bi bi-lock-fill text-warning" title="Restricted"></span> }
                    </td>
                    <td>
                        <a href="cases/@c.Id" class="link-body-emphasis text-decoration-none fw-medium case-title">@c.Title</a>
                        @if (c.LegalReferred) { <span class="im-badge im-b-neutral ms-1" title="Referred to Legal / Privacy">Legal</span> }
                        @if (c.LegalHold) { <span class="im-badge im-b-danger ms-1" title="Under a legal hold — preserve, do not delete">Hold</span> }
                        @if (c.IsExercise) { <span class="im-badge im-b-info ms-1" title="Tabletop / exercise (drill) case — excluded from dashboards, reminders and feeds">Exercise</span> }
                    </td>
                    <td><span class="@Ui.ClassificationBadge(c.Classification)">@Ui.Label(c.Classification)</span></td>
                    <td><span class="@Ui.PhaseBadge(c.Phase)">@Ui.Label(c.Phase)</span></td>
                    <td><span class="@Ui.SeverityBadge(c.Severity)">@SevLabels.For(c.Severity)</span></td>
                    <td>
                        @{
                            var sla = SlaPolicy.Evaluate(c.Severity, c.Phase, c.DetectedAtUtc, c.ContainedAtUtc, c.ResolvedAtUtc, _targets, Clock.UtcNow);
                        }
                        @if (sla.State == SlaState.NoTarget)
                        {
                            <span class="text-muted small">—</span>
                        }
                        else
                        {
                            <span class="@Ui.SlaBadge(sla.State)" title="@SlaTitle(sla)">
                                <span class="bi @Ui.SlaGlyph(sla.State)" aria-hidden="true"></span> @Ui.SlaLabel(sla.State)
                            </span>
                        }
                    </td>
                    <td>@(c.Origin == CaseOrigin.ThirdParty ? "Third-party" : "Internal")</td>
                    <td class="text-muted small">@Ui.Age(c.CreatedAtUtc, Clock.UtcNow)</td>
                    <td><a class="btn btn-sm btn-outline-primary" href="cases/@c.Id">Open</a></td>
                </tr>
            }
        </tbody>
    </table>
    <div class="form-text mt-1 d-none d-md-block">
        <span class="bi bi-keyboard me-1" aria-hidden="true"></span>Tip: focus the list, then <kbd>j</kbd>/<kbd>k</kbd> move and <kbd>Enter</kbd> opens@(BulkEligible ? "" : ".")
        @if (BulkEligible)
        {
            <text>, <kbd>x</kbd> selects for a bulk action.</text>
        }
    </div>

    @if (_page is { Total: > 0 } && (_page.TotalPages > 1 || _pageSize != DefaultPageSize))
    {
        <nav class="d-flex justify-content-between align-items-center gap-2 flex-wrap mt-2">
            <span class="text-muted small">
                @if (_page.TotalPages > 1) { <text>Page @_page.Page of @_page.TotalPages · </text> }
                @_page.Total case@(_page.Total == 1 ? "" : "s")
            </span>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <label class="text-muted small mb-0">Per page
                    <select class="form-select form-select-sm d-inline-block w-auto ms-1" value="@_pageSize" @onchange="SetPageSize" aria-label="Cases per page">
                        @foreach (var s in PageSizeOptions) { <option value="@s">@s</option> }
                    </select>
                </label>
                @if (_page.TotalPages > 1)
                {
                    <div class="btn-group">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => GoToPage(1)" disabled="@(_page.Page <= 1)" title="First page">« First</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="PrevPage" disabled="@(_page.Page <= 1)">← Prev</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(_page.Page >= _page.TotalPages)">Next →</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => GoToPage(_page.TotalPages)" disabled="@(_page.Page >= _page.TotalPages)" title="Last page">Last »</button>
                    </div>
                    <label class="text-muted small mb-0">Go to
                        <input type="number" min="1" max="@_page.TotalPages" value="@_page.Page" @onchange="JumpToPage"
                               class="form-control form-control-sm d-inline-block ms-1" style="width:4.5rem" aria-label="Jump to page" />
                    </label>
                }
            </div>
        </nav>
    }
    </div>
}

@* E-18 / U-15: bulk-action modal. Step 1 collects the verb's inputs; step 2 enumerates the exact case
   numbers affected before anything is written. Each case is still assigned / referred individually and so is
   individually audited. *@
@if (_bulkVerb != BulkVerb.None)
{
    var selectedItems = _page?.Items.Where(i => _selected.Contains(i.Id)).ToList() ?? new();
    <div class="modal d-block im-trap" tabindex="-1" role="dialog" aria-modal="true" aria-label="Bulk action"
         style="background:var(--im-scrim)" @onclick="CloseBulk">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        @(_bulkVerb == BulkVerb.Assign ? "Assign selected cases" : "Refer selected cases to Legal")
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseBulk"></button>
                </div>

                @if (!_bulkConfirm)
                {
                    <div class="modal-body">
                        @if (_bulkVerb == BulkVerb.Assign)
                        {
                            <div class="row g-2 align-items-end">
                                <div class="col-sm-7">
                                    <label class="form-label small mb-0" for="bulk-to">Assign to</label>
                                    <select id="bulk-to" class="form-select form-select-sm" @bind="_bulkAssignToId">
                                        <option value="">Select a user…</option>
                                        @foreach (var u in Users.All())
                                        {
                                            <option value="@u.UserId">@u.DisplayName</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-sm-5">
                                    <label class="form-label small mb-0" for="bulk-role">Role on each case</label>
                                    <select id="bulk-role" class="form-select form-select-sm" @bind="_bulkAssignRole">
                                        @foreach (var r in Enum.GetValues<CaseAssignmentRole>())
                                        {
                                            <option value="@r">@r</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="form-text">Adds this assignee to each selected case (existing assignees are kept). Reversible per case.</div>
                        }
                        else
                        {
                            <div class="row g-2">
                                <div class="col-sm-6">
                                    <label class="form-label small mb-0" for="bulk-contact">Legal / Privacy contact <span class="text-muted">(optional)</span></label>
                                    <input id="bulk-contact" class="form-control form-control-sm" @bind="_bulkReferContact" placeholder="e.g. privacy@@example" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-0" for="bulk-note">Regulatory-relevance note <span class="text-muted">(optional)</span></label>
                                    <input id="bulk-note" class="form-control form-control-sm" @bind="_bulkReferNote" placeholder="Why these are being referred" />
                                </div>
                            </div>
                            <div class="form-text">Marks each selected case as referred to Legal / Privacy. The same contact / note applies to all.</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <span class="me-auto small text-muted">@_selected.Count case@(_selected.Count == 1 ? "" : "s") selected</span>
                        <button class="btn btn-outline-secondary" @onclick="CloseBulk">Cancel</button>
                        <button class="btn btn-primary" @onclick="ProceedBulk"
                                disabled="@(_bulkVerb == BulkVerb.Assign && string.IsNullOrEmpty(_bulkAssignToId))">
                            Continue…
                        </button>
                    </div>
                }
                else
                {
                    <div class="modal-body">
                        <p>
                            @if (_bulkVerb == BulkVerb.Assign)
                            {
                                <text>Assign these <strong>@selectedItems.Count</strong> case@(selectedItems.Count == 1 ? "" : "s")
                                to <strong>@BulkToName()</strong> as <strong>@_bulkAssignRole</strong>?</text>
                            }
                            else
                            {
                                <text>Refer these <strong>@selectedItems.Count</strong> case@(selectedItems.Count == 1 ? "" : "s")
                                to Legal / Privacy@(string.IsNullOrWhiteSpace(_bulkReferContact) ? "" : $" ({_bulkReferContact})")?</text>
                            }
                        </p>
                        <ul class="small mb-0" style="max-height:16rem;overflow:auto">
                            @foreach (var c in selectedItems)
                            {
                                <li><code>@c.CaseNumber</code> — @c.Title @(c.LegalReferred && _bulkVerb == BulkVerb.Refer ? "· already referred" : "")</li>
                            }
                        </ul>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" @onclick="() => _bulkConfirm = false" disabled="@_bulkBusy">Back</button>
                        <button class="btn btn-primary" @onclick="ApplyBulk" disabled="@_bulkBusy">
                            @if (_bulkBusy) { <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> }
                            @(_bulkVerb == BulkVerb.Assign ? "Confirm assign" : "Confirm referral")
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    // Filters live in the URL so views are bookmarkable and the dashboard can deep-link into them.
    [SupplyParameterFromQuery(Name = "classification")] public string? QClassification { get; set; }
    [SupplyParameterFromQuery(Name = "phase")] public string? QPhase { get; set; }
    [SupplyParameterFromQuery(Name = "sev")] public string? QSeverity { get; set; }
    [SupplyParameterFromQuery(Name = "origin")] public string? QOrigin { get; set; }
    [SupplyParameterFromQuery(Name = "q")] public string? QSearch { get; set; }
    [SupplyParameterFromQuery(Name = "closed")] public bool QClosed { get; set; }
    [SupplyParameterFromQuery(Name = "exercises")] public bool QExercises { get; set; }
    [SupplyParameterFromQuery(Name = "overdue")] public bool QOverdue { get; set; }
    [SupplyParameterFromQuery(Name = "sla")] public bool QSla { get; set; }
    [SupplyParameterFromQuery(Name = "referred")] public bool QReferred { get; set; }
    [SupplyParameterFromQuery(Name = "hold")] public bool QHold { get; set; }
    [SupplyParameterFromQuery(Name = "opened")] public string? QOpened { get; set; }
    [SupplyParameterFromQuery(Name = "scope")] public string? QScope { get; set; }
    [SupplyParameterFromQuery(Name = "assignee")] public string? QAssignee { get; set; }
    [SupplyParameterFromQuery(Name = "assigneeName")] public string? QAssigneeName { get; set; }
    // FR-10: pagination position + page size live in the URL too, so a refresh / dropped circuit / bookmark
    // keeps the reader on the same page instead of snapping back to page 1.
    [SupplyParameterFromQuery(Name = "page")] public int? QPage { get; set; }
    [SupplyParameterFromQuery(Name = "size")] public int? QPageSize { get; set; }

    private CasePage? _page;
    private DashboardMetrics? _dash; // caseload summary tiles (same figures as the dashboard)
    private readonly CaseFilter _filter = new();
    private bool _onlyMine; // the Mine/All scope toggle, driven by ?scope=mine
    private bool _canEdit;  // EditCases — gates the metered bulk-select bar (E-18/U-15)

    private string _classification = "";
    private string _phase = "";
    private string _minSeverity = "";
    private string _origin = "";
    private string _search = "";
    private bool _includeClosed;
    private bool _includeExercises;
    private bool _overdueOnly;
    private bool _slaAtRiskOnly;
    private bool _referredOnly;
    private bool _onHoldOnly;
    private string? _openedLabel; // "MMM yyyy" when an opened-month drill-in is active
    private string? _assignee;    // assignee drill-in from team workload: a user id, or "none" for unassigned
    private string? _assigneeName;

    // FR-10: page size is a URL-carried display preference (persists across filter changes; see CurrentParams).
    private const int DefaultPageSize = 25;
    private static readonly int[] PageSizeOptions = [25, 50, 100];
    private int _pageSize = DefaultPageSize;

    // The administered SLA targets, refreshed each reload so an admin change is reflected on next load.
    private SlaTargets _targets = SlaTargets.Empty;

    private bool _hasActiveFilter => !(string.IsNullOrEmpty(_classification) && string.IsNullOrEmpty(_phase)
        && string.IsNullOrEmpty(_minSeverity) && string.IsNullOrEmpty(_origin)
        && string.IsNullOrEmpty(_search) && !_includeClosed && !_includeExercises && !_overdueOnly && !_slaAtRiskOnly
        && !_referredOnly && !_onHoldOnly && _openedLabel is null && _assignee is null);

    // FR-16: whether the collapsed "More filters" (status roll-up toggles) group is expanded.
    private bool _showMoreFilters;

    // PROD-09: the user's own + shared views, and the inline "save view" form state.
    private List<SavedViewItem>? _views;
    private bool _savingView;
    private string _newViewName = "";
    private bool _newViewShared;

    // The caseload-summary tiles are a stable overview, so load them once (not on every filter change).
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _canEdit = (await Authz.AuthorizeAsync(auth.User, Policies.EditCases)).Succeeded;
        _dash = await Dashboard.GetAsync();
        await ReloadViews();

        // PROD-24: a bare /cases load (fresh mount from elsewhere) lands on the user's default view, if set.
        // Only the exact "cases" path with no query — /cases/mine and any ?filter= are explicit, so left alone.
        // A later Clear/toggle stays on the same mount (OnParametersSet, not here), so it never bounces back.
        var rel = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
        if (string.Equals(rel, "cases", StringComparison.OrdinalIgnoreCase)
            && _views?.FirstOrDefault(v => v.IsDefault) is { Query.Length: > 0 } def)
        {
            Nav.NavigateTo($"cases?{def.Query}");
        }
    }

    // PROD-25: a keyboard row cursor over the current page. -1 = none until the first j/k. Reset on reload.
    private int _cursor = -1;

    private void OnListKey(KeyboardEventArgs e)
    {
        if (_page is not { Items.Count: > 0 } p) return;
        var n = p.Items.Count;
        switch (e.Key)
        {
            case "j" or "ArrowDown":
                _cursor = _cursor < 0 ? 0 : Math.Min(_cursor + 1, n - 1);
                break;
            case "k" or "ArrowUp":
                _cursor = _cursor <= 0 ? 0 : _cursor - 1;
                break;
            case "Enter" or "o":
                if (_cursor >= 0 && _cursor < n) Nav.NavigateTo($"cases/{p.Items[_cursor].Id}");
                break;
            // PROD-25 + E-18: x toggles the cursor row into the bulk selection (editors, cohort only).
            case "x" when BulkEligible && _cursor >= 0 && _cursor < n:
                var id = p.Items[_cursor].Id;
                ToggleSelect(id, !_selected.Contains(id));
                break;
        }
    }

    private async Task ToggleDefault(SavedViewItem v)
    {
        try
        {
            await Views.ToggleDefaultAsync(v.Id);
            await ReloadViews();
        }
        catch (InvalidOperationException ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    // Runs on initial load and on every query-string change (e.g. a dashboard drill-in).
    protected override async Task OnParametersSetAsync()
    {
        // Scope is driven by ?scope=mine; the legacy /cases/mine route is honoured as an alias so old
        // links and bookmarks still land on the user's own caseload.
        var relative = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');
        _onlyMine = string.Equals(QScope, "mine", StringComparison.OrdinalIgnoreCase)
            || relative.Equals("cases/mine", StringComparison.OrdinalIgnoreCase);
        _filter.OnlyMine = _onlyMine;

        _classification = QClassification ?? "";
        _phase = QPhase ?? "";
        _minSeverity = QSeverity ?? "";
        _origin = QOrigin ?? "";
        _search = QSearch ?? "";
        _includeClosed = QClosed;
        _includeExercises = QExercises;
        _overdueOnly = QOverdue;
        _slaAtRiskOnly = QSla;
        _referredOnly = QReferred;
        _onHoldOnly = QHold;
        _assignee = string.IsNullOrWhiteSpace(QAssignee) ? null : QAssignee;
        _assigneeName = QAssigneeName;

        // opened=YYYY-MM narrows to cases opened that month (activity-bar drill-in).
        _filter.OpenedYear = null;
        _filter.OpenedMonth = null;
        _openedLabel = null;
        if (!string.IsNullOrWhiteSpace(QOpened) && DateTime.TryParse($"{QOpened}-01", out var mo))
        {
            _filter.OpenedYear = mo.Year;
            _filter.OpenedMonth = mo.Month;
            _openedLabel = mo.ToString("MMM yyyy");
        }

        // FR-10: page position + size come from the URL, not just component state. A filter change navigates
        // without the `page` param (see CurrentParams), so it naturally falls back to page 1; a paging or
        // page-size change navigates *with* these params, landing here to reload at that position.
        _pageSize = PageSizeOptions.Contains(QPageSize ?? 0) ? QPageSize!.Value : DefaultPageSize;
        _filter.PageSize = _pageSize;
        _filter.Page = QPage is int qp && qp > 0 ? qp : 1;
        await Reload();

        // A bookmarked page beyond the current end (the queue shrank) clamps to the last page rather than
        // showing an empty list under a "Page 6 of 3" label.
        if (_page is { Total: > 0 } pg && _filter.Page > pg.TotalPages)
        {
            _filter.Page = pg.TotalPages;
            await Reload();
        }
    }

    // The current filter state as query parameters — the single source used both to navigate on a filter
    // change and to capture the current view for saving.
    private Dictionary<string, object?> CurrentParams() => new()
    {
        ["scope"] = _onlyMine ? "mine" : null,
        ["classification"] = Blank(_classification),
        ["phase"] = Blank(_phase),
        ["sev"] = Blank(_minSeverity),
        ["origin"] = Blank(_origin),
        ["q"] = Blank(_search),
        ["closed"] = _includeClosed ? "true" : null,
        ["exercises"] = _includeExercises ? "true" : null,
        ["overdue"] = _overdueOnly ? "true" : null,
        ["sla"] = _slaAtRiskOnly ? "true" : null,
        ["referred"] = _referredOnly ? "true" : null,
        ["hold"] = _onHoldOnly ? "true" : null,
        ["assignee"] = _assignee,
        ["assigneeName"] = _assignee is null or "none" ? null : Blank(_assigneeName ?? ""),
        // FR-10: page size persists across filter changes (omitted at the default to keep URLs clean). `page`
        // is deliberately NOT here — a filter change should restart at page 1; paging adds it in GoToPage.
        ["size"] = _pageSize == DefaultPageSize ? null : _pageSize.ToString(),
    };

    // A select/search change rewrites the query string; OnParametersSetAsync then reloads. We always
    // target the /cases base so scope lives in one place (?scope=mine), normalising the /cases/mine alias.
    private void ApplyFilters() =>
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(Nav.ToAbsoluteUri("cases").ToString(), CurrentParams()));

    // The Mine/All toggle. Keeps the active filters, just flips scope.
    private void SetScope(bool mine)
    {
        if (_onlyMine == mine) return;
        _onlyMine = mine;
        ApplyFilters();
    }

    private void ClearFilters() => Nav.NavigateTo(_onlyMine ? "cases?scope=mine" : "cases");

    // FR-16: the active filters as removable chips (label + a one-field clear). Excludes the assignee /
    // opened-month drill-ins, which already have their own context badges below.
    private IEnumerable<(string Label, Action Clear)> ActiveFilterChips()
    {
        if (Enum.TryParse<Classification>(_classification, out var c))
            yield return ($"Classification: {Ui.Label(c)}", () => _classification = "");
        if (Enum.TryParse<CasePhase>(_phase, out var p))
            yield return ($"Phase: {Ui.Label(p)}", () => _phase = "");
        if (Enum.TryParse<Severity>(_minSeverity, out var sev))
            yield return ($"Severity ≥ {SevLabels.For(sev)}", () => _minSeverity = "");
        if (_origin == nameof(CaseOrigin.InternalDetection))
            yield return ("Origin: Internal", () => _origin = "");
        else if (_origin == nameof(CaseOrigin.ThirdParty))
            yield return ("Origin: Third-party", () => _origin = "");
        if (!string.IsNullOrWhiteSpace(_search))
            yield return ($"Search: “{_search}”", () => _search = "");
        if (_includeClosed) yield return ("Including closed", () => _includeClosed = false);
        if (_includeExercises) yield return ("Including exercises", () => _includeExercises = false);
        if (_overdueOnly) yield return ("Overdue only", () => _overdueOnly = false);
        if (_slaAtRiskOnly) yield return ("SLA at risk", () => _slaAtRiskOnly = false);
        if (_referredOnly) yield return ("Referred to Legal", () => _referredOnly = false);
        if (_onHoldOnly) yield return ("On legal hold", () => _onHoldOnly = false);
    }

    private void RemoveFilter(Action clear) { clear(); ApplyFilters(); }

    // --- PROD-09: saved / shared views ---------------------------------------
    private async Task ReloadViews() => _views = await Views.ListAsync();

    private void ApplyView(SavedViewItem v) =>
        Nav.NavigateTo(string.IsNullOrEmpty(v.Query) ? "cases" : $"cases?{v.Query}");

    private void ToggleSaveForm()
    {
        _savingView = !_savingView;
        _confirmOverwrite = false;
        if (_savingView) { _newViewName = ""; _newViewShared = false; }
    }

    private async Task OnSaveKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_newViewName)) await SaveView();
    }

    // FR-15: a save whose name matches one of the user's own views overwrites it, so pause for a one-click
    // confirm the first time (unless they already confirmed via the Overwrite button).
    private bool _confirmOverwrite;

    private bool NameCollidesWithMine(string name) =>
        _views?.Any(v => v.IsMine && string.Equals(v.Name, name, StringComparison.OrdinalIgnoreCase)) ?? false;

    private async Task SaveView()
    {
        var name = _newViewName.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;
        if (!_confirmOverwrite && NameCollidesWithMine(name)) { _confirmOverwrite = true; return; }
        try
        {
            await Views.SaveAsync(name, CurrentQuery(), _newViewShared);
            _savingView = false;
            _confirmOverwrite = false;
            await ReloadViews();
            Toasts.Success($"Saved view “{name}”.");
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Toasts.Error(ex.Message);
        }
    }

    private async Task DeleteView(SavedViewItem v)
    {
        try
        {
            await Views.DeleteAsync(v.Id);
            await ReloadViews();
            Toasts.Info($"Deleted view “{v.Name}”.");
        }
        catch (InvalidOperationException ex)
        {
            Toasts.Error(ex.Message);
        }
    }

    // The current filters as a query string (no leading '?'), for saving a view.
    private string CurrentQuery()
    {
        var url = Nav.GetUriWithQueryParameters(Nav.ToAbsoluteUri("cases").ToString(), CurrentParams());
        return new Uri(url).Query.TrimStart('?');
    }

    // Highlight the view whose filters match the current query (order-insensitive).
    private bool IsActiveView(SavedViewItem v) => NormalizeQuery(v.Query) == NormalizeQuery(CurrentQuery());

    private static string NormalizeQuery(string? query) =>
        string.Join('&', (query ?? "").TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
            .OrderBy(p => p, StringComparer.Ordinal));

    private static string ViewTooltip(SavedViewItem v)
    {
        var who = v.IsMine ? (v.IsShared ? "Shared by you" : "Your private view") : $"Shared by {v.OwnerName}";
        return string.IsNullOrEmpty(v.Query) ? $"{who} · all cases" : $"{who} · cases?{v.Query}";
    }

    private static string? Blank(string v) => string.IsNullOrEmpty(v) ? null : v;

    // FR-10: paging navigates (rewrites the URL) rather than mutating component state, so the position is
    // bookmarkable and survives a refresh / dropped circuit. OnParametersSetAsync then reloads at that page.
    private void GoToPage(int page)
    {
        var p = new Dictionary<string, object?>(CurrentParams());
        p["page"] = page > 1 ? page.ToString() : null; // omit page=1 for clean URLs
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(Nav.ToAbsoluteUri("cases").ToString(), p));
    }

    private void PrevPage() { if (_filter.Page > 1) GoToPage(_filter.Page - 1); }
    private void NextPage() { if (_page is not null && _filter.Page < _page.TotalPages) GoToPage(_filter.Page + 1); }

    private void JumpToPage(ChangeEventArgs e)
    {
        if (_page is not null && int.TryParse(e.Value?.ToString(), out var p))
            GoToPage(Math.Clamp(p, 1, _page.TotalPages));
    }

    // A page-size change resets to page 1 at the new size (both carried in the URL).
    private void SetPageSize(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var size) || !PageSizeOptions.Contains(size)) return;
        var p = new Dictionary<string, object?>(CurrentParams());
        p["size"] = size == DefaultPageSize ? null : size.ToString(); // CurrentParams reflects the old size
        p["page"] = null;
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(Nav.ToAbsoluteUri("cases").ToString(), p));
    }

    private async Task Reload()
    {
        _filter.Classification = Enum.TryParse<Classification>(_classification, out var c) ? c : null;
        _filter.Phase = Enum.TryParse<CasePhase>(_phase, out var p) ? p : null;
        _filter.MinSeverity = Enum.TryParse<Severity>(_minSeverity, out var sev) ? sev : null;
        _filter.Origin = Enum.TryParse<CaseOrigin>(_origin, out var o) ? o : null;
        _filter.Search = _search;
        _filter.IncludeClosed = _includeClosed;
        _filter.IncludeExercises = _includeExercises;
        _filter.OverdueOnly = _overdueOnly;
        _filter.SlaAtRiskOnly = _slaAtRiskOnly;
        _filter.ReferredOnly = _referredOnly;
        _filter.OnHoldOnly = _onHoldOnly;
        _filter.UnassignedOnly = _assignee == "none";
        _filter.AssigneeUserId = _assignee == "none" ? null : _assignee;
        _targets = SlaProvider.Current;
        _page = await CaseSvc.ListAsync(_filter);
        _cursor = -1; // PROD-25: a fresh result set clears the keyboard row cursor
        // E-18: a new cohort (filter/page/scope change) invalidates the selection — never carry a bulk
        // selection across cohorts, and never leave a stale id from a page we've navigated away from.
        _selected.Clear();
    }

    // --- E-18 / U-15: metered bulk-select + bulk actions ---------------------
    // Metering: (1) scope-gated — bulk is offered only over a coherent cohort (a filter is set, or the Mine
    // scope), never the naked All queue; (2) hard count cap; (3) enumerate-and-confirm before any write;
    // (4) reversible verbs only (assign / refer-to-Legal) — never reclassify/close.
    private const int MaxBulk = 25;
    private readonly HashSet<Guid> _selected = new();
    private bool BulkEligible => _canEdit && (_hasActiveFilter || _onlyMine);

    private enum BulkVerb { None, Assign, Refer }
    private BulkVerb _bulkVerb = BulkVerb.None;
    private bool _bulkConfirm;
    private bool _bulkBusy;
    private string _bulkAssignToId = "";
    private CaseAssignmentRole _bulkAssignRole = CaseAssignmentRole.Analyst;
    private string? _bulkReferContact;
    private string? _bulkReferNote;

    // The "select page" header checkbox is on when the page's selectable rows (up to the cap) are all selected.
    private bool PageAllSelected =>
        _page is { Items.Count: > 0 } p && p.Items.Take(MaxBulk).All(i => _selected.Contains(i.Id));

    private void ToggleSelect(Guid id, bool on)
    {
        if (on) { if (_selected.Count < MaxBulk) _selected.Add(id); }
        else _selected.Remove(id);
    }

    private void TogglePage(bool on)
    {
        if (_page is not { Items.Count: > 0 } p) return;
        if (on) foreach (var i in p.Items.Take(MaxBulk)) _selected.Add(i.Id);
        else foreach (var i in p.Items) _selected.Remove(i.Id);
    }

    private void ClearSelection() => _selected.Clear();

    private void OpenBulk(BulkVerb verb)
    {
        _bulkVerb = verb;
        _bulkConfirm = false;
        _bulkAssignToId = "";
        _bulkAssignRole = CaseAssignmentRole.Analyst;
        _bulkReferContact = null;
        _bulkReferNote = null;
    }

    private void CloseBulk() { _bulkVerb = BulkVerb.None; _bulkConfirm = false; }

    private void ProceedBulk()
    {
        if (_bulkVerb == BulkVerb.Assign && string.IsNullOrEmpty(_bulkAssignToId)) return;
        _bulkConfirm = true;
    }

    private string BulkToName() => Users.Resolve(_bulkAssignToId)?.DisplayName ?? _bulkAssignToId;

    private async Task ApplyBulk()
    {
        if (_bulkBusy || _page is null) return;
        // Snapshot the affected cases from the confirmed set (the selection clears on the reload that follows).
        var targets = _page.Items.Where(i => _selected.Contains(i.Id)).ToList();
        if (targets.Count == 0) { CloseBulk(); return; }
        _bulkBusy = true;
        var verb = _bulkVerb;
        var toName = BulkToName();
        var done = 0;
        try
        {
            foreach (var c in targets)
            {
                try
                {
                    if (verb == BulkVerb.Assign)
                        await CaseSvc.AssignAsync(c.Id, _bulkAssignToId, toName, _bulkAssignRole);
                    else
                        await CaseSvc.ReferToLegalAsync(c.Id,
                            string.IsNullOrWhiteSpace(_bulkReferContact) ? null : _bulkReferContact.Trim(),
                            string.IsNullOrWhiteSpace(_bulkReferNote) ? null : _bulkReferNote.Trim());
                    done++;
                }
                catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or ForbiddenException)
                {
                    Toasts.Error($"{c.CaseNumber}: {ex.Message}");
                }
            }
        }
        finally { _bulkBusy = false; }

        CloseBulk();
        if (done > 0)
        {
            Toasts.Success(verb == BulkVerb.Assign
                ? $"Assigned {done} case{(done == 1 ? "" : "s")} to {toName}."
                : $"Referred {done} case{(done == 1 ? "" : "s")} to Legal.");
            await Reload(); // reflect the new assignee / Legal badge and clear the selection
        }
    }

    // Tooltip for an SLA badge: the clock, its target, and time left / overshoot.
    private static string SlaTitle(SlaStatus st)
    {
        var clock = st.Clock is { } c ? Ui.SlaClockLabel(c) : "SLA";
        var timing = Ui.SlaTiming(st);
        var target = st.TargetHours is { } h ? $" · target {h}h" : "";
        return string.IsNullOrEmpty(timing) ? $"{clock}{target}" : $"{clock} · {timing}{target}";
    }
}
